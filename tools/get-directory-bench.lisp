;;;; C4 directory GET CLOSED; esecuzioni esclusivamente dal padre dopo source freeze.
;;;; --self-test|--negative-fixture|--bench directory-nuova/
;;; OWNER: main possiede fixture/checkpoint; worker i possiede contesto, output e raw i.
;;; SHARED: directory/mappe/FD immutabili sotto EBR; cache della sola vista; heap globale.
;;; REQ: REQ-IDX-001 REQ-CCH-002 REQ-CMP-007 REQ-AFF-008 REQ-VAL-001
(require :asdf)
(require :sb-posix)
(defpackage #:arcdocdb.get-directory.bench (:use #:cl))
(in-package #:arcdocdb.get-directory.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defconstant +count+ 20000)
(defconstant +warmup+ 1000)
(defconstant +replicas+ 5)
(defconstant +self-count+ 8)
(defconstant +sentinel+ #xcc)
(defconstant +output-start+ 3)
(defconstant +csn+ #xffffffffffffffff)
(defconstant +run-seconds+ 600)
(defconstant +window-seconds+ 30)
(defconstant +cleanup-seconds+ 2)
(defconstant +plain-limit+ 1048576)
(defconstant +cache-sets+ 256)
(defconstant +cache-size+ 1024)
(defconstant +cache-payload+ 2156816) ; 8 + 256*8*(1024+29) + 256 + 8, stripes=1.
(defvar *threads* (make-array 4 :initial-element nil))
(defvar *run-deadline* 0)
(defvar *cleanup-deadline* 0)
(defvar *source* nil)
(defparameter *limits*
  '(:closed-only :current-get-v2-unprepared :tests-system-and-support-loaded-outside-windows
    :synthetic-committed-primary :native-io-warmup :all-n-keys-warm-no-eviction
    :fixed-count-no-adaptation :whole-process-allocation-not-live-heap-or-rss
    :candidate-and-full-output-checks-in-window :resolve-start-select-resolve-abandon
    :parallel-thread-startup-gate-join-and-quiescence-in-window
    :no-active :no-controller-publication-or-reclaim-measurement :no-pool-migration
    :no-snapshot-history-workload :no-p99 :no-network :no-durability-measurement
    :no-db-throughput-claim :no-performance-threshold :parent-certifies-source-freeze))
(deftype octets () '(simple-array (unsigned-byte 8) (*)))

(define-condition bench-failure (error)
  ((rule :initarg :rule :reader failure-rule)
   (detail :initarg :detail :reader failure-detail))
  (:report (lambda (condition stream)
             (format stream "tools/get-directory-bench.lisp ~A: ~A"
                     (failure-rule condition) (failure-detail condition)))))
(define-condition bench-timeout (bench-failure) ())
(defun fail (control &rest arguments)
  (error 'bench-failure :rule "COD-61" :detail (apply #'format nil control arguments)))
(defun timeout-failure (phase)
  (error 'bench-timeout :rule "COD-61" :detail (format nil "deadline ~A." phase)))
(defun diagnostic (condition)
  (let ((text (format nil "tools/get-directory-bench.lisp COD-61: ~A" condition)))
    (subseq text 0 (min 2048 (length text)))))
(defun api (package name &key internal)
  "Cold: nessuna ricerca di simboli nel ciclo. Internals usati solo per oracoli/config cold."
  (multiple-value-bind (symbol visibility) (find-symbol name package)
    (unless (and symbol (or internal (eq visibility :external)) (fboundp symbol))
      (fail "API assente: ~A:~A." package name))
    (symbol-function symbol)))
(defun fixture-api (suffix)
  (api "ARCDOCDB.GET.DIRECTORY.TESTS" (concatenate 'string "DIRECTORY-FIXTURE-" suffix)))
(defun fixture-field (fixture suffix)
  (funcall (fixture-api suffix) fixture))
(defun remaining (deadline)
  (/ (max 0 (- deadline (get-internal-real-time)))
     (float internal-time-units-per-second 1d0)))
(defun require-run-time ()
  (unless (plusp (remaining *run-deadline*)) (timeout-failure :run)))

(defstruct (raw (:copier nil))
  (completed 0 :type fixnum) (checksum 0 :type fixnum) failure)
(defstruct (sample (:copier nil))
  (ticks 0 :type integer) (heap 0 :type integer) failure)
(defstruct (profile (:copier nil))
  fixture (n 1 :type fixnum) (v 16 :type fixnum)
  view maps keys values ids ends segments files
  (contributions #() :type simple-vector) (cache-contributions #() :type simple-vector) cache-routing)

(defun source-metadata (args)
  (list :base "6eeb501" :base-role :ancestor :integration-main "644e53f"
        :integration-registration :parent-before-freeze :registration :parent-record-command-after-freeze
        :consistency :parent-evidence-required :argv (copy-list args)
        :fixture-system "arcdocdb/tests" :fixture-support "tests/get-directory/support.lisp"
        :prod-only nil :load-outside-windows t :test-op-invoked nil))
(defun leaf (kind &rest fields)
  (append (list :schema-version 1 :kind kind :status :running
                :source (copy-tree *source*) :limits (copy-list *limits*)) fields))
(defun require-fields (record fields)
  (unless (and (listp record) (evenp (length record))
               (loop for tail on record by #'cddr always (keywordp (car tail))))
    (fail "record non plist di keyword."))
  (dolist (field fields)
    (unless (nth-value 0 (get-properties record (list field)))
      (fail "campo mancante ~S." field)))
  record)
(defun require-schema (record kind)
  (require-fields record '(:schema-version :kind :status))
  (unless (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind))
               (member (getf record :status) '(:running :ok :failed)))
    (fail "schema 1/kind/status errati per ~S." kind))
  record)

(defun write-leaf (record directory name)
  "Checkpoint solo nel namespace esclusivo del run; staging esclusivo, rilettura dati bounded."
  (unless (member name '("report.lisp" "self-test-metrics.lisp" "self-test-sensor.lisp") :test #'string=)
    (fail "foglia non assegnata."))
  (require-schema record (getf record :kind))
  (require-fields record '(:source :limits))
  (let* ((path (merge-pathnames name directory))
         (temporary (merge-pathnames (concatenate 'string name ".tmp") directory))
         (text (with-output-to-string (stream)
                 (let ((*print-readably* t) (*print-pretty* nil) (*print-length* nil) (*print-level* nil))
                   (write record :stream stream) (terpri stream))))
         (bytes (sb-ext:string-to-octets text :external-format :utf-8)) (owned-temporary nil))
    (unless (< (length bytes) +plain-limit+) (fail "foglia oltre budget plain: ~A." name))
    (unwind-protect
         (progn
           (with-open-file (stream temporary :direction :output :element-type '(unsigned-byte 8)
                                   :if-exists :error :if-does-not-exist :create)
             (setf owned-temporary t)
             (write-sequence bytes stream))
           (sb-posix:rename (namestring temporary) (namestring path)))
      (when (and owned-temporary (probe-file temporary)) (delete-file temporary)))
    (with-open-file (stream path :direction :input :external-format :utf-8)
      (let* ((*read-eval* nil) (*package* (find-package :cl-user))
             (stored (read stream nil :eof)) (end (read stream nil :eof)))
        (unless (and (eq end :eof) (equal record stored)) (fail "rilettura diversa: ~A." name))
        (require-schema stored (getf record :kind)))))
  record)

(defun load-fixture-system ()
  "Il padre esegue LOAD-SYSTEM, NON TEST-OP; carica suite e support fuori dai clock."
  (let ((*standard-output* *error-output*))
    (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
    (asdf:load-system "arcdocdb/tests")
    ;; Compatibile anche prima dell'inclusione ASD del support, senza doppio LOAD dopo integrazione.
    (unless (let ((package (find-package "ARCDOCDB.GET.DIRECTORY.TESTS")))
              (and package (fboundp (find-symbol "MAKE-DIRECTORY-FIXTURE" package))))
      (load (merge-pathnames "tests/get-directory/support.lisp" (truename "./")))))
  (api "ARCDOCDB.GET.DIRECTORY.TESTS" "MAKE-DIRECTORY-FIXTURE"))

(defun reference-le (image start width)
  (let ((number 0))
    (dotimes (i width number) (setf number (logior number (ash (aref image (+ start i)) (* 8 i)))))))
(defun reference-mix (word)
  "Oracolo cold del routing letto staticamente in src/cache/core.lisp; non XXH64 delle key."
  (let* ((a (logxor word (ash word -16))) (b (logand #xffffffff (* a #x7feb352d)))
         (c (logxor b (ash b -15))) (d (logand #xffffffff (* c #x846ca68b))))
    (logxor d (ash d -16))))
(defun reference-set (id)
  (logand 255 (reference-mix (logxor (reference-mix 0)
                                    (reference-mix (logxor id #x9e3779b9))
                                    (reference-mix (logxor 64 #x85ebca6b))))))
(defun check-cache-routing (fixture ids)
  "Cold, sola lettura degli internals cache: config fissa, routing coincidente, occupazione <=8."
  (let* ((cache (fixture-field fixture "CACHE"))
         (classes (funcall (api "ARCDOCDB.CACHE" "CACHE-SERIE-CLASSES" :internal t) cache))
         (histogram (make-array +cache-sets+ :element-type 'fixnum :initial-element 0))
         (route (api "ARCDOCDB.CACHE" "INSIEME-CACHE" :internal t)))
    (unless (= 1 (length classes)) (fail "fixture deve avere una sola classe cache."))
    (let ((class (svref classes 0)))
      (unless (and (= +cache-size+ (funcall (api "ARCDOCDB.CACHE" "CLASSE-CACHE-SIZE" :internal t) class))
                   (= +cache-sets+ (funcall (api "ARCDOCDB.CACHE" "CLASSE-CACHE-SETS" :internal t) class))
                   (= +cache-payload+ (funcall (api "ARCDOCDB.CACHE" "PAYLOAD-CACHE-SERIE") cache)))
        (fail "fixture cache richiede classe1024/sets256/stripes1/payload2156816, senza eviction."))
      (dotimes (i (length ids))
        (let* ((id (svref ids i)) (set (reference-set id)))
          (unless (= set (funcall route class 0 id 64)) (fail "routing cache discordante."))
          (incf (aref histogram set))
          (when (> (aref histogram set) 8) (fail "routing eccede gli otto posti di un insieme.")))))
    (list :schema-version 1 :kind :get-directory-cache-routing :status :ok
          :sets +cache-sets+ :ways 8 :class-bytes +cache-size+ :payload-bytes +cache-payload+
          :max-set-occupancy (reduce #'max histogram) :locations (length ids))))

(defun prepare-profile (fixture n v)
  "Oracoli da immagini/ID/END della fixture, mai dal risultato di selezione/risoluzione."
  (let* ((maps (fixture-field fixture "MAPS")) (keys (fixture-field fixture "KEYS"))
         (values (fixture-field fixture "VALUES")) (ids (fixture-field fixture "IDS"))
         (ends (fixture-field fixture "ENDS")) (images (fixture-field fixture "IMAGES"))
         (files (fixture-field fixture "FILES")) (segments (make-array n))
         (contributions (make-array n)) (cache-contributions (make-array n))
         (map-segment (api "ARCDOCDB.GET.RESOLVER" "MAPPA-SEGMENTO-GET-SEGMENT" :internal t))
         (directory (fixture-field fixture "DIRECTORY")))
    (unless (and (= n (length maps) (length keys) (length values) (length ids) (length ends) (length images))
                 (= 4 (length (fixture-field fixture "CONTEXTS")) (length (fixture-field fixture "OUTPUTS")))
                 (= n (funcall (api "ARCDOCDB.GET.DIRECTORY" "CONTA-SEGMENTI-DIRECTORY-GET") directory))
                 (= (* 12 n) (funcall (api "ARCDOCDB.GET.DIRECTORY" "PAYLOAD-DIRECTORY-GET-SERIE") directory)))
      (fail "forme/cardinalita/payload fixture non concordi."))
    (dotimes (i n)
      (let* ((image (the octets (svref images i))) (value (the octets (svref values i)))
             (end (svref ends i)) (segment (funcall map-segment (svref maps i))))
        (unless (and (= 16 (length (svref keys i))) (= v (length value))
                     (= 2 (reference-le image 8 2)) (= 2 (aref image 10))
                     (= (svref ids i) (reference-le image 32 8)) (= end (+ 104 v))
                     (= 1 (aref image 72)) (zerop (aref image 73))
                     (= +csn+ (reference-le image 80 8))
                     (= v (reference-le image 76 4)) (= 16 (reference-le image 74 2)))
          (fail "oracolo CLOSED v2 ordinario non concorde alla chiave ~D." i))
        (dotimes (k v)
          (unless (= (aref value k) (aref image (+ 104 k))) (fail "oracoli valore/immagine discordi.")))
        (setf (svref segments i) segment (svref cache-contributions i) (1+ (reduce #'+ value))
              ;; Tutti addendi/checksum caldi restano fixnum su SBCL64; CSN verificato in due u32.
              (svref contributions i) (+ 1 end (svref ids i) (* 2 #xffffffff)
                                         (reduce #'+ value)))))
    (make-profile :fixture fixture :n n :v v :view (fixture-field fixture "VIEW")
                  :maps maps :keys keys :values values :ids ids :ends ends :segments segments :files files
                  :contributions contributions :cache-contributions cache-contributions
                  :cache-routing (check-cache-routing fixture ids))))

(defun expected-checksum (profile id count scenario)
  "COUNT20000 non e divisibile per64: oracolo indipendente con lo stesso ordine preregistrato."
  (let ((sum 0) (cursor (mod id (profile-n profile))))
    (dotimes (i count sum)
      (incf sum (if (eq scenario :resolve)
                    (svref (profile-contributions profile) cursor)
                    (svref (profile-cache-contributions profile) cursor)))
      (setf cursor (mod (1+ cursor) (profile-n profile))))))

(defun make-cycle (profile id scenario)
  (let* ((fixture (profile-fixture profile)) (n (profile-n profile)) (v (profile-v profile))
         (context (svref (fixture-field fixture "CONTEXTS") id))
         (output (the octets (svref (fixture-field fixture "OUTPUTS") id)))
         (reader (funcall (api "ARCDOCDB.EPOCHS" "CONTESTO-EPOCA") (fixture-field fixture "EPOCHS") id))
         (candidate (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0))
         (start (api "ARCDOCDB.GET" "AVVIA-GET")) (copy-candidate (api "ARCDOCDB.GET" "COPIA-CANDIDATO-GET"))
         (select (api "ARCDOCDB.GET.DIRECTORY" "TROVA-MAPPA-DIRECTORY-GET"))
         (resolve (api "ARCDOCDB.GET.DIRECTORY" "RISOLVI-CANDIDATO-DIRECTORY-GET"))
         (probe (api "ARCDOCDB.GET.DIRECTORY" "SONDA-CACHE-DIRECTORY-GET"))
         (copy-value (api "ARCDOCDB.GET" "COPIA-VALORE-GET")) (finish (api "ARCDOCDB.GET" "CONCLUDI-GET"))
         (abandon (api "ARCDOCDB.GET" "ABBANDONA-GET")) (state (api "ARCDOCDB.GET" "STATO-CONTESTO-GET"))
         (active (api "ARCDOCDB.EPOCHS" "EPOCA-ATTIVA-P"))
         (acquire-directory (fixture-api "DIRECTORY")) (cursor (mod id n)))
    (declare (type fixnum n v cursor) (type octets output))
    (lambda ()
      (let ((i cursor) (sum 0))
        (declare (type fixnum i sum))
        (fill output +sentinel+)
        (unwind-protect
             (progn
               (unless (and (eq :candidate (funcall start context (profile-view profile)
                                                   (svref (profile-keys profile) i) nil 0 0))
                            (eq :candidate (funcall state context)) (funcall active reader))
                 (fail "AVVIA-GET non CANDIDATE sotto EBR."))
               (funcall copy-candidate context candidate)
               (unless (and (= #xffffffff (ldb (byte 32 0) (aref candidate 0)))
                            (= #xffffffff (ldb (byte 32 32) (aref candidate 0)))
                            (= 64 (ldb (byte 32 0) (aref candidate 1)))
                            (= (svref (profile-ids profile) i) (ldb (byte 32 32) (aref candidate 1)))
                            (= (+ 40 v) (aref candidate 3)))
                 (fail "CSN/location/size del candidato discordi all'oracolo."))
               ;; Acquisizione controller SOLO dopo AVVIA-GET; riferimento non esce dal compito.
               (let ((directory (funcall acquire-directory fixture)))
                 (ecase scenario
                   (:resolve
                    (unless (eq (svref (profile-maps profile) i) (funcall select context directory))
                      (fail "selezione mappa errata."))
                    (multiple-value-bind (segment end flags proof) (funcall resolve context directory)
                      (unless (and (eq segment (svref (profile-segments profile) i))
                                   (= end (svref (profile-ends profile) i)) (zerop flags) (null proof)
                                   (eq :candidate (funcall state context)))
                        (fail "resolver CLOSED discordante: segment/END/flags/proof.")))
                    (setf sum (svref (profile-contributions profile) i)))
                   (:cache-hit
                    (unless (eq :hit (funcall probe context directory)) (fail "cache richiede HIT, nessun fallback."))
                    (unless (= (+ +output-start+ v) (funcall copy-value context output +output-start+))
                      (fail "fine copia errata."))
                    (multiple-value-bind (result size) (funcall finish context 1)
                      (unless (and (eq :found result) (= v size)) (fail "conclusione richiede FOUND,V.")))
                    (setf sum 1))))
               ;; Tutti i byte e tutte le sei guardie; resolve non modifica alcun byte output.
               (dotimes (k (length output))
                 (let ((byte (aref output k)))
                   (unless (= byte (if (and (eq scenario :cache-hit) (<= 3 k) (< k (+ 3 v)))
                                       (aref (the octets (svref (profile-values profile) i)) (- k 3))
                                       +sentinel+))
                     (fail "byte/sentinella output errato a ~D." k))
                   (when (and (eq scenario :cache-hit) (<= 3 k) (< k (+ 3 v))) (incf sum byte)))))
          (funcall abandon context))
        (unless (and (eq :idle (funcall state context)) (not (funcall active reader)))
          (fail "cleanup non IDLE/quiescente."))
        (setf cursor (mod (1+ cursor) n))
        sum))))

(defun warm-native-all-keys (profile)
  "Fuori finestra, native GET su ciascuna delle N chiavi; ritorni completi, zero eviction/scan."
  (let* ((fixture (profile-fixture profile)) (context (svref (fixture-field fixture "CONTEXTS") 0))
         (output (svref (fixture-field fixture "OUTPUTS") 0))
         (start (api "ARCDOCDB.GET" "AVVIA-GET")) (read-record (api "ARCDOCDB.GET" "LEGGI-RECORD-GET"))
         (copy-value (api "ARCDOCDB.GET" "COPIA-VALORE-GET")) (finish (api "ARCDOCDB.GET" "CONCLUDI-GET"))
         (abandon (api "ARCDOCDB.GET" "ABBANDONA-GET")))
    (dotimes (i (profile-n profile))
      (require-run-time)
      (fill output +sentinel+)
      (unwind-protect
           (progn
             (unless (eq :candidate (funcall start context (profile-view profile) (svref (profile-keys profile) i) nil 0 0))
               (fail "warm native non CANDIDATE."))
             (multiple-value-bind (source cache insertion evicted scan)
                 (funcall read-record context (svref (profile-segments profile) i) (svref (profile-ends profile) i) 0)
               (unless (or (and (eq source :segment) (eq cache :miss) (eq insertion :inserted) (null evicted) (null scan))
                           (and (eq source :cache) (eq cache :hit) (eq insertion :not-attempted) (null evicted) (null scan)))
                 (fail "warm native: enum/eviction/scan inattesi.")))
             (unless (= (+ 3 (profile-v profile)) (funcall copy-value context output 3)) (fail "warm native copia."))
             (multiple-value-bind (result size) (funcall finish context 1)
               (unless (and (eq result :found) (= size (profile-v profile))) (fail "warm native conclusione.")))
             (funcall (api "ARCDOCDB.GET.DIRECTORY.TESTS" "DIRECTORY-CHECK-OUTPUT") fixture 0 i))
        (funcall abandon context)))
    ;; Verifica TUTTE N dopo l'ultimo inserimento: evizioni precedenti non possono restare nascoste.
    (let ((cycle (make-cycle profile 0 :cache-hit)))
      (dotimes (i (profile-n profile)) (funcall cycle)))))

(defun run-loop (cycle count raw)
  (declare (type fixnum count) (type raw raw))
  (handler-case
      (dotimes (i count)
        (incf (raw-checksum raw) (the fixnum (funcall cycle)))
        (setf (raw-completed raw) (1+ i)))
    (error (condition) (setf (raw-failure raw) condition)))
  raw)
(defun observe (action sample)
  "Sensori globali main: tick-start, heap-start, heap-end, tick-end; unwind conserva raw."
  (let ((ticks (get-internal-real-time)) (heap (sb-ext:get-bytes-consed)))
    (unwind-protect
         (handler-case (funcall action) (error (condition) (setf (sample-failure sample) condition)))
      (setf (sample-heap sample) (- (sb-ext:get-bytes-consed) heap)
            (sample-ticks sample) (- (get-internal-real-time) ticks))))
  sample)
(defun alive-workers-p ()
  (some (lambda (thread) (and thread (sb-thread:thread-alive-p thread))) *threads*))
(defun stop-workers ()
  "Unica deadline cleanup 2s, condivisa da tutti i join; solo thread propri."
  ;; Una seconda chiamata dopo il fallimento non concede altri due secondi.
  (when (zerop *cleanup-deadline*)
    (setf *cleanup-deadline* (+ (get-internal-real-time) (* +cleanup-seconds+ internal-time-units-per-second))))
  (let ((deadline *cleanup-deadline*))
    (dotimes (i 4)
      (let ((thread (svref *threads* i)))
        (when (and thread (sb-thread:thread-alive-p thread)) (sb-thread:terminate-thread thread))))
    (dotimes (i 4)
      (let ((thread (svref *threads* i)))
        (when thread
          (sb-thread:join-thread thread :timeout (remaining deadline) :default :cleanup-timeout)
          (unless (sb-thread:thread-alive-p thread) (setf (svref *threads* i) nil)))))
    (not (alive-workers-p))))

(defun worker-metric (raw id count expected quiescent)
  ;; Nessuna lettura raw di un worker ancora vivo, neppure per una finestra fallita.
  (let ((completed (when quiescent (raw-completed raw)))
        (checksum (when quiescent (raw-checksum raw)))
        (failure (when quiescent (raw-failure raw))))
    (list :schema-version 1 :kind :get-directory-worker
          :status (if (and quiescent (null failure) (eql count completed) (eql expected checksum)) :ok :failed)
          :worker-id id :requested count :completed completed :checksum checksum :expected-checksum expected
          :quiescent quiescent :raw-observability (if quiescent :observed :unavailable-worker-alive)
          :diagnostic (cond (failure (diagnostic failure)) ((not quiescent) "tools/get-directory-bench.lisp COD-61: raw non quiescente.")))))
(defun window-metric (profile scenario execution workers replica count warmup sample raws expected quiescent)
  (let* ((worker-records (loop for id below workers collect
                             (worker-metric (svref raws id) id count (svref expected id) quiescent)))
         (ticks (sample-ticks sample)) (seconds (/ ticks (float internal-time-units-per-second 1d0)))
         (completed (when quiescent (reduce #'+ worker-records :key (lambda (x) (getf x :completed)))))
         (checksum (when quiescent (reduce #'+ worker-records :key (lambda (x) (getf x :checksum)))))
         (good (and quiescent (null (sample-failure sample))
                    (every (lambda (x) (eq :ok (getf x :status))) worker-records))))
    (list :schema-version 1 :kind :get-directory-window :status (if good :ok :failed)
          :execution execution :scenario scenario :segment-count (profile-n profile) :value-bytes (profile-v profile)
          :key-bytes 16 :csn +csn+ :replica replica :worker-count workers :count-per-worker count :warmup-per-worker warmup
          :requested (* workers count) :completed completed :checksum checksum :expected-checksum (reduce #'+ expected)
          :raw-ticks ticks :seconds seconds :heap-bytes (sample-heap sample) :counter-scope :whole-process
          :time-quality (if (zerop ticks) :below-resolution :measured)
          :ops-per-second (when (and good (plusp ticks)) (/ completed seconds))
          :thread-setup-in-window (eq execution :parallel) :cleanup-outside-window-on-failure t
          :code-checks-in-window t :directory-selections-per-cycle (if (eq scenario :resolve) 2 1)
          :quiescent quiescent :workers worker-records
          :diagnostic (when (sample-failure sample) (diagnostic (sample-failure sample))))))

(defun run-window (profile scenario execution workers replica count warmup)
  "Preallocation/warmup/fullGC cold; startup, gate, bounded join e quiescenza dentro il group."
  (require-run-time)
  (when (alive-workers-p) (fail "nuova finestra con worker precedente ancora vivo."))
  (setf *cleanup-deadline* 0)
  (let* ((cycles (make-array workers)) (raws (make-array workers)) (expected (make-array workers))
         (entries (make-array workers)) (names (make-array workers)) (sample (make-sample))
         (ready (sb-thread:make-semaphore :count 0)) (start (sb-thread:make-semaphore :count 0))
         (check-clean (api "ARCDOCDB.GET.DIRECTORY.TESTS" "DIRECTORY-CHECK-CLEAN"))
         (deadline 0))
    (dotimes (id workers)
      ;; Warmup con closure diversa: il cursore della finestra parte SEMPRE da worker-id mod N.
      (let ((warm (make-cycle profile id scenario)) (cycle (make-cycle profile id scenario)) (raw (make-raw)))
        (dotimes (i warmup) (funcall warm))
        (setf (svref cycles id) cycle (svref raws id) raw
              (svref expected id) (expected-checksum profile id count scenario)
              (svref names id) (format nil "get-directory-~D" id)
              (svref entries id)
              (lambda ()
                (handler-case
                    (progn (sb-thread:signal-semaphore ready)
                           (unless (sb-thread:wait-on-semaphore start :timeout (remaining deadline)) (timeout-failure :start))
                           (run-loop cycle count raw))
                  (error (condition) (setf (raw-failure raw) condition)))
                :completed))))
    (let ((action
            (if (eq execution :serial)
                (lambda ()
                  (run-loop (svref cycles 0) count (svref raws 0))
                  (funcall check-clean (profile-fixture profile) 0))
                (lambda ()
                  (dotimes (id workers)
                    ;; Timeout differito durante creazione/registrazione: nessun thread proprio senza handle.
                    (sb-sys:without-interrupts
                      (setf (svref *threads* id) (sb-thread:make-thread (svref entries id) :name (svref names id)))))
                  (dotimes (id workers)
                    (unless (sb-thread:wait-on-semaphore ready :timeout (remaining deadline)) (timeout-failure :ready)))
                  (sb-thread:signal-semaphore start workers)
                  (dotimes (id workers)
                    (unless (eq :completed (sb-thread:join-thread (svref *threads* id)
                                                                 :timeout (remaining deadline) :default :join-timeout))
                      (timeout-failure :join)))
                  (when (alive-workers-p) (fail "join senza quiescenza."))
                  (fill *threads* nil)
                  (dotimes (id workers) (funcall check-clean (profile-fixture profile) id))))))
      (sb-ext:gc :full t)
      (setf deadline (min *run-deadline* (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second))))
      (handler-case (sb-ext:with-timeout (remaining deadline) (observe action sample))
        (error (condition) (setf (sample-failure sample) condition))))
    ;; In errore il group chiude prima del cleanup bounded; questa differenza e registrata.
    (when (alive-workers-p)
      (handler-case (stop-workers) (error (condition) (setf (sample-failure sample) condition))))
    (window-metric profile scenario execution workers replica count warmup sample raws expected (not (alive-workers-p)))))

(defun validate-window (record)
  (require-schema record :get-directory-window)
  (require-fields record '(:execution :scenario :segment-count :value-bytes :csn :replica :worker-count
                           :count-per-worker :warmup-per-worker :requested :completed :checksum :expected-checksum
                           :raw-ticks :seconds :heap-bytes :counter-scope :time-quality :ops-per-second
                           :thread-setup-in-window :quiescent :workers :diagnostic))
  (let ((workers (getf record :worker-count)) (count (getf record :count-per-worker))
        (ticks (getf record :raw-ticks)) (execution (getf record :execution)))
    (unless (and (eq :ok (getf record :status)) (null (getf record :diagnostic)) (getf record :quiescent)
                 (member execution '(:serial :parallel)) (member (getf record :scenario) '(:resolve :cache-hit))
                 (member (getf record :segment-count) '(1 8 32 64)) (member (getf record :value-bytes) '(16 256))
                 (eql +csn+ (getf record :csn)) (member workers '(1 2 4))
                 (or (eq execution :parallel) (= 1 workers)) (member count '(8 20000))
                 (eql (getf record :warmup-per-worker) (if (= count 8) 8 +warmup+))
                 (typep ticks '(integer 0)) (typep (getf record :heap-bytes) '(integer 0))
                 (eq :whole-process (getf record :counter-scope))
                 (eq (getf record :thread-setup-in-window) (eq execution :parallel))
                 (eql (* count workers) (getf record :requested)) (eql (* count workers) (getf record :completed))
                 (eql (getf record :checksum) (getf record :expected-checksum))
                 (eql (getf record :seconds) (/ ticks (float internal-time-units-per-second 1d0)))
                 (eq (getf record :time-quality) (if (zerop ticks) :below-resolution :measured))
                 (eql (getf record :ops-per-second) (when (plusp ticks) (/ (getf record :completed) (getf record :seconds))))
                 (= workers (length (getf record :workers))))
      (fail "finestra incompleta o metriche incoerenti."))
    (loop for worker in (getf record :workers) for id from 0 do
      (require-schema worker :get-directory-worker)
      (require-fields worker '(:worker-id :requested :completed :checksum :expected-checksum :quiescent :diagnostic))
      (unless (and (eq :ok (getf worker :status)) (null (getf worker :diagnostic)) (getf worker :quiescent)
                   (eql id (getf worker :worker-id)) (eql count (getf worker :requested)) (eql count (getf worker :completed))
                   (typep (getf worker :checksum) '(integer 0)) (eql (getf worker :checksum) (getf worker :expected-checksum)))
        (fail "worker ~D incompleto." id)))
    (unless (and (= (getf record :checksum) (reduce #'+ (getf record :workers) :key (lambda (x) (getf x :checksum))))
                 (= (getf record :expected-checksum) (reduce #'+ (getf record :workers) :key (lambda (x) (getf x :expected-checksum)))))
      (fail "aggregati worker discordanti.")))
  record)

(defun validate-matrix (records replicas count)
  (unless (= (length records) (* 16 4 replicas)) (fail "matrice incompleta."))
  (dolist (record records) (validate-window record))
  (dolist (execution '(:serial :parallel))
    (dolist (n '(1 8 32 64))
      (dolist (v '(16 256))
        (dolist (scenario '(:resolve :cache-hit))
          (dotimes (replica replicas)
            (dolist (workers (if (eq execution :serial) '(1) '(1 2 4)))
              (unless (= 1 (count-if (lambda (record)
                                      (and (eq execution (getf record :execution)) (eq scenario (getf record :scenario))
                                           (= n (getf record :segment-count)) (= v (getf record :value-bytes))
                                           (= replica (getf record :replica)) (= workers (getf record :worker-count))
                                           (= count (getf record :count-per-worker)))) records))
                (fail "cella preregistrata mancante/duplicata."))))))))
  records)

(defun expect-rejection (function)
  (let ((rejected nil))
    (handler-case (funcall function)
      (bench-failure (condition)
        (unless (and (string= "COD-61" (failure-rule condition))
                     (search "tools/get-directory-bench.lisp" (princ-to-string condition))) (error condition))
        (setf rejected t)))
    (unless rejected (fail "self-test non rileva la metrica mancante.")))
  t)
(defun req-val-001-missing-completed-self-test ()
  (let* ((profile (make-profile :n 1 :v 16)) (raw (make-raw :completed 8 :checksum 8))
         (good (window-metric profile :resolve :serial 1 0 8 8 (make-sample) (vector raw) (vector 8) t))
         (broken (copy-tree good)))
    (validate-window good)
    (remf broken :completed)
    (expect-rejection (lambda () (validate-window broken)))
    ;; Prova anche il completamento del worker, l'header schema e il fallimento parziale.
    (let ((worker-broken (copy-tree good)) (schema-broken (copy-tree good)) (failed (copy-tree good)))
      (remf (first (getf worker-broken :workers)) :completed)
      (remf schema-broken :schema-version)
      (setf (getf failed :completed) 7 (getf failed :status) :failed (getf failed :ops-per-second) nil)
      (expect-rejection (lambda () (validate-window worker-broken)))
      (expect-rejection (lambda () (validate-window schema-broken)))
      (expect-rejection (lambda () (validate-window failed))))
    (list :schema-version 1 :kind :get-directory-diagnostics :status :ok
          :req "REQ-VAL-001" :missing-completed-detected t :worker-missing-completed-detected t
          :missing-schema-detected t :partial-failed-detected t :zero-ticks-rate-nil t)))

(defun sensor-metric (sample raw requested)
  (list :schema-version 1 :kind :get-directory-sensor-window
        :status (if (or (sample-failure sample) (raw-failure raw) (/= requested (raw-completed raw))) :failed :ok)
        :requested requested :completed (raw-completed raw) :checksum (raw-checksum raw)
        :raw-ticks (sample-ticks sample) :heap-bytes (sample-heap sample) :counter-scope :whole-process
        :diagnostic (when (or (sample-failure sample) (raw-failure raw))
                      (diagnostic (or (sample-failure sample) (raw-failure raw))))))
(defun observe-sensor (action sample)
  "Ogni timeout lascia il sample leggibile e pubblicabile prima del gate sensore."
  (let ((deadline (min *run-deadline* (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second)))))
    (handler-case (sb-ext:with-timeout (remaining deadline) (observe action sample))
      (error (condition) (setf (sample-failure sample) condition))))
  sample)
(defun req-val-001-sensor-self-test (directory)
  (let* ((record (leaf :get-directory-sensor :metrics nil :diagnostic nil))
         (empty (make-raw)) (positive (make-raw)) (a (make-sample)) (b (make-sample))
         (retained (make-array 4 :initial-element nil)) (cursor 0)
         (empty-cycle (lambda () 1))
         (positive-cycle (lambda ()
                           (setf (svref retained cursor) (make-array 1048576 :element-type '(unsigned-byte 8) :initial-element 47))
                           (incf cursor) 1))
         (empty-action (lambda () (run-loop empty-cycle 8 empty)))
         (positive-action (lambda () (run-loop positive-cycle 4 positive))))
    (write-leaf record directory "self-test-sensor.lisp")
    (handler-case
        (progn
          (sb-ext:gc :full t)
          (observe-sensor empty-action a)
          (push (sensor-metric a empty 8) (getf record :metrics))
          (write-leaf record directory "self-test-sensor.lisp")
          (sb-ext:gc :full t)
          (observe-sensor positive-action b)
          (push (sensor-metric b positive 4) (getf record :metrics))
          (setf (getf record :retained-payload-bytes) 4194304 (getf record :retained-arrays) cursor)
          (write-leaf record directory "self-test-sensor.lisp")
          (unless (and (null (sample-failure a)) (null (sample-failure b)) (null (raw-failure empty)) (null (raw-failure positive))
                       (= 8 (raw-completed empty) (raw-checksum empty)) (= 4 cursor (raw-completed positive) (raw-checksum positive))
                       (>= (sample-ticks a) 0) (>= (sample-ticks b) 0) (>= (sample-heap a) 0)
                       (>= (sample-heap b) 4194304)
                       (every (lambda (array) (and (typep array 'octets) (= 1048576 (length array))
                                                  (= 47 (aref array 0) (aref array 1048575)))) retained))
            (fail "sensore globale non osserva il controllo positivo trattenuto."))
          (setf (getf record :status) :ok)
          (write-leaf record directory "self-test-sensor.lisp"))
      (error (condition)
        (setf (getf record :status) :failed (getf record :diagnostic) (diagnostic condition))
        (write-leaf record directory "self-test-sensor.lisp")
        (error condition)))))

(defun profile-metadata (profile)
  (list :schema-version 1 :kind :get-directory-profile :status :ok
        :segment-count (profile-n profile) :value-bytes (profile-v profile)
        :directory-payload-bytes (* 12 (profile-n profile))
        :cache-routing (copy-tree (profile-cache-routing profile))))
(defun campaign (record directory name replicas count warmup &key report-p metadata-report)
  "Una sola fixture viva; ordine N,V,seriale/parallelo,caso,replica,worker. COUNT immutato."
  (handler-case
      (progn
        (dolist (n '(1 8 32 64))
          (dolist (v '(16 256))
            (require-run-time)
            (let ((fixture nil))
              (unwind-protect
                   (progn
                     (setf fixture (funcall (api "ARCDOCDB.GET.DIRECTORY.TESTS" "MAKE-DIRECTORY-FIXTURE")
                                            :count n :value-bytes v :workers 4 :version 2 :csn +csn+ :cache-p t))
                     (let ((profile (prepare-profile fixture n v)))
                       (warm-native-all-keys profile)
                       (when metadata-report
                         (push (profile-metadata profile) (getf metadata-report :profiles))
                         (write-leaf metadata-report directory "report.lisp"))
                       (dolist (execution '(:serial :parallel))
                         (dolist (scenario '(:resolve :cache-hit))
                           (dotimes (replica replicas)
                             (dolist (workers (if (eq execution :serial) '(1) '(1 2 4)))
                               (let ((metric (run-window profile scenario execution workers replica count warmup)))
                                 ;; Copia posseduta e checkpoint prima del gate: raw falliti conservati.
                                 (push (copy-tree metric) (getf record (if report-p execution :metrics)))
                                 (write-leaf record directory name)
                                 (validate-window metric))))))))
                (stop-workers)
                (when (alive-workers-p) (fail "cleanup senza quiescenza; FD fino all'uscita processo."))
                (when fixture
                  (funcall (api "ARCDOCDB.GET.DIRECTORY.TESTS" "CLOSE-DIRECTORY-FIXTURE") fixture))))))
        (validate-matrix (if report-p (append (getf record :serial) (getf record :parallel)) (getf record :metrics)) replicas count)
        (unless report-p (setf (getf record :status) :ok))
        (write-leaf record directory name))
    (error (condition)
      (setf (getf record :status) :failed (getf record :diagnostic) (diagnostic condition))
      (write-leaf record directory name)
      (error condition))))

(defun new-report (mode)
  (leaf :get-directory-benchmark :mode mode :exit-code nil :diagnostic nil :persistence :pending
        :recorded-at (get-universal-time) :count-per-worker +count+ :warmup-per-worker +warmup+ :replicas +replicas+
        :segment-counts '(1 8 32 64) :value-bytes '(16 256) :csn +csn+ :scenarios '(:resolve :cache-hit)
        :worker-counts '(1 2 4) :serial nil :parallel nil :self-test nil :sensor nil :profiles nil
        :environment (list :lisp (lisp-implementation-type) :version (lisp-implementation-version)
                           :machine (machine-type) :os (software-type) :os-version (software-version)
                           :cwd (namestring (truename "./")) :external-load :uncontrolled :safety 3 :speed 2 :debug 2
                           :timer :get-internal-real-time :timer-units-per-second internal-time-units-per-second
                           :heap :sb-ext-get-bytes-consed :heap-scope :whole-process)
        :budgets (list :run-seconds 600 :window-seconds 30 :cleanup-group-seconds 2 :max-threads 4
                       :max-plain-leaf-bytes (1- +plain-limit+) :run-directory-live-bytes 4194304
                       :max-live-fixtures 1 :max-live-fixture-fds 64 :max-live-fixture-file-bytes 23744
                       :fixture-files-per-campaign 210 :fixture-file-bytes-per-campaign 52710
                       :cache-payload-per-fixture +cache-payload+
                       :fixture-temporary-roots :exclusive-support-owned :fasl-and-parent-evidence :excluded)))

(defun validate-report (report)
  (require-schema report :get-directory-benchmark)
  (unless (and (eq :ok (getf report :status)) (eql 0 (getf report :exit-code))
               (eq :ok (getf (getf report :self-test) :status)) (eq :ok (getf (getf report :sensor) :status))
               (= 64 (getf (getf report :self-test) :windows)) (= 8 (length (getf report :profiles)))
               (= +count+ (getf report :count-per-worker)) (= +warmup+ (getf report :warmup-per-worker))
               (= +replicas+ (getf report :replicas))) (fail "report di successo incompleto."))
  (if (string= "--bench" (getf report :mode))
      (progn
        (unless (and (= 80 (length (getf report :serial))) (= 240 (length (getf report :parallel)))) (fail "campagne 80/240 incomplete."))
        (validate-matrix (append (getf report :serial) (getf report :parallel)) +replicas+ +count+))
      (unless (and (null (getf report :serial)) (null (getf report :parallel))) (fail "self-test contiene campagna benchmark.")))
  report)

(defun execute (mode report directory)
  (if (string= mode "--negative-fixture")
      (let* ((raw (make-raw :completed 8 :checksum 8))
             (broken (window-metric (make-profile :n 1 :v 16) :resolve :serial 1 0 8 8 (make-sample) (vector raw) (vector 8) t))
             (metrics (leaf :get-directory-self-test :count-per-worker 8 :warmup-per-worker 8 :replicas 1 :metrics nil :diagnostic nil)))
        (setf (getf broken :measurement-origin) :synthetic-negative-fixture)
        (remf broken :completed)
        (push broken (getf metrics :metrics))
        (write-leaf metrics directory "self-test-metrics.lisp")
        (handler-case (validate-window broken)
          (error (condition)
            (setf (getf metrics :status) :failed (getf metrics :diagnostic) (diagnostic condition))
            (write-leaf metrics directory "self-test-metrics.lisp")
            (error condition)))
        (fail "negative fixture accettata."))
      (progn
        (load-fixture-system)
        (setf (getf report :sensor) (req-val-001-sensor-self-test directory))
        (let ((metrics (leaf :get-directory-self-test :count-per-worker 8 :warmup-per-worker 8 :replicas 1
                             :metrics nil :diagnostics nil :diagnostic nil)))
          (setf (getf report :self-test) (list :schema-version 1 :kind :get-directory-self-test-summary :status :running))
          (write-leaf metrics directory "self-test-metrics.lisp")
          (handler-case
              (progn
                (setf (getf metrics :diagnostics) (req-val-001-missing-completed-self-test))
                (campaign metrics directory "self-test-metrics.lisp" 1 8 8 :metadata-report report)
                (setf (getf report :self-test) (list :schema-version 1 :kind :get-directory-self-test-summary
                                                   :status :ok :windows (length (getf metrics :metrics)))))
            (error (condition)
              (setf (getf metrics :status) :failed (getf metrics :diagnostic) (diagnostic condition)
                    (getf (getf report :self-test) :status) :failed)
              (write-leaf metrics directory "self-test-metrics.lisp")
              (error condition))))
        (write-leaf report directory "report.lisp")
        (when (string= mode "--bench")
          (campaign report directory "report.lisp" +replicas+ +count+ +warmup+ :report-p t)))))

(defun create-directory (mode requested)
  (let* ((prefix (if (string= mode "--bench") "get-directory-bench" "get-directory-self-test"))
         (path (uiop:ensure-directory-pathname (merge-pathnames requested (truename "./"))))
         (name (car (last (pathname-directory path)))))
    (unless (and (stringp name) (uiop:string-prefix-p prefix name)) (fail "directory deve iniziare con ~A." prefix))
    (ensure-directories-exist (merge-pathnames "parent-placeholder" (uiop:pathname-parent-directory-pathname path)))
    (sb-posix:mkdir (namestring path) #o700) ; EEXIST fallisce: niente riuso/overwrite di run altrui.
    path))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (*source* (source-metadata args))
         (report (new-report (first args))) (directory nil))
    (setf *run-deadline* (+ (get-internal-real-time) (* +run-seconds+ internal-time-units-per-second)))
    (handler-case
        (progn
          (unless (and (= 2 (length args)) (member (first args) '("--self-test" "--negative-fixture" "--bench") :test #'string=))
            (fail "uso: --self-test|--negative-fixture|--bench directory-nuova/; conteggi fissi."))
          (unless (>= most-positive-fixnum #xffffffffffff) (fail "richiesto SBCL64."))
          (setf directory (create-directory (first args) (second args)))
          (write-leaf report directory "report.lisp")
          (sb-ext:with-timeout (remaining *run-deadline*) (execute (first args) report directory))
          (setf (getf report :status) :ok (getf report :exit-code) 0)
          (validate-report report))
      (error (condition)
        (setf (getf report :status) :failed (getf report :exit-code) 1 (getf report :diagnostic) (diagnostic condition))))
    (when directory
      (handler-case
          (progn (setf (getf report :persistence) :verified) (write-leaf report directory "report.lisp"))
        (error (condition)
          (setf (getf report :status) :failed (getf report :exit-code) 1 (getf report :persistence) :failed
                (getf report :diagnostic) (diagnostic condition))
          (handler-case (write-leaf report directory "report.lisp")
            (error (second-condition) (format *error-output* "~A~%" (diagnostic second-condition)))))))
    (format t "~S: ~A~%" (getf report :status) (or directory "nessuna directory acquisita"))
    (when (getf report :diagnostic) (format *error-output* "~A~%" (getf report :diagnostic)))
    (sb-ext:exit :code (or (getf report :exit-code) 1))))

(uiop:with-current-directory ((merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
  (main))
