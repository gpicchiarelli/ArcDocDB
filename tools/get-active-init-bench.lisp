;;;; C4: GET CLOSED attraverso ACTIVE vuoto, poi primo publish; parent solo dopo freeze.
;;;; Uso: --self-test|--bench spikes/out/<namespace-nuovo>/; --library solo definizioni.
;;; OWNER: main fixture/lease/FD/thread; worker i contesto/cursore/raw i.
;;; SHARED: fonti e root immutabili nella finestra; clock/heap whole-process.
;;; REQ: REQ-IDX-001 REQ-WAL-006 REQ-CMP-007 REQ-AFF-008 REQ-VAL-001
(require :asdf)
(require :sb-posix)
(load "tools/evidence-storage.lisp")
(defpackage #:arcdocdb.get.active.init.bench (:use #:cl))
(in-package #:arcdocdb.get.active.init.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defconstant +count+ 10000)
(defconstant +warmup+ 500)
(defconstant +replicas+ 5)
(defconstant +window-seconds+ 30)
(defconstant +campaign-seconds+ 600)
(defvar *threads* #())
(defvar *deadline* 0)
(define-condition bench-failure (error)
  ((detail :initarg :detail :reader failure-detail))
  (:report (lambda (c s) (format s "get-active-init-bench COD-61: ~A" (failure-detail c)))))
(defun fail (control &rest args) (error 'bench-failure :detail (apply #'format nil control args)))
(defun api (package name &key internal)
  (multiple-value-bind (symbol visibility) (find-symbol name package)
    (unless (and symbol (fboundp symbol) (or internal (eq visibility :external)))
      (fail "API assente ~A:~A." package name))
    (symbol-function symbol)))
(defun fixture-api (name) (api "ARCDOCDB.GET.DIRECTORY.TESTS" name :internal t))
(defun field (fixture suffix)
  (funcall (fixture-api (concatenate 'string "DIRECTORY-FIXTURE-" suffix)) fixture))
(defun series-field (fixture suffix)
  (funcall (fixture-api (concatenate 'string "DIRECTORY-SERIES-FIXTURE-" suffix)) fixture))
(defun remaining (deadline)
  (/ (max 0 (- deadline (get-internal-real-time))) (float internal-time-units-per-second 1d0)))
(defun require-time (deadline) (unless (plusp (remaining deadline)) (fail "deadline scaduta.")))
(defun workers-alive-p ()
  (some (lambda (thread) (and thread (sb-thread:thread-alive-p thread))) *threads*))
(defun stop-workers ()
  "Cleanup bounded dei soli thread propri; FD trattenuti se un worker rimane vivo."
  (let ((deadline (+ (get-internal-real-time) (* 2 internal-time-units-per-second))))
    (map nil (lambda (thread)
               (when (and thread (sb-thread:thread-alive-p thread)) (sb-thread:terminate-thread thread))) *threads*)
    (map nil (lambda (thread)
               (when thread (sb-thread:join-thread thread :timeout (remaining deadline) :default :timeout))) *threads*))
  (not (workers-alive-p)))
(defun exclusive-directory (path)
  (let* ((directory (merge-pathnames (uiop:ensure-directory-pathname path) (truename "./")))
         (parent (uiop:pathname-parent-directory-pathname directory)))
    (ensure-directories-exist (merge-pathnames "placeholder" parent))
    (unless (uiop:subpathp (truename parent) (truename "spikes/out/")) (fail "output fuori spikes/out."))
    (sb-posix:mkdir (namestring directory) #o700)
    (truename directory)))
(defun write-record (record path)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil))
      (write record :stream out :pretty t) (terpri out))))
(defun save-report (record directory)
  (when directory
    (let ((tmp (merge-pathnames "report.tmp" directory)) (path (merge-pathnames "report.lisp" directory)))
      (write-record record tmp) (sb-posix:rename (namestring tmp) (namestring path)))))
(defstruct profile fixture directory controller (n 1 :type fixnum) segments ends expected contributions)
(defstruct raw (completed 0 :type fixnum) (checksum 0 :type fixnum) failure)
(defun reference-le (image start width)
  (let ((number 0))
    (dotimes (i width number) (incf number (ash (aref image (+ start i)) (* 8 i))))))
(defun prepare-profile (fixture n)
  "Oracolo bytewise dagli input CLOSED CSN=1 della fixture, senza osservare GET/resolve."
  (let* ((directory (series-field fixture "DIRECTORY")) (ends (field directory "ENDS"))
         (segments (make-array n)) (expected (make-array n)) (contributions (make-array n)))
    (unless (and (= n (length ends) (length (field directory "MAPS")) (length (field directory "IMAGES"))
                   (length (field directory "IDS")) (length (field directory "KEYS")) (length (field directory "VALUES")))
                 (= 4 (length (field directory "CONTEXTS")) (length (field directory "OUTPUTS")))
                 (= 1 (field directory "CSN")) (not (field directory "PREPARED-P")))
      (fail "cardinalita/config fixture discordante."))
    (dotimes (i n)
      (let* ((image (svref (field directory "IMAGES") i)) (key (svref (field directory "KEYS") i))
             (value (svref (field directory "VALUES") i)) (id (svref (field directory "IDS") i))
             (words (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0)))
        (unless (and (= 2 (reference-le image 8 2) (aref image 10)) (= id (reference-le image 32 8))
                     (= 1 (reference-le image 80 8) (aref image 72)) (zerop (aref image 73))
                     (= 16 (length key) (length value) (reference-le image 74 2) (reference-le image 76 4))
                     (= 120 (svref ends i))) (fail "image CLOSED discordante ~D." i))
        (dotimes (k 16)
          (unless (and (= (aref key k) (aref image (+ 88 k))) (= (aref value k) (aref image (+ 104 k))))
            (fail "image/key/value discordante ~D." i)))
        ;; Un frammento, key16 inserite una volta in ordine; flags=0, proof=NIL.
        (setf (aref words 0) 1 (aref words 1) (+ (ash id 32) 64)
              (aref words 2) (+ (* i 16) (ash 16 32) (ash 1 48)) (aref words 3) 56
              (svref expected i) words (svref contributions i) (+ 1 id 120)
              (svref segments i)
              (funcall (api "ARCDOCDB.GET.RESOLVER" "MAPPA-SEGMENTO-GET-SEGMENT" :internal t)
                       (svref (field directory "MAPS") i)))))
    (make-profile :fixture fixture :directory directory :controller (series-field fixture "CONTROLLER")
                  :n n :segments segments :ends ends :expected expected :contributions contributions)))
(defun check-candidate (actual expected)
  (declare (type (simple-array (unsigned-byte 64) (5)) actual expected))
  (dotimes (word 5)
    (unless (and (= (ldb (byte 32 0) (aref actual word)) (ldb (byte 32 0) (aref expected word)))
                 (= (ldb (byte 32 32) (aref actual word)) (ldb (byte 32 32) (aref expected word))))
      (fail "candidate word ~D." word))))
(defun check-resolved (profile ordinal segment end flags proof)
  (unless (and (eq segment (svref (profile-segments profile) ordinal))
               (= end (svref (profile-ends profile) ordinal)) (zerop flags) (null proof))
    (fail "CLOSED segment/END/flags/proof discordanti.")))
(defun make-cycle (profile worker)
  "Solo avvia/resolve/abbandona; oracolo, cleanup pin e checksum dentro clock, nessun read/cache."
  (let* ((directory (profile-directory profile)) (n (profile-n profile)) (cursor (mod worker n))
         (context (svref (field directory "CONTEXTS") worker)) (keys (field directory "KEYS"))
         (view (field directory "VIEW")) (start (api "ARCDOCDB.GET" "AVVIA-GET"))
         (candidate-of (api "ARCDOCDB.GET" "CONTESTO-GET-CONTENT" :internal t))
         (resolve (api "ARCDOCDB.GET.DIRECTORY" "RISOLVI-CANDIDATO-SERIE-GET"))
         (abandon (api "ARCDOCDB.GET" "ABBANDONA-GET")) (state (api "ARCDOCDB.GET" "STATO-CONTESTO-GET"))
         (active (api "ARCDOCDB.EPOCHS" "EPOCA-ATTIVA-P"))
         (reader (funcall (api "ARCDOCDB.EPOCHS" "CONTESTO-EPOCA") (field directory "EPOCHS") worker))
         (clean (fixture-api "DIRECTORY-CHECK-CLEAN")))
    (lambda ()
      (let ((i cursor) (sum 0))
        (unwind-protect
             (progn
               (unless (and (eq :candidate (funcall start context view (svref keys i) nil 0 11))
                            (eq :candidate (funcall state context)) (funcall active reader)) (fail "candidate/pin."))
               (let ((candidate (funcall candidate-of context)))
                 (check-candidate candidate (svref (profile-expected profile) i))
                 (multiple-value-bind (segment end flags proof) (funcall resolve context (profile-controller profile))
                   (check-resolved profile i segment end flags proof)
                   (setf sum (+ 1 end (ldb (byte 32 32) (aref candidate 1))))))
               (unless (and (eq :candidate (funcall state context)) (funcall active reader))
                 (fail "resolve stato/pin.")))
          (funcall abandon context))
        (unless (and (eq :idle (funcall state context)) (not (funcall active reader)) (funcall clean directory worker))
          (fail "cleanup pin/stato."))
        (setf cursor (mod (1+ cursor) n))
        sum))))
(defun expected-checksum (profile worker count)
  (let ((sum 0) (cursor (mod worker (profile-n profile))))
    (dotimes (i count sum)
      (incf sum (svref (profile-contributions profile) cursor))
      (setf cursor (mod (1+ cursor) (profile-n profile))))))
(defun run-loop (cycle count raw deadline)
  (handler-case
      (dotimes (i count)
        (when (zerop (logand i 255)) (require-time deadline))
        (incf (raw-checksum raw) (the fixnum (funcall cycle))) (setf (raw-completed raw) (1+ i)))
    (error (c) (setf (raw-failure raw) (princ-to-string c))))
  :completed)
(defun worker-record (profile id count warmup raw warm)
  (list :worker id :requested count :completed (raw-completed raw) :checksum (raw-checksum raw)
        :expected-checksum (expected-checksum profile id count) :failure (raw-failure raw)
        :warmup-requested warmup :warmup-completed (raw-completed warm)
        :warmup-checksum (raw-checksum warm) :warmup-expected-checksum (expected-checksum profile id warmup)
        :warmup-failure (raw-failure warm)))
(defun validate-window (record)
  (unless (and (eql 1 (getf record :schema-version)) (eq :get-active-init-window (getf record :kind))
               (member (getf record :stage) '(:empty-active :first-active-publish))
               (member (getf record :execution) '(:serial :parallel))
               (member (getf record :readers) '(1 2 4))
               (or (eq :parallel (getf record :execution)) (eql 1 (getf record :readers)))
               (eq :ok (getf record :status)) (eq t (getf record :quiescent))
               (typep (getf record :count-per-reader) '(integer 1))
               (typep (getf record :warmup-per-reader) '(integer 1))
               (typep (getf record :checksum) '(integer 0))
               (typep (getf record :expected-checksum) '(integer 0))
               (eql (getf record :requested) (* (getf record :readers) (getf record :count-per-reader)))
               (eql (getf record :requested) (getf record :completed))
               (eql (getf record :checksum) (getf record :expected-checksum))
               (typep (getf record :ticks) '(integer 0)) (typep (getf record :heap-bytes) '(integer 0))
               (= (getf record :readers) (length (getf record :workers)))
               (every (lambda (worker)
                        (and (null (getf worker :failure)) (null (getf worker :warmup-failure))
                             (typep (getf worker :checksum) '(integer 0))
                             (typep (getf worker :expected-checksum) '(integer 0))
                             (typep (getf worker :warmup-checksum) '(integer 0))
                             (typep (getf worker :warmup-expected-checksum) '(integer 0))
                             (eql (getf record :count-per-reader) (getf worker :requested))
                             (eql (getf worker :requested) (getf worker :completed))
                             (eql (getf worker :checksum) (getf worker :expected-checksum))
                             (eql (getf record :warmup-per-reader) (getf worker :warmup-requested))
                             (eql (getf worker :warmup-requested) (getf worker :warmup-completed))
                             (eql (getf worker :warmup-checksum) (getf worker :warmup-expected-checksum))))
                      (getf record :workers))) (fail "finestra incompleta/schema discordante."))
  record)
(defun run-window (profile stage execution workers replica)
  (require-time *deadline*)
  (let* ((cycles (make-array workers)) (raws (make-array workers)) (warms (make-array workers))
         (threads (make-array workers :initial-element nil)) (gate (sb-thread:make-semaphore :count 0))
         (error-text nil) (ticks 0) (heap 0)
         (deadline (min *deadline* (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second)))))
    (dotimes (id workers)
      (let ((warm (make-raw)))
        (run-loop (make-cycle profile id) +warmup+ warm deadline)
        (setf (svref warms id) warm (svref raws id) (make-raw) (svref cycles id) (make-cycle profile id))
        (unless (and (null (raw-failure warm)) (= +warmup+ (raw-completed warm))
                     (= (raw-checksum warm) (expected-checksum profile id +warmup+))) (fail "warmup incompleto."))))
    (setf *threads* threads)
    (sb-ext:gc :full t)
    (require-time deadline)
    (let ((start-ticks (get-internal-real-time)) (start-heap (sb-ext:get-bytes-consed)))
      (unwind-protect
           (handler-case
               (progn
                 (if (eq execution :serial)
                     (run-loop (svref cycles 0) +count+ (svref raws 0) deadline)
                     (progn
                       (dotimes (id workers)
                         (let ((cycle (svref cycles id)) (raw (svref raws id)))
                           (setf (svref threads id)
                                 (sb-thread:make-thread
                                  (lambda ()
                                    (handler-case
                                        (progn
                                          (unless (sb-thread:wait-on-semaphore gate :timeout (remaining deadline))
                                            (fail "gate timeout.")) (run-loop cycle +count+ raw deadline))
                                      (error (c) (setf (raw-failure raw) (princ-to-string c))))
                                    :completed)))))
                       (sb-thread:signal-semaphore gate workers)
                       (map nil (lambda (thread)
                                  (unless (eq :completed (sb-thread:join-thread thread :timeout (remaining deadline)
                                                                             :default :timeout)) (fail "join timeout."))) threads)))
                 (require-time deadline))
             (error (c) (setf error-text (princ-to-string c))))
        (setf heap (- (sb-ext:get-bytes-consed) start-heap) ticks (- (get-internal-real-time) start-ticks))))
    (when (workers-alive-p) (stop-workers))
    (let* ((quiet (not (workers-alive-p)))
           (records (when quiet (loop for id below workers collect
                                     (worker-record profile id +count+ +warmup+ (svref raws id) (svref warms id)))))
           (completed (when quiet (reduce #'+ records :key (lambda (r) (getf r :completed)))))
           (sum (when quiet (reduce #'+ records :key (lambda (r) (getf r :checksum)))))
           (expected (loop for id below workers sum (expected-checksum profile id +count+))))
      (list :schema-version 1 :kind :get-active-init-window :stage stage :execution execution :readers workers
            :n (profile-n profile) :replica replica :count-per-reader +count+ :warmup-per-reader +warmup+
            :requested (* workers +count+) :completed completed :checksum sum :expected-checksum expected
            :ticks ticks :seconds (/ ticks (float internal-time-units-per-second 1d0)) :heap-bytes heap
            :heap-scope :whole-process :serial-heap-zero-observed (and (eq execution :serial) (zerop heap))
            :measurement :start-resolve-abandon :oracle-and-pin-cleanup-and-checksum-in-clock t
            :parallel-startup-gate-wait-join-in-clock (eq execution :parallel)
            :quiescent quiet :workers records :diagnostic error-text
            :status (if (and quiet (null error-text) (= completed (* workers +count+)) (= sum expected)
                             (every (lambda (r) (null (getf r :failure))) records)) :ok :failed)))))
(defun check-root (fixture stage)
  "Cold: attesta la fase predisposta dalle API fixture, senza derivarne l'oracolo GET."
  (let* ((root (funcall (api "ARCDOCDB.SERIES" "LEGGI-RADICE-SERIE") (series-field fixture "CONTROLLER")))
         (empty-p (eq stage :empty-active)))
    (unless (and (eq root (series-field fixture "ROOT"))
                 (eq root (series-field fixture "PLANNED"))
                 (= (if empty-p 0 1) (funcall (api "ARCDOCDB.GET.RESOLVER" "RADICE-GET-ATTIVA-COUNT" :internal t) root))
                 (= (if empty-p 0 1) (funcall (api "ARCDOCDB.GET.RESOLVER" "RADICE-GET-ATTIVA-PUTS" :internal t) root))
                 (= (if empty-p 0 4) (funcall (api "ARCDOCDB.GET.RESOLVER" "RADICE-GET-ATTIVA-NODES" :internal t) root))
                 (= (if empty-p 64 (series-field fixture "NEXT"))
                    (funcall (api "ARCDOCDB.GET.RESOLVER" "RADICE-GET-ATTIVA-END" :internal t) root))
                 (eq (series-field fixture "SOURCES")
                     (funcall (api "ARCDOCDB.GET.RESOLVER" "CONTENUTO-RADICE-GET-ATTIVA") root)))
      (fail "fase root discordante ~S." stage))))
(defun campaign (report directory)
  (dolist (n '(1 8 64))
    (let ((fixture nil))
      (unwind-protect
           (progn
             (setf fixture (funcall (fixture-api "MAKE-DIRECTORY-SERIES-FIXTURE")
                                    :count n :workers 4 :cache-p nil :empty-active-p t :publish-active-p nil))
             (let ((profile (prepare-profile fixture n)))
               (dolist (stage '(:empty-active :first-active-publish))
                 (when (eq stage :first-active-publish)
                   (require-time *deadline*)
                   (funcall (fixture-api "DIRECTORY-SERIES-PUBLISH") fixture
                            (funcall (fixture-api "DIRECTORY-SERIES-STAGE") fixture
                                     (series-field fixture "ACTIVE-KEY") (series-field fixture "ACTIVE-VALUE"))))
                 (check-root fixture stage)
                 (dotimes (replica +replicas+)
                   (dolist (config '((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4)))
                     (let ((record (run-window profile stage (first config) (second config) replica)))
                       (push record (getf report :windows)) (save-report report directory) (validate-window record)))))))
        (when (workers-alive-p) (stop-workers))
        (when (and fixture (not (workers-alive-p))) (funcall (fixture-api "CLOSE-DIRECTORY-SERIES-FIXTURE") fixture))))))
(defun validate-campaign (records)
  (unless (= 120 (length records)) (fail "matrice incompleta."))
  (dolist (n '(1 8 64))
    (dolist (stage '(:empty-active :first-active-publish))
      (dotimes (replica +replicas+)
        (dolist (config '((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4)))
          (unless (= 1 (count-if (lambda (r)
                                  (and (eql n (getf r :n)) (eq stage (getf r :stage)) (eql replica (getf r :replica))
                                       (eq (first config) (getf r :execution)) (eql (second config) (getf r :readers)))) records))
            (fail "cella mancante/duplicata."))))))
  (dolist (record records)
    (unless (and (eql +count+ (getf record :count-per-reader)) (eql +warmup+ (getf record :warmup-per-reader)))
      (fail "count/warmup discordante."))
    (validate-window record))
  (unless (and (= 2400000 (reduce #'+ records :key (lambda (r) (getf r :completed))))
               (= 120000 (loop for r in records sum (* (getf r :readers) (getf r :warmup-per-reader)))))
    (fail "totali discordanti.")))
(defun expect-rejection (thunk)
  (let ((caught nil))
    (handler-case (funcall thunk) (error () (setf caught t)))
    (unless caught (fail "self-test controllo negativo accettato."))))
(defun self-test (directory)
  "Solo sensori sintetici e scrittura/reader evidence esistente; nessun prodotto o fixture."
  (let* ((worker '(:requested 8 :completed 8 :checksum 8 :expected-checksum 8 :failure nil
                   :warmup-requested 8 :warmup-completed 8 :warmup-checksum 8 :warmup-expected-checksum 8))
         (good (list :schema-version 1 :kind :get-active-init-window :stage :empty-active :execution :serial
                     :readers 1 :count-per-reader 8 :warmup-per-reader 8 :status :ok :quiescent t
                     :requested 8 :completed 8 :checksum 8 :expected-checksum 8 :ticks 0 :heap-bytes 0 :workers (list worker)))
         (words (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0))
         (path (merge-pathnames "self-test-record.lisp" directory)))
    (validate-window good)
    (dolist (key '(:schema-version :kind :completed :quiescent :heap-bytes :workers :count-per-reader))
      (let ((bad (copy-tree good))) (remf bad key) (expect-rejection (lambda () (validate-window bad)))))
    (dolist (change '((:status :failed) (:completed 7) (:checksum 9) (:heap-bytes -1)))
      (let ((bad (copy-tree good))) (setf (getf bad (first change)) (second change))
        (expect-rejection (lambda () (validate-window bad)))))
    (let ((bad (copy-tree good))) (setf (getf (first (getf bad :workers)) :warmup-completed) 7)
      (expect-rejection (lambda () (validate-window bad))))
    (dotimes (i 5)
      (let ((bad (copy-seq words))) (setf (aref bad i) (ash 1 40))
        (expect-rejection (lambda () (check-candidate bad words)))))
    (let ((profile (make-profile :segments (vector :expected) :ends (vector 120))))
      (dolist (args '((:wrong 120 0 nil) (:expected 121 0 nil) (:expected 120 1 nil) (:expected 120 0 64)))
        (expect-rejection (lambda () (apply #'check-resolved profile 0 args)))))
    (write-record good path)
    (unless (equal good (arcdocdb.evidence:read-evidence path :max-expanded-bytes 2097152)) (fail "record roundtrip."))
    (write-record '(:schema-version 999 :kind :unknown) path)
    (expect-rejection (lambda () (validate-window (arcdocdb.evidence:read-evidence path :max-expanded-bytes 2097152))))
    (let* ((start (sb-ext:get-bytes-consed))
           (retained (make-array 1048576 :element-type '(unsigned-byte 8) :initial-element 47))
           (delta (- (sb-ext:get-bytes-consed) start)))
      (unless (and (>= delta 1048576) (= 47 (aref retained 0) (aref retained 1048575))) (fail "sensore heap."))
      (list :status :ok :negative-cases 22 :record-roundtrip t :observed-control-heap-bytes delta :product-loaded nil))))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (directory nil) (*threads* #())
         (*deadline* (+ (get-internal-real-time) (* +campaign-seconds+ internal-time-units-per-second)))
         (report (list :schema-version 1 :kind :get-active-init-benchmark :status :running :argv args :self-test nil :windows nil
                       :started-at-universal-time (get-universal-time)
                       :source-helpers '("tools/get-active-init-bench.lisp" "tools/evidence-storage.lisp")
                       :environment (list :lisp (lisp-implementation-version) :machine (machine-type) :os (software-type)
                                          :os-version (software-version) :timer-units internal-time-units-per-second
                                          :clock :get-internal-real-time :heap :sb-ext-get-bytes-consed :heap-scope :whole-process)
                       :campaign '(:n (1 8 64) :stages (:empty-active :first-active-publish) :replicas 5
                                   :count-per-worker 10000 :warmup-per-worker 500 :windows 120
                                   :configurations ((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4))
                                   :measured-cycles 2400000 :warmup-cycles 120000 :setup-and-publish-outside-clock t
                                   :deadline-seconds 600 :window-deadline-seconds 30 :cleanup-seconds 2)
                       :static-risks '(:freeze-required :not-executed-by-author :fixture-empty-active-p-required
                                       :sbcl64 :ordinary-closed-csn1-key16-value16 :single-fragment-insertion-order
                                       :checks-in-clock :heap-whole-process-allocation-not-rss :serial-zero-only-observed
                                       :parallel-startup-included :gate-not-proof-of-temporal-overlap :external-load-uncontrolled
                                       :deadline-poll-every-256-cycles :cold-load-native-io-cooperative-deadline
                                       :failed-worker-cleanup-outside-clock :fd-retained-if-worker-alive
                                       :no-storage-throughput-claim :no-engine-qualification))))
    (handler-case
        (progn
          (unless (and (= 2 (length args)) (member (first args) '("--self-test" "--bench") :test #'string=))
            (fail "usage --self-test|--bench spikes/out/<namespace-nuovo>/."))
          (setf directory (exclusive-directory (second args))) (save-report report directory)
          (setf (getf report :self-test) (self-test directory)) (save-report report directory)
          (when (string= "--bench" (first args))
            (let ((*standard-output* *error-output*))
              (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./"))) (asdf:load-system "arcdocdb/tests"))
            (campaign report directory) (validate-campaign (getf report :windows)))
          (setf (getf report :status) :ok))
      (error (c) (setf (getf report :status) :failed (getf report :diagnostic) (princ-to-string c))))
    (setf (getf report :finished-at-universal-time) (get-universal-time)) (save-report report directory)
    (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil)) (write report :pretty t) (terpri))
    (sb-ext:exit :code (if (eq :ok (getf report :status)) 0 1))))
(unless (equal (uiop:command-line-arguments) '("--library")) (main))
