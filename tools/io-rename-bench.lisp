;;;; C4: microbenchmark locale della sola API di rinomina; CL + SBCL, librerie locali.
;;;; Uso dal checkout, anche mediante --script:
;;;;   sbcl --no-userinit --no-sysinit --script tools/io-rename-bench.lisp --self-test
;;;;   [controlli del recorder in altri processi; sorgenti congelati]
;;;;   sbcl --no-userinit --no-sysinit --script tools/io-rename-bench.lisp \
;;;;     --bench spikes/out/<namespace-nuovo>/
;;;;   --self-test
;;;;   --bench spikes/out/<namespace-nuovo>/
;;;; Il namespace e un solo slug ASCII (lettere, cifre, - e _, massimo 96).
;;;; --self-test non carica prodotto/ASDF, non crea thread, non misura syscall.
;;;; --bench carica il prodotto fuori clock; il recorder esterno attesta provenance.
;;;; Gate del recorder: --self-test e controlli in processi separati, poi --bench
;;;; in un nuovo processo, con sorgenti congelati. --bench non esegue self-test.
;;;; Cache FASL privata nel run; ASDF force, warning/style-warning fatali.
;;;; 128 roundtrip/reader, 256 rename/reader, 5 repliche, seriale e 2/4 directory.
;;;; Ogni roundtrip usa SEMPRE source.tmp -> destination.tmp -> source.tmp.
;;;; Il secondo scenario aggiunge durable-flush(directory) DOPO OGNI rename.
;;;; Byte writes, preparazione, GC e verifiche finali sono fuori dai contatori.
;;;; Startup/gate/join paralleli, controlli cooperativi e contatori sono nel clock.
;;;; 30s/window e 600s/campaign sono deadline COOPERATIVE: una syscall bloccata
;;;; non viene interrotta. Il recorder esterno deve limitare la vita del processo.
;;;; Nessun retry, rollback, terminate-thread o timeout asincrono.
;;;; Lock/FD/fixture si rilasciano soltanto dopo la terminazione di TUTTI i worker.
;;;; Una rinomina non attesta EDIT, validita del file o checkpoint completo.
;;; REQ: REQ-AFF-001 REQ-AFF-008 REQ-VAL-001
;;; OWNER: main possiede campagna, namespace, lock, fixture e registro dei thread.
;;; OWNER: worker i possiede directory i e raw i tra avvio e join; main legge raw
;;;        e riprende le capacita soltanto dopo la quiescenza dell'intero gruppo.
;;; SHARED: API, nomi, fixture e deadline immutabili durante una finestra;
;;;         stop scritto solo da main, letto con barrier; nessun contatore condiviso.
(require :sb-posix)
(defpackage #:arcdocdb.io-rename.bench (:use #:cl))
(in-package #:arcdocdb.io-rename.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defconstant +iterations+ 128)
(defconstant +replicas+ 5)
(defconstant +window-seconds+ 30)
(defconstant +campaign-seconds+ 600)
(defconstant +fixture-bytes+ 4096)
(defconstant +boundary-bytes+ 64)
(defconstant +max-report-characters+ 1048576)
(deftype octets () '(simple-array (unsigned-byte 8) (*)))

(define-condition bench-failure (error)
  ((rule :initarg :rule :reader failure-rule)
   (reason :initarg :reason :reader failure-reason)
   (detail :initarg :detail :reader failure-detail))
  (:report (lambda (condition stream)
             (format stream "tools/io-rename-bench.lisp ~A (~S): ~A"
                     (failure-rule condition) (failure-reason condition)
                     (failure-detail condition)))))
(define-condition bench-deadline (bench-failure) ())

(defun reject (reason &optional (detail "osservazione rifiutata"))
  (error 'bench-failure :rule "COD-61" :reason reason :detail detail))
(defun expire (reason)
  (error 'bench-deadline :rule "COD-61" :reason reason
                        :detail "deadline cooperativa raggiunta"))
(defun diagnostic (condition)
  (let ((text (format nil "tools/io-rename-bench.lisp COD-61: ~A" condition)))
    (subseq text 0 (min 2048 (length text)))))
(defun remaining (deadline)
  (/ (max 0 (- deadline (get-internal-real-time)))
     (float internal-time-units-per-second 1d0)))
(defun require-time (deadline)
  (when (>= (get-internal-real-time) deadline) (expire :campaign-deadline)))

(defstruct (api (:copier nil))
  (rename #'identity :type function :read-only t)
  (flush #'identity :type function :read-only t)
  (directory #'identity :type function :read-only t)
  (create #'identity :type function :read-only t)
  (reader #'identity :type function :read-only t)
  (append #'identity :type function :read-only t)
  (read #'identity :type function :read-only t)
  (close #'identity :type function :read-only t)
  (state #'identity :type function :read-only t)
  (mode #'identity :type function :read-only t)
  (written #'identity :type function :read-only t)
  (durable #'identity :type function :read-only t)
  (fd #'identity :type function :read-only t))
(defstruct (fixture (:copier nil))
  (id 0 :type fixnum :read-only t)
  (directory #p"./" :type pathname :read-only t)
  (owned nil :type boolean)
  (source-owned nil :type boolean) (boundary-owned nil :type boolean)
  ;; 0 directory; 1 source writer; 2 source reader; 3 boundary writer; 4 boundary reader.
  (handles (make-array 5 :initial-element nil) :type simple-vector :read-only t)
  (bytes (make-array 0 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (boundary (make-array 0 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (baseline nil :type list))
(defstruct (raw (:copier nil))
  (attempted 0 :type fixnum) (renames 0 :type fixnum) (iterations 0 :type fixnum)
  (forward 0 :type fixnum) (backward 0 :type fixnum) (flushes 0 :type fixnum)
  (toggle 0 :type bit) (toggle-sum 0 :type fixnum)
  (terminated nil :type boolean) (failure nil :type (or null condition)))
(defstruct (group (:copier nil))
  (threads #() :type simple-vector :read-only t)
  (raws #() :type simple-vector :read-only t)
  (deadline 0 :type integer :read-only t)
  (stop 0 :type bit)
  (ready (sb-thread:make-semaphore :count 0) :type sb-thread:semaphore :read-only t)
  (gate (sb-thread:make-semaphore :count 0) :type sb-thread:semaphore :read-only t))
(defstruct (run (:copier nil))
  (root #p"./" :type pathname :read-only t)
  (deadline 0 :type integer :read-only t)
  (directory nil :type (or null pathname))
  (lock nil :type (or null pathname)) (lock-owned nil :type boolean)
  (fixtures (make-array 4 :initial-element nil) :type simple-vector :read-only t)
  (api nil :type (or null api)) (active nil :type (or null group)))

(defun function-in (package name &key internal)
  "Cold: risolve una funzione gia caricata; mai INTERN o ricerca nel ciclo caldo."
  (let ((package-object (find-package package)))
    (unless package-object (reject :missing-api package))
    (multiple-value-bind (symbol visibility) (find-symbol name package-object)
      (unless (and symbol (fboundp symbol) (or internal (eq visibility :external)))
        (reject :missing-api (format nil "~A:~A" package name)))
      (symbol-function symbol))))
(defun asdf-policy-symbol (name)
  (let ((symbol (find-symbol name "ASDF")))
    (unless (and symbol (boundp symbol)) (reject :asdf-policy name))
    symbol))
(defun load-product (run)
  "Solo --bench: sistema locale di prodotto, nessun test-op, load/compile fuori clock."
  (require :asdf)
  (let* ((*standard-output* *error-output*) (*trace-output* *error-output*)
         (*compile-print* nil) (*compile-verbose* nil) (*load-print* nil) (*load-verbose* nil)
         (cache (merge-pathnames "fasl/" (run-directory run)))
         (policy (list (asdf-policy-symbol "*COMPILE-FILE-WARNINGS-BEHAVIOUR*")
                       (asdf-policy-symbol "*COMPILE-FILE-FAILURE-BEHAVIOUR*"))))
    (ensure-directories-exist (merge-pathnames "placeholder" cache))
    (handler-bind ((warning (lambda (condition)
                             (if (typep condition 'sb-kernel:redefinition-warning)
                                 (format *error-output* "~&ASDF-REDEFINITION ~S: ~A~%" (type-of condition) condition)
                                 (reject :product-warning (diagnostic condition))))))
      (progv policy '(:error :error)
        (funcall (function-in "ASDF" "INITIALIZE-OUTPUT-TRANSLATIONS")
                 (list :output-translations (list t (namestring cache)) :ignore-inherited-configuration))
        (require-time (run-deadline run))
        (funcall (function-in "ASDF" "LOAD-ASD") (merge-pathnames "arcdocdb.asd" (run-root run)))
        (funcall (function-in "ASDF" "LOAD-SYSTEM") "arcdocdb" :force t :verbose nil))))
  (flet ((io (name &key internal) (function-in "ARCDOCDB.IO" name :internal internal)))
    (make-api :rename (io "RINOMINA-NELLA-DIRECTORY") :flush (io "DURABLE-FLUSH")
              :directory (io "APRI-DIRECTORY") :create (io "CREA-TEMPORANEO")
              :reader (io "APRI-LETTURA") :append (io "APPEND-ESATTO") :read (io "LEGGI-ESATTO")
              :close (io "CHIUDI") :state (io "STATO-FILE") :mode (io "MODE-FILE")
              :written (io "POSIZIONE-SCRITTA") :durable (io "POSIZIONE-DUREVOLE")
              :fd (io "FILE-FD" :internal t))))

(defun valid-name-p (name)
  "Oracolo locale dei nomi del contratto; non sostituisce il preflight di prodotto."
  (and (stringp name) (<= 1 (length name) 255)
       (not (member name '("." "..") :test #'string=))
       (every (lambda (character) (let ((code (char-code character)))
                                   (and (< 0 code 128) (/= code 47)))) name)))
(defun check-name-pair (source destination)
  (unless (and (valid-name-p source) (valid-name-p destination) (not (string= source destination)))
    (reject :name-oracle))
  t)
(defun namespace-path (root requested)
  (unless (and (stringp requested) (> (length requested) 12)
               (string= requested "spikes/out/" :end1 11)
               (char= (char requested (1- (length requested))) #\/))
    (reject :namespace "uso: --bench spikes/out/<namespace-nuovo>/"))
  (let ((slug (subseq requested 11 (1- (length requested)))))
    (unless (and (<= 1 (length slug) 96)
                 (every (lambda (character)
                          (or (find character "-_" :test #'char=)
                              (<= (char-code #\0) (char-code character) (char-code #\9))
                              (<= (char-code #\a) (char-code character) (char-code #\z))
                              (<= (char-code #\A) (char-code character) (char-code #\Z)))) slug))
      (reject :namespace "namespace: un solo slug ASCII, massimo 96 caratteri"))
    (merge-pathnames requested root)))
(defun acquire-namespace (run requested)
  "mkdir esclusiva, lock del tool per checkout; EEXIST fallisce senza riuso/steal."
  (let* ((path (namespace-path (run-root run) requested))
         (parent (merge-pathnames "spikes/out/" (run-root run)))
         (lock (merge-pathnames ".io-rename-bench.lock/" parent)))
    (ensure-directories-exist (merge-pathnames "placeholder" parent))
    (unless (equal parent (truename parent)) (reject :physical-namespace "spikes/out non fisico"))
    (require-time (run-deadline run))
    (sb-posix:mkdir (namestring lock) #o700)
    (setf (run-lock run) lock (run-lock-owned run) t)
    (sb-posix:mkdir (namestring path) #o700)
    (setf (run-directory run) path)
    path))

(defun lstat-or-absent (path)
  (handler-case (sb-posix:lstat (namestring path))
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:enoent (sb-posix:syscall-errno condition)) nil (error condition)))))
(defun stat-identity (stat)
  (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat)))
(defun check-file-shape (regular-p links size expected-size &optional (detail "fixture"))
  (unless (and regular-p (= 1 links) (= size expected-size)) (reject :file-shape detail))
  t)
(defun check-distinct-identities (identities)
  (unless (= (length identities) (length (remove-duplicates identities :test #'equal)))
    (reject :independent-directory-alias))
  t)
(defun checked-regular-stat (path bytes)
  (let ((stat (lstat-or-absent path)))
    (unless stat (reject :file-shape (namestring path)))
    (check-file-shape (sb-posix:s-isreg (sb-posix:stat-mode stat))
                      (sb-posix:stat-nlink stat) (sb-posix:stat-size stat) bytes (namestring path))
    stat))
(defun fixture-octets (size id salt)
  (let ((bytes (make-array size :element-type '(unsigned-byte 8))))
    (dotimes (index size bytes)
      (setf (aref bytes index) (mod (+ salt (* 37 index) (* 53 id)) 256)))))
(defun check-octets (observed expected)
  (unless (= (length observed) (length expected)) (reject :byte-length))
  (dotimes (index (length expected))
    (unless (= (aref observed index) (aref expected index)) (reject :byte-content)))
  t)
(defun check-path-bytes (path expected)
  "Cold, lettura bounded di foglia regolare senza hardlink; EOF controllato."
  (let ((stat (checked-regular-stat path (length expected)))
        (observed (make-array (length expected) :element-type '(unsigned-byte 8))))
    (with-open-file (stream path :direction :input :element-type '(unsigned-byte 8))
      (unless (= (file-length stream) (length expected)) (reject :byte-length))
      (unless (= (read-sequence observed stream) (length expected)) (reject :byte-length))
      (unless (eq :eof (read-byte stream nil :eof)) (reject :byte-length)))
    (check-octets observed expected)
    (stat-identity stat)))
(defun handle-snapshot (api handle directory-p)
  "Cold: stato, modo, posizioni logiche e offset nativo; FD confrontato nel medesimo oracolo cold."
  (let* ((fd (funcall (api-fd api) handle)) (stat (sb-posix:fstat fd)))
    (list :fd fd :state (funcall (api-state api) handle) :mode (funcall (api-mode api) handle)
          :written (funcall (api-written api) handle) :durable (funcall (api-durable api) handle)
          :offset (unless directory-p (sb-posix:lseek fd 0 sb-posix:seek-cur))
          :identity (stat-identity stat)
          :kind (if directory-p (sb-posix:s-isdir (sb-posix:stat-mode stat))
                    (sb-posix:s-isreg (sb-posix:stat-mode stat))))))
(defun fixture-snapshots (api fixture)
  (loop for handle across (fixture-handles fixture) for index from 0
        collect (handle-snapshot api handle (zerop index))))
(defun check-initial-frontiers (snapshots)
  (loop for snapshot in snapshots for index from 0 do
    (let* ((writer (member index '(1 3)))
           (bytes (case index (1 +fixture-bytes+) (3 +boundary-bytes+) (otherwise 0))))
      (unless (and (eq :open (getf snapshot :state)) (getf snapshot :kind)
                   (eq (if (zerop index) :directory (if writer :append :input)) (getf snapshot :mode))
                   (= bytes (getf snapshot :written)) (= bytes (getf snapshot :durable))
                   (or (zerop index) (= bytes (getf snapshot :offset))))
        (reject :initial-frontier))))
  (unless (and (equal (getf (second snapshots) :identity) (getf (third snapshots) :identity))
               (equal (getf (fourth snapshots) :identity) (getf (fifth snapshots) :identity)))
    (reject :reader-identity)))
(defun check-frontiers (observed baseline)
  (unless (equal observed baseline) (reject :position-or-frontier))
  t)
(defun check-directory-identity (fixture)
  (let ((stat (sb-posix:lstat (string-right-trim "/" (namestring (fixture-directory fixture))))))
    (unless (and (sb-posix:s-isdir (sb-posix:stat-mode stat))
                 (equal (stat-identity stat) (getf (first (fixture-baseline fixture)) :identity)))
      (reject :directory-identity))))
(defun verify-fixture (api fixture toggle)
  "Solo con tutti i worker terminati: byte, posizione dei nomi, inode, offset/frontiere."
  (unless (typep toggle 'bit) (reject :toggle))
  (check-directory-identity fixture)
  (let* ((directory (fixture-directory fixture))
         (active (if (zerop toggle) "source.tmp" "destination.tmp"))
         (absent (if (zerop toggle) "destination.tmp" "source.tmp"))
         (baseline (fixture-baseline fixture))
         (source-id (check-path-bytes (merge-pathnames active directory) (fixture-bytes fixture)))
         (boundary-id (check-path-bytes (merge-pathnames "boundary.tmp" directory) (fixture-boundary fixture))))
    (when (lstat-or-absent (merge-pathnames absent directory)) (reject :destination-not-absent))
    (unless (and (equal source-id (getf (second baseline) :identity))
                 (equal boundary-id (getf (fourth baseline) :identity))
                 (not (equal source-id boundary-id)))
      (reject :inode-alias-or-change))
    (check-frontiers (fixture-snapshots api fixture) baseline)
    ;; PREAD di entrambi i reader: byte controllati anche tramite le capacita mantenute.
    (loop for index in '(2 4) for expected in (list (fixture-bytes fixture) (fixture-boundary fixture)) do
      (let ((output (make-array (length expected) :element-type '(unsigned-byte 8))))
        (unless (= (length expected) (funcall (api-read api) (svref (fixture-handles fixture) index)
                                             output 0 (length expected) 0))
          (reject :reader-count))
        (check-octets output expected)))
    (check-frontiers (fixture-snapshots api fixture) baseline)
    (list :status :ok :bytes-verified +fixture-bytes+ :boundary-bytes-verified +boundary-bytes+
          :toggle toggle :active-name active :alternate-name-absent t
          :inode-preserved t :no-hardlinks t :positions-and-frontiers-unchanged t)))

(defun checked-rename (function directory source destination)
  (unless (null (funcall function directory source destination)) (reject :rename-return))
  nil)
(defun checked-flush (function directory)
  (unless (eql 0 (funcall function directory)) (reject :directory-flush-return))
  nil)
(defun prepare-file (api fixture name bytes writer-index reader-index)
  (let* ((path (merge-pathnames name (fixture-directory fixture)))
         (handles (fixture-handles fixture)))
    (when (lstat-or-absent path) (reject :fixture-not-new (namestring path)))
    (setf (svref handles writer-index) (funcall (api-create api) path))
    (if (= writer-index 1) (setf (fixture-source-owned fixture) t)
        (setf (fixture-boundary-owned fixture) t))
    (unless (= (length bytes) (funcall (api-append api) (svref handles writer-index)
                                      bytes 0 (length bytes)))
      (reject :fixture-write))
    (unless (= (length bytes) (funcall (api-flush api) (svref handles writer-index)))
      (reject :fixture-flush))
    (setf (svref handles reader-index) (funcall (api-reader api) path))))
(defun prepare-fixture (run fixture)
  "Fixture gia registrata dal main: tutte le acquisizioni restano tracciate se fallisce."
  (let ((api (run-api run)) (path (fixture-directory fixture)))
    (require-time (run-deadline run))
    (sb-posix:mkdir (namestring path) #o700)
    (setf (fixture-owned fixture) t
          (svref (fixture-handles fixture) 0) (funcall (api-directory api) path))
    (prepare-file api fixture "source.tmp" (fixture-bytes fixture) 1 2)
    (require-time (run-deadline run))
    (prepare-file api fixture "boundary.tmp" (fixture-boundary fixture) 3 4)
    (checked-flush (api-flush api) (svref (fixture-handles fixture) 0))
    (setf (fixture-baseline fixture) (fixture-snapshots api fixture))
    (check-initial-frontiers (fixture-baseline fixture))
    (verify-fixture api fixture 0)
    ;; Roundtrip nativo cold: rileva un callback no-op prima di ammettere la misura.
    (checked-rename (api-rename api) (svref (fixture-handles fixture) 0) "source.tmp" "destination.tmp")
    (verify-fixture api fixture 1)
    (require-time (run-deadline run))
    (checked-rename (api-rename api) (svref (fixture-handles fixture) 0) "destination.tmp" "source.tmp")
    (verify-fixture api fixture 0)))
(defun prepare-fixtures (run)
  (check-name-pair "source.tmp" "destination.tmp")
  (dotimes (id 4)
    (let ((fixture (make-fixture :id id
                     :directory (merge-pathnames (format nil "reader-~D/" id) (run-directory run))
                     :bytes (fixture-octets +fixture-bytes+ id 17)
                     :boundary (fixture-octets +boundary-bytes+ id 193))))
      (setf (svref (run-fixtures run) id) fixture)
      (prepare-fixture run fixture)))
  (let ((identities nil))
    (loop for fixture across (run-fixtures run) do
      ;; Due handle per file sono intenzionali; le TRE foglie filesystem sono distinte.
      (dolist (index '(0 1 3))
        (let ((identity (getf (nth index (fixture-baseline fixture)) :identity)))
          (push identity identities))))
    (check-distinct-identities identities))
  t)

(defun check-stop (group)
  (when (= 1 (sb-thread:barrier (:read) (group-stop group))) (expire :cancelled))
  (when (>= (get-internal-real-time) (group-deadline group)) (expire :window-deadline)))
(defun request-stop (group)
  ;; OWNER: solo main scrive; i worker leggono, senza lock/scritture per operazione.
  (sb-thread:barrier (:write))
  (setf (group-stop group) 1))
(defun record-rename (raw forward-p)
  "Progresso registrato dopo un ritorno NIL: rename e ciclo sono contatori distinti."
  (incf (raw-renames raw))
  (if forward-p (incf (raw-forward raw)) (incf (raw-backward raw)))
  (setf (raw-toggle raw) (logxor 1 (raw-toggle raw)))
  (incf (raw-toggle-sum raw) (raw-toggle raw)))
(defun rename-step (api directory mode group raw forward-p)
  (check-stop group)
  (unless (= (raw-toggle raw) (if forward-p 0 1)) (reject :sequence-oracle))
  (incf (raw-attempted raw))
  (checked-rename (api-rename api) directory
                  (if forward-p "source.tmp" "destination.tmp")
                  (if forward-p "destination.tmp" "source.tmp"))
  (record-rename raw forward-p)
  (when (eq mode :rename-and-directory-fsync)
    (check-stop group)
    (checked-flush (api-flush api) directory)
    (incf (raw-flushes raw))))
(defun run-loop (api fixture mode group raw)
  (let ((directory (svref (fixture-handles fixture) 0)))
    (dotimes (cycle +iterations+)
      (rename-step api directory mode group raw t)
      (rename-step api directory mode group raw nil)
      (incf (raw-iterations raw))))
  :terminated)
(defun worker-entry (api fixture mode group raw)
  "Confine worker: conserva errore/progresso, non chiude FD e non elimina fixture."
  (handler-case
      (progn
        (sb-thread:signal-semaphore (group-ready group))
        (unless (sb-thread:wait-on-semaphore (group-gate group)
                                            :timeout (remaining (group-deadline group)))
          (expire :start-gate))
        (run-loop api fixture mode group raw))
    (error (condition) (setf (raw-failure raw) condition)))
  (setf (raw-terminated raw) t)
  :terminated)
(defun all-workers-terminated-p (group)
  (let ((done (or (null group)
                  (notany (lambda (thread) (and thread (sb-thread:thread-alive-p thread)))
                          (group-threads group)))))
    (when done (sb-thread:barrier (:read)))
    done))
(defun join-started (group)
  "Ogni join e bounded dalla medesima deadline della finestra. Nessuna terminazione forzata."
  (loop for thread across (group-threads group) do
    (when thread
      (unless (eq :terminated (sb-thread:join-thread thread :timeout (remaining (group-deadline group))
                                                          :default :join-timeout))
        (expire :join)))))
(defun parallel-action (group entries names)
  ;; Nessun timeout asincrono: un thread viene registrato subito dopo make-thread.
  (dotimes (id (length entries))
    (check-stop group)
    (setf (svref (group-threads group) id)
          (sb-thread:make-thread (svref entries id) :name (svref names id))))
  (dotimes (id (length entries))
    (unless (sb-thread:wait-on-semaphore (group-ready group)
                                        :timeout (remaining (group-deadline group)))
      (expire :ready-gate)))
  (check-stop group)
  (sb-thread:signal-semaphore (group-gate group) (length entries))
  (join-started group))
(defun observe-action (group action)
  "Clock wall e heap aggregati del processo; stop/rilascio gate/join bounded inclusi."
  (let ((start (get-internal-real-time)) (before (sb-ext:get-bytes-consed)) (failure nil))
    ;; Confine del coordinatore: l'errore resta nel raw, nessuna close su worker vivo.
    (handler-case (funcall action)
      (error (condition)
        (setf failure condition)
        (request-stop group)
        (sb-thread:signal-semaphore (group-gate group) (length (group-raws group)))
        (handler-case (join-started group)
          (error (join-condition)
            ;; Non rimpiazza un errore reale con un semplice esaurimento della deadline.
            (when (typep failure 'bench-deadline) (setf failure join-condition))))))
    (let ((heap (- (sb-ext:get-bytes-consed) before))
          (ticks (- (get-internal-real-time) start)))
      (list :raw-ticks ticks :seconds (/ ticks (float internal-time-units-per-second 1d0))
            :heap-bytes heap :clock-scope :whole-process-wall :heap-scope :whole-process
            :deadline-expired (not (plusp (remaining (group-deadline group))))
            :coordinator-error-kind (cond ((null failure) nil)
                                           ((typep failure 'bench-deadline) :deadline)
                                           (t :error))
            :diagnostic (when failure (diagnostic failure))))))

(defun require-fields (record fields)
  (unless (and (listp record) (evenp (length record))
               (loop for tail on record by #'cddr always (keywordp (car tail))))
    (reject :record-shape))
  (dolist (field fields)
    (unless (nth-value 0 (get-properties record (list field)))
      (reject :missing-field (symbol-name field))))
  record)
(defun require-schema (record kind)
  (require-fields record '(:schema-version :kind :status))
  (unless (and (eql 1 (getf record :schema-version)) (eq kind (getf record :kind))
               (member (getf record :status) '(:running :ok :failed :incomplete)))
    (reject :record-schema))
  record)
(defun check-worker-record (record mode)
  "Oracolo di prefisso: attempted, due direzioni, toggle, somma toggle e cicli completi."
  (require-schema record :io-rename-worker)
  (require-fields record '(:reader-id :requested-cycles :requested-renames :terminated :error-kind
                          :attempted-renames :completed-renames :completed-cycles :forward :backward
                          :directory-fsyncs :toggle :toggle-sum :checks :diagnostic))
  (unless (and (typep (getf record :reader-id) '(integer 0 3))
               (typep (getf record :terminated) 'boolean)
               (eql +iterations+ (getf record :requested-cycles))
               (eql (* 2 +iterations+) (getf record :requested-renames))
               (member mode '(:rename-only :rename-and-directory-fsync))
               (member (getf record :error-kind) '(nil :deadline :error :not-terminated)))
    (reject :worker-params))
  (unless (getf record :terminated) (return-from check-worker-record record))
  (dolist (field '(:attempted-renames :completed-renames :completed-cycles :forward
                  :backward :directory-fsyncs :toggle :toggle-sum))
    (unless (typep (getf record field) '(integer 0 256)) (reject :counter-range)))
  (let ((n (getf record :completed-renames)) (a (getf record :attempted-renames))
        (f (getf record :forward)) (b (getf record :backward)) (c (getf record :completed-cycles))
        (flushes (getf record :directory-fsyncs)))
    (unless (and (<= n a (min 256 (1+ n))) (= f (ceiling n 2)) (= b (floor n 2))
                 (<= (max 0 (1- b)) c b)) (reject :count-oracle))
    (unless (and (= (getf record :toggle) (mod n 2)) (= (getf record :toggle-sum) f))
      (reject :toggle-oracle))
    (unless (if (eq mode :rename-only) (zerop flushes) (<= (max 0 (1- n)) flushes n))
      (reject :fsync-oracle)))
  record)
(defun classify-worker (record mode)
  "Nessuna pretesa zero heap. Errore/oracolo fallito => failed; prefisso => incomplete."
  (handler-case
      (progn
        (check-worker-record record mode)
        (cond ((not (getf record :terminated)) :incomplete)
              ((eq :error (getf record :error-kind)) :failed)
              ((not (eq :ok (getf (getf record :checks) :status))) :failed)
              ((getf record :error-kind) :incomplete)
              ((or (/= +iterations+ (getf record :completed-cycles))
                   (/= (* 2 +iterations+) (getf record :completed-renames))) :incomplete)
              ((and (eq mode :rename-and-directory-fsync)
                    (/= (* 2 +iterations+) (getf record :directory-fsyncs))) :incomplete)
              (t :ok)))
    (bench-failure (condition) (values :failed (failure-reason condition)))))
(defun worker-record (api fixture raw mode quiescent)
  "Nessuna lettura di raw o capacita se il gruppo ha ancora un worker vivo."
  (let* ((failure (when quiescent (raw-failure raw)))
         (record (list :schema-version 1 :kind :io-rename-worker :status :running
                       :reader-id (fixture-id fixture) :requested-cycles +iterations+
                       :requested-renames (* 2 +iterations+) :terminated (and quiescent (raw-terminated raw))
                       :raw-observability (if quiescent :observed :unavailable-worker-alive)
                       :error-kind (cond ((not quiescent) :not-terminated)
                                         ((null failure) nil) ((typep failure 'bench-deadline) :deadline)
                                         (t :error))
                       :attempted-renames (when quiescent (raw-attempted raw))
                       :completed-renames (when quiescent (raw-renames raw))
                       :completed-cycles (when quiescent (raw-iterations raw))
                       :forward (when quiescent (raw-forward raw)) :backward (when quiescent (raw-backward raw))
                       :directory-fsyncs (when quiescent (raw-flushes raw)) :toggle (when quiescent (raw-toggle raw))
                       :toggle-sum (when quiescent (raw-toggle-sum raw)) :checks nil
                       :diagnostic (when failure (diagnostic failure)))))
    (when (and quiescent (raw-terminated raw))
      (handler-case (setf (getf record :checks) (verify-fixture api fixture (raw-toggle raw)))
        (error (condition)
          (setf (getf record :checks) (list :status :failed :diagnostic (diagnostic condition))))))
    (multiple-value-bind (status reason) (classify-worker record mode)
      (setf (getf record :status) status (getf record :classification-reason) reason))
    record))
(defun check-window-totals (record)
  (require-fields record '(:execution :requested-cycles :requested-renames :completed-cycles
                          :completed-renames :directory-fsyncs :final-oracles-outside-clock))
  (let ((readers (getf record :readers)) (workers (getf record :workers)))
    (unless (and (eq (getf record :execution) (if (= readers 1) :serial :parallel))
                 (eql (* readers +iterations+) (getf record :requested-cycles))
                 (eql (* readers 2 +iterations+) (getf record :requested-renames))
                 (getf record :final-oracles-outside-clock))
      (reject :window-totals))
    (when (and (getf record :quiescent) (= readers (length workers)))
      (dolist (field '(:completed-cycles :completed-renames :directory-fsyncs))
        (let ((values (mapcar (lambda (worker) (getf worker field)) workers)))
          (unless (and (every (lambda (value) (typep value '(integer 0 *))) values)
                       (eql (getf record field) (reduce #'+ values)))
            (reject :window-totals)))))
    (when (not (getf record :quiescent))
      (unless (and (null (getf record :completed-cycles)) (null (getf record :completed-renames))
                   (null (getf record :directory-fsyncs)))
        (reject :nonquiescent-observation))))
  record)
(defun classify-window (record)
  (handler-case
      (progn
        (require-schema record :io-rename-window)
        (require-fields record '(:mode :readers :replica :workers :quiescent :raw-ticks :seconds
                                :heap-bytes :clock-scope :heap-scope :deadline-expired
                                :coordinator-error-kind :startup-gate-join-in-clock))
        (unless (and (member (getf record :mode) '(:rename-only :rename-and-directory-fsync))
                     (member (getf record :readers) '(1 2 4)) (typep (getf record :replica) '(integer 1 5))
                     (typep (getf record :raw-ticks) '(integer 0 *))
                     (typep (getf record :heap-bytes) '(integer 0 *))
                     (eql (getf record :seconds) (/ (getf record :raw-ticks)
                                                   (float internal-time-units-per-second 1d0)))
                     (eq :whole-process-wall (getf record :clock-scope))
                     (eq :whole-process (getf record :heap-scope))
                     (typep (getf record :quiescent) 'boolean)
                     (typep (getf record :deadline-expired) 'boolean)
                     (member (getf record :coordinator-error-kind) '(nil :deadline :error))
                     (eq (getf record :startup-gate-join-in-clock) (> (getf record :readers) 1)))
          (reject :window-metrics))
        (let ((workers (getf record :workers)) (mode (getf record :mode)))
          (when (or (> (length workers) (getf record :readers))
                    (/= (length workers) (length (remove-duplicates workers :key (lambda (x) (getf x :reader-id))))))
            (reject :worker-inventory))
          (loop for worker in workers for id from 0 do
            (unless (eql id (getf worker :reader-id)) (reject :worker-inventory)))
          (check-window-totals record)
          (cond ((eq :error (getf record :coordinator-error-kind)) :failed)
                ((some (lambda (worker) (eq :failed (classify-worker worker mode))) workers) :failed)
                ((or (not (getf record :quiescent)) (getf record :deadline-expired)
                     (> (getf record :seconds) +window-seconds+)
                     (getf record :coordinator-error-kind) (/= (length workers) (getf record :readers))
                     (some (lambda (worker) (eq :incomplete (classify-worker worker mode))) workers)) :incomplete)
                (t :ok))))
    (bench-failure (condition) (values :failed (failure-reason condition)))))
(defun rename-rate (status completed ticks seconds)
  "Niente tasso per finestre fallite/incomplete o clock sotto risoluzione."
  (when (and (eq status :ok) (plusp ticks)) (/ completed seconds)))
(defun window-record (run group mode readers replica sample)
  (let* ((quiescent (all-workers-terminated-p group))
         (workers (loop for id below readers collect
                        (worker-record (run-api run) (svref (run-fixtures run) id)
                                       (svref (group-raws group) id) mode quiescent)))
         (record (append (list :schema-version 1 :kind :io-rename-window :status :running
                              :mode mode :readers readers :execution (if (= readers 1) :serial :parallel)
                              :replica replica :requested-cycles (* readers +iterations+)
                              :requested-renames (* readers 2 +iterations+) :quiescent quiescent
                              :startup-gate-join-in-clock (> readers 1) :final-oracles-outside-clock t
                              :workers workers) sample)))
    (sb-thread:barrier (:memory))
    (setf (getf record :completed-cycles) (when quiescent (reduce #'+ workers :key (lambda (x) (getf x :completed-cycles))))
          (getf record :completed-renames) (when quiescent (reduce #'+ workers :key (lambda (x) (getf x :completed-renames))))
          (getf record :directory-fsyncs) (when quiescent (reduce #'+ workers :key (lambda (x) (getf x :directory-fsyncs)))))
    (multiple-value-bind (status reason) (classify-window record)
      (setf (getf record :status) status (getf record :classification-reason) reason))
    (setf (getf record :time-quality) (if (zerop (getf record :raw-ticks)) :below-resolution :measured)
          (getf record :renames-per-second)
          (rename-rate (getf record :status) (getf record :completed-renames)
                       (getf record :raw-ticks) (getf record :seconds)))
    record))
(defun run-window (run mode readers replica)
  "Cold verifica/GC/preallocazione; clock comprende thread creation, gate e bounded join."
  (require-time (run-deadline run))
  (unless (all-workers-terminated-p (run-active run)) (reject :previous-worker-alive))
  (dotimes (id readers) (verify-fixture (run-api run) (svref (run-fixtures run) id) 0))
  (sb-ext:gc :full t)
  (require-time (run-deadline run))
  (let* ((group (make-group :deadline (min (run-deadline run)
                              (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second)))
                            :threads (make-array readers :initial-element nil)
                            :raws (make-array readers :initial-element nil)))
         (entries (make-array readers)) (names (make-array readers)))
    (dotimes (id readers)
      (let ((fixture (svref (run-fixtures run) id)) (raw (make-raw)))
        (setf (svref (group-raws group) id) raw
              (svref entries id) (lambda () (worker-entry (run-api run) fixture mode group raw))
              (svref names id) (format nil "io-rename-reader-~D" id))))
    (setf (run-active run) group)
    (let* ((action (if (= readers 1)
                       (lambda ()
                         (handler-case (run-loop (run-api run) (svref (run-fixtures run) 0)
                                                 mode group (svref (group-raws group) 0))
                           (error (condition) (setf (raw-failure (svref (group-raws group) 0)) condition)))
                         (setf (raw-terminated (svref (group-raws group) 0)) t))
                       (lambda () (parallel-action group entries names))))
           (sample (observe-action group action)))
      (window-record run group mode readers replica sample))))

(defun report-text (record)
  (let ((text (with-output-to-string (stream)
                (let ((*print-readably* t) (*print-pretty* t) (*print-length* nil) (*print-level* nil))
                  (write record :stream stream) (terpri stream)))))
    (when (> (length text) +max-report-characters+) (reject :report-budget))
    text))
(defun decode-own-report (text)
  "Solo testo prodotto dal tool/fixture self-test, mai input Lisp esterno; read-eval NIL."
  (when (> (length text) +max-report-characters+) (reject :report-budget))
  (with-input-from-string (stream text)
    (let* ((*read-eval* nil) (*package* (find-package :cl-user))
           (record (read stream nil :eof)) (end (read stream nil :eof)))
      (unless (and (listp record) (eq :eof end)) (reject :report-roundtrip))
      record)))
(defun checked-report-roundtrip (record)
  (require-fields record '(:schema-version :kind :status :params :windows :limits :source :environment))
  (unless (member (getf record :kind) '(:io-rename-benchmark :io-rename-self-test))
    (reject :record-schema))
  (require-schema record (getf record :kind))
  (let* ((text (report-text record)) (decoded (decode-own-report text)))
    (unless (equal record decoded) (reject :report-roundtrip))
    text))
(defun write-report (report run)
  "Checkpoint raw cold; source/environment solo al livello campagna, mai dentro ogni window."
  (unless (all-workers-terminated-p (run-active run))
    (reject :report-worker-alive "raw finale disponibile su stdout; nessun FD aperto/chiuso per checkpoint"))
  (let* ((path (merge-pathnames "report.lisp" (run-directory run)))
         (temporary (merge-pathnames "report.lisp.tmp" (run-directory run)))
         (text (checked-report-roundtrip report)))
    (with-open-file (stream temporary :direction :output :external-format :utf-8
                            :if-exists :error :if-does-not-exist :create)
      (write-string text stream))
    (unless (eql 0 (sb-posix:rename (namestring temporary) (namestring path)))
      (reject :report-rename))
    (with-open-file (stream path :direction :input :external-format :utf-8)
      (unless (= (file-length stream) (length (sb-ext:string-to-octets text :external-format :utf-8)))
        (reject :report-roundtrip))
      (let ((stored (make-string (length text))))
        (unless (= (read-sequence stored stream) (length text)) (reject :report-roundtrip))
        (unless (eq :eof (read-char stream nil :eof)) (reject :report-roundtrip))
        (unless (equal report (decode-own-report stored)) (reject :report-roundtrip)))))
  report)

(defun close-fixture-handles (api fixture)
  "Chiamato solo dopo quiescenza globale; una sola close per handle anche su guasto."
  (let ((failures nil))
    (dotimes (index (length (fixture-handles fixture)))
      (let ((handle (svref (fixture-handles fixture) index)))
        (when handle
          (setf (svref (fixture-handles fixture) index) nil)
          ;; Confine rilascio risorse: conserva ogni errore, continua sulle altre capacita.
          (handler-case
              (unless (null (funcall (api-close api) handle)) (reject :close-return))
            (error (condition) (push (diagnostic condition) failures))))))
    (nreverse failures)))
(defun unlink-owned-leaf (directory name)
  "Solo foglie note della fixture in namespace 0700 esclusivo; nessuna scansione ricorsiva."
  (let ((path (merge-pathnames name directory)))
    (when (lstat-or-absent path)
      (unless (eql 0 (sb-posix:unlink (namestring path))) (reject :cleanup-unlink)))))
(defun remove-fixture (fixture)
  (when (fixture-owned fixture)
    (let ((path (fixture-directory fixture)))
      (when (fixture-source-owned fixture)
        (unlink-owned-leaf path "source.tmp") (unlink-owned-leaf path "destination.tmp"))
      (when (fixture-boundary-owned fixture) (unlink-owned-leaf path "boundary.tmp"))
      (unless (eql 0 (sb-posix:rmdir (namestring path))) (reject :cleanup-rmdir))
      (setf (fixture-owned fixture) nil))))
(defun cleanup-run (run)
  "Nessun fallback: un solo worker vivo impedisce TUTTE le close/unlink/rmdir, incluso il lock."
  (unless (all-workers-terminated-p (run-active run))
    (return-from cleanup-run
      (list :status :incomplete :quiescent nil :action :retained-worker-alive
            :lock-retained (run-lock-owned run) :resources-until-process-exit t)))
  (let ((failures nil) (retained nil))
    (loop for fixture across (run-fixtures run) do
      (when fixture
        (let ((close-failures (close-fixture-handles (run-api run) fixture)))
          (setf failures (append failures close-failures))
          (if close-failures (push (namestring (fixture-directory fixture)) retained)
              (handler-case (remove-fixture fixture)
                (error (condition)
                  (push (diagnostic condition) failures)
                  (push (namestring (fixture-directory fixture)) retained)))))))
    (when (and (null failures) (run-lock-owned run))
      (handler-case
          (progn
            (unless (eql 0 (sb-posix:rmdir (namestring (run-lock run)))) (reject :lock-release))
            (setf (run-lock-owned run) nil))
        (error (condition) (push (diagnostic condition) failures))))
    (list :status (if failures :failed :ok) :quiescent t
          :action (if failures :retained-cleanup-error :fixture-resources-released)
          :diagnostics failures :retained-fixture-paths (nreverse retained)
          :lock-retained (run-lock-owned run) :raw-and-private-fasl-retained (not (null (run-directory run))))))

(defun source-description (mode args)
  (list :driver "tools/io-rename-bench.lisp" :product-system "arcdocdb" :subsystem "src/io/"
        :argv (copy-list args) :registration :outer-recorder :provenance :outer-recorder
        :source-freeze :required-before-process-start :inventory :outer-recorder-only
        :product-load-requested (string= mode "--bench") :test-op-invoked nil
        :prerequisites :self-test-and-controls-passed-in-separate-processes
        :prerequisite-attestation :outer-recorder :self-test-in-benchmark-process nil
        :api-contract '(:return nil :directory-fd-local :renameat-same-directory
                        :rename-no-implicit-fsync :durable-flush-separate
                        :no-edit-decision-or-file-validity-attestation :no-complete-checkpoint)))
(defun environment-description (root)
  (list :lisp (lisp-implementation-type) :version (lisp-implementation-version)
        :machine (machine-type) :cpu (machine-version) :os (software-type) :os-version (software-version)
        :root (namestring root) :cwd (namestring (truename "./"))
        :pid (sb-posix:getpid) :external-load :uncontrolled
        :safety 3 :speed 2 :debug 2 :timer :get-internal-real-time
        :timer-units-per-second internal-time-units-per-second
        :clock-scope :whole-process-wall :heap-counter :sb-ext-get-bytes-consed
        :heap-scope :whole-process :heap-is :allocated-bytes-not-live-heap-or-rss
        :private-fasl-cache nil :product-load-status :not-attempted
        :asdf-force t :warning-and-style-warning-policy :fatal))
(defun new-report (mode args root)
  (list :schema-version 1 :kind (if (string= mode "--self-test") :io-rename-self-test :io-rename-benchmark)
        :status :running :exit-code nil :mode mode :recorded-at (get-universal-time)
        :params (list :cycles-per-reader +iterations+ :renames-per-cycle 2
                      :renames-per-reader (* 2 +iterations+) :replicas +replicas+ :readers '(1 2 4)
                      :native-rename-syscalls-per-successful-api-call 1
                      :attempted-counter-unit :api-invocations :completed-counter-unit :nil-api-returns
                      :modes '(:rename-only :rename-and-directory-fsync) :expected-windows 30
                      :fixture-bytes +fixture-bytes+ :boundary-bytes +boundary-bytes+
                      :warmup-cycles 0 :cold-native-roundtrip-renames-per-directory 2
                      :window-seconds +window-seconds+ :campaign-seconds +campaign-seconds+
                      :fixed-count-no-adaptation t)
        :windows nil :source (source-description mode args) :environment (environment-description root)
        :limits '(:native-local-filesystem :reserved-physical-namespace :exclusive-run-lock
                  :same-pair-forward-backward :no-hardlink-or-independent-directory-inode-alias
                  :source-prepared-and-verified-outside-clock :byte-writes-and-setup-excluded
                  :full-gc-outside-clock :final-byte-name-identity-position-frontier-oracles-outside-clock
                  :cooperative-deadlines-not-hard-syscall-timeouts :outer-process-timeout-required
                  :startup-gate-join-in-parallel-clock :whole-process-wall-and-allocated-heap
                  :no-zero-heap-criterion-for-metadata-path :warm-local-os-cache :fixed-order
                  :syscall-count-derived-from-native-one-call-contract-not-traced
                  :no-db-throughput-claim :no-power-loss-durability-claim :no-checkpoint-protocol
                  :return-and-toggle-do-not-prove-all-intermediate-filesystem-states
                  :no-external-load-control :no-latency-distribution :no-performance-threshold)
        :resource-limits (list :max-workers 4 :fixture-directories 4 :fixture-handles 20
                               :fixture-file-bytes (* 4 (+ +fixture-bytes+ +boundary-bytes+))
                               :max-report-characters +max-report-characters+
                               :fasl-cache-budget :product-build-dependent :cleanup :quiescence-required)
        :namespace nil :physical-namespace nil :lock nil :fixtures nil :phase :arguments
        :current-window nil :last-phase nil :self-test nil :final-oracles nil :cleanup nil :persistence :not-written
        :diagnostic nil))
(defun fixture-inventory (run)
  "Un solo inventario cold nel report: non si copia in finestre, source o environment."
  (loop for fixture across (run-fixtures run) collect
    (list :reader-id (fixture-id fixture) :directory (namestring (fixture-directory fixture))
          :source "source.tmp" :destination "destination.tmp" :boundary "boundary.tmp"
          :baseline (copy-tree (fixture-baseline fixture)) :cold-roundtrip-verified t)))
(defun classify-campaign (windows)
  (let ((statuses (mapcar #'classify-window windows)))
    (cond ((member :failed statuses) :failed)
          ((or (/= (length windows) 30) (member :incomplete statuses)) :incomplete)
          (t
            (let ((cells (mapcar (lambda (x) (list (getf x :mode) (getf x :readers) (getf x :replica))) windows)))
              (if (= 30 (length (remove-duplicates cells :test #'equal))) :ok :failed))))))
(defun benchmark (run report)
  (setf (getf report :phase) :load-product
        (getf (getf report :environment) :product-load-status) :running)
  (setf (run-api run) (load-product run)
        (getf (getf report :environment) :product-load-status) :ok)
  (require-time (run-deadline run))
  (setf (getf report :phase) :prepare-fixture)
  (prepare-fixtures run)
  (setf (getf report :fixtures) (fixture-inventory run))
  (write-report report run)
  (dolist (mode '(:rename-only :rename-and-directory-fsync))
    (dolist (readers '(1 2 4))
      (dotimes (replica +replicas+)
        (require-time (run-deadline run))
        (setf (getf report :phase) :window
              (getf report :current-window) (list :mode mode :readers readers :replica (1+ replica)))
        (let ((window (run-window run mode readers (1+ replica))))
          (setf (getf report :windows) (append (getf report :windows) (list window)))
          (when (all-workers-terminated-p (run-active run)) (write-report report run))
          (unless (eq :ok (getf window :status))
            (setf (getf report :status) (getf window :status))
            (return-from benchmark report))))))
  (setf (getf report :phase) :final-oracles)
  (require-time (run-deadline run))
  (setf (getf report :final-oracles)
        (loop for fixture across (run-fixtures run) collect (verify-fixture (run-api run) fixture 0)))
  (require-time (run-deadline run))
  (setf (getf report :status) (classify-campaign (getf report :windows)))
  report)

(defun expect-rejection (function reason)
  "COD-60: ogni negativo esige la ragione specifica, non un errore estraneo."
  (let ((rejected nil))
    (handler-case (funcall function)
      (bench-failure (condition)
        (unless (eq reason (failure-reason condition)) (error condition))
        (setf rejected t)))
    (unless rejected (reject :self-test (format nil "negativo non rilevato: ~S" reason)))
    t))
(defun expect-status (expected actual)
  (unless (eq expected actual)
    (reject :self-test (format nil "classificatore: atteso ~S, osservato ~S" expected actual)))
  t)
(defun synthetic-worker (id mode &optional (renames 256))
  "Fixture dichiaratamente sintetica: nessuna syscall o misura, contatori letterali attesi."
  (list :schema-version 1 :kind :io-rename-worker :status :running :reader-id id
        :requested-cycles 128 :requested-renames 256 :terminated t :error-kind nil
        :attempted-renames renames :completed-renames renames :completed-cycles (floor renames 2)
        :forward (ceiling renames 2) :backward (floor renames 2) :toggle (mod renames 2)
        :toggle-sum (ceiling renames 2) :directory-fsyncs (if (eq mode :rename-only) 0 renames)
        :checks '(:status :ok :origin :synthetic) :diagnostic nil))
(defun synthetic-window (readers mode replica)
  (list :schema-version 1 :kind :io-rename-window :status :running :origin :synthetic
        :mode mode :readers readers :replica replica :quiescent t
        :execution (if (= readers 1) :serial :parallel) :final-oracles-outside-clock t
        :requested-cycles (* 128 readers) :requested-renames (* 256 readers)
        :completed-cycles (* 128 readers) :completed-renames (* 256 readers)
        :directory-fsyncs (if (eq mode :rename-only) 0 (* 256 readers))
        :raw-ticks internal-time-units-per-second :seconds 1d0 :heap-bytes 65536
        :clock-scope :whole-process-wall :heap-scope :whole-process
        :deadline-expired nil :coordinator-error-kind nil :startup-gate-join-in-clock (> readers 1)
        :workers (loop for id below readers collect (synthetic-worker id mode))))
(defun self-test-errors-and-names ()
  (dolist (pair '(("a" "b") ("source.tmp" "destination.tmp")))
    (check-name-pair (first pair) (second pair)))
  (check-name-pair (make-string 255 :initial-element #\a) "b")
  (dolist (name (list "" "." ".." "a/b" (string #\Null)
                     (make-string 256 :initial-element #\a) (string (code-char 128))))
    (expect-rejection (lambda () (check-name-pair name "b")) :name-oracle))
  (expect-rejection (lambda () (check-name-pair "same" "same")) :name-oracle)
  (expect-rejection (lambda () (checked-rename (lambda (&rest args) (length args)) nil "a" "b"))
                    :rename-return)
  (expect-rejection (lambda () (checked-flush (lambda (directory) (if directory 1 -1)) nil))
                    :directory-flush-return)
  (expect-rejection (lambda () (checked-rename
                                (lambda (&rest args) (reject :injected-call-error (format nil "~S" args)))
                                nil "a" "b")) :injected-call-error)
  (let ((seen nil))
    (handler-case
        (checked-rename (lambda (&rest args)
                          (error 'sb-posix:syscall-error :errno sb-posix:eio :name (first args)))
                        :synthetic-rename "a" "b")
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eio (sb-posix:syscall-errno condition)) (error condition))
        (setf seen t)))
    (unless seen (reject :self-test "syscall-error sintetico perso")))
  (list :case :errors-and-name-oracle :status :ok :invalid-names-rejected 8
        :wrong-rename-and-flush-results-rejected t :call-error-and-errno-preserved t))
(defun self-test-oracles ()
  (let* ((expected (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(0 127 255 17)))
         (observed (copy-seq expected)))
    (check-octets observed expected)
    (dotimes (index 4)
      (setf (aref observed index) (logxor 1 (aref observed index)))
      (expect-rejection (lambda () (check-octets observed expected)) :byte-content)
      (setf (aref observed index) (aref expected index)))
    (expect-rejection (lambda () (check-octets (subseq observed 0 3) expected)) :byte-length))
  (check-file-shape t 1 4096 4096)
  (dolist (shape '((nil 1 4096) (t 2 4096) (t 1 4095)))
    (expect-rejection (lambda () (check-file-shape (first shape) (second shape) (third shape) 4096))
                      :file-shape))
  (check-distinct-identities '((7 11) (7 12) (8 11)))
  (expect-rejection (lambda () (check-distinct-identities '((7 11) (7 11)))) :independent-directory-alias)
  (let ((baseline '(:fd 41 :state :open :written 4096 :durable 4096 :offset 4096)))
    (check-frontiers baseline (copy-list baseline))
    (dolist (field '(:fd :written :durable :offset))
      (let ((altered (copy-list baseline)))
        (setf (getf altered field) 4095)
        (expect-rejection (lambda () (check-frontiers altered baseline)) :position-or-frontier))))
  (list :case :byte-inode-position-frontier-oracles :status :ok
        :every-altered-byte-and-short-buffer-rejected t :nonregular-hardlink-size-rejected t
        :same-inode-alias-rejected t :fd-written-durable-native-offset-rejected t))
(defun self-test-worker-classifier ()
  (dolist (mode '(:rename-only :rename-and-directory-fsync))
    (expect-status :ok (classify-worker (synthetic-worker 0 mode) mode))
    (expect-status :incomplete (classify-worker (synthetic-worker 0 mode 50) mode))
    (dolist (field '(:toggle :toggle-sum :forward :completed-cycles :directory-fsyncs))
      (let ((broken (synthetic-worker 0 mode)))
        (incf (getf broken field))
        (expect-status :failed (classify-worker broken mode))))
    (let ((broken (synthetic-worker 0 mode)))
      (remf broken :completed-renames)
      (expect-rejection (lambda () (check-worker-record broken mode)) :missing-field)
      (expect-status :failed (classify-worker broken mode)))
    (let ((broken (synthetic-worker 0 mode)))
      (setf (getf broken :error-kind) :error)
      (expect-status :failed (classify-worker broken mode)))
    (let ((partial (synthetic-worker 0 mode 51)))
      (setf (getf partial :error-kind) :deadline)
      (expect-status :incomplete (classify-worker partial mode)))
    (let ((alive (synthetic-worker 0 mode)))
      (setf (getf alive :terminated) nil (getf alive :completed-renames) nil)
      (expect-status :incomplete (classify-worker alive mode))))
  (list :case :worker-classifier :status :ok :two-scenarios t
        :complete-accepted t :prefix-timeout-and-alive-incomplete t
        :missing-counter-wrong-toggle-direction-cycle-fsync-and-error-failed t))
(defun self-test-window-classifier ()
  (let ((good (synthetic-window 2 :rename-only 1)))
    (expect-status :ok (classify-window good)) ; Heap positivo consentito, e whole process.
    (let ((partial (copy-tree good)))
      (setf (getf partial :workers) (butlast (getf partial :workers)))
      (expect-status :incomplete (classify-window partial)))
    (dolist (field '(:deadline-expired :quiescent))
      (let ((partial (copy-tree good)))
        (setf (getf partial field) (eq field :deadline-expired))
        (when (eq field :quiescent)
          (setf (getf partial :completed-cycles) nil (getf partial :completed-renames) nil
                (getf partial :directory-fsyncs) nil))
        (expect-status :incomplete (classify-window partial))))
    (let ((broken (copy-tree good)))
      (setf (getf (second (getf broken :workers)) :reader-id) 0)
      (expect-status :failed (classify-window broken)))
    (let ((broken (copy-tree good)))
      (setf (getf broken :heap-bytes) -1)
      (expect-status :failed (classify-window broken)))
    (let ((broken (copy-tree good)))
      (incf (getf broken :completed-renames))
      (expect-status :failed (classify-window broken)))
    (let ((below-resolution (copy-tree good)))
      (setf (getf below-resolution :raw-ticks) 0 (getf below-resolution :seconds) 0d0)
      (expect-status :ok (classify-window below-resolution))
      (unless (null (rename-rate :ok 512 0 0d0)) (reject :self-test "tasso inventato sotto risoluzione")))
    (let ((expired (copy-tree good)))
      (setf (getf expired :raw-ticks) (* 31 internal-time-units-per-second)
            (getf expired :seconds) 31d0)
      (expect-status :incomplete (classify-window expired)))
    (unless (and (= 512d0 (rename-rate :ok 512 internal-time-units-per-second 1d0))
                 (null (rename-rate :failed 512 internal-time-units-per-second 1d0))
                 (null (rename-rate :incomplete 50 internal-time-units-per-second 1d0)))
      (reject :self-test "classificazione dei tassi errata"))
    (let ((broken (copy-tree good)))
      (remf broken :raw-ticks)
      (expect-status :failed (classify-window broken))))
  (let ((windows (loop for mode in '(:rename-only :rename-and-directory-fsync) append
                   (loop for readers in '(1 2 4) append
                     (loop for replica from 1 to 5 collect (synthetic-window readers mode replica))))))
    (expect-status :ok (classify-campaign windows))
    (expect-status :incomplete (classify-campaign (butlast windows)))
    (expect-status :failed (classify-campaign (cons (first windows) (butlast windows)))))
  (list :case :window-and-campaign-classifier :status :ok :whole-process-positive-heap-accepted t
        :missing-worker-timeout-live-group-and-missing-window-incomplete t
        :duplicate-worker-cell-negative-heap-wrong-total-and-missing-clock-failed t
        :zero-ticks-accepted-without-invented-throughput t))
(defun check-model-position (table active absent expected)
  (unless (and (equal (gethash active table) expected) (null (gethash absent table)))
    (reject :model-position))
  t)
(defun self-test-rename-roundtrip ()
  "Modello in memoria distinto dal prodotto: due move, stesso payload/inode, sentinel immobile."
  (let* ((table (make-hash-table :test #'equal)) (payload '(:inode (7 11) :bytes (0 127 255 17)))
         (sentinel '(:inode (7 12) :bytes (193 230))) (calls 0) (raw (make-raw)))
    (setf (gethash "source.tmp" table) payload (gethash "boundary.tmp" table) sentinel)
    (let ((rename (lambda (directory source destination)
                    (unless (eq directory :model-directory) (reject :model-arguments))
                    (check-name-pair source destination)
                    (unless (and (gethash source table) (null (gethash destination table)))
                      (reject :model-position))
                    (setf (gethash destination table) (gethash source table))
                    (remhash source table) (incf calls) nil)))
      (check-model-position table "source.tmp" "destination.tmp" payload)
      (checked-rename rename :model-directory "source.tmp" "destination.tmp")
      (record-rename raw t)
      (check-model-position table "destination.tmp" "source.tmp" payload)
      (checked-rename rename :model-directory "destination.tmp" "source.tmp")
      (record-rename raw nil)
      (check-model-position table "source.tmp" "destination.tmp" payload))
    (unless (and (= calls 2) (= (raw-renames raw) 2) (= (raw-toggle raw) 0)
                 (= (raw-toggle-sum raw) 1) (equal (gethash "boundary.tmp" table) sentinel))
      (reject :self-test "roundtrip/toggle/sentinel incoerente"))
    ;; No-op e alias dello stesso inode devono fallire l'oracolo di posizione.
    (expect-rejection (lambda () (check-model-position table "destination.tmp" "source.tmp" payload)) :model-position)
    (setf (gethash "destination.tmp" table) payload)
    (expect-rejection (lambda () (check-model-position table "source.tmp" "destination.tmp" payload)) :model-position))
  (list :case :memory-rename-roundtrip :status :ok :cycles 1 :rename-calls 2
        :noop-and-same-inode-alias-rejected t :product-used nil))
(defun mark-late-report (run report)
  "Controllo cooperativo dopo la persistenza/emissione; non rappresenta un hard-timeout."
  (when (and (eq :ok (getf report :status)) (not (plusp (remaining (run-deadline run)))))
    (setf (getf report :status) :incomplete (getf report :exit-code) 1
          (getf report :diagnostic) "tools/io-rename-bench.lisp COD-61: campaign deadline dopo finalizzazione")
    t))
(defun self-test (report)
  "COD-60: solo errori, oracoli, classificatori e serializzazione; nessun prodotto/bench."
  (when (find-package "ARCDOCDB.IO") (reject :self-test-product-present "richiesto processo separato pulito"))
  (let ((expired (make-run :deadline 0))
        (sample (list :status :ok :exit-code 0 :diagnostic nil)))
    (unless (and (mark-late-report expired sample) (eq :incomplete (getf sample :status))
                 (= 1 (getf sample :exit-code)))
      (reject :self-test "finalizzazione tardiva promossa a OK")))
  (setf (getf report :phase) :self-test
        (getf report :self-test)
        (list :status :ok :product-loaded nil :benchmark-executed nil :threads-started 0
              :cases (list (self-test-errors-and-names) (self-test-oracles)
                           (self-test-worker-classifier) (self-test-window-classifier)
                           (self-test-rename-roundtrip))))
  (let ((probe (copy-tree report)))
    (setf (getf probe :status) :ok (getf probe :exit-code) 0)
    (checked-report-roundtrip probe)
    (let ((missing-window (copy-tree probe)))
      (remf missing-window :windows)
      (expect-rejection (lambda () (checked-report-roundtrip missing-window)) :missing-field))
    (expect-rejection (lambda () (decode-own-report "(:schema-version 1) (:extra t)")) :report-roundtrip))
  (setf (getf (getf report :self-test) :report-roundtrip-verified) t
        (getf report :status) :ok)
  report)

(defun finalize-report (run report)
  (setf (getf report :cleanup) (cleanup-run run))
  (let ((cleanup-status (getf (getf report :cleanup) :status)))
    (cond ((eq cleanup-status :failed) (setf (getf report :status) :failed))
          ((and (eq cleanup-status :incomplete) (not (eq :failed (getf report :status))))
           (setf (getf report :status) :incomplete))
          (t nil)))
  (when (and (eq :ok (getf report :status)) (not (plusp (remaining (run-deadline run)))))
    (setf (getf report :status) :incomplete
          (getf report :diagnostic) "tools/io-rename-bench.lisp COD-61: campaign deadline al termine"))
  (setf (getf report :exit-code) (if (eq :ok (getf report :status)) 0 1)
        (getf report :last-phase) (getf report :phase)
        (getf report :phase) :finished)
  (cond ((null (run-directory run)) (setf (getf report :persistence) :stdout-only))
        ((not (all-workers-terminated-p (run-active run)))
         (setf (getf report :persistence) :stdout-only-worker-alive))
        (t
          (setf (getf report :persistence) :verified)
          (handler-case (write-report report run)
            (error (condition)
              (setf (getf report :status) :failed (getf report :exit-code) 1
                    (getf report :persistence) :failed (getf report :diagnostic) (diagnostic condition))))))
  (when (mark-late-report run report)
    (when (and (run-directory run) (all-workers-terminated-p (run-active run)))
      (handler-case (write-report report run)
        (error (condition) (setf (getf report :status) :failed
                                (getf report :diagnostic) (diagnostic condition))))))
  report)
(defun main (root)
  (let* ((args (rest sb-ext:*posix-argv*)) (mode (or (first args) ""))
         (run (make-run :root root :deadline (+ (get-internal-real-time)
                                                (* +campaign-seconds+ internal-time-units-per-second))))
         (report (new-report mode args root)))
    ;; Confine processo C4: ogni fallimento produce raw leggibile, file/regola e exit != 0.
    (handler-case
        (cond ((equal args '("--self-test")) (self-test report))
              ((and (= 2 (length args)) (string= mode "--bench"))
               (unless (and (= sb-vm:n-word-bits 64) (or (member :darwin *features*) (member :linux *features*)))
                 (reject :platform "richiesto SBCL64 Linux/macOS"))
               (acquire-namespace run (second args))
               (setf (getf report :namespace) (second args)
                     (getf report :physical-namespace) (namestring (truename (run-directory run)))
                     (getf report :lock) (namestring (run-lock run))
                     (getf (getf report :environment) :private-fasl-cache)
                     (namestring (merge-pathnames "fasl/" (run-directory run))))
               (write-report report run)
               (benchmark run report))
              (t (reject :arguments "uso: --self-test oppure --bench spikes/out/<namespace-nuovo>/")))
      (error (condition)
        (when (eq :load-product (getf report :phase))
          (setf (getf (getf report :environment) :product-load-status) :failed))
        (setf (getf report :status) (if (typep condition 'bench-deadline) :incomplete :failed)
              (getf report :diagnostic) (diagnostic condition))))
    (finalize-report run report)
    ;; Sempre un solo record finale su stdout, anche se worker vivo impedisce il checkpoint.
    (write-string (checked-report-roundtrip report) *standard-output*)
    (finish-output *standard-output*)
    (when (mark-late-report run report)
      (when (and (run-directory run) (all-workers-terminated-p (run-active run)))
        (handler-case (write-report report run)
          (error (condition) (setf (getf report :status) :failed
                                  (getf report :diagnostic) (diagnostic condition))))))
    (unless (zerop (getf report :exit-code))
      (format *error-output* "tools/io-rename-bench.lisp COD-61: status ~S; consultare windows/diagnostic/cleanup.~%~A~%"
              (getf report :status) (or (getf report :diagnostic) "finestra incompleta o verifica fallita")))
    ;; Con worker vivo niente exit hooks: le capacita restano possedute fino all'uscita OS.
    (sb-ext:exit :code (getf report :exit-code) :abort (not (all-workers-terminated-p (run-active run))))))

(main (truename (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*))))
