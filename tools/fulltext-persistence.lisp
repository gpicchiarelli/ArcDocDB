;;;; C4: file indice con campi NNTP, riaperto e interrogato in un secondo processo SBCL.
;;; REQ: REQ-SEC-008 REQ-SEC-007 REQ-VAL-001
(require :asdf)
(asdf:load-asd (truename "arcdocdb.asd"))
(asdf:load-system "arcdocdb/tests")
(defpackage #:arcdocdb.fulltext.persistence
  (:use #:cl)
  (:local-nicknames (#:c #:arcdocdb.fulltext.codec) (#:ct #:arcdocdb.fulltext.codec.tests)
                    (#:at #:arcdocdb.fulltext.analysis.tests) (#:ft #:arcdocdb.fulltext.format.tests)))
(in-package #:arcdocdb.fulltext.persistence)
(defun descriptor ()
  (let ((rows #*1110))
    (ct::descriptor :rows rows :meta (ct::meta :rows rows :fields '((1 "subject" ("subject")) (2 "body" ("body")))))))
(defun image ()
  (let ((run (arcdocdb.fulltext.index:crea-indice-posizionale)) (analysis (at::small-space))
        (scratch (ct::space)) (descriptor (descriptor)))
    (at::append-field run analysis 0 1 "Common Lisp annuncio")
    (at::append-field run analysis 0 2 "ArcDocDB offre ricerca full text")
    (at::append-field run analysis 1 1 "Re: Common Lisp annuncio")
    (at::append-field run analysis 1 2 "Grazie per il lavoro")
    (at::append-field run analysis 2 1 "")
    (at::append-field run analysis 2 2 "Versione storica articolo")
    (at::seal run)
    (multiple-value-bind (buffer start end) (ct::encode run descriptor scratch)
      (assert (zerop start)) (subseq buffer 0 end))))
(defun read-file (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((size (file-length stream)))
      (unless (<= 1 size 1048576) (error "Fixture fuori limite"))
      (let ((data (make-array size :element-type '(unsigned-byte 8))))
        (assert (= size (read-sequence data stream))) data))))
(defun verify-file (path)
  (let* ((data (read-file path)) (scratch (ct::space)) (descriptor (descriptor))
         (view (c:crea-vista-indice-full-text data 0 (length data) descriptor scratch))
         (query (at::small-space)))
    (dolist (case '(("COMMON LISP" 0 1 :phrase t) ("common lisp" 1 1 :phrase t)
                    ("ricerca full text" 0 2 :phrase t) ("ricerca" 1 2 :all nil)
                    ("lavoro" 1 2 :all t) ("lavoro" 1 1 :any nil)
                    ("versione storica" 2 2 :phrase t) ("articolo" 2 1 :any nil)
                    ("articolo" 3 2 :any nil)))
      (destructuring-bind (text row field mode expected) case
        (at::analyzed text :space query)
        (assert (eq expected (ct::matches view row field query mode))))))
  (format t "PERSISTED-QUERIES-OK~%"))
(defun child (path expected)
  (uiop:with-temporary-file (:pathname output :stream out)
    (close out)
    (uiop:with-temporary-file (:pathname errors :stream err)
      (close err)
      (let ((process (uiop:launch-program
                      (list (namestring sb-ext:*runtime-pathname*) "--noinform" "--no-userinit" "--no-sysinit"
                            "--script" "tools/fulltext-persistence.lisp" "--read" (namestring path))
                      :output output :error-output errors :if-output-exists :supersede :if-error-output-exists :supersede)))
        (unwind-protect
             (progn
               (loop repeat 600 while (uiop:process-alive-p process) do (sleep 0.05))
               (when (uiop:process-alive-p process) (error "Timeout del child full text"))
               (let ((exit (uiop:wait-process process)) (stdout (uiop:read-file-string output))
                     (stderr (uiop:read-file-string errors)))
                 (unless (and (= exit (if expected 0 2))
                              (search (if expected "PERSISTED-QUERIES-OK" "PERSISTED-INDEX-REJECTED") stdout))
                   (error "Child inatteso ~D: ~A ~A" exit stdout stderr))
                 (format t "Child ~A: exit=~D, ~A" (if expected :valid :corrupt) exit stdout)))
          (when (uiop:process-alive-p process)
            (uiop:terminate-process process :urgent t)
            (loop repeat 40 while (uiop:process-alive-p process) do (sleep 0.05))))))))
(defun self-test ()
  (let ((data (image)))
    (uiop:with-temporary-file (:pathname path :stream stream :element-type '(unsigned-byte 8))
      (write-sequence data stream) (finish-output stream) (close stream)
      (child path t)
      (let* ((positions (aref (ct::starts data) 4)) (broken (copy-seq data)))
        ;; CRC corretto ma posizione oltre il campo: il secondo processo deve rifiutarla.
        (ft::ref-le broken positions #xffffffff 4) (ft::repair broken 0 (length broken))
        (with-open-file (out path :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
          (write-sequence broken out))
        (child path nil))))
  (format t "(:schema-version 1 :kind :fulltext-persistence :status :ok :child-processes 2 :queries 9 :negative-controls 1 :durability-claim nil :mvcc-claim nil)~%"))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--self-test")) (self-test))
        ((and (= 2 (length args)) (string= (first args) "--read"))
         (handler-case (verify-file (second args))
           (arcdocdb.conditions:corruption-detected (condition)
             (format t "PERSISTED-INDEX-REJECTED ~A~%" condition) (uiop:quit 2))))
        (t (error "Uso: --self-test | --read file-binario"))))
