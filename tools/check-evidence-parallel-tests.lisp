;;;; Fixture C4 indipendenti; caricate soltanto da --self-test.
;;; REQ: REQ-VAL-001 REQ-AFF-012
;;;; Nessun record del motore o fonte di prodotto eseguito dalle fixture.
(in-package #:arcdocdb.evidence.check)
(declaim (optimize (safety 3) (debug 3)))

(defparameter *ept-checker* (merge-pathnames "check-evidence.lisp" *load-truename*))
(defvar *ept-root* nil)
(defvar *ept-checks* 0)
(defvar *ept-cases* nil)
(defvar *ept-serial* 0)

(defun ept-check (value detail)
  (unless value (error "Self-test evidenze parallele: ~A" detail))
  (incf *ept-checks*) t)

(defun ept-directory (path)
  (let ((directory (uiop:ensure-directory-pathname path)))
    (ept-check (not (probe-file directory)) "Directory fixture nuova")
    (ensure-directories-exist (uiop:pathname-parent-directory-pathname directory))
    (sb-posix:mkdir (namestring directory) #o700) directory))

(defun ept-write-text (path text)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error :external-format :utf-8)
    (write-string text stream)) path)

(defun ept-data-text (data)
  (let ((*print-readably* t) (*print-length* nil) (*print-level* nil) (*print-circle* nil))
    (format nil "~S~%" data)))

(defun ept-write-data (path data) (ept-write-text path (ept-data-text data)))

(defun ept-one-data (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*package* (find-package :cl-user)) (eof (gensym)))
    (with-open-file (stream path :external-format :utf-8)
      (let ((value (read stream nil eof)))
        (ept-check (not (eq value eof)) "Dato presente")
        (ept-check (eq eof (read stream nil eof)) "Una sola forma con EOF") value))))

(defun ept-snapshot (paths)
  (mapcar (lambda (path) (list path (arcdocdb.evidence:file-bytes path)
                             (arcdocdb.evidence:file-sha256 path))) paths))

(defun ept-unchanged (snapshot)
  (ept-check (equal snapshot (ept-snapshot (mapcar #'first snapshot))) "Byte e SHA256 input immutati"))

(defun ept-child (argv directory label &key input output)
  "Subprocesso senza shell; stdout/stderr e stato conservati, kill/reap anche su errore."
  (let ((stdout (or output (merge-pathnames (format nil "~A.stdout.lisp" label) directory)))
        (stderr (merge-pathnames (format nil "~A.stderr.log" label) directory)) (process nil))
    (unwind-protect
         (progn
           (setf process (uiop:launch-program argv :input input :output stdout :error-output stderr
                          :if-output-exists :error :if-error-output-exists :error :force-shell nil))
           (multiple-value-bind (exit signal) (sb-ext:with-timeout 45 (uiop:wait-process process))
             (ept-write-data (merge-pathnames (format nil "~A.process.lisp" label) directory)
                             (list :argv argv :exit-code exit :signal signal :stdout (namestring stdout) :stderr (namestring stderr)))
             (values exit signal stdout stderr)))
      (when process
        (when (uiop:process-alive-p process) (uiop:terminate-process process :urgent t))
        (sb-ext:with-timeout 5 (uiop:wait-process process)) (uiop:close-streams process)))))

(defun ept-sbcl (script &rest arguments)
  (append (list (namestring sb-ext:*runtime-pathname*) "--noinform" "--no-userinit" "--no-sysinit"
                "--disable-debugger" "--script" (namestring script)) arguments))

(defun ept-case (name function)
  (let* ((directory (ept-directory (merge-pathnames (format nil "case-~2,'0D-~A/" (incf *ept-serial*) name) *ept-root*)))
         (before *ept-checks*) (row nil))
    (handler-case
        (setf row (list :name name :status :ok :checks (progn (funcall function directory) (- *ept-checks* before))))
      (serious-condition (condition)
        (setf row (list :name name :status :failed :checks (- *ept-checks* before)
                        :condition (type-of condition) :diagnostic (princ-to-string condition)))))
    (ept-write-data (merge-pathnames "case-result.lisp" directory) row)
    (push row *ept-cases*)))

(defun ept-fixture (directory &key (catalogs 4) catalog-edit artifact-text)
  "Quattro cataloghi con due entry identiche: ogni riferimento resta contato."
  (let ((root (ept-directory (merge-pathnames "input/" directory))) (paths nil) (catalog-paths nil))
    (dotimes (i catalogs)
      (let* ((base (ept-directory (merge-pathnames (format nil "2026-10-16-~2,'0D/" i) root)))
             (catalog (merge-pathnames "catalogo.lisp" base))
             (artifact (merge-pathnames "artifact.lisp" base))
             (original (merge-pathnames "original.lisp" base))
             (process (merge-pathnames "process.lisp" base))
             (entry '(:artifact "artifact.lisp" :original "original.lisp" :process-artifact "process.lisp"))
             (data (list :schema-version 1 :kind :evidence-catalog :entries (list (copy-list entry) (copy-list entry)))))
        (if artifact-text (ept-write-text artifact (funcall artifact-text i))
            (ept-write-data artifact (list :schema-version 1 :kind :historical-fixture :status :failed :value i)))
        ;; Il checker storico non interpreta né promuove gli esiti dei due accessori.
        (ept-write-data original (list :historical-value i :status :source-changed))
        (ept-write-data process (list :status :failed :exit-code 7 :source-consistency :changed :label i))
        (when catalog-edit (setf data (funcall catalog-edit data i)))
        (ept-write-data catalog data)
        (push catalog catalog-paths) (setf paths (append paths (list catalog artifact original process)))))
    (list :root root :paths paths :catalogs (nreverse catalog-paths))))

(defun ept-summary (report)
  (mapcar (lambda (key) (list key (getf report key)))
          '(:status :catalogs :artifact-references :stored-files :stored-bytes :limits)))

(defun ept-positive (fixture &optional (jobs '(1 2 4)))
  (let* ((snapshot (ept-snapshot (getf fixture :paths)))
         (files (length snapshot)) (bytes (reduce #'+ snapshot :key #'second))
         (catalogs (length (getf fixture :catalogs))) (summaries nil))
    (dolist (count jobs)
      (let ((report (verifica-evidenze (getf fixture :root) :jobs count)))
        (ept-check (eq :ok (getf report :status)) "Esito positivo")
        (ept-check (= catalogs (getf report :catalogs)) "Cataloghi effettivi")
        (ept-check (= (* catalogs 6) (getf report :artifact-references)) "Tre ref per entry, duplicati contati")
        (ept-check (= files (getf report :stored-files)) "File fisici contati una volta")
        (ept-check (= bytes (getf report :stored-bytes)) "Byte fisici indipendenti")
        (ept-check (equal '(:structure-presence-size-and-compressed-integrity :no-result-reinterpretation)
                          (getf report :limits)) "Limiti storici invariati")
        (push (ept-summary report) summaries)))
    (ept-check (every (lambda (summary) (equal summary (first summaries))) summaries) "Seriale e parallelo equivalenti")
    (ept-unchanged snapshot) (first summaries)))

(defun ept-error (function)
  (let ((condition nil))
    (handler-case (funcall function) (error (caught) (setf condition caught)))
    (ept-check condition "Rifiuto richiesto, nessun successo silenzioso") condition))

(defun ept-rejected (fixture directory &key catalog first-detail)
  (let ((snapshot (ept-snapshot (getf fixture :paths))))
    (dolist (jobs '(1 4))
      (let* ((condition (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs jobs))))
             (text (princ-to-string condition)))
        (when (and catalog (= jobs 4))
          (ept-check (typep condition 'invalid-evidence) "Rifiuto worker normalizzato")
          (ept-check (equal (truename catalog) (truename (evidence-path condition))) "Primo catalogo in ordine")
          (when first-detail (ept-check (search first-detail text :test #'char-equal) "Diagnostico del primo errore")))
        (ept-write-data (merge-pathnames (format nil "rejection-jobs~D.lisp" jobs) directory)
                        (list :jobs jobs :condition (type-of condition) :diagnostic text))))
    (ept-unchanged snapshot)))

(defun ept-cli (fixture directory jobs)
  (multiple-value-bind (exit signal stdout stderr)
      (ept-child (ept-sbcl *ept-checker* "--root" (namestring (getf fixture :root)) "--jobs" (write-to-string jobs))
                 directory (format nil "cli-jobs~D" jobs))
    (ept-check (and (eql exit 0) (null signal)) "CLI positiva exit0/signal NIL")
    (ept-check (zerop (arcdocdb.evidence:file-bytes stderr)) "CLI positiva stderr vuoto")
    (ept-summary (ept-one-data stdout))))

(defun ept-sparse-file (path size)
  (with-open-file (stream path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
    (file-position stream (1- size)) (write-byte 0 stream)) path)

(defun ept-bundle (directory &key bad-hash symlink-payload)
  (let* ((root (ept-directory (merge-pathnames "input/" directory)))
         (base (ept-directory (merge-pathnames "2026-10-16/" root)))
         (source (merge-pathnames "original.lisp" directory))
         (payload (merge-pathnames "artifact.lisp.gz" base))
         (descriptor (merge-pathnames "artifact.lisp" base))
         (catalog (merge-pathnames "catalogo.lisp" base))
         (actual (if symlink-payload (merge-pathnames "outside.lisp.gz" directory) payload)))
    (ept-write-data source '(:schema-version 1 :kind :fixture :status :failed :value "dato storico"))
    (multiple-value-bind (exit signal stdout stderr)
        (ept-child '("gzip" "-n" "-9" "-c") directory "prepare-gzip" :input source :output actual)
      (declare (ignore stdout stderr)) (ept-check (and (eql exit 0) (null signal)) "Preparazione gzip"))
    (when symlink-payload (sb-posix:symlink (namestring actual) (namestring payload)))
    (ept-write-data descriptor
      (list :schema-version 1 :kind :compressed-evidence :codec :gzip :payload "artifact.lisp.gz"
            :uncompressed-bytes (arcdocdb.evidence:file-bytes source)
            :uncompressed-sha256 (arcdocdb.evidence:file-sha256 source)
            :compressed-bytes (arcdocdb.evidence:file-bytes actual)
            :compressed-sha256 (if bad-hash (make-string 64 :initial-element #\0) (arcdocdb.evidence:file-sha256 actual))))
    (ept-write-data catalog '(:schema-version 1 :kind :evidence-catalog
                              :entries ((:artifact "artifact.lisp" :original "artifact.lisp" :process-artifact "artifact.lisp")
                                        (:artifact "artifact.lisp" :original "artifact.lisp" :process-artifact "artifact.lisp"))))
    (list :root root :catalogs (list catalog) :paths (list catalog descriptor payload))))

(defun ept-alive-p (pid)
  (handler-case (progn (sb-posix:kill pid 0) t)
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:esrch (sb-posix:syscall-errno condition)) nil (error condition)))))

(sb-alien:define-alien-routine ("getsid" ept-session-id) sb-alien:int (pid sb-alien:int))

(defun ept-session-preamble (stream)
  "Il clock non serve al cleanup: identità POSIX osservate direttamente nei figli."
  (format stream "(require :asdf)~%(require :sb-posix)~%")
  (write-string "(sb-alien:define-alien-routine (\"getsid\" fixture-sid) sb-alien:int (pid sb-alien:int))
(defun fixture-identity () (list :pid (sb-posix:getpid) :ppid (sb-posix:getppid) :pgrp (sb-posix:getpgrp) :sid (fixture-sid 0)))
" stream))

(defun ept-session-bootstrap (stream temporary)
  (format stream "(let ((*features* (cons :arcdocdb-evidence-check-library *features*))) (load ~S :verbose nil :print nil))~%"
          (namestring *ept-checker*))
  (format stream "(uiop:symbol-call :arcdocdb.evidence.check :inizializza-sessione-worker ~S)~%" (namestring temporary)))

(defun ept-session-cleanup (directory leader-dies)
  "Nipote in PGID diverso/SID identica e controllo in SID diversa; tutte le fixture conservate."
  (let* ((fixture (ept-fixture directory :catalogs 1)) (snapshot (ept-snapshot (getf fixture :paths)))
         (child-source (merge-pathnames "grandchild.lisp" directory))
         (worker-source (merge-pathnames "session-worker.lisp" directory))
         (control-source (merge-pathnames "outside-session.lisp" directory))
         (input (merge-pathnames "regular-stdin.bin" directory))
         (worker-meta (merge-pathnames "worker.identity.lisp" directory))
         (child-meta (merge-pathnames "grandchild.identity.lisp" directory))
         (control-meta (merge-pathnames "outside.identity.lisp" directory))
         (control-temp (ept-directory (merge-pathnames "outside-temporary/" directory)))
         (temporary nil) (control nil) (identities nil))
    (ept-write-text input "stdin regolare posseduto dalla fixture")
    (ept-write-text child-source
      (with-output-to-string (stream)
        (ept-session-preamble stream)
        (format stream "(unless (= (sb-posix:getpgrp) (sb-posix:getpid)) (sb-posix:setpgid 0 0))~%(with-open-file (s ~S :direction :output :if-exists :error) (write (fixture-identity) :stream s))~%(sleep 30)~%" (namestring child-meta))))
    (ept-write-text control-source
      (with-output-to-string (stream)
        (ept-session-preamble stream) (ept-session-bootstrap stream control-temp)
        (format stream "(with-open-file (s ~S :direction :output :if-exists :error) (write (fixture-identity) :stream s))~%(sleep 30)~%" (namestring control-meta))))
    (unwind-protect
         (progn
           (setf control (uiop:launch-program (ept-sbcl control-source)
                           :input nil :output (merge-pathnames "outside.stdout.log" directory)
                           :error-output (merge-pathnames "outside.stderr.log" directory)
                           :if-output-exists :error :if-error-output-exists :error :force-shell nil))
           (sb-ext:with-timeout 12
             (loop until (and (probe-file control-meta) (plusp (arcdocdb.evidence:file-bytes control-meta))) do (sleep 0.01)))
           (let ((*worker-command-hook*
                   (lambda (catalog argv)
                     (declare (ignore catalog))
                     (ept-check (not temporary) "Un solo worker della fixture di sessione")
                     (setf temporary (uiop:ensure-directory-pathname (second (member "--temporary-directory" argv :test #'string=))))
                     (ept-write-text worker-source
                       (with-output-to-string (stream)
                         (ept-session-preamble stream) (ept-session-bootstrap stream temporary)
                         (format stream "(let* ((input (open ~S :element-type '(unsigned-byte 8))) (child (sb-ext:run-program ~S '~S :search nil :wait nil :input input :output ~S :error ~S)))~%"
                                 (namestring input) (namestring sb-ext:*runtime-pathname*)
                                 (rest (ept-sbcl child-source))
                                 (namestring (merge-pathnames "grandchild.stdout.log" directory))
                                 (namestring (merge-pathnames "grandchild.stderr.log" directory)))
                         (format stream "(sb-ext:with-timeout 12 (loop until (and (probe-file ~S) (with-open-file (s ~S) (plusp (file-length s)))) do (sleep 0.01)))~%"
                                 (namestring child-meta) (namestring child-meta))
                         (format stream "(with-open-file (s ~S :direction :output :if-exists :error) (write (append (fixture-identity) (list :child-pid (sb-ext:process-pid child))) :stream s))~%"
                                 (namestring worker-meta))
                         (if leader-dies
                             (format stream "(sb-posix:kill (sb-posix:getpid) sb-posix:sigkill)~%")
                             (format stream "(sleep 30)~%"))
                         (format stream "(close input))~%")))
                     (append (list (namestring sb-ext:*runtime-pathname*) "--dynamic-space-size" "2048")
                             (rest (ept-sbcl worker-source))))))
             (let ((condition (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs 2 :worker-seconds 5)))))
               (ept-check (typep condition 'invalid-evidence) "Fallimento della sessione normalizzato")
               (unless leader-dies (ept-check (search "timeout" (princ-to-string condition) :test #'char-equal) "Timeout reale del leader vivo"))
               (ept-write-data (merge-pathnames "session-condition.lisp" directory)
                               (list :leader-dies leader-dies :condition (type-of condition) :diagnostic (princ-to-string condition)))))
           (ept-check (and (probe-file worker-meta) (probe-file child-meta)) "Identità di entrambi i processi conservate")
           (let* ((worker (ept-one-data worker-meta)) (child (ept-one-data child-meta))
                  (outside (ept-one-data control-meta))
                  (worker-pid (getf worker :pid)) (child-pid (getf child :pid)))
             (setf identities (list worker child))
             (ept-write-data (merge-pathnames "session-observations.lisp" directory)
               (list :leader-dies leader-dies :worker worker :grandchild child :outside outside
                     :worker-alive (ept-alive-p worker-pid) :grandchild-alive (ept-alive-p child-pid)
                     :outside-alive (uiop:process-alive-p control) :temporary (namestring temporary)))
             (ept-check (= worker-pid (getf worker :sid) (getf worker :pgrp)) "Leader di sessione privato")
             (ept-check (= worker-pid (getf child :sid) (getf child :ppid)) "Nipote nella SID del worker e figlio diretto")
             (ept-check (= child-pid (getf child :pgrp) (getf worker :child-pid)) "PGID separato del nipote reale")
             (ept-check (/= (getf worker :pgrp) (getf child :pgrp)) "I due gruppi POSIX sono distinti")
             (ept-check (/= worker-pid (getf outside :sid)) "Controllo fuori dalla SID bersaglio")
             (ept-check (probe-file (merge-pathnames "session.pid" temporary)) "Marker sessione conservato")
             (ept-check (not (ept-alive-p worker-pid)) "Leader morto dopo il ritorno")
             (ept-check (not (ept-alive-p child-pid)) "Nipote di altro PGID morto dopo il ritorno")
             (ept-check (uiop:process-alive-p control) "La sessione estranea resta viva")
             (ept-unchanged snapshot)))
      ;; Un test che rivela una regressione non deve lasciare vivi i propri helper.
      (dolist (path (list worker-meta child-meta))
        (when (probe-file path)
          (ignore-errors
            (pushnew (ept-one-data path) identities :test #'= :key (lambda (identity) (getf identity :pid))))))
      (dolist (identity identities)
        (let ((pid (getf identity :pid)) (sid (getf identity :sid)))
          (when (and pid sid (ept-alive-p pid) (= sid (ept-session-id pid)))
            (ignore-errors (sb-posix:kill pid sb-posix:sigkill)))))
      (when control
        (when (uiop:process-alive-p control) (uiop:terminate-process control :urgent t))
        (sb-ext:with-timeout 5 (uiop:wait-process control)) (uiop:close-streams control)))))

(defun ept-worker-script (path argv start end peers timeout)
  "Child fixture registra PID/tick su file separati, senza stampare sul protocollo del worker."
  (ept-write-text path
    (with-output-to-string (stream)
      (format stream "(require :asdf)~%(require :sb-posix)~%")
      (format stream "(unless (= (sb-posix:getpgrp) (sb-posix:getpid)) (sb-posix:setpgid 0 0))~%")
      ;; Lo stesso clock monotono POSIX a 64 bit, confrontabile tra processi.
      (write-string "(sb-alien:define-alien-type stamp (sb-alien:struct stamp (seconds sb-alien:long) (nanos sb-alien:long)))
(sb-alien:define-alien-routine (\"clock_gettime\" clock-gettime) sb-alien:int (id sb-alien:int) (value (* stamp)))
(defun clock-ns () (unless (member :64-bit *features*) (error \"clock ABI\")) (sb-alien:with-alien ((value stamp)) (unless (zerop (clock-gettime #+darwin 6 #+linux 1 #-(or darwin linux) (error \"clock platform\") (sb-alien:addr value))) (error \"clock_gettime\")) (+ (* 1000000000 (sb-alien:slot value 'seconds)) (sb-alien:slot value 'nanos))))
" stream)
      (format stream "(with-open-file (s ~S :direction :output :if-exists :error) (write (list :pid (sb-posix:getpid) :tick (clock-ns)) :stream s))~%" (namestring start))
      (if timeout (format stream "(sleep 30)~%")
          (progn
            (format stream "(sb-ext:with-timeout 12 (loop until (every #'probe-file '~S) do (sleep 0.01)))~%" (mapcar #'namestring peers))
            ;; Il vero entrypoint gira nello stesso processo/gruppo del wrapper.
            ;; Nessun secondo SBCL che possa sottrarsi al cleanup del parent.
            (format stream "(let ((*features* (cons :arcdocdb-evidence-check-library *features*))) (load ~S :verbose nil :print nil))~%"
                    (namestring *ept-checker*))
            (format stream "(uiop:symbol-call :arcdocdb.evidence.check :catalog-worker ~S ~S)~%"
                    (second (member "--catalog" argv :test #'string=))
                    (second (member "--temporary-directory" argv :test #'string=)))
            (format stream "(with-open-file (s ~S :direction :output :if-exists :error) (write (list :pid (sb-posix:getpid) :tick (clock-ns)) :stream s))~%"
                    (namestring end)))))))

(defun ept-process-bound (directory jobs &optional timeout)
  (let* ((fixture (ept-fixture directory)) (catalogs (getf fixture :catalogs))
         (starts (loop for i below 4 collect (merge-pathnames (format nil "worker-~D.start.lisp" i) directory)))
         (ends (loop for i below 4 collect (merge-pathnames (format nil "worker-~D.end.lisp" i) directory)))
         (invocations nil) (snapshot (ept-snapshot (getf fixture :paths))))
    (let ((*worker-command-hook*
            (lambda (catalog argv)
              (let* ((index (position (truename catalog) catalogs :test #'equal :key #'truename))
                     (wave (* jobs (floor index jobs)))
                     (peers (subseq starts wave (min 4 (+ wave jobs))))
                     (script (merge-pathnames (format nil "worker-~D.lisp" index) directory)))
                (ept-check index "Hook riceve un catalogo pianificato")
                (ept-check (member "2048" argv :test #'string=) "Heap argv 2048MiB")
                (push (list :index index :argv argv) invocations)
                (ept-worker-script script argv (nth index starts) (nth index ends) peers timeout)
                (append (list (namestring sb-ext:*runtime-pathname*) "--dynamic-space-size" "2048")
                        (rest (ept-sbcl script)))))))
      (if timeout
          (let ((condition (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs jobs :worker-seconds 3)))))
            (ept-check (typep condition 'invalid-evidence) "Timeout normalizzato")
            (ept-check (search "timeout" (princ-to-string condition) :test #'char-equal) "Causa timeout conservata")
            (ept-write-data (merge-pathnames "timeout-condition.lisp" directory)
                            (list :condition (type-of condition) :diagnostic (princ-to-string condition))))
          (let ((report (verifica-evidenze (getf fixture :root) :jobs jobs :worker-seconds 30)))
            (ept-check (= 4 (getf report :catalogs)) "Tutti i quattro cataloghi terminati")
            (ept-check (= 24 (getf report :artifact-references)) "Tutti i riferimenti verificati"))))
    (ept-check (<= 1 (length invocations) 4) "Numero hook limitato ai cataloghi")
    (let ((events nil) (started 0))
      (loop for start in starts for end in ends
            when (probe-file start)
              do (incf started)
                 (let* ((first (ept-one-data start)) (pid (getf first :pid)))
                   (ept-check (not (ept-alive-p pid)) "Ogni child terminato e raccolto")
                   (unless timeout
                     (ept-check (probe-file end) "Fine worker presente")
                     (let ((last (ept-one-data end)))
                       (ept-check (= pid (getf last :pid)) "Stesso processo start/end")
                       (ept-check (< (getf first :tick) (getf last :tick)) "Intervallo worker positivo")
                       (push (cons (getf first :tick) 1) events) (push (cons (getf last :tick) -1) events)))))
      (ept-check (plusp started) "Almeno un vero child osservato")
      (ept-check (= started (length invocations)) "PID conservato per ogni child lanciato")
      (unless timeout
        (ept-check (= 4 started (length invocations)) "Quattro processi esclusivi, uno per catalogo")
        (let ((active 0) (peak 0))
          (dolist (event (sort events (lambda (a b) (if (= (car a) (car b)) (< (cdr a) (cdr b)) (< (car a) (car b))))))
            (incf active (cdr event)) (setf peak (max peak active)))
          (ept-check (zerop active) "Nessun worker residuo")
          (ept-check (= jobs peak) "Picco processi esattamente JOBS, rendezvous effettivo")
          (ept-write-data (merge-pathnames "process-observations.lisp" directory)
                          (list :jobs jobs :observed-processes started :peak peak :events events)))))
    (ept-write-data (merge-pathnames "hook-argv.lisp" directory) (nreverse invocations))
    (ept-unchanged snapshot)))

(defun ept-bad-protocol (directory variant)
  (let* ((fixture (ept-fixture directory)) (snapshot (ept-snapshot (getf fixture :paths)))
         (marker (merge-pathnames "MUST-NOT-EVALUATE" directory)) (pids nil))
    (let ((*worker-command-hook*
            (lambda (catalog argv)
              (declare (ignore argv))
              (let* ((index (length pids))
                     (pid-path (merge-pathnames (format nil "protocol-~D.pid.lisp" index) directory))
                     (script (merge-pathnames (format nil "protocol-~D.lisp" index) directory))
                     (data (list :schema-version 1 :kind :evidence-catalog-check :catalog (namestring catalog)
                                 :status :ok :artifact-references 6))
                     (text (ecase variant
                             (:malformed "(:status :ok")
                             (:read-eval (format nil "#.(progn (with-open-file (s ~S :direction :output) (write-line ~S s)) '(:status :ok))"
                                                 (namestring marker) "BAD"))
                             (:descriptor "(:schema-version 1 :kind :compressed-evidence :codec :gzip :payload \"never.gz\" :status :ok)")
                             (:extra-key (ept-data-text (append data '(:unexpected-key 0))))
                             (:duplicate-key (ept-data-text (append data '(:status :ok)))))))
                (push pid-path pids)
                (ept-write-text script
                  (format nil "(require :sb-posix)~%(unless (= (sb-posix:getpgrp) (sb-posix:getpid)) (sb-posix:setpgid 0 0))~%(with-open-file (s ~S :direction :output :if-exists :error) (write (sb-posix:getpid) :stream s))~%(write-string ~S)~%(finish-output)~%"
                          (namestring pid-path) text))
                (append (list (namestring sb-ext:*runtime-pathname*) "--dynamic-space-size" "2048")
                        (rest (ept-sbcl script)))))))
      (let ((condition (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs 4)))))
        (ept-check (typep condition 'invalid-evidence) "Protocollo worker rifiutato")
        (ept-write-data (merge-pathnames "protocol-rejection.lisp" directory)
                        (list :variant variant :condition (type-of condition) :diagnostic (princ-to-string condition)))))
    (ept-check (not (probe-file marker)) "Protocollo READ-EVAL mai eseguito")
    (ept-check (= 4 (length pids)) "Quattro cataloghi con protocollo controllato")
    (dolist (pid-path pids)
      (ept-check (probe-file pid-path) "PID del processo protocollo conservato")
      (ept-check (not (ept-alive-p (ept-one-data pid-path))) "Processo protocollo raccolto"))
    (ept-unchanged snapshot)))

(defun ept-scan-stub (path counter variant)
  "CLI iniettabile: due errori espliciti poi PS reale, oppure fallimento controllato."
  (ept-write-text path
    (with-output-to-string (stream)
      (format stream "(require :asdf)~%(require :sb-posix)~%")
      (format stream "(let* ((*read-eval* nil) (attempt (1+ (if (probe-file ~S) (with-open-file (s ~S) (read s)) 0))))~%"
              (namestring counter) (namestring counter))
      (format stream "(with-open-file (s ~S :direction :output :if-exists :supersede) (write attempt :stream s))~%"
              (namestring counter))
      (ecase variant
        (:retry
         (write-string "(if (< attempt 3) (progn (format *error-output* \"EXPECTED-SCAN-FAILURE attempt~D~%\" attempt) (sb-ext:exit :code 2))
 (multiple-value-bind (output diagnostic exit) (uiop:run-program '(\"ps\" \"-axo\" \"pid=\") :output :string :error-output :string :ignore-error-status t)
   (write-string output) (write-string diagnostic *error-output*) (sb-ext:exit :code exit)))
" stream))
        (:failed (write-string "(format *error-output* \"EXPECTED-SCAN-FAILURE attempt~D~%\" attempt) (sb-ext:exit :code 2)
" stream))
        (:nonnumeric (write-string "(write-line \"not-a-pid\") (sb-ext:exit :code 0)
" stream))
        (:empty (write-string "(sb-ext:exit :code 0)
" stream)))
      (format stream ")~%"))))

(defun ept-scan-retry (directory variant)
  "Una scansione incompleta non equivale mai all'assenza di processi nella sessione."
  (let* ((logs (ept-directory (merge-pathnames "scan-logs/" directory)))
         (counter (merge-pathnames "attempt-counter.lisp" directory))
         (stub (merge-pathnames "scan-command.lisp" directory))
         (driver (merge-pathnames "scan-driver.lisp" directory))
         (argv (ept-sbcl stub)) (members nil))
    (ept-scan-stub stub counter variant)
    (if (eq variant :retry)
        (let ((*process-scan-command* argv) (*process-scan-serial* 0))
          (setf members (processi-sessione (ept-session-id 0) logs))
          (ept-check (= 3 *process-scan-serial*) "Tre tentativi prima del successo")
          (ept-check (member (sb-posix:getpid) members) "Snapshot completo include PID del chiamante")
          (ept-write-data (merge-pathnames "scan-result.lisp" directory)
                          (list :status :ok :caller-pid (sb-posix:getpid) :caller-pgrp (sb-posix:getpgrp)
                                :caller-sid (ept-session-id 0) :members members)))
        (progn
          (ept-write-text driver
            (with-output-to-string (stream)
              (format stream "(require :asdf)~%(require :sb-posix)~%")
              (format stream "(let ((*features* (cons :arcdocdb-evidence-check-library *features*))) (load ~S :verbose nil :print nil))~%" (namestring *ept-checker*))
              (format stream "(let ((arcdocdb.evidence.check::*process-scan-command* '~S) (arcdocdb.evidence.check::*process-scan-serial* 0))~%" argv)
              (format stream "(handler-case (progn (uiop:symbol-call :arcdocdb.evidence.check :processi-sessione (sb-posix:getsid 0) ~S) (sb-ext:exit :code 0)) (error (condition) (write-line (princ-to-string condition) *error-output*) (sb-ext:exit :code 1))))~%" (namestring logs))))
          (multiple-value-bind (exit signal stdout stderr)
              (ept-child (ept-sbcl driver) directory "scan-rejected")
            (declare (ignore stdout))
            (ept-check (and (eql 1 exit) (null signal)) "Scansione definitivamente invalida: exit1/signal NIL")
            (ept-check (search "nessuno snapshot completo" (uiop:read-file-string stderr) :test #'char-equal)
                       "Rifiuto esplicito dopo tre snapshot incompleti"))))
    (ept-check (= 3 (ept-one-data counter)) "Contatore CLI esattamente tre")
    (ept-check (= 9 (length (uiop:directory-files logs))) "Tre stdout, tre stderr e tre metadata conservati")
    (loop for attempt from 1 to 3
          for metadata = (merge-pathnames (format nil "scan-~D.lisp" attempt) logs)
          for stdout = (merge-pathnames (format nil "scan-~D.stdout.log" attempt) logs)
          for stderr = (merge-pathnames (format nil "scan-~D.stderr.log" attempt) logs)
          for data = (ept-one-data metadata)
          for expected-exit = (if (or (eq variant :failed) (and (eq variant :retry) (< attempt 3))) 2 0)
          do (ept-check (and (eql 1 (getf data :schema-version)) (eq :process-snapshot (getf data :kind))) "Schema scan metadata")
             (ept-check (equal argv (getf data :command)) "Comando scan esatto conservato")
             (ept-check (and (eql expected-exit (getf data :exit-code)) (null (getf data :signal))) "Exit e segnale del singolo tentativo")
             (ept-check (and (probe-file stdout) (probe-file stderr)
                            (equal (truename stdout) (truename (getf data :stdout)))
                            (equal (truename stderr) (truename (getf data :stderr)))) "Log scan fisici associati")
             (when (eq variant :empty) (ept-check (zerop (arcdocdb.evidence:file-bytes stdout)) "Output vuoto reale"))
             (when (eq variant :nonnumeric)
               (ept-check (string= (uiop:read-file-string stdout) (format nil "not-a-pid~%")) "Output nonnumerico reale")))))

(defun ept-scan-propagates (directory timeout)
  "Errori estranei allo snapshot e deadline non vengono consumati da una riprova."
  (let* ((logs (ept-directory (merge-pathnames "scan-logs/" directory)))
         (original (symbol-function 'acquisisci-pid)) (calls 0) (observed nil)
         (injected (if timeout (make-condition 'sb-ext:timeout)
                       (make-condition 'simple-error :format-control "EXPECTED-GENERIC-SCAN-FAULT" :format-arguments nil))))
    (unwind-protect
         (progn
           (setf (symbol-function 'acquisisci-pid)
                 (lambda (path)
                   (incf calls)
                   (if (= calls 1) (error injected) (funcall original path))))
           (setf observed (handler-case (processi-sessione (ept-session-id 0) logs)
                            (sb-ext:timeout (condition) condition)
                            (error (condition) condition)))
           (ept-check (typep observed 'serious-condition) "Rifiuto o timeout osservato, nessun successo silenzioso"))
      (setf (symbol-function 'acquisisci-pid) original)
      (ept-write-data (merge-pathnames "propagation-observations.lisp" directory)
                      (list :timeout timeout :calls calls :injected-type (type-of injected)
                            :observed-type (and observed (type-of observed))
                            :same-condition (eq injected observed)
                            :function-restored (eq original (symbol-function 'acquisisci-pid)))))
    (ept-check (eq original (symbol-function 'acquisisci-pid)) "FDEFINITION ripristinata anche su errore")
    (ept-check (= 1 calls) "Guasto generico o timeout propagato alla prima chiamata")
    (ept-check (eq injected observed) "Condizione originale propagata senza mascheramento")))

(defun ept-cleanup-workers (directory order)
  "Cleanup completo anche con ERROR e TIMEOUT, nei due ordini; nessun processo avviato."
  (let* ((symbol 'termina-worker) (original (fdefinition symbol))
         (logs (ept-directory (merge-pathnames "cleanup-logs/" directory)))
         (generic (make-condition 'simple-error :format-control "EXPECTED-CLEANUP-GENERIC-FAULT"
                                 :format-arguments nil))
         (timeout (make-condition 'sb-ext:timeout)) (calls nil) (caught nil))
    (unwind-protect
         (progn
           (setf (fdefinition symbol)
                 (lambda (worker)
                   (push worker calls)
                   (ecase worker
                     (:one (error (if (eq order :error-first) generic timeout)))
                     (:two (error (if (eq order :error-first) timeout generic)))
                     (:three nil))))
           (handler-case (chiudi-workers '(:one :two :three) logs)
             (serious-condition (condition) (setf caught condition))))
      (setf (fdefinition symbol) original))
    (let* ((diagnostic (princ-to-string caught))
           (observed (list :order order :calls (reverse calls) :function-restored (eq original (fdefinition symbol))
                           :condition (and caught (type-of caught)) :diagnostic diagnostic :logs (namestring logs))))
      (ept-write-data (merge-pathnames "cleanup-observations.lisp" directory) observed)
      (ept-check (eq original (fdefinition symbol)) "FDEFINITION originale ripristinata")
      (ept-check (equal (reverse calls) '(:one :two :three)) "Tutti e tre i worker chiusi, una volta e in ordine")
      (ept-check (typep caught 'error) "Errore ordinario aggregato dopo il cleanup completo")
      (ept-check (and (not (eq caught generic)) (not (eq caught timeout))) "Nessun rethrow prematuro della condizione originaria")
      (ept-check (search "EXPECTED-CLEANUP-GENERIC-FAULT" diagnostic) "Diagnostico del guasto generico conservato")
      (ept-check (search (princ-to-string timeout) diagnostic) "Diagnostico del timeout conservato")
      (ept-check (search (namestring logs) diagnostic) "Riferimento LOGS nel riepilogo")
      (list :status :ok :observations observed))))

(defun ept-exercise ()
  (ept-case "equivalence-and-cli"
    (lambda (directory)
      (let* ((fixture (ept-fixture directory)) (expected (ept-positive fixture)))
        (ept-check (equal expected (ept-cli fixture directory 1)) "CLI seriale uguale API")
        (ept-check (equal expected (ept-cli fixture directory 4)) "CLI parallela uguale API"))))
  (dolist (jobs '(0 5))
    (ept-case (format nil "jobs-~D" jobs)
      (lambda (directory) (let ((fixture (ept-fixture directory)))
        (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs jobs)))))))
  (dolist (arguments '(("--jobs" "0") ("--jobs" "5") ("--worker-seconds" "0")
                       ("--worker-heap-mib" "0") ("--jobs") ("--unknown-option")))
    (let ((arguments arguments))
      (ept-case (format nil "cli-reject-~D" (length *ept-cases*))
        (lambda (directory)
          (let ((fixture (ept-fixture directory)))
            (multiple-value-bind (exit signal stdout stderr)
                (ept-child (apply #'ept-sbcl *ept-checker* "--root" (namestring (getf fixture :root)) arguments) directory "cli-invalid")
              (declare (ignore stdout stderr))
              (ept-check (and (integerp exit) (not (zerop exit)) (null signal)) "CLI invalida exit nonzero, nessun segnale")))))))
  (dolist (bad '("" "." ".." "../escape.lisp" "sub/file.lisp" "sub\\file.lisp" 7))
    (let ((bad bad))
      (ept-case (format nil "invalid-leaf-~D" (length *ept-cases*))
        (lambda (directory)
          (let ((fixture (ept-fixture directory :catalogs 1 :catalog-edit
                            (lambda (data i) (declare (ignore i)) (setf (getf (first (getf data :entries)) :artifact) bad) data))))
            (ept-rejected fixture directory :catalog (first (getf fixture :catalogs))))))))
  (dolist (variant '(:empty :schema :missing-artifact :missing-file))
    (let ((variant variant))
      (ept-case (string-downcase (symbol-name variant))
        (lambda (directory)
          (let ((fixture (ept-fixture directory :catalogs 1 :catalog-edit
                            (lambda (data i) (declare (ignore i))
                              (ecase variant
                                (:empty (setf (getf data :entries) nil))
                                (:schema (setf (getf data :schema-version) 2))
                                (:missing-artifact (remf (first (getf data :entries)) :artifact))
                                (:missing-file (setf (getf (first (getf data :entries)) :artifact) "absent.lisp"))) data))))
            (ept-rejected fixture directory :catalog (first (getf fixture :catalogs))))))))
  (ept-case "artifact-schema"
    (lambda (directory)
      (let ((fixture (ept-fixture directory :catalogs 1 :artifact-text (lambda (i) (declare (ignore i)) "(:schema-version 2 :kind :fixture)"))))
        (ept-rejected fixture directory :catalog (first (getf fixture :catalogs))))))
  (ept-case "no-catalog"
    (lambda (directory) (ept-rejected (ept-fixture directory :catalogs 0) directory)))
  (ept-case "first-error-catalog-order"
    (lambda (directory)
      (let ((fixture (ept-fixture directory :catalog-edit
                        (lambda (data i)
                          (case i (0 (setf (getf (first (getf data :entries)) :artifact) "first-missing.lisp"))
                                  (1 (setf (getf (first (getf data :entries)) :artifact) "second-missing.lisp"))) data))))
        (ept-rejected fixture directory :catalog (first (getf fixture :catalogs)) :first-detail "first-missing.lisp"))))
  (dolist (variant '(:read-eval :trailing))
    (let ((variant variant))
      (ept-case (string-downcase (symbol-name variant))
        (lambda (directory)
          (let* ((marker (merge-pathnames "MUST-NOT-EXIST" directory))
                 (text (if (eq variant :read-eval)
                           (format nil "#.(progn (with-open-file (s ~S :direction :output) (write-line ~S s)) '(:schema-version 1))" (namestring marker) "BAD")
                           "(:schema-version 1) (:extra t)"))
                 (fixture (ept-fixture directory :catalogs 1 :artifact-text (lambda (i) (declare (ignore i)) text))))
            (unwind-protect (ept-rejected fixture directory :catalog (first (getf fixture :catalogs)))
              (ept-check (not (probe-file marker)) "READ-EVAL non eseguito")))))))
  (dolist (compressed '(nil t))
    (let ((compressed compressed))
      (ept-case (if compressed "gzip-global-size" "plain-global-size")
        (lambda (directory)
          (let* ((fixture (ept-fixture directory :catalogs 1 :catalog-edit
                             (lambda (data i) (declare (ignore i)) (setf (getf data :schema-version) 2) data)))
                 (path (merge-pathnames (if compressed "unlisted.gz" "unlisted.bin") (getf fixture :root))))
            (ept-sparse-file path (1+ (* (if compressed 8 1) 1024 1024)))
            (push path (getf fixture :paths))
            (ept-rejected fixture directory)
            (let ((condition (ept-error (lambda () (verifica-evidenze (getf fixture :root) :jobs 4)))))
              (ept-check (search "unlisted" (princ-to-string condition) :test #'char-equal) "Preflight size prima del catalogo invalido")))))))
  (ept-case "compressed-positive" (lambda (directory) (ept-positive (ept-bundle directory))))
  (ept-case "compressed-hash" (lambda (directory)
    (let ((fixture (ept-bundle directory :bad-hash t))) (ept-rejected fixture directory :catalog (first (getf fixture :catalogs))))))
  (ept-case "compressed-payload-symlink-escape" (lambda (directory)
    (let ((fixture (ept-bundle directory :symlink-payload t))) (ept-rejected fixture directory :catalog (first (getf fixture :catalogs))))))
  (dolist (variant '(:malformed :read-eval :descriptor :extra-key :duplicate-key))
    (let ((variant variant))
      (ept-case (format nil "worker-protocol-~A" (string-downcase (symbol-name variant)))
        (lambda (directory) (ept-bad-protocol directory variant)))))
  (ept-case "process-bound-two" (lambda (directory) (ept-process-bound directory 2)))
  (ept-case "process-bound-four" (lambda (directory) (ept-process-bound directory 4)))
  (ept-case "worker-timeout-cleanup" (lambda (directory) (ept-process-bound directory 4 t)))
  (ept-case "session-timeout-grandchild-other-group" (lambda (directory) (ept-session-cleanup directory nil)))
  (ept-case "session-dead-leader-grandchild-other-group" (lambda (directory) (ept-session-cleanup directory t)))
  (dolist (variant '(:retry :failed :nonnumeric :empty))
    (let ((variant variant))
      (ept-case (format nil "process-scan-~A" (string-downcase (symbol-name variant)))
        (lambda (directory) (ept-scan-retry directory variant)))))
  (ept-case "process-scan-generic-error-propagates" (lambda (directory) (ept-scan-propagates directory nil)))
  (ept-case "process-scan-timeout-propagates" (lambda (directory) (ept-scan-propagates directory t)))
  (ept-case "cleanup-workers-error-then-timeout" (lambda (directory) (ept-cleanup-workers directory :error-first)))
  (ept-case "cleanup-workers-timeout-then-error" (lambda (directory) (ept-cleanup-workers directory :timeout-first))))

(defun self-test (&optional root)
  "Fixture esclusive conservate con report e output; nessuna pulizia distruttiva o promozione."
  (let* ((*ept-checks* 0) (*ept-cases* nil) (*ept-serial* 0)
         (parent (merge-pathnames "../spikes/out/" (uiop:pathname-directory-pathname *ept-checker*)))
         (*ept-root* (if root (ept-directory root)
                         (progn (ensure-directories-exist parent)
                           (uiop:ensure-directory-pathname
                             (sb-posix:mkdtemp (namestring (merge-pathnames "evidence-parallel-self-test-XXXXXX" parent)))))))
         (fatal nil))
    (handler-case (ept-exercise) (serious-condition (condition) (setf fatal (princ-to-string condition))))
    (let* ((cases (nreverse *ept-cases*))
           (ok (and (not fatal) cases (every (lambda (row) (eq :ok (getf row :status))) cases)))
           (report (append (list :schema-version 1 :kind :evidence-parallel-self-test :status (if ok :ok :failed)
                                 :checks *ept-checks* :case-count (length cases) :root (namestring *ept-root*) :cases cases
                                 :limits '(:fixture-only :no-engine-qualification :historical-statuses-uninterpreted))
                           (when fatal (list :diagnostic fatal)))))
      (ept-write-data (merge-pathnames "report.lisp" *ept-root*) report)
      (write report :pretty t) (terpri)
      (unless ok (error "Self-test evidenze parallele fallito; fixture conservate in ~A" *ept-root*))
      report)))
