;;;; C4: corpus, oracoli, controlli negativi; copertura diagnostica in processo separato.
;;; REQ: REQ-SEC-007 REQ-SEC-008 REQ-SEC-010 REQ-VAL-001
(require :asdf)
(require :sb-cover)
(defpackage #:arcdocdb.fulltext.qualification (:use #:cl))
(in-package #:arcdocdb.fulltext.qualification)

(defun symbol-in (package name)
  (or (find-symbol name package) (error "Simbolo assente ~A::~A" package name)))
(defun test-call (package name) (funcall (symbol-in package name)))
(defun detected (mutant test)
  "Conta solo un errore del test: il mutante semantico non deve sollevare errori propri."
  (funcall mutant)
  (handler-case (progn (funcall test) nil) (simple-error () t)))
(defun with-mutant (package name replacement test-package test-name)
  (let* ((symbol (symbol-in package name)) (old (symbol-function symbol)))
    (unwind-protect
         (unless (detected (lambda () (setf (symbol-function symbol) replacement))
                           (lambda () (test-call test-package test-name)))
           (error "Mutante sopravvissuto: ~A::~A" package name))
      (setf (symbol-function symbol) old)))
  (format t "MUTANT-DETECTED ~A::~A~%" package name))
(defun negative-controls ()
  (with-mutant "ARCDOCDB.FULLTEXT.ANALYSIS" "COMPOSIZIONE-UNICODE"
    (lambda (space first second) (declare (ignore space first second)) 0)
    "ARCDOCDB.FULLTEXT.ANALYSIS.TESTS" "REQ-SEC-007-NORMALIZATION-CONFORMANCE")
  (with-mutant "ARCDOCDB.FULLTEXT.ANALYSIS" "CONFINE-PAROLA-P"
    (lambda (space right) (declare (ignore space right)) t)
    "ARCDOCDB.FULLTEXT.ANALYSIS.TESTS" "REQ-SEC-007-WORD-BREAK-CONFORMANCE")
  (with-mutant "ARCDOCDB.FULLTEXT.INDEX" "CONTINUA-FRASE-QUERY"
    (lambda (run field query row position) (declare (ignore run field query row position)) t)
    "ARCDOCDB.FULLTEXT.ANALYSIS.TESTS" "REQ-SEC-004-POSITIONAL-PHRASES-AND-VERSIONS")
  (with-mutant "ARCDOCDB.FULLTEXT.FORMAT" "VERIFICA-HEADER-FULL-TEXT"
    (lambda (buffer start size identity segment-id) (declare (ignore buffer start size identity segment-id)) nil)
    "ARCDOCDB.FULLTEXT.FORMAT.TESTS" "REQ-SEC-008-CRC-VALID-HEADER-ERRORS")
  (with-mutant "ARCDOCDB.FULLTEXT.CODEC" "VERIFICA-TERMINE-PROFILO"
    (lambda (buffer start end space) (declare (ignore buffer start end space)) nil)
    "ARCDOCDB.FULLTEXT.CODEC.TESTS" "REQ-SEC-008-CODEC-TERM-PROFILE-CORRUPTION")
  (with-mutant "ARCDOCDB.FULLTEXT.CODEC" "VERIFICA-DIZIONARIO-FILE"
    (lambda (buffer descriptor space) (declare (ignore buffer descriptor space)) nil)
    "ARCDOCDB.FULLTEXT.CODEC.TESTS" "REQ-SEC-008-CODEC-CRC-VALID-BODY-ERRORS")
  (with-mutant "ARCDOCDB.FULLTEXT.DOCUMENT" "CHIAVE-DOCUMENTO-P"
    (lambda (task start end key) (declare (ignore task start end key)) nil)
    "ARCDOCDB.FULLTEXT.DOCUMENT.TESTS" "REQ-SEC-003-CBOR-NNTP-INDEPENDENT-WIRE")
  (with-mutant "ARCDOCDB.FULLTEXT.DOCUMENT" "TERMINE-DOCUMENTO-RIPETUTO-P"
    (lambda (task token) (declare (ignore task token)) nil)
    "ARCDOCDB.FULLTEXT.DOCUMENT.TESTS" "REQ-SEC-010-DOCUMENT-BOUND-DISTINCT-AND-EMPTY")
  (with-mutant "ARCDOCDB.FULLTEXT.ADMISSION" "VERIFICA-COSTO-FILE-RISERVA"
    (lambda (pool i cost) (declare (ignore pool i cost)) nil)
    "ARCDOCDB.FULLTEXT.ADMISSION.TESTS" "REQ-SEC-010-RESERVATION-FILE-BOUNDS-AND-ROTATION")
  (with-mutant "ARCDOCDB.FULLTEXT.ADMISSION" "LIBERA-FONTI-RISERVA"
    (lambda (pool slot) (declare (ignore pool slot)) nil)
    "ARCDOCDB.FULLTEXT.ADMISSION.TESTS" "REQ-SEC-006-RESERVATION-CANCELLATION-AT-EVERY-COPY-STAGE")
  (with-mutant "ARCDOCDB.FULLTEXT.PUT" "PREFLIGHT-APPEND-PUT"
    (lambda (pool request batch) (declare (ignore pool request batch)) nil)
    "ARCDOCDB.FULLTEXT.PUT.TESTS" "REQ-SEC-003-PUT-APPEND-PREFLIGHT-RETAINS-RESERVATION")
  (with-mutant "ARCDOCDB.FULLTEXT.PUT" "VERIFICA-INCARNAZIONE-PUT"
    (lambda (slot batch) (declare (ignore slot batch)) nil)
    "ARCDOCDB.FULLTEXT.PUT.TESTS" "REQ-WAL-005-PUT-STALE-BATCH-INCARNATION")
  (with-mutant "ARCDOCDB.FULLTEXT.PUT" "ESIGI-CORNICE-PUT-VALIDATA"
    (lambda (request) (declare (ignore request)) nil)
    "ARCDOCDB.FULLTEXT.PUT.TESTS" "REQ-SEC-003-PUT-APPEND-PREFLIGHT-RETAINS-RESERVATION")
  (with-mutant "ARCDOCDB.FULLTEXT.PUT" "VERIFICA-HEADER-RIFERIMENTO-PUT"
    (lambda (pool slot batch high low) (declare (ignore pool slot batch)) (values high low))
    "ARCDOCDB.FULLTEXT.PUT.TESTS" "REQ-WAL-005-REFERENCE-HEADER-CORRUPTION-FAIL-STOP")
  (with-mutant "ARCDOCDB.FULLTEXT.ADMISSION" "TROVA-RIGA-TRASFERITA-FULL-TEXT"
    (lambda (pool lease row) (declare (ignore pool lease row)) (values :absent nil 0))
    "ARCDOCDB.FULLTEXT.ADMISSION.TESTS" "REQ-SEC-003-ROW-DIRECTORY-INDEPENDENT-MODEL"))
(defun scope-p (path)
  (not (null (or (search "/src/fulltext/" (namestring path))
                 (search "/src/fulltext-admission/" (namestring path))
                 (search "/src/fulltext-put/" (namestring path))
                 (search "/src/wal/frame.lisp" (namestring path))
                 (search "/src/wal/builder.lisp" (namestring path))
                 (search "/src/wal/types.lisp" (namestring path))))))
(defun self-test ()
  (assert (scope-p #P"/repo/src/fulltext/format-read.lisp"))
  (assert (scope-p #P"/repo/src/fulltext-admission/reserve.lisp"))
  (assert (scope-p #P"/repo/src/fulltext-put/append.lisp"))
  (assert (scope-p #P"/repo/src/wal/frame.lisp"))
  (assert (scope-p #P"/repo/src/wal/builder.lisp"))
  (assert (scope-p #P"/repo/src/wal/types.lisp"))
  (assert (not (scope-p #P"/repo/tests/fulltext/format.lisp")))
  (assert (not (detected (lambda () nil) (lambda () t))))
  (assert (detected (lambda () nil) (lambda () (error "Oracolo negativo"))))
  (format t "(:schema-version 1 :kind :fulltext-qualification-self-test :status :ok)~%"))
(defun load-suite (&optional directory)
  (when directory
    (require :sb-cover)
    (proclaim '(optimize (sb-cover:store-coverage-data 3)))
    (asdf:initialize-output-translations
     `(:output-translations (,(merge-pathnames "**/*.*" (truename "./"))
                            ,(merge-pathnames "fasl/**/*.*" directory)) :ignore-inherited-configuration)))
  (asdf:load-asd (truename "arcdocdb.asd"))
  (handler-bind ((warning (lambda (c) (error c))))
    (asdf:load-system "arcdocdb/tests" :force (not (null directory)))))
(defun coverage (directory)
  (ensure-directories-exist directory) (load-suite directory)
  (uiop:symbol-call :sb-cover :reset-coverage)
  (test-call "ARCDOCDB.FULLTEXT.FORMAT.TESTS" "RUN")
  (let* ((package (find-package "ARCDOCDB.FULLTEXT.ANALYSIS.TESTS"))
         (tests (symbol-value (find-symbol "*TESTS*" package))))
    (dolist (test (reverse tests))
      (unless (member (symbol-name test) '("REQ-SEC-008-FRAMING-ALLOCATION" "REQ-SEC-010-HOT-PATH-ALLOCATION")
                      :test #'equal)
        (funcall test))))
  (dolist (test (reverse (symbol-value (symbol-in "ARCDOCDB.FULLTEXT.CODEC.TESTS" "*TESTS*"))))
    (unless (string= (symbol-name test) "REQ-SEC-010-CODEC-HOT-ALLOCATION") (funcall test)))
  (dolist (test (reverse (symbol-value (symbol-in "ARCDOCDB.FULLTEXT.DOCUMENT.TESTS" "*TESTS*"))))
    (unless (string= (symbol-name test) "REQ-SEC-010-DOCUMENT-HOT-ALLOCATION") (funcall test)))
  (dolist (test (reverse (symbol-value (symbol-in "ARCDOCDB.FULLTEXT.ADMISSION.TESTS" "*TESTS*"))))
    (unless (string= (symbol-name test) "REQ-SEC-010-RESERVATION-HOT-ALLOCATION") (funcall test)))
  (dolist (test (reverse (symbol-value (symbol-in "ARCDOCDB.FULLTEXT.PUT.TESTS" "*TESTS*"))))
    (unless (string= (symbol-name test) "REQ-SEC-010-PUT-HOT-ALLOCATION") (funcall test)))
  (uiop:symbol-call :sb-cover :save-coverage-in-file (merge-pathnames "coverage-state.lisp" directory))
  (uiop:symbol-call :sb-cover :report directory :if-matches #'scope-p)
  (format t "Copertura diagnostica full text: ~A; allocazioni verificate separatamente.~%" directory))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--self-test")) (self-test))
        ((equal args '("--check"))
         (load-suite)
         (test-call "ARCDOCDB.FULLTEXT.FORMAT.TESTS" "RUN")
         (test-call "ARCDOCDB.FULLTEXT.ANALYSIS.TESTS" "RUN")
         (test-call "ARCDOCDB.FULLTEXT.CODEC.TESTS" "RUN")
         (test-call "ARCDOCDB.FULLTEXT.DOCUMENT.TESTS" "RUN")
         (test-call "ARCDOCDB.FULLTEXT.ADMISSION.TESTS" "RUN")
         (test-call "ARCDOCDB.FULLTEXT.PUT.TESTS" "RUN")
         (negative-controls)
         (format t "(:schema-version 1 :kind :fulltext-core-qualification :status :ok :negative-controls 15)~%"))
        ((and (= 2 (length args)) (string= "--coverage" (first args)))
         (coverage (merge-pathnames (uiop:ensure-directory-pathname (second args)) (truename "./"))))
        (t (error "Uso: --self-test | --check | --coverage directory-privata/"))))
