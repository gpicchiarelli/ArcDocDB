;;;; C4, schema 1. Preregistrazione: docs/implementazione/hash-chiavi-metodo.md.
;;;; --self-test DIR/ | --negative-fixture DIR/ | --bench DIR/ [--parallel] [COUNT]
;;;; Nessuna campagna implicita; il parent autorizza le esecuzioni dopo il freeze.
;;; OWNER: main possiede rapporti; ogni worker possiede buffer, seed e raw.
;;; SHARED: semafori ready/start; un solo contatore heap dell'intero processo.
(eval-when (:compile-toplevel :load-toplevel :execute)
  (require :asdf)
  (require :sb-posix)
  (load (merge-pathnames "evidence-storage.lisp"
                         (or *compile-file-truename* *load-truename*))))
(defpackage #:arcdocdb.key-hash.bench (:use #:cl))
(in-package #:arcdocdb.key-hash.bench)
(declaim (optimize (speed 2) (safety 3) (debug 2) (sb-c:store-coverage-data 0)))

(defparameter *root*
  (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*)))
(defconstant +replicas+ 5)
(defconstant +warmup+ 256)
(defconstant +min-count+ 20000)
(defconstant +max-count+ 100000)
(defconstant +deadline-seconds+ 30)
(defparameter +lengths+ '(0 1 7 8 16 31 32 33 64 256 1024 65535))
(defparameter +seed-cases+ '(:zero :max))
(deftype octets () '(simple-array (unsigned-byte 8) (*)))
(deftype u32 () '(unsigned-byte 32))
(deftype natural-fixnum () '(integer 0 #.most-positive-fixnum))
(deftype hash-function ()
  '(function (t t t t t) (values (unsigned-byte 32) (unsigned-byte 32) &optional)))

(define-condition bench-failure (error)
  ((rule :initarg :rule :reader failure-rule)
   (detail :initarg :detail :reader failure-detail))
  (:report (lambda (condition stream)
             (format stream "tools/key-hash-bench.lisp ~A: ~A"
                     (failure-rule condition) (failure-detail condition)))))
(defun fail (rule control &rest arguments)
  (error 'bench-failure :rule rule :detail (apply #'format nil control arguments)))

(defun freeze (object)
  "Snapshot senza cons o stringhe condivisi con il produttore. Solo dati del report."
  (typecase object
    (cons (cons (freeze (car object)) (freeze (cdr object))))
    (string (copy-seq object))
    ((or null symbol number) object)
    (t (fail "COD-61" "dato non serializzabile: ~S." (type-of object)))))

(defun require-fields (record keys)
  "Rifiuta plist malformate/duplicate; NIL presente non equivale a campo mancante."
  (unless (and (listp record) (evenp (length record)))
    (fail "COD-61" "record non plist."))
  (let ((seen nil))
    (loop for (key value) on record by #'cddr do
      (unless (and (keywordp key) (not (member key seen)))
        (fail "COD-61" "campo non keyword o duplicato: ~S." key))
      (push key seen))
    (dolist (key keys)
      (unless (member key seen) (fail "COD-61" "metrica mancante: ~S." key))))
  record)

(defun write-frozen (record directory leaf validator)
  "Una sola scrittura esclusiva, poi rilettura senza READ-EVAL e nuova validazione."
  (declare (type function validator))
  (let ((snapshot (freeze record)) (path (merge-pathnames leaf directory)))
    (funcall validator snapshot)
    (with-open-file (stream path :direction :output :if-exists :error
                           :if-does-not-exist :create :external-format :utf-8)
      (let ((*print-readably* t) (*print-pretty* t) (*print-length* nil)
            (*print-level* nil) (*print-base* 10) (*print-radix* nil))
        (write snapshot :stream stream) (terpri stream)))
    (let ((stored (arcdocdb.evidence:read-evidence path)))
      (unless (equal snapshot stored) (fail "COD-61" "rilettura diversa: ~A." path))
      (funcall validator stored))
    snapshot))

(defun product-symbol (package name &key function)
  "Solo dopo LOAD-PRODUCT; nessun package prodotto al read-time."
  (let ((pkg (find-package package)))
    (unless pkg (fail "COD-61" "package ~A assente dopo ASDF." package))
    (multiple-value-bind (symbol visibility) (find-symbol name pkg)
      (unless (and symbol (eq visibility :external) (or (not function) (fboundp symbol)))
        (fail "COD-61" "API ~A:~A assente/non esportata." package name))
      symbol)))

(defun source-manifest ()
  "Freeze dei sorgenti ASDF e del metodo; hashing dei file sempre fuori dai clock."
  (let ((paths (list (merge-pathnames "arcdocdb.asd" *root*)
                     (merge-pathnames "tools/key-hash-bench.lisp" *root*)
                     (merge-pathnames "tools/evidence-storage.lisp" *root*)
                     (merge-pathnames "docs/implementazione/hash-chiavi-metodo.md" *root*))))
    (labels ((visit (component)
               (typecase component
                 (asdf:cl-source-file (push (asdf:component-pathname component) paths))
                 (asdf:parent-component (mapc #'visit (asdf:component-children component))))))
      (visit (asdf:find-system "arcdocdb")))
    (mapcar (lambda (path)
              (list :path (namestring (truename path))
                    :sha256 (arcdocdb.evidence:file-sha256 path)))
            (sort paths #'string< :key #'namestring))))

(defun verify-source-freeze (report)
  (unless (equal (getf report :source-freeze) (source-manifest))
    (fail "COD-61" "sorgenti cambiati dopo il freeze del run.")))

(defun load-product (report)
  "RUN standard e forzato, prima di qualunque sensore/clock; nessuna coverage."
  (when (or (member :sb-cover *features*) (find-package "SB-COVER"))
    (fail "COD-61" "processo con SB-COVER: usare un nuovo processo senza coverage."))
  (unless (and (string= (lisp-implementation-type) "SBCL")
               (>= most-positive-fixnum #xffffffff))
    (fail "COD-61" "richiesto SBCL64: tutti gli u32 devono essere fixnum."))
  (setf asdf:*compile-file-failure-behaviour* :error
        asdf:*compile-file-warnings-behaviour* :error)
  (proclaim '(optimize (sb-c:store-coverage-data 0)))
  (let ((*standard-output* *error-output*))
    (handler-bind ((warning (lambda (condition)
                             (unless (typep condition 'sb-kernel:redefinition-warning)
                               (fail "COD-01" "avviso prodotto: ~A" condition)))))
      (asdf:load-asd (merge-pathnames "arcdocdb.asd" *root*))
      (setf (getf report :source-freeze) (freeze (source-manifest)))
      (asdf:load-system "arcdocdb" :force t)))
  (verify-source-freeze report)
  (let* ((symbol (product-symbol "ARCDOCDB.HASH64" "XXH64" :function t))
         (actual (sb-int:info :function :type symbol))
         (expected (sb-kernel:specifier-type
                    '(function (t t t t t) (values u32 u32 &optional)))))
    (unless (sb-kernel:type= actual expected)
      (fail "COD-61" "FTYPE pubblico inatteso: ~S." (sb-kernel:type-specifier actual)))
    (setf (getf report :public-ftype) (freeze (sb-kernel:type-specifier actual)))
    (symbol-function symbol)))

(defun iterations-for (length count)
  "Preregistrato, mai adattato ai tempi: ceiling(COUNT/divisore), massimo finito."
  (declare (type (integer 0 65535) length) (type (integer 20000 100000) count))
  (ceiling count (cond ((<= length 64) 1) ((= length 256) 4)
                       ((= length 1024) 16) ((= length 65535) 1024)
                       (t (fail "COD-60" "lunghezza fuori matrice.")))))

;;; Oracolo cold indipendente: interi CL generici, maschera esplicita modulo 2^64.
;;; Non chiama codice prodotto né helper src/hash; può allocare bignum fuori misura.
(defun reference-xxh64 (buffer start end seed-high seed-low)
  (let ((p1 #x9e3779b185ebca87) (p2 #xc2b2ae3d27d4eb4f)
        (p3 #x165667b19e3779f9) (p4 #x85ebca77c2b2ae63) (p5 #x27d4eb2f165667c5)
        (seed (logior (ash seed-high 32) seed-low)) (cursor start) (hash 0))
    (labels ((wrap (value) (logand value #xffffffffffffffff))
             (rol (value shift)
               (wrap (logior (ash value shift) (ash value (- shift 64)))))
             (read-le (position size)
               (loop for j below size sum (ash (aref buffer (+ position j)) (* 8 j))))
             (round64 (acc lane) (wrap (* (rol (wrap (+ acc (* lane p2))) 31) p1)))
             (merge64 (acc lane) (wrap (+ (* (logxor acc (round64 0 lane)) p1) p4))))
      (if (< (- end start) 32)
          (setf hash (wrap (+ seed p5)))
          (let ((v1 (wrap (+ seed p1 p2))) (v2 (wrap (+ seed p2)))
                (v3 seed) (v4 (wrap (- seed p1))))
            (loop while (<= (+ cursor 32) end) do
              (setf v1 (round64 v1 (read-le cursor 8))
                    v2 (round64 v2 (read-le (+ cursor 8) 8))
                    v3 (round64 v3 (read-le (+ cursor 16) 8))
                    v4 (round64 v4 (read-le (+ cursor 24) 8)))
              (incf cursor 32))
            (setf hash (wrap (+ (rol v1 1) (rol v2 7) (rol v3 12) (rol v4 18))))
            (dolist (lane (list v1 v2 v3 v4)) (setf hash (merge64 hash lane)))))
      (setf hash (wrap (+ hash (- end start))))
      (loop while (<= (+ cursor 8) end) do
        (setf hash (wrap (+ (* (rol (logxor hash (round64 0 (read-le cursor 8))) 27) p1) p4)))
        (incf cursor 8))
      (when (<= (+ cursor 4) end)
        (setf hash (wrap (+ (* (rol (logxor hash (wrap (* (read-le cursor 4) p1))) 23) p2) p3)))
        (incf cursor 4))
      (loop while (< cursor end) do
        (setf hash (wrap (* (rol (logxor hash (wrap (* (aref buffer cursor) p5))) 11) p1)))
        (incf cursor))
      (setf hash (wrap (* (logxor hash (ash hash -33)) p2))
            hash (wrap (* (logxor hash (ash hash -29)) p3)))
      (logxor hash (ash hash -32)))))

(defstruct (input (:copier nil))
  (buffer (make-array 0 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (snapshot (make-array 0 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (start 3 :type natural-fixnum :read-only t) (end 3 :type natural-fixnum :read-only t)
  (seed-high 0 :type u32 :read-only t) (seed-low 0 :type u32 :read-only t)
  (expected-high 0 :type u32 :read-only t) (expected-low 0 :type u32 :read-only t))

(defun new-input (length seed-case &optional (worker 0))
  "Padding 3+5, offset non allineato; buffer e seed distinti per worker."
  (let* ((base (ecase seed-case (:zero 0) (:max #xffffffff)))
         (high (logxor base (logand #xffffffff (* worker #x9e3779b1))))
         (low (logxor base (logand #xffffffff (* worker #x85ebca77))))
         (buffer (make-array (+ length 8) :element-type '(unsigned-byte 8))))
    (dotimes (i (length buffer))
      (setf (aref buffer i) (mod (+ (* i 131) (floor i 251) (* worker 17)) 256)))
    (let ((digest (reference-xxh64 buffer 3 (+ 3 length) high low)))
      (make-input :buffer buffer :snapshot (copy-seq buffer) :end (+ 3 length)
                  :seed-high high :seed-low low :expected-high (ldb (byte 32 32) digest)
                  :expected-low (ldb (byte 32 0) digest)))))

(defun verify-call (hash buffer start end high low expected-high expected-low)
  "Arity esatta verificata cold, anche un terzo NIL è rifiutato; nessuna MV-LIST."
  (multiple-value-call
      (lambda (actual-high actual-low &rest excess)
        (unless (and (null excess) (typep actual-high 'u32) (typep actual-low 'u32)
                     (typep actual-high 'fixnum) (typep actual-low 'fixnum)
                     (= actual-high expected-high) (= actual-low expected-low))
          (fail "COD-60" "digest/numero valori non conforme a (high, low) u32.")))
    (funcall hash buffer start end high low)))

(defun verify-input (hash input)
  "Oracolo ricalcolato cold e tutti i byte, padding incluso, prima/dopo ogni clock."
  (unless (equalp (input-buffer input) (input-snapshot input))
    (fail "COD-60" "buffer modificato, incluso padding esterno allo span."))
  (let ((digest (reference-xxh64 (input-snapshot input) (input-start input) (input-end input)
                                 (input-seed-high input) (input-seed-low input))))
    (unless (and (= (input-expected-high input) (ldb (byte 32 32) digest))
                 (= (input-expected-low input) (ldb (byte 32 0) digest)))
      (fail "COD-60" "oracolo della fixture cambiato.")))
  (verify-call hash (input-buffer input) (input-start input) (input-end input)
               (input-seed-high input) (input-seed-low input)
               (input-expected-high input) (input-expected-low input))
  (unless (equalp (input-buffer input) (input-snapshot input))
    (fail "COD-60" "la verifica cold ha modificato il buffer.")))

(defstruct (raw (:copier nil))
  (completed 0 :type natural-fixnum) (high 0 :type u32) (low 0 :type u32)
  (ticks 0 :type natural-fixnum) (heap 0 :type natural-fixnum)
  (status :pending :type keyword) (failure nil :type (or null condition)))

(defun kernel (hash input count raw)
  "Una hash per ciclo, due u32 immediati consumati; solo fixnum nei contatori."
  (declare (type hash-function hash) (type input input) (type natural-fixnum count)
           (type raw raw) (optimize (speed 3) (safety 3) (debug 0)))
  (let ((buffer (input-buffer input)) (start (input-start input)) (end (input-end input))
        (sh (input-seed-high input)) (sl (input-seed-low input))
        (eh (input-expected-high input)) (el (input-expected-low input)))
    (declare (type octets buffer) (type natural-fixnum start end) (type u32 sh sl eh el))
    (dotimes (i count)
      (multiple-value-bind (high low) (funcall hash buffer start end sh sl)
        (declare (type u32 high low))
        (unless (and (= high eh) (= low el)) (fail "COD-60" "digest errato nel kernel."))
        (setf (raw-high raw) high (raw-low raw) low (raw-completed raw) (1+ i)))))
  (values))

(defun measure-kernel (hash input count raw &key (heap-p t))
  "Raw preallocato; nessun rapporto, oracolo, boxed u64 o GC nella finestra."
  (declare (type natural-fixnum count) (type raw raw)
           (optimize (speed 3) (safety 3) (debug 0)))
  (let ((heap-before (if heap-p (the natural-fixnum (sb-ext:get-bytes-consed)) 0))
        (ticks-before (the natural-fixnum (get-internal-real-time))))
    (declare (type natural-fixnum heap-before ticks-before))
    (handler-case
        (progn (kernel hash input count raw) (setf (raw-status raw) :ok))
      (error (condition) (setf (raw-status raw) :failed (raw-failure raw) condition)))
    (let ((ticks-after (the natural-fixnum (get-internal-real-time)))
          (heap-after (if heap-p (the natural-fixnum (sb-ext:get-bytes-consed)) 0)))
      (declare (type natural-fixnum ticks-after heap-after))
      (setf (raw-ticks raw) (- ticks-after ticks-before)
            (raw-heap raw) (- heap-after heap-before))))
  raw)

(defun control-kernel (retained count raw)
  "Baseline reale o allocazione trattenuta; nessuna closure creata nel clock."
  (declare (type (or null simple-vector) retained) (type natural-fixnum count)
           (type raw raw) (optimize (speed 3) (safety 3) (debug 0)))
  (dotimes (i count)
    (when retained
      (setf (svref retained i)
            (make-array 1048576 :element-type '(unsigned-byte 8) :initial-element 0)))
    (setf (raw-completed raw) (1+ i) (raw-high raw) 0 (raw-low raw) 0)))

(defun measure-control (retained count raw)
  (declare (type natural-fixnum count) (type raw raw)
           (optimize (speed 3) (safety 3) (debug 0)))
  (let ((heap (the natural-fixnum (sb-ext:get-bytes-consed)))
        (ticks (the natural-fixnum (get-internal-real-time))))
    (declare (type natural-fixnum heap ticks))
    (control-kernel retained count raw)
    (setf (raw-ticks raw) (- (the natural-fixnum (get-internal-real-time)) ticks)
          (raw-heap raw) (- (the natural-fixnum (sb-ext:get-bytes-consed)) heap)
          (raw-status raw) :ok))
  raw)

(defparameter +metric-fields+
  '(:kind :workload :status :length :seed-case :replica :workers :iterations :completed
    :bytes :heap-bytes :raw-ticks :seconds :time-quality :ns-per-call :bytes-per-second
    :counter-scope :worker-results :sink-high :sink-low :expected-high :expected-low
    :buffer-unchanged :diagnostic))

(defun metric (raw kind length seed-case replica iterations
               &key input (workers 1) worker-results)
  "Conversioni e rate soltanto dopo il clock. Zero tick => rate NIL, mai stime."
  (let* ((ticks (raw-ticks raw))
         (seconds (/ ticks (float internal-time-units-per-second 1d0)))
         (completed (raw-completed raw)) (bytes (* completed length)))
    (list :kind kind :workload (list :name (string-downcase (symbol-name kind)) :primitive :xxh64)
          :status (raw-status raw) :length length :seed-case seed-case :replica replica
          :workers workers :iterations iterations :completed completed :bytes bytes
          :heap-bytes (raw-heap raw) :raw-ticks ticks :seconds seconds
          :time-quality (if (zerop ticks) :below-resolution :measured)
          :ns-per-call (when (and (plusp ticks) (plusp completed)) (/ (* seconds 1d9) completed))
          :bytes-per-second (when (plusp ticks) (/ bytes seconds))
          :counter-scope :whole-process :worker-results (freeze worker-results)
          :sink-high (unless worker-results (raw-high raw))
          :sink-low (unless worker-results (raw-low raw))
          :expected-high (unless worker-results (if input (input-expected-high input) 0))
          :expected-low (unless worker-results (if input (input-expected-low input) 0))
          :buffer-unchanged nil
          :diagnostic (when (raw-failure raw) (princ-to-string (raw-failure raw))))))

(defun validate-worker (record iterations seed-case)
  (require-fields record '(:worker :status :ready :joined :iterations :completed
                          :seed-high :seed-low :sink-high :sink-low :expected-high :expected-low
                          :raw-ticks :buffer-unchanged :diagnostic))
  (let ((worker (getf record :worker)) (base (ecase seed-case (:zero 0) (:max #xffffffff))))
    (unless (and (typep worker '(integer 0 3)) (eq (getf record :status) :ok)
                 (eq (getf record :ready) t) (eq (getf record :joined) t)
                 (eq (getf record :buffer-unchanged) t) (null (getf record :diagnostic))
                 (eql (getf record :iterations) iterations) (eql (getf record :completed) iterations)
                 (eql (getf record :seed-high) (logxor base (logand #xffffffff (* worker #x9e3779b1))))
                 (eql (getf record :seed-low) (logxor base (logand #xffffffff (* worker #x85ebca77))))
                 (typep (getf record :raw-ticks) 'natural-fixnum)
                 (typep (getf record :sink-high) 'u32) (typep (getf record :sink-low) 'u32)
                 (eql (getf record :sink-high) (getf record :expected-high))
                 (eql (getf record :sink-low) (getf record :expected-low)))
      (fail "COD-61" "worker incompleto, errore o digest incoerente.")))
  record)

(defun validate-metric (record &key zero-heap)
  (require-fields record +metric-fields+)
  (let ((ticks (getf record :raw-ticks)) (heap (getf record :heap-bytes))
        (length (getf record :length)) (iterations (getf record :iterations))
        (workers (getf record :workers)) (completed (getf record :completed))
        (kind (getf record :kind)))
    (unless (and (member kind '(:serial :parallel :sensor-empty :sensor-positive))
                 (eq (getf record :status) :ok) (null (getf record :diagnostic))
                 (eq (getf record :counter-scope) :whole-process)
                 (member length +lengths+) (member workers '(1 2 4))
                 (typep ticks 'natural-fixnum) (typep heap 'natural-fixnum)
                 (typep iterations '(integer 1 100000))
                 (eql completed (* iterations workers))
                 (eql (getf record :bytes) (* completed length))
                 (eql (getf record :seconds) (/ ticks (float internal-time-units-per-second 1d0)))
                 (eq (getf record :time-quality) (if (zerop ticks) :below-resolution :measured))
                 (eql (getf record :ns-per-call)
                      (when (plusp ticks) (/ (* (getf record :seconds) 1d9) completed)))
                 (eql (getf record :bytes-per-second)
                      (when (plusp ticks) (/ (* completed length) (getf record :seconds)))))
      (fail "COD-61" "metrica incompleta, negativa o rate incoerenti."))
    (if (eq kind :parallel)
        (let ((records (getf record :worker-results)))
          (unless (and (= (length records) workers) (eq (getf record :buffer-unchanged) t)
                       (null (getf record :sink-high)) (null (getf record :sink-low))
                       (null (getf record :expected-high)) (null (getf record :expected-low))
                       (equal (mapcar (lambda (r) (getf r :worker)) records)
                              (loop for i below workers collect i)))
            (fail "COD-61" "gruppo parallelo incompleto/duplicato."))
          (dolist (worker records) (validate-worker worker iterations (getf record :seed-case))))
        (unless (and (= workers 1) (null (getf record :worker-results))
                     (typep (getf record :sink-high) 'u32) (typep (getf record :sink-low) 'u32)
                     (eql (getf record :sink-high) (getf record :expected-high))
                     (eql (getf record :sink-low) (getf record :expected-low))
                     (or (member kind '(:sensor-empty :sensor-positive))
                         (eq (getf record :buffer-unchanged) t)))
          (fail "COD-61" "digest o immutabilità seriale incoerenti.")))
    (when (member kind '(:serial :parallel))
      (unless (and (member (getf record :seed-case) +seed-cases+)
                   (typep (getf record :replica) '(integer 0 4)))
        (fail "COD-61" "identità della replica non preregistrata.")))
    (when (and (or zero-heap (member kind '(:serial :sensor-empty))) (not (zerop heap)))
      (fail "COD-30" "gate zero heap fallito: ~D byte." heap)))
  record)

(defun publish-metric (report record)
  (require-fields report '(:metrics))
  (push (freeze record) (getf report :metrics)))

(defun expect-rejection (function)
  "Solo BENCH-FAILURE conta come rilevamento della fixture dello strumento."
  (let ((rejected nil))
    (handler-case (funcall function) (bench-failure () (setf rejected t)))
    (unless rejected (fail "COD-60" "fixture negativa non rilevata.")))
  t)

(defun capture-run (report function)
  (handler-case
      (progn (funcall function) (setf (getf report :status) :ok (getf report :exit-code) 0))
    (error (condition)
      (setf (getf report :status) :failed (getf report :exit-code) 1
            (getf report :diagnostic)
            (format nil "tools/key-hash-bench.lisp COD-61: ~A" condition))))
  report)

(defun validate-sensor (sensor)
  (require-fields sensor '(:schema-version :kind :status :metrics :empty-heap-bytes
                          :positive-heap-bytes :retained-bytes :missing-fields-rejected
                          :negative-fields-rejected :alias-guard :freeze-guard :nonzero-status-guard))
  (unless (and (eql (getf sensor :schema-version) 1) (eq (getf sensor :kind) :key-hash-sensor)
               (eq (getf sensor :status) :ok) (eql (getf sensor :empty-heap-bytes) 0)
               (typep (getf sensor :positive-heap-bytes) '(integer 4194304))
               (eql (getf sensor :retained-bytes) 4194304)
               (eql (getf sensor :missing-fields-rejected) (length +metric-fields+))
               (eql (getf sensor :negative-fields-rejected) 12)
               (eq (getf sensor :alias-guard) t) (eq (getf sensor :freeze-guard) t)
               (eq (getf sensor :nonzero-status-guard) t)
               (= (length (getf sensor :metrics)) 2)
               (equal (mapcar (lambda (r) (getf r :kind)) (getf sensor :metrics))
                      '(:sensor-empty :sensor-positive)))
    (fail "COD-61" "sensore/autoverifica incompleti."))
  (dolist (record (getf sensor :metrics)) (validate-metric record))
  (unless (and (eql (getf (first (getf sensor :metrics)) :iterations) 20000)
               (eql (getf (second (getf sensor :metrics)) :iterations) 4)
               (eql (getf (first (getf sensor :metrics)) :heap-bytes) (getf sensor :empty-heap-bytes))
               (eql (getf (second (getf sensor :metrics)) :heap-bytes) (getf sensor :positive-heap-bytes)))
    (fail "COD-61" "contatori del sensore non associati alle finestre."))
  sensor)

(defun sensor-self-test (directory)
  "Baseline vuota zero, positivo 4x1MiB trattenuto, metriche/alias/freeze/rilettura."
  (let ((empty (make-raw)) (positive (make-raw)) (retained (make-array 4))
        (report (list :metrics nil :status :running :exit-code nil :diagnostic nil)))
    (control-kernel nil +warmup+ (make-raw))
    (control-kernel (make-array 1) 1 (make-raw))
    (sb-ext:gc :full t)
    (measure-control nil 20000 empty)
    (let* ((record (metric empty :sensor-empty 0 nil nil 20000))
           (alias report))
      (validate-metric record :zero-heap t)
      (publish-metric report record)
      (unless (and (eq report alias) (not (eq record (first (getf alias :metrics)))))
        (fail "COD-60" "testa report/alias non conservata."))
      (setf (char (getf (getf record :workload) :name) 0) #\X)
      (unless (string= (getf (getf (first (getf alias :metrics)) :workload) :name) "sensor-empty")
        (fail "COD-60" "FREEZE condivide stringhe mutabili."))
      (setf (getf (getf record :workload) :primitive) :mutated)
      (unless (eq (getf (getf (first (getf alias :metrics)) :workload) :primitive) :xxh64)
        (fail "COD-60" "FREEZE condivide sottoliste.")))
    (sb-ext:gc :full t)
    (measure-control retained 4 positive)
    (unless (and (every (lambda (buffer) (and (typep buffer 'octets) (= (length buffer) 1048576))) retained)
                 (>= (raw-heap positive) 4194304))
      (fail "COD-60" "sensore non osserva i quattro MiB trattenuti."))
    (let ((record (metric positive :sensor-positive 0 nil nil 4)))
      (validate-metric record)
      (expect-rejection (lambda () (validate-metric record :zero-heap t)))
      (publish-metric report record))
    (dolist (key +metric-fields+)
      (let ((broken (metric empty :sensor-empty 0 nil nil 20000)))
        (remf broken key)
        (expect-rejection (lambda () (validate-metric broken)))))
    (dolist (key '(:iterations :completed :bytes :heap-bytes :raw-ticks :seconds :ns-per-call
                  :bytes-per-second :length :workers :sink-high :sink-low))
      (let ((broken (metric empty :sensor-empty 0 nil nil 20000)))
        (setf (getf broken key) -1)
        (expect-rejection (lambda () (validate-metric broken)))))
    (let ((broken (metric empty :sensor-empty 0 nil nil 20000)))
      (remf broken :completed)
      (capture-run report (lambda () (validate-metric broken)))
      (unless (and (eq (getf report :status) :failed) (eql (getf report :exit-code) 1))
        (fail "COD-60" "metrica incompleta non produce stato non nullo.")))
    (let ((sensor (list :schema-version 1 :kind :key-hash-sensor :status :ok
                        :metrics (nreverse (getf report :metrics))
                        :empty-heap-bytes (raw-heap empty) :positive-heap-bytes (raw-heap positive)
                        :retained-bytes (reduce #'+ retained :key #'length)
                        :missing-fields-rejected (length +metric-fields+) :negative-fields-rejected 12
                        :alias-guard t :freeze-guard t :nonzero-status-guard t)))
      (write-frozen sensor directory "self-test-sensor.lisp" #'validate-sensor))))

(defun expect-invalid (hash arguments reason)
  "Tipo/reason esatti, ordine dei controlli e immutabilità anche sui rifiuti."
  (let* ((buffer (first arguments)) (snapshot (when (vectorp buffer) (copy-seq buffer)))
         (invalid (product-symbol "ARCDOCDB.CONDITIONS" "INVALID-ARGUMENT"))
         (reason-reader (symbol-function (product-symbol "ARCDOCDB.CONDITIONS" "ERROR-REASON" :function t)))
         (rejected nil))
    (handler-case (apply hash arguments)
      (error (condition)
        (unless (and (typep condition invalid) (eq (funcall reason-reader condition) reason))
          (fail "COD-60" "atteso INVALID-ARGUMENT ~S, ricevuto ~A." reason condition))
        (setf rejected t)))
    (unless rejected (fail "COD-60" "argomenti invalidi accettati: ~S." reason))
    (when (and snapshot (not (equalp buffer snapshot)))
      (fail "COD-60" "rifiuto modifica il buffer."))))

(defun product-self-test (hash)
  "Fixture funzionali cold; nessuna campagna di performance in --self-test."
  (let ((fixtures nil) (negative-count 0) (buffer (make-array 16 :element-type '(unsigned-byte 8)
                                                              :initial-element 42)))
    ;; Anchors indipendenti dal generatore della matrice (seed zero).
    (dolist (anchor '(("" #xef46db3751d8e999) ("a" #xd24ec4f1a98c6e5b) ("abc" #x44bc2cf5ad770999)))
      (let* ((text (first anchor)) (expected (second anchor))
             (bytes (make-array (length text) :element-type '(unsigned-byte 8)
                                :initial-contents (map 'list #'char-code text)))
             (snapshot (copy-seq bytes)))
        (unless (= (reference-xxh64 bytes 0 (length bytes) 0 0) expected)
          (fail "COD-60" "oracolo indipendente fallisce anchor ~S." text))
        (verify-call hash bytes 0 (length bytes) 0 0 (ldb (byte 32 32) expected) (ldb (byte 32 0) expected))
        (unless (equalp bytes snapshot) (fail "COD-60" "anchor modificato."))))
    (dolist (length +lengths+)
      (dolist (seed +seed-cases+)
        (let ((input (new-input length seed)))
          (verify-input hash input) (push input fixtures))))
    ;; Riprova in ordine inverso alle prime chiamate: nessuno stato dipendente dal seed precedente.
    (dolist (input fixtures) (verify-input hash input))
    (dolist (length '(0 32 33 65535))
      (dolist (seed +seed-cases+)
        (let ((input (new-input length seed)))
          (dolist (start '(0 1 8))
            (let ((expected (reference-xxh64 (input-snapshot input) start (+ start length)
                                            (input-seed-high input) (input-seed-low input))))
              (verify-call hash (input-buffer input) start (+ start length)
                           (input-seed-high input) (input-seed-low input)
                           (ldb (byte 32 32) expected) (ldb (byte 32 0) expected))
              (unless (equalp (input-buffer input) (input-snapshot input))
                (fail "COD-60" "span di confine modifica il buffer.")))))))
    (dolist (seed +seed-cases+)
      (let* ((empty (make-array 0 :element-type '(unsigned-byte 8)))
             (word (ecase seed (:zero 0) (:max #xffffffff)))
             (expected (reference-xxh64 empty 0 0 word word)))
        (verify-call hash empty 0 0 word word (ldb (byte 32 32) expected) (ldb (byte 32 0) expected))))
    (labels ((reject (args reason) (expect-invalid hash args reason) (incf negative-count)))
      (dolist (bad (list nil #() "bytes"
                        (make-array '(2 2) :element-type '(unsigned-byte 8))
                        (make-array 16 :element-type '(unsigned-byte 8) :adjustable t)
                        (make-array 8 :element-type '(unsigned-byte 8) :displaced-to buffer)))
        (reject (list bad 0 0 0 0) :hash-arguments))
      (dolist (bad (list -1 1/2 0d0 (1+ most-positive-fixnum)))
        (reject (list buffer bad 8 0 0) :hash-arguments)
        (reject (list buffer 0 bad 0 0) :hash-arguments))
      (dolist (bad (list -1 #x100000000 nil))
        (reject (list buffer 0 8 bad 0) :hash-arguments))
      (dolist (bad (list -1 #x100000000 1/2))
        (reject (list buffer 0 8 0 bad) :hash-arguments))
      (dolist (range '((8 7) (0 17) (17 17)))
        (reject (append (list buffer) range '(0 0)) :buffer-range))
      (reject (list nil -1 2 #x100000000 -1) :hash-arguments)
      (let ((large (make-array 65544 :element-type '(unsigned-byte 8) :initial-element 7)))
        (reject (list large 3 65539 0 0) :hash-span-limit)
        (reject (list large 0 65545 0 0) :buffer-range)))
    (unless (= negative-count 26) (fail "COD-60" "matrice negativa cambiata senza preregistrazione."))
    (list :status :ok :oracle :independent-cold-xxh64 :anchors 3 :fixtures 24
          :edge-spans 24 :empty-vectors 2 :negative-cases negative-count :interleaved-recheck t)))

(defun warm-input (hash input count)
  (kernel hash input (min +warmup+ count) (make-raw))
  (verify-input hash input))

(defun serial-one (hash report length seed replica)
  (let* ((count (iterations-for length (getf report :base-count)))
         (input (new-input length seed)) (raw (make-raw)))
    (verify-input hash input)
    (warm-input hash input count)
    (sb-ext:gc :full t)
    (measure-kernel hash input count raw)
    (let ((record (metric raw :serial length seed replica count :input input)))
      (handler-case
          (progn (verify-input hash input) (setf (getf record :buffer-unchanged) t)
                 (validate-metric record :zero-heap t))
        (error (condition)
          (setf (getf record :status) :failed (getf record :diagnostic) (princ-to-string condition))))
      (publish-metric report record)
      (unless (eq (getf record :status) :ok) (fail "COD-61" "seriale: ~A" (getf record :diagnostic))))))

(defun remaining-seconds (deadline)
  (declare (type natural-fixnum deadline))
  (/ (max 0 (- deadline (get-internal-real-time))) (float internal-time-units-per-second 1d0)))

(defun worker-main (hash input count raw ready start)
  "Warmup privato; ready/start bounded; nessun contatore heap per worker."
  (let ((signalled nil))
    (handler-case
        (progn
          (warm-input hash input count)
          (setf (raw-status raw) :ready)
          (sb-thread:signal-semaphore ready) (setf signalled t)
          (unless (sb-thread:wait-on-semaphore start :timeout +deadline-seconds+)
            (fail "COD-42" "worker oltre deadline di start."))
          (measure-kernel hash input count raw :heap-p nil))
      (error (condition)
        (setf (raw-status raw) :failed (raw-failure raw) condition)
        (unless signalled (sb-thread:signal-semaphore ready)))))
  :joined)

(defun stop-workers (threads)
  "Solo thread posseduti dal driver; join di cleanup <=2s per thread."
  (declare (type simple-vector threads))
  (dotimes (i (length threads))
    (let ((thread (svref threads i)))
      (when (and thread (sb-thread:thread-alive-p thread)) (sb-thread:terminate-thread thread))))
  (dotimes (i (length threads))
    (let ((thread (svref threads i)))
      (when thread (sb-thread:join-thread thread :timeout 2 :default :cleanup-timeout)))))

(defun worker-record (worker raw input count ready joined)
  (list :worker worker :status (if joined (raw-status raw) :failed) :ready ready :joined joined
        :iterations count :completed (raw-completed raw) :seed-high (input-seed-high input)
        :seed-low (input-seed-low input) :sink-high (raw-high raw) :sink-low (raw-low raw)
        :expected-high (input-expected-high input) :expected-low (input-expected-low input)
        :raw-ticks (raw-ticks raw) :buffer-unchanged nil
        :diagnostic (cond ((raw-failure raw) (princ-to-string (raw-failure raw)))
                          ((not joined) "tools/key-hash-bench.lisp COD-42: join incompleto."))))

(defun parallel-one (hash report length seed replica workers)
  "Una finestra heap globale include apertura del gate e join, mai somma dei worker."
  (declare (type (member 1 2 4) workers) (type (integer 0 65535) length))
  (let* ((count (iterations-for length (getf report :base-count)))
         (inputs (make-array workers)) (raws (make-array workers))
         (threads (make-array workers :initial-element nil))
         (ready-flags (make-array workers :initial-element nil))
         (joined-flags (make-array workers :initial-element nil))
         (ready (sb-thread:make-semaphore :count 0)) (start (sb-thread:make-semaphore :count 0))
         (process (make-raw)) (records nil))
    (dotimes (i workers)
      (setf (svref inputs i) (new-input length seed i) (svref raws i) (make-raw))
      (verify-input hash (svref inputs i)))
    (let ((deadline (+ (get-internal-real-time) (* +deadline-seconds+ internal-time-units-per-second))))
      (declare (type natural-fixnum deadline))
      (handler-case
          (unwind-protect
               (progn
                 (dotimes (i workers)
                   (let ((input (svref inputs i)) (raw (svref raws i)))
                     (setf (svref threads i)
                           (sb-thread:make-thread (lambda () (worker-main hash input count raw ready start))
                                                  :name (format nil "key-hash-bench-~D" i)))))
                 (dotimes (i workers)
                   (unless (sb-thread:wait-on-semaphore ready :timeout (remaining-seconds deadline))
                     (fail "COD-42" "ready incompleto.")))
                 (dotimes (i workers)
                   (setf (svref ready-flags i) (eq (raw-status (svref raws i)) :ready))
                   (unless (svref ready-flags i) (fail "COD-42" "worker ~D fallito prima dello start." i)))
                 (sb-ext:gc :full t)
                 (let ((heap (the natural-fixnum (sb-ext:get-bytes-consed)))
                       (ticks (the natural-fixnum (get-internal-real-time))))
                   (declare (type natural-fixnum heap ticks))
                   (sb-thread:signal-semaphore start workers)
                   (dotimes (i workers)
                     (setf (svref joined-flags i)
                           (eq :joined (sb-thread:join-thread (svref threads i)
                                                             :timeout (remaining-seconds deadline) :default :timeout))))
                   (setf (raw-ticks process) (- (the natural-fixnum (get-internal-real-time)) ticks)
                         (raw-heap process) (- (the natural-fixnum (sb-ext:get-bytes-consed)) heap)
                         (raw-status process) :ok)))
            (stop-workers threads))
        (error (condition) (setf (raw-status process) :failed (raw-failure process) condition))))
    ;; Leggere raw soltanto dopo quiescenza; un timeout non viene promosso a successo dal cleanup.
    (dotimes (i workers)
      (let ((thread (svref threads i)) (input (svref inputs i)))
        (if (and thread (sb-thread:thread-alive-p thread))
            (push (list :worker i :status :failed :diagnostic "COD-42: worker non quiescente.") records)
            (let ((record (worker-record i (svref raws i) input count
                                         (svref ready-flags i) (svref joined-flags i))))
              (incf (raw-completed process) (raw-completed (svref raws i)))
              (handler-case
                  (progn (verify-input hash input) (setf (getf record :buffer-unchanged) t)
                         (validate-worker record count seed))
                (error (condition)
                  (setf (getf record :status) :failed (getf record :diagnostic) (princ-to-string condition))))
              (push record records)))))
    (let ((record (metric process :parallel length seed replica count
                          :workers workers :worker-results (nreverse records))))
      (setf (getf record :buffer-unchanged)
            (every (lambda (worker) (eq (getf worker :buffer-unchanged) t)) (getf record :worker-results)))
      (handler-case (validate-metric record)
        (error (condition) (setf (getf record :status) :failed (getf record :diagnostic) (princ-to-string condition))))
      (publish-metric report record)
      (unless (eq (getf record :status) :ok) (fail "COD-61" "parallelo: ~A" (getf record :diagnostic))))))

(defun preregistration (count)
  (loop for length in +lengths+ collect
    (list :length length :iterations (iterations-for length count)
          :max-iterations (iterations-for length +max-count+)
          :warmup (min +warmup+ (iterations-for length count)))))

(defun campaign-identities (parallel-p)
  "Ordine completo: nessun duplicato può sostituire una replica mancante."
  (append
   (loop for length in +lengths+ append
     (loop for seed in +seed-cases+ append
       (loop for replica below +replicas+ collect (list :serial length seed replica 1))))
   (when parallel-p
     (loop for workers in '(1 2 4) append
       (loop for length in +lengths+ append
         (loop for seed in +seed-cases+ append
           (loop for replica below +replicas+ collect (list :parallel length seed replica workers))))))))

(defun new-report ()
  (list :schema-version 1 :kind :key-hash-benchmark :status :running :exit-code nil
        :mode nil :parallel-requested nil :base-count +min-count+ :replicas +replicas+ :warmup-cap +warmup+
        :recorded-at nil :sbcl (lisp-implementation-version)
        :machine (machine-type) :os (software-type) :safety 3 :coverage :disabled
        :timer-units-per-second internal-time-units-per-second :preregistration nil
        :public-ftype nil :source-freeze nil :source-freeze-verified nil
        :sensor nil :product-self-test nil :metrics nil :diagnostic nil
        :limits '(:xxh64-original :span-0-through-65535 :non-cryptographic :explicit-u32-seed
                  :call-validation-and-counter-overhead :whole-process-heap
                  :parallel-gate-and-join-overhead :no-db-throughput :no-baseline-subtraction
                  :no-performance-threshold :seed-lifecycle-future :external-load-uncontrolled)))

(defun validate-report (report)
  (require-fields report '(:schema-version :kind :status :exit-code :mode :parallel-requested :base-count
                          :replicas :warmup-cap :recorded-at :sbcl :machine :os :safety :coverage
                          :timer-units-per-second :preregistration :public-ftype :source-freeze
                          :source-freeze-verified :sensor :product-self-test :metrics :diagnostic :limits))
  (unless (and (eql (getf report :schema-version) 1) (eq (getf report :kind) :key-hash-benchmark)
               (member (getf report :status) '(:ok :failed)))
    (fail "COD-61" "schema/stato report invalido."))
  ;; La fixture CLI negativa deve conservare proprio la metrica malformata.
  (when (eq (getf report :status) :failed)
    (unless (and (eql (getf report :exit-code) 1) (stringp (getf report :diagnostic)))
      (fail "COD-61" "report fallito senza diagnostica/codice non nullo."))
    (return-from validate-report report))
  (let ((test (getf report :product-self-test)) (count (getf report :base-count)))
    (unless (and (member (getf report :mode) '("--self-test" "--bench") :test #'equal)
                 (eql (getf report :exit-code) 0) (null (getf report :diagnostic))
                 (typep count '(integer 20000 100000))
                 (typep (getf report :recorded-at) '(integer 0))
                 (member (getf report :parallel-requested) '(nil t))
                 (or (string= (getf report :mode) "--bench") (not (getf report :parallel-requested)))
                 (eql (getf report :replicas) 5) (eql (getf report :warmup-cap) 256)
                 (eql (getf report :timer-units-per-second) internal-time-units-per-second)
                 (eq (getf report :coverage) :disabled) (eql (getf report :safety) 3)
                 (getf report :public-ftype) (getf report :source-freeze)
                 (eq (getf report :source-freeze-verified) t)
                 (equal (getf report :preregistration) (preregistration count))
                 (equal test '(:status :ok :oracle :independent-cold-xxh64 :anchors 3 :fixtures 24
                               :edge-spans 24 :empty-vectors 2 :negative-cases 26 :interleaved-recheck t)))
      (fail "COD-61" "report successo incompleto o diverso dal preregistrato."))
    (validate-sensor (getf report :sensor))
    (let ((expected (if (string= (getf report :mode) "--bench")
                        (campaign-identities (getf report :parallel-requested)) nil))
          (actual (mapcar (lambda (r) (mapcar (lambda (key) (getf r key))
                                             '(:kind :length :seed-case :replica :workers)))
                          (getf report :metrics))))
      (unless (equal expected actual) (fail "COD-61" "repliche mancanti, duplicate o fuori ordine.")))
    (dolist (record (getf report :metrics))
      (validate-metric record)
      (unless (eql (getf record :iterations) (iterations-for (getf record :length) count))
        (fail "COD-61" "conteggio adattato invece che preregistrato."))))
  report)

(defun create-directory (requested)
  "mkdir esclusivo 0700: directory esistente rifiutata, nessun file sovrascritto."
  (unless (and (plusp (length requested)) (char= (char requested (1- (length requested))) #\/))
    (fail "COD-61" "DIR/ obbligatoria, con slash finale."))
  (let ((path (uiop:ensure-directory-pathname (merge-pathnames requested *root*))))
    (ensure-directories-exist (merge-pathnames "parent-placeholder"
                                              (uiop:pathname-parent-directory-pathname path)))
    (sb-posix:mkdir (namestring path) #o700)
    (truename path)))

(defun parse-arguments (args)
  (unless (and (<= 2 (length args) 4)
               (member (first args) '("--self-test" "--negative-fixture" "--bench") :test #'string=)
               (or (string= (first args) "--bench") (= (length args) 2)))
    (fail "COD-61" "uso --self-test DIR/ | --negative-fixture DIR/ | --bench DIR/ [--parallel] [COUNT 20000..100000]."))
  (let ((parallel-p nil) (count +min-count+) (count-seen nil))
    (dolist (token (cddr args))
      (cond ((string= token "--parallel")
             (when parallel-p (fail "COD-61" "--parallel duplicato.")) (setf parallel-p t))
            ((and (<= 1 (length token) 6) (every #'digit-char-p token) (not count-seen))
             (setf count (parse-integer token) count-seen t))
            (t (fail "COD-61" "argomento inatteso: ~S." token))))
    (unless (<= +min-count+ count +max-count+) (fail "COD-61" "COUNT fuori 20000..100000."))
    (values (first args) (second args) parallel-p count)))

(defun execute-mode (hash report directory)
  (when (string= (getf report :mode) "--negative-fixture")
    (let ((broken (metric (make-raw :completed 1 :status :ok) :serial 1 :zero 0 1)))
      (remf broken :completed) (publish-metric report broken) (validate-metric broken))
    (fail "COD-60" "fixture CLI negativa non rilevata."))
  (setf (getf report :sensor) (sensor-self-test directory)
        (getf report :product-self-test) (product-self-test hash))
  (when (string= (getf report :mode) "--bench")
    (dolist (length +lengths+)
      (dolist (seed +seed-cases+)
        (dotimes (replica +replicas+) (serial-one hash report length seed replica))))
    (when (getf report :parallel-requested)
      (dolist (workers '(1 2 4))
        (dolist (length +lengths+)
          (dolist (seed +seed-cases+)
            (dotimes (replica +replicas+) (parallel-one hash report length seed replica workers)))))))
  (verify-source-freeze report)
  (setf (getf report :source-freeze-verified) t))

(defun main ()
  (let ((report (new-report)) (directory nil))
    (capture-run report
      (lambda ()
        (multiple-value-bind (mode requested parallel-p count)
            (parse-arguments (uiop:command-line-arguments))
          (setf (getf report :mode) mode (getf report :parallel-requested) parallel-p
                (getf report :base-count) count (getf report :preregistration) (preregistration count)
                directory (create-directory requested))
          (let ((hash (load-product report)))
            (setf (getf report :recorded-at) (get-universal-time))
            (execute-mode hash report directory)))))
    (setf (getf report :metrics) (nreverse (getf report :metrics)))
    ;; Un errore nella validazione finale diventa un report :failed prima della sola scrittura.
    (handler-case (validate-report report)
      (error (condition) (capture-run report (lambda () (error condition)))))
    (when directory
      (handler-case (write-frozen report directory "report.lisp" #'validate-report)
        (error (condition)
          (setf (getf report :exit-code) 1)
          (format *error-output* "tools/key-hash-bench.lisp COD-61: persistenza/rilettura: ~A~%" condition))))
    (when (getf report :diagnostic) (format *error-output* "~A~%" (getf report :diagnostic)))
    (format t "~S: ~A~%" (if (zerop (getf report :exit-code)) :ok :failed)
            (or directory (getf report :diagnostic)))
    (sb-ext:exit :code (getf report :exit-code))))

;; Il flag di libreria serve solo a compilazione/ispezione: non avvia clock o campagne.
(unless (member :key-hash-bench-library *features*) (main))
