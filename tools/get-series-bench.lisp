;;;; C4 ponte GET/controller. SOLO il parent esegue dopo freeze, via record-command.lisp.
;;;; Uso: --self-test|--bench|--negative-record-case spikes/out/<namespace-nuovo>/.
;;;; --library carica soltanto definizioni C4, senza compilare/caricare il prodotto.
;;; OWNER: main possiede fixture, file log e handle thread; reader i possiede contesto/output/raw i.
;;; SHARED: controller/root/directory/mappe/FD immutabili; cache locale Serie; sensore heap globale.
;;; REQ: REQ-IDX-001 REQ-CCH-002 REQ-CMP-007 REQ-AFF-008 REQ-VAL-001
(require :asdf)
(require :sb-posix)
(defpackage #:arcdocdb.get.series.bench (:use #:cl))
(in-package #:arcdocdb.get.series.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defconstant +count+ 20000)
(defconstant +warmup+ 1000)
(defconstant +replicas+ 5)
(defconstant +sentinel+ #xcc)
(defconstant +csn+ #xffffffffffffffff)
(defconstant +window-seconds+ 30)
(defconstant +campaign-seconds+ 600)
(deftype octets () '(simple-array (unsigned-byte 8) (*)))
(deftype candidate-words () '(simple-array (unsigned-byte 64) (5)))
;;; OWNER: main, binding per invocazione; reader scrive soltanto nel proprio RAW.
(defvar *threads* #())
(defvar *deadline* 0)
(define-condition bench-failure (error)
  ((detail :initarg :detail :reader failure-detail))
  (:report (lambda (condition stream)
             (format stream "tools/get-series-bench.lisp COD-61: ~A" (failure-detail condition)))))
(defun fail (control &rest arguments)
  (error 'bench-failure :detail (apply #'format nil control arguments)))
(defun api (package name &key internal)
  "Ricerca cold di un nome esistente; nessun INTERN o ricerca nel ciclo misurato."
  (multiple-value-bind (symbol visibility) (find-symbol name package)
    (unless (and symbol (fboundp symbol) (or internal (eq visibility :external)))
      (fail "API assente ~A:~A." package name))
    (symbol-function symbol)))
(defun fixture-api (name)
  (api "ARCDOCDB.GET.DIRECTORY.TESTS" name))
(defun field (fixture suffix)
  (funcall (fixture-api (concatenate 'string "DIRECTORY-FIXTURE-" suffix)) fixture))
(defun remaining (deadline)
  (/ (max 0 (- deadline (get-internal-real-time)))
     (float internal-time-units-per-second 1d0)))
(defun require-time (deadline)
  (unless (plusp (remaining deadline)) (fail "deadline scaduta.")))
(defun workers-alive-p ()
  (some (lambda (thread) (and thread (sb-thread:thread-alive-p thread))) *threads*))
(defun stop-workers ()
  "Cleanup bounded di soli thread propri; FD conservati se resta un reader vivo."
  (let ((deadline (+ (get-internal-real-time) (* 2 internal-time-units-per-second))))
    (map nil (lambda (thread)
               (when (and thread (sb-thread:thread-alive-p thread)) (sb-thread:terminate-thread thread))) *threads*)
    (map nil (lambda (thread)
               (when thread (sb-thread:join-thread thread :timeout (remaining deadline) :default :timeout))) *threads*))
  (not (workers-alive-p)))
(defun load-product ()
  "LOAD-SYSTEM fuori dai clock; nessun TEST-OP. Dipendenze/support già esistenti."
  (let ((*standard-output* *error-output*))
    (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
    (asdf:load-system "arcdocdb/tests")))
(defun exclusive-directory (path)
  "Namespace nuovo soltanto sotto spikes/out, anche dopo risoluzione dei symlink parent."
  (let* ((directory (merge-pathnames (uiop:ensure-directory-pathname path) (truename "./")))
         (parent (uiop:pathname-parent-directory-pathname directory)))
    (ensure-directories-exist (merge-pathnames "placeholder" parent))
    (unless (uiop:subpathp (truename parent) (truename "spikes/out/"))
      (fail "output fuori da spikes/out: ~A." directory))
    (sb-posix:mkdir (namestring directory) #o700)
    (truename directory)))
(defun save-report (report directory)
  "Un solo record strutturato; checkpoint parziali conservati prima del gate."
  (let ((temporary (merge-pathnames "report.tmp" directory))
        (final (merge-pathnames "report.lisp" directory)))
    (with-open-file (out temporary :direction :output :if-exists :supersede :external-format :utf-8)
      (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil))
        (write report :stream out :pretty t) (terpri out)))
    (sb-posix:rename (namestring temporary) (namestring final))))
(defstruct profile fixture controller file (n 1 :type fixnum) segments ends expected contributions cache-contributions)
(defstruct raw (completed 0 :type fixnum) (checksum 0 :type fixnum) failure)
(defun reference-le (image start width)
  (let ((number 0))
    (dotimes (i width number)
      (setf number (+ number (ash (aref image (+ start i)) (* 8 i)))))))
(defun prepare-oracle (fixture n)
  "Cold: oracolo bytewise da immagini fixture e ordine di pubblicazione; mai GET osservato."
  (let ((segments (make-array n)) (ends (field fixture "ENDS"))
        (expected (make-array n)) (contributions (make-array n)) (cache-contributions (make-array n)))
    (unless (and (= n (length (field fixture "MAPS")) (length ends) (length (field fixture "IMAGES"))
                   (length (field fixture "IDS")) (length (field fixture "KEYS")) (length (field fixture "VALUES")))
                 (= 4 (length (field fixture "CONTEXTS")) (length (field fixture "OUTPUTS"))))
      (fail "cardinalita fixture discordanti."))
    (dotimes (i n)
      (let* ((image (svref (field fixture "IMAGES") i)) (value (svref (field fixture "VALUES") i))
             (id (svref (field fixture "IDS") i)) (words (make-array 5 :element-type '(unsigned-byte 64))))
        (unless (and (= 2 (reference-le image 8 2)) (= id (reference-le image 32 8))
                     (= +csn+ (reference-le image 80 8)) (= 16 (reference-le image 74 2))
                     (= 16 (length value) (reference-le image 76 4))
                     (= 120 (svref ends i)) (= 1 (aref image 72)) (zerop (aref image 73)))
          (fail "fixture CLOSED ordinaria discordante a ~D." i))
        (dotimes (k 16)
          (unless (= (aref value k) (aref image (+ 104 k))) (fail "immagine/valore ~D." i)))
        ;; Un solo frammento, key16 inserite una volta in ordine; END retention non usato.
        (setf (aref words 0) +csn+ (aref words 1) (+ (ash id 32) 64)
              (aref words 2) (+ (* i 16) (ash 16 32) (ash 1 48))
              (aref words 3) 56 (aref words 4) 0
              (svref expected i) words (svref contributions i) (+ 1 id 120)
              (svref cache-contributions i) (+ 1 id 120 (reduce #'+ value))
              (svref segments i)
              (funcall (api "ARCDOCDB.GET.RESOLVER" "MAPPA-SEGMENTO-GET-SEGMENT" :internal t)
                       (svref (field fixture "MAPS") i)))))
    (values segments ends expected contributions cache-contributions)))
(defun prepare-profile (fixture n directory)
  "FONTI constructor e controller fuori dai clock; root CLOSED-only tramite API pubbliche."
  (let* ((sources (funcall (api "ARCDOCDB.GET.DIRECTORY" "CREA-FONTI-GET-SERIE") (field fixture "DIRECTORY")))
         (file nil) (complete nil))
    (unwind-protect
         (progn
           (setf file (funcall (api "ARCDOCDB.IO" "CREA-TEMPORANEO")
                               (merge-pathnames (format nil "controller-~D.tmp" n) directory)))
           (let* ((registry (funcall (api "ARCDOCDB.CSN" "CREA-REGISTRO-CSN") :capacity 4))
                  (log (funcall (api "ARCDOCDB.WAL" "CREA-LOG-IO") file :segment 1))
                  (controller (funcall (api "ARCDOCDB.SERIES" "CREA-CONTROLLORE-SERIE")
                                       registry log :capacity 1 :root sources)))
             (multiple-value-bind (segments ends expected contributions cache-contributions) (prepare-oracle fixture n)
               (setf complete t)
               (make-profile :fixture fixture :controller controller :file file :n n
                             :segments segments :ends ends :expected expected :contributions contributions
                             :cache-contributions cache-contributions))))
      (when (and file (not complete)) (funcall (api "ARCDOCDB.IO" "CHIUDI") file)))))
(defun check-candidate (actual expected)
  (declare (type candidate-words actual expected))
  (dotimes (word 5)
    ;; Confronto u64 per due u32; allocazioni da misurare nel run centralizzato.
    (unless (and (= (ldb (byte 32 0) (aref actual word)) (ldb (byte 32 0) (aref expected word)))
                 (= (ldb (byte 32 32) (aref actual word)) (ldb (byte 32 32) (aref expected word))))
      (fail "candidato discordante nella word ~D." word))))
(defun check-output (output value copied-p)
  (declare (type octets output value))
  (let ((sum 0))
    (dotimes (k (length output) sum)
      (let ((byte (aref output k)))
        (unless (= byte (if (and copied-p (<= 3 k) (< k 19)) (aref value (- k 3)) +sentinel+))
          (fail "byte/sentinella output discordante a ~D." k))
        (when (and copied-p (<= 3 k) (< k 19)) (incf sum byte))))))
(defun check-resolved (profile ordinal segment end flags proof)
  (unless (and (eq segment (svref (profile-segments profile) ordinal))
               (= end (svref (profile-ends profile) ordinal)) (zerop flags) (null proof))
    (fail "selezione CLOSED discordante: segment/END/flags/proof.")))
(defun make-cycle (profile worker scenario)
  "Closure privata; lookup, dispatch controller e verifica completa dentro la finestra."
  (let* ((fixture (profile-fixture profile)) (n (profile-n profile)) (cursor (mod worker n))
         (context (svref (field fixture "CONTEXTS") worker)) (output (svref (field fixture "OUTPUTS") worker))
         (keys (field fixture "KEYS")) (values (field fixture "VALUES")) (view (field fixture "VIEW"))
         (candidate (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0))
         (start (api "ARCDOCDB.GET" "AVVIA-GET")) (copy (api "ARCDOCDB.GET" "COPIA-CANDIDATO-GET"))
         (resolve (api "ARCDOCDB.GET.DIRECTORY" "RISOLVI-CANDIDATO-SERIE-GET"))
         (probe (api "ARCDOCDB.GET.DIRECTORY" "SONDA-CACHE-SERIE-GET"))
         (read-record (api "ARCDOCDB.GET.DIRECTORY" "LEGGI-RECORD-SERIE-GET"))
         (copy-value (api "ARCDOCDB.GET" "COPIA-VALORE-GET")) (finish (api "ARCDOCDB.GET" "CONCLUDI-GET"))
         (abandon (api "ARCDOCDB.GET" "ABBANDONA-GET")) (state (api "ARCDOCDB.GET" "STATO-CONTESTO-GET"))
         (active (api "ARCDOCDB.EPOCHS" "EPOCA-ATTIVA-P"))
         (reader (funcall (api "ARCDOCDB.EPOCHS" "CONTESTO-EPOCA") (field fixture "EPOCHS") worker))
         (clean (fixture-api "DIRECTORY-CHECK-CLEAN")))
    (lambda ()
      (let ((i cursor) (copied-p nil) (sum 0))
        (fill output +sentinel+)
        (unwind-protect
             (progn
               (unless (and (eq :candidate (funcall start context view (svref keys i) nil 0 0))
                            (eq :candidate (funcall state context)) (funcall active reader))
                 (fail "CANDIDATE/pin non acquisito."))
               (funcall copy context candidate)
               (check-candidate candidate (svref (profile-expected profile) i))
               ;; Anche cache-hit verifica indipendentemente la selezione prima della sonda.
               ;; Due acquisizioni root nel ciclo cache, una per ciascuna API, stessa epoca.
               (multiple-value-bind (segment end flags proof) (funcall resolve context (profile-controller profile))
                 (check-resolved profile i segment end flags proof)
                 (setf sum (+ 1 end (ldb (byte 32 32) (aref candidate 1)))))
               (unless (eq :candidate (funcall state context)) (fail "resolve cambia stato."))
               (case scenario
                 (:resolve nil)
                 ((:cache-hit :read)
                  (if (eq scenario :cache-hit)
                      (unless (eq :hit (funcall probe context (profile-controller profile))) (fail "cache senza HIT."))
                      (multiple-value-bind (source cache insertion evicted scan)
                          (funcall read-record context (profile-controller profile))
                        (unless (or (and (eq source :segment) (eq cache :miss) (eq insertion :inserted)
                                         (null evicted) (null scan))
                                    (and (eq source :cache) (eq cache :hit) (eq insertion :not-attempted)
                                         (null evicted) (null scan))) (fail "read enum/eviction/scan."))))
                  (unless (= 19 (funcall copy-value context output 3)) (fail "fine copia."))
                  (multiple-value-bind (result size) (funcall finish context 1)
                    (unless (and (eq result :found) (= size 16)) (fail "FOUND/size.")))
                  (setf copied-p t))
                 (otherwise (fail "scenario ~S." scenario)))
               (incf sum (check-output output (svref values i) copied-p)))
          (funcall abandon context))
        (unless (and (eq :idle (funcall state context)) (not (funcall active reader))) (fail "pin/stato residuo."))
        (funcall clean fixture worker)
        (setf cursor (mod (1+ cursor) n))
        sum))))
(defun expected-checksum (profile worker count scenario)
  (let ((sum 0) (cursor (mod worker (profile-n profile))))
    (dotimes (i count sum)
      (incf sum (svref (if (eq scenario :resolve) (profile-contributions profile) (profile-cache-contributions profile)) cursor))
      (setf cursor (mod (1+ cursor) (profile-n profile))))))
(defun run-loop (cycle count raw deadline)
  "Worker boundary: conserva progresso e condizione; timeout distinto dal successo."
  (handler-case
      (dotimes (i count)
        (when (zerop (logand i 255)) (require-time deadline))
        (incf (raw-checksum raw) (the fixnum (funcall cycle)))
        (setf (raw-completed raw) (1+ i)))
    (error (condition) (setf (raw-failure raw) (princ-to-string condition))))
  :completed)
(defun validate-window (record)
  (unless (and (eq :ok (getf record :status)) (eq t (getf record :quiescent))
               (eql (getf record :requested) (getf record :completed))
               (eql (getf record :checksum) (getf record :expected-checksum))
               (typep (getf record :ticks) '(integer 0)) (typep (getf record :heap-bytes) '(integer 0))
               (every (lambda (worker)
                        (and (null (getf worker :failure)) (eql (getf worker :requested) (getf worker :completed))
                             (eql (getf worker :checksum) (getf worker :expected-checksum)))) (getf record :workers)))
    (fail "finestra incompleta/discordante."))
  record)
(defun run-window (profile scenario execution workers replica count warmup)
  (require-time *deadline*)
  (let* ((cycles (make-array workers)) (raws (make-array workers)) (expected (make-array workers))
         (threads (make-array workers :initial-element nil)) (error-text nil) (ticks 0) (heap 0)
         (gate (sb-thread:make-semaphore :count 0)) (deadline 0))
    (dotimes (id workers)
      (let ((warm (make-cycle profile id scenario))) (dotimes (i warmup) (funcall warm)))
      (setf (svref cycles id) (make-cycle profile id scenario) (svref raws id) (make-raw)
            (svref expected id) (expected-checksum profile id count scenario)))
    (setf *threads* threads)
    (sb-ext:gc :full t)
    (setf deadline (min *deadline* (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second))))
    (let ((start-ticks (get-internal-real-time)) (start-heap (sb-ext:get-bytes-consed)))
      (unwind-protect
           (handler-case
               (progn
                (if (eq execution :serial)
                   (run-loop (svref cycles 0) count (svref raws 0) deadline)
                   (progn
                     (dotimes (id workers)
                       (let ((cycle (svref cycles id)) (raw (svref raws id)))
                         (setf (svref *threads* id)
                               (sb-thread:make-thread
                                (lambda ()
                                  (handler-case
                                      (progn
                                        (unless (sb-thread:wait-on-semaphore gate :timeout (remaining deadline))
                                          (fail "start gate timeout."))
                                      (run-loop cycle count raw deadline))
                                    (error (condition) (setf (raw-failure raw) (princ-to-string condition))))
                                  :completed)))))
                     (sb-thread:signal-semaphore gate workers)
                     (map nil (lambda (thread)
                                (unless (eq :completed (sb-thread:join-thread thread :timeout (remaining deadline)
                                                                            :default :timeout)) (fail "join timeout."))) *threads*)))
               (require-time deadline))
             (error (condition) (setf error-text (princ-to-string condition))))
        (setf heap (- (sb-ext:get-bytes-consed) start-heap) ticks (- (get-internal-real-time) start-ticks))))
    (when (workers-alive-p) (stop-workers))
    (let* ((quiet (not (workers-alive-p)))
           (records (when quiet (loop for id below workers for raw = (svref raws id) collect
                                     (list :worker id :requested count :completed (raw-completed raw)
                                           :checksum (raw-checksum raw) :expected-checksum (svref expected id)
                                           :failure (raw-failure raw)))))
           (completed (when quiet (reduce #'+ records :key (lambda (r) (getf r :completed)))))
           (sum (when quiet (reduce #'+ records :key (lambda (r) (getf r :checksum))))))
      (list :scenario scenario :execution execution :readers workers :n (profile-n profile) :replica replica
            :count-per-reader count :warmup-per-reader warmup :requested (* workers count) :completed completed
            :checksum sum :expected-checksum (reduce #'+ expected) :ticks ticks :heap-bytes heap
            :seconds (/ ticks (float internal-time-units-per-second 1d0)) :quiescent quiet :workers records
            :root-acquisitions-per-cycle (if (eq scenario :resolve) 1 2)
            :measurement (if (eq scenario :resolve) :start-resolve-abandon :start-resolve-probe-copy-finish-abandon)
            :gate-startup-wait-join-in-window (eq execution :parallel)
            :status (if (and quiet (null error-text) (= completed (* workers count)) (= sum (reduce #'+ expected))
                             (every (lambda (r) (null (getf r :failure))) records)) :ok :failed)
            :diagnostic error-text))))
(defun expect-rejection (function)
  (let ((caught nil))
    (handler-case (funcall function) (bench-failure () (setf caught t)))
    (unless caught (fail "self-test: controllo negativo accettato."))))
(defun self-test ()
  "COD-60: controlli negativi su candidato, output e record; sensore heap con payload trattenuto."
  (let* ((words (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0))
         (output (make-array 22 :element-type '(unsigned-byte 8) :initial-element +sentinel+))
         (value (make-array 16 :element-type '(unsigned-byte 8) :initial-element 1))
         (good (list :status :ok :quiescent t :requested 8 :completed 8 :checksum 8 :expected-checksum 8
                     :ticks 0 :heap-bytes 0 :workers '((:requested 8 :completed 8 :checksum 8 :expected-checksum 8)))))
    (validate-window good)
    (dolist (key '(:completed :quiescent :heap-bytes))
      (let ((bad (copy-tree good))) (remf bad key) (expect-rejection (lambda () (validate-window bad)))))
    (dotimes (i 5)
      (let ((bad (copy-seq words)))
        (setf (aref bad i) (ash 1 40))
        (expect-rejection (lambda () (check-candidate bad words)))))
    (setf (aref output 0) 0)
    (expect-rejection (lambda () (check-output output value nil)))
    (let ((profile (make-profile :segments (vector :expected) :ends (vector 120))))
      (expect-rejection (lambda () (check-resolved profile 0 :wrong 120 0 nil)))
      (expect-rejection (lambda () (check-resolved profile 0 :expected 121 0 nil))))
    (let* ((start (sb-ext:get-bytes-consed))
           (retained (make-array 1048576 :element-type '(unsigned-byte 8) :initial-element 47))
           (delta (- (sb-ext:get-bytes-consed) start)))
      (unless (and (>= delta 1048576) (= 47 (aref retained 0) (aref retained 1048575)))
        (fail "sensore heap non rileva payload trattenuto."))
      (list :status :ok :negative-checks 11 :allocation-control-bytes 1048576 :observed-heap-bytes delta))))
(defun negative-record-case (report directory)
  "COD-61: conserva record senza COMPLETED e fallisce esplicitamente, prima di caricare il prodotto."
  (let ((broken (list :status :ok :quiescent t :requested 8 :checksum 8 :expected-checksum 8
                      :ticks 0 :heap-bytes 0 :workers nil :origin :synthetic-missing-completed)))
    (push broken (getf report :windows)) (save-report report directory)
    (validate-window broken)
    (fail "negative record non rilevato.")))
(defun campaign (report directory count warmup replicas)
  (dolist (n '(1 8 64))
    (let ((fixture nil) (profile nil))
      (unwind-protect
           (progn
             (setf fixture (funcall (fixture-api "MAKE-DIRECTORY-FIXTURE") :count n :value-bytes 16 :workers 4)
                   profile (prepare-profile fixture n directory))
             ;; Warm read della NUOVA API e verifica di tutte N dopo gli inserimenti, cold.
             (let ((read (make-cycle profile 0 :read)) (probe (make-cycle profile 0 :cache-hit)))
               (dotimes (i n) (funcall read)) (dotimes (i n) (funcall probe)))
             (dolist (scenario '(:resolve :cache-hit))
               (dotimes (replica replicas)
                 (dolist (configuration '((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4)))
                   (let ((record (run-window profile scenario (first configuration) (second configuration)
                                             replica count warmup)))
                     (push record (getf report :windows)) (save-report report directory)
                     (validate-window record))))))
        (when (workers-alive-p) (stop-workers))
        (unless (workers-alive-p)
          (when profile (funcall (api "ARCDOCDB.IO" "CHIUDI") (profile-file profile)))
          (when fixture (funcall (fixture-api "CLOSE-DIRECTORY-FIXTURE") fixture)))))))
(defun validate-campaign (records count warmup replicas)
  "Ogni cella preregistrata una volta; non basta il totale di finestre/completamenti."
  (unless (= (length records) (* 24 replicas)) (fail "matrice incompleta."))
  (dolist (n '(1 8 64))
    (dolist (scenario '(:resolve :cache-hit))
      (dotimes (replica replicas)
        (dolist (configuration '((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4)))
          (unless (= 1 (count-if (lambda (record)
                                   (and (= n (getf record :n)) (eq scenario (getf record :scenario))
                                        (= replica (getf record :replica)) (eq (first configuration) (getf record :execution))
                                        (= (second configuration) (getf record :readers))
                                        (= count (getf record :count-per-reader)) (= warmup (getf record :warmup-per-reader)))) records))
            (fail "cella mancante/duplicata."))))))
  (mapc #'validate-window records))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (directory nil) (*threads* #())
         (*deadline* (+ (get-internal-real-time) (* +campaign-seconds+ internal-time-units-per-second)))
         (report (list :schema-version 1 :kind :get-series-benchmark :status :running
                       :argv args :mode (first args) :self-test nil :windows nil :diagnostic nil
                       :started-at-universal-time (get-universal-time)
                       :environment (list :lisp (lisp-implementation-version) :machine (machine-type)
                                          :os (software-type) :os-version (software-version) :cwd (namestring (truename "./"))
                                          :timer-units internal-time-units-per-second :heap :sb-ext-get-bytes-consed
                                          :heap-scope :whole-process :external-load :uncontrolled)
                       :campaign '(:n (1 8 64) :value-bytes 16 :scenarios (:resolve :cache-hit)
                                   :replicas 5 :count-per-reader 20000 :warmup-per-reader 1000
                                   :configurations ((:serial 1) (:parallel 1) (:parallel 2) (:parallel 4))
                                   :windows 120 :measured-cycles 4800000 :warmup-cycles 240000
                                   :deadline-seconds 600 :window-deadline-seconds 30 :cleanup-seconds 2
                                   :cache-measurement :resolve-plus-probe :cache-root-acquisitions-per-cycle 2)
                       :static-risks '(:parent-source-freeze-required :not-executed-by-author :sbcl64-required
                                       :tests-system-loaded-outside-clock :closed-only :ordinary-v2-only
                                       :fixture-published-primary-assumption :single-fragment-arena-order
                                       :candidate-output-pin-checks-in-window :deadline-poll-every-256-cycles
                                       :parallel-gate-wait-startup-and-join-in-window :gate-not-proof-of-temporal-overlap
                                       :self-test-count8-not-proof-of-temporal-overlap :fixed-count-aborts-on-deadline
                                       :campaign-deadline-cooperative-in-cold-load-and-native-io
                                       :heap-is-whole-process-allocation-not-rss :failed-cleanup-outside-window
                                       :allocations-and-compiler-warnings-unverified
                                       :no-controller-publication-or-reclaim-measurement :no-performance-threshold
                                       :no-database-throughput-claim))))
    (handler-case
        (progn
          (unless (and (= 2 (length args))
                       (member (first args) '("--self-test" "--bench" "--negative-record-case") :test #'string=))
            (fail "usage --self-test|--bench|--negative-record-case spikes/out/<namespace-nuovo>/."))
          (setf directory (exclusive-directory (second args))) (save-report report directory)
          (when (string= "--negative-record-case" (first args)) (negative-record-case report directory))
          (setf (getf report :self-test) (self-test)) (save-report report directory)
          (load-product)
          (let ((bench-p (string= "--bench" (first args))))
            (campaign report directory (if bench-p +count+ 8) (if bench-p +warmup+ 8) (if bench-p +replicas+ 1))
            (validate-campaign (getf report :windows) (if bench-p +count+ 8) (if bench-p +warmup+ 8)
                               (if bench-p +replicas+ 1)))
          (setf (getf report :status) :ok))
      (error (condition)
        (setf (getf report :status) :failed
              (getf report :diagnostic) (format nil "tools/get-series-bench.lisp COD-61: ~A" condition))))
    (setf (getf report :finished-at-universal-time) (get-universal-time))
    (when directory (save-report report directory))
    (let ((*print-readably* nil) (*print-escape* t)) (write report :pretty t) (terpri))
    (sb-ext:exit :code (if (eq :ok (getf report :status)) 0 1))))
(unless (equal (uiop:command-line-arguments) '("--library")) (main))
