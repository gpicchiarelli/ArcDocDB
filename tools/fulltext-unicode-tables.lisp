;;;; Generatore C4 di tabelle numeriche Unicode 18; gli ingressi non sono codice Lisp.
;;;; REQ: REQ-SEC-007
(require :asdf)
(setf *read-eval* nil)
(defpackage #:arcdocdb.fulltext.unicode.generator (:use #:cl))
(in-package #:arcdocdb.fulltext.unicode.generator)
(defparameter +properties+
  '("Other" "CR" "LF" "Newline" "Extend" "ZWJ" "Regional_Indicator" "Format"
    "Katakana" "Hebrew_Letter" "ALetter" "Single_Quote" "Double_Quote"
    "MidNumLet" "MidLetter" "MidNum" "Numeric" "ExtendNumLet" "WSegSpace"))
(defun split (text separator)
  (mapcar (lambda (s) (string-trim '(#\Space #\Tab #\Return) s))
          (uiop:split-string text :separator (list separator))))
(defun code-number (text)
  (let ((n (parse-integer text :radix 16 :junk-allowed nil)))
    (unless (<= 0 n #x10ffff) (error "Scalare fuori intervallo: ~A" text)) n))
(defun code-list (text)
  (mapcar #'code-number (remove "" (split text #\Space) :test #'string=)))
(defun map-lines (path function)
  (with-open-file (in path :external-format :utf-8)
    (loop for line = (read-line in nil) while line do
      (let ((text (string-trim '(#\Space #\Tab #\Return)
                               (subseq line 0 (position #\# line)))))
        (when (plusp (length text)) (funcall function text))))))
(defun range-bounds (text)
  (let ((dot (search ".." text)))
    (let ((lo (code-number (if dot (subseq text 0 dot) text)))
          (hi (code-number (if dot (subseq text (+ dot 2)) text))))
      (unless (<= lo hi) (error "Range invertito: ~A" text)) (values lo hi))))
(defun property-array (path selected &optional classes)
  (let ((result (make-array #x110000 :element-type '(unsigned-byte 8) :initial-element 0)))
    (map-lines path
      (lambda (line)
        (let ((fields (split line #\;)))
          (unless (>= (length fields) 2) (error "Riga proprieta malformata"))
          (when (or classes (string= selected (second fields)))
            (let ((value (if classes (position (second fields) classes :test #'string=) 1)))
              (unless value (error "Proprieta non supportata: ~A" (second fields)))
              (multiple-value-bind (lo hi) (range-bounds (first fields))
                (loop for cp from lo to hi do
                  (unless (zerop (aref result cp)) (error "Range sovrapposto: ~A" line))
                  (setf (aref result cp) value))))))))
    result))
(defun unicode-data (path)
  (let ((ccc (make-array #x110000 :element-type '(unsigned-byte 8) :initial-element 0))
        (letter (make-array #x110000 :element-type '(unsigned-byte 8) :initial-element 0))
        (decomp nil) (pending nil) (last-code -1))
    (map-lines path
      (lambda (line)
        (let* ((f (split line #\;)) (cp (code-number (first f))))
          (unless (and (= 15 (length f)) (> cp last-code)) (error "UnicodeData non ordinato"))
          (setf last-code cp)
          (let ((class (parse-integer (fourth f)))
                (word (if (find (char (third f) 0) "LN") 1 0)))
            (unless (<= 0 class 255) (error "CCC invalida"))
            (cond ((search ", First>" (second f))
                   (when pending (error "Range UCD annidato"))
                   (setf pending (list cp class word)))
                  ((search ", Last>" (second f))
                   (unless (and pending (= class (second pending)) (= word (third pending)))
                     (error "Range UCD incoerente"))
                   (loop for i from (first pending) to cp do
                     (setf (aref ccc i) class (aref letter i) word))
                   (setf pending nil))
                  (t (when pending (error "Range UCD incompleto"))
                     (setf (aref ccc cp) class (aref letter cp) word)))
            (let ((mapping (sixth f)))
              (when (and (plusp (length mapping)) (char/= #\< (char mapping 0)))
                (push (cons cp (code-list mapping)) decomp)))))))
    (when pending (error "Range UCD senza terminazione"))
    (values ccc letter (nreverse decomp))))
(defun case-mappings (path)
  (let ((items nil))
    (map-lines path
      (lambda (line)
        (let ((f (split line #\;)))
          (unless (>= (length f) 3) (error "CaseFolding malformato"))
          (when (member (second f) '("C" "F") :test #'string=)
            (push (cons (code-number (first f)) (code-list (third f))) items)))))
    (sort items #'< :key #'car)))
(defun packed-ranges (array)
  (let ((items nil) (start 0))
    (loop for i from 1 to (length array) do
      (when (or (= i (length array)) (/= (aref array start) (aref array i)))
        (unless (zerop (aref array start))
          (push start items) (push (1- i) items) (push (aref array start) items))
        (setf start i)))
    (nreverse items)))
(defun packed-mappings (mappings)
  (let ((records nil) (data nil) (count 0))
    (dolist (item mappings)
      (push (car item) records) (push count records) (push (length (cdr item)) records)
      (dolist (cp (cdr item)) (push cp data) (incf count)))
    (values (nreverse records) (nreverse data))))
(defun composition-pairs (decompositions exclusions)
  (let ((pairs nil))
    (dolist (item decompositions)
      (when (and (= 2 (length (cdr item))) (zerop (aref exclusions (car item))))
        (push (cons (+ (ash (second item) 21) (third item)) (car item)) pairs)))
    (loop for item in (sort pairs #'< :key #'car) append (list (car item) (cdr item)))))
(defun emit-table (stream name contents &optional (bits 32))
  (format stream "~%;;; OWNER: caricamento del modulo; tabella privata immutabile.~%")
  (format stream ";;; SHARED: sole letture fra Serie, nessuna scrittura per operazione.~%")
  (format stream ";;; REQ: REQ-SEC-007~%(defparameter ~A~%  (make-array ~D :element-type '(unsigned-byte ~D)~%    :initial-contents '(" name (length contents) bits)
  (loop for item in contents for i from 0 do
    (if (zerop (mod i 12)) (progn (terpri stream) (write-string "      " stream))
        (write-char #\Space stream))
    (format stream "~D" item))
  (format stream "))~%  \"Tabella Unicode 18.0.0 generata; immutabile dopo il caricamento.\")~%")
  (format stream "(declaim (type (simple-array (unsigned-byte ~D) (*)) ~A))~%" bits name))
(defun generate-tables (root output)
  (let* ((base (uiop:ensure-directory-pathname root))
         (readme (uiop:read-file-string (merge-pathnames "ReadMe.txt" base))))
    (unless (search "final data files for version 18.0.0" readme) (error "Versione UCD errata"))
    (multiple-value-bind (ccc letter decomp) (unicode-data (merge-pathnames "UnicodeData.txt" base))
      (let* ((fold (case-mappings (merge-pathnames "CaseFolding.txt" base)))
             (exclusions (property-array (merge-pathnames "DerivedNormalizationProps.txt" base)
                                         "Full_Composition_Exclusion"))
             (wb (property-array (merge-pathnames "auxiliary/WordBreakProperty.txt" base)
                                 nil +properties+))
             (pict (property-array (merge-pathnames "emoji/emoji-data.txt" base) "Extended_Pictographic")))
        (ensure-directories-exist output)
        (with-open-file (s output :direction :output :if-exists :supersede :external-format :utf-8)
          (format s ";;;; Dati Unicode 18.0.0; generati da tools/fulltext-unicode-tables.lisp.~%")
          (format s ";;;; Copyright Unicode, Inc.; licenza in data/unicode/18.0.0/LICENSE.txt.~%")
          (format s "(in-package #:arcdocdb.fulltext.analysis)~%(declaim (optimize (safety 3)))~%")
          (loop for name in +properties+ for code from 0 do
            (format s ";;; REQ: REQ-SEC-007~%(defconstant +wb-~A+ ~D)~%"
                    (string-downcase (substitute #\- #\_ name)) code))
          (emit-table s "+ccc-ranges+" (packed-ranges ccc))
          (emit-table s "+letter-ranges+" (packed-ranges letter))
          (emit-table s "+word-ranges+" (packed-ranges wb))
          (emit-table s "+pict-ranges+" (packed-ranges pict))
          (multiple-value-bind (records data) (packed-mappings decomp)
            (emit-table s "+decomp-records+" records) (emit-table s "+decomp-data+" data))
          (multiple-value-bind (records data) (packed-mappings fold)
            (emit-table s "+fold-records+" records) (emit-table s "+fold-data+" data))
          (emit-table s "+compose-pairs+" (composition-pairs decomp exclusions) 64)))))
  (format t "Tables Unicode 18.0.0: ~A~%" output))
(defun self-test ()
  (assert (= 18 (1- (length +properties+))))
  (assert (= #x10ffff (code-number "10FFFF")))
  (assert (equal '(65 223) (code-list "0041 00DF")))
  (multiple-value-bind (lo hi) (range-bounds "0041..005A") (assert (= lo 65)) (assert (= hi 90)))
  (assert (equal '(1 2 3 4 4 7) (packed-ranges #(0 3 3 0 7))))
  (multiple-value-bind (records data) (packed-mappings '((65 97) (223 115 115)))
    (assert (equal '(65 0 1 223 1 2) records)) (assert (equal '(97 115 115) data)))
  (dolist (input '("-1" "110000" "0041junk"))
    (assert (handler-case (progn (code-number input) nil) (error () t))))
  (assert (handler-case (progn (range-bounds "005A..0041") nil) (error () t)))
  (format t "(:status :ok :kind :fulltext-unicode-generator-self-test)~%"))
(defun check-tables (root expected)
  "Rigenera in un temporaneo e confronta ogni carattere, senza cambiare i sorgenti."
  (uiop:with-temporary-file (:pathname temporary :stream stream :type "lisp")
    (close stream)
    (generate-tables root temporary)
    (unless (string= (uiop:read-file-string expected :external-format :utf-8)
                     (uiop:read-file-string temporary :external-format :utf-8))
      (error "Tabelle Unicode diverse dalla rigenerazione")))
  (format t "(:status :ok :kind :fulltext-unicode-reproducibility)~%"))
(let ((args (uiop:command-line-arguments)))
  (cond ((equal args '("--self-test")) (self-test))
        ((and (= 3 (length args)) (string= "--generate" (first args)))
         (generate-tables (second args) (third args)))
        ((and (= 3 (length args)) (string= "--check" (first args)))
         (check-tables (second args) (third args)))
        (t (error "Uso: --self-test | --generate/--check directory-ucd file-lisp"))))
