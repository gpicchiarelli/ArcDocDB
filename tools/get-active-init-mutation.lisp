      ("omit-seal-bytes" "TEST-REQ-AFF-008-ACTIVE-PREFLIGHT-SEAL-BYTE-BOUNDARY"
       "(size (+ (lunghezza-lotto batch) arcdocdb.wal::+seal-total+))" "(size (lunghezza-lotto batch))" :seal-budget-omitted)
