;;;; C4: archivio nuovo da un manifesto esplicito; nessuna append o scoperta di alberi.
;;;; --collect MANIFEST NEWDEST --observations NEWDIR --jobs 4
;;;; --self-test [NEWDIR]
;;; REQ: REQ-VAL-001 REQ-AFF-012
(require :asdf)
(require :sb-posix)
(load (merge-pathnames "evidence-storage.lisp" *load-truename*))

(defpackage #:arcdocdb.command-archive.collect
  (:use #:cl)
  (:export #:collect-archive #:invalid-collection #:collection-reason #:collection-detail))
(in-package #:arcdocdb.command-archive.collect)
(declaim (optimize (safety 3) (debug 3)))

(defconstant +plain-limit+ 1048576)
(defconstant +gzip-limit+ 8388608)
(defconstant +expanded-limit+ 134217728)
(defconstant +entry-limit+ 100000)
(defconstant +depth-limit+ 128)
(defconstant +jobs+ 4)
(defconstant +join-budget+ 1800)
(defparameter *collector-source* (truename *load-truename*))
(defparameter *reserved-paths*
  '("collection-manifest.lisp" "collection-source.lisp" "archive-index.lisp" "catalogo.lisp"))

(define-condition invalid-collection (error)
  ((reason :initarg :reason :reader collection-reason)
   (detail :initarg :detail :reader collection-detail))
  (:report (lambda (condition stream)
             (format stream "Raccolta rifiutata ~S: ~A."
                     (collection-reason condition) (collection-detail condition)))))

(defun reject (reason control &rest arguments)
  (error 'invalid-collection :reason reason :detail (apply #'format nil control arguments)))

(defun demand (predicate reason control &rest arguments)
  (unless predicate (apply #'reject reason control arguments)))

(defun required (data key)
  (let* ((absent (gensym "ABSENT")) (value (getf data key absent)))
    (demand (not (eq absent value)) :data-shape "Campo ~S assente" key) value))

(defun proper-size (value)
  (let ((size (handler-case (list-length value) (type-error () nil))))
    (demand (and size (<= size +entry-limit+)) :data-shape "Lista propria entro budget richiesta") size))

(defun check-plist (data &optional fields)
  (let ((size (proper-size data)) (seen (make-hash-table :test #'eq)))
    (demand (and (plusp size) (evenp size)) :data-shape "Plist non vuota richiesta")
    (loop for key in data by #'cddr
          do (demand (keywordp key) :data-shape "Chiave non keyword")
             (demand (not (gethash key seen)) :duplicate-field "Campo ~S duplicato" key)
             (when fields (demand (member key fields) :data-shape "Campo ~S non ammesso" key))
             (setf (gethash key seen) t)))
  data)

(defun read-stream-data (stream)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
        (*read-suppress* nil) (*package* (find-package :cl-user)) (eof (gensym "EOF")))
    (handler-case
        (let ((data (read stream nil eof)))
          (demand (not (eq eof data)) :data-shape "Dati vuoti")
          (demand (eq eof (read stream nil eof)) :data-shape "Piu di una forma")
          (check-plist data))
      (invalid-collection (condition) (error condition))
      (error (condition) (reject :data-shape "Lettura DATA: ~A" condition)))))

(defun path-string (value)
  (demand (and (stringp value) (<= 1 (length value) 4096)
               (not (find-if (lambda (character)
                               (or (< (char-code character) 32) (= (char-code character) 127)
                                   (find character "\\:*?[]"))) value)))
          :relative-path "Nome di percorso non ammesso") value)

(defun relative-parts (value)
  (path-string value)
  (let ((parts (uiop:split-string value :separator "/")))
    (demand (and (<= (length parts) +depth-limit+)
                 (every (lambda (part) (and (plusp (length part))
                                            (not (member part '("." "..") :test #'string=)))) parts))
            :relative-path "Percorso relativo semplice richiesto: ~S" value) parts))

(defun path-mode (path)
  (let ((name (namestring path)))
    (sb-posix:stat-mode (sb-posix:lstat (if (> (length name) 1) (string-right-trim "/" name) name)))))

(defun exists-p (path)
  (handler-case (progn (path-mode path) t)
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:enoent (sb-posix:syscall-errno condition)) nil (error condition)))))

(defun regular-source (argument defaults)
  (path-string argument)
  (let ((path (merge-pathnames argument defaults)))
    (handler-case
        (progn
          (demand (sb-posix:s-isreg (path-mode path)) :nonregular-source "File regolare senza symlink finale: ~A" path)
          (truename path))
      (invalid-collection (condition) (error condition))
      (error (condition) (reject :nonregular-source "~A: ~A" path condition)))))

(defun future-root (argument)
  "Risolve il genitore reale anche per directory ancora assenti, senza crearle."
  (path-string argument)
  (let ((absolute (merge-pathnames (uiop:ensure-directory-pathname argument) (truename "./"))))
    (labels ((resolve-parent (path depth)
               (demand (<= depth +depth-limit+) :relative-path "Profondita output oltre budget")
               (if (exists-p path)
                   (let ((real (truename path)))
                     (demand (sb-posix:s-isdir (path-mode real)) :arguments "Genitore non directory: ~A" path)
                     (uiop:ensure-directory-pathname real))
                   (let* ((parts (pathname-directory path)) (leaf (car (last parts)))
                          (parent (make-pathname :defaults path :directory (butlast parts))))
                     (demand (and (stringp leaf) (= 1 (length (relative-parts leaf))))
                             :relative-path "Componente output non semplice")
                     (merge-pathnames (concatenate 'string leaf "/") (resolve-parent parent (1+ depth)))))))
      (let* ((parts (pathname-directory absolute)) (leaf (car (last parts)))
             (parent (make-pathname :defaults absolute :directory (butlast parts))))
        (demand (and (stringp leaf) (= 1 (length (relative-parts leaf)))) :relative-path "Root output non ammessa")
        (merge-pathnames (concatenate 'string leaf "/") (resolve-parent parent 0))))))

(defun inside-p (path root)
  (let ((name (namestring path)) (base (namestring root)))
    (and (<= (length base) (length name)) (string= base name :end2 (length base)))))

(defun fingerprint (path)
  (list :bytes (arcdocdb.evidence:file-bytes path) :sha256 (arcdocdb.evidence:file-sha256 path)))

(defun file-budget (path target)
  (let ((size (arcdocdb.evidence:file-bytes path))
        (limit (if (equal "gz" (pathname-type target)) +gzip-limit+ +plain-limit+)))
    (demand (<= size limit) :file-budget "~A: ~D byte, limite ~D" target size limit) size))

(defun plain-data (path)
  (demand (<= (arcdocdb.evidence:file-bytes path) +plain-limit+) :file-budget "Dati plain oltre 1MiB: ~A" path)
  (with-open-file (stream path :external-format :utf-8) (read-stream-data stream)))

(defun evidence-data (path compressed)
  (handler-case
      (check-plist (arcdocdb.evidence:read-evidence path :max-expanded-bytes +expanded-limit+))
    (invalid-collection (condition) (error condition))
    (error (condition) (reject (if compressed :decoded-record :data-shape) "~A: ~A" path condition))))

(defun valid-date-p (value)
  (and (stringp value) (= 10 (length value)) (char= #\- (char value 4)) (char= #\- (char value 7))
       (every (lambda (index) (digit-char-p (char value index))) '(0 1 2 3 5 6 8 9))
       (<= 1 (parse-integer value :start 5 :end 7) 12) (<= 1 (parse-integer value :start 8 :end 10) 31)))

(defun process-metadata (data label relative)
  (check-plist data)
  (demand (and (eql 1 (required data :schema-version)) (eq :command-verification (required data :kind)))
          :process-schema "Record schema1 COMMAND-VERIFICATION richiesto")
  (let ((status (required data :status)) (code (required data :exit-code))
        (consistency (required data :source-consistency)) (command (required data :command))
        (finished (getf data :finished-at-universal-time :absent)))
    (demand (and (member status '(:ok :failed :source-changed))
                 (typep finished '(integer 0 *))) :incomplete-process "Record non concluso: ~A" relative)
    (demand (and (plusp (proper-size command)) (every #'stringp command)
                 (or (keywordp consistency) (null consistency))
                 (if (eq status :failed) (or (integerp code) (null code)) (integerp code)))
            :process-metadata "Campi command/status/exit/source-consistency non validi")
    (when (eq status :ok)
      (demand (and (eql 0 code) (eq :stable consistency)) :process-metadata "OK richiede exit0/STABLE"))
    (when (eq status :source-changed)
      (demand (eq :changed consistency) :process-metadata "SOURCE-CHANGED richiede CHANGED"))
    (let ((started (getf data :started-at-universal-time :absent)))
      (unless (eq :absent started)
        (demand (and (typep started '(integer 0 *)) (<= started finished)) :incomplete-process "Timestamp non ordinati")))
    (list :label label :record-path relative :command command :status status :exit-code code :source-consistency consistency)))

(defun rendered (data)
  (let ((*print-readably* t) (*print-pretty* t) (*print-right-margin* 80) (*print-circle* nil))
    (sb-ext:string-to-octets (with-output-to-string (stream) (write data :stream stream :pretty t) (terpri stream))
                             :external-format :utf-8)))

(defun index-datum (files processes)
  (list :schema-version 1 :kind :original-command-archive :metadata-policy :read-without-result-inference
        :processes processes :files (sort (copy-list files) #'string< :key (lambda (entry) (getf entry :path)))
        :limits '(:explicit-file-manifest :sha256-byte-copy-check :raw-originals-preserved
                  :no-result-or-gate-inference :no-requirement-or-release-promotion)))

(defun catalogue-datum (root date)
  (list :schema-version 1 :kind :evidence-catalog :date date :path-base (namestring root) :formats nil
        :entries (list (list :kind :original-command-archive :artifact "archive-index.lisp"
                            :artifact-schema-version 1 :artifact-kind :original-command-archive)) :pending nil))

(defun check-descriptor-tasks (tasks files)
  "Autentica ogni descriptor, anche accessorio, e richiede il payload esplicito nel piano."
  (dolist (task tasks)
    (let ((source (getf task :source)) (relative (getf task :path)))
      (handler-case
          (arcdocdb.evidence:call-with-evidence-bytes
           source
           (lambda (plain)
             (unless (equal plain source)
               (let* ((raw (plain-data source)) (slash (position #\/ relative :from-end t))
                      (payload-relative (concatenate 'string (if slash (subseq relative 0 (1+ slash)) "")
                                                     (required raw :payload)))
                      (payload (gethash payload-relative files)))
                 (demand (and (eq :compressed-evidence (getf raw :kind)) payload
                              (= (required raw :compressed-bytes) (getf (getf payload :before) :bytes))
                              (string-equal (required raw :compressed-sha256) (getf (getf payload :before) :sha256)))
                         :decoded-record "Payload autenticato non selezionato al path ~A" payload-relative))))
           :max-expanded-bytes +expanded-limit+)
        (error (condition) (reject :decoded-record "~A: ~A" source condition))))))

(defun plan-collection (manifest-path root)
  "Solo le entry esplicite e due copie del contratto/strumento, senza enumerare directory."
  (let* ((source (regular-source manifest-path (truename "./")))
         (base (uiop:pathname-directory-pathname source)) (manifest (plain-data source))
         (tasks nil) (processes nil) (files (make-hash-table :test #'equal))
         (directories (make-hash-table :test #'equal)) (labels (make-hash-table :test #'equal))
         (records (make-hash-table :test #'equal)))
    (check-plist manifest '(:schema-version :kind :date :files :processes))
    (demand (and (eql 1 (required manifest :schema-version))
                 (eq :command-archive-manifest (required manifest :kind)) (valid-date-p (required manifest :date)))
            :manifest-schema "Manifesto schema1, kind e data YYYY-MM-DD richiesti")
    (demand (and (plusp (proper-size (required manifest :files)))
                 (plusp (proper-size (required manifest :processes)))) :manifest-schema "File e processi non vuoti richiesti")
    (labels ((add-file (argument relative automatic)
               (let ((parts (relative-parts relative)))
                 (unless automatic
                   (demand (not (member (first parts) *reserved-paths* :test #'string-equal))
                           :reserved-target "Path riservato: ~A" relative))
                 (demand (not (gethash relative files)) :duplicate-target "~A" relative)
                 (demand (not (gethash relative directories)) :path-collision "File al posto di directory: ~A" relative)
                 (loop for rest on parts while (rest rest)
                       for prefix = (format nil "~{~A~^/~}" (subseq parts 0 (- (length parts) (length (rest rest)))))
                       do (demand (not (gethash prefix files)) :path-collision "Directory al posto di file: ~A" prefix)
                          (setf (gethash prefix directories) t))
                 (demand (< (hash-table-count files) +entry-limit+) :entry-limit "Troppi file")
                 (let* ((path (regular-source argument base)) (bytes (file-budget path relative))
                        (before (fingerprint path)) (task (list :source path :path relative :before before)))
                   (demand (= bytes (getf before :bytes)) :source-changed "~A" path)
                   (setf (gethash relative files) task) (push task tasks)))))
      (dolist (entry (required manifest :files))
        (check-plist entry '(:source :path)) (add-file (required entry :source) (required entry :path) nil))
      (add-file (namestring source) "collection-manifest.lisp" t)
      (add-file (namestring *collector-source*) "collection-source.lisp" t))
    (demand (<= (+ 2 (hash-table-count files) (hash-table-count directories)) +entry-limit+)
            :entry-limit "Inventario file/directory oltre budget")
    (check-descriptor-tasks tasks files)
    (dolist (entry (required manifest :processes))
      (check-plist entry '(:label :record-path))
      (let* ((label (required entry :label)) (relative (required entry :record-path))
             (parts (handler-case (relative-parts label)
                      (invalid-collection () (reject :process-label "Label semplice richiesta")))))
        (demand (and (= 1 (length parts)) (not (gethash label labels))) :process-label "Label semplice unica richiesta")
        (setf (gethash label labels) t)
        (relative-parts relative)
        (demand (not (gethash relative records)) :process-record "Record duplicato: ~A" relative)
        (setf (gethash relative records) t)
        (let ((task (gethash relative files)))
          (demand task :process-record "Record non presente nei file: ~A" relative)
          (let* ((path (getf task :source)) (raw (plain-data path))
                 (compressed (eq :compressed-evidence (getf raw :kind)))
                 (data (evidence-data path compressed)) (metadata (process-metadata data label relative)))
            (push (list :source path :finished-at-universal-time (getf data :finished-at-universal-time)
                        :metadata metadata) processes)))))
    (setf tasks (nreverse tasks) processes (nreverse processes))
    (let* ((entries (mapcar (lambda (task) (append (list :path (getf task :path) :source (namestring (getf task :source)))
                                                 (getf task :before))) tasks))
           (index (rendered (index-datum entries (mapcar (lambda (process) (getf process :metadata)) processes))))
           (catalogue (rendered (catalogue-datum root (getf manifest :date)))))
      (demand (and (<= (length index) +plain-limit+) (<= (length catalogue) +plain-limit+))
              :index-budget "Indice/catalogo oltre 1MiB"))
    (values (coerce tasks 'vector) processes (getf manifest :date))))

(defun save-octets-new (path octets)
  (with-open-file (stream path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
    (write-sequence octets stream)))

(defun save-data-new (path data)
  (save-octets-new path (rendered data)))

(defun create-root (root reason)
  (demand (not (exists-p root)) reason "~A" root)
  (ensure-directories-exist (merge-pathnames "placeholder" (uiop:pathname-parent-directory-pathname root)))
  (handler-case (sb-posix:mkdir (namestring root) #o700)
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:eexist (sb-posix:syscall-errno condition)) (reject reason "~A" root) (error condition)))))

(defun copy-bytes-new (source target buffer expected-bytes)
  (let ((fd (sb-posix:open (namestring source) (logior sb-posix:o-rdonly sb-posix:o-nofollow sb-posix:o-nonblock))))
    (unwind-protect
         (progn
           (demand (sb-posix:s-isreg (sb-posix:stat-mode (sb-posix:fstat fd))) :nonregular-source "~A" source)
           (let ((input (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8) :auto-close t)))
             (setf fd nil)
             (with-open-stream (stream input)
               (with-open-file (output target :direction :output :if-exists :error :element-type '(unsigned-byte 8))
                 (let ((remaining expected-bytes))
                   (loop while (plusp remaining)
                         do (let ((count (read-sequence buffer stream :end (min remaining (length buffer)))))
                              (demand (plusp count) :source-changed "Fonte accorciata: ~A" source)
                              (write-sequence buffer output :end count) (decf remaining count))))
                 (let ((eof (gensym "EOF")))
                   (demand (eq eof (read-byte stream nil eof)) :source-changed "Fonte cresciuta: ~A" source))))))
      (when fd (sb-posix:close fd)))))

(defun copy-verified (task root after-copy buffer)
  (let* ((source (getf task :source)) (relative (getf task :path))
         (target (merge-pathnames relative root)) (before (fingerprint source)))
    (demand (equal before (getf task :before)) :source-changed "Fonte cambiata dal piano: ~A" source)
    (copy-bytes-new source target buffer (getf before :bytes))
    (when after-copy (funcall after-copy target))
    (let ((after-source (fingerprint source)) (after-target (fingerprint target)))
      (demand (equal before after-source) :source-changed "~A" source)
      (demand (equal before after-target) :copied-bytes "~A" target)
      (append (list :path relative :source (namestring source)) before))))

(defun remaining-seconds (deadline)
  (max 0d0 (/ (- deadline (get-internal-real-time)) (float internal-time-units-per-second 1d0))))

(defun copy-plan (tasks root after-copy)
  "Quattro thread, primo task privato se disponibile, coda mutex e join entro deadline."
  (let* ((count (length tasks)) (cursor (min +jobs+ count))
         (mutex (sb-thread:make-mutex :name "command-archive-queue"))
         (ready (sb-thread:make-semaphore :count 0)) (go (sb-thread:make-semaphore :count 0))
         (results (make-array count :initial-element nil)) (statistics (make-array +jobs+ :initial-element 0))
         (errors (make-array +jobs+ :initial-element nil)) (threads nil) (joined nil) (failure nil) (cleanup-errors nil)
         (defaults *default-pathname-defaults*)
         (deadline (+ (get-internal-real-time) (* +join-budget+ internal-time-units-per-second))))
    (labels ((take () (sb-thread:with-mutex (mutex) (when (< cursor count) (prog1 cursor (incf cursor)))))
             (perform (index worker buffer)
               (setf (aref results index)
                     (handler-case (list :status :ok :entry (copy-verified (aref tasks index) root after-copy buffer))
                       (invalid-collection (condition)
                         (list :status :failed :reason (collection-reason condition) :detail (collection-detail condition)))
                       (error (condition) (list :status :failed :reason :copy-error :detail (princ-to-string condition)))))
               (incf (aref statistics worker)))
             (work (worker)
               (let ((*default-pathname-defaults* defaults)
                     (buffer (make-array 65536 :element-type '(unsigned-byte 8))))
                 (handler-case
                     (progn
                       (sb-thread:signal-semaphore ready)
                       (demand (sb-thread:wait-on-semaphore go :timeout (remaining-seconds deadline))
                               :worker-timeout "GO worker ~D" worker)
                       (when (< worker count) (perform worker worker buffer))
                       (loop for index = (take) while index do (perform index worker buffer)))
                   (error (condition) (setf (aref errors worker) (princ-to-string condition)))))))
      (unwind-protect
           (handler-case
               (progn
                 (dotimes (worker +jobs+)
                   (let ((id worker)) (push (sb-thread:make-thread (lambda () (work id))
                                                :name (format nil "command-archive-~D" id)) threads)))
                 (setf threads (nreverse threads))
                 (dotimes (worker +jobs+)
                   (demand (sb-thread:wait-on-semaphore ready :timeout (remaining-seconds deadline))
                           :worker-timeout "READY worker ~D" worker))
                 (dotimes (worker +jobs+) (sb-thread:signal-semaphore go))
                 (dolist (thread threads)
                   (let ((marker (gensym "TIMEOUT")))
                     (demand (not (eq marker (sb-thread:join-thread thread :timeout (remaining-seconds deadline) :default marker)))
                             :worker-timeout "JOIN worker")))
                 (setf joined t))
             (error (condition) (setf failure condition)))
        (unless joined
          (dotimes (worker +jobs+) (sb-thread:signal-semaphore go))
          (dolist (thread threads)
            (handler-case
                (progn
                  (when (sb-thread:thread-alive-p thread) (sb-thread:terminate-thread thread))
                  (let ((marker (gensym "CLEANUP-TIMEOUT")))
                    (when (eq marker (sb-thread:join-thread thread :timeout 5 :default marker))
                      (push "JOIN cleanup timeout" cleanup-errors))))
              (error (condition) (push (princ-to-string condition) cleanup-errors)))))))
    (values results statistics errors failure (nreverse cleanup-errors))))

(defun verify-processes (processes root)
  (dolist (process processes)
    (let* ((relative (getf (getf process :metadata) :record-path)) (path (merge-pathnames relative root))
           (raw (plain-data path)) (copy (evidence-data path (eq :compressed-evidence (getf raw :kind))))
           (metadata (process-metadata copy (getf (getf process :metadata) :label) relative)))
      (demand (and (equal (getf process :metadata) metadata)
                   (eql (getf process :finished-at-universal-time) (getf copy :finished-at-universal-time)))
              :decoded-record "Metadati copiati diversi: ~A" relative))))

(defun verify-evidence-copies (tasks root)
  (loop for task across tasks for path = (merge-pathnames (getf task :path) root)
        do (handler-case
               (arcdocdb.evidence:call-with-evidence-bytes
                path (lambda (plain) (declare (ignore plain)) t) :max-expanded-bytes +expanded-limit+)
             (error (condition) (reject :decoded-record "Copia ~A: ~A" path condition)))))

(defun strict-closure (root observations processes)
  (let* ((log (merge-pathnames "closed-check.log" observations))
         (checker (merge-pathnames "check-command-archive.lisp" *collector-source*))
         (process (uiop:launch-program
                   (list "sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--script"
                         (namestring checker) "--archive" (namestring root))
                   :output log :error-output :output)))
    (multiple-value-bind (exit signal) (uiop:wait-process process)
      (demand (and (eql 0 exit) (null signal)) :closed-check "Exit ~S signal ~S, log ~A" exit signal log)
      (let ((result (handler-case (plain-data log)
                      (error (condition) (reject :closed-check "Output checker non DATA: ~A" condition)))))
        (demand (and (eql 1 (getf result :schema-version)) (eq :command-archive-audit (getf result :kind))
                     (eq :ok (getf result :status)) (eq t (getf result :closed-inventory))
                     (equal processes (getf result :processes)))
                :closed-check "Metadata/inventario checker non concordanti")
        (list :exit-code exit :signal signal :log (namestring log) :result result)))))

(defun api-pathname-string (value)
  "Normalizza soltanto i tre argomenti esterni dell'API; i campi del manifesto restano stringhe."
  (typecase value
    (string value)
    (pathname (namestring value))
    (t (reject :arguments "Argomento API stringa o pathname richiesto"))))

(defun collect-archive (manifest destination observations &key after-copy)
  "Copia in una root nuova, osservazioni esterne; l'hook interno riceve il solo target.
Nessuna append, cancellazione, modifica di originali o inferenza dei risultati."
  (demand (or (null after-copy) (functionp after-copy)) :arguments "Hook non funzione")
  (let* ((manifest (api-pathname-string manifest))
         (destination (api-pathname-string destination))
         (observations (api-pathname-string observations))
         (root (future-root destination)) (observation-root (future-root observations))
         (report-path (merge-pathnames "report.lisp" observation-root))
         (report (list :schema-version 1 :kind :command-archive-collection :status :running :phase :planning
                       :destination (namestring root) :observations (namestring observation-root)
                       :workers +jobs+ :sha-per-copy 3
                       :limits '(:explicit-file-manifest :completed-command-records-only :fresh-destination-only
                                 :no-auto-sidecars-or-trees :local-per-file-observations :no-atomicity-or-authentication
                                 :no-result-or-gate-inference :no-mcdc-or-release-qualification))))
    (demand (not (or (inside-p root observation-root) (inside-p observation-root root)))
            :path-overlap "Archivio e osservazioni devono essere esterni fra loro")
    (create-root observation-root :existing-observations)
    (handler-case
        (progn
          (demand (not (exists-p root)) :existing-destination "~A" root)
          (multiple-value-bind (tasks processes date) (plan-collection manifest root)
            (setf (getf report :planned-files) (length tasks)
                  (getf report :processes) (mapcar (lambda (process) (getf process :metadata)) processes)
                  (getf report :phase) :create-directories)
            (create-root root :existing-destination)
            (loop for task across tasks do (ensure-directories-exist (merge-pathnames (getf task :path) root)))
            (setf (getf report :phase) :copy)
            (multiple-value-bind (results statistics errors failure cleanup-errors) (copy-plan tasks root after-copy)
              (setf (getf report :copy-results) (coerce results 'list)
                    (getf report :worker-copied-counts) (coerce statistics 'list)
                    (getf report :worker-errors) (coerce errors 'list)
                    (getf report :cleanup-errors) cleanup-errors (getf report :phase) :joined)
              (demand (null cleanup-errors) :worker-error "Cleanup: ~S" cleanup-errors)
              (when failure
                (if (typep failure 'invalid-collection) (error failure) (reject :worker-error "~A" failure)))
              (demand (every #'null errors) :worker-error "~S" (coerce errors 'list))
              (demand (every #'identity results) :worker-error "Risultati di copia mancanti")
              (let ((failed (find :failed results :key (lambda (result) (getf result :status)))))
                (when failed (reject (getf failed :reason) "~A" (getf failed :detail))))
              (verify-evidence-copies tasks root)
              (verify-processes processes root)
              (let* ((files (map 'list (lambda (result) (getf result :entry)) results))
                     (index (rendered (index-datum files (getf report :processes))))
                     (catalogue (rendered (catalogue-datum root date))))
                (demand (and (<= (length index) +plain-limit+) (<= (length catalogue) +plain-limit+))
                        :index-budget "Indice/catalogo oltre 1MiB")
                (save-octets-new (merge-pathnames "archive-index.lisp" root) index)
                (save-octets-new (merge-pathnames "catalogo.lisp" root) catalogue)))
            (setf (getf report :phase) :published
                  (getf report :independent-closure) (strict-closure root observation-root (getf report :processes))
                  (getf report :phase) :complete (getf report :status) :ok))
          (save-data-new report-path report)
          (values report (namestring report-path)))
      (error (condition)
        (setf (getf report :status) :failed
              (getf report :reason) (if (typep condition 'invalid-collection) (collection-reason condition) :infrastructure)
              (getf report :diagnostic) (princ-to-string condition))
        (save-data-new report-path report)
        (error condition)))))

(defun main ()
  (let ((arguments (uiop:command-line-arguments)))
    (handler-case
        (progn
          (write
           (cond ((and (= 7 (length arguments)) (string= "--collect" (first arguments))
                       (string= "--observations" (fourth arguments))
                       (string= "--jobs" (sixth arguments)) (string= "4" (seventh arguments)))
                  (collect-archive (second arguments) (third arguments) (fifth arguments)))
                 ((and (<= 1 (length arguments) 2) (string= "--self-test" (first arguments)))
                  (load (merge-pathnames "collect-command-archive-tests.lisp" *collector-source*))
                  (if (second arguments) (funcall (symbol-function 'self-test) (second arguments))
                      (funcall (symbol-function 'self-test))))
                 (t (reject :arguments "Usare --collect MANIFEST NEWDEST --observations NEWDIR --jobs 4 o --self-test [NEWDIR]")))
           :pretty t)
          (terpri) (sb-ext:exit :code 0))
      (error (condition)
        (write (list :schema-version 1 :kind :command-archive-collection :status :failed
                     :reason (if (typep condition 'invalid-collection) (collection-reason condition) :infrastructure)
                     :diagnostic (princ-to-string condition)) :pretty t)
        (terpri) (sb-ext:exit :code 1)))))

(unless (member :arcdocdb-command-archive-library *features*) (main))
