;;;; C4: pipeline nativa ACTIVE -> piano CONTROL -> prepara -> pubblica + fsync.
;;;; --self-test: classificatori e dati propri, stdout soltanto; niente prodotto/figli/I/O.
;;;; --bench spikes/out/control-checkpoint-bench-X/: namespace letterale nuovo.
;;;; 2 versioni * (1,2,4) worker * 5 repliche = 30 finestre, 560 pubblicazioni.
;;;; Otto casi nuovi per worker e finestra; nessun gettone di pubblicazione riusato.
;;;; Setup, ACTIVE, piano, byte fixture, GC e oracoli finali fuori clock.
;;;; Nel clock: prepara-checkpoint-control, pubblica-control-recuperato e coordinamento.
;;;; Heap dell'intero processo, senza criterio zero heap o throughput DB.
;;;; Deadline cooperative 60s/finestra e 600s/campagna; supervisor esterno necessario.
;;;; Nessun test-op, patch SYMBOL-FUNCTION, retry, rollback o terminate-thread.
;;; REQ: REQ-REC-001 REQ-FOR-001 REQ-FOR-003 REQ-AFF-001 REQ-AFF-008 REQ-VAL-001
;;; OWNER: main possiede namespace, fixture e report; worker i possiede casi e raw i.
;;; SHARED: API/deadline immutabili nella finestra; gate di avvio e stop del main.
;;; Le capacità tornano al main solo dopo quiescenza dell'intero gruppo.
(require :sb-posix)
(defpackage #:arcdocdb.control-checkpoint.c4 (:use #:cl))
(in-package #:arcdocdb.control-checkpoint.c4)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defconstant +count+ 8)
(defconstant +replicas+ 5)
(defconstant +window-seconds+ 60)
(defconstant +campaign-seconds+ 600)
(defconstant +max-report+ 8388608)
(deftype octets () '(simple-array (unsigned-byte 8) (*)))

(define-condition bench-failure (error)
  ((reason :initarg :reason :reader failure-reason)
   (detail :initarg :detail :reader failure-detail))
  (:report (lambda (condition stream)
             (format stream "tools/control-checkpoint-bench.lisp COD-61 ~S: ~A"
                     (failure-reason condition) (failure-detail condition)))))
(define-condition bench-deadline (bench-failure) ())
(defun reject (reason &optional (detail "osservazione rifiutata"))
  (error 'bench-failure :reason reason :detail detail))
(defun expire (reason)
  (error 'bench-deadline :reason reason :detail "deadline cooperativa raggiunta"))
(defun diagnostic (condition)
  (let ((text (format nil "tools/control-checkpoint-bench.lisp COD-61: ~A" condition)))
    (subseq text 0 (min 2048 (length text)))))
(defun remaining (deadline)
  (/ (max 0 (- deadline (get-internal-real-time)))
     (float internal-time-units-per-second 1d0)))
(defun require-time (deadline)
  (unless (plusp (remaining deadline)) (expire :deadline)))
(defun failure-status (previous condition)
  "Un timeout tardivo non cancella un errore già osservato."
  (if (or (eq previous :failed) (not (typep condition 'bench-deadline))) :failed :incomplete))

(defstruct (api (:copier nil))
  (prepare #'identity :type function :read-only t)
  (publish #'identity :type function :read-only t)
  (functions nil :type list :read-only t))
(defstruct (fixture (:copier nil))
  (path #p"./" :type pathname :read-only t)
  (identity (make-array 16 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (version 2 :type (member 1 2) :read-only t)
  ;; 0 parent; 1/2 new ACTIVE append/input; 3/4 CONTROL append/input;
  ;; 5/6 previous CONTROL append/input; 7/8 previous ACTIVE append/input.
  (handles (make-array 9 :initial-element nil) :type simple-vector :read-only t)
  (header (make-array 64 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (old-header (make-array 64 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (scratch (make-array 4096 :element-type '(unsigned-byte 8)) :type octets :read-only t)
  (old-bytes (make-array 0 :element-type '(unsigned-byte 8)) :type octets)
  (expected (make-array 0 :element-type '(unsigned-byte 8)) :type octets)
  (active nil :type t) (plan nil :type t) (prepared nil :type t) (published nil :type t)
  (baseline nil :type list))
(defstruct (raw (:copier nil))
  (attempted 0 :type fixnum) (prepared 0 :type fixnum) (count 0 :type fixnum)
  (terminated nil :type boolean) (failure nil :type (or null condition)))
(defstruct (group (:copier nil))
  (threads #() :type simple-vector :read-only t)
  (raws #() :type simple-vector :read-only t)
  (deadline 0 :type integer) (stop 0 :type bit)
  (ready (sb-thread:make-semaphore :count 0) :type sb-thread:semaphore :read-only t)
  (gate (sb-thread:make-semaphore :count 0) :type sb-thread:semaphore :read-only t))
(defstruct (run (:copier nil))
  (root #p"./" :type pathname :read-only t)
  (deadline 0 :type integer :read-only t)
  (directory nil :type (or null pathname))
  (api nil :type (or null api)) (active nil :type (or null group))
  (fixtures nil :type list) (warnings nil :type list)
  (source-paths nil :type list))

(defun function-in (package name &key internal)
  "Cold: trova definizioni locali già caricate, senza INTERN o sostituzioni globali."
  (let ((pkg (find-package package)))
    (unless pkg (reject :missing-api package))
    (multiple-value-bind (symbol visibility) (find-symbol name pkg)
      (unless (and symbol (fboundp symbol) (or internal (eq visibility :external)))
        (reject :missing-api (format nil "~A:~A" package name)))
      (symbol-function symbol))))
(defun call-api (api key &rest args)
  "Cold: dispatch dei soli helper di fixture/oracoli; il clock usa due function slot."
  (let ((function (cdr (assoc key (api-functions api)))))
    (unless function (reject :missing-api (symbol-name key)))
    (apply function args)))
(defun product-api ()
  (make-api
   :prepare (function-in "ARCDOCDB.CONTROL" "PREPARA-CHECKPOINT-CONTROL")
   :publish (function-in "ARCDOCDB.CONTROL" "PUBBLICA-CONTROL-RECUPERATO")
   :functions
   (loop for (key package name internal) in
     '((:directory "ARCDOCDB.IO" "APRI-DIRECTORY")
       (:create "ARCDOCDB.IO" "CREA-TEMPORANEO") (:reader "ARCDOCDB.IO" "APRI-LETTURA")
       (:append "ARCDOCDB.IO" "APPEND-ESATTO") (:read "ARCDOCDB.IO" "LEGGI-ESATTO")
       (:flush "ARCDOCDB.IO" "DURABLE-FLUSH") (:rename "ARCDOCDB.IO" "RINOMINA-NELLA-DIRECTORY")
       (:close "ARCDOCDB.IO" "CHIUDI") (:fd "ARCDOCDB.IO" "FILE-FD" t)
       (:state "ARCDOCDB.IO" "STATO-FILE") (:mode "ARCDOCDB.IO" "MODE-FILE")
       (:written "ARCDOCDB.IO" "POSIZIONE-SCRITTA") (:durable "ARCDOCDB.IO" "POSIZIONE-DUREVOLE")
       (:csns "ARCDOCDB.CSN" "CREA-REGISTRO-CSN")
       (:snapshots "ARCDOCDB.MVCC" "CREA-REGISTRO-SNAPSHOT")
       (:epochs "ARCDOCDB.EPOCHS" "CREA-REGISTRO-EPOCHE")
       (:scope "ARCDOCDB.GET" "CREA-AMBITO-GET") (:view "ARCDOCDB.GET" "CREA-VISTA-GET-SERIE")
       (:primary "ARCDOCDB.INDEX.PRIMARY" "CREA-INDICE-PRIMARIO")
       (:active "ARCDOCDB.ACTIVE" "PREPARA-SEGMENTO-ATTIVO")
       (:edit "ARCDOCDB.STORAGE.FORMAT" "SCRIVI-VALORE-EDIT")
       (:u64 "ARCDOCDB.BINARY" "SCRIVI-U64") (:u32 "ARCDOCDB.BINARY" "SCRIVI-U32")
       (:plan "ARCDOCDB.CONTROL" "CREA-CHECKPOINT-CONTROL")
       (:plan-bytes "ARCDOCDB.CONTROL" "CHECKPOINT-CONTROL-BYTES" t)
       (:publication-state "ARCDOCDB.CONTROL" "STATO-PUBBLICAZIONE-CONTROL")
       (:published-active "ARCDOCDB.CONTROL" "ACTIVE-CONTROL-PUBBLICATO")
       (:published-log "ARCDOCDB.CONTROL" "LOG-CONTROL-PUBBLICATO")
       (:log-file "ARCDOCDB.WAL" "LOG-IO-FILE" t) (:log-state "ARCDOCDB.WAL" "STATO-LOG")
       (:log-header "ARCDOCDB.STORAGE.FORMAT" "VERIFICA-HEADER-LOG")
       (:segment-header "ARCDOCDB.STORAGE.FORMAT" "VERIFICA-HEADER-SEGMENTO")
       (:recover "ARCDOCDB.RECOVERY.MANIFEST" "RICOSTRUISCI-MANIFEST")
       (:manifest-active "ARCDOCDB.RECOVERY.MANIFEST" "SEGMENTO-ATTIVO")
       (:manifest-next "ARCDOCDB.RECOVERY.MANIFEST" "PROSSIMO-ID-SEGMENTO")
       (:closed "ARCDOCDB.RECOVERY.MANIFEST" "NUMERO-SEGMENTI-CHIUSI")
       (:removed "ARCDOCDB.RECOVERY.MANIFEST" "NUMERO-SEGMENTI-RIMOSSI")
       (:segment "ARCDOCDB.RECOVERY.MANIFEST" "TROVA-SEGMENTO"))
     collect (cons key (function-in package name :internal internal)))))

(defun with-load-policy (run function)
  "Confine load C4: unica eccezione registrata è SB-KERNEL:REDEFINITION-WARNING."
  (handler-bind ((warning
                  (lambda (condition)
                    (if (typep condition 'sb-kernel:redefinition-warning)
                        (let ((message (diagnostic condition)))
                          (push message (run-warnings run))
                          (format *error-output* "~&ASDF-REDEFINITION ~A~%" message)
                          (muffle-warning condition))
                        (reject :load-warning (diagnostic condition))))))
    (funcall function)))
(defun asdf-policy-symbol (name)
  (let ((symbol (find-symbol name "ASDF")))
    (unless (and symbol (boundp symbol)) (reject :asdf-policy name))
    symbol))
(defun load-product (run)
  "Cold: cache FASL privata e ASDF force sui sorgenti, senza sistema di test."
  (let ((*standard-output* *error-output*) (*trace-output* *error-output*)
        (*compile-print* nil) (*compile-verbose* nil) (*load-print* nil) (*load-verbose* nil))
    (with-load-policy run (lambda () (require :asdf)))
    (let ((cache (merge-pathnames "fasl/" (run-directory run))))
      (ensure-directories-exist (merge-pathnames "placeholder" cache))
      (with-load-policy
       run
       (lambda ()
         (progv (list (asdf-policy-symbol "*COMPILE-FILE-WARNINGS-BEHAVIOUR*")
                      (asdf-policy-symbol "*COMPILE-FILE-FAILURE-BEHAVIOUR*")) '(:error :error)
           (funcall (function-in "ASDF" "INITIALIZE-OUTPUT-TRANSLATIONS")
                    (list :output-translations (list t (namestring cache)) :ignore-inherited-configuration))
           (funcall (function-in "ASDF" "LOAD-ASD") (merge-pathnames "arcdocdb.asd" (run-root run)))
           (require-time (run-deadline run))
           (funcall (function-in "ASDF" "LOAD-SYSTEM") "arcdocdb" :force t :verbose nil)))))
    (setf (run-api run) (product-api))))

(defun namespace-path (root requested)
  "Accetta solo il prefisso letterale; nessuna normalizzazione di input equivalenti."
  (let ((prefix "spikes/out/control-checkpoint-bench-"))
    (unless (and (stringp requested) (> (length requested) (1+ (length prefix)))
                 (string= requested prefix :end1 (length prefix))
                 (char= #\/ (char requested (1- (length requested)))))
      (reject :namespace "uso: --bench spikes/out/control-checkpoint-bench-X/"))
    (let ((suffix (subseq requested (length prefix) (1- (length requested)))))
      (unless (and (<= 1 (length suffix) 64)
                   (every (lambda (c) (or (find c "-_" :test #'char=)
                                          (char<= #\0 c #\9) (char<= #\a c #\z)
                                          (char<= #\A c #\Z))) suffix))
        (reject :namespace "X: 1..64 caratteri ASCII alfanumerici, - o _")))
    (merge-pathnames requested root)))
(defun lstat-or-absent (path)
  (handler-case (sb-posix:lstat (string-right-trim "/" (namestring path)))
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:enoent (sb-posix:syscall-errno condition)) nil (error condition)))))
(defun stat-identity (stat)
  (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat)))
(defun check-ancestors (path &key create)
  "LSTAT di ogni componente dalla radice; symlink/dot-path rifiutati prima di mkdir."
  (let ((parts (pathname-directory path)) (seen (list :absolute)))
    (unless (eq :absolute (first parts)) (reject :physical-namespace))
    (dolist (part (rest parts))
      (unless (and (stringp part) (not (member part '("." "..") :test #'equal)))
        (reject :physical-namespace))
      (setf seen (append seen (list part)))
      (let* ((prefix (make-pathname :directory seen)) (stat (lstat-or-absent prefix)))
        (when (and (null stat) create)
          (sb-posix:mkdir (namestring prefix) #o700)
          (setf stat (lstat-or-absent prefix)))
        (unless (and stat (sb-posix:s-isdir (sb-posix:stat-mode stat)))
          (reject :physical-namespace (namestring prefix)))))
    t))
(defun private-directory (path)
  (sb-posix:mkdir (namestring path) #o700)
  (let ((stat (lstat-or-absent path)))
    (unless (and stat (sb-posix:s-isdir (sb-posix:stat-mode stat))
                 (= #o700 (logand #o777 (sb-posix:stat-mode stat))))
      (reject :directory-mode (namestring path))))
  path)
(defun acquire-namespace (run requested)
  (let ((path (namespace-path (run-root run) requested)))
    (check-ancestors (run-root run))
    (check-ancestors (merge-pathnames "spikes/out/" (run-root run)) :create t)
    (require-time (run-deadline run))
    (private-directory path)
    (setf (run-directory run) path)
    (check-ancestors path)))
(defun checked-stat (path size)
  (let ((stat (lstat-or-absent path)))
    (unless (and stat (sb-posix:s-isreg (sb-posix:stat-mode stat))
                 (= 1 (sb-posix:stat-nlink stat)) (= size (sb-posix:stat-size stat)))
      (reject :file-shape (namestring path)))
    stat))
(defun distinct-identities (identities)
  (unless (= (length identities) (length (remove-duplicates identities :test #'equal)))
    (reject :inode-alias))
  t)
(defun private-root-record (path)
  (let ((stat (lstat-or-absent path)))
    (unless (and stat (sb-posix:s-isdir (sb-posix:stat-mode stat))
                 (= #o700 (logand #o777 (sb-posix:stat-mode stat))))
      (reject :worker-root (namestring path)))
    (list :path (namestring path) :identity (stat-identity stat) :mode #o700)))
(defun read-path (path expected)
  "Cold: EOF esatto, LSTAT prima/dopo e byte uguali agli input della fixture."
  (let* ((before (checked-stat path (length expected)))
         (bytes (make-array (length expected) :element-type '(unsigned-byte 8))))
    (with-open-file (stream path :element-type '(unsigned-byte 8))
      (unless (and (= (file-length stream) (length bytes))
                   (= (read-sequence bytes stream) (length bytes))
                   (eq :eof (read-byte stream nil :eof))) (reject :readback-eof)))
    (unless (and (equalp bytes expected)
                 (equal (stat-identity before) (stat-identity (checked-stat path (length bytes)))))
      (reject :readback-bytes (namestring path)))
    bytes))
(defun write-bytes (path bytes)
  "Cold: evidence esclusiva di input canonico, mai caricata come programma."
  (with-open-file (stream path :direction :output :element-type '(unsigned-byte 8)
                               :if-exists :error :if-does-not-exist :create)
    (write-sequence bytes stream))
  (read-path path bytes)
  path)

(defun view-for (api identity)
  "Serie indipendente: registri, indice e vista costruiti tramite factory reali."
  (let* ((csns (call-api api :csns :capacity 4))
         (snapshots (call-api api :snapshots csns 4 20 5))
         (epochs (call-api api :epochs 1 4))
         (scope (call-api api :scope epochs snapshots))
         (primary (call-api api :primary :capacity 16 :arena-bytes 64 :max-depth 1
                            :directory-budget-bytes 4096 :fragment-budget-bytes 4096)))
    (call-api api :view scope primary nil identity)))
(defun edit-payload (api new-p)
  "Il recovery chiude il vecchio ACTIVE header-only: CLOSED 1/64, senza esiti o rimozioni."
  (let ((bytes (make-array (if new-p 44 24) :element-type '(unsigned-byte 8) :initial-element 0))
        (closed (make-array (if new-p 20 0) :element-type '(unsigned-byte 8) :initial-element 0))
        (removed (make-array 0 :element-type '(unsigned-byte 8))))
    (when new-p
      (call-api api :u64 closed 0 1)
      (call-api api :u64 closed 8 64)
      (call-api api :u32 closed 16 0))
    (unless (= (length bytes) (call-api api :edit bytes 0 (if new-p 3 2) (if new-p 2 1)
                                       closed (if new-p 1 0) removed :completo t
                                       :max-chiusi 1 :max-rimossi 0 :max-esiti 0)) (reject :edit-length))
    bytes))
(defun open-slot (api fixture slot key leaf)
  (let ((file (call-api api key (merge-pathnames leaf (fixture-path fixture)))))
    (setf (svref (fixture-handles fixture) slot) file)
    file))
(defun prepare-active (api fixture view old-p)
  (let* ((writer-slot (if old-p 7 1)) (input-slot (if old-p 8 2))
         (leaf (if old-p "previous-active.tmp" "active.tmp"))
         (header (if old-p (fixture-old-header fixture) (fixture-header fixture)))
         (writer (open-slot api fixture writer-slot :create leaf))
         (input (open-slot api fixture input-slot :reader leaf)))
    (call-api api :active view input writer (svref (fixture-handles fixture) 0)
              (if old-p 1 2) 123456 header (make-array 64 :element-type '(unsigned-byte 8))
              :version (fixture-version fixture))))
(defun snapshot (api file)
  (let* ((fd (call-api api :fd file)) (stat (sb-posix:fstat fd))
         (directory-p (eq :directory (call-api api :mode file)))
         (kind (if directory-p (sb-posix:s-isdir (sb-posix:stat-mode stat))
                              (sb-posix:s-isreg (sb-posix:stat-mode stat)))))
    (unless kind (reject :fd-kind))
    (list :fd fd :state (call-api api :state file) :mode (call-api api :mode file)
          :written (call-api api :written file) :durable (call-api api :durable file)
          :offset (unless directory-p (sb-posix:lseek fd 0 sb-posix:seek-cur))
          :identity (stat-identity stat) :kind (if directory-p :directory :regular)
          ;; Il rename cambia le entry del parent: la sua size non è una frontiera del log.
          :size (unless directory-p (sb-posix:stat-size stat)))))
(defun snapshots (api fixture)
  (loop for file across (fixture-handles fixture) collect (snapshot api file)))
(defun check-manifest (api manifest new-p)
  (unless (and (= (if new-p 2 1) (call-api api :manifest-active manifest))
               (equal (list t (if new-p 3 2)) (multiple-value-list (call-api api :manifest-next manifest)))
               (= (if new-p 1 0) (call-api api :closed manifest))
               (zerop (call-api api :removed manifest))
               (equal '(:active 0 0) (multiple-value-list (call-api api :segment manifest (if new-p 2 1))))
               (equal (if new-p '(:closed 64 0) '(:unknown 0 0))
                      (multiple-value-list (call-api api :segment manifest (if new-p 1 2)))))
    (reject :recovery-manifest))
  (list :active (if new-p 2 1) :next-id (if new-p 3 2) :closed (if new-p 1 0) :removed 0
        :previous-active (when new-p (list :id 1 :state :closed :valid-bytes 64 :outcomes 0))))
(defun recover-bytes (api fixture bytes new-p)
  (multiple-value-bind (start version)
      (call-api api :log-header bytes 0 (length bytes) :control (fixture-identity fixture))
    (unless (and (= 64 start) (= version (fixture-version fixture))) (reject :control-header))
    (multiple-value-bind (manifest prefix status)
        (call-api api :recover bytes start (length bytes) :version version :file-offset 0
                  :file-size (length bytes) :max-batches 1 :max-batch-records 1 :max-edits 1
                  :max-segmenti 2 :max-esiti 0)
      (unless (and (= prefix (length bytes)) (eq :complete status)) (reject :recovery-prefix))
      (list :status :ok :header-version version :prefix prefix :recovery-status status
            :manifest (check-manifest api manifest new-p)))))
(defun seed-previous (api fixture old-plan)
  (let* ((bytes (copy-seq (call-api api :plan-bytes old-plan)))
         (writer (open-slot api fixture 5 :create "previous-control.tmp"))
         (directory (svref (fixture-handles fixture) 0)))
    (setf (fixture-old-bytes fixture) bytes)
    (unless (= (length bytes) (call-api api :append writer bytes 0 (length bytes))
                             (call-api api :flush writer)) (reject :previous-frontier))
    (unless (null (call-api api :rename directory "previous-control.tmp" "control.log"))
      (reject :seed-rename))
    (unless (zerop (call-api api :flush directory)) (reject :seed-fsync))
    (open-slot api fixture 6 :reader "control.log")
    (recover-bytes api fixture (read-path (merge-pathnames "control.log" (fixture-path fixture)) bytes) nil)))
(defun check-baseline (fixture)
  (let ((baseline (fixture-baseline fixture)))
    (loop for row in baseline for slot from 0 do
      (unless (and (eq :open (getf row :state))
                   (eq (if (zerop slot) :directory (if (member slot '(1 3 5 7)) :append :input))
                       (getf row :mode))) (reject :baseline-state))
      (let ((size (cond ((member slot '(1 2 7 8)) 64)
                        ((member slot '(5 6)) (length (fixture-old-bytes fixture)))
                        (t 0))))
        (unless (and (= (if (member slot '(1 5 7)) size 0) (getf row :written))
                     (= (getf row :written) (getf row :durable))
                     (or (zerop slot) (and (= size (getf row :size))
                                          (= (if (member slot '(1 5 7)) size 0) (getf row :offset)))))
          (reject :baseline-frontier))))
    (dolist (pair '((1 2) (3 4) (5 6) (7 8)))
      (unless (equal (getf (nth (first pair) baseline) :identity)
                     (getf (nth (second pair) baseline) :identity)) (reject :fd-pair)))
    (distinct-identities (loop for slot in '(0 1 3 5 7) collect (getf (nth slot baseline) :identity)))))
(defun prepare-fixture (run fixture)
  (let* ((api (run-api run)) (view (view-for api (fixture-identity fixture))))
    (open-slot api fixture 0 :directory "")
    (let* ((old-active (prepare-active api fixture view t))
           (old-plan (call-api api :plan old-active (edit-payload api nil) 17 :max-segmenti 1 :max-esiti 0)))
      (seed-previous api fixture old-plan))
    (setf (fixture-active fixture) (prepare-active api fixture view nil)
          (fixture-plan fixture) (call-api api :plan (fixture-active fixture) (edit-payload api t)
                                         19 :max-segmenti 2 :max-esiti 0)
          (fixture-expected fixture) (copy-seq (call-api api :plan-bytes (fixture-plan fixture))))
    (open-slot api fixture 3 :create "control.log.tmp")
    (open-slot api fixture 4 :reader "control.log.tmp")
    (write-bytes (merge-pathnames "previous-control.bytes" (fixture-path fixture)) (fixture-old-bytes fixture))
    (write-bytes (merge-pathnames "planned-control.bytes" (fixture-path fixture)) (fixture-expected fixture))
    (setf (fixture-baseline fixture) (snapshots api fixture))
    (check-baseline fixture)
    fixture))
(defun fixture-identity-for (cell worker)
  (let ((bytes (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0)))
    (setf (aref bytes 0) #xc4 (aref bytes 1) cell (aref bytes 2) worker)
    bytes))
(defun prepare-window (run version readers replica cell)
  "Fixture nuova per replica: nessun piano/capacità/gettone proviene da altra finestra."
  (let* ((window-path (merge-pathnames (format nil "v~D-w~D-r~D/" version readers replica)
                                      (run-directory run)))
         (workers (make-array readers :initial-element nil)))
    (private-directory window-path)
    (dotimes (worker readers)
      (let* ((path (private-directory (merge-pathnames (format nil "worker-~D/" worker) window-path)))
             (cases (make-array +count+ :initial-element nil)))
        (setf (svref workers worker) cases)
        (dotimes (ordinal +count+)
          (require-time (run-deadline run))
          (let* ((case-path (private-directory (merge-pathnames (format nil "case-~D/" ordinal) path)))
                 (fixture (make-fixture :path case-path :version version
                                        :identity (fixture-identity-for cell worker))))
            (push fixture (run-fixtures run))
            (setf (svref cases ordinal) (prepare-fixture run fixture))))))
    (distinct-identities
     (loop for cases across workers append
       (loop for fixture across cases append
         (loop for slot in '(0 1 3 5 7) collect (getf (nth slot (fixture-baseline fixture)) :identity)))))
    workers))

(defun quiescent-p (group)
  (let ((done (or (null group) (notany (lambda (thread) (and thread (sb-thread:thread-alive-p thread)))
                                     (group-threads group)))))
    (when done (sb-thread:barrier (:read)))
    done))
(defun check-stop (group)
  (sb-thread:barrier (:read))
  (when (= 1 (group-stop group)) (expire :stop))
  (require-time (group-deadline group)))
(defun request-stop (group)
  (setf (group-stop group) 1)
  (sb-thread:barrier (:write)))
(defun run-cases (api cases group raw)
  (loop for fixture across cases do
    (check-stop group)
    (incf (raw-attempted raw))
    (let ((handles (fixture-handles fixture)))
      (setf (fixture-prepared fixture)
            (funcall (api-prepare api) (fixture-plan fixture) (svref handles 4) (svref handles 3)
                     (svref handles 0) (fixture-scratch fixture) :chunk-bytes 4096))
      (incf (raw-prepared raw))
      (check-stop group)
      (setf (fixture-published fixture)
            (funcall (api-publish api) (fixture-prepared fixture) (svref handles 6)))
      (incf (raw-count raw)))
    (check-stop group))
  :terminated)
(defun worker-entry (api cases group raw)
  "Confine worker: conserva condizione e prefisso, senza close/cleanup/report."
  (handler-case
      (progn
        (sb-thread:signal-semaphore (group-ready group))
        (unless (sb-thread:wait-on-semaphore (group-gate group) :timeout (remaining (group-deadline group)))
          (expire :gate))
        (run-cases api cases group raw))
    (error (condition) (setf (raw-failure raw) condition)))
  (setf (raw-terminated raw) t)
  :terminated)
(defun join-started (group)
  (loop for thread across (group-threads group) do
    (when thread
      (unless (eq :terminated (sb-thread:join-thread thread :timeout (remaining (group-deadline group))
                                                          :default :join-timeout)) (expire :join)))))
(defun parallel-action (group entries names)
  (dotimes (id (length entries))
    (check-stop group)
    (setf (svref (group-threads group) id) (sb-thread:make-thread (svref entries id) :name (svref names id))))
  (dotimes (id (length entries))
    (unless (sb-thread:wait-on-semaphore (group-ready group) :timeout (remaining (group-deadline group)))
      (expire :ready)))
  (check-stop group)
  (sb-thread:signal-semaphore (group-gate group) (length entries))
  (join-started group))
(defun observe-action (group action)
  "Il GC canonico precede questa funzione; startup/gate/join e controlli sono inclusi."
  (let ((before (sb-ext:get-bytes-consed)) (start (get-internal-real-time)) (failure nil))
    (handler-case (funcall action)
      (error (condition)
        (setf failure condition)
        (request-stop group)
        (sb-thread:signal-semaphore (group-gate group) (length (group-raws group)))
        (handler-case (join-started group)
          (error (join-condition)
            (when (typep failure 'bench-deadline) (setf failure join-condition))))))
    (let ((heap (- (sb-ext:get-bytes-consed) before))
          (ticks (- (get-internal-real-time) start)))
      (list :seconds (/ ticks (float internal-time-units-per-second 1d0)) :ticks ticks :heap-bytes heap
            :deadline-expired (not (plusp (remaining (group-deadline group))))
            :error-kind (cond ((null failure) nil) ((typep failure 'bench-deadline) :deadline) (t :error))
            :diagnostic (when failure (diagnostic failure))))))

(defun require-fields (record fields)
  (unless (and (listp record) (evenp (length record))
               (loop for tail on record by #'cddr always (keywordp (first tail)))) (reject :record-shape))
  (dolist (field fields)
    (unless (nth-value 0 (get-properties record (list field))) (reject :missing-field (symbol-name field))))
  record)
(defun check-worker (record)
  (require-fields record '(:worker-id :terminated :attempted :prepared :count :error-kind :results :readback))
  (unless (and (typep (getf record :worker-id) '(integer 0 3))
               (typep (getf record :terminated) 'boolean)
               (member (getf record :error-kind) '(nil :deadline :error :not-terminated))) (reject :worker-shape))
  (when (getf record :terminated)
    (let ((a (getf record :attempted)) (p (getf record :prepared)) (n (getf record :count)))
      (unless (and (typep a '(integer 0 8)) (typep p '(integer 0 8)) (typep n '(integer 0 8))
                   (<= n p a (min +count+ (1+ n)))) (reject :count-oracle))))
  record)
(defun classify-worker (record)
  "Classificatore puro: timeout e prefissi sono esiti C4, mai asserzioni del prodotto."
  (handler-case
      (progn (check-worker record)
             (cond ((not (getf record :terminated)) :incomplete)
                   ((eq :error (getf record :error-kind)) :failed)
                   ((eq :failed (getf (getf record :readback) :status)) :failed)
                   ((eq :incomplete (getf (getf record :readback) :status)) :incomplete)
                   ((or (getf record :error-kind) (/= +count+ (getf record :count))) :incomplete)
                   ((not (and (= +count+ (length (getf record :results)))
                              (eq :ok (getf (getf record :readback) :status))
                              (every (lambda (result) (eq :ok (getf result :status)))
                                     (getf record :results)))) :failed)
                   (t :ok)))
    (bench-failure () :failed)))
(defun classify-window (window)
  (require-fields window '(:version :readers :replica :count :seconds :heap-bytes :workers :results :limits :readback))
  (unless (and (member (getf window :version) '(1 2)) (member (getf window :readers) '(1 2 4))
               (typep (getf window :replica) '(integer 1 5))) (reject :window-shape))
  (let ((statuses (mapcar #'classify-worker (getf window :workers))))
    (cond ((or (eq :error (getf (getf window :results) :error-kind))
               (member :failed statuses) (eq :failed (getf (getf window :readback) :status))
               (/= (length statuses) (length (remove-duplicates (getf window :workers) :key
                                                              (lambda (w) (getf w :worker-id)))))) :failed)
          ((or (getf (getf window :results) :deadline-expired)
               (getf (getf window :results) :error-kind)
               (/= (getf window :readers) (length statuses)) (member :incomplete statuses)
               (/= (* +count+ (getf window :readers)) (getf window :count))) :incomplete)
          ((not (= (getf window :count)
                   (reduce #'+ (getf window :workers) :key (lambda (w) (getf w :count)) :initial-value 0))) :failed)
          ((not (and (typep (getf window :seconds) '(real 0))
                     (typep (getf window :heap-bytes) '(integer 0))
                     (eq :ok (getf (getf window :readback) :status)))) :failed)
          (t :ok))))
(defun classify-campaign (windows)
  (let ((statuses (mapcar #'classify-window windows))
        (cells (mapcar (lambda (w) (list (getf w :version) (getf w :readers) (getf w :replica))) windows)))
    (cond ((or (member :failed statuses) (/= (length cells) (length (remove-duplicates cells :test #'equal)))) :failed)
          ((or (/= 30 (length windows)) (member :incomplete statuses)) :incomplete)
          ((/= 560 (reduce #'+ windows :key (lambda (w) (getf w :count)) :initial-value 0)) :failed)
          (t :ok))))

(defun expected-frontiers (fixture)
  (let ((rows (copy-tree (fixture-baseline fixture))) (size (length (fixture-expected fixture))))
    (setf (getf (nth 3 rows) :written) size (getf (nth 3 rows) :durable) size
          (getf (nth 3 rows) :offset) size (getf (nth 3 rows) :size) size
          (getf (nth 4 rows) :size) size)
    rows))
(defun file-sha256 (run path &key (check-deadline t))
  "Cold: SHA-256 del lettore comune; finalizzazione già fallita può completare l'hash."
  (when check-deadline (require-time (run-deadline run)))
  (let ((hash (funcall (function-in "ARCDOCDB.EVIDENCE" "FILE-SHA256") path)))
    (unless (and (stringp hash) (= 64 (length hash))
                 (every (lambda (c) (or (char<= #\0 c #\9) (char<= #\a c #\f))) hash))
      (reject :evidence-sha256))
    (when check-deadline (require-time (run-deadline run)))
    hash))
(defun check-old-fd (api fixture)
  (let ((bytes (make-array (length (fixture-old-bytes fixture)) :element-type '(unsigned-byte 8)))
        (file (svref (fixture-handles fixture) 6)))
    (unless (and (= (length bytes) (call-api api :read file bytes 0 (length bytes) 0))
                 (equalp bytes (fixture-old-bytes fixture))) (reject :old-fd-bytes))
    (recover-bytes api fixture bytes nil)))
(defun check-active-file (api fixture old-p)
  (let* ((expected (if old-p (fixture-old-header fixture) (fixture-header fixture)))
         (path (merge-pathnames (if old-p "previous-active.tmp" "active.tmp") (fixture-path fixture)))
         (bytes (read-path path expected)))
    (multiple-value-bind (next version origin)
        (call-api api :segment-header bytes 0 (length bytes) (fixture-identity fixture) (if old-p 1 2))
      (unless (and (= next 64) (= version (fixture-version fixture)) (= origin 1)) (reject :active-header)))
    (stat-identity (checked-stat path 64))))
(defun verify-fixture (run fixture)
  "Cold: rilegge il nome installato; recovery su quei byte, mai sul manifest già nel piano."
  (let* ((api (run-api run)) (path (merge-pathnames "control.log" (fixture-path fixture)))
         (bytes (read-path path (fixture-expected fixture)))
         (identity (stat-identity (checked-stat path (length bytes))))
         (baseline (fixture-baseline fixture)) (current (snapshots api fixture)))
    (unless (equal current (expected-frontiers fixture)) (reject :frontier-or-offset))
    (unless (and (equal identity (getf (nth 3 baseline) :identity))
                 (not (equal identity (getf (nth 6 baseline) :identity)))) (reject :installed-inode))
    (unless (and (zerop (sb-posix:stat-nlink (sb-posix:fstat (call-api api :fd (svref (fixture-handles fixture) 6)))))
                 (zerop (sb-posix:stat-nlink (sb-posix:fstat (call-api api :fd (svref (fixture-handles fixture) 5))))))
      (reject :previous-inode-still-linked))
    (when (lstat-or-absent (merge-pathnames "control.log.tmp" (fixture-path fixture))) (reject :source-still-present))
    (unless (and (equal (check-active-file api fixture nil) (getf (nth 1 baseline) :identity))
                 (equal (check-active-file api fixture t) (getf (nth 7 baseline) :identity))) (reject :active-inode))
    (let ((directory (lstat-or-absent (fixture-path fixture))))
      (unless (and directory (= #o700 (logand #o777 (sb-posix:stat-mode directory)))
                   (sb-posix:s-isdir (sb-posix:stat-mode directory))
                   (equal (stat-identity directory) (getf (first baseline) :identity))) (reject :directory-inode)))
    (unless (and (equal '(:published t) (multiple-value-list (call-api api :publication-state (fixture-prepared fixture))))
                 (eq (fixture-active fixture) (call-api api :published-active (fixture-published fixture)))
                 (eq (svref (fixture-handles fixture) 3)
                     (call-api api :log-file (call-api api :published-log (fixture-published fixture))))
                 (eq :open (call-api api :log-state (call-api api :published-log (fixture-published fixture)))))
      (reject :published-result))
    (list :status :ok :path (namestring path) :installed-inode identity
          :previous-inode (getf (nth 6 baseline) :identity)
          :independent-inodes (loop for slot in '(0 1 3 5 7) collect (getf (nth slot baseline) :identity))
          :installed-sha256 (file-sha256 run path)
          :readback (recover-bytes api fixture bytes t) :old-fd (check-old-fd api fixture)
          :source-tmp :absent :active-header :unchanged :frontiers :verified :offsets :verified)))
(defun worker-record (run group id cases root)
  "Accede al raw soltanto dopo quiescenza globale; esiti cold conservati anche se parziali."
  (unless (quiescent-p group)
    (return-from worker-record
      (list :worker-id id :status :incomplete :terminated nil :attempted nil :prepared nil :count nil
            :root root :error-kind :not-terminated :results nil :readback (list :status :not-run))))
  (let* ((raw (svref (group-raws group) id)) (failure (raw-failure raw)) (results nil) (read-failure nil))
    (handler-case
        (progn
          (unless (equal root (private-root-record (pathname (getf root :path)))) (reject :worker-root-changed))
          (loop for fixture across cases when (fixture-published fixture) do
            (require-time (run-deadline run)) (push (verify-fixture run fixture) results)))
      (error (condition) (setf read-failure condition)))
    (let ((record (list :worker-id id :terminated (raw-terminated raw) :attempted (raw-attempted raw)
                        :prepared (raw-prepared raw) :count (raw-count raw) :root root
                        :error-kind (cond ((null failure) nil) ((typep failure 'bench-deadline) :deadline) (t :error))
                        :diagnostic (when failure (diagnostic failure)) :results (nreverse results)
                        :readback (list :status (cond ((null read-failure) :ok)
                                                     ((typep read-failure 'bench-deadline) :incomplete) (t :failed))
                                        :diagnostic (when read-failure (diagnostic read-failure))))))
      (setf (getf record :status) (classify-worker record))
      record)))
(defun run-window (run version readers replica cell)
  (let* ((cases (prepare-window run version readers replica cell))
         (raws (make-array readers :initial-element nil)) (entries (make-array readers))
         (names (make-array readers))
         (roots (map 'vector (lambda (owned)
                               (private-root-record
                                (make-pathname :directory (butlast (pathname-directory (fixture-path (svref owned 0)))))))
                     cases))
         (group (make-group :threads (make-array readers :initial-element nil) :raws raws)))
    (distinct-identities (loop for root across roots collect (getf root :identity)))
    (setf (run-active run) group)
    (dotimes (id readers)
      (let ((raw (make-raw)) (owned (svref cases id)))
        (setf (svref raws id) raw
              (svref entries id) (lambda () (worker-entry (run-api run) owned group raw))
              (svref names id) (format nil "control-c4-~D" id))))
    (let ((action (if (= readers 1)
                      (lambda ()
                        (handler-case (run-cases (run-api run) (svref cases 0) group (svref raws 0))
                          (error (condition) (setf (raw-failure (svref raws 0)) condition)))
                        (setf (raw-terminated (svref raws 0)) t))
                      (lambda () (parallel-action group entries names)))))
      ;; Fonte canonica unica del GC della finestra: nessuna variante salta questo passo.
      (sb-ext:gc :full t)
      (require-time (run-deadline run))
      (setf (group-deadline group) (min (run-deadline run)
                                       (+ (get-internal-real-time) (* +window-seconds+ internal-time-units-per-second))))
      (let* ((sample (observe-action group action))
             (workers (loop for id below readers collect (worker-record run group id (svref cases id) (svref roots id))))
             (count (loop for worker in workers sum (or (getf worker :count) 0)))
             (read-status (cond ((some (lambda (w) (eq :failed (getf (getf w :readback) :status))) workers) :failed)
                                ((every (lambda (w) (eq :ok (getf (getf w :readback) :status))) workers) :ok)
                                (t :incomplete)))
             (window (list :schema-version 1 :version version :readers readers :replica replica
                           :count count :seconds (getf sample :seconds) :heap-bytes (getf sample :heap-bytes)
                           :workers workers :results sample :readback (list :status read-status :clock :excluded)
                           :limits '(:whole-process-heap :startup-gate-join-included :cooperative-deadline))))
        (setf (getf window :status) (classify-window window))
        window))))

(defun collect-sources (run)
  "Inventario conservativo: tutti i .lisp src, ASD, driver, metodo e helper SHA."
  (let ((pending (list (cons (merge-pathnames "src/" (run-root run)) 0))) (paths nil))
    (loop repeat 4096 while pending do
      (let* ((item (pop pending)) (directory (car item)) (depth (cdr item)))
        (when (> depth 12) (reject :source-depth))
        (check-ancestors directory)
        (dolist (path (funcall (function-in "UIOP" "DIRECTORY-FILES") directory))
          (when (equal "lisp" (pathname-type path)) (push path paths)))
        (dolist (child (funcall (function-in "UIOP" "SUBDIRECTORIES") directory))
          (push (cons child (1+ depth)) pending))))
    (when pending (reject :source-budget))
    (dolist (name '("arcdocdb.asd" "tools/control-checkpoint-bench.lisp" "tools/evidence-storage.lisp"
                    "docs/implementazione/control-verifica-metodo.md"))
      (push (merge-pathnames name (run-root run)) paths))
    (setf (run-source-paths run) (sort paths #'string< :key #'namestring))))
(defun source-snapshot (run)
  (loop for path in (run-source-paths run) collect
    (list :path (enough-namestring path (run-root run)) :bytes (sb-posix:stat-size (sb-posix:lstat (namestring path)))
          :sha256 (file-sha256 run path))))
(defun report-text (report)
  (let ((text (with-output-to-string (stream)
                (let ((*print-readably* t) (*print-pretty* nil) (*print-length* nil) (*print-level* nil))
                  (write report :stream stream) (terpri stream)))))
    (when (> (length text) +max-report+) (reject :report-budget))
    text))
(defun decode-own-report (text)
  "Solo dati serializzati da C4, budget fisso e *READ-EVAL* NIL."
  (when (> (length text) +max-report+) (reject :report-budget))
  (with-input-from-string (stream text)
    (let ((*read-eval* nil) (*package* (find-package :cl-user)))
      (let ((record (read stream nil :eof)))
        (unless (and (listp record) (eq :eof (read stream nil :eof))) (reject :report-roundtrip))
        record))))
(defun checked-report-text (report)
  (require-fields report '(:schema-version :kind :status :versions :readers :replicas :count
                          :seconds :heap-bytes :windows :workers :results :limits :readback :source :environment))
  (unless (eql 1 (getf report :schema-version)) (reject :report-schema))
  (let ((text (report-text report)))
    (unless (equalp report (decode-own-report text)) (reject :report-roundtrip))
    text))
(defun write-report (run report)
  "Cold: checkpoint su disco e readback; nessuna persistenza se un worker è vivo."
  (unless (quiescent-p (run-active run)) (reject :report-worker-alive))
  (let* ((path (merge-pathnames "report.lisp" (run-directory run)))
         (temporary (merge-pathnames "report.lisp.tmp" (run-directory run)))
         (text (checked-report-text report)))
    (with-open-file (stream temporary :direction :output :external-format :utf-8
                                     :if-exists :error :if-does-not-exist :create)
      (write-string text stream))
    (unless (eql 0 (sb-posix:rename (namestring temporary) (namestring path))) (reject :report-rename))
    (let* ((expected (sb-ext:string-to-octets text :external-format :utf-8))
           (bytes (read-path path expected))
           (stored (sb-ext:octets-to-string bytes :external-format :utf-8)))
      (unless (equalp report (decode-own-report stored)) (reject :persisted-report-readback))))
  report)
(defun write-report-sha (run)
  "Hash dell'ultimo report canonico anche dopo timeout; readback dei byte del descriptor."
  (when (find-package "ARCDOCDB.EVIDENCE")
    (let* ((path (merge-pathnames "report.sha256" (run-directory run)))
           (temporary (merge-pathnames "report.sha256.tmp" (run-directory run)))
           (hash (file-sha256 run (merge-pathnames "report.lisp" (run-directory run)) :check-deadline nil))
           (text (format nil "~A  report.lisp~%" hash))
           (bytes (sb-ext:string-to-octets text :external-format :utf-8)))
      (write-bytes temporary bytes)
      (unless (eql 0 (sb-posix:rename (namestring temporary) (namestring path))) (reject :sha-rename))
      (read-path path bytes))))
(defun close-fixtures (run)
  "Confine cleanup: rilascia soltanto FD; tutti i file di fixture/evidenza restano conservati."
  (unless (quiescent-p (run-active run))
    (return-from close-fixtures (list :status :incomplete :quiescent nil :action :retained-until-os-exit)))
  (let ((failures nil) (count 0))
    (dolist (fixture (run-fixtures run))
      (dotimes (slot (length (fixture-handles fixture)))
        (let ((file (svref (fixture-handles fixture) slot)))
          (when file
            (setf (svref (fixture-handles fixture) slot) nil)
            (handler-case
                (progn (unless (null (call-api (run-api run) :close file)) (reject :close-return)) (incf count))
              (error (condition) (push (diagnostic condition) failures)))))))
    (list :status (if failures :failed :ok) :quiescent t :closed-fds count
          :action :files-retained :diagnostics (nreverse failures))))
(defun new-report (args root)
  (list :schema-version 1 :kind (if (equal args '("--self-test")) :control-checkpoint-self-test :control-checkpoint-benchmark)
        :status :running :exit-code nil :argv (copy-list args) :recorded-at (get-universal-time)
        :versions '(1 2) :readers '(1 2 4) :replicas +replicas+ :count 0 :seconds 0d0 :heap-bytes 0
        :windows nil :workers nil :results nil :readback (list :status :not-run)
        :params (list :count-per-worker +count+ :expected-windows 30 :expected-publications 560
                      :window-seconds +window-seconds+ :campaign-seconds +campaign-seconds+
                      :chunk-bytes 4096 :warmup 0 :max-workers 4 :max-open-fixture-fds 288
                      :count-unit :published-api-returns :seconds-unit :wall-seconds :heap-unit :allocated-bytes)
        :source (list :before nil :after nil :consistency :not-observed :source-freeze :required
                      :inventory :conservative-src-plus-driver-method-asd-evidence :hash :sha256
                      :outer-recorder :required-for-git-status-environment-stdout-stderr)
        :environment (list :lisp (lisp-implementation-type) :version (lisp-implementation-version)
                           :root (namestring root) :features (copy-list *features*)
                           :timer :get-internal-real-time :timer-units internal-time-units-per-second
                           :heap-counter :sb-ext-get-bytes-consed :heap-scope :whole-process
                           :heap-is :allocated-not-live-or-rss :safety 3 :speed 2 :debug 2
                           :private-fasl-cache nil :asdf-force t :load-status :not-attempted
                           :warning-policy :fatal-except-recorded-sb-kernel-redefinition-warning)
        :limits '(:native-local-filesystem :private-directory-0700 :fresh-fixture-per-window-and-case
                  :no-publisher-token-reuse :active-plan-fixture-bytes-and-full-gc-excluded
                  :prepare-readback-and-preflight-included :publish-rename-and-fsync-included
                  :startup-gate-join-in-parallel-clock :final-header-recovery-stat-oracles-excluded
                  :heap-whole-process :no-zero-heap-claim :no-db-throughput-claim :no-performance-threshold
                  :cooperative-deadlines :outer-process-timeout-required :no-power-loss-test
                  :fixed-order :warm-os-cache :external-load-uncontrolled :no-latency-percentiles
                  :no-catalog-inventory-reclaim-or-client-ack :namespace-ancestors-not-race-proof
                  :source-before-after-not-continuous-monitor :report-readback-not-fsync-durability)
        :namespace nil :phase :arguments :current-window nil :load-warnings nil :self-test nil
        :cleanup nil :persistence :stdout-only :diagnostic nil))
(defun describe-native-environment (report)
  "Solo --bench: metadati cold, indipendenti dal classificatore puro --self-test."
  (let ((environment (getf report :environment)))
    (setf (getf environment :os) (software-type) (getf environment :os-version) (software-version)
          (getf environment :machine) (machine-type) (getf environment :cpu) (machine-version)
          (getf environment :pid) (sb-posix:getpid) (getf environment :external-load) :uncontrolled
          (getf environment :ram-and-process-heap-limit) :outer-recorder))
  report)
(defun update-totals (report)
  (let ((windows (getf report :windows)))
    (setf (getf report :count) (reduce #'+ windows :key (lambda (w) (getf w :count)) :initial-value 0)
          (getf report :seconds) (reduce #'+ windows :key (lambda (w) (getf w :seconds)) :initial-value 0d0)
          (getf report :heap-bytes) (reduce #'+ windows :key (lambda (w) (getf w :heap-bytes)) :initial-value 0)
          (getf report :workers) (list :counts '(1 2 4) :scope :independent-series)
          (getf report :results) (list :recorded-windows (length windows) :expected-windows 30)
          (getf report :readback) (list :status (if (and (= 30 (length windows))
                                                      (every (lambda (w) (eq :ok (getf (getf w :readback) :status))) windows))
                                                 :ok :incomplete) :clock :excluded)))
  report)
(defun benchmark (run report)
  (describe-native-environment report)
  (let ((*standard-output* *error-output*) (*load-print* nil) (*load-verbose* nil))
    (with-load-policy run (lambda () (require :asdf)))
    (with-load-policy run (lambda () (load (merge-pathnames "tools/evidence-storage.lisp" (run-root run))))))
  (collect-sources run)
  (setf (getf (getf report :source) :before) (source-snapshot run)
        (getf report :phase) :load-product (getf (getf report :environment) :load-status) :running)
  (load-product run)
  (setf (getf (getf report :environment) :load-status) :ok)
  (write-report run report)
  (let ((cell 0))
    (dolist (version '(1 2))
      (dolist (readers '(1 2 4))
        (dotimes (replica +replicas+)
          (require-time (run-deadline run))
          (incf cell)
          (setf (getf report :phase) :window
                (getf report :current-window) (list :version version :readers readers :replica (1+ replica)))
          (let ((window (run-window run version readers (1+ replica) cell)))
            (setf (getf report :windows) (append (getf report :windows) (list window)))
            (update-totals report)
            (when (quiescent-p (run-active run)) (write-report run report))
            (unless (eq :ok (getf window :status))
              (setf (getf report :status) (getf window :status))
              (return-from benchmark report))
            (let ((cleanup (close-fixtures run)))
              (unless (eq :ok (getf cleanup :status))
                (reject :window-cleanup (report-text cleanup)))))))))
  (setf (getf report :status) (classify-campaign (getf report :windows)))
  report)

(defun expect-rejection (function reason)
  (let ((observed nil))
    (handler-case (funcall function)
      (bench-failure (condition) (setf observed (failure-reason condition))))
    (unless (eq observed reason) (reject :self-test (format nil "atteso ~S osservato ~S" reason observed)))))
(defun model-worker (id)
  (list :worker-id id :terminated t :attempted +count+ :prepared +count+ :count +count+
        :error-kind nil :results (loop repeat +count+ collect (list :status :ok)) :readback (list :status :ok)))
(defun model-window (version readers replica)
  (list :schema-version 1 :version version :readers readers :replica replica :count (* readers +count+)
        :seconds 1d0 :heap-bytes 16 :workers (loop for id below readers collect (model-worker id))
        :results (list :error-kind nil :deadline-expired nil) :limits nil :readback (list :status :ok)))
(defun self-test (report)
  "COD-60: pure classificazioni/serializzazione; nessun load prodotto, child, thread o fixture nativa."
  (when (find-package "ARCDOCDB.CONTROL") (reject :self-test "richiesto processo separato pulito"))
  (let ((windows (loop for version in '(1 2) append
                   (loop for readers in '(1 2 4) append
                     (loop for replica from 1 to +replicas+ collect (model-window version readers replica))))))
    (unless (eq :ok (classify-campaign windows)) (reject :self-test "campione completo"))
    (unless (eq :incomplete (classify-campaign (rest windows))) (reject :self-test "campione parziale"))
    (unless (eq :failed (classify-campaign (cons (first windows) (butlast windows))))
      (reject :self-test "cella duplicata"))
    (dolist (kind '(:deadline :error :not-terminated))
      (let ((worker (model-worker 0)))
        (setf (getf worker :error-kind) kind)
        (when (eq :not-terminated kind) (setf (getf worker :terminated) nil))
        (unless (eq (if (eq :error kind) :failed :incomplete) (classify-worker worker))
          (reject :self-test "worker errato/timeout"))))
    (let ((worker (model-worker 0)) (late (copy-tree (first windows))))
      (setf (getf worker :count) 9)
      (unless (eq :failed (classify-worker worker)) (reject :self-test "count oltre limite"))
      (setf (getf (getf late :results) :deadline-expired) t)
      (unless (eq :incomplete (classify-window late)) (reject :self-test "finestra tardiva")))
    (let ((worker (model-worker 0)))
      (setf (getf (getf worker :readback) :status) :failed)
      (unless (eq :failed (classify-worker worker)) (reject :self-test "readback fallito")))
    (let ((prefix (model-worker 0)) (window (model-window 2 2 1)))
      (setf (getf prefix :attempted) 1 (getf prefix :prepared) 1 (getf prefix :count) 0
            (getf prefix :results) nil (getf prefix :error-kind) :deadline)
      (unless (eq :incomplete (classify-worker prefix)) (reject :self-test "prefisso valido"))
      (setf (getf (second (getf window :workers)) :worker-id) 0)
      (unless (eq :failed (classify-window window)) (reject :self-test "worker duplicato")))
    (let ((expired (make-run :deadline 0)) (probe (copy-tree report)))
      (setf (getf probe :status) :ok (getf probe :exit-code) 0)
      (unless (and (mark-late expired probe) (eq :incomplete (getf probe :status))
                   (= 1 (getf probe :exit-code))) (reject :self-test "exit tardivo"))
      (unless (eq :failed (failure-status :failed (make-condition 'bench-deadline :reason :deadline :detail "modello")))
        (reject :self-test "errore nascosto dal timeout")))
    (dolist (path '("spikes/out/x/" "spikes/out/control-checkpoint-bench-/"
                    "spikes/out/control-checkpoint-bench-x/../" "spikes/out/control-checkpoint-bench-x"))
      (expect-rejection (lambda () (namespace-path #p"/fixture/" path)) :namespace))
    (namespace-path #p"/fixture/" "spikes/out/control-checkpoint-bench-A_1/")
    (expect-rejection (lambda () (distinct-identities '((1 2) (1 2)))) :inode-alias)
    (expect-rejection (lambda () (decode-own-report "(:a 1) (:b 2)")) :report-roundtrip)
    (setf (getf report :self-test) (list :status :ok :product-loaded nil :child-processes 0
                                       :threads 0 :native-fixtures 0 :benchmark-executed nil
                                       :cases '(:complete-30-560 :partial :duplicate-cell :typed-timeout
                                                :worker-error :count-overrun :failed-readback :late-window
                                                :literal-namespace :inode-alias :serialization :late-exit :error-precedence
                                                :valid-prefix :duplicate-worker))
          (getf report :status) :ok (getf report :phase) :self-test)
    (checked-report-text report))
  report)
(defun mark-late (run report)
  (when (and (eq :ok (getf report :status)) (not (plusp (remaining (run-deadline run)))))
    (setf (getf report :status) :incomplete (getf report :exit-code) 1
          (getf report :diagnostic) "tools/control-checkpoint-bench.lisp COD-61: deadline dopo persistenza/stdout")
    t))
(defun finalize-report (run report)
  (setf (getf report :cleanup) (close-fixtures run)
        (getf report :load-warnings) (nreverse (run-warnings run)))
  (unless (eq :ok (getf (getf report :cleanup) :status))
    (setf (getf report :status) (if (or (eq :failed (getf report :status))
                                      (eq :failed (getf (getf report :cleanup) :status))) :failed :incomplete)))
  (when (and (run-source-paths run) (quiescent-p (run-active run)))
    (handler-case
        (let* ((after (source-snapshot run)) (source (getf report :source))
               (stable (equal (getf source :before) after)))
          (setf (getf source :after) after (getf source :consistency) (if stable :stable :changed))
          (unless stable (setf (getf report :status) :failed (getf report :diagnostic) "COD-61: source SHA cambiato")))
      (error (condition)
        (setf (getf report :status) (failure-status (getf report :status) condition)
              (getf report :diagnostic) (diagnostic condition)))))
  (setf (getf report :exit-code) (if (eq :ok (getf report :status)) 0 1) (getf report :phase) :finished)
  (mark-late run report)
  (when (and (run-directory run) (quiescent-p (run-active run)))
    (setf (getf report :persistence) :readback-verified)
    (handler-case
        (progn (write-report run report) (write-report-sha run))
      (error (condition)
        (setf (getf report :status) (failure-status (getf report :status) condition)
              (getf report :exit-code) 1 (getf report :diagnostic) (diagnostic condition)
              (getf report :persistence) :failed))))
  report)
(defun persist-last-state (run report)
  "Confine finale: dopo persistenza controlla ancora il tempo; l'actual exit resta nonzero."
  (when (and (run-directory run) (quiescent-p (run-active run)))
    (handler-case (progn (write-report run report) (write-report-sha run))
      (error (condition) (setf (getf report :status) :failed (getf report :exit-code) 1
                              (getf report :persistence) :failed (getf report :diagnostic) (diagnostic condition)))))
  (mark-late run report))
(defun main (root)
  (let* ((args (rest sb-ext:*posix-argv*))
         (run (make-run :root root :deadline (+ (get-internal-real-time)
                                                (* +campaign-seconds+ internal-time-units-per-second))))
         (report (new-report args root)))
    (handler-case
        (cond ((equal args '("--self-test")) (self-test report))
              ((and (= 2 (length args)) (equal "--bench" (first args)))
               (unless (and (= sb-vm:n-word-bits 64) (or (member :darwin *features*) (member :linux *features*)))
                 (reject :platform "richiesto SBCL64 Linux/macOS"))
               (acquire-namespace run (second args))
               (setf (getf report :namespace) (second args)
                     (getf (getf report :environment) :private-fasl-cache)
                     (namestring (merge-pathnames "fasl/" (run-directory run))))
               (write-report run report)
               (benchmark run report))
              (t (reject :arguments "--self-test oppure --bench spikes/out/control-checkpoint-bench-X/")))
      (error (condition)
        (when (eq :load-product (getf report :phase))
          (setf (getf (getf report :environment) :load-status) :failed))
        (setf (getf report :status) (failure-status (getf report :status) condition)
              (getf report :diagnostic) (diagnostic condition))))
    (finalize-report run report)
    (when (mark-late run report) (persist-last-state run report))
    (when (eq :failed (getf report :persistence)) (persist-last-state run report))
    (write-string (checked-report-text report) *standard-output*)
    (finish-output *standard-output*)
    (when (mark-late run report) (persist-last-state run report))
    (unless (zerop (getf report :exit-code))
      (format *error-output* "~&tools/control-checkpoint-bench.lisp COD-61: ~S; ~A~%"
              (getf report :status) (or (getf report :diagnostic) "consultare windows/readback/cleanup")))
    ;; Ultimo controllo dopo stdout/persistenza: exit OS autentico prevale sul testo già emesso.
    (when (mark-late run report) (persist-last-state run report))
    (sb-ext:exit :code (getf report :exit-code) :abort (not (quiescent-p (run-active run))))))

(main (make-pathname :directory (butlast (pathname-directory *load-truename*))
                     :name nil :type nil :defaults *load-truename*))
