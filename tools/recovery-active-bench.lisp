;;;; C4 piccolo: apertura/recovery ACTIVE readonly in memoria, con allocazioni.
;;; OWNER: main fixture/FD fino a tutti i join; worker i scratch/decisions/raw i.
;;; SHARED: codice immutabile, semafori e solo canale condizioni protetto da mutex.
;;; REQ: REQ-REC-001 REQ-TXM-007 REQ-AFF-008 REQ-AFF-009 REQ-VAL-001
;;; Bootstrap di control-transition-bench: warning tool fatali anche durante LOAD.
(eval-when (:load-toplevel :execute)
  (unless (member :recovery-active-driver *features*)
    (let ((*features* (cons :recovery-active-driver *features*)))
      (handler-bind ((warning (lambda (c) (error "COD-60: warning tool: ~A" c))))
        (load *load-truename*)))
    (error "COD-60: il driver non ha terminato il processo.")))
(defpackage #:arcdocdb.recovery.active.bench (:use #:cl))
(in-package #:arcdocdb.recovery.active.bench)
(declaim (optimize (safety 3) (speed 2) (debug 2)))
(defconstant +iterations+ 200)
(defconstant +warmup+ 8)
(defconstant +window-seconds+ 5)
(defconstant +join-seconds+ 30)
(defconstant +size+ 768)
(defparameter *local* '(0 1 #x8000000000000000 #xffffffffffffffff))
(defparameter *derived* '(2 3 #x8000000000000001 #xfffffffffffffffe))
(defparameter *aborted* '(4 5 #x8000000000000002 #xfffffffffffffffd))
(defparameter *csns* '(0 7 #x8000000000000000 #xffffffffffffffff))
(define-condition bench-failure (error)
  ((reason :initarg :reason :reader failure-reason))
  (:report (lambda (c s) (format s "recovery-active COD-60: ~S" (failure-reason c)))))
(define-condition deadline (bench-failure) ())
(defun reject (reason) (error 'bench-failure :reason reason))
(defun require-time (limit)
  (when (>= (get-internal-real-time) limit) (error 'deadline :reason :deadline)))
(defun remaining (limit)
  (max 0.000001d0 (/ (- limit (get-internal-real-time)) (float internal-time-units-per-second 1d0))))
(defun api (package name)
  (let ((symbol (find-symbol name package)))
    (unless (and symbol (fboundp symbol)) (reject (list :missing-api package name)))
    (symbol-function symbol)))
(defun av (name &rest args) (apply (api "ARCDOCDB.RECOVERY.ACTIVE.TESTS" name) args))
(defun public (name &rest args)
  (multiple-value-bind (symbol visibility) (find-symbol name "ARCDOCDB.RECOVERY.ACTIVE")
    (unless (eq visibility :external) (reject (list :not-public name)))
    (apply (symbol-function symbol) args)))
(defun matrix ()
  (loop for v in '(1 2) append (loop for n in '(1 2 4) append
    (loop for replica from 1 to 3 collect (list v n replica)))))
(defun output-name-p (s)
  (let ((prefix "spikes/out/active-verifica-bench-"))
    (and (stringp s) (> (length s) (1+ (length prefix)))
         (string= prefix s :end2 (length prefix)) (char= #\/ (char s (1- (length s))))
         (let ((suffix (subseq s (length prefix) (1- (length s)))))
           (and (<= 1 (length suffix) 64)
                (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                                      (char<= #\0 c #\9) (find c "-_"))) suffix))))))
(defun arguments (args)
  (cond ((equal args '("--self-test")) (values :self-test nil))
        ((and (= 3 (length args)) (equal (first args) "--bench")
              (equal (second args) "--output") (output-name-p (third args)))
         (values :bench (third args)))
        (t (reject :arguments))))

;;; Oracolo dichiarativo puro: nessun risultato del prodotto costruisce l'atteso.
(defun expected-queries ()
  (append (loop for id in *derived* for csn in *csns* collect (list id t csn))
          (loop for id in (append *local* *aborted* '(42)) collect (list id nil 0))))
(defun oracle-p (frontiers statistics queries version)
  (and (equal frontiers (list +size+ +size+ :complete version))
       (equal statistics '(1 24 12 4 4 4)) (equal queries (expected-queries))))
(defun token (frontiers statistics queries)
  (+ (first frontiers) (second frontiers) (fourth frontiers) (reduce #'+ statistics)
     (loop for row in queries when (second row) sum (1+ (logand (third row) #xffffffff)))))
(defun expected-token (version)
  (token (list +size+ +size+ :complete version) '(1 24 12 4 4 4) (expected-queries)))
(defun specs ()
  (let ((key (av "AV-BYTES" 1 7)) (value (av "AV-BYTES" 1 9)))
    (append (loop repeat 8 collect (list :put 17 nil key value))
            (loop for id in *local* collect (list :put id t key value))
            (loop for id in *local* for csn in *csns* collect (list :outcome id csn))
            (loop for id in (append *derived* *aborted*) collect (list :put id t key value)))))
(defun with-fixtures (count version thunk &optional fixtures)
  ;; Nesting mantiene gli unwind-protect AV fino al ritorno dopo quiescenza.
  (if (zerop count) (funcall thunk (reverse fixtures))
      (let* ((source (av "AV-LOG" (list (specs)) :version version))
             (other (funcall (api "ARCDOCDB.RECOVERY.TESTS" "PARTICIPANT-ID") 1))
             (decisions (loop for id in *derived* for csn in *csns*
                              collect (list id csn (list (av "AV-IDENTITY") other)))))
        (unless (= +size+ (length source)) (reject :fixture-size))
        (av "AV-WITH-FIXTURE" source
            (lambda (fixture) (with-fixtures (1- count) version thunk (cons fixture fixtures)))
            :version version :decision-specs decisions))))
(defun recovery (fixture version)
  (av "AV-CLEAR" fixture)
  (let* ((result (av "AV-CALL" fixture :chunk-bytes 4096 :max-bytes 4096 :max-batches 1
                     :max-batch-records 24 :max-batch-bytes 4096 :max-records 24
                     :max-prepared 12 :max-outcomes 4))
         (frontiers (multiple-value-list (public "FRONTIERE-ACTIVE-RECUPERATO" result)))
         (statistics (multiple-value-list (public "STATISTICHE-ACTIVE-RECUPERATO" result)))
         (queries (loop for row in (expected-queries) collect
                    (cons (first row) (multiple-value-list (public "ESITO-CHIUSURA-ACTIVE" result (first row)))))))
    (unless (oracle-p frontiers statistics queries version) (reject :oracle))
    (av "AV-NOEFFECTS" fixture)
    (unless (= 2 (av "AV-FIXTURE-READS" fixture)) (reject :read-count))
    (token frontiers statistics queries)))

(defstruct raw (warmup 0) (attempted 0) (completed 0) (sink 0))
(defstruct channel (lock (sb-thread:make-mutex)) first failure)
(defun publish-condition (channel condition)
  (sb-thread:with-mutex ((channel-lock channel))
    (unless (channel-first channel) (setf (channel-first channel) condition))
    (unless (or (typep condition 'deadline) (channel-failure channel))
      (setf (channel-failure channel) condition))))
(defun condition-data (c)
  (when c (let ((text (princ-to-string c)))
            (list :type (princ-to-string (type-of c)) :message (subseq text 0 (min 512 (length text)))))))
(defun channel-data (channel)
  ;; Solo condizioni comunicate esplicitamente: mai RAW di worker ancora vivi.
  (sb-thread:with-mutex ((channel-lock channel))
    (values (cond ((channel-failure channel) :error) ((channel-first channel) :deadline))
            (condition-data (or (channel-failure channel) (channel-first channel)))
            (condition-data (channel-first channel)))))
(defun worker (fixture version raw ready go stop limit channel)
  (handler-case
      (progn
        (dotimes (i +iterations+)
          (require-time limit)
          (when (sb-thread:try-semaphore stop) (error 'deadline :reason :cooperative-stop))
          (incf (raw-attempted raw))
          (let ((value (recovery fixture version)))
            (incf (raw-completed raw)) (incf (raw-sink raw) value))
          (when (zerop i)
            (sb-thread:signal-semaphore ready)
            (unless (sb-thread:wait-on-semaphore go :timeout (remaining limit))
              (error 'deadline :reason :verified-gate))))
        (require-time limit))
    (error (c) (publish-condition channel c)))
  :done)
(defun raw-data (r id)
  (list :id id :warmup (raw-warmup r) :attempted (raw-attempted r)
        :completed (raw-completed r) :sink (raw-sink r)))
(defun counts (records)
  (let ((n (loop for r in records sum (getf r :completed))))
    (list :verified-recoveries n :records (* 24 n) :closure-queries (* 13 n))))
(defun window-status (quiet kind records version workers)
  (cond ((eq kind :error) :failed) ((not quiet) :incomplete)
        ((not (and (= workers (length records))
                   (loop for r in records for id from 0 always
                     (and (eql id (getf r :id)) (eql +warmup+ (getf r :warmup))
                          (integerp (getf r :completed)) (integerp (getf r :attempted))
                          (<= 0 (getf r :completed) (getf r :attempted) +iterations+)
                          (<= (- (getf r :attempted) (getf r :completed)) 1)
                          (eql (* (getf r :completed) (expected-token version)) (getf r :sink)))))) :failed)
        ((or kind (some (lambda (r) (/= +iterations+ (getf r :completed))) records)) :incomplete)
        (t :ok)))
(defun observe (fixtures raws version workers)
  (let* ((start (get-internal-real-time)) (heap (sb-ext:get-bytes-consed))
         (limit (+ start (* +window-seconds+ internal-time-units-per-second)))
         (join-limit (+ limit (* +join-seconds+ internal-time-units-per-second)))
         (ready (sb-thread:make-semaphore)) (go (sb-thread:make-semaphore))
         (stop (sb-thread:make-semaphore)) (channel (make-channel)) (threads nil) (joined 0))
    (handler-case
        (progn
          (loop for f in fixtures for r in raws do
            (let ((owned-f f) (owned-r r))
              (push (sb-thread:make-thread
                     (lambda () (worker owned-f version owned-r ready go stop limit channel))
                     :name "recovery-active-c4") threads)))
          (dotimes (i workers)
            (require-time limit)
            (unless (sb-thread:wait-on-semaphore ready :timeout (remaining limit))
              (error 'deadline :reason :first-verified-gate))))
      (error (c) (publish-condition channel c) (sb-thread:signal-semaphore stop workers)))
    (sb-thread:signal-semaphore go workers)
    ;; Un solo budget comune di join; nessuna terminate-thread, retry o raw vivo.
    (dolist (thread threads)
      (handler-case
          (if (eq :done (sb-thread:join-thread thread :timeout (remaining join-limit) :default :timeout))
              (incf joined) (error 'deadline :reason :join))
        (error (c) (publish-condition channel c) (sb-thread:signal-semaphore stop workers))))
    (let* ((wall (- (get-internal-real-time) start)) (bytes (- (sb-ext:get-bytes-consed) heap))
           (quiet (and (= joined (length threads)) (notany #'sb-thread:thread-alive-p threads)))
           (records (when quiet (loop for r in raws for id from 0 collect (raw-data r id)))))
      (multiple-value-bind (kind cause first) (channel-data channel)
        (list :quiescent quiet :status (window-status quiet kind records version workers)
              :error-kind kind :cause cause :first-condition first :workers records
              :counts (if quiet (counts records) :unavailable)
              :sink (if quiet (loop for r in records sum (getf r :sink)) :unavailable)
              :wall-ticks wall :bytes-consed bytes)))))

(defun loading-warning-action (asdf-p redefinition-p)
  (if (and asdf-p redefinition-p) :record :error))
(defun call-asdf (thunk)
  "Solo ridefinizioni ASDF registrate; ogni altro warning resta fatale."
  (let ((count 0) (messages nil))
    (handler-bind
        ((warning (lambda (c)
                    (if (eq :record (loading-warning-action t (typep c 'sb-kernel:redefinition-warning)))
                        (progn (incf count)
                               (when (< (length messages) 16) (push (condition-data c) messages))
                               (format *error-output* "~&ASDF-REDEFINITION ~A~%" c)
                               (muffle-warning c))
                        (reject (list :bootstrap-warning (condition-data c)))))))
      (funcall thunk))
    (list :count count :messages (nreverse messages) :message-limit 16)))
(defun load-product (root out)
  (require :asdf)
  (let ((*default-pathname-defaults* root) (*compile-verbose* nil) (*compile-print* nil)
        (*load-verbose* nil) (*load-print* nil) (*standard-output* *error-output*))
    (funcall (api "ASDF" "INITIALIZE-OUTPUT-TRANSLATIONS")
             (list :output-translations (list t (namestring (merge-pathnames "fasl/" out)))
                   :ignore-inherited-configuration))
    ;; Un solo LOAD-ASD/LOAD-SYSTEM; registra i test senza TEST-OP o RUN.
    (call-asdf
     (lambda ()
       (progv (list (find-symbol "*COMPILE-FILE-WARNINGS-BEHAVIOUR*" "ASDF")
                    (find-symbol "*COMPILE-FILE-FAILURE-BEHAVIOUR*" "ASDF")) '(:error :error)
         (funcall (api "ASDF" "LOAD-ASD") (merge-pathnames "arcdocdb.asd" root))
         (funcall (api "ASDF" "LOAD-SYSTEM") "arcdocdb/tests" :verbose nil))))))
(defun acquire-output (root requested)
  (require :sb-posix)
  (let ((out (merge-pathnames requested root)))
    (ensure-directories-exist (merge-pathnames "spikes/out/placeholder" root))
    (funcall (api "SB-POSIX" "MKDIR") (namestring out) #o700) ; EEXIST fatale.
    out))
(defun save-report (report out)
  (let ((*print-readably* t) (*print-pretty* nil) (*print-length* nil) (*print-level* nil)
        (tmp (merge-pathnames "report.tmp" out)) (path (merge-pathnames "report.lisp" out)))
    (with-open-file (s tmp :direction :output :if-exists :supersede :external-format :utf-8)
      (write report :stream s) (terpri s))
    (funcall (api "SB-POSIX" "RENAME") (namestring tmp) (namestring path))))
(defun bench (root requested)
  (let* ((out (acquire-output root requested))
         (report (list :schema-version 1 :kind :recovery-active-benchmark :status :incomplete
                       :parameters (list :iterations-per-worker +iterations+ :warmup +warmup+
                                         :matrix (matrix) :bytes +size+ :records 24 :batches 1
                                         :ordinary 8 :local 4 :outcomes 4 :derived 4 :aborted 4
                                         :window-seconds +window-seconds+ :join-seconds +join-seconds+)
                       :clock (list :wall :get-internal-real-time :units-per-second internal-time-units-per-second)
                       :heap :sbcl-get-bytes-consed-whole-process-window :worker-cpu :unavailable
                       :source-evidence :outer-recorder-and-capture-wrapper
                       :limits '(:in-memory :recovery-with-allocations :oracle-and-instrumentation-included
                                 :setup-and-warmup-excluded :not-db-throughput :not-disk-cold
                                 :not-zero-heap :not-conclusive-scaling :not-p99 :cooperative-deadlines)
                       :windows nil :cause nil)))
    (save-report report out)
    (handler-case
        (progn
          (setf (getf report :bootstrap-redefinitions) (load-product root out))
          (dolist (case (matrix))
            (destructuring-bind (version workers replica) case
              (declare (ignore replica))
              (with-fixtures workers version
                (lambda (fixtures)
                  (let ((raws (loop repeat workers collect (make-raw))))
                    (loop for f in fixtures for r in raws do
                      (dotimes (i +warmup+) (recovery f version) (incf (raw-warmup r))))
                    (let ((w (append (list :case case) (observe fixtures raws version workers))))
                      (setf (getf report :windows) (append (getf report :windows) (list w))
                            (getf report :status) (getf w :status) (getf report :cause) (getf w :cause))
                      (save-report report out)
                      (unless (getf w :quiescent)
                        ;; EXIT :ABORT non svolge AV-WITH-FIXTURE: niente cleanup con worker vivi.
                        (sb-ext:exit :code (if (eq :failed (getf w :status)) 1 2) :abort t))
                      (unless (eq :ok (getf w :status)) (return-from bench report))))))))
          (setf (getf report :status) :ok))
      (error (c)
        (setf (getf report :status) :failed)
        (unless (getf report :cause) (setf (getf report :cause) (condition-data c)))))
    (save-report report out)
    report))

;;; Solo helper puri: nessun ASDF, prodotto, fixture, thread, file o misura.
(defun self-test ()
  (let ((checks 0))
    (flet ((check (value) (unless value (reject :self-test)) (incf checks)))
      (check (= 18 (length (remove-duplicates (matrix) :test #'equal))))
      (check (= 8400 (loop for (v n r) in (matrix) sum (* n +iterations+))))
      (check (= +size+ (+ 64 (* 20 26) (* 4 32) 56)))
      (check (= 24 (+ 8 4 4 4 4)))
      (check (= 12 (+ 4 4 4)))
      (check (= 13 (length (expected-queries))))
      (dolist (pair '((nil nil) (nil t) (t nil) (t t)))
        (check (eq (if (equal pair '(t t)) :record :error) (apply #'loading-warning-action pair))))
      (dolist (condition (list (make-condition 'simple-warning :format-control "fixture" :format-arguments nil)
                               (make-condition 'style-warning)))
        (check (handler-case (progn (call-asdf (lambda () (warn condition))) nil)
                 (bench-failure () t))))
      (dolist (v '(1 2))
        (let ((f (list +size+ +size+ :complete v)) (s '(1 24 12 4 4 4)) (q (expected-queries)))
          (check (oracle-p f s q v)) (check (= (+ 4294968891 v) (expected-token v)))
          (dolist (bad (list (list 767 +size+ :complete v) (list +size+ 767 :complete v)
                            (list +size+ +size+ :tail v) (list +size+ +size+ :complete (- 3 v))))
            (check (not (oracle-p bad s q v))))
          (check (not (oracle-p f '(1 24 12 5 3 4) q v)))
          (let ((bad (copy-tree q))) (setf (second (first bad)) nil)
            (check (not (oracle-p f s bad v))))
          (let ((bad (copy-tree q))) (setf (third (fourth bad)) 0)
            (check (not (oracle-p f s bad v))))))
      (dolist (case (matrix))
        (destructuring-bind (v n replica) case
          (declare (ignore replica))
          (let ((rows (loop for id below n collect (list :id id :warmup 8 :attempted 200
                              :completed 200 :sink (* 200 (expected-token v))))))
            (check (eq :ok (window-status t nil rows v n)))
            (check (= (* n 200 24) (getf (counts rows) :records)))
            (check (eq :failed (window-status nil :error nil v n)))
            (check (eq :incomplete (window-status nil :deadline nil v n)))
            (incf (getf (first rows) :sink)) (check (eq :failed (window-status t nil rows v n))))))
      (check (eq :self-test (arguments '("--self-test"))))
      (check (eq :bench (arguments '("--bench" "--output" "spikes/out/active-verifica-bench-X/"))))
      (dolist (args '(("--bench") ("--self-test" "x") ("--bench" "--output" "/tmp/x/")
                      ("--bench" "--output" "spikes/out/active-verifica-bench-/")
                      ("--bench" "--output" "spikes/out/active-verifica-bench-X/../Y/")
                      ("--bench" "--output" "spikes/out/active-verifica-bench-X//")))
        (check (handler-case (progn (arguments args) nil) (bench-failure () t)))))
    (list :schema-version 1 :kind :recovery-active-benchmark-self-test :status :ok :checks checks)))
(defun main (script)
  (handler-case
      (handler-bind ((warning (lambda (c) (error "COD-60: warning: ~A" c))))
        (multiple-value-bind (mode output) (arguments (cdr sb-ext:*posix-argv*))
          (let ((report (ecase mode (:self-test (self-test))
                          (:bench (bench (truename (merge-pathnames "../" (make-pathname :name nil :type nil :defaults script))) output)))))
            (format t "~S~%" report)
            (case (getf report :status) (:ok 0) (:incomplete 2) (otherwise 1)))))
    (error (c) (format *error-output* "~&~A~%" c) 1)))
(sb-ext:exit :code (main (or *load-truename* *compile-file-truename*)))
