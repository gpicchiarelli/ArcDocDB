;;;; C4: rinomina I/O, baseline + quattro mutanti; solo il parent esegue dopo freeze.
;;;; Uso: --self-test|--check spikes/out/<namespace-nuovo>/; nessun TEST-OP ASDF.
;;;; Copie raw/isolatedtests escluse dal collector; raw/evidence conserva driver/config/patch/log/report.
;;; OWNER: parent C4 possiede copie, child e report; ogni child seriale possiede fixture e FI.
;;;; Deadline parent cooperativo: digest canonici/finalizzazione possono bloccare;
;;;; controllo prima/dopo ogni digest e prima della promozione finale a :OK, non hard-timeout.
;;; REQ: REQ-REC-001 REQ-AFF-001 REQ-AFF-004 REQ-AFF-008 REQ-VAL-001
(require :asdf)
(require :sb-posix)
(defpackage #:arcdocdb.io.rename.mutation (:use #:cl))
(in-package #:arcdocdb.io.rename.mutation)
(declaim (optimize (safety 3) (debug 2)))
(defconstant +child-seconds+ 120)
(defconstant +campaign-seconds+ 900)
(defconstant +cleanup-seconds+ 2)
(defconstant +record-limit+ 2097152)
(defconstant +file-limit+ 16777216)
(defconstant +inventory-limit+ 4096)
;;; OWNER: driver C4 nel proprio processo; profilo fissato prima di main/child-main.
;;; Il wrapper carica questo engine con --library e ripristina poi gli argv effettivi.
(defparameter *profile* :io-rename)
(defparameter *campaign-kind* :io-rename-mutations)
(defparameter *campaign-config-kind* :io-rename-mutation-campaign-config)
(defparameter *config-kind* :io-rename-mutation-config)
(defparameter *child-kind* :io-rename-mutation-child)
(defparameter *mutant-files* '("src/io/rename.lisp"))
(defparameter *backend-test-files* '("tests/io/rename.lisp"))
(defparameter *expected-test-count* nil)
(defparameter *driver-source* "tools/io-rename-mutation.lisp")
(defparameter *engine-source* "tools/io-rename-mutation.lisp")
(defparameter *evidence-source* "tools/evidence-storage.lisp")
(load *evidence-source*)
(defparameter *profile-self-test* nil)
(defparameter *profile-static-risks*
  '(:only-four-rename-mutants :shared-rename-core-also-used-by-namespace
    :rename-tests-required :native-fixture-io))
(defparameter *test-suites*
  '(("ARCDOCDB.IO.TESTS" "*TESTS*" "tests/io/rename.lisp" "IO-RENAME-")
    ("ARCDOCDB.IO.TESTS" "*TESTS*" "tests/io/rename-native.lisp" "IO-RENAME-")))
(defparameter *mutants*
  (list
   (list :name "accept-same-name" :file "src/io/rename.lisp"
         :test '("ARCDOCDB.IO.TESTS" "TEST-REQ-REC-001-IO-RENAME-SAME-NAME-SAME-STRING")
         :before "(when (string= source destination)
    (error 'invalid-argument :reason :io-rename-same-name))"
         :after "(progn nil)"
         :expected-failure :same-name-admitted)
   (list :name "allow-slash-name" :file "src/io/rename.lisp"
         :test '("ARCDOCDB.IO.TESTS" "TEST-REQ-REC-001-IO-RENAME-SLASH-NAME")
         :before "(and (<= 1 code 127) (char/= character #\\/))" :after "(<= 1 code 127)"
         :expected-failure :slash-name-admitted)
   (list :name "accept-nonzero-callback-result" :file "src/io/rename.lisp"
         :test '("ARCDOCDB.IO.TESTS" "TEST-REQ-AFF-001-IO-RENAME-NIL-RESULT-FAULTS")
         :before "(unless (eql result 0) (fallisci-rinomina directory :io-rename-result))"
         ;; Conserva l'uso di RESULT e tutti i tipi dichiarati anche senza il controllo.
         :after "(when (eql result 0) nil)"
         :expected-failure :invalid-callback-result-admitted)
   (list :name "omit-incomplete-exit-cleanup" :file "src/io/rename.lisp"
         ;; Primo test backend che osserva lo stato dopo una condizione catturata;
         ;; l'asserzione sul FAULTED precede i successivi casi nativi/nonlocali.
         :test '("ARCDOCDB.IO.TESTS" "TEST-REQ-AFF-004-IO-RENAME-ORIGINAL-TYPED-CONDITION-PRESERVED")
         :before "(when (and (not complete) (eq (file-state directory) :open))
          (setf (file-state directory) :faulted))"
         ;; WHEN completo nel core RINOMINA-CON-NOMI-PRIVATI, dentro WITHOUT-INTERRUPTS.
         ;; Il core serve anche SOSTITUISCI-TEMPORANEO; il target resta un'assertion backend IO-RENAME.
         :after "(progn complete nil)"
         :expected-failure :incomplete-exit-remains-open)))
;;; OWNER: main, deadline immutabile per invocazione; nessun child condivide questo binding.
(defvar *deadline* nil)
(define-condition invalid-campaign (error)
  ((detail :initarg :detail :reader campaign-detail))
  (:report (lambda (condition stream)
             (format stream "~A COD-61: ~A" *driver-source* (campaign-detail condition)))))
(define-condition synthetic-fixture-timeout (simple-error) ())
(define-condition synthetic-io-fault (simple-error) ())
(define-condition campaign-warning (error)
  ((original :initarg :original :reader warning-original))
  (:report (lambda (condition stream)
             (format stream "Warning ~S durante compile/load/test: ~A"
                     (type-of (warning-original condition)) (warning-original condition)))))
(defun abort-warning (condition)
  ;; ERROR della WARNING stessa può rientrare nell'handler; usa una condizione ERROR distinta.
  (if (typep condition 'sb-kernel:redefinition-warning)
      ;; Stessa eccezione di tools/build.lisp: replay ASDF/compile-time delle definizioni.
      (format *error-output* "~&ASDF-REDEFINITION ~S: ~A~%" (type-of condition) condition)
      (error 'campaign-warning :original condition)))
(defun reject (control &rest arguments)
  (error 'invalid-campaign :detail (apply #'format nil control arguments)))
(defun remaining ()
  (if *deadline* (/ (max 0 (- *deadline* (get-internal-real-time)))
                    (float internal-time-units-per-second 1d0)) +campaign-seconds+))
(defun require-time () (unless (plusp (remaining)) (reject "campaign timeout.")))
(defun file-identity (path)
  "Leaf regolare, senza symlink, limitato prima/dopo il lettore SHA canonico."
  (let ((stat (sb-posix:lstat (namestring (pathname path)))))
    (unless (and (sb-posix:s-isreg (sb-posix:stat-mode stat))
                 (<= 0 (sb-posix:stat-size stat) +file-limit+))
      (reject "nonregular/oversized file: ~A." path))
    (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat) (sb-posix:stat-mode stat)
          (sb-posix:stat-size stat) (sb-posix:stat-mtime stat) (sb-posix:stat-ctime stat))))
(defun sha256 (path)
  (require-time)
  (let* ((before (file-identity path)) (hash (arcdocdb.evidence:file-sha256 path)))
    (unless (and (equal before (file-identity path))
                 (stringp hash) (= 64 (length hash)) (string= hash (string-downcase hash))
                 (every (lambda (c) (or (char<= #\0 c #\9) (char<= #\a c #\f))) hash))
      (reject "canonical SHA256 shape/source drift: ~A." path))
    (require-time)
    hash))
(defun source-helpers ()
  (remove-duplicates (list *driver-source* *engine-source* *evidence-source*) :test #'string=))
(defun helper-specs ()
  "Ruoli espliciti: anche quando driver ed engine coincidono, le due copie raw restano attestate."
  (list (list :role :driver :file *driver-source* :raw "driver.lisp")
        (list :role :engine :file *engine-source* :raw "engine.lisp")
        (list :role :evidence :file *evidence-source* :raw "evidence-storage.lisp")))
(defun capture-helpers (root evidence)
  (loop for spec in (helper-specs)
        for source = (merge-pathnames (getf spec :file) root)
        for destination = (merge-pathnames (getf spec :raw) evidence)
        for before = (sha256 source)
        do (ensure-directories-exist destination)
           (uiop:copy-file source destination)
           (unless (and (string= before (sha256 source)) (string= before (sha256 destination)))
             (reject "helper drift while capturing ~A." source))
        collect (append spec (list :sha256 before))))
(defun verify-helpers (entries root evidence)
  "Confronta ruolo/path, SHA preregistrato, fonte nella copia e bytes raw; nessun LOAD dei dati."
  (and (= (length entries) (length (helper-specs)))
       (loop for entry in entries for spec in (helper-specs)
             always (and (eq (getf entry :role) (getf spec :role))
                         (equal (getf entry :file) (getf spec :file))
                         (equal (getf entry :raw) (getf spec :raw))
                         (stringp (getf entry :sha256))
                         (string= (getf entry :sha256) (sha256 (merge-pathnames (getf spec :file) root)))
                         (string= (getf entry :sha256) (sha256 (merge-pathnames (getf spec :raw) evidence)))))))
(defun inventory ()
  (append '("arcdocdb.asd") (sort (mapcar #'enough-namestring (directory "src/**/*.lisp")) #'string<)
          (sort (mapcar #'enough-namestring (directory "tests/**/*.lisp")) #'string<)
          (source-helpers)))
(defun manifest-entry (file root)
  (require-time)
  (let ((path (merge-pathnames file root)))
    (unless (uiop:subpathp (truename path) (truename root))
      (reject "manifest outside root: ~A." file))
    (list :file file :sha256 (sha256 path))))
(defun manifest (files root)
  "Quattro worker C4 al massimo, lettore SHA canonico per file; risultato in ordine argv.
4096 file/16 MiB ciascuno; ogni worker possiede FD/processo digest, deadline cooperativa."
  (unless (and (<= (length files) +inventory-limit+)
               (= (length files) (length (remove-duplicates files :test #'string=))))
    (reject "manifest too large or duplicate paths."))
  (when (null files) (return-from manifest nil))
  (let* ((input (coerce files 'vector)) (output (make-array (length files) :initial-element nil))
         (next 0) (failure nil) (mutex (sb-thread:make-mutex :name "canonical digest queue"))
         (deadline *deadline*) (threads nil) (complete nil))
    (labels ((worker ()
               (let ((*deadline* deadline))
                 (handler-case
                     (loop repeat (length input)
                           for index = (sb-thread:with-mutex (mutex)
                                         (when (and (not failure) (< next (length input)))
                                           (prog1 next (incf next))))
                           while index do (setf (aref output index) (manifest-entry (aref input index) root)))
                   (error (condition) (sb-thread:with-mutex (mutex) (unless failure (setf failure condition))))))))
      (unwind-protect
           (progn
             (dotimes (i (min 4 (length input)))
               (push (sb-thread:make-thread #'worker :name "canonical SHA256 worker") threads))
             (dolist (thread threads)
               (let ((joined (sb-thread:join-thread thread :timeout (remaining) :default :timeout)))
                 (when (eq :timeout joined) (reject "canonical digest worker timeout."))))
             (when failure (error failure))
             (unless (every #'identity output) (reject "canonical digest inventory incomplete."))
             (require-time) (setf complete t) (coerce output 'list))
        (unless complete
          (dolist (thread threads)
            (when (sb-thread:thread-alive-p thread) (sb-thread:terminate-thread thread)))
          (dolist (thread threads)
            (sb-thread:join-thread thread :timeout +cleanup-seconds+ :default :timeout))
          (when (some #'sb-thread:thread-alive-p threads)
            (reject "canonical digest worker unreaped; process exit required.")))))))
(defun unique-position (text anchor)
  (when (zerop (length anchor)) (reject "empty anchor."))
  (let ((position (search anchor text)))
    (unless position (reject "missing anchor ~S." anchor))
    (when (search anchor text :start2 (1+ position)) (reject "ambiguous anchor ~S." anchor))
    position))
(defun substitute-unique (text before after)
  (let ((position (unique-position text before)))
    (concatenate 'string (subseq text 0 position) after (subseq text (+ position (length before))))))
(defun write-text (text path)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :error :external-format :utf-8)
    (write-string text out)))
(defun write-record (record path)
  (ensure-directories-exist path)
  (with-open-file (out path :direction :output :if-exists :supersede :external-format :utf-8)
    (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil))
      (write record :stream out :pretty t) (terpri out))))
(defun save-report (record directory)
  (when directory
    (let ((temporary (merge-pathnames "report.tmp" directory)) (final (merge-pathnames "report.lisp" directory)))
      (write-record record temporary) (sb-posix:rename (namestring temporary) (namestring final)))))
(defun namespace-leaf (path)
  "Preflight puro: una sola foglia ASCII dentro spikes/out/, senza creare antenati."
  (unless (and (stringp path) (<= 13 (length path) 108)
               (uiop:string-prefix-p "spikes/out/" path)
               (char= #\/ (char path (1- (length path)))))
    (reject "output requires spikes/out/<single-slug>/ before filesystem effects."))
  (let ((leaf (subseq path 11 (1- (length path)))))
    (unless (every (lambda (character)
                    (or (find character "-_" :test #'char=)
                        (<= 48 (char-code character) 57)
                        (<= 65 (char-code character) 90)
                        (<= 97 (char-code character) 122))) leaf)
      (reject "output slug must be ASCII alphanumeric, hyphen or underscore."))
    leaf))
(defun directory-physical-p (path)
  "LSTAT non segue il leaf: directory fisica o NIL per ENOENT, mai un symlink."
  (let ((stat (handler-case (sb-posix:lstat (string-right-trim "/" (namestring path)))
                (sb-posix:syscall-error (condition)
                  (unless (= sb-posix:enoent (sb-posix:syscall-errno condition)) (error condition))
                  nil))))
    (when stat
      (unless (and (sb-posix:s-isdir (sb-posix:stat-mode stat))
                   (equal path (truename path)))
        (reject "output ancestor is not a physical directory: ~A" path))
      t)))
(defun exclusive-directory (path)
  (let* ((leaf (namespace-leaf path)) (root (truename "./"))
         (spikes (merge-pathnames "spikes/" root))
         (parent (merge-pathnames "spikes/out/" root))
         (directory (merge-pathnames (concatenate 'string leaf "/") parent)))
    (unless (directory-physical-p spikes) (reject "tracked spikes directory absent."))
    (unless (directory-physical-p parent) (sb-posix:mkdir (namestring parent) #o700))
    (unless (directory-physical-p parent) (reject "output parent changed."))
    (sb-posix:mkdir (namestring directory) #o700)
    (truename directory)))
(defun exclusive-owned-child (directory prefix name)
  "Solo una root già posseduta dal parent, due antenati letterali e una foglia validata."
  (namespace-leaf (concatenate 'string "spikes/out/" name "/"))
  (unless (and (member prefix '("raw/evidence/" "raw/isolatedtests/") :test #'string=)
               (directory-physical-p directory)
               (uiop:subpathp directory (merge-pathnames "spikes/out/" (truename "./"))))
    (reject "internal output root/prefix invalid before filesystem effects."))
  (let ((parent directory))
    (dolist (component (remove "" (uiop:split-string prefix :separator '(#\/)) :test #'string=))
      (setf parent (merge-pathnames (concatenate 'string component "/") parent))
      (unless (directory-physical-p parent) (sb-posix:mkdir (namestring parent) #o700))
      (unless (directory-physical-p parent) (reject "internal output ancestor changed.")))
    (let ((child (merge-pathnames (concatenate 'string name "/") parent)))
      (sb-posix:mkdir (namestring child) #o700)
      (truename child))))
(defun read-record (path)
  "Reader evidence esistente, bounded e non valutante; nessun parser nuovo."
  (arcdocdb.evidence:read-evidence path :max-expanded-bytes +record-limit+))
(defun expected-tests ()
  "Nomi letterali dai soli file del profilo; preregistrazione senza caricare il prodotto."
  (let ((tests nil) (backend-tests nil))
    (dolist (suite *test-suites*)
      (destructuring-bind (package registry file marker) suite
        (declare (ignore registry))
        (let ((names (loop for raw in (uiop:split-string (uiop:read-file-string file :external-format :utf-8)
                                                        :separator '(#\Newline))
                           for line = (string-left-trim '(#\Space #\Tab) raw)
                           when (and (>= (length line) 9) (string-equal "(deftest " line :end2 9))
                           collect (string-upcase (first (remove "" (uiop:split-string (subseq line 9)
                                                            :separator '(#\Space #\Tab #\( #\))) :test #'string=))))))
          (setf names (remove-if-not
                       (lambda (name)
                         (search marker name))
                       names))
          (unless names (reject "profile suite absent: ~A." file))
          (when (member file *backend-test-files* :test #'string=)
            (setf backend-tests (append backend-tests (mapcar (lambda (name) (list package name)) names))))
          (setf tests (append tests (mapcar (lambda (name) (list package name)) names))))))
    (unless (= (length tests) (length (remove-duplicates tests :test #'equal)))
      (reject "duplicate profile test names."))
    (when (and *expected-test-count* (/= *expected-test-count* (length tests)))
      (reject "profile test count differs from ~D." *expected-test-count*))
    (unless (and (= 4 (length *mutants*))
                 (= 4 (length (remove-duplicates (mapcar (lambda (m) (getf m :test)) *mutants*) :test #'equal)))
                 (every (lambda (m) (and (member (getf m :test) tests :test #'equal)
                                         (member (getf m :test) backend-tests :test #'equal))) *mutants*))
      (reject "all four distinct backend targets must be preregistered."))
    tests))
(defun condition-is-p (condition package name)
  (let* ((pkg (find-package package)) (symbol (and pkg (find-symbol name pkg))))
    (and symbol (find-class symbol nil) (typep condition symbol))))
(defun semantic-kind (condition)
  (cond
    ((or (typep condition 'sb-ext:timeout)
         (condition-is-p condition "ARCDOCDB.IO.TESTS" "RENAME-FIXTURE-TIMEOUT")
         (typep condition 'type-error) (typep condition 'warning)
         (condition-is-p condition "ARCDOCDB.CONDITIONS" "IO-FAULT")
         (condition-is-p condition "SB-POSIX" "SYSCALL-ERROR")) :infrastructure)
    ((and (typep condition 'simple-error)
          (stringp (simple-condition-format-control condition))
          (uiop:string-prefix-p "Asserzione fallita:" (simple-condition-format-control condition))) :assertion)
    (t :infrastructure)))
(defun classify (child exit expected verified &key baseline timeout signal target-test reaped)
  "Kill soltanto in un test preregistrato, dopo build/suite attestate e child reaped."
  (let* ((passed (getf child :passed-tests))
         (completed (and (listp passed) (ignore-errors (list-length passed)))))
   (cond
    ((or timeout signal (not (eq t reaped))) :infrastructure-error)
    ((or (null child) (not (integerp exit))) :infrastructure-error)
    ((and (eq :failed (getf child :status)) (eq :compile (getf child :phase)) (not (zerop exit))) :compilation-error)
    ((or (eq :infrastructure (getf child :failure-kind))
         (and (eq :complete (getf child :phase)) (not (zerop exit)))) :infrastructure-error)
    ((not (and verified (eql 1 (getf child :schema-version)) (eq *child-kind* (getf child :kind))
               (equal expected (getf child :expected-tests)) (eq t (getf child :compiled))
               (equal expected (getf child :registered-tests))
               (eq t (getf child :suite-compiled)))) :invalid)
    ((and (= 0 exit) (eq :ok (getf child :status)) (eq :complete (getf child :phase))
          (equal expected (getf child :passed-tests)) (null (getf child :failed-test))
          (null (getf child :failure-kind))) (if baseline :baseline-passed :survived))
    ((and (= 1 exit) (eq :failed (getf child :status)) (eq :tests (getf child :phase))
          (eq :assertion (getf child :failure-kind))
          (integerp completed)
          (< completed (length expected))
          (equal passed (subseq expected 0 completed))
          (equal (getf child :failed-test) (nth completed expected))
          (or baseline (and target-test (equal target-test (getf child :failed-test)))))
     (if baseline :baseline-failed :detected))
    (t :invalid))))
(defun self-test (directory)
  "COD-60: dati sintetici, nessuna compilazione, child prodotto o fixture I/O del prodotto.
Le fixture digest/record sono locali; FILE-SHA256 conserva il proprio helper canonico."
  (unless (string= "io-rename-self-test-A" (namespace-leaf "spikes/out/io-rename-self-test-A/"))
    (reject "output slug valid case."))
  (dolist (invalid '("/tmp/invalid/new/" "spikes/out/../escape/" "spikes/out/nested/new/"
                    "spikes/out/" "spikes/out/slug" "spikes/out/./"))
    (let ((caught nil))
      (handler-case (namespace-leaf invalid) (invalid-campaign () (setf caught t)))
      (unless caught (reject "output namespace accepted: ~A" invalid))))
  (unless (directory-physical-p directory) (reject "owned self-test directory not physical."))
  (let ((link (merge-pathnames "parent-link" directory)) (caught nil))
    (unwind-protect
         (progn
           (sb-posix:symlink (namestring directory) (namestring link))
           (handler-case (directory-physical-p (uiop:ensure-directory-pathname link))
             (invalid-campaign () (setf caught t)))
           (unless caught (reject "output ancestor symlink accepted.")))
      (when (probe-file link) (sb-posix:unlink (namestring link)))))
  (let* ((tests '(("ARCDOCDB.IO.TESTS" "TEST-REQ-VAL-001-IO-RENAME-FIRST")
                  ("ARCDOCDB.IO.TESTS" "TEST-REQ-VAL-001-IO-RENAME-SECOND")))
         (target (first tests))
         (failed (list :schema-version 1 :kind *child-kind* :status :failed :phase :tests
                       :compiled t :suite-compiled t :expected-tests tests :passed-tests nil
                       :registered-tests tests
                       :failed-test (first tests) :failure-kind :assertion))
         (passed (copy-tree failed)) (checks 0))
    (setf (getf passed :status) :ok (getf passed :phase) :complete (getf passed :passed-tests) tests
          (getf passed :failed-test) nil (getf passed :failure-kind) nil)
    (flet ((check (record code desired &rest options)
             (incf checks)
             (unless (eq desired (apply #'classify record code tests t
                                        :reaped t :target-test target options))
               (reject "classifier self-test ~S." desired))))
      (check failed 1 :detected) (check failed 1 :baseline-failed :baseline t)
      (check passed 0 :survived) (check passed 0 :baseline-passed :baseline t)
      (check failed 1 :infrastructure-error :timeout t) (check failed 1 :infrastructure-error :signal 9)
      (unless (eq :infrastructure-error (classify failed 1 tests t :target-test target :reaped nil))
        (reject "unreaped child accepted."))
      (incf checks)
      (check nil 1 :infrastructure-error) (check failed 0 :invalid) (check failed 2 :invalid)
      (check failed nil :infrastructure-error) (check failed :crashed :infrastructure-error)
      (check passed 7 :infrastructure-error)
      (dolist (kind '(:assertion :product-condition :infrastructure))
        (let ((copy (copy-tree failed)))
          (setf (getf copy :failure-kind) kind)
          (check copy 1 (case kind (:assertion :detected) (:infrastructure :infrastructure-error) (t :invalid)))))
      (dolist (change '((:compiled nil) (:suite-compiled nil) (:schema-version 999) (:kind :other)
                       (:registered-tests nil) (:expected-tests ("OTHER")) (:failed-test "OTHER")
                       (:passed-tests ("OTHER")) (:status :running) (:phase :validate-suite)
                       (:failure-kind nil)))
        (let ((copy (copy-tree failed)))
          (setf (getf copy (first change)) (second change)) (check copy 1 :invalid)))
      (let ((copy (copy-tree failed)))
        (setf (getf copy :phase) :compile (getf copy :failure-kind) :infrastructure)
        (check copy 2 :compilation-error)
        (setf (getf copy :phase) :load)
        (check copy 2 :infrastructure-error)))
    (let ((copy (copy-tree failed)))
      (setf (getf copy :passed-tests) (list (first tests)) (getf copy :failed-test) (second tests))
      (unless (eq :detected (classify copy 1 tests t :reaped t :target-test (second tests)))
        (reject "correct prefix rejected."))
      (setf (getf copy :passed-tests) '("OTHER"))
      (unless (eq :invalid (classify copy 1 tests t :reaped t :target-test (second tests)))
        (reject "wrong prefix accepted."))
      (setf (getf copy :passed-tests) tests)
      (unless (eq :invalid (classify copy 1 tests t :reaped t :target-test (second tests)))
        (reject "completed prefix accepted as failure."))
      (incf checks 3))
    (dolist (options (list (list :target-test target :verified nil)
                          (list :target-test nil :verified t)
                          (list :target-test (list "OTHER" (second target)) :verified t)
                          (list :target-test (second tests) :verified t)))
      (unless (eq :invalid (classify failed 1 tests (getf options :verified) :reaped t
                                    :target-test (getf options :target-test)))
        (reject "unattested/missing/wrong exact target accepted."))
      (incf checks))
    (dolist (change (list (list :passed-tests (list (second tests)))
                         (list :passed-tests (list (first tests) (first tests)))
                         (list :passed-tests (cons (first tests) :dotted))
                         (list :failed-test (list "OTHER" (second target)))))
      (let ((copy (copy-tree failed)))
        (setf (getf copy (first change)) (second change))
        (unless (eq :invalid (classify copy 1 tests t :reaped t :target-test target))
          (reject "malformed/exact names accepted."))
        (incf checks)))
    (dolist (change '((:passed-tests nil) (:failed-test "OTHER") (:failure-kind :assertion)
                     (:registered-tests nil) (:phase :tests)))
      (let ((copy (copy-tree passed)))
        (setf (getf copy (first change)) (second change))
        (unless (eq :invalid (classify copy 0 tests t :reaped t :target-test target))
          (reject "incomplete success accepted."))
        (incf checks)))
    (let ((warning (make-condition 'simple-warning :format-control "Asserzione fallita: warning")))
      (unless (eq :infrastructure
                  (semantic-kind (handler-case (abort-warning warning) (campaign-warning (condition) condition))))
        (reject "warning wrapper accepted as assertion."))
      (incf checks))
    (unless (string= "xAy" (substitute-unique "xBy" "B" "A")) (reject "substitution self-test."))
    (unless (string= "xBy" (substitute-unique (substitute-unique "xBy" "B" "A") "A" "B"))
      (reject "anchor roundtrip."))
    (dolist (anchor '("" "Z" "x"))
      (let ((caught nil))
        (handler-case (unique-position "xx" anchor) (invalid-campaign () (setf caught t)))
        (unless caught (reject "anchor self-test."))))
    (let ((path (merge-pathnames "self-test-record.lisp" directory)))
      (write-record passed path)
      (unless (equal passed (read-record path)) (reject "record roundtrip."))
      (unless (eq :survived (classify (read-record path) 0 tests t :reaped t :target-test target))
        (reject "record classification."))
      (let ((before (sha256 path)))
        (write-record '(:schema-version 999 :kind :other :status :ok) path)
        (unless (and (not (string= before (sha256 path)))
                     (eq :invalid (classify (read-record path) 0 tests t :reaped t :target-test target)))
          (reject "write/schema/SHA detection."))))
    (when (or (find-package "ARCDOCDB.IO.TESTS") (find-package "ARCDOCDB.CONDITIONS"))
      (reject "self-test requires unloaded product."))
    (let* ((package (make-package "ARCDOCDB.IO.TESTS" :use nil))
           (conditions (make-package "ARCDOCDB.CONDITIONS" :use nil))
           (symbol (intern "RENAME-FIXTURE-TIMEOUT" package))
           (io-symbol (intern "IO-FAULT" conditions)))
      (unwind-protect
           (progn
             (setf (find-class symbol) (find-class 'synthetic-fixture-timeout))
             (setf (find-class io-symbol) (find-class 'synthetic-io-fault))
             ;; Simbolo timeout intenzionalmente interno; messaggi con prefisso assertion
             ;; non possono scavalcare il tipo infrastruttura.
             (unless (eq :internal (nth-value 1 (find-symbol "RENAME-FIXTURE-TIMEOUT" package)))
               (reject "synthetic timeout must be internal."))
             (dolist (condition (list (make-condition 'synthetic-fixture-timeout
                                                      :format-control "Asserzione fallita: timeout")
                                     (make-condition 'synthetic-io-fault
                                                      :format-control "Asserzione fallita: io")
                                     (make-condition 'sb-ext:timeout)
                                     (make-condition 'sb-posix:syscall-error :errno sb-posix:eio :name 'synthetic)
                                     (make-condition 'type-error :datum nil :expected-type 'integer)
                                     (make-condition 'simple-warning :format-control "Asserzione fallita: warning")
                                     (make-condition 'simple-error :format-control "other failure")))
               (unless (eq :infrastructure (semantic-kind condition))
                 (reject "typed timeout/io/type/warning accepted as assertion."))
               (let ((copy (copy-tree failed)))
                 (setf (getf copy :failure-kind) (semantic-kind condition))
                 (unless (eq :infrastructure-error (classify copy 1 tests t :reaped t :target-test target))
                   (reject "infrastructure record accepted as kill.")))
               (incf checks))
             (unless (eq :assertion (semantic-kind (make-condition 'simple-error
                                                      :format-control "Asserzione fallita: ~S"
                                                      :format-arguments '(nil))))
               (reject "simple assertion rejected."))
             (incf checks))
        (setf (find-class symbol) nil)
        (setf (find-class io-symbol) nil)
        (delete-package package) (delete-package conditions)))
    (let* ((paths '("SHA empty.txt" "SHA abc.txt" "SHA binary.txt"))
           (root (truename directory)))
      (write-text "" (merge-pathnames (first paths) root))
      (write-text "abc" (merge-pathnames (second paths) root))
      (with-open-file (out (merge-pathnames (third paths) root) :direction :output :if-exists :error
                                                          :element-type '(unsigned-byte 8))
        (dotimes (i 256) (write-byte i out)))
      (let ((hashes (manifest paths root))
            (known '("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
                     "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
                     "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880")))
        (unless (equal hashes (loop for file in paths for hash in known
                                   collect (list :file file :sha256 hash)))
          (reject "canonical digest fixtures differ from known SHA256."))))
    (append (list :status :ok :classifier-cases checks :anchor-negative-cases 3 :anchor-roundtrip t :record-roundtrip t
                  :typed-fixture-timeout-detection t :canonical-sha256-fixtures 3
                  :write-schema-sha-detection t :no-compilation t :no-product-child t)
            (when *profile-self-test*
              (list :profile *profile* :profile-checks (funcall *profile-self-test* directory))))))
(defun loaded-source-files (root config)
  "Solo componenti Lisp dei due sistemi effettivamente caricati; massimo 4096 nodi/12 livelli."
  (let ((files nil) (nodes 0))
    (labels ((walk (component depth)
               (unless (and (<= depth 12) (<= (incf nodes) +inventory-limit+)) (reject "ASDF graph budget."))
               (cond
                 ((typep component 'asdf:cl-source-file)
                  (let* ((path (truename (asdf:component-pathname component)))
                         (file (enough-namestring path root)))
                    (unless (and (uiop:subpathp path root) (member file (getf config :files) :test #'string=))
                      (reject "compiled source outside frozen inventory."))
                    (pushnew file files :test #'string=)))
                 ((typep component 'asdf:module)
                  (dolist (child (asdf:component-children component)) (walk child (1+ depth))))
                 (t (reject "unexpected ASDF component.")))))
      (walk (asdf:find-system "arcdocdb") 0)
      (walk (asdf:find-system "arcdocdb/tests") 0))
    (sort files #'string<)))
(defun compiled-entry (file fasl root hashes)
  (unless (and fasl (probe-file fasl) (uiop:subpathp (truename fasl) (merge-pathnames "fasl/" root)))
    (reject "nonprivate/missing FASL: ~A." file))
  (list :file file :source-sha256 (getf (find file hashes :key (lambda (e) (getf e :file)) :test #'string=) :sha256)
        :fasl (namestring (truename fasl))
        :fasl-sha256 (getf (find (enough-namestring fasl root) hashes :key (lambda (e) (getf e :file))
                               :test #'string=) :sha256)))
(defun compile-child (config record)
  "Fresh process/cache privata: src-only, poi definizioni ASDF tests; nessun TEST-OP o RUN."
  (let* ((root (truename "./")) (destination (merge-pathnames "fasl/" root)) (*standard-output* *error-output*))
    (asdf:initialize-source-registry `(:source-registry (:directory ,root) :ignore-inherited-configuration))
    (asdf:initialize-output-translations
     `(:output-translations (,(merge-pathnames "**/*.*" root) ,(merge-pathnames "**/*.*" destination))
       :ignore-inherited-configuration))
    (handler-bind ((warning #'abort-warning))
      ;; La source-registry privata carica l’ASD una volta; non ridefinire PERFORM sotto warning fatali.
      (asdf:load-system "arcdocdb" :force t)
      (setf (getf record :compiled) t)
      (asdf:load-system "arcdocdb/tests" :force t)
      (let* ((files (loaded-source-files root config))
             (fasls (mapcar (lambda (file) (asdf:apply-output-translations
                                            (make-pathname :type "fasl" :defaults (merge-pathnames file root)))) files))
             (hashes nil))
        (unless (equal files (getf config :compiled-source-files))
          (reject "loaded ASDF sources differ from parent selection."))
        (setf (getf record :loaded-source-files) files)
        (dolist (fasl fasls)
          (unless (and (probe-file fasl) (uiop:subpathp (truename fasl) destination))
            (reject "nonprivate/missing loaded FASL.")))
        (setf hashes (manifest (append files (mapcar (lambda (f) (enough-namestring f root)) fasls)) root))
        (loop for file in files for fasl in fasls
              do (push (compiled-entry file fasl root hashes) (getf record :compiled-files))))
      (setf (getf record :suite-compiled) t))))
(defun package-suites (package-name)
  (remove-if-not (lambda (suite) (string= package-name (first suite))) *test-suites*))
(defun package-markers (package-name)
  (remove-duplicates (mapcar #'fourth (package-suites package-name)) :test #'string=))
(defun registered-tests (expected)
  (unless (equal expected (expected-tests)) (reject "frozen test selection drift."))
  (dolist (package-name (remove-duplicates (mapcar #'first expected) :test #'string=))
    (let* ((package (find-package package-name))
           (suites (package-suites package-name))
           (markers (package-markers package-name))
           (registry (and package (find-symbol (second (first suites)) package)))
           (selected (remove-if-not (lambda (test) (string= package-name (first test))) expected)))
      (unless (= 1 (length (remove-duplicates (mapcar #'second suites) :test #'string=)))
        (reject "profile package must use one registry ~A." package-name))
      (unless (and registry (boundp registry)) (reject "suite registry absent ~A." package-name))
      (let ((registered (mapcar #'symbol-name (reverse (symbol-value registry)))))
        (unless (equal (mapcar #'second selected)
                       (remove-if-not (lambda (name) (some (lambda (marker) (search marker name)) markers)) registered))
          (reject "frozen registry mismatch ~A." package-name)))
      (dolist (test selected)
        (let ((symbol (find-symbol (second test) package)))
          (unless (and symbol (member symbol (symbol-value registry)) (fboundp symbol)) (reject "unregistered test ~S." test))))))
  expected)
(defun child-main (config-path)
  (let* ((config (read-record config-path)) (code 2)
         (*deadline* (+ (get-internal-real-time) (* +child-seconds+ internal-time-units-per-second)))
         (record (list :schema-version 1 :kind *child-kind* :profile *profile* :status :running :phase :setup
                       :compiled nil :suite-compiled nil :compiled-files nil :loaded-source-files nil
                       :expected-tests (getf config :expected-tests)
                       :registered-tests nil :passed-tests nil :failed-test nil :failure-kind nil :source-manifest nil
                       :config-sha256 nil :config-sha256-after nil :source-manifest-before nil
                       :diagnostic nil :condition-type nil :finished-at-universal-time nil)))
    (handler-case
        (handler-bind ((warning #'abort-warning))
          (unless (and (eql 1 (getf config :schema-version))
                       (eq *config-kind* (getf config :kind)) (eq *profile* (getf config :profile))
                       (equal *test-suites* (getf config :test-suites))
                       (equal *mutant-files* (getf config :mutant-files))
                       (equal *backend-test-files* (getf config :backend-test-files))
                       (eql *expected-test-count* (getf config :expected-test-count))
                       (equal (source-helpers) (getf config :source-helpers)))
            (reject "child config schema/selection mismatch."))
          (setf (getf record :config-sha256) (sha256 config-path))
          (setf (getf record :source-manifest-before) (manifest (getf config :files) (truename "./")))
          (unless (equal (getf config :manifest) (getf record :source-manifest-before))
            (reject "copy drift before compile."))
          (unless (verify-helpers (getf config :helper-manifest) (truename "./")
                                  (uiop:pathname-directory-pathname config-path))
            (reject "child helper source/raw SHA mismatch."))
          (setf (getf record :phase) :compile) (compile-child config record)
          (setf (getf record :phase) :validate-suite)
          (setf (getf record :registered-tests) (registered-tests (getf config :expected-tests))
                (getf record :phase) :tests)
          (dolist (test (getf config :expected-tests))
            (require-time)
            (setf (getf record :failed-test) test)
            (funcall (find-symbol (second test) (first test)))
            (setf (getf record :passed-tests) (append (getf record :passed-tests) (list test))))
          (setf (getf record :failed-test) nil (getf record :phase) :complete
                (getf record :status) :finalizing code 0))
      (error (condition)
        (setf (getf record :status) :failed (getf record :diagnostic) (princ-to-string condition)
              (getf record :condition-type) (princ-to-string (type-of condition))
              (getf record :failure-kind) (if (eq :tests (getf record :phase)) (semantic-kind condition) :infrastructure))
        (when (and (eq :tests (getf record :phase)) (eq :assertion (getf record :failure-kind)))
          (setf code 1))))
    (handler-case
        (progn
          (setf (getf record :source-manifest) (manifest (getf config :files) (truename "./"))
                (getf record :config-sha256-after) (sha256 config-path)
                (getf record :finished-at-universal-time) (get-universal-time))
          (unless (and (equal (getf config :manifest) (getf record :source-manifest))
                       (equal (getf record :config-sha256) (getf record :config-sha256-after)))
            (reject "child sources/config changed during execution."))
          (write-record record (getf config :child-report))
          (require-time)
          (when (zerop code) (setf (getf record :status) :ok)))
      (error (condition)
        (setf code 2 (getf record :status) :failed (getf record :failure-kind) :infrastructure
              (getf record :diagnostic) (princ-to-string condition)
              (getf record :condition-type) (princ-to-string (type-of condition)))))
    (write-record record (getf config :child-report))
    (sb-ext:exit :code code)))
(defun patch-text (file source before after)
  (let* ((position (unique-position source before)) (left (1+ (or (position #\Newline source :end position :from-end t) -1)))
         (right (or (position #\Newline source :start (+ position (length before))) (length source)))
         (old (subseq source left right))
         (new (concatenate 'string (subseq source left position) after (subseq source (+ position (length before)) right)))
         (old-lines (uiop:split-string old :separator '(#\Newline))) (new-lines (uiop:split-string new :separator '(#\Newline)))
         (line (1+ (count #\Newline source :end left))))
    (with-output-to-string (out)
      (format out "--- a/~A~%+++ b/~A~%@@ -~D,~D +~D,~D @@~%" file file line (length old-lines) line (length new-lines))
      (dolist (text old-lines) (format out "-~A~%" text)) (dolist (text new-lines) (format out "+~A~%" text)))))
(defun copy-inputs (root copy evidence files frozen expected mutant)
  (unless (equal frozen (manifest files root)) (reject "source drift before copy."))
  (dolist (file files)
    (require-time)
    (let ((source (merge-pathnames file root)) (destination (merge-pathnames file copy)))
      (ensure-directories-exist destination)
      (if (and mutant (string= file (getf mutant :file)))
          (let* ((original (uiop:read-file-string source :external-format :utf-8))
                 (modified (substitute-unique original (getf mutant :before) (getf mutant :after))))
            (write-text modified destination) (write-text modified (merge-pathnames "mutated-source.lisp" evidence))
            (write-text (patch-text file original (getf mutant :before) (getf mutant :after))
                        (merge-pathnames "mutation.patch" evidence)))
          (uiop:copy-file source destination))))
  (unless (equal frozen (manifest files root)) (reject "source drift after copy."))
  (let* ((copied (manifest files copy))
         (changed (loop for old in frozen for new in copied unless (equal old new) collect (getf new :file)))
         (config (list :schema-version 1 :kind *config-kind* :profile *profile* :files files
                       :baseline-manifest frozen :manifest copied :changed-paths changed :mutation mutant
                       :expected-tests expected :test-suites *test-suites*
                       :mutant-files *mutant-files* :backend-test-files *backend-test-files*
                       :expected-test-count *expected-test-count* :source-helpers (source-helpers)
                       :driver-source *driver-source* :engine-source *engine-source* :evidence-source *evidence-source*
                       :helper-manifest (capture-helpers copy evidence)
                       :compiled-source-files (loaded-source-files root (list :files files))
                       :child-report (namestring (merge-pathnames "child-report.lisp" evidence)))))
    (unless (equal changed (when mutant (list (getf mutant :file)))) (reject "unexpected copy delta ~S." changed))
    (write-record config (merge-pathnames "config.lisp" evidence))
    config))
(defun wait-death (process seconds)
  (let ((deadline (+ (get-internal-real-time) (* seconds internal-time-units-per-second))))
    (loop repeat 12000 while (uiop:process-alive-p process)
          do (when (>= (get-internal-real-time) deadline) (return)) (sleep 0.01))
    (not (uiop:process-alive-p process))))
(defun verify-artifacts (child config copy evidence)
  "Il parent confronta componenti ASDF congelati, fonti e FASL privati; SHA canonico per file."
  (let* ((files (getf config :files)) (entries (getf child :compiled-files))
         (expected (getf config :compiled-source-files))
         (changed (loop for old in (getf config :baseline-manifest) for new in (getf config :manifest)
                        unless (equal old new) collect (getf new :file)))
         (config-path (merge-pathnames "config.lisp" evidence)) (mutant (getf config :mutation)))
    (and expected (<= (length expected) +inventory-limit+)
         (= (length expected) (length (remove-duplicates expected :test #'string=)))
         (every (lambda (file) (member file files :test #'string=)) expected)
         (equal (getf config :manifest) (manifest files copy))
         (eql 1 (getf config :schema-version)) (eq *config-kind* (getf config :kind))
         (eq *profile* (getf config :profile)) (eq *profile* (getf child :profile))
         (equal (source-helpers) (getf config :source-helpers))
         (equal *driver-source* (getf config :driver-source))
         (equal *engine-source* (getf config :engine-source))
         (equal *evidence-source* (getf config :evidence-source))
         (equal *mutant-files* (getf config :mutant-files))
         (or (null mutant) (member (getf mutant :file) *mutant-files* :test #'string=))
         (equal changed (getf config :changed-paths))
         (equal changed (when mutant (list (getf mutant :file))))
         (equal (getf config :manifest) (getf child :source-manifest-before))
         (equal (getf config :manifest) (getf child :source-manifest))
         (equal (getf config :expected-tests) (getf child :registered-tests))
         (equal expected (getf child :loaded-source-files))
         (string= (sha256 config-path) (getf child :config-sha256))
         (string= (getf child :config-sha256) (getf child :config-sha256-after))
         (verify-helpers (getf config :helper-manifest) copy evidence)
         (or (null mutant)
             (string= (sha256 (merge-pathnames "mutated-source.lisp" evidence))
                      (sha256 (merge-pathnames (getf mutant :file) copy))))
         (= (length entries) (length expected))
         (equal (sort (mapcar (lambda (e) (getf e :file)) entries) #'string<) expected)
         (every (lambda (entry)
                  (let ((fasl (getf entry :fasl)) (file (getf entry :file)))
                    (and (stringp fasl) (probe-file fasl)
                         (uiop:subpathp (truename fasl) (merge-pathnames "fasl/" copy))
                         (equal (truename fasl)
                                (truename (make-pathname :type "fasl" :defaults
                                           (merge-pathnames file (merge-pathnames "fasl/" copy)))))
                         (string= (getf entry :source-sha256)
                                  (getf (find file (getf config :manifest) :key (lambda (e) (getf e :file))
                                              :test #'string=) :sha256))))) entries)
         (let ((hashes (manifest (mapcar (lambda (e) (enough-namestring (getf e :fasl) copy)) entries) copy)))
           (loop for entry in entries for hash in hashes
                 always (string= (getf entry :fasl-sha256) (getf hash :sha256)))))))
(defun run-copy (root directory files frozen expected mutant checkpoint)
  (let* ((name (if mutant (getf mutant :name) "baseline"))
         (copy (exclusive-owned-child directory "raw/isolatedtests/" name))
         (evidence (exclusive-owned-child directory "raw/evidence/" name))
         (result (list :name name :profile *profile* :file (when mutant (getf mutant :file)) :result :pending :status :running
                       :copy-directory (namestring copy) :evidence-directory (namestring evidence)
                       :expected-failure (when mutant (getf mutant :expected-failure))
                       :suggested-detection-test (when mutant (getf mutant :test))
                       :producer-record (namestring (merge-pathnames "report.lisp" directory))
                       :producer-closed nil :child-launched nil :child-reaped nil :timed-out nil :cleanup :pending
                       :diagnostic nil :source-consistency :not-observed
                       :changed-paths nil :config-sha256 nil :config-sha256-after nil
                       :config-record (namestring (merge-pathnames "config.lisp" evidence))
                       :child-report (namestring (merge-pathnames "child-report.lisp" evidence))
                       :result-record (namestring (merge-pathnames "result.lisp" evidence))
                       :deadline-seconds nil :failed-test nil :failure-kind nil :passed-count nil
                       :artifacts-verified nil :exit-code nil :signal nil))
         (process nil) (config nil) (child nil))
    (funcall checkpoint result)
    (handler-case
        (progn
          (setf config (copy-inputs root copy evidence files frozen expected mutant))
          (let* ((seconds (min +child-seconds+ (max 0 (- (remaining) +cleanup-seconds+))))
                 (argv (list "sbcl" "--noinform" "--no-userinit" "--no-sysinit" "--disable-debugger"
                             "--script" (namestring (merge-pathnames "driver.lisp" evidence))
                             "--child" (namestring (merge-pathnames "config.lisp" evidence)))))
            (unless (plusp seconds) (reject "campaign timeout."))
            (write-record (list :argv argv :profile *profile* :directory (namestring copy) :deadline-seconds seconds)
                          (merge-pathnames "command.lisp" evidence))
            (setf (getf result :deadline-seconds) seconds
                  (getf result :changed-paths) (getf config :changed-paths)
                  (getf result :config-sha256) (sha256 (merge-pathnames "config.lisp" evidence)))
            (funcall checkpoint result)
            (unwind-protect
                 (progn
                   (setf process (uiop:launch-program argv :directory copy :output (merge-pathnames "stdout.log" evidence)
                                                      :error-output (merge-pathnames "stderr.log" evidence)))
                   (setf (getf result :child-launched) t)
                   (unless (wait-death process seconds) (setf (getf result :timed-out) t)))
              (when process
                (when (uiop:process-alive-p process) (uiop:terminate-process process :urgent t))
                (if (wait-death process +cleanup-seconds+)
                    (multiple-value-bind (exit signal) (uiop:wait-process process)
                      (setf (getf result :exit-code) exit (getf result :signal) signal
                            (getf result :cleanup) :reaped (getf result :child-reaped) t))
                    (setf (getf result :cleanup) :unreaped (getf result :timed-out) t)))))
          (when (probe-file (getf config :child-report)) (setf child (read-record (getf config :child-report))))
          (setf (getf result :source-consistency)
                (if (equal (getf config :manifest) (manifest files copy)) :stable :changed)
                (getf result :config-sha256-after) (sha256 (merge-pathnames "config.lisp" evidence)))
          (let ((verified (and child (equal config (read-record (merge-pathnames "config.lisp" evidence)))
                               (string= (getf result :config-sha256) (getf result :config-sha256-after))
                               (verify-artifacts child config copy evidence))))
            (setf (getf result :artifacts-verified) (not (null verified))
                  (getf result :failed-test) (getf child :failed-test)
                  (getf result :failure-kind) (getf child :failure-kind)
                  (getf result :passed-count) (length (getf child :passed-tests))
                  (getf result :result)
                  (classify child (getf result :exit-code) (getf config :expected-tests) verified :baseline (null mutant)
                            :timeout (getf result :timed-out) :signal (getf result :signal)
                            :target-test (when mutant (getf mutant :test))
                            :reaped (getf result :child-reaped)))))
      (error (condition)
        (setf (getf result :result) :infrastructure-error
              (getf result :diagnostic) (format nil "~A COD-61: ~A" *driver-source* condition))))
    (setf (getf result :status) (if (member (getf result :result) '(:baseline-passed :detected)) :ok :failed))
    (write-record result (merge-pathnames "result.lisp" evidence)) (funcall checkpoint result)
    result))
(defun main ()
  (let* ((args (uiop:command-line-arguments)) (root (truename "./")) (directory nil) (files nil) (frozen nil)
         (*deadline* (+ (get-internal-real-time) (* +campaign-seconds+ internal-time-units-per-second)))
         (report (list :schema-version 1 :kind *campaign-kind* :profile *profile* :status :running :argv args
                       :started-at-universal-time (get-universal-time) :self-test nil :baseline nil :mutants nil
                       :source-root (namestring root)
                       :targets (mapcar (lambda (m) (list :name (getf m :name) :file (getf m :file)
                                                         :test (getf m :test))) *mutants*)
                       :test-selection *test-suites* :expected-tests nil :source-consistency :not-observed
                       :mutant-files *mutant-files* :backend-test-files *backend-test-files*
                       :expected-test-count *expected-test-count* :source-helpers (source-helpers)
                       :driver-source *driver-source* :engine-source *engine-source* :evidence-source *evidence-source*
                       :helper-manifest nil
                       :raw-root "raw/evidence/" :collector-exclusions '("raw/isolatedtests/")
                       :file-limit-bytes +file-limit+ :inventory-limit +inventory-limit+
                       :child-deadline-seconds +child-seconds+ :campaign-deadline-seconds +campaign-seconds+
                       :deadline-policy :cooperative :campaign-config "raw/evidence/campaign-config.lisp"
                       :static-risks (append '(:parent-source-freeze-required :not-executed-by-author :serial-children
                                               :compiler-fixture-type-io-timeout-crash-not-kills :isolatedcopies-excluded-from-collector
                                               :evidence-directory-must-be-collected-with-terminal-producer
                                               :canonical-digest-helper-uses-shasum :all-asdf-test-definitions-loaded-only
                                               :cooperative-parent-deadline :stat-timestamps-platform-resolution
                                               :no-engine-qualification)
                                             *profile-static-risks*))))
    (handler-case
        (progn
          (unless (and (= 2 (length args)) (member (first args) '("--self-test" "--check") :test #'string=))
            (reject "usage --self-test|--check spikes/out/<namespace-nuovo>/."))
          (setf directory (exclusive-directory (second args))) (save-report report directory)
          (setf (getf report :helper-manifest)
                (capture-helpers root (merge-pathnames "raw/evidence/" directory)))
          (write-record (list :schema-version 1 :kind *campaign-config-kind* :profile *profile* :argv args
                              :source-root (namestring root) :targets *mutants* :test-suites *test-suites*
                              :mutant-files *mutant-files* :backend-test-files *backend-test-files*
                              :expected-test-count *expected-test-count* :source-helpers (source-helpers)
                              :driver-source *driver-source* :engine-source *engine-source* :evidence-source *evidence-source*
                              :helper-manifest (getf report :helper-manifest)
                              :deadline-policy :cooperative :child-seconds +child-seconds+
                              :campaign-seconds +campaign-seconds+ :cleanup-seconds +cleanup-seconds+)
                        (merge-pathnames "raw/evidence/campaign-config.lisp" directory))
          (setf (getf report :self-test)
                (self-test (exclusive-owned-child directory "raw/evidence/" "self-test")))
          (write-record (getf report :self-test) (merge-pathnames "raw/evidence/self-test/result.lisp" directory))
          (save-report report directory)
          (when (string= "--check" (first args))
            (setf files (inventory) frozen (manifest files root)
                  (getf report :frozen-manifest) "raw/evidence/frozen-manifest.lisp")
            (write-record frozen (merge-pathnames "raw/evidence/frozen-manifest.lisp" directory))
            (handler-bind ((warning #'abort-warning))
              (asdf:load-asd (merge-pathnames "arcdocdb.asd" root)))
            (let ((expected (expected-tests)))
              (setf (getf report :expected-tests) expected (getf report :test-count) (length expected))
              (save-report report directory)
              (dolist (mutant *mutants*)
                (unless (member (getf mutant :file) *mutant-files* :test #'string=) (reject "mutant scope invalid."))
                (unless (member (getf mutant :test) expected :test #'equal) (reject "mutant test absent."))
                (unique-position (uiop:read-file-string (getf mutant :file)) (getf mutant :before)))
              (let ((baseline (run-copy root directory files frozen expected nil
                                        (lambda (result) (setf (getf report :baseline) result) (save-report report directory)))))
                (unless (eq :baseline-passed (getf baseline :result)) (reject "baseline not passed.")))
              (dolist (mutant *mutants*)
                (require-time)
                (let ((entry nil))
                  (run-copy root directory files frozen expected mutant
                            (lambda (result)
                              (setf entry result
                                    (getf report :mutants)
                                    (cons result (remove (getf result :name) (getf report :mutants)
                                                         :key (lambda (e) (getf e :name)) :test #'string=)))
                              (save-report report directory)))
                  (when (eq :unreaped (getf entry :cleanup)) (reject "unreaped child."))))
              (unless (and (= 4 (length (getf report :mutants)))
                           (every (lambda (entry) (eq :detected (getf entry :result))) (getf report :mutants)))
                (reject "mutant survived or campaign invalid."))))
          (setf (getf report :status) :finalizing))
      (error (condition)
        (setf (getf report :status) :failed
              (getf report :diagnostic) (format nil "~A COD-61: ~A" *driver-source* condition))))
    (handler-case
        (progn
          (when frozen
            (handler-case
                (let ((after (manifest files root)))
                  (write-record after (merge-pathnames "raw/evidence/source-manifest-after.lisp" directory))
                  (setf (getf report :source-manifest-after) "raw/evidence/source-manifest-after.lisp"
                        (getf report :source-consistency)
                        (if (and (equal files (inventory)) (equal frozen after)) :stable :changed))
                  (unless (eq :stable (getf report :source-consistency)) (reject "primary source drift.")))
              (error (condition)
                (unless (eq :changed (getf report :source-consistency))
                  (setf (getf report :source-consistency) :unverified))
                (setf (getf report :status) :failed (getf report :diagnostic) (princ-to-string condition)))))
          (dolist (entry (append (when (getf report :baseline) (list (getf report :baseline))) (getf report :mutants)))
            (setf (getf entry :producer-closed) (or (not (getf entry :child-launched)) (eq t (getf entry :child-reaped))))
            (write-record entry (merge-pathnames "result.lisp" (pathname (getf entry :evidence-directory)))))
          (setf (getf report :counters)
                (loop for result in '(:baseline-passed :baseline-failed :detected :survived :compilation-error :infrastructure-error :invalid)
                      append (list result (count result (append (when (getf report :baseline) (list (getf report :baseline)))
                                                                (getf report :mutants)) :key (lambda (entry) (getf entry :result)))))
                (getf report :finished-at-universal-time) (get-universal-time))
          (save-report report directory)
          ;; Dopo hashes finali, result terminali, contatori e report provvisorio.
          ;; Non è un hard-timeout: le chiamate al lettore canonico restano cooperative.
          (when (getf report :helper-manifest)
            (unless (verify-helpers (getf report :helper-manifest) root (merge-pathnames "raw/evidence/" directory))
              (reject "campaign helper source/raw SHA mismatch.")))
          (require-time)
          (when (eq :finalizing (getf report :status)) (setf (getf report :status) :ok)))
      (error (condition)
        (setf (getf report :status) :failed (getf report :diagnostic) (princ-to-string condition))))
    (handler-case
        (progn
          (save-report report directory)
          ;; Anche una scrittura terminale lenta non conserva :OK oltre il budget cooperativo.
          (when (eq :ok (getf report :status)) (require-time)))
      (error (condition)
        (setf (getf report :status) :failed (getf report :diagnostic) (princ-to-string condition))
        (save-report report directory)))
    (let ((*print-readably* nil) (*print-escape* t) (*print-length* nil) (*print-level* nil)) (write report :pretty t) (terpri))
    (sb-ext:exit :code (if (eq :ok (getf report :status)) 0 1))))
(let ((args (uiop:command-line-arguments)))
  (unless (equal args '("--library"))
    (if (and (= 2 (length args)) (string= "--child" (first args))) (child-main (second args)) (main))))
