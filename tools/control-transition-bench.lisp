;;;; C4: solo VERIFICA-TRANSIZIONE-RECOVERY su manifest pubblicamente decodificati.
;;;; --self-test: dati/classificatore/oracolo/contatori/argv; nessun carico prodotto/test.
;;;; --bench --output spikes/out/control-transition-bench-X/ : root nuova esclusiva.
;;;; Il recorder esterno conserva comando, ambiente, primo errore e actual exit.
;;; OWNER: main possiede setup/report; ciascun worker possiede manifest e contatori.
;;; SHARED: solo funzioni immutabili e gate; trasferimento al main dopo quiescenza.
;;; REQ: REQ-REC-001 REQ-TXM-007 REQ-AFF-018 REQ-VAL-001
;;; Il bootstrap rilegge il driver una sola volta sotto handler: anche gli avvisi
;;; delle DEFUN compilate da LOAD sono fatali, prima dell'ingresso in MAIN.
;;; OWNER: binding dinamico del feature nel singolo processo CLI; profondità massima due LOAD.
(eval-when (:load-toplevel :execute)
  (unless (member :arcdocdb-control-transition-driver *features*)
    (let ((*features* (cons :arcdocdb-control-transition-driver *features*)))
      (handler-bind ((warning (lambda (condition)
                                (error "control-transition COD-01: ~A" condition))))
        (load *load-truename*)))
    (error "control-transition COD-61: il driver non ha terminato il processo.")))
(eval-when (:compile-toplevel :load-toplevel :execute) (require :sb-posix))
(defpackage #:arcdocdb.control-transition.c4 (:use #:cl))
(in-package #:arcdocdb.control-transition.c4)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defconstant +target+ 10000)
(defconstant +warmup+ 32)
(defconstant +replicas+ 3)
(defconstant +window-seconds+ 30)
(defconstant +campaign-seconds+ 180)
(defconstant +report-limit+ 1048576)
(defconstant +inventory-depth+ 32)
(defconstant +inventory-count+ 4096)
(defconstant +u64-max+ #xffffffffffffffff)
(defvar *warnings* nil)
(defvar *warning-count* 0)
(defvar *threads* nil)

(define-condition bench-failure (error)
  ((reason :initarg :reason :reader failure-reason))
  (:report (lambda (c s) (format s "control-transition C4: ~S" (failure-reason c)))))
(define-condition bench-deadline (bench-failure) ())
(defun reject (reason) (error 'bench-failure :reason reason))
(defun diagnostic (c)
  (let ((s (princ-to-string c))) (subseq s 0 (min 512 (length s)))))
(defun error-kind (c) (if (typep c 'bench-deadline) :deadline :error))
(defun function-in (package name &optional internal)
  (multiple-value-bind (symbol visibility) (find-symbol name package)
    (unless (and symbol (fboundp symbol) (or internal (eq visibility :external)))
      (reject (list :missing-api package name)))
    (symbol-function symbol)))

;; POSIX timespec ABI del runtime SBCL a 64 bit, Darwin/Linux.
;; Darwin: CLOCK_MONOTONIC=6, CLOCK_THREAD_CPUTIME_ID=16 (SDK _time.h).
;; Linux: CLOCK_MONOTONIC=1, CLOCK_THREAD_CPUTIME_ID=3.
(sb-alien:define-alien-type clock-stamp
  (sb-alien:struct clock-stamp (seconds sb-alien:long) (nanos sb-alien:long)))
(sb-alien:define-alien-routine ("clock_gettime" %clock-gettime) sb-alien:int
  (id sb-alien:int) (stamp (* clock-stamp)))
(defun clock-ns (kind)
  (unless (member :64-bit *features*) (reject :clock-abi))
  (let ((id #+darwin (ecase kind (:wall 6) (:cpu 16))
            #+linux (ecase kind (:wall 1) (:cpu 3))
            #-(or darwin linux) (progn (reject :clock-platform) kind)))
    (sb-alien:with-alien ((stamp clock-stamp))
      (unless (zerop (%clock-gettime id (sb-alien:addr stamp))) (reject :clock-gettime))
      (+ (* 1000000000 (sb-alien:slot stamp 'seconds))
         (sb-alien:slot stamp 'nanos)))))
(defun require-time (deadline)
  (when (>= (clock-ns :wall) deadline) (error 'bench-deadline :reason :deadline)))
(defun remaining (deadline)
  (/ (max 0 (- deadline (clock-ns :wall))) 1d9))

(defun output-name-p (s)
  (let ((prefix "spikes/out/control-transition-bench-"))
    (and (stringp s) (> (length s) (1+ (length prefix)))
         (string= s prefix :end1 (length prefix)) (char= #\/ (char s (1- (length s))))
         (let ((suffix (subseq s (length prefix) (1- (length s)))))
           (and (<= 1 (length suffix) 64)
                (every (lambda (c) (or (char<= #\a c #\z) (char<= #\A c #\Z)
                                      (char<= #\0 c #\9) (find c "-_"))) suffix))))))
(defun arguments (args)
  (cond ((equal args '("--self-test")) (values :self-test nil))
        ((and (= (length args) 3) (equal (first args) "--bench")
              (equal (second args) "--output") (output-name-p (third args)))
         (values :bench (third args)))
        (t (reject :arguments))))
(defun matrix ()
  (loop for version in '(1 2) append
    (loop for closed in '(0 16 256) append
      (loop for outcomes in '(0 4) append
        (loop for removed in (list (if (zerop closed) 0 4)) append
          (loop for regime in '(:fixnum :high-u64) append
            (loop for workers in '(1 2 4) append
              (loop for replica from 1 to +replicas+
                    collect (list version closed outcomes removed regime workers replica)))))))))
(defun lookup-units (closed outcomes removed) (+ 2 (* closed (1+ outcomes)) removed))
(defun repetitions (closed outcomes removed workers)
  (ceiling +target+ (* workers (lookup-units closed outcomes removed))))

;;; Dati logici propri: nessuna query del prodotto costruisce l'aspettativa.
(defun declared-facts (closed outcomes removed regime series)
  (let* ((base (+ (* series 1024) (ecase regime (:fixnum 0) (:high-u64 #x8000000000000000))))
         (active (+ base 768))
         (pairs (ecase regime
                  (:fixnum '((0 0) (1 17) (2 0) (3 23)))
                  (:high-u64 '((0 0) (#xffffffffffffffff #xffffffffffffffff)
                               (#x8000000000000000 0) (1 #x8000000000000000)))))
         (rows (loop for i below closed collect
                 (list (+ base i 1) (+ 64 (* 64 (mod i 4)))
                       (if (zerop outcomes) nil (copy-tree pairs)))))
         (removed-ids (loop for i below removed collect (+ base 513 i)))
         (previous (list :completo t :next-id (1+ active) :open active
                         :chiusi rows :rimossi removed-ids))
         (current (list :completo t :next-id (+ active 2) :open (1+ active)
                        :chiusi (append (copy-tree rows) (list (list active 64 (copy-tree pairs))))
                        :rimossi (copy-list removed-ids))))
    (values previous current)))
(defun same-set-p (left right)
  (and (= (length left) (length right))
       (= (length left) (length (remove-duplicates left :test #'equal)))
       (every (lambda (x) (member x right :test #'equal)) left)))
(defun declared-transition-p (previous current)
  "Oracolo a liste: conservazione, cardinalita e nuovo ACTIVE uguale al vecchio+1."
  (let ((old (getf previous :open)) (rows (getf previous :chiusi))
        (new-rows (getf current :chiusi)))
    (and (= (getf current :open) (1+ old)) (= (getf previous :next-id) (1+ old))
         (= (getf current :next-id) (+ old 2))
         (= (length new-rows) (1+ (length rows)))
         (= (length new-rows) (length (remove-duplicates new-rows :key #'first)))
         (every (lambda (row) (equal row (assoc (first row) new-rows))) rows)
         (let ((closing (assoc old new-rows))) (and closing (= (second closing) 64)))
         (same-set-p (getf previous :rimossi) (getf current :rimossi)))))
(defun check-model (manifest facts)
  "Cold: confronto esaustivo con fatti dichiarati, usando solo query pubbliche."
  (flet ((query (name &rest args)
           (multiple-value-list (apply (function-in "ARCDOCDB.RECOVERY.MANIFEST" name)
                                       manifest args))))
    (unless (and (equal (query "SEGMENTO-ATTIVO") (list (getf facts :open)))
                 (equal (query "PROSSIMO-ID-SEGMENTO") (list t (getf facts :next-id)))
                 (equal (query "NUMERO-SEGMENTI-CHIUSI") (list (length (getf facts :chiusi))))
                 (equal (query "NUMERO-SEGMENTI-RIMOSSI") (list (length (getf facts :rimossi))))
                 (equal (query "TROVA-SEGMENTO" (getf facts :open)) '(:active 0 0))
                 (equal (query "TROVA-SEGMENTO" 0) '(:unknown 0 0))) (reject :model-scalars))
    (dolist (row (getf facts :chiusi))
      (destructuring-bind (id valid pairs) row
        (unless (equal (query "TROVA-SEGMENTO" id) (list :closed valid (length pairs)))
          (reject :model-closed))
        (dolist (pair pairs)
          (unless (equal (query "TROVA-ESITO-CHIUSURA" id (first pair)) (list t (second pair)))
            (reject :model-outcome)))
        (unless (equal (query "TROVA-ESITO-CHIUSURA" id 42) '(nil 0)) (reject :model-absence))))
    (dolist (id (getf facts :rimossi))
      (unless (and (equal (query "TROVA-SEGMENTO" id) '(:removed 0 0))
                   (equal (query "TROVA-ESITO-CHIUSURA" id 0) '(nil 0))) (reject :model-removed))))
  t)

(defstruct (sample (:copier nil))
  (series 0 :read-only t) (previous nil :read-only t) (current nil :read-only t)
  (before nil :type list :read-only t) (after nil :type list :read-only t))
(defstruct (raw (:copier nil))
  (warmup 0) (attempted 0) (completed 0) (verify0 0) (nonempty 0) (sink 0)
  (wall-ns nil) (cpu-ns nil) (done nil) (error-kind nil) (detail nil))
(defun decode-facts (facts version deadline)
  (require-time deadline)
  (multiple-value-bind (bytes start end)
      (funcall (function-in "ARCDOCDB.RECOVERY.TESTS" "MANIFEST-LOG-FIXTURE" t)
               (list (list facts)) :version version :prefix 0 :file-offset 64)
    (multiple-value-bind (manifest prefix status)
        (funcall (function-in "ARCDOCDB.RECOVERY.MANIFEST" "RICOSTRUISCI-MANIFEST")
                 bytes start end :version version :file-offset 64 :file-size (+ 64 end)
                 :max-bytes 65536 :max-batches 1 :max-batch-records 1 :max-batch-bytes 65536
                 :max-search-bytes 65536 :max-edits 1 :max-segmenti 262 :max-esiti 1028
                 :max-chiusi-per-edit 257 :max-rimossi-per-edit 4 :max-esiti-per-edit 1028
                 :max-metadata-bytes 65536)
      (unless (and (= prefix end) (eq status :complete)) (reject :decode-prefix))
      (check-model manifest facts)
      manifest)))
(defun build-sample (case series deadline)
  (destructuring-bind (version closed outcomes removed regime workers replica) case
    (declare (ignore workers replica))
    (multiple-value-bind (previous current) (declared-facts closed outcomes removed regime series)
      (unless (declared-transition-p previous current) (reject :declared-transition))
      (let ((left (decode-facts previous version deadline))
            (right (decode-facts current version deadline)))
        (when (eq left right) (reject :manifest-alias))
        (make-sample :series series :previous left :current right :before previous :after current)))))
(defun warm-sample (guard sample raw deadline)
  (dotimes (i +warmup+)
    (require-time deadline)
    (unless (null (funcall guard (sample-previous sample) (sample-current sample))) (reject :warmup-return))
    (incf (raw-warmup raw))))
(defun guard-loop (guard sample raw count stop deadline)
  "Solo guard, contatori e check cooperativi ogni 32 passi nella finestra interna."
  (let ((wall (clock-ns :wall)) (cpu (clock-ns :cpu)))
    (unwind-protect
         (progn
           (dotimes (i count)
             (when (zerop (logand i 31))
               (require-time deadline)
               (when (sb-thread:try-semaphore stop)
                 (error 'bench-deadline :reason :cooperative-stop)))
             (incf (raw-attempted raw))
             (let ((answer (funcall guard (sample-previous sample) (sample-current sample))))
               (incf (raw-completed raw))
               (incf (raw-sink raw) (raw-completed raw))
               (if (null answer) (incf (raw-verify0 raw)) (incf (raw-nonempty raw)))))
           (require-time deadline))
      (setf (raw-cpu-ns raw) (- (clock-ns :cpu) cpu)
            (raw-wall-ns raw) (- (clock-ns :wall) wall)))))
(defun worker (guard sample raw count stop deadline &optional ready gate)
  (handler-case
      (progn
        (when ready
          (sb-thread:signal-semaphore ready)
          (unless (sb-thread:wait-on-semaphore gate :timeout (remaining deadline))
            (error 'bench-deadline :reason :start-gate)))
        (guard-loop guard sample raw count stop deadline))
    (error (c) (setf (raw-error-kind raw) (error-kind c) (raw-detail raw) (diagnostic c))))
  (setf (raw-done raw) t)
  :done)
(defun quiescent-p () (notany #'sb-thread:thread-alive-p *threads*))
(defun join-group (deadline)
  (dolist (thread *threads*)
    (unless (eq :done (sb-thread:join-thread thread :timeout (remaining deadline) :default :timeout))
      (error 'bench-deadline :reason :join))))
(defun observe (guard samples raws count deadline)
  (let* ((workers (length samples)) (ready (sb-thread:make-semaphore :count 0))
         (gate (sb-thread:make-semaphore :count 0))
         (stops (loop repeat workers collect (sb-thread:make-semaphore :count 0)))
         (entries (loop for sample in samples for raw in raws for stop in stops collect
                    (let ((owned-sample sample) (owned-raw raw) (owned-stop stop))
                      (lambda () (worker guard owned-sample owned-raw count owned-stop deadline ready gate)))))
         (failure nil) (start (clock-ns :wall)) (heap (sb-ext:get-bytes-consed)))
    (setf *threads* nil)
    (handler-case
        (if (= workers 1)
            (worker guard (first samples) (first raws) count (first stops) deadline)
            (progn
              (dolist (entry entries)
                (require-time deadline)
                (push (sb-thread:make-thread entry :name "control-transition-c4") *threads*))
              (dotimes (i workers)
                (unless (sb-thread:wait-on-semaphore ready :timeout (remaining deadline))
                  (error 'bench-deadline :reason :ready-gate)))
              (require-time deadline)
              (sb-thread:signal-semaphore gate workers)
              (join-group deadline)))
      (error (c) (setf failure c)))
    (when failure
      (dolist (stop stops) (sb-thread:signal-semaphore stop))
      (sb-thread:signal-semaphore gate workers)
      ;; Stessa deadline: nessun timeout aggiuntivo, retry o terminazione forzata.
      (handler-case (join-group deadline)
        (error (c) (when (eq (error-kind failure) :deadline) (setf failure c)))))
    (values (- (clock-ns :wall) start) (- (sb-ext:get-bytes-consed) heap) failure (quiescent-p))))

;;; Classificatore puro: campioni sintetici e raw reali usano le stesse regole.
(defun fields-p (data fields)
  (handler-case
      (and (listp data) (evenp (length data))
           (let ((keys (loop for tail on data by #'cddr collect (first tail))))
             (and (every #'keywordp keys) (= (length keys) (length (remove-duplicates keys)))
                  (every (lambda (key) (member key keys)) fields))))
    (error () nil)))
(defun natural-p (n) (and (integerp n) (<= 0 n)))
(defun triangular (n) (/ (* n (1+ n)) 2))
(defun counters-valid-p (r planned)
  (and (fields-p r '(:id :series :warmup :attempted :completed :verify0 :nonempty :sink
                    :wall-ns :cpu-ns :done :error-kind))
       (every (lambda (key) (natural-p (getf r key)))
              '(:id :series :warmup :attempted :completed :verify0 :nonempty :sink))
       (<= (getf r :warmup) +warmup+)
       (<= (getf r :completed) (getf r :attempted) planned)
       (<= (- (getf r :attempted) (getf r :completed)) 1)
       (= (+ (getf r :verify0) (getf r :nonempty)) (getf r :completed))
       (= (getf r :sink) (triangular (getf r :completed)))
       (member (getf r :done) '(nil t)) (member (getf r :error-kind) '(nil :error :deadline))
       (every (lambda (key) (or (null (getf r key)) (natural-p (getf r key)))) '(:wall-ns :cpu-ns))
       (or (zerop (getf r :completed))
           (and (natural-p (getf r :wall-ns)) (natural-p (getf r :cpu-ns))))))
(defun operation-counts (records closed outcomes removed)
  (let ((done (loop for r in records sum (getf r :completed))))
    (list :guards done :shape-checks (* 2 done) :closed-rows (* closed done)
          :removed-rows (* removed done) :segment-lookups (* (+ 2 closed removed) done)
          :outcome-lookups (* closed outcomes done)
          :logical-lookups (* (lookup-units closed outcomes removed) done))))
(defun window-status (w)
  (block classify
    (unless (fields-p w '(:case :repetitions :wall-ns :bytes-consed :error-kind :quiescent
                          :oracle :workers :operation-counts)) (return-from classify :failed))
    (unless (member (getf w :case) (matrix) :test #'equal) (return-from classify :failed))
    (destructuring-bind (version closed outcomes removed regime workers replica) (getf w :case)
      (declare (ignore version regime replica))
      (let ((n (repetitions closed outcomes removed workers)) (records (getf w :workers)))
        (unless (and (eql n (getf w :repetitions)) (natural-p (getf w :wall-ns))
                     (natural-p (getf w :bytes-consed)) (member (getf w :error-kind) '(nil :error :deadline)))
          (return-from classify :failed))
        (when (or (eq (getf w :error-kind) :error) (eq (getf w :oracle) :failed))
          (return-from classify :failed))
        (unless (getf w :quiescent) (return-from classify :incomplete))
        (unless (and (= workers (length records))
                     (every (lambda (r) (counters-valid-p r n)) records)
                     (equal (sort (mapcar (lambda (r) (getf r :id)) records) #'<)
                            (loop for i below workers collect i))
                     (= workers (length (remove-duplicates records :key (lambda (r) (getf r :series)))))
                     (equal (getf w :operation-counts) (operation-counts records closed outcomes removed)))
          (return-from classify :failed))
        (when (some (lambda (r) (or (eq :error (getf r :error-kind)) (plusp (getf r :nonempty)))) records)
          (return-from classify :failed))
        (if (and (null (getf w :error-kind)) (eq :ok (getf w :oracle))
                 (every (lambda (r) (and (getf r :done) (null (getf r :error-kind))
                                        (= (getf r :warmup) +warmup+) (= (getf r :completed) n)
                                        (plusp (getf r :sink)))) records)) :ok :incomplete)))))
(defun raw-record (raw id series)
  (list :id id :series series :warmup (raw-warmup raw) :attempted (raw-attempted raw)
        :completed (raw-completed raw) :verify0 (raw-verify0 raw) :nonempty (raw-nonempty raw)
        :sink (raw-sink raw) :wall-ns (raw-wall-ns raw) :cpu-ns (raw-cpu-ns raw)
        :done (raw-done raw) :error-kind (raw-error-kind raw) :detail (raw-detail raw)))
(defun run-window (case number guard campaign-deadline)
  (destructuring-bind (version closed outcomes removed regime workers replica) case
    (declare (ignore version regime replica))
    (let* ((deadline (min campaign-deadline (+ (clock-ns :wall) (* +window-seconds+ 1000000000))))
           (n (repetitions closed outcomes removed workers))
           (samples (loop for id below workers collect (build-sample case (+ (* number 4) id 1) deadline)))
           (raws (loop repeat workers collect (make-raw))))
      (loop for sample in samples for raw in raws do (warm-sample guard sample raw deadline))
      (sb-ext:gc :full t)
      (require-time deadline)
      (multiple-value-bind (wall heap failure quiet) (observe guard samples raws n deadline)
        (let* ((records (when quiet (loop for raw in raws for sample in samples for id from 0
                                         collect (raw-record raw id (sample-series sample)))))
               (w (list :case case :repetitions n :wall-ns wall :bytes-consed heap
                        :error-kind (when failure (error-kind failure))
                        :detail (when failure (diagnostic failure)) :quiescent quiet :oracle :not-run
                        :workers records :operation-counts (when quiet (operation-counts records closed outcomes removed)))))
          (when quiet
            (handler-case
                (progn
                  (loop for sample in samples do
                    (require-time deadline)
                    (check-model (sample-previous sample) (sample-before sample))
                    (check-model (sample-current sample) (sample-after sample)))
                  (require-time deadline) (setf (getf w :oracle) :ok))
              (error (c)
                (if (eq :deadline (error-kind c))
                    (unless (eq (getf w :error-kind) :error) (setf (getf w :error-kind) :deadline))
                    (setf (getf w :oracle) :failed))
                (setf (getf w :detail) (diagnostic c))))
            (setf *threads* nil))
          (setf (getf w :status) (window-status w))
          w)))))

(defun lstat-or-absent (path)
  (handler-case (sb-posix:lstat (string-right-trim "/" (namestring path)))
    (sb-posix:syscall-error (c)
      (if (= sb-posix:enoent (sb-posix:syscall-errno c)) nil (error c)))))
(defun check-directories (path &optional create)
  (let ((parts (pathname-directory path)) (seen (list :absolute)))
    (unless (eq :absolute (first parts)) (reject :absolute-root))
    (dolist (part (rest parts))
      (unless (and (stringp part) (not (member part '("." "..") :test #'equal))) (reject :ancestor))
      (setf seen (append seen (list part)))
      (let* ((p (make-pathname :directory seen)) (s (lstat-or-absent p)))
        (when (and create (null s)) (sb-posix:mkdir (namestring p) #o700) (setf s (lstat-or-absent p)))
        (unless (and s (sb-posix:s-isdir (sb-posix:stat-mode s))) (reject :ancestor-type))))))
(defun acquire-output (root requested)
  (unless (output-name-p requested) (reject :output))
  (check-directories root)
  (check-directories (merge-pathnames "spikes/out/" root) t)
  (let ((out (merge-pathnames requested root)))
    (sb-posix:mkdir (namestring out) #o700) ; EEXIST, anche symlink, e' fatale.
    (check-directories out)
    out))
(defun load-policy (function &optional asdf)
  (handler-bind ((warning (lambda (c)
                           (if (and asdf (typep c 'sb-kernel:redefinition-warning))
                               (progn
                                 (incf *warning-count*)
                                 (when (< (length *warnings*) 16) (push (diagnostic c) *warnings*))
                                 (format *error-output* "~&ASDF-REDEFINITION ~A~%" c)
                                 (muffle-warning c))
                               (reject (list :warning (diagnostic c)))))))
    (funcall function)))
(defun copy-helper (root out deadline)
  "Cold: byte source congelati prima di COMPILE-FILE; nessun lettore SHA alternativo."
  (require-time deadline)
  (let ((copy (merge-pathnames "evidence-storage-source.lisp" out)))
    (with-open-file (input (merge-pathnames "tools/evidence-storage.lisp" root)
                           :element-type '(unsigned-byte 8))
      (let* ((size (file-length input))
             (bytes (progn (unless (and (integerp size) (<= 1 size +report-limit+)) (reject :helper-size))
                           (make-array size :element-type '(unsigned-byte 8)))))
        (unless (and (= size (read-sequence bytes input)) (eq :eof (read-byte input nil :eof)))
          (reject :helper-copy-eof))
        (with-open-file (output copy :direction :output :element-type '(unsigned-byte 8)
                                    :if-exists :error :if-does-not-exist :create)
          (write-sequence bytes output))))
    (require-time deadline)
    copy))
(defun load-code (root out deadline)
  "Solo load-system: registra test, non chiama test-op/RUN. FASL tutti privati."
  (let ((*standard-output* *error-output*) (*trace-output* *error-output*)
        (*compile-verbose* nil) (*compile-print* nil) (*load-verbose* nil) (*load-print* nil)
        (*default-pathname-defaults* root) (cache (merge-pathnames "fasl/" out))
        (copy (copy-helper root out deadline)))
    (load-policy (lambda () (require :asdf)) t)
    (ensure-directories-exist (merge-pathnames "placeholder" cache))
    (load-policy
     (lambda ()
       (progv (list (find-symbol "*COMPILE-FILE-WARNINGS-BEHAVIOUR*" "ASDF")
                    (find-symbol "*COMPILE-FILE-FAILURE-BEHAVIOUR*" "ASDF")) '(:error :error)
         (funcall (function-in "ASDF" "INITIALIZE-OUTPUT-TRANSLATIONS")
                  (list :output-translations (list t (namestring cache)) :ignore-inherited-configuration))
         (require-time deadline)
         ;; LOAD compila le definizioni SBCL una volta sola dalla copia congelata.
         ;; COMPILE-FILE seguito da LOAD ridefinirebbe le macro nello stesso processo.
         (load copy))))
    ;; Helper gia' disponibile per lo snapshot che precede il load del sistema.
    copy))
(defun load-system (root deadline)
  (load-policy
   (lambda ()
     (let ((*standard-output* *error-output*) (*trace-output* *error-output*)
           (*default-pathname-defaults* root))
       (funcall (function-in "ASDF" "LOAD-ASD") (merge-pathnames "arcdocdb.asd" root))
       (require-time deadline)
       (progv (list (find-symbol "*COMPILE-FILE-WARNINGS-BEHAVIOUR*" "ASDF")
                    (find-symbol "*COMPILE-FILE-FAILURE-BEHAVIOUR*" "ASDF")) '(:error :error)
         (funcall (function-in "ASDF" "LOAD-SYSTEM") "arcdocdb/tests" :force t :verbose nil))
       (require-time deadline))) t))
(defun source-files (root)
  (let ((files-count 4) (directory-count 0))
    (labels ((walk (directory depth)
               (when (or (> depth +inventory-depth+) (> (incf directory-count) +inventory-count+))
                 (reject :source-directory-budget))
               (let ((files (funcall (function-in "UIOP" "DIRECTORY-FILES") directory))
                     (children (funcall (function-in "UIOP" "SUBDIRECTORIES") directory)))
                 ;; Si contano anche file non Lisp per limitare il lavoro del filtro.
                 (incf files-count (length files))
                 (when (or (> files-count +inventory-count+)
                           (> (+ directory-count (length children)) +inventory-count+))
                   (reject :source-file-budget))
                 (append (remove-if-not (lambda (p) (equal (pathname-type p) "lisp")) files)
                         (mapcan (lambda (child) (walk child (1+ depth))) children)))))
      (sort (append (walk (merge-pathnames "src/" root) 0) (walk (merge-pathnames "tests/" root) 0)
                    (mapcar (lambda (p) (merge-pathnames p root))
                            '("arcdocdb.asd" "tools/control-transition-bench.lisp" "tools/evidence-storage.lisp"
                              "docs/implementazione/control-transizione-metodo.md")))
            #'string< :key #'namestring))))
(defun hash-sources (root deadline)
  (loop for path in (source-files root) do (require-time deadline)
        collect (list (enough-namestring path root)
                      (funcall (function-in "ARCDOCDB.EVIDENCE" "FILE-SHA256") path))))
(defun attest-helper (copy sources deadline)
  (require-time deadline)
  (let ((sha (funcall (function-in "ARCDOCDB.EVIDENCE" "FILE-SHA256") copy))
        (source (second (assoc "tools/evidence-storage.lisp" sources :test #'equal))))
    (unless (and source (equal sha source)) (reject :helper-source-mismatch))
    (require-time deadline)
    sha))
(defun campaign-status (windows failure before after expired)
  (cond ((or (eq failure :error) (some (lambda (w) (eq (getf w :status) :failed)) windows)
             (and before after (not (equal before after)))) :failed)
        ((or expired failure (null before) (null after)
             (< (length windows) (length (matrix)))
             (some (lambda (w) (not (eq (getf w :status) :ok))) windows)) :incomplete)
        ((not (equal (mapcar (lambda (w) (getf w :case)) windows) (matrix))) :failed)
        (t :ok)))
(defun main-owned-status (windows failure)
  "Il main conserva la precedenza degli errori senza consultare raw di worker vivi."
  (if (or (eq failure :error) (some (lambda (w) (eq (getf w :status) :failed)) windows))
      :failed :incomplete))
(defun save-report (record out)
  (let* ((*print-readably* t) (*print-pretty* nil) (*print-circle* nil)
         (text (with-output-to-string (s) (write record :stream s) (terpri s)))
         (bytes (sb-ext:string-to-octets text :external-format :utf-8))
         (path (merge-pathnames "report.lisp" out)) (tmp (merge-pathnames "report.tmp" out)))
    (when (> (length bytes) +report-limit+) (reject :report-size))
    (with-open-file (s tmp :direction :output :element-type '(unsigned-byte 8)
                          :if-exists :error :if-does-not-exist :create) (write-sequence bytes s))
    (rename-file tmp path)
    (unless (equal record (funcall (function-in "ARCDOCDB.EVIDENCE" "READ-EVIDENCE")
                                  path :max-expanded-bytes +report-limit+)) (reject :report-readback))
    (let ((sha (funcall (function-in "ARCDOCDB.EVIDENCE" "FILE-SHA256") path)))
      (with-open-file (s (merge-pathnames "report.sha256" out) :direction :output :if-exists :supersede)
        (format s "~A~%" sha)))))
(defun bench (root requested)
  (let* ((started (clock-ns :wall)) (deadline (+ started (* +campaign-seconds+ 1000000000)))
         (out nil) (before nil) (after nil) (windows nil) (failure nil) (detail nil)
         (helper-copy nil) (helper-before nil) (helper-after nil)
         (*warnings* nil) (*warning-count* 0) (*threads* nil))
    (handler-case
        (progn
          (setf out (acquire-output root requested))
          (setf helper-copy (load-code root out deadline))
          (setf before (hash-sources root deadline))
          (setf helper-before (attest-helper helper-copy before deadline))
          (load-system root deadline)
          (let ((guard (function-in "ARCDOCDB.RECOVERY.MANIFEST" "VERIFICA-TRANSIZIONE-RECOVERY")))
            (loop for case in (matrix) for number from 0 do
              (require-time deadline)
              (let ((w (run-window case number guard deadline)))
                (push w windows)
                (unless (eq :ok (getf w :status)) (return)))))
          (when (quiescent-p)
            (setf after (hash-sources root deadline)
                  helper-after (attest-helper helper-copy after deadline))
            (unless (equal helper-before helper-after) (reject :helper-copy-changed))))
      (error (c)
        (setf failure (error-kind c) detail (diagnostic c))
        (format *error-output* "~&FIRST-MAIN-ERROR ~A~%" c)))
    ;; Mai leggere raw vivi, liberare fixture, né persistere una fotografia concorrente.
    (unless (quiescent-p)
      (let ((status (main-owned-status windows failure)))
        (format t "~S~%" (list :schema-version 1 :kind :control-transition-c4 :status status
                              :quiescent nil :operation-counts :unavailable :evidence :outer-recorder
                              :main-error-kind failure :detail detail
                              :window-observations
                              (mapcar (lambda (w) (list :case (getf w :case) :status (getf w :status)
                                                       :error-kind (getf w :error-kind) :detail (getf w :detail)))
                                      (reverse windows))))
        (return-from bench (if (eq status :failed) 1 2))))
    (setf windows (nreverse windows))
    (let* ((expired (>= (clock-ns :wall) deadline))
           (status (campaign-status windows failure before after expired))
           (record (list :schema-version 1 :kind :control-transition-c4 :status status
                         :command-capture :outer-record-command :target-lookups +target+ :warmup +warmup+
                         :expected-windows (length (matrix)) :window-seconds +window-seconds+
                         :campaign-seconds +campaign-seconds+ :campaign-observed-ns (- (clock-ns :wall) started)
                         :clock '(:wall :clock-monotonic :worker-cpu :clock-thread-cputime-id :units :nanoseconds)
                         :bytes-consed-scope :whole-process-aggregate-window
                         :lookup-scope :logical-public-query-units-inferred-from-completed-guards
                         :source-sha256-before before :source-sha256-after after
                         :source-inventory-limits (list :depth +inventory-depth+ :files +inventory-count+
                                                        :directories +inventory-count+)
                         :helper-snapshot (list :copy-before-load t :source-loaded-once t
                                                :path (when helper-copy (enough-namestring helper-copy out))
                                                :sha256-before helper-before :sha256-after helper-after
                                                :scope :private-copy-equals-source-snapshot)
                         :source-consistency (if (and before after) (if (equal before after) :stable :changed) :unavailable)
                         :asdf-redefinition-count *warning-count* :asdf-redefinitions (nreverse *warnings*)
                         :error-kind failure :detail detail
                         :deadline-expired expired :quiescent t :windows windows
                         :limits '(:cooperative-deadlines :external-supervision :no-zero-allocation-claim
                                   :no-p99 :no-storage-pipeline-claim :logical-series-ownership))))
      (when (and out helper-before)
        (save-report record out)
        (when (and (eq status :ok) (>= (clock-ns :wall) deadline))
          (setf status :incomplete (getf record :status) :incomplete (getf record :deadline-expired) t)
          (save-report record out)))
      (format t "~S~%" (list :schema-version 1 :status status :windows (length windows)
                            :error-kind failure :detail detail
                            :report (when (and out helper-before) (namestring (merge-pathnames "report.lisp" out)))))
      (case status (:ok 0) (:incomplete 2) (otherwise 1)))))

;;; Suite pura autonoma; questi record non invocano worker o benchmark.
(defun synthetic-window (case)
  (destructuring-bind (version closed outcomes removed regime workers replica) case
    (declare (ignore version regime replica))
    (let* ((n (repetitions closed outcomes removed workers))
           (records (loop for id below workers collect
                      (list :id id :series (1+ id) :warmup +warmup+ :attempted n :completed n
                            :verify0 n :nonempty 0 :sink (triangular n) :wall-ns 100 :cpu-ns 80
                            :done t :error-kind nil))))
      (list :case case :repetitions n :wall-ns 120 :bytes-consed 16 :error-kind nil
            :quiescent t :oracle :ok :workers records
            :operation-counts (operation-counts records closed outcomes removed)))))
(defun self-test ()
  (let ((checks 0))
    (flet ((check (truth) (unless truth (reject :self-test)) (incf checks)))
      (check (= 216 (length (matrix))))
      (dolist (case (matrix))
        (let ((w (synthetic-window case)))
          (check (eq :ok (window-status w)))
          (destructuring-bind (v c o r regime workers replica) case
            (declare (ignore v regime replica))
            (let ((units (* workers (repetitions c o r workers) (lookup-units c o r))))
              (check (<= +target+ units (+ (1- +target+) (* workers (lookup-units c o r)))))))))
      (dolist (regime '(:fixnum :high-u64))
        (multiple-value-bind (left right) (declared-facts 16 4 4 regime 1)
          (check (declared-transition-p left right))
          (let ((bad (copy-tree right)))
            (setf (second (first (third (first (getf bad :chiusi))))) 1)
            (check (not (declared-transition-p left bad))))
          (let ((bad (copy-tree right))) (pop (getf bad :rimossi))
            (check (not (declared-transition-p left bad))))))
      (let ((base (synthetic-window '(2 16 4 4 :high-u64 2 1))))
        (dolist (key '(:oracle :wall-ns :bytes-consed :operation-counts))
          (let ((bad (copy-tree base))) (remf bad key) (check (eq :failed (window-status bad)))))
        (let ((bad (copy-tree base))) (setf (getf bad :oracle) :failed)
          (check (eq :failed (window-status bad))))
        (let ((bad (copy-tree base))) (setf (getf bad :error-kind) :deadline)
          (check (eq :incomplete (window-status bad)))
          (setf (getf (first (getf bad :workers)) :error-kind) :error)
          (check (eq :failed (window-status bad))))
        (let ((bad (copy-tree base))) (setf (getf bad :quiescent) nil (getf bad :workers) nil)
          (check (eq :incomplete (window-status bad))))
        (dolist (key '(:id :series :sink :completed :attempted :verify0 :nonempty))
          (let* ((bad (copy-tree base)) (r (first (getf bad :workers))))
            (incf (getf r key)) (check (eq :failed (window-status bad)))))
        (let* ((partial (copy-tree base)) (r (first (getf partial :workers))))
          (setf (getf r :attempted) 1 (getf r :completed) 1 (getf r :verify0) 1 (getf r :sink) 1
                (getf r :error-kind) :deadline
                (getf partial :operation-counts) (operation-counts (getf partial :workers) 16 4 4))
          (check (eq :incomplete (window-status partial))))
        (check (eq :failed (campaign-status (list base base) :error '(:a) '(:a) t)))
        (check (eq :failed (campaign-status nil nil '(:a) '(:b) nil)))
        (check (eq :incomplete (campaign-status nil :deadline nil nil t))))
      (check (eq :self-test (arguments '("--self-test"))))
      (check (eq :bench (arguments '("--bench" "--output" "spikes/out/control-transition-bench-X/"))))
      (dolist (args '(("--bench") ("--self-test" "--output" "x")
                      ("--bench" "--output" "spikes/out/control-transition-bench-X/../Y/")
                      ("--bench" "--output" "/spikes/out/control-transition-bench-X/")
                      ("--bench" "--output" "spikes/out/control-transition-bench-X//")
                      ("--bench" "--output" "spikes/out/control-transition-bench-/")))
        (check (handler-case (progn (arguments args) nil) (bench-failure () t))))
      (check (eq :deadline (error-kind (make-condition 'bench-deadline :reason :test))))
      (check (eq :error (error-kind (make-condition 'bench-failure :reason :test))))
      (check (eq :failed (main-owned-status nil :error)))
      (check (eq :failed (main-owned-status '((:status :failed :quiescent nil)) :deadline)))
      (check (eq :incomplete (main-owned-status '((:status :incomplete :quiescent nil)) :deadline)))
      (let* ((*read-eval* nil) (data (synthetic-window '(1 0 0 0 :fixnum 1 1)))
             (text (with-output-to-string (s) (let ((*print-readably* t)) (write data :stream s)))))
        (check (equal data (read-from-string text)))))
    (format t "~S~%" (list :schema-version 1 :kind :control-transition-self-test :status :ok :checks checks))
    0))
(defun main (script)
  (handler-case
      (load-policy
       (lambda ()
         (multiple-value-bind (mode output) (arguments (cdr sb-ext:*posix-argv*))
           (ecase mode
             (:self-test (self-test))
             (:bench (bench (truename (merge-pathnames "../" (make-pathname :name nil :type nil :defaults script)))
                            output))))))
    (error (c) (format *error-output* "~&~A~%" (diagnostic c)) (if (typep c 'bench-deadline) 2 1))))
;; COMPILE-FILE non esegue MAIN. LOAD/--script sono invocazioni CLI esplicite.
(sb-ext:exit :code (main (or *load-truename* *compile-file-truename*)))
