;;;; Pacchetti CI: inventario canonico, originali opachi, gzip verificato e limiti aggregati.
;;; REQ: REQ-VAL-001 REQ-AFF-012
(in-package #:arcdocdb.ci)
(declaim (optimize (safety 3) (debug 3)))
(defvar *ci-ingest-expanded-left* nil)

(defun ci-verify-gzip (path bytes hash remaining)
  "Espande soltanto tramite descriptor costruito qui, mai interpretando il raw."
  (unless (and (integerp bytes) (<= 0 bytes (min remaining (* 128 1024 1024)))
               (ci-hex-id-p hash)) (error "Limite/hash gzip non valido: ~A" path))
  (let ((descriptor (list :schema-version 1 :kind :compressed-evidence :codec :gzip
                          :payload (file-namestring path) :uncompressed-bytes bytes
                          :uncompressed-sha256 hash :compressed-bytes (ci-bytes path)
                          :compressed-sha256 (ci-sha256 path))))
    ;; L'helper di storage è codice fidato. Gli si passa una plist validata,
    ;; non un record esterno, e si conserva il suo controllo prima di ogni write.
    (with-open-file (input path :element-type '(unsigned-byte 8))
      (multiple-value-bind (expanded stream)
          (arcdocdb.evidence::%expand-to-temporary input descriptor path remaining)
        (unwind-protect
             (unless (and (= bytes (ci-bytes (truename expanded)))
                          (string= hash (ci-sha256 (truename expanded))))
               (error "Espansione diversa dall'originale: ~A" path))
          (when stream (close stream))
          (when (probe-file expanded) (delete-file expanded)))))
    bytes))

(defun ci-file-entry (path relative &key expanded-bytes expanded-sha256)
  (ci-relative-path relative)
  (let* ((size (ci-bytes path)) (gzip (string= (or (pathname-type path) "") "gz")))
    (when (> size (if gzip (* 8 1024 1024) (* 1024 1024)))
      (error "File oltre il limite: ~A" path))
    (append (list :path relative :bytes size :sha256 (ci-sha256 path)
                  :encoding (if gzip :gzip :plain))
            (when gzip
              (list :expanded-bytes expanded-bytes :expanded-sha256 expanded-sha256)))))

(defun ci-packet-file (source destination relative)
  "Copia originale o gzip lossless; restituisce le voci, senza riscrivere l'ingresso."
  (let ((target (merge-pathnames relative destination)))
    (if (and (> (ci-bytes source) 4096) (not (equal (pathname-type source) "gz")))
        (let* ((gzip (pathname (concatenate 'string (namestring target) ".gz")))
               (bytes (ci-bytes source)) (hash (ci-sha256 source)))
          (ensure-directories-exist gzip)
          (with-open-file (out gzip :direction :output :if-exists :error
                                   :element-type '(unsigned-byte 8))
            (uiop:run-program (list "gzip" "-n" "-9" "-c" "--" (namestring source))
                              :output out :error-output :string))
          (ci-verify-gzip gzip bytes hash +ci-expanded-bytes+)
          (ci-save target (list :schema-version 1 :kind :compressed-evidence :codec :gzip
                               :payload (file-namestring gzip) :uncompressed-bytes bytes
                               :uncompressed-sha256 hash :compressed-bytes (ci-bytes gzip)
                               :compressed-sha256 (ci-sha256 gzip)))
          (list (ci-file-entry target relative)
                (ci-file-entry gzip (concatenate 'string relative ".gz")
                               :expanded-bytes bytes :expanded-sha256 hash)))
        (progn
          (ci-copy-new source target)
          (if (equal (pathname-type source) "gz")
              (let* ((original (pathname (subseq (namestring source) 0 (- (length (namestring source)) 3))))
                     (descriptor (ci-read original)))
                (unless (and (eq :compressed-evidence (getf descriptor :kind))
                             (string= (file-namestring source) (getf descriptor :payload)))
                  (error "Gzip senza descriptor canonico: ~A" source))
                (list (ci-file-entry target relative
                                    :expanded-bytes (getf descriptor :uncompressed-bytes)
                                    :expanded-sha256 (getf descriptor :uncompressed-sha256))))
              (list (ci-file-entry target relative)))))))

(defun ci-cache-path-p (relative)
  (or (some (lambda (part) (member part '("fasl" "cache" "src" "tests" "copies") :test #'string=))
            (uiop:split-string relative :separator "/"))
      (member (pathname-type relative) '("fasl" "core" "html") :test #'equal)
      (string= (file-namestring relative) "coverage-state.lisp")))

(defun ci-pack-job (out work job identity result)
  "Una sola chiusura dopo il processo; report canonico piccolo e originali completi."
  (let ((rows nil) (packet (ci-mkdir (merge-pathnames "packet/" out))))
    (ci-save (merge-pathnames "result.lisp" packet) result)
    (when (> (ci-bytes (merge-pathnames "result.lisp" packet)) 65536)
      (error "Riepilogo canonico del job oltre 64KiB."))
    (push (ci-file-entry (merge-pathnames "result.lisp" packet) "result.lisp") rows)
    (dolist (file (ci-files work :limit 100000 :max-depth 32))
      (let ((relative (enough-namestring file work)))
        (unless (ci-cache-path-p relative)
          (setf rows (nconc (ci-packet-file file packet (concatenate 'string "raw/" relative)) rows)))))
    (setf rows (sort rows #'string< :key (lambda (row) (getf row :path))))
    (ci-save (merge-pathnames "manifest.lisp" packet)
             (list :schema-version 1 :kind :ci-packet :job job :identity identity
                   :context (ci-context) :files rows))
    (ci-verify-packet packet)
    packet))

(defun ci-verify-packet (directory)
  "Verifica nomi, schema, byte e inventario chiuso; nessun raw viene letto come Lisp."
  (let* ((root (ci-directory directory))
         (manifest (ci-read (merge-pathnames "manifest.lisp" root)))
         (rows (getf manifest :files)) (seen (make-hash-table :test #'equal))
         (stored 0) (expanded 0))
    (ci-plist-check manifest '(:schema-version :kind :job :identity :context :files)
                    '(:schema-version :kind :job :identity :context :files))
    (unless (and (eql 1 (getf manifest :schema-version)) (eq :ci-packet (getf manifest :kind))
                 (member (getf manifest :job) (cons "plan" (cons "sealed" *ci-jobs*)) :test #'string=)
                 (listp rows) (<= 1 (length rows) 10000)) (error "Manifest CI non valido."))
    (setf (gethash "manifest.lisp" seen) t)
    (dolist (row rows)
      (ci-plist-check row '(:path :bytes :sha256 :encoding :expanded-bytes :expanded-sha256)
                      '(:path :bytes :sha256 :encoding))
      (let* ((relative (ci-relative-path (getf row :path))) (path (merge-pathnames relative root))
             (size (getf row :bytes)) (hash (getf row :sha256)))
        (when (gethash relative seen) (error "Path duplicato: ~A" relative))
        (setf (gethash relative seen) t)
        (unless (and (ci-regular-file-p path) (integerp size) (<= 0 size (* 8 1024 1024))
                     (ci-hex-id-p hash) (= size (ci-bytes path)) (string= hash (ci-sha256 path)))
          (error "File CI alterato/non regolare: ~A" path))
        (incf stored size)
        (case (getf row :encoding)
          (:plain (when (> size (* 1024 1024)) (error "Plain oltre 1MiB."))
                  (when (and *ci-ingest-expanded-left* (> size *ci-ingest-expanded-left*))
                    (error "Budget espanso del run esaurito."))
                  (incf expanded size)
                  (when *ci-ingest-expanded-left* (decf *ci-ingest-expanded-left* size)))
          (:gzip (let ((bytes (ci-verify-gzip path (getf row :expanded-bytes)
                                             (getf row :expanded-sha256)
                                             (min (- +ci-expanded-bytes+ expanded)
                                                  (or *ci-ingest-expanded-left* +ci-expanded-bytes+)))))
                   (incf expanded bytes)
                   (when *ci-ingest-expanded-left* (decf *ci-ingest-expanded-left* bytes))))
          (otherwise (error "Codifica CI sconosciuta.")))))
    (incf stored (ci-bytes (merge-pathnames "manifest.lisp" root)))
    (when (or (> stored +ci-packet-bytes+) (> expanded +ci-expanded-bytes+))
      (error "Budget aggregato CI superato."))
    (let ((files (ci-files root)))
      (unless (and (= (length files) (hash-table-count seen))
                   (every (lambda (p) (gethash (enough-namestring p root) seen)) files))
        (error "Inventario CI non chiuso.")))
    manifest))

(defun ci-packet-digest (directory)
  (ci-sha256 (merge-pathnames "manifest.lisp" (ci-directory directory))))

(defun ci-copy-packet (source destination)
  (ci-verify-packet source)
  (let ((root (ci-mkdir destination)))
    (dolist (file (ci-files source))
      (ci-copy-new file (merge-pathnames (enough-namestring file (ci-directory source)) root)))
    (ci-verify-packet root)
    root))

(defun ci-summary-counts (results)
  "Ogni job mantiene il proprio ambiente; nessuna somma di test su due OS."
  (loop for result in results collect
    (list :job (getf result :job) :status (getf result :status)
          :metrics (getf result :metrics) :reason (getf result :reason))))

(defun ci-html-escape (text)
  (with-output-to-string (out)
    (loop for c across (princ-to-string text)
          do (case c (#\< (write-string "&lt;" out)) (#\> (write-string "&gt;" out))
                   (#\& (write-string "&amp;" out)) (#\| (write-string "&#124;" out))
                   (#\Newline (write-char #\Space out))
                   (#\Return (write-char #\Space out)) (#\Tab (write-char #\Space out))
                   (#\[ (write-string "&#91;" out)) (#\] (write-string "&#93;" out))
                   (#\` (write-string "&#96;" out)) (#\* (write-string "&#42;" out))
                   (#\_ (write-string "&#95;" out)) (#\\ (write-string "&#92;" out))
                   (otherwise (write-char c out))))))

(defun ci-report-markdown (summary path)
  (with-open-file (out path :direction :output :if-exists :error :external-format :utf-8)
    (format out "# Statistiche CI~%~%Codice provato: `~A`.~%~%Identità sorgenti: `~A`.~%~%"
            (ci-html-escape (getf summary :tested-sha)) (ci-html-escape (getf summary :source-id)))
    (format out "Raccolta chiusa: ~A; metriche complete: ~A; verifiche superate: ~A.~%~%"
            (getf summary :collection-closed) (getf summary :metrics-complete)
            (getf summary :verification-passed))
    (let ((proof (getf summary :source-attribution)))
      (when proof
        (if (eq :github-pr-merge-source-v1 (getf proof :method))
            (format out "Sorgenti equivalenti al merge GitHub `~A` della PR ~A; SHA originale conservata sopra. Producer PR non fidato; nessuna attestazione dell'esecuzione.~%~%"
                    (ci-html-escape (getf proof :github-merge-sha))
                    (ci-html-escape (getf proof :pull-request)))
            (format out "Commit confermato dai metadata GitHub del run.~%~%"))))
    (format out "| Job | Esito | Metriche |~%|---|---|---|~%")
    (dolist (row (getf summary :jobs))
      (format out "| ~A | ~A | ~A |~%" (ci-html-escape (getf row :job))
              (getf row :status) (ci-html-escape (ci-wire-string (getf row :metrics)))))
    (format out "~%Prestazioni esplorative su runner GitHub; forme/rami non sono MC/DC.~%")))
