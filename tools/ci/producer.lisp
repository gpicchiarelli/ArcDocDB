;;;; Producer CI e aggregazione: processi registrati, piano esplicito e stati distinti.
;;; REQ: REQ-VAL-001 REQ-AFF-005 REQ-AFF-012
(in-package #:arcdocdb.ci)
(declaim (optimize (safety 3) (debug 3)))

(defun ci-expected-jobs (&optional (context (ci-context)))
  (append '("plan" "verify-linux" "verify-macos" "audit" "coverage")
          (when (or (string= "workflow_dispatch" (getf context :event))
                    (and (string= "push" (getf context :event))
                         (string= "refs/heads/main" (getf context :ref)))
                    (string= "local" (getf context :event))) '("bench"))))

(defun ci-plan (out)
  (multiple-value-bind (clean reason) (ci-working-clean-p)
    (unless clean (error "Checkout sporco: piano non attribuibile: ~A" reason)))
  (let* ((root (ci-mkdir out)) (work (ci-mkdir (merge-pathnames "work/" root)))
         (identity (ci-source))
         (result (list :schema-version 1 :kind :ci-job-result :job "plan" :status :passed
                       :identity (ci-identity-summary identity) :context (ci-context)
                       :expected-jobs (ci-expected-jobs)
                       :metrics (ci-identity-summary identity) :reason nil)))
    ;; L'inventario completo è ricostruibile dagli oggetti Git identificati dal
    ;; commit. Non duplica decine di migliaia di record storici ad ogni run.
    (ci-save (merge-pathnames "sources.lisp" work)
             (append (ci-identity-summary identity)
                     (list :inventory-method :git-ls-tree-objects-v1
                           :excluded-prefix "spikes/results/ci/")))
    (ci-installation-record work)
    (ci-pack-job root work "plan" (ci-identity-summary identity) result)
    result))

(defun ci-command (argv out label)
  "Esegue il recorder con destinazione nota. Timeout del job e deadline dei figli sono distinti."
  (let* ((record-dir (merge-pathnames (format nil "commands/~A/" label) out))
         (args (ci-sbcl-command "tools/record-command.lisp" "--out" (namestring record-dir) "--"))
         (stdout (merge-pathnames (format nil "~A-driver.stdout" label) out))
         (stderr (merge-pathnames (format nil "~A-driver.stderr" label) out)))
    (ensure-directories-exist stdout)
    (multiple-value-bind (text errors code)
        (uiop:run-program (append args argv) :output stdout :error-output stderr :ignore-error-status t)
      (declare (ignore text errors))
      (list :name label :command argv :exit-code code :status (if (zerop code) :passed :failed)
            :record (enough-namestring (merge-pathnames "report.lisp" record-dir) out)))))

(defun ci-check-command (argv out label)
  (let* ((path (merge-pathnames (format nil "~A.lisp" label) out))
         (record (ci-command (append argv (list "--report" (namestring path))) out label)))
    (if (probe-file path)
        (append record (list :metrics (ci-read path)))
        (progn (setf (getf record :status) :failed)
               (append record (list :metrics nil :reason :missing-result))))))

(defun ci-run-audit (out)
  (let* ((lisp (list *ci-sbcl* "--noinform" "--no-userinit" "--no-sysinit" "--script"))
         (checks (list (ci-check-command (append lisp '("tools/lint.lisp" "src")) out "lint")
                       (ci-check-command (append lisp '("tools/check-trace.lisp")) out "trace")
                       (ci-check-command (append lisp '("tools/check-links.lisp" ".")) out "links")
                       (ci-command '("make" "ci-audit") out "c4"))))
    (list :schema-version 1 :kind :ci-audit
          :status (if (every (lambda (c) (eq :passed (getf c :status))) checks) :passed :failed)
          :checks checks)))

(defun ci-child (job out)
  "Processo fresco: non compone build strumentata e benchmark nella stessa immagine."
  (let* ((root (ci-directory out))
         (result (cond ((member job '("verify-linux" "verify-macos") :test #'string=)
                        (ci-run-tests root))
                       ((string= job "coverage")
                        (let ((*ci-coverage-normal-report* (uiop:getenv "CI_NORMAL_TEST_REPORT")))
                          (ci-run-coverage root)))
                       ((string= job "bench")
                        (let ((*ci-measure-coordinator-identity*
                                (ci-read (merge-pathnames "coordinator-identity.lisp" root))))
                          (ci-validate-measure-identity *ci-measure-coordinator-identity*)
                          (ci-run-measure root)))
                       ((string= job "audit") (ci-run-audit root))
                       (t (error "Job sconosciuto: ~A" job)))))
    (ci-save (merge-pathnames "child-result.lisp" root) result)
    (if (or (member (getf result :status) '(:passed :ok :measured :complete))
            (and (eq :partial (getf result :status))
                 (eq :passed (getf result :tests-status)))) 0 1)))

(defun ci-compact-metrics (data job)
  (cond ((member job '("verify-linux" "verify-macos") :test #'string=)
         (loop for key in '(:planned :passed :failed :not-run :skipped :ticks :time-unit)
               append (list key (getf data key))))
        ((string= job "coverage")
         (list :totals (getf data :totals) :expected-files (getf (getf data :totals) :expected-files)
               :missing-files (getf data :missing-files) :excluded-tests (getf data :excluded-tests)
               :tests-status (getf data :tests-status) :uninstrumented-children (getf data :uninstrumented-children)))
        ((string= job "bench") (list :metrics (getf data :metrics) :scope :exploratory))
        ((string= job "audit") (list :checks (getf data :checks)))
        (t nil)))

(defun ci-run-job (job out)
  (unless (member job *ci-jobs* :test #'string=) (error "Job non ammesso: ~A" job))
  (unless (ci-working-clean-p) (error "Checkout sporco prima del job."))
  (let* ((root (ci-mkdir out)) (work (ci-mkdir (merge-pathnames "work/" root)))
         (identity (ci-source)) (before (getf identity :source-id))
         (ticks (get-internal-real-time)) (data nil) (failure nil) (execution nil))
    (ci-installation-record work)
    (when (string= job "bench")
      (ci-save (merge-pathnames "coordinator-identity.lisp" work) (ci-measure-identity identity)))
    (handler-case
        (progn
          (setf execution
                (ci-command (ci-sbcl-command (namestring *ci-entry*) "child" "--job" job
                                            "--out" (namestring work)) work "job"))
          (let ((file (merge-pathnames "child-result.lisp" work)))
            (when (probe-file file) (setf data (ci-read file :max-bytes (* 16 1024 1024)))))
          (unless (and data (eq :passed (getf execution :status)))
            (setf failure :child-failed))
          (when (and data (string= job "bench")
                     (not (and (equal (ci-measure-identity identity) (getf data :source-before))
                               (equal (ci-measure-identity identity) (getf data :source-after)))))
            (setf failure :source-changed)))
      (error (c) (setf failure (princ-to-string c))))
    (unless (and (ci-working-clean-p) (string= before (getf (ci-source) :source-id)))
      (setf failure :source-changed))
    (let ((result (list :schema-version 1 :kind :ci-job-result :job job
                        :status (if failure :failed :passed)
                        :identity (ci-identity-summary identity) :context (ci-context)
                        :ticks (- (get-internal-real-time) ticks)
                        :time-unit internal-time-units-per-second
                        :metrics (when data (ci-compact-metrics data job)) :metrics-status (getf data :status)
                        :reason failure :execution execution)))
      (ci-pack-job root work job (ci-identity-summary identity) result)
      result)))

(defun ci-discover-packets (input)
  (let ((root (ci-directory input)) (found nil))
    (dolist (file (ci-files root :limit 100000 :max-depth 32))
      (let ((parts (uiop:split-string (enough-namestring file root) :separator "/")))
        (when (and (string= "manifest.lisp" (file-namestring file)) (<= (length parts) 3))
          (let ((data (ci-read file)))
            (when (eq :ci-packet (getf data :kind))
              (push (uiop:pathname-directory-pathname file) found))))))
    (sort found #'string< :key #'namestring)))

(defun ci-collect (input &key expected-context)
  "Ogni job atteso riceve uno stato; niente percentuali o totali tra ambienti diversi."
  (let ((packets nil) (identity nil) (plan nil) (seen (make-hash-table :test #'equal))
        (*ci-ingest-expanded-left* +ci-expanded-bytes+))
    (dolist (dir (ci-discover-packets input))
      (let* ((manifest (ci-verify-packet dir)) (job (getf manifest :job)))
        (unless (string= job "sealed")
          (when (gethash job seen) (error "Due payload per lo stesso job: ~A" job))
          (setf (gethash job seen) t)
          (let* ((result (ci-read (merge-pathnames "result.lisp" dir)))
                 (id (getf manifest :identity)) (context (getf manifest :context)))
            (ci-plist-check result
               '(:schema-version :kind :job :status :identity :context :expected-jobs
                 :metrics :reason :ticks :time-unit :metrics-status :execution)
               '(:schema-version :kind :job :status :identity :context :metrics :reason))
            (ci-plist-check context
               '(:run-id :attempt :event :ref :repository :head-sha :base-sha :image :os :architecture :lisp-version)
               '(:run-id :attempt :event :ref :repository))
            (unless (and (eql 1 (getf result :schema-version)) (eq :ci-job-result (getf result :kind))
                         (member (getf result :status) '(:passed :failed))
                         (string= job (getf result :job)) (equal id (getf result :identity))
                         (equal context (getf result :context)))
              (error "Identità risultato/manifest non corrispondente."))
            (when expected-context
              (dolist (key '(:run-id :attempt :repository))
                (unless (equal (getf expected-context key) (getf context key))
                  (error "Contesto diverso per ~A." key))))
            (if identity
                (unless (equal identity id) (error "Payload di revisioni/metodi diversi."))
                (setf identity id))
            (when (string= job "plan") (setf plan result))
            (push (list :directory (namestring dir) :digest (ci-packet-digest dir)
                        :job job :result result) packets)))))
    (let* ((expected (when plan (getf plan :expected-jobs)))
           (jobs (loop for job in (or expected (cons "plan" *ci-jobs*))
                       for payload = (find job packets :key (lambda (p) (getf p :job)) :test #'string=)
                       collect (if payload (getf payload :result)
                                   (list :job job :status :missing :reason :missing-artifact :metrics nil))))
           (closed (and plan (every (lambda (j) (member (getf j :status) '(:passed :failed :missing))) jobs)))
           (complete (and closed (every #'ci-metrics-valid-p jobs)))
           (passed (and closed (every (lambda (j) (eq :passed (getf j :status))) jobs))))
      (when plan
        (unless (equal expected (ci-expected-jobs (getf plan :context)))
          (error "Piano job diverso dalla politica CI."))
        (unless (every (lambda (p) (member (getf p :job) expected :test #'equal)) packets)
          (error "Payload per job non previsto dal piano.")))
      (let ((stored 0) (expanded 0) (files 0))
        (dolist (packet packets)
          (let* ((dir (ci-directory (getf packet :directory)))
                 (manifest (ci-read (merge-pathnames "manifest.lisp" dir))))
            (incf stored (ci-bytes (merge-pathnames "manifest.lisp" dir)))
            (dolist (row (getf manifest :files))
              (incf files) (incf stored (getf row :bytes))
              (incf expanded (if (eq :gzip (getf row :encoding))
                                 (getf row :expanded-bytes) (getf row :bytes))))))
        (when (or (> stored +ci-packet-bytes+) (> expanded +ci-expanded-bytes+) (> files 10000))
          (error "Raccolta oltre i budget aggregati del run.")))
      (list :schema-version 1 :kind :ci-collection
            :source-id (getf identity :source-id) :tested-sha (getf identity :tested-sha)
            :policy-id (getf identity :policy-id) :identity identity
            :context (or (getf plan :context) expected-context)
            :collection-closed (not (null closed)) :metrics-complete (not (null complete))
            :verification-passed (not (null passed))
            :jobs (ci-summary-counts jobs) :packets (nreverse packets)
            :limits '(:github-hosted-exploratory-performance :not-mcdc :raw-not-evaluated)))))

(defun ci-seal (input out)
  (let* ((root (ci-mkdir out)) (work (ci-mkdir (merge-pathnames "work/" root)))
         (summary (ci-collect input)) (identity (getf summary :identity)))
    (ci-save (merge-pathnames "summary.lisp" work) (ci-public-summary summary))
    (ci-report-markdown summary (merge-pathnames "report.md" work))
    (ci-pack-job root work "sealed" identity
                 (list :schema-version 1 :kind :ci-job-result :job "sealed"
                       :identity identity :status (if (getf summary :metrics-complete) :passed :failed)
                       :context (ci-context) :metrics (ci-public-summary summary) :reason nil))
    summary))

(defun ci-metrics-valid-p (result)
  (let ((metrics (getf result :metrics)) (job (getf result :job)))
    (and metrics
         (cond ((member job '("verify-linux" "verify-macos") :test #'equal)
                (every (lambda (k) (let ((n (getf metrics k))) (and (integerp n) (<= 0 n))))
                       '(:planned :passed :failed :not-run :skipped)))
               ((equal job "coverage")
                (and (eq :measured (getf (getf metrics :totals) :status))
                     (null (getf metrics :missing-files))
                     (every (lambda (r) (eq :passed (getf r :normal-status)))
                            (getf metrics :excluded-tests))))
               ((equal job "audit")
                (let ((checks (getf metrics :checks)))
                  (and (= 4 (length checks))
                       (every (lambda (r) (or (equal (getf r :name) "c4")
                                              (and (getf r :metrics)
                                                   (eq :ci-check (getf (getf r :metrics) :kind))))) checks))))
               (t t)))))

(defun ci-public-summary (summary)
  (loop for (key value) on summary by #'cddr unless (eq key :packets) append (list key value)))

(defun ci-measure-identity (identity)
  (loop for k in '(:tested-sha :source-id :policy-id) append (list k (getf identity k))))

(defun ci-validate-measure-identity (identity)
  (ci-plist-check identity '(:tested-sha :source-id :policy-id) '(:tested-sha :source-id :policy-id))
  (unless (and (ci-hex-id-p (getf identity :tested-sha) 40)
               (ci-hex-id-p (getf identity :source-id)) (ci-hex-id-p (getf identity :policy-id)))
    (error "Identità del coordinatore benchmark non valida."))
  identity)
