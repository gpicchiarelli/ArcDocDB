;;;; Trasporto GitHub: metadati API, ZIP limitato e nessun checkout del producer.
;;; REQ: REQ-VAL-001 REQ-AFF-012
(in-package #:arcdocdb.ci)
(declaim (optimize (safety 3) (debug 3)))

(defun ci-repository ()
  (let* ((name (or (uiop:getenv "GITHUB_REPOSITORY") "gpicchiarelli/ArcDocDB"))
         (parts (uiop:split-string name :separator "/")))
    (unless (and (= 2 (length parts))
                 (every (lambda (p) (and (plusp (length p))
                    (every (lambda (c) (or (alphanumericp c) (find c "-_."))) p))) parts))
      (error "Repository GitHub non valido."))
    name))

(defun ci-api-lines (endpoint jq)
  "Il filtro jq è codice costante fidato; l'API restituisce solo campi TSV."
  (let ((output (ci-command-output (list "gh" "api" endpoint "--jq" jq))))
    (loop for line in (uiop:split-string output :separator '(#\Newline))
          unless (zerop (length line)) collect
            (uiop:split-string line :separator '(#\Tab)))))

(defun ci-github-run (run-id attempt)
  (ci-positive-id run-id) (ci-positive-id attempt)
  (let* ((repo (ci-repository))
         (rows (ci-api-lines
                (format nil "repos/~A/actions/runs/~A/attempts/~A" repo run-id attempt)
                "[.id,.run_attempt,.event,.head_sha,.head_branch,.status,.conclusion,.path,.repository.full_name,.created_at,.check_suite_id] | @tsv"))
         (row (first rows)))
    (unless (and (= 1 (length rows)) (= 11 (length row))
                 (equal (first row) run-id) (equal (second row) attempt)
                 (ci-hex-id-p (fourth row) 40)
                 (equal (sixth row) "completed")
                 (equal (eighth row) ".github/workflows/ci.yml")
                 (equal (ninth row) repo)
                 (member (third row) '("push" "pull_request" "workflow_dispatch") :test #'equal))
      (error "Run/attempt non terminale o workflow/repository inatteso: ~S." row))
    (let* ((suite-id (ci-positive-id (nth 10 row)))
           (suite (ci-api-lines (format nil "repos/~A/check-suites/~A" repo suite-id) ".head_sha"))
           (check-sha (caar suite)))
      (unless (and (= 1 (length suite)) (ci-hex-id-p check-sha 40))
        (error "SHA del check suite non valido."))
    (list :run-id run-id :attempt attempt :event (third row)
          :head-sha (fourth row) :ref (concatenate 'string "refs/heads/" (fifth row))
          :conclusion (seventh row) :repository repo :created-at (tenth row)
          :check-suite-id suite-id :check-suite-sha check-sha))))

(defun ci-github-merge-candidate (sha head)
  "Metadata GitHub, non campi del producer: merge firmato da web-flow legato all'head del run."
  (let* ((rows (ci-api-lines
                (format nil "repos/~A/commits/~A" (ci-repository) sha)
                "[.sha,(.commit.verification.verified==true),.commit.verification.reason,.committer.login,.commit.committer.email,(.parents|length),.parents[0].sha,.parents[1].sha] | @tsv"))
         (row (first rows)))
    (unless (and (= 1 (length rows)) (= 8 (length row))
                 (equal sha (first row)) (equal "true" (second row))
                 (equal "valid" (third row)) (equal "web-flow" (fourth row))
                 (equal "noreply@github.com" (fifth row)) (equal "2" (sixth row))
                 (ci-hex-id-p (seventh row) 40) (equal head (eighth row)))
      (error "Merge PR non firmato da GitHub o non legato all'head del run."))
    (list :base-sha (seventh row) :head-sha head)))

(defun ci-github-pr-anchors (head)
  "Al massimo 99 associazioni; nessuna risoluzione di branch/ref mutabili."
  (let ((rows (ci-api-lines
               (format nil "repos/~A/commits/~A/pulls?per_page=100" (ci-repository) head)
               ".[] | [.number,.head.sha,.base.repo.full_name,.merge_commit_sha] | @tsv"))
        (seen (make-hash-table :test #'equal)) (anchors nil))
    (when (>= (length rows) 100) (error "Inventario PR oltre il limite di 99."))
    (dolist (row rows)
      (unless (and (= 4 (length row)) (ci-positive-id (first row))
                   (ci-hex-id-p (second row) 40) (equal (ci-repository) (third row))
                   (or (equal "" (fourth row)) (ci-hex-id-p (fourth row) 40)))
        (error "Metadata delle PR associate non validi."))
      (when (gethash (first row) seen) (error "Associazione PR duplicata."))
      (setf (gethash (first row) seen) t)
      (when (and (equal head (second row)) (not (equal "" (fourth row))))
        (push (list :pull-request (first row) :github-merge-sha (fourth row)) anchors)))
    (sort anchors #'< :key (lambda (row) (parse-integer (getf row :pull-request))))))

(defun ci-github-artifacts (run-id attempt)
  (let ((prefix (format nil "ci-~A-~A-" run-id attempt)) (found nil))
    (loop for page from 1 to 20
          for rows = (ci-api-lines
                       (format nil "repos/~A/actions/runs/~A/artifacts?per_page=100&page=~D"
                               (ci-repository) run-id page)
                       ".artifacts[] | [.id,.name,.size_in_bytes,.expired] | @tsv")
          do (dolist (row rows)
               (unless (= 4 (length row)) (error "Metadati artifact non validi."))
               (when (%ci-prefix-p prefix (second row))
                 (let ((job (subseq (second row) (length prefix))))
                   (unless (member job (cons "plan" (cons "seal" *ci-jobs*)) :test #'equal)
                     (error "Nome artifact CI inatteso: ~A." (second row)))
                   (ci-positive-id (first row))
                   (unless (and (every #'digit-char-p (third row))
                                (<= (parse-integer (third row)) (* 10 1024 1024)))
                     (error "Artifact oltre il budget di trasporto."))
                   (push (list :id (first row) :name (second row) :job job
                               :expired (string= "true" (fourth row))) found))))
          when (< (length rows) 100) return nil
          finally (error "Inventario artifact oltre 2000 elementi."))
    (nreverse found)))

(defun ci-zip-u16 (bytes offset)
  (unless (<= 0 offset (- (length bytes) 2)) (error "ZIP troncato."))
  (+ (aref bytes offset) (ash (aref bytes (1+ offset)) 8)))
(defun ci-zip-u32 (bytes offset)
  (+ (ci-zip-u16 bytes offset) (ash (ci-zip-u16 bytes (+ offset 2)) 16)))

(defun ci-zip-inventory (path)
  "Legge la directory centrale; niente ZIP64, alias, cifratura o path speciali."
  (when (> (ci-bytes path) (* 10 1024 1024)) (error "ZIP oltre 10MiB."))
  (let* ((bytes (with-open-file (in path :element-type '(unsigned-byte 8))
                  (let ((data (make-array (file-length in) :element-type '(unsigned-byte 8))))
                    (unless (= (length data) (read-sequence data in)) (error "ZIP troncato.")) data)))
         (end (loop for p downfrom (- (length bytes) 22) to (max 0 (- (length bytes) 65557))
                    when (and (= #x06054b50 (ci-zip-u32 bytes p))
                              (= (length bytes) (+ p 22 (ci-zip-u16 bytes (+ p 20))))) return p))
         (seen (make-hash-table :test #'equal)) (rows nil) (total 0))
    (unless end (error "ZIP senza chiusura valida."))
    (let* ((count (ci-zip-u16 bytes (+ end 10))) (offset (ci-zip-u32 bytes (+ end 16)))
           (size (ci-zip-u32 bytes (+ end 12))) (p offset))
      (unless (and (zerop (ci-zip-u16 bytes (+ end 4)))
                   (zerop (ci-zip-u16 bytes (+ end 6)))
                   (= count (ci-zip-u16 bytes (+ end 8))) (<= 1 count 10000)
                   (= end (+ offset size))) (error "ZIP multidisco/ZIP64 o directory invalida."))
      (dotimes (i count)
        (declare (ignore i))
        (unless (= #x02014b50 (ci-zip-u32 bytes p)) (error "Directory ZIP troncata."))
        (let* ((flags (ci-zip-u16 bytes (+ p 8))) (method (ci-zip-u16 bytes (+ p 10)))
               (compressed (ci-zip-u32 bytes (+ p 20))) (expanded (ci-zip-u32 bytes (+ p 24)))
               (n (ci-zip-u16 bytes (+ p 28))) (extra (ci-zip-u16 bytes (+ p 30)))
               (comment (ci-zip-u16 bytes (+ p 32))) (local (ci-zip-u32 bytes (+ p 42)))
               (mode (ash (ci-zip-u32 bytes (+ p 38)) -16))
               (next (+ p 46 n extra comment)))
          (unless (and (<= next end) (zerop (logand flags #x2041))
                       (member method '(0 8)) (< local offset)
                       (= #x04034b50 (ci-zip-u32 bytes local)))
            (error "Formato ZIP non ammesso."))
          (let* ((name (%ci-utf8-text (subseq bytes (+ p 46) (+ p 46 n))))
                 (directory (and (plusp (length name)) (char= #\/ (char name (1- (length name))))))
                 (relative (if directory (subseq name 0 (1- (length name))) name))
                 (local-n (ci-zip-u16 bytes (+ local 26)))
                 (data-start (+ local 30 local-n (ci-zip-u16 bytes (+ local 28)))))
            (ci-relative-path relative)
            (unless (and (not (gethash name seen))
                         (member (logand mode #o170000) (if directory '(0 #o040000) '(0 #o100000)))
                         (<= (+ data-start compressed) offset)
                         (= n local-n)
                         (equalp (subseq bytes (+ local 30) (+ local 30 local-n))
                                 (subseq bytes (+ p 46) (+ p 46 n))))
              (error "ZIP con alias, link o header divergenti."))
            (setf (gethash name seen) t)
            (incf total expanded)
            (when (> total +ci-packet-bytes+) (error "ZIP espanso oltre 2MiB."))
            (unless directory (push (list :path relative :bytes expanded) rows)))
          (setf p next)))
      (unless (= p end) (error "Directory ZIP non chiusa.")))
    (nreverse rows)))

(defun ci-extract-zip (archive destination)
  "Estrae singoli file validati in file creati qui; il tool non sceglie i percorsi."
  (let ((rows (ci-zip-inventory archive)) (root (ci-mkdir destination)))
    (dolist (row rows)
      (let ((target (merge-pathnames (getf row :path) root)) (count 0))
        (ensure-directories-exist target)
        (with-open-file (out target :direction :output :if-exists :error :element-type '(unsigned-byte 8))
          (%ci-call-program
           (list "unzip" "-p" (namestring archive) (getf row :path)) nil
           (lambda (input)
             (loop for c = (read-char input nil nil) while c
                   do (when (> (incf count) (getf row :bytes)) (error "ZIP espansione eccessiva."))
                      (write-byte (char-code c) out)))))
        (unless (= count (getf row :bytes)) (error "ZIP espansione incompleta."))))
    root))

(defun ci-github-download (run-id attempt out)
  (let ((root (ci-mkdir out)) (artifacts (ci-github-artifacts run-id attempt)))
    (dolist (artifact artifacts)
      (unless (or (getf artifact :expired) (string= "seal" (getf artifact :job)))
        (let ((archive (merge-pathnames (format nil "~A.zip" (getf artifact :id)) root)))
          (with-open-file (stream archive :direction :output :if-exists :error
                                          :element-type '(unsigned-byte 8))
            (let ((count 0))
              (%ci-call-program
               (list "gh" "api" (format nil "repos/~A/actions/artifacts/~A/zip"
                                        (ci-repository) (getf artifact :id))) nil
               (lambda (input)
                 (loop for c = (read-char input nil nil) while c
                       do (when (> (incf count) (* 10 1024 1024)) (error "Download ZIP oltre limite."))
                          (write-byte (char-code c) stream))))))
          (ci-extract-zip archive (merge-pathnames (format nil "~A/" (getf artifact :job)) root))
          (delete-file archive))))
    root))
