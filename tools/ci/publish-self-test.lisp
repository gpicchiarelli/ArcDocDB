;;;; C4: provenienza PR e prima ricevuta, Git privato e API simulate.
;;; REQ: REQ-VAL-001 REQ-AFF-012
;;; OWNER: una fixture sincrona possiede repository, API delegate e variabili CI.
(in-package #:arcdocdb.ci)
(declaim (optimize (safety 3) (debug 3)))

(defun %ci-publication-commit (message)
  (ci-git '("add" "--all"))
  (%ci-data-test-commit message))

(defun ci-publication-self-test (out)
  (let* ((root (ci-mkdir out)) (*ci-root* (ci-mkdir (merge-pathnames "git/" root)))
         (cases nil) (api (symbol-function 'ci-api-lines)) (queries nil)
         (commit-row nil) (pr-rows nil)
         (run-id (uiop:getenv "GITHUB_RUN_ID")) (attempt (uiop:getenv "GITHUB_RUN_ATTEMPT")))
    (labels ((check (id function)
               (handler-case
                   (push (list :id id :status (if (funcall function) :passed :failed)) cases)
                 (error (c) (push (list :id id :status :failed :reason (princ-to-string c)) cases))))
             (rejects (function)
               (handler-case (progn (funcall function) nil) (error () t)))
             (write-file (path text)
               (%ci-data-test-write (merge-pathnames path *ci-root*) text :replace t))
             (restore-env (name value)
               (if value (sb-posix:setenv name value 1) (sb-posix:unsetenv name))))
      (unwind-protect
           (progn
             (ci-git '("init" "--quiet" "--template=" "--object-format=sha1" "--initial-branch=main"))
             (ci-git '("config" "--local" "user.name" "CI private fixture"))
             (ci-git '("config" "--local" "user.email" "ci-fixture@example.invalid"))
             (write-file "src/unit.lisp" "#.(error \"never load archived source\")")
             (write-file "docs/note.txt" "base")
             (write-file "tools/ci/policy.lisp" "NIL")
             (let* ((base (%ci-publication-commit "base"))
                    (head (progn (write-file "src/unit.lisp" "#.(error \"head stays inert\")")
                                 (%ci-publication-commit "head")))
                    (tree (%ci-one-line (ci-git '("write-tree"))))
                    (merge (%ci-one-line
                            (ci-git (list "-c" "commit.gpgsign=false" "commit-tree" tree
                                          "-p" base "-p" head "-m" "synthetic merge"))))
                    (anchor (progn (write-file "spikes/results/ci/data.txt" "#.(never-evaluate)")
                                   (%ci-publication-commit "results-only anchor")))
                    (docs (progn (write-file "docs/note.txt" "different documentation")
                                 (%ci-publication-commit "changed documentation")))
                    (policy (progn (write-file "tools/ci/policy.lisp" "T")
                                   (%ci-publication-commit "changed policy")))
                    (identity (ci-identity-summary (ci-source merge)))
                    (server (list :run-id "123" :attempt "1" :repository "gpicchiarelli/ArcDocDB"
                                  :event "pull_request" :head-sha head :check-suite-sha head))
                    (summary (list :identity identity :packets
                                   (list (list :result (list :context (copy-list server)))))))
               (labels ((reset-api ()
                          (setf commit-row (list merge "true" "valid" "web-flow" "noreply@github.com" "2" base head)
                                pr-rows (list (list "21" head "gpicchiarelli/ArcDocDB" anchor))
                                queries nil))
                        (validate () (ci-validate-provenance summary server)))
                 (reset-api)
                 (setf (symbol-function 'ci-api-lines)
                       (lambda (endpoint jq)
                         (declare (ignore jq))
                         (push endpoint queries)
                         (cond ((equal endpoint (format nil "repos/gpicchiarelli/ArcDocDB/commits/~A" merge))
                                (list (copy-list commit-row)))
                               ((equal endpoint (format nil "repos/gpicchiarelli/ArcDocDB/commits/~A/pulls?per_page=100" head))
                                (copy-tree pr-rows))
                               (t (error "API non prevista dalla fixture: ~A" endpoint)))))
                 (check :signed-merge-with-equivalent-sources
                        (lambda ()
                          (let ((proof (validate)))
                            (and (eq :github-pr-merge-source-v1 (getf proof :method))
                                 (equal merge (getf proof :tested-sha))
                                 (equal anchor (getf proof :github-merge-sha))
                                 (equal head (getf proof :run-head-sha))
                                 (equal "21" (getf proof :pull-request))
                                 (equal (getf identity :source-id) (getf proof :source-id))))))
                 (check :direct-head-remains-accepted-without-api
                        (lambda ()
                          (let* ((direct (list :identity (ci-identity-summary (ci-source head)) :packets nil))
                                 (queries-before (length queries)))
                            (and (ci-validate-provenance direct server)
                                 (= queries-before (length queries))))))
                 (dolist (spec '((:unsigned-merge 1 "false") (:invalid-signature 2 "invalid")
                                 (:different-signer 3 "fixture") (:different-email 4 "fixture@example.invalid")
                                 (:one-parent 5 "1") (:octopus-parents 5 "3")
                                 (:different-head-parent 7 "0000000000000000000000000000000000000000")
                                 (:invalid-base-parent 6 "--help")
                                 (:api-commit-mismatch 0 "0000000000000000000000000000000000000000")))
                   (check (first spec)
                          (lambda ()
                            (reset-api)
                            (setf (nth (second spec) commit-row) (third spec))
                            (rejects #'validate))))
                 (dolist (spec (list (list :documentation-is-not-excluded docs)
                                    (list :policy-difference-rejected policy)))
                   (check (first spec)
                          (lambda () (reset-api)
                            (setf (fourth (first pr-rows)) (second spec))
                            (rejects #'validate))))
                 (check :different-pr-head-rejected
                        (lambda () (reset-api) (setf (second (first pr-rows)) base) (rejects #'validate)))
                 (check :different-base-repository-rejected
                        (lambda () (reset-api) (setf (third (first pr-rows)) "other/repo") (rejects #'validate)))
                 (check :missing-merge-anchor-rejected
                        (lambda () (reset-api) (setf (fourth (first pr-rows)) "") (rejects #'validate)))
                 (check :duplicate-pr-metadata-rejected
                        (lambda () (reset-api) (push (copy-list (first pr-rows)) pr-rows) (rejects #'validate)))
                 (check :bounded-pr-inventory
                        (lambda () (reset-api)
                          (setf pr-rows (loop repeat 100 collect (copy-list (first pr-rows))))
                          (rejects #'validate)))
                 (check :push-does-not-use-pr-fallback
                        (lambda () (reset-api)
                          (let ((push-server (copy-list server)))
                            (setf (getf push-server :event) "push")
                            (and (rejects (lambda () (ci-validate-provenance summary push-server)))
                                 (null queries)))))
                 (check :forged-source-identity-rejected
                        (lambda () (reset-api)
                          (let* ((wrong (copy-list identity)) (claim (copy-tree summary)))
                            (setf (getf wrong :source-id) (make-string 64 :initial-element #\f)
                                  (getf claim :identity) wrong)
                            (rejects (lambda () (ci-validate-provenance claim server))))))
                 (check :run-context-still-checked
                        (lambda () (reset-api)
                          (let ((wrong (copy-tree summary)))
                            (setf (getf (getf (getf (first (getf wrong :packets)) :result) :context) :attempt) "2")
                            (rejects (lambda () (ci-validate-provenance wrong server))))))
                 (reset-api)
                 (ci-save (merge-pathnames "api-fixture.lisp" root)
                          (list :tested-sha merge :head-sha head :github-merge-sha anchor
                                :signature-fields commit-row :pulls pr-rows)))
               ;; Un vero push, solo verso il bare locale posseduto dalla fixture.
               (check :first-reconciliation-receipt-creates-parent
                      (lambda ()
                        (let* ((bare (merge-pathnames "origin.git/" root))
                               (state '(:schema-version 1 :kind :ci-reconciliation :cursor nil :visited 0)))
                          (ci-git (list "init" "--quiet" "--bare" "--template=" (namestring bare)))
                          (ci-git (list "remote" "add" "origin" (namestring bare)))
                          (ci-git '("push" "--quiet" "origin" "HEAD:refs/heads/main"))
                          (sb-posix:setenv "GITHUB_RUN_ID" "123456" 1)
                          (sb-posix:setenv "GITHUB_RUN_ATTEMPT" "1" 1)
                          (and (eq :published (ci-publish-reconciliation state))
                               (equal (ci-wire-string state)
                                      (ci-git '("show" "origin/main:spikes/results/ci/reconciliation/state.lisp")))
                               (equal (ci-wire-string state)
                                      (ci-git '("show" "origin/main:spikes/results/ci/reconciliation/runs/123456-1.lisp")))))))))
        (setf (symbol-function 'ci-api-lines) api)
        (restore-env "GITHUB_RUN_ID" run-id)
        (restore-env "GITHUB_RUN_ATTEMPT" attempt))
      (let* ((failed (count :failed cases :key (lambda (row) (getf row :status))))
             (report (list :schema-version 1 :kind :ci-publication-self-test
                           :status (if (zerop failed) :passed :failed)
                           :planned (length cases) :passed (- (length cases) failed) :failed failed
                           :cases (nreverse cases))))
        (ci-save (merge-pathnames "report.lisp" root) report)
        report))))
