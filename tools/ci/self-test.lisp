;;;; Ingresso CLI e verifiche dei confini CI, soltanto su invocazione esplicita.
;;; REQ: REQ-VAL-001 REQ-AFF-012
(in-package #:arcdocdb.ci)
(declaim (optimize (safety 3) (debug 3)))

(defun ci-entry-newer-p (a b)
  (or (> (parse-integer (getf a :run-id)) (parse-integer (getf b :run-id)))
      (and (equal (getf a :run-id) (getf b :run-id))
           (> (parse-integer (getf a :attempt)) (parse-integer (getf b :attempt))))))

(defun ci-status (&optional (ref "HEAD"))
  "Nessun fallback verde: seleziona solo source-id e policy-id della revisione richiesta."
  (let* ((identity (ci-source ref)) (index-path (merge-pathnames "spikes/results/ci/index.lisp" *ci-root*))
         (index (when (ci-regular-file-p index-path) (ci-read index-path)))
         (entries (remove-if-not
                   (lambda (r) (and (equal (getf r :source-id) (getf identity :source-id))
                                    (equal (getf r :policy-id) (getf identity :policy-id))))
                   (getf index :runs)))
         (latest (first (sort entries #'ci-entry-newer-p))))
    (let ((report (list :schema-version 1 :kind :ci-status
                        :head-sha (getf identity :tested-sha) :source-id (getf identity :source-id)
                        :policy-id (getf identity :policy-id)
                        :status (cond ((null latest) :not-measured)
                                      ((not (getf latest :verification-passed)) :failed)
                                      ((not (getf latest :metrics-complete)) :partial)
                                      (t :passed))
                        :current-result latest)))
      (write-line (ci-wire-string report))
      (if (and latest (getf latest :collection-closed) (getf latest :verification-passed)) 0 1))))

(defun ci-boundary-self-test (out)
  (let ((cases nil) (root (ci-mkdir out)))
    (labels ((check (id thunk)
               (handler-case (push (list :id id :status (if (funcall thunk) :passed :failed)) cases)
                 (error (c) (push (list :id id :status :failed :reason (princ-to-string c)) cases))))
             (rejects (thunk) (handler-case (progn (funcall thunk) nil) (error () t))))
      (check :unknown-denominator-is-incomplete
             (lambda () (not (ci-metrics-valid-p '(:job "verify-linux" :metrics (:planned nil :passed 0))))))
      (check :known-zero-is-measured
             (lambda () (ci-metrics-valid-p '(:job "verify-linux" :metrics
                        (:planned 0 :passed 0 :failed 0 :not-run 0 :skipped 0)))))
      (check :measurement-identity-rejects-missing-fields
             (lambda () (rejects (lambda () (ci-validate-measure-identity '(:tested-sha "fixture"))))))
      (check :measurement-identity-handoff
             (lambda ()
               (let ((*ci-measure-coordinator-identity*
                       (list :tested-sha (make-string 40 :initial-element #\a)
                             :source-id (make-string 64 :initial-element #\b)
                             :policy-id (make-string 64 :initial-element #\c))))
                 (and (ci-validate-measure-identity *ci-measure-coordinator-identity*)
                      (equal *ci-measure-coordinator-identity* (ci-measure-source-fingerprint))))))
      (check :missing-plan-is-not-closed
             (lambda () (let* ((dir (ci-mkdir (merge-pathnames "empty/" root)))
                              (summary (ci-collect dir)))
                         (and (null (getf summary :collection-closed))
                              (null (getf summary :metrics-complete))
                              (null (getf summary :verification-passed))
                              (= 6 (length (getf summary :jobs)))))))
      (check :coverage-summary-keeps-complete-raw-inventory
             (lambda ()
               (let* ((out (ci-mkdir (merge-pathnames "coverage-summary/" root)))
                      (work (ci-mkdir (merge-pathnames "work/" out)))
                      (files (loop for i below 600 collect
                               (list :path (format nil "src/~A/unit-~D.lisp"
                                                   (make-string 100 :initial-element #\x) i)
                                     :tracked t :asdf t :blob (make-string 40 :initial-element #\a))))
                      (data (list :expected-files files :totals '(:status :measured :expected-files 600)
                                  :missing-files nil :excluded-tests '((:id "fixture" :normal-status :passed))
                                  :tests-status :passed :uninstrumented-children '("fixture-child")))
                      (metrics (ci-compact-metrics data "coverage"))
                      (result (list :job "sealed" :status :passed :metrics
                                    (list :jobs (list (list :job "coverage" :status :passed :metrics metrics)))))
                      (raw (merge-pathnames "coverage.lisp" work)))
                 (ci-save raw data)
                 (let* ((packet (ci-pack-job out work "sealed" '(:source-id "fixture") result))
                        (stored (merge-pathnames "raw/coverage.lisp" packet)))
                   (and (> (ci-bytes raw) 65536)
                        (= 600 (getf metrics :expected-files))
                        (every (lambda (key) (equal (getf data key) (getf metrics key)))
                               '(:totals :missing-files :excluded-tests :tests-status :uninstrumented-children))
                        (< (ci-bytes (merge-pathnames "result.lisp" packet)) 65536)
                        (equal result (ci-read (merge-pathnames "result.lisp" packet)))
                        (equal data (arcdocdb.evidence:read-evidence stored)))))))
      (check :small-raw-log-is-compressed-losslessly
             (lambda ()
               (let* ((out (ci-mkdir (merge-pathnames "small-raw/" root)))
                      (work (ci-mkdir (merge-pathnames "work/" out)))
                      (raw (merge-pathnames "stdout.txt" work)))
                 (with-open-file (s raw :direction :output :if-exists :error)
                   (dotimes (i 400) (format s "Diagnostica ripetuta della prova.~%")))
                 (let* ((packet (ci-pack-job out work "audit" '(:source-id "fixture")
                                             '(:job "audit" :status :passed)))
                        (stored (merge-pathnames "raw/stdout.txt" packet))
                        (data (ci-read stored)))
                   (and (< 4096 (ci-bytes raw) 65536)
                        (eq :compressed-evidence (getf data :kind))
                        (< (+ (ci-bytes stored) (getf data :compressed-bytes)) (ci-bytes raw))
                        (arcdocdb.evidence:call-with-evidence-bytes
                         stored (lambda (path)
                                  (string= (ci-sha256 raw) (ci-sha256 (truename path))))))))))
      (check :coverage-compaction-preserves-incomplete-proof
             (lambda ()
               (let* ((data '(:totals (:status :measured) :expected-files nil
                              :missing-files nil :excluded-tests ((:normal-status :not-run))))
                      (metrics (ci-compact-metrics data "coverage")))
                 (and (equal (getf data :excluded-tests) (getf metrics :excluded-tests))
                      (not (ci-metrics-valid-p (list :job "coverage" :metrics metrics)))))))
      (check :coverage-compaction-keeps-unavailable-inventory-unknown
             (lambda ()
               (null (getf (ci-compact-metrics '(:status :failed) "coverage") :expected-files))))
      (check :coverage-compaction-keeps-measured-empty-inventory-zero
             (lambda ()
               (eql 0 (getf (ci-compact-metrics '(:expected-files nil
                                                :totals (:status :measured :expected-files 0)) "coverage")
                             :expected-files))))
      (check :duplicate-cli-option
             (lambda () (rejects (lambda () (ci-options '("--job" "audit" "--job" "bench") '("--job"))))))
      (check :zip-truncated-is-rejected
             (lambda () (let ((p (merge-pathnames "bad.zip" root)))
               (with-open-file (s p :direction :output :if-exists :error :element-type '(unsigned-byte 8))
                 (write-sequence #(80 75 3 4) s))
               (rejects (lambda () (ci-zip-inventory p))))))
      (check :packet-inventory-closed
             (lambda ()
               (let* ((out (ci-mkdir (merge-pathnames "packet-case/" root)))
                      (work (ci-mkdir (merge-pathnames "work/" out)))
                      (packet (ci-pack-job out work "audit" '(:source-id "fixture")
                                          '(:job "audit" :status :failed :metrics nil))))
                 (ci-save (merge-pathnames "undeclared.lisp" packet) nil)
                 (rejects (lambda () (ci-verify-packet packet))))))
      (check :gzip-expansion-is-bounded
             (lambda () (let* ((plain (merge-pathnames "plain.txt" root))
                               (gzip (merge-pathnames "plain.txt.gz" root)))
               (with-open-file (s plain :direction :output :if-exists :error)
                 (dotimes (n 1024) (write-char #\x s)))
               (with-open-file (s gzip :direction :output :if-exists :error :element-type '(unsigned-byte 8))
                 (uiop:run-program (list "gzip" "-n" "-c" (namestring plain)) :output s))
               (and (= 1024 (ci-verify-gzip gzip 1024 (ci-sha256 plain) 1024))
                    (rejects (lambda () (ci-verify-gzip gzip 1024 (ci-sha256 plain) 1023)))))))
      (check :packet-dedup-is-idempotent
             (lambda ()
               (let* ((out (ci-mkdir (merge-pathnames "dedup-case/" root)))
                      (work (ci-mkdir (merge-pathnames "work/" out)))
                      (packet (ci-pack-job out work "audit" '(:source-id "fixture")
                                          '(:job "audit" :status :failed :metrics nil)))
                      (copy (ci-copy-packet packet (merge-pathnames "copy/" root))))
                 (string= (ci-packet-digest packet) (ci-packet-digest copy)))))
      (let* ((failed (count :failed cases :key (lambda (r) (getf r :status))))
             (report (list :schema-version 1 :kind :ci-boundary-self-test :status (if (zerop failed) :passed :failed)
                           :planned (length cases) :passed (- (length cases) failed) :failed failed
                           :cases (nreverse cases))))
        (ci-save (merge-pathnames "report.lisp" root) report) report))))

(defun ci-self-test (out)
  (let ((root (ci-mkdir out)) (reports nil))
    (dolist (spec '(("data" ci-data-self-test) ("tests" ci-test-self-test)
                    ("conditions" ci-conditions-self-test)
                    ("measure" ci-measure-self-test) ("workflow" ci-workflow-self-test)
                    ("boundaries" ci-boundary-self-test) ("publication" ci-publication-self-test)))
      (let* ((path (merge-pathnames (format nil "~A/" (first spec)) root))
             (prepared (when (equal (first spec) "tests") (ci-mkdir path)))
             (report (handler-case (funcall (second spec) path)
                       (error (c) (list :status :failed :planned 1 :passed 0 :failed 1 :reason (princ-to-string c))))))
        (declare (ignore prepared))
        (ci-save (merge-pathnames (format nil "~A.lisp" (first spec)) root) report)
        (let ((counts (or (getf report :counts) report)))
          (push (list :module (first spec) :status (getf report :status)
                      :planned (getf counts :planned) :passed (getf counts :passed)
                      :failed (getf counts :failed) :not-run (getf counts :not-run 0)) reports))))
    (let ((report (list :schema-version 1 :kind :ci-self-test
                        :status (if (every (lambda (r) (eq :passed (getf r :status))) reports) :passed :failed)
                        :modules (nreverse reports))))
      (ci-save (merge-pathnames "report.lisp" root) report)
      (write-line (ci-wire-string report)) report)))

(defun ci-child-bounded (job out)
  (handler-case
      (sb-ext:with-timeout (if (string= job "bench") 180 1500)
        (ci-child job out))
    (serious-condition (c)
      (let ((path (merge-pathnames "child-result.lisp" (ci-directory out))))
        (unless (ci-lstat path)
          (ci-save path (list :schema-version 1 :kind :ci-child-failure :status :failed
                              :job job :reason (princ-to-string c)))))
      (format *error-output* "~&Child CI: ~A~%" c) 1)))

(defun ci-main (args)
  (let ((command (pop args)))
    (cond
      ((equal command "plan")
       (let ((options (ci-options args '("--out"))))
         (ci-plan (ci-required options "--out")) 0))
      ((member command '("run" "child") :test #'equal)
       (let* ((options (ci-options args '("--job" "--out")))
              (job (ci-required options "--job")) (out (ci-required options "--out")))
         (if (equal command "child") (ci-child-bounded job out)
             (if (eq :passed (getf (ci-run-job job out) :status)) 0 1))))
      ((equal command "seal")
       (let* ((options (ci-options args '("--input" "--out")))
              (summary (ci-seal (ci-required options "--input") (ci-required options "--out"))))
         (if (and (getf summary :collection-closed) (getf summary :verification-passed)) 0 1)))
      ((equal command "self-test")
       (let* ((options (ci-options args '("--out")))
              (report (ci-self-test (ci-required options "--out"))))
         (if (eq :passed (getf report :status)) 0 1)))
      ((equal command "status")
       (ci-status (ci-option (ci-options args '("--ref")) "--ref" "HEAD")))
      ((equal command "publish")
       (let ((options (ci-options args '("--run-id" "--attempt" "--dry-run"))))
         (multiple-value-bind (state path)
             (ci-publish (ci-required options "--run-id") (ci-required options "--attempt")
                         :dry-run (ci-option options "--dry-run"))
           (format t "~&~A: ~A~%" state path) 0)))
      ((equal command "reconcile")
       (ci-reconcile (parse-integer (ci-option (ci-options args '("--limit")) "--limit" "100"))))
      (t (error "Uso: tools/ci.lisp plan|run|seal|self-test|status|publish|reconcile opzioni.")))))
