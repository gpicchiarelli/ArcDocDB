;;;; C4: oracolo wire indipendente, nessun caricamento del prodotto o ASDF.
;;; REQ: REQ-SEC-008 REQ-VAL-001
(defpackage #:arcdocdb.fulltext.golden (:use #:cl))
(in-package #:arcdocdb.fulltext.golden)
(defun bytes (string) (map 'list #'char-code string))
(defun crc (buffer start end)
  (let ((value #xffffffff))
    (loop for i from start below end do
      (setf value (logxor value (aref buffer i)))
      (dotimes (bit 8) (setf value (logxor (ash value -1) (if (oddp value) #x82f63b78 0)))))
    (logxor value #xffffffff)))
(defun le (buffer start value size)
  (dotimes (i size) (setf (aref buffer (+ start i)) (mod (floor value (expt 256 i)) 256))))
(defun header (major value)
  (let ((n (cond ((< value 24) 0) ((< value 256) 1) ((< value 65536) 2) ((< value (expt 2 32)) 4) (t 8))))
    (cons (+ (* major 32) (if (zerop n) value (ecase n (1 24) (2 25) (4 26) (8 27))))
          (loop for i downfrom (1- n) to 0 collect (mod (floor value (expt 256 i)) 256)))))
(defun cbor (value)
  (etypecase value
    (integer (header 0 value))
    (string (append (header 3 (length value)) (bytes value)))
    (list (append (header 4 (length value)) (mapcan #'cbor value)))))
(defun fixture ()
  (let* ((hint #(72 73 78 84))
         (meta (cbor (list 1 1 1 64 4 (crc hint 0 4) 2 "unicode-word-18.0.0-v1" 1
                          '((1 "body" ("body"))) '(16777216 1024 1048576 67108864 268435456) 2)))
         (sizes (list (length meta) 64 9 48 16 32)) (starts nil) (cursor 208))
    (dolist (size sizes) (push cursor starts) (incf cursor size)
      ;; LENGTHS termina gia su multiplo di 8: nessun padding finale viene aggiunto.
      (setf cursor (* 8 (ceiling cursor 8))))
    (setf starts (nreverse starts))
    (let* ((size (+ cursor 4)) (buffer (make-array size :element-type '(unsigned-byte 8) :initial-element 0)))
      (replace buffer (bytes "ARCDIDX1"))
      (le buffer 8 2 2) (le buffer 10 5 2) (le buffer 12 6 2)
      (dotimes (i 16) (setf (aref buffer (+ 16 i)) i))
      (le buffer 32 7 8) (le buffer 40 size 8) (le buffer 48 64 8)
      (loop for begin in starts for n in sizes for i from 0 do
        (le buffer (+ 64 (* i 24)) (1+ i) 2)
        (le buffer (+ 72 (* i 24)) begin 8) (le buffer (+ 80 (* i 24)) n 8))
      (replace buffer meta :start1 (first starts))
      (let ((d (second starts)))
        (le buffer d 1 2) (le buffer (+ d 4) 5 4) (le buffer (+ d 24) 1 8)
        (le buffer (+ d 32) 1 2) (le buffer (+ d 36) 4 4)
        (le buffer (+ d 40) 5 8) (le buffer (+ d 48) 1 8) (le buffer (+ d 56) 2 8))
      (replace buffer (bytes "alphabeta") :start1 (third starts))
      (let ((p (fourth starts)))
        (le buffer (+ p 4) 2 4)
        (le buffer (+ p 20) 1 4) (le buffer (+ p 24) 2 8)
        (le buffer (+ p 32) 1 4) (le buffer (+ p 36) 1 4) (le buffer (+ p 40) 3 8))
      (loop for p in '(0 2 1 0) for i from 0 do (le buffer (+ (fifth starts) (* i 4)) p 4))
      (let ((p (sixth starts)))
        (le buffer (+ p 4) 1 2) (le buffer (+ p 8) 3 4)
        (le buffer (+ p 16) 1 4) (le buffer (+ p 20) 1 2) (le buffer (+ p 24) 1 4))
      (le buffer 56 (crc buffer 0 56) 4) (le buffer (- size 4) (crc buffer 64 (- size 4)) 4)
      buffer)))
(defun self-test ()
  (assert (= #xe3069283 (crc (coerce (bytes "123456789") 'vector) 0 9)))
  (assert (equal '(27 255 255 255 255 255 255 255 255) (header 0 (1- (expt 2 64)))))
  (assert (equal '(131 1 97 97 128) (cbor '(1 "a" nil))))
  (assert (handler-case (progn (cbor #\A) nil) (type-error () t)))
  (format t "(:schema-version 1 :kind :fulltext-golden-self-test :status :ok)~%"))
(defun check-fixture (path)
  (with-open-file (stream path)
    (let ((values nil) (high nil))
      (loop for ch = (read-char stream nil) while ch do
        (unless (find ch '(#\Space #\Tab #\Newline #\Return))
          (let ((digit (digit-char-p ch 16)))
            (unless digit (error "Fixture hex malformata"))
            (if high (progn (push (+ (* high 16) digit) values) (setf high nil)) (setf high digit)))))
      (when high (error "Nibble finale incompleto"))
      (assert (equalp (coerce (nreverse values) 'vector) (fixture)))))
  (format t "(:schema-version 1 :kind :fulltext-golden-reproducibility :status :ok)~%"))
(let ((args (cdr sb-ext:*posix-argv*)))
  (cond ((equal args '("--self-test")) (self-test))
        ((and (= 2 (length args)) (string= (first args) "--check")) (check-fixture (second args)))
        ((and (= 2 (length args)) (string= (first args) "--generate"))
         (let ((buffer (fixture)))
           (ensure-directories-exist (second args))
           (with-open-file (stream (second args) :direction :output :if-exists :error)
             (loop for byte across buffer for i from 0 do
               (format stream "~2,'0X" byte) (when (= 15 (mod i 16)) (terpri stream)))
             (terpri stream))
           (format t "(:schema-version 1 :kind :fulltext-golden :bytes ~D :header-crc ~D :payload-crc ~D)~%"
                   (length buffer) (crc buffer 0 56) (crc buffer 64 (- (length buffer) 4)))))
        (t (error "Uso: --self-test | --generate/--check file-hex"))))
