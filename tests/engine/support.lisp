(defpackage #:arcdocdb.engine.tests
  (:use #:cl)
  (:local-nicknames (#:e #:arcdocdb.engine))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:export #:run #:child-main))
(in-package #:arcdocdb.engine.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defun bytes (n &optional (byte 0)) (make-array n :element-type '(unsigned-byte 8) :initial-element byte))
(defun archive-id () (bytes 16 73))
(defun series-id () (bytes 16 41))
(defun key (n) (bytes 16 n))
(defun value (n) (bytes 23 (+ 128 n)))
(defun open-engine (root &key create (version 2) observer (arena-bytes 2048))
  (e:apri-motore root (archive-id) (series-id) :create create :version version
    :clock (lambda () 10) :observer observer :max-file-bytes 8192 :max-record-bytes 256
    :max-records 32 :max-segments 16 :index-capacity 32 :key-arena-bytes arena-bytes))
(defmacro with-root ((root) &body body)
  `(let ((,root (arcdocdb.get.active.tests::active-fresh-root)) (success nil))
     (unwind-protect (prog1 (progn ,@body) (setf success t))
       (if success (uiop:delete-directory-tree ,root :validate t)
           (format *error-output* "~&ENGINE-ROOT-RETAINED ~A~%" ,root)))))
(defmacro with-engine ((engine expression) &body body)
  `(let ((,engine ,expression)) (unwind-protect (progn ,@body) (e:chiudi-motore ,engine))))
(defun check-get (engine id expected)
  (let ((target (bytes 64 204)))
    (multiple-value-bind (status size) (e:leggi-documento engine (key id) target :start 3)
      (is (eq status (if expected :found :absent)))
      (is (= size (if expected (length expected) 0)))
      (when expected (is (equalp expected (subseq target 3 (+ 3 size)))))
      (is (every (lambda (n) (= n 204)) (subseq target 0 3)))
      (is (every (lambda (n) (= n 204)) (subseq target (if expected 26 3)))))))
(defun check-frontier (engine expected)
  (let ((observed (multiple-value-list (e:frontiere-motore engine))))
    (unless (equal (list 0 expected 0 expected) observed)
      (error "ENGINE-ORACLE-MISMATCH expected=~D observed=~S" expected observed))))
(defun image (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((data (bytes (file-length stream)))) (is (= (read-sequence data stream) (length data))) data)))
(defun images (root &optional only-segments)
  (loop for path in (uiop:directory-files root)
        when (or (not only-segments) (search ".seg" (file-namestring path)))
        collect (cons (file-namestring path) (image path))))
(defun check-images (root originals)
  (dolist (entry originals) (is (equalp (cdr entry) (image (merge-pathnames (car entry) root))))))
(defun reject-index-limit (root engine id reason)
  (let ((frontier (multiple-value-list (e:frontiere-motore engine)))
        (originals (images root)) (seen nil))
    (handler-case (e:scrivi-documento engine (key id) (value id))
      (arcdocdb.conditions:resource-exhausted (condition)
        (is (eq reason (arcdocdb.conditions:error-reason condition))) (setf seen t)))
    (is seen)
    (unless (eq :ready (e:stato-motore engine))
      (error "ENGINE-ADMISSION-ORACLE-MISMATCH expected=READY observed=~S" (e:stato-motore engine)))
    (is (equal frontier (multiple-value-list (e:frontiere-motore engine))))
    (check-images root originals)))
(defun check-segment-images (root originals)
  ;; Il recovery puo' completare esclusivamente .seg.tmp -> .seg: stessi ID e byte.
  ;; L'oracolo non cerca un contenuto uguale in altri file e rifiuta nomi doppi.
  (dolist (entry originals)
    (let* ((name (car entry))
           (was-temporary (and (= 24 (length name)) (string= ".seg.tmp" name :start2 16))))
      (is (or was-temporary (and (= 20 (length name)) (string= ".seg" name :start2 16))))
      (let* ((stem (subseq name 0 16))
             (temporary (merge-pathnames (concatenate 'string stem ".seg.tmp") root))
             (final (merge-pathnames (concatenate 'string stem ".seg") root))
             (old-present (probe-file temporary)) (final-present (probe-file final)))
        (is (not (and old-present final-present)))
        (is (if was-temporary (or old-present final-present) final-present))
        (is (equalp (cdr entry) (image (if old-present temporary final))))))))
(defun initial-workload (engine)
  (is (= 1 (e:scrivi-documento engine (key 1) (value 1))))
  (is (= 2 (e:scrivi-documento engine (key 2) (value 2))))
  (is (= 3 (e:scrivi-documento engine (key 1) (value 3))))
  (is (= 4 (e:cancella-documento engine (key 2))))
  (is (= 5 (e:scrivi-documento engine (key 3) (value 4)))))
(defun check-initial (engine)
  (check-get engine 1 (value 3)) (check-get engine 2 nil) (check-get engine 3 (value 4))
  (check-frontier engine 5))
(defun resumed-workload (engine)
  (is (= 6 (e:scrivi-documento engine (key 5) (value 7))))
  (is (= 7 (e:scrivi-documento engine (key 3) (value 8))))
  (is (= 8 (e:cancella-documento engine (key 1))))
  (is (= 9 (e:cancella-documento engine (key 5)))))
(defun check-resumed (engine)
  (check-get engine 1 nil) (check-get engine 2 nil) (check-get engine 3 (value 8))
  (check-get engine 5 nil) (check-frontier engine 9))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~S~%" (list :kind :production-engine-tests :status :passed :tests (length *tests*)
                         :benchmark nil :power-loss-qualification nil))
  t)
