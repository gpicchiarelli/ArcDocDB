;;;; Codec di riferimento manuale, non usa costanti, writer, CRC o sonda del prodotto.
;;; REQ: REQ-IDX-009 REQ-LIM-003
(in-package #:arcdocdb.index.page.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defun raw-page (size kind body count parameter &key (next 0) (next-generation 0)
                     (page (* size 4096)) (generation 7) (image 91) (prefix 11))
  (let* ((end (+ prefix size)) (buffer (bytes (+ end 13) #xad)))
    (fill buffer 0 :start prefix :end end)
    (replace buffer #(65 82 67 73 80 71 48 49) :start1 prefix)
    (ref-write buffer (+ prefix 8) 1 2)
    (ref-write buffer (+ prefix 10) (ecase kind (:bucket 1) (:directory 2) (:chiave 3)) 1)
    (ref-write buffer (+ prefix 11) (ecase size (4096 12) (16384 14) (65536 16)) 1)
    (replace buffer (series) :start1 (+ prefix 16))
    (ref-write buffer (+ prefix 32) image 8)
    (ref-write buffer (+ prefix 40) page 8)
    (ref-write buffer (+ prefix 48) generation 8)
    (ref-write buffer (+ prefix 56) (length body) 4)
    (ref-write buffer (+ prefix 60) count 4)
    (ref-write buffer (+ prefix 64) next 8)
    (ref-write buffer (+ prefix 72) next-generation 8)
    (ref-write buffer (+ prefix 80) parameter 4)
    (replace buffer body :start1 (+ prefix 96))
    (repair buffer prefix end)
    (values buffer prefix end (identita-fixture size :page page :generation generation :image image))))

(defun bucket-body (size keys &key (collision nil) (external nil))
  "Chiavi in ordine d'inserimento; fingerprint 5, gruppi percorsi in sequenza."
  (let* ((cap (capacity size)) (slots (bytes cap 255)) (positions nil)
         (used (* cap 65)))
    (loop for key in keys for i from 0 do
      (let* ((group (* 16 (if collision 0 (mod i (floor cap 16)))))
             (low (+ 5 (* 128 group)))
             (slot (loop for step below cap for pos = (mod (+ group step) cap)
                         when (= (aref slots pos) 255) return pos)))
        (unless slot (error "Fixture senza slot libero"))
        (setf (aref slots slot) 5)
        (push (list slot low key) positions)
        (unless external (incf used (length key)))))
    (let ((body (bytes used)) (cursor (* cap 65)))
      (replace body slots)
      (dolist (item (sort positions #'< :key #'first))
        (destructuring-bind (slot low key) item
          (let ((entry (+ cap (* slot 64))))
            (ref-write body entry (+ low (ash #x89abcdef 32)) 8)
            (ref-write body (+ entry 8) #xffffffffffffffff 8)
            (ref-write body (+ entry 16) #xffffffff00000070 8)
            (ref-write body (+ entry 24) (+ 25 (length key)) 4)
            (ref-write body (+ entry 28) (length key) 2)
            (if external
                (progn (ref-write body (+ entry 30) 1 2)
                       (ref-write body (+ entry 40) (* size 100) 8)
                       (ref-write body (+ entry 48) 7 8))
                (progn (ref-write body (+ entry 32) cursor 4)
                       (replace body key :start1 cursor) (incf cursor (length key)))))))
      body)))

(defun directory-body (bits size &key (empty nil))
  (let ((body (bytes (* 16 (expt 2 bits)))))
    (unless empty
      (dotimes (i (expt 2 bits))
        (ref-write body (* i 16) (* size (1+ i)) 8)
        (ref-write body (+ (* i 16) 8) 7 8)))
    body))

(defun roundtrip (size kind body count parameter &key (next 0) (next-generation 0)
                       (page (* size 4096)))
  (multiple-value-bind (expected start end id)
      (raw-page size kind body count parameter :next next :next-generation next-generation :page page)
    (let* ((before (copy-seq expected)) (input (bytes (+ 7 (length body)) #xa7))
           (destination (bytes (length expected) #xad))
           (plan (p:crea-descrittore-pagina id kind count parameter
                                           :next next :next-generation next-generation)))
      (replace input body :start1 3)
      (let ((copy (copy-seq input)))
        (is (= end (p:scrivi-pagina-indice destination start end plan input 3 (+ 3 (length body)))))
        (is (equalp input copy)))
      (is (equalp expected destination))
      (is (equal (list kind count parameter (length body) next next-generation)
                 (multiple-value-list (p:verifica-pagina-indice expected start end id))))
      (is (equalp before expected)))))
