;;;; Workload e crash: dati attesi fissati prima delle chiamate di prodotto.
(in-package #:arcdocdb.vertical.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defun kill-writer (stage)
  (format t "~&CRASH-READY ~S pid=~D~%" stage (sb-posix:getpid))
  (finish-output)
  (sb-posix:kill (sb-posix:getpid) sb-posix:sigkill)
  (error "SIGKILL non ha arrestato il processo."))

(defun initial-workload (env)
  (commit-record env 1 1 (key-bytes 1) (value-bytes 1) 1)
  (check-get env (key-bytes 1) (value-bytes 1))
  (commit-record env 1 1 (key-bytes 2) (value-bytes 2) 2)
  (check-get env (key-bytes 2) (value-bytes 2))
  (commit-record env 1 1 (key-bytes 1) (value-bytes 3) 3)
  (check-get env (key-bytes 1) (value-bytes 3))
  (commit-record env 1 2 (key-bytes 2) (bytes 0) 4)
  (check-get env (key-bytes 2) nil)
  (commit-record env 1 1 (key-bytes 3) (value-bytes 4) 5)
  (check-get env (key-bytes 3) (value-bytes 4)))

(defun rotate-and-write (env)
  (multiple-value-bind (prepared append manifest) (checkpoint env)
    (s:rilascia-controllore-serie (environment-controller env) (environment-lease env))
    (setf (environment-lease env) nil)
    (io:rinomina-nella-directory (environment-directory env) (segment-leaf 1 :temporary) (segment-leaf 1 :final))
    (io:rinomina-nella-directory (environment-directory env) (segment-leaf 2 :temporary) (segment-leaf 2 :final))
    (is (zerop (io:durable-flush (environment-directory env))))
    (start-active env prepared append (closed-maps env manifest))
    (check-get env (key-bytes 1) (value-bytes 3))
    (commit-record env 2 1 (key-bytes 4) (value-bytes 5) 6)
    (commit-record env 2 1 (key-bytes 3) (value-bytes 6) 7)
    (commit-record env 2 2 (key-bytes 1) (bytes 0) 8)
    (check-get env (key-bytes 1) nil)
    (check-get env (key-bytes 2) nil)
    (check-get env (key-bytes 3) (value-bytes 6))
    (check-get env (key-bytes 4) (value-bytes 5))))

(defun writer (env stage)
  (multiple-value-bind (prepared append) (prepare-active env 1)
    (bootstrap env prepared) (start-active env prepared append #())
    (initial-workload env)
    (ecase stage
      (:committed nil)
      (:tail
       (let ((record (bytes 128)) (start (io:posizione-scritta (environment-append env))))
         (arcdocdb.record:scrivi-record record 0 1 6 (key-bytes 1) (value-bytes 7)
                                       :version (environment-version env))
         (is (= (+ start 13) (io:append-esatto (environment-append env) record 0 13)))
         (is (= (+ start 13) (io:durable-flush (environment-append env))))))
      (:prepared (checkpoint env t))
      (:rotated (rotate-and-write env)))
    (kill-writer stage)))

(defun replay-index (env manifest)
  "Replay C4 di sole cornici ordinarie già verificate da tutte le mappe CLOSED."
  (let ((previous-csn 0) (count 0))
    (loop for id from 1 to 8 do
      (multiple-value-bind (state end outcomes) (mf:trova-segmento manifest id)
        (when (eq state :closed)
          (is (zerop outcomes))
          (let ((image (file-image (leaf env (segment-name env id)))) (position 64))
            (loop repeat 32 while (< position end) do
              (multiple-value-bind (next kind flags ks ke vs ve)
                  (arcdocdb.record:verifica-cornice image position end :version (environment-version env))
                (is (zerop flags)) (is (< position next))
                (let ((csn (b:leggi-u64 image (+ position 16))))
                  (ecase kind
                    ((1 2) (is (> csn previous-csn))
                     (publish-index env id position (- next position) csn kind (subseq image ks ke))
                     (setf previous-csn csn) (incf count))
                    (3 (is (= csn previous-csn)) (is (= 32 (- ve vs))))))
                (setf position next)))
            (is (= position end))))))
    (values previous-csn count)))

(defun verify-workload (env stage directory &optional wrong-expected)
  (let ((rotated (eq stage :rotated)))
    (check-get env (key-bytes 1) (unless rotated (value-bytes (if wrong-expected 7 3))) directory)
    (check-get env (key-bytes 2) nil directory)
    (check-get env (key-bytes 3) (value-bytes (if rotated 6 4)) directory)
    (check-get env (key-bytes 4) (when rotated (value-bytes 5)) directory)))

(defun segment-images (env)
  (loop for id from 1 to 8 append
    (loop for form in '(:temporary :final)
          for name = (segment-leaf id form)
          when (probe-file (leaf env name)) collect (cons name (file-image (leaf env name))))))

(defun verify (env stage recover-p &optional wrong-expected)
  (let ((originals (segment-images env)))
    (when recover-p (checkpoint env))
    (let* ((control (read-control env)) (manifest (c:manifest-control-recuperato control))
           ;; Verificare TUTTI i prefissi prima di pubblicare candidati nell'indice.
           (maps (closed-maps env manifest))
           (directory (gd:crea-directory-get-serie (environment-view env) maps)))
      (is (= (if (eq stage :rotated) 2 1) (gd:conta-segmenti-directory-get directory)))
      (multiple-value-bind (maximum count) (replay-index env manifest)
        (is (= (if (eq stage :rotated) 8 5) maximum count)))
      (verify-workload env stage directory wrong-expected)
      (dolist (entry originals)
        (is (equalp (cdr entry) (file-image (leaf env (car entry))))))
      (when (eq stage :tail)
        (multiple-value-bind (state prefix outcomes) (mf:trova-segmento manifest 1)
          (is (eq state :closed)) (is (zerop outcomes))
          (is (= 13 (- (length (file-image (leaf env (segment-name env 1)))) prefix)))))
      (when (eq stage :prepared)
        (is (probe-file (leaf env "unpublished-control.tmp")))
        (is (= 3 (mf:segmento-attivo manifest))))
      (format t "~&VERIFIED v~D ~S recovery=~S closed=~D originals-unchanged=~D~%"
              (environment-version env) stage recover-p (length maps) (length originals)))))
