;;;; Ripresa C4: base verificata, ambiente nuovo e secondo SIGKILL.
(in-package #:arcdocdb.vertical.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defun original-maximum (stage)
  (if (eq stage :rotated) 8 5))

(defun check-frontier (env expected)
  (is (equal (list 0 expected 0 expected)
             (multiple-value-list
              (arcdocdb.csn:leggi-frontiere-csn (environment-registry env))))))

(defun inspect-resume-base (env stage)
  "Base C4: namespace completo noto, record ordinari e ACTIVE verificato vuoto."
  (let* ((control (read-control env)) (manifest (c:manifest-control-recuperato control))
         (maps (closed-maps env manifest))
         (directory (gd:crea-directory-get-serie (environment-view env) maps))
         (active (read-active env control)))
    (is (equal '(64 64 :complete)
               (subseq (multiple-value-list (ra:frontiere-active-recuperato active)) 0 3)))
    (is (equal '(0 0 0 0 0 0) (multiple-value-list (ra:statistiche-active-recuperato active))))
    (multiple-value-bind (maximum count) (replay-index env manifest)
      (is (= (original-maximum stage) maximum count))
      (verify-workload env stage directory)
      maximum)))

(defun verify-resumed-workload (env stage directory)
  (check-get env (key-bytes 1) nil directory)
  (check-get env (key-bytes 2) nil directory)
  (check-get env (key-bytes 3) (value-bytes 8) directory)
  (check-get env (key-bytes 4) (when (eq stage :rotated) (value-bytes 5)) directory)
  (check-get env (key-bytes 5) nil directory))

(defun check-original-images (env originals)
  (dolist (entry originals)
    (is (equalp (cdr entry) (file-image (leaf env (car entry)))))))

(defun resumed-workload (env id stage base)
  (commit-record env id 1 (key-bytes 5) (value-bytes 7) (+ base 1))
  (check-frontier env (+ base 1))
  (check-get env (key-bytes 5) (value-bytes 7))
  (commit-record env id 1 (key-bytes 3) (value-bytes 8) (+ base 2))
  (check-frontier env (+ base 2))
  (check-get env (key-bytes 3) (value-bytes 8))
  (commit-record env id 2 (key-bytes 1) (bytes 0) (+ base 3))
  (check-frontier env (+ base 3))
  (check-get env (key-bytes 1) nil)
  (commit-record env id 2 (key-bytes 5) (bytes 0) (+ base 4))
  (check-frontier env (+ base 4))
  (verify-resumed-workload env stage nil))

(defun resume-writes (env stage base)
  (let ((originals (segment-images env)))
    (multiple-value-bind (prepared append manifest) (checkpoint env)
      (let* ((maps (closed-maps env manifest)) (id (mf:segmento-attivo manifest)))
        (multiple-value-bind (maximum count) (replay-index env manifest)
          (is (= base maximum count)))
        (start-active env prepared append maps)
        (verify-workload env stage nil)
        (handler-bind
            ((oracle-csn-mismatch
               (lambda (condition)
                 (declare (ignore condition))
                 ;; Il negativo deve fallire prima della prima append, non solo sul GET finale.
                 (is (= 64 (io:posizione-scritta append) (io:posizione-durevole append)
                        (length (file-image (leaf env (segment-name env id))))))
                 (format t "~&REJECTED-CSN-BEFORE-APPEND~%")
                 (finish-output))))
          (resumed-workload env id stage base))
        (check-original-images env originals)
        (format t "~&RESUMED v~D ~S base=~D last=~D H=~D~%"
                (environment-version env) stage base (+ base 4) (+ base 4))
        (kill-writer :resumed)))))

(defun resume-process (root version stage wrong-base)
  (let ((base (let ((inspector (make-environment root version)))
                (unwind-protect (inspect-resume-base inspector stage)
                  (close-environment inspector)))))
    (let* ((initial (if wrong-base 0 base))
           (env (make-environment root version :initial-csn initial)))
      (unwind-protect
           (progn (check-frontier env initial) (resume-writes env stage base))
        (close-environment env)))))

(defun verify-resumed (env stage recover-p)
  (let ((originals (segment-images env)))
    (when recover-p (checkpoint env))
    (let* ((control (read-control env)) (manifest (c:manifest-control-recuperato control))
           (maps (closed-maps env manifest))
           (directory (gd:crea-directory-get-serie (environment-view env) maps)))
      (is (= (if (eq stage :rotated) 4 3) (gd:conta-segmenti-directory-get directory)))
      (multiple-value-bind (maximum count) (replay-index env manifest)
        (is (= (if (eq stage :rotated) 12 9) maximum count)))
      (verify-resumed-workload env stage directory)
      (check-original-images env originals)
      (when (eq stage :tail)
        (multiple-value-bind (state prefix outcomes) (mf:trova-segmento manifest 1)
          (is (eq state :closed)) (is (zerop outcomes))
          (is (= 13 (- (length (file-image (leaf env (segment-name env 1)))) prefix)))))
      (when (eq stage :prepared)
        (is (probe-file (leaf env "unpublished-control.tmp")))
        (is (= 5 (mf:segmento-attivo manifest))))
      (format t "~&REVERIFIED v~D ~S recovery=~S last=~D originals-unchanged=~D~%"
              (environment-version env) stage recover-p
              (if (eq stage :rotated) 12 9) (length originals)))))

(defun child-main (arguments)
  (destructuring-bind (mode root version stage) arguments
    (let ((root (uiop:ensure-directory-pathname root)) (version (parse-integer version))
          (stage (cond ((string-equal stage "committed") :committed)
                       ((string-equal stage "tail") :tail)
                       ((string-equal stage "prepared") :prepared)
                       ((string-equal stage "rotated") :rotated)
                       (t (error "Punto di arresto sconosciuto: ~A" stage)))))
      (if (member mode '("resume" "resume-wrong-csn") :test #'string=)
          (resume-process root version stage (string= mode "resume-wrong-csn"))
          (let ((env (make-environment root version)))
            (unwind-protect
                 (cond ((string= mode "write") (writer env stage))
                       ((string= mode "recover") (verify env stage t))
                       ((string= mode "verify") (verify env stage nil))
                       ((string= mode "verify-wrong") (verify env stage nil t))
                       ((string= mode "recover-resumed") (verify-resumed env stage t))
                       ((string= mode "verify-resumed") (verify-resumed env stage nil))
                       (t (error "Modalità sconosciuta: ~A" mode)))
              (close-environment env)))))))
