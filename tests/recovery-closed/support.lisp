;;;; Fixture CLOSED: oracoli bytewise/CRC bitwise, CONTROL reale e input readonly.
;;; OWNER: runner seriale, <=8 capacità complessive incluso CONTROL, file <=4096, eventi <=32768.
;;; SHARED: nessuna FI globale o worker; i risultati si consegnano solo completi.
;;; REQ: REQ-REC-001 REQ-STO-006 REQ-TXM-007 REQ-AFF-008 REQ-AFF-009
(defpackage #:arcdocdb.recovery.closed.tests
  (:use #:cl)
  (:local-nicknames (#:cr #:arcdocdb.recovery.closed) (#:io #:arcdocdb.io)
                   (#:ct #:arcdocdb.control.tests) (#:rt #:arcdocdb.recovery.tests)
                   (#:av #:arcdocdb.recovery.active.tests) (#:rac #:arcdocdb.recovery.active.checkpoint.tests)
                   (#:da #:arcdocdb.recovery.archive) (#:c #:arcdocdb.control))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:import-from #:arcdocdb.conditions #:invalid-argument #:resource-exhausted #:corruption-detected
                #:invariant-violation #:unsupported-format #:io-fault #:error-reason #:error-offset)
  (:export #:run))
(in-package #:arcdocdb.recovery.closed.tests)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test recovery CLOSED superati.~%" (length *tests*)) t)
(defun cdr-record (kind stamp &rest options) (apply #'rac::ra-record kind stamp options))
(defun cdr-batch (csn &rest records) (apply #'rac::ra-batch csn records))
(defun cdr-header (version id origin)
  (let ((header (ct::control-reference-header (ct::crr-uuid) version t)))
    (setf (aref header 10) origin)
    (ct::crr-pack header 32 id 8)
    (ct::crr-pack header 56 (ct::crr-crc header 0 56) 4) header))
(defun cdr-seal (records start durable csn version id)
  (let ((body (ct::crr-bytes 32)) (checksums (apply #'ct::crr-cat (mapcar (lambda (r) (subseq r 0 4)) records))))
    (ct::crr-pack body 0 id 8) (ct::crr-pack body 8 start 8) (ct::crr-pack body 16 durable 8)
    (ct::crr-pack body 24 (length records) 4)
    (ct::crr-pack body 28 (ct::crr-crc checksums 0 (length checksums)) 4)
    (rt::reference-record 3 csn (ct::crr-bytes 0) body :version version)))
(defun cdr-log (batches &key (version 2) (id 2) (origin 1) records tail)
  "Solo oracoli: writer con lotti, compaction con record ordinari; terzo valore P prima della coda."
  (let ((chunks (list (cdr-header version id origin))) (layouts nil) (pos 64))
    (ecase origin
      (1 (dolist (batch batches)
           (let ((start pos) (offsets nil)
                 (encoded (mapcar (lambda (r) (rac::ra-encode-record r version)) (getf batch :records))))
             (dolist (record encoded) (push pos offsets) (push record chunks) (incf pos (length record)))
             (let ((seal (cdr-seal encoded start (getf batch :durable start) (getf batch :csn) version id))
                   (seal-start pos))
               (push seal chunks) (incf pos (length seal))
               (push (list :start start :records (nreverse offsets) :seal seal-start :end pos) layouts)))))
      (2 (dolist (record records)
           (let ((bytes (rac::ra-encode-record record version)))
             (push (list :start pos :records (list pos) :end (+ pos (length bytes))) layouts)
             (push bytes chunks) (incf pos (length bytes))))))
    (is (<= pos 4096))
    (when tail (push tail chunks))
    (values (apply #'ct::crr-cat (nreverse chunks)) (nreverse layouts) pos)))

(defun cdr-control-bytes (version closed)
  "ID massimo via EDIT delta legale; non richiede NEXT-ID u64 oltre il massimo nel primo snapshot."
  (let* ((maximal (remove-if-not (lambda (entry) (= (first entry) #xffffffffffffffff)) closed))
         (initial (remove-if (lambda (entry) (= (first entry) #xffffffffffffffff)) closed))
         (next (loop for entry in initial maximize (1+ (first entry)) into n finally (return (max 10 (or n 10)))))
         (first (ct::crr-log version (ct::crr-edit :active 9 :next next :closed initial))))
    (if maximal
        (ct::crr-cat first (ct::crr-batch (length first) (length first)
                           (list (list 0 (ct::crr-edit :active 0 :next 0 :closed maximal))) 19))
        first)))

(defstruct (cdr-fixture (:constructor %cdr-fixture))
  control control-input input backend id prefix version scratch source reference control-source view
  (reads 0) hook (short 4096) inputs
  (images (make-hash-table :test 'eql)) (references (make-hash-table :test 'eql))
  (paths (make-hash-table :test 'equal)) (closed (make-hash-table :test 'eql))
  (events (make-array 32768 :fill-pointer 0)))
(defun cdr-event (f event)
  (is (< (length (cdr-fixture-events f)) 32768)) (vector-push event (cdr-fixture-events f)))
(defun cdr-events (f) (coerce (cdr-fixture-events f) 'list))
(defun cdr-clear (f) (setf (cdr-fixture-reads f) 0 (fill-pointer (cdr-fixture-events f)) 0))
(defun cdr-transfer (f fd buffer start count offset)
  (let ((source (gethash fd (cdr-fixture-images f))))
    (is source) (is (not (gethash fd (cdr-fixture-closed f))))
    (let ((n (min count (cdr-fixture-short f) (max 0 (- (length source) offset)))))
      (replace buffer source :start1 start :end1 (+ start n) :start2 offset :end2 (+ offset n)) n)))
(defun cdr-forbidden (f operation &rest args)
  (cdr-event f (cons operation args)) (error 'invariant-violation :reason :closed-fixture-forbidden-io))
(defun cdr-backend (f)
  (io:make-backend
   (lambda (path mode) (is (eq mode :input)) (or (gethash path (cdr-fixture-paths f)) (error "Nome inatteso")))
   (lambda (fd buffer start count offset)
     (cdr-event f (list :read fd start count offset)) (incf (cdr-fixture-reads f))
     (if (cdr-fixture-hook f) (funcall (cdr-fixture-hook f) f fd buffer start count offset)
         (cdr-transfer f fd buffer start count offset)))
   (lambda (&rest args) (apply #'cdr-forbidden f :write args))
   (lambda (&rest args) (apply #'cdr-forbidden f :flush args))
   (lambda (&rest args) (apply #'cdr-forbidden f :directory-flush args))
   (lambda (fd) (is (gethash fd (cdr-fixture-images f))) (is (not (gethash fd (cdr-fixture-closed f))))
     (cdr-event f (list :close fd)) (setf (gethash fd (cdr-fixture-closed f)) t) 0)
   :identity (lambda (fd) (cdr-event f (list :identity fd)) (values 1 fd))
   :entry-identity (lambda (&rest args) (apply #'cdr-forbidden f :entry args))
   :rename (lambda (&rest args) (apply #'cdr-forbidden f :rename args))))
(defun cdr-register (f path fd bytes)
  (is (<= (length bytes) 4096))
  (setf (gethash path (cdr-fixture-paths f)) fd
        (gethash fd (cdr-fixture-images f)) (copy-seq bytes)
        (gethash fd (cdr-fixture-references f)) (copy-seq bytes))
  path)
(defun cdr-open (f path max-transfer)
  (let ((input (io:apri-lettura path :backend (cdr-fixture-backend f) :max-transfer max-transfer)))
    (push input (cdr-fixture-inputs f)) input))
(defun cdr-add-input (f bytes)
  (let* ((number (length (cdr-fixture-inputs f))) (fd (+ 501 number))
         (path (format nil "/closed-fixture/extra-~D.seg" fd)))
    (is (<= 2 number 7)) (cdr-register f path fd bytes) (cdr-open f path 4096)))
(defun cdr-with-fixture (source thunk &key (version 2) (id 2) (prefix (length source)) outcomes
                                         (closed nil closed-p) (short 4096) (max-transfer 4096))
  (is (<= (length source) 4096)) (is (plusp short))
  (let* ((entries (if closed-p closed (list (list id prefix outcomes))))
         (control (cdr-control-bytes version entries))
         (f (%cdr-fixture :id id :prefix prefix :version version :short short
                         :scratch (ct::crr-bytes (max 64 (length source)) #xa5)
                         :control-source control :view (ct::crr-view (ct::crr-uuid)))))
    (setf (cdr-fixture-backend f) (cdr-backend f))
    (cdr-register f "/closed-fixture/control.log" 501 control)
    (cdr-register f "/closed-fixture/segment.seg" 502 source)
    (setf (cdr-fixture-source f) (gethash 502 (cdr-fixture-images f))
          (cdr-fixture-reference f) (gethash 502 (cdr-fixture-references f)))
    (unwind-protect
         (progn
           (setf (cdr-fixture-control-input f) (cdr-open f "/closed-fixture/control.log" 4096)
                 (cdr-fixture-control f)
                 (c:leggi-control-recuperato (cdr-fixture-view f) (cdr-fixture-control-input f)
                   (length control) (ct::crr-bytes (length control)))
                 (cdr-fixture-input f) (cdr-open f "/closed-fixture/segment.seg" max-transfer))
           (cdr-clear f) (funcall thunk f))
      (dolist (input (cdr-fixture-inputs f))
        (unless (eq :closed (io:stato-file input)) (io:chiudi input))))))
(defun cdr-call (f &rest options)
  (apply #'cr:leggi-closed-recuperato (cdr-fixture-control f) (cdr-fixture-input f)
         (cdr-fixture-id f) (cdr-fixture-scratch f) options))
(defun cdr-noeffects (f)
  (loop for fd being the hash-keys of (cdr-fixture-images f) using (hash-value bytes)
        do (is (equalp bytes (gethash fd (cdr-fixture-references f)))))
  (is (equalp (arcdocdb.get::vista-get-serie-identity (cdr-fixture-view f)) (ct::crr-uuid)))
  (dolist (input (cdr-fixture-inputs f))
    (is (eq :open (io:stato-file input))) (is (eq :input (io:mode-file input)))
    (is (zerop (io:posizione-scritta input))) (is (zerop (io:posizione-durevole input))))
  (is (every (lambda (e) (member (first e) '(:read :identity))) (cdr-events f))))
(defun cdr-expect (type reason thunk &optional (offset nil offset-p))
  (if offset-p (av::av-expect type reason thunk offset) (av::av-expect type reason thunk)))
(declaim (notinline cdr-invoke))
(defun cdr-invoke (name &rest args) (apply (symbol-function name) args))
