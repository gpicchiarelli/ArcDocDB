(in-package #:arcdocdb.fulltext.analysis.tests)

(defun append-field (run space row field text &optional (quantum 4096))
  (analyzed text :space space)
  (arcdocdb.fulltext.index:inizia-campo-full-text run row field space)
  (loop repeat 100000 until (eq :building (arcdocdb.fulltext.index:passo-indice-posizionale run quantum))
        finally (is (eq :building (arcdocdb.fulltext.index::indice-posizionale-state run)))))
(defun seal (run &optional (quantum 4096))
  (arcdocdb.fulltext.index:sigilla-indice-posizionale run)
  (loop repeat 100000 until (eq :sealed (arcdocdb.fulltext.index:passo-indice-posizionale run quantum))
        finally (is (eq :sealed (arcdocdb.fulltext.index::indice-posizionale-state run)))))
(defun matches (run row field query mode)
  (arcdocdb.fulltext.index:corrisponde-riga-full-text run row field query mode))

(deftest req-sec-004-positional-phrases-and-versions
  (dolist (quantum '(1 13 4096))
    (let ((run (arcdocdb.fulltext.index:crea-indice-posizionale)) (space (small-space)) (query (small-space)))
      (append-field run space 0 1 "Articolo Caffè" quantum)
      (append-field run space 0 2 "uno due uno uno" quantum)
      (append-field run space 1 1 "Articolo" quantum)
      (append-field run space 1 2 "modificato" quantum)
      (append-field run space #xffffffff 1 "" quantum)
      (seal run quantum)
      (analyzed "CAFFÈ" :space query)
      (is (matches run 0 1 query :all)) (is (not (matches run 1 1 query :any)))
      (is (not (matches run 0 2 query :all)))
      (analyzed "uno uno" :space query)
      (is (matches run 0 2 query :phrase))
      (analyzed "due uno uno" :space query) (is (matches run 0 2 query :phrase))
      (analyzed "uno due uno uno uno" :space query)
      (is (matches run 0 2 query :all)) (is (not (matches run 0 2 query :phrase)))
      (analyzed "articolo modificato" :space query)
      (is (not (matches run 0 1 query :all))) (is (not (matches run 1 1 query :all)))
      (is (not (matches run 1 2 query :all)))
      (is (not (matches run #xffffffff 1 query :any)))
      (rejected (lambda () (append-field run space 2 1 "x")) 'invalid-argument :fulltext-index-input))))

(defun reference-match (words terms mode)
  (not (null (ecase mode
               (:all (every (lambda (term) (member term words :test #'equal)) terms))
               (:any (some (lambda (term) (member term words :test #'equal)) terms))
               (:phrase (search terms words :test #'equal))))))

(deftest req-sec-004-index-differential
  (let* ((run (arcdocdb.fulltext.index:crea-indice-posizionale))
         (space (small-space)) (query (small-space)) (reference (make-array '(120 3)))
         (seed 17) (vocabulary #("uno" "due" "tre" "caffè" "strasse")) (checks 0))
    (flet ((choose (n) (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32))) (mod seed n)))
      (dotimes (row 120)
        (dotimes (field 3)
          (let ((words (loop repeat (choose 15) collect (aref vocabulary (choose 5)))))
            (setf (aref reference row field) words)
            (append-field run space row (1+ field) (format nil "~{~A~^ ~}" words)))))
      (seal run)
      (dotimes (q 80)
        (let ((terms (loop repeat (1+ (choose 5)) collect
                          (let ((i (choose 6))) (if (= i 5) "assente" (aref vocabulary i))))))
          (analyzed (format nil "~{~A~^ ~}" terms) :space query)
          (dotimes (row 120)
            (dotimes (field 4)
              (dolist (mode '(:all :any :phrase))
                (incf checks)
                (is (eq (reference-match (if (< field 3) (aref reference row field) nil) terms mode)
                        (matches run row (1+ field) query mode)))))))))
    (format t "Run posizionale: ~D confronti con scansione indipendente.~%" checks)))

(deftest req-sec-010-index-capacity-and-state
  (let ((run (arcdocdb.fulltext.index:crea-indice-posizionale :max-tokens 1 :max-fields 1 :max-bytes 3))
        (space (small-space)))
    (analyzed "a b" :space space)
    (rejected (lambda () (arcdocdb.fulltext.index:inizia-campo-full-text run 0 1 space))
              'resource-exhausted :fulltext-index-capacity)
    (is (zerop (arcdocdb.fulltext.index::indice-posizionale-count run)))
    (append-field run space 0 1 "abc")
    (rejected (lambda () (append-field run space 0 1 "a")) 'invalid-argument :fulltext-field-order)
    (rejected (lambda () (append-field run space 0 2 "a")) 'resource-exhausted :fulltext-index-capacity)
    (seal run) (analyzed "abc" :space space) (is (matches run 0 1 space :all))
    (setf (a::spazio-full-text-work-limit space) (a::spazio-full-text-work space))
    (rejected (lambda () (matches run 0 1 space :all)) 'resource-exhausted :fulltext-analysis-work))
  (let ((run (arcdocdb.fulltext.index:crea-indice-posizionale)) (space (small-space)))
    (analyzed "a" :space space)
    (rejected (lambda () (matches run 0 1 space :all)) 'invalid-argument :fulltext-query-input)
    (seal run) (is (not (matches run 0 1 space :all)))
    (analyzed "!!!" :space space)
    (rejected (lambda () (matches run 0 1 space :all)) 'invalid-argument :fulltext-query-input))
  (rejected (lambda () (arcdocdb.fulltext.index:crea-indice-posizionale :max-memory 1))
            'resource-exhausted :fulltext-index-memory))
