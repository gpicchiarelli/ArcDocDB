(in-package #:arcdocdb.fulltext.codec.tests)

(deftest req-sec-008-codec-golden-independent
  (let ((reference (golden)) (run (sample-run)) (descriptor (descriptor)) (scratch (space)))
    (is (= 468 (length reference)))
    (is (equalp (meta) (subseq reference 208 (+ 208 (ft::ref-u64 reference 80)))))
    (is (= (ft::ref-crc reference 0 56) (logior (aref reference 56) (ash (aref reference 57) 8)
                                                               (ash (aref reference 58) 16) (ash (aref reference 59) 24))))
    (dotimes (prefix 32)
      (multiple-value-bind (buffer start end) (encode run descriptor scratch prefix)
        (is (equalp reference (subseq buffer start end)))
        (is (every (lambda (b) (= b #xac)) (subseq buffer 0 start)))
        (is (every (lambda (b) (= b #xac)) (subseq buffer end)))
        (let ((before (copy-seq buffer)))
          (is (= end (c:verifica-indice-full-text buffer start end descriptor scratch)))
          (is (equalp buffer before)))))))

(deftest req-sec-008-persisted-query-semantics
  (let* ((buffer (golden)) (descriptor (descriptor)) (scratch (space)) (query (at::small-space))
         (view (c:crea-vista-indice-full-text buffer 0 (length buffer) descriptor scratch)))
    (dolist (case '(("alpha beta" 0 :phrase t) ("beta alpha" 0 :phrase t) ("alpha alpha" 0 :phrase nil)
                    ("alpha alpha" 0 :all t) ("alpha gamma" 0 :all nil) ("gamma beta" 1 :any t)
                    ("alpha" 1 :all nil) ("beta" 1 :all t) ("beta" 2 :all nil)))
      (destructuring-bind (text row mode expected) case
        (at::analyzed text :space query) (is (eq expected (matches view row 1 query mode)))))
    (at::analyzed "ALPHA BETA" :space query) (is (matches view 0 1 query :phrase))
    (is (not (matches view 0 2 query :any)))
    ;; Lo scratch di verifica non e conservato nella vista.
    (fill (c::spazio-codec-full-text-prefix scratch) 42)
    (fill (c::spazio-codec-full-text-starts scratch) 0)
    (is (matches view 0 1 query :phrase))))

(deftest req-sec-008-empty-and-multiple-fields
  (let* ((rows #*111) (fields '((1 "subject" ("subject")) (2 "body" ("body"))))
         (descriptor (descriptor :rows rows :meta (meta :rows rows :fields fields)))
         (scratch (space)) (analysis (at::small-space)) (query (at::small-space))
         (run (arcdocdb.fulltext.index:crea-indice-posizionale)))
    (at::append-field run analysis 0 1 "") (at::append-field run analysis 0 2 "Caffè Straße")
    (at::append-field run analysis 1 1 "CAFÉ") (at::append-field run analysis 1 2 "café")
    (at::append-field run analysis 2 2 "") (at::seal run)
    (multiple-value-bind (buffer start end) (encode run descriptor scratch 3)
      (let ((view (c:crea-vista-indice-full-text buffer start end descriptor scratch)))
        (at::analyzed "CAFFÈ STRASSE" :space query) (is (matches view 0 2 query :phrase))
        (is (not (matches view 0 1 query :any)))
        (at::analyzed "café café" :space query) (is (matches view 1 1 query :all))
        (is (not (matches view 1 1 query :phrase)))
        (is (not (matches view 2 1 query :any))))))
  (dolist (present '(nil t))
    (let* ((descriptor (descriptor)) (scratch (space)) (analysis (at::small-space))
           (run (arcdocdb.fulltext.index:crea-indice-posizionale)))
      (when present (at::append-field run analysis 0 1 "")) (at::seal run)
      (multiple-value-bind (buffer start end) (encode run descriptor scratch)
        (is (= end (c:verifica-indice-full-text buffer start end descriptor scratch)))))))

(deftest req-sec-008-every-bit-and-truncation
  (let ((reference (golden)) (descriptor (descriptor)) (scratch (space)))
    (dotimes (bit (* 8 (length reference)))
      (let ((buffer (copy-seq reference)))
        (setf (aref buffer (floor bit 8)) (logxor (aref buffer (floor bit 8)) (ash 1 (mod bit 8))))
        (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                  'corruption-detected)))
    (dotimes (end (length reference))
      (rejected (lambda () (c:verifica-indice-full-text reference 0 end descriptor scratch)) 'corruption-detected))
    (format t "Codec: ~D bit e ~D troncamenti rifiutati.~%" (* 8 (length reference)) (length reference))))
