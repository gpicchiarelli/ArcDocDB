(in-package #:arcdocdb.fulltext.admission.tests)

(deftest req-sec-003-reservation-owned-nntp-runs
  (with-pool (pool queue configs lease)
    (let ((sources (sources configs)))
      (multiple-value-bind (slot generation) (f:prenota-full-text pool lease sources)
        (is (equal '(146 146 1) (budget pool lease)))
        (rejected (lambda () (f:leggi-run-riserva-full-text pool lease slot generation 0)) 'invalid-argument)
        (complete pool lease slot generation 1)
        (is (unborrowed sources))
        (dotimes (i 2)
          (let* ((source (d::preparazione-full-text-run (svref sources i)))
                 (owned (f:leggi-run-riserva-full-text pool lease slot generation i))
                 (snapshot (frozen-run owned)))
            (is (not (eq source owned))) (is (equalp snapshot (frozen-run source)))
            (is (dt::matches owned 0 1 "ALPHA" :all)) (is (dt::matches owned 0 2 "beta" :phrase))
            (dt::prepare (svref sources i) (dt::document '("subject" . "omega")) :row 2)
            (is (equalp snapshot (frozen-run owned))) (is (dt::matches owned 0 1 "alpha" :phrase))))
        (fill sources nil)
        (is (equal '(146 146 1) (budget pool lease)))
        (f:annulla-riserva-full-text pool lease slot generation)
        (is (equal '(0 0 0) (budget pool lease)))))))

(deftest req-sec-010-reservation-independent-ledger
  (with-pool (pool queue configs lease :capacity 3)
    (let ((model nil) (total 0) (upper 0) (checks 0)
          (fixed (d:limite-fisso-indice-full-text (svref configs 0))))
      (dotimes (i 128)
        (if (or (= 3 (length model)) (and model (zerop (mod i 3))))
            (destructuring-bind (slot generation bytes cost) (pop model)
              (f:annulla-riserva-full-text pool lease slot generation) (decf total bytes) (decf upper cost))
            (let* ((variant (mod i 4)) (input (case variant (0 (dt::wire))
                                             (1 (dt::document '("subject" . "alpha")))
                                             (2 (dt::document '("body" . "beta"))) (otherwise (dt::document))))
                   (bytes (case variant (0 146) (1 74) (2 72) (otherwise 0)))
                   (cost (case variant (0 145) (1 73) (2 72) (otherwise 0))))
              (multiple-value-bind (slot generation) (f:prenota-full-text pool lease (sources configs :row i :input input))
                (complete pool lease slot generation (1+ (mod i 7)))
                (push (list slot generation bytes cost) model) (incf total bytes) (incf upper cost))))
        (is (equal (list total total (length model)) (budget pool lease)))
        (dotimes (j 2) (is (= (+ fixed upper) (f:leggi-bound-riserve-full-text pool lease j))) (incf checks)))
      (dolist (item model) (f:annulla-riserva-full-text pool lease (first item) (second item)))
      (is (equal '(0 0 0) (budget pool lease)))
      (format t "Ledger indipendente: ~D confronti di bound su 128 operazioni.~%" checks))))

(deftest req-sec-003-reservation-all-sixteen-generations
  (let* ((configs (coerce (loop for id from 1 to 8 append (list (config id 1) (config id #xffffffffffffffff))) 'vector))
         (queue (ex:crea-coda-writer :capacity 16)) (pool (pool queue configs)) (lease (ex:acquisisci-writer queue)))
    (unwind-protect
         (multiple-value-bind (slot generation) (f:prenota-full-text pool lease (sources configs :row #xffffffff))
           (complete pool lease slot generation 3)
           (is (equal '(1168 1168 1) (budget pool lease)))
           (dotimes (i 16)
             (is (dt::matches (f:leggi-run-riserva-full-text pool lease slot generation i) #xffffffff 2 "BETA" :all))
             (is (= (+ 145 (d:limite-fisso-indice-full-text (svref configs i)))
                    (f:leggi-bound-riserve-full-text pool lease i))))
           (f:annulla-riserva-full-text pool lease slot generation))
      (ex:rilascia-writer queue lease))))
