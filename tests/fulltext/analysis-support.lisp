;;;; Oracoli: esempi espliciti e corpus ufficiali UCD, mai normalizzatore del runtime.
(defpackage #:arcdocdb.fulltext.analysis.tests
  (:use #:cl)
  (:local-nicknames (#:a #:arcdocdb.fulltext.analysis))
  (:import-from #:arcdocdb.fulltext.analysis #:crea-spazio-full-text #:inizia-analisi-full-text
                #:passo-analisi-full-text #:risultati-analisi-full-text)
  (:import-from #:arcdocdb.conditions #:arcdocdb-error #:invalid-argument #:resource-exhausted
                #:corruption-detected #:error-reason)
  (:export #:run))
(in-package #:arcdocdb.fulltext.analysis.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defmacro is (form) `(unless ,form (error "Analisi full text: ~S" ',form)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test dell'analisi full text superati.~%" (length *tests*)) t)
(defun small-space (&key (scalars 4096) (tokens 128) (bytes 16384))
  (crea-spazio-full-text :max-scalars scalars :max-tokens tokens :token-bytes bytes))
(defun bytes (string) (sb-ext:string-to-octets string :external-format :utf-8))
(defun analyzed (string &key (space (small-space)) (quantum 4096))
  (let ((input (bytes string)))
    (inizia-analisi-full-text space input 0 (length input) :max-tokens 128)
    (loop repeat 1000000 until (eq :done (passo-analisi-full-text space quantum))
          finally (is (eq :done (a::spazio-full-text-phase space))))
    (multiple-value-bind (data begins ends n used) (risultati-analisi-full-text space)
      (is (<= used (length data)))
      (loop for i below n collect (sb-ext:octets-to-string data :start (aref begins i)
                                                        :end (aref ends i) :external-format :utf-8)))))
(defun rejected (thunk type reason)
  (let ((caught nil))
    (handler-case (funcall thunk) (arcdocdb-error (c) (setf caught c)))
    (is caught) (is (typep caught type)) (when reason (is (eq reason (error-reason caught))))))
(defun cp-list (string)
  (mapcar (lambda (word) (parse-integer word :radix 16 :junk-allowed nil))
          (remove "" (uiop:split-string string :separator '(#\Space #\Tab)) :test #'equal)))
(defun corpus (name)
  (asdf:system-relative-pathname "arcdocdb" (concatenate 'string "data/unicode/18.0.0/" name)))
(defun each-data-line (name function)
  (with-open-file (stream (corpus name) :external-format :utf-8)
    (loop for line = (read-line stream nil) while line for number from 1 do
      (let ((content (string-trim '(#\Space #\Tab) (subseq line 0 (position #\# line)))))
        (unless (or (zerop (length content)) (char= (char content 0) #\@))
          (funcall function content number))))))
(defun complete (space)
  (loop repeat 1000000 until (eq :done (passo-analisi-full-text space 4096))
        finally (is (eq :done (a::spazio-full-text-phase space)))))
