(in-package #:arcdocdb.fulltext.document.tests)

(deftest req-sec-003-document-selected-types-and-duplicates
  (let ((task (task)))
    (dolist (value '(:null :true 17 (:array) (:bytes #(97)) (:map) (:tag 42 "beta")))
      (rejected (lambda () (prepare task (document (cons "body" value))))
                'invalid-argument :fulltext-document-field-type)
      (is (eq :failed (d:stato-preparazione-full-text task)))
      (is (null (d::preparazione-full-text-input task)))
      (rejected (lambda () (d:risultati-preparazione-full-text task)) 'invalid-argument))
    (rejected (lambda () (prepare task (document '("body" . "alpha") '("body" . "beta"))))
              'invalid-argument :fulltext-duplicate-path-key)
    (rejected (lambda () (prepare task (ft::octets '(128)))) 'invalid-argument :fulltext-document-root))
  (let ((task (task (config :definitions '((1 "subject" ("headers" "subject")))))))
    (rejected (lambda () (prepare task (document '("headers" . "alpha"))))
              'invalid-argument :fulltext-document-path-type)
    (rejected (lambda () (prepare task (document '("headers" . (:map)) '("headers" . (:map)))))
              'invalid-argument :fulltext-duplicate-path-key)))

(deftest req-sec-003-document-entire-cbor-is-validated
  (let ((task (task)) (input (wire)))
    (dotimes (n (length input))
      (rejected (lambda () (prepare task input :end n)) 'corruption-detected))
    (dolist (bytes (list (concatenate '(simple-array (unsigned-byte 8) (*)) input (ft::octets '(0)))
                        (ft::octets '(#xbf #xff)) (ft::octets '(#xb8 0))
                        (ft::octets '(#xa1 #x61 #x78 #x61 #xc0))
                        (ft::octets '(#xa1 #x61 #x78 #x7b 255 255 255 255 255 255 255 255))))
      (rejected (lambda () (prepare task bytes)) 'corruption-detected))
    (is (matches (prepare task input) 0 1 "alpha" :all))))

(deftest req-sec-010-document-aggregate-limits
  (dolist (case '((#(8 1024 1048576 67108864 268435456) :fulltext-document-input-budget)
                  (#(16777216 1024 1 67108864 268435456) :fulltext-document-token-budget)
                  (#(16777216 1024 1048576 72 268435456) :fulltext-document-prepared-budget)))
    (let ((task (task (config :limits (first case)))))
      (rejected (lambda () (prepare task (wire))) 'resource-exhausted (second case))
      (is (eq :failed (d:stato-preparazione-full-text task)))
      (is (null (r::indice-posizionale-source (d::preparazione-full-text-run task))))))
  (let ((task (task (config :limits #(9 1024 2 73 268435456)))))
    (is (matches (prepare task (wire)) 0 1 "alpha" :all)))
  (let ((task (task (config :limits #(16777216 1024 1 67108864 268435456)))))
    (let ((run (prepare task (document '("subject" . "alpha") '("body" . "")))))
      (is (= (r::indice-posizionale-count run) 1)) (is (= (r::indice-posizionale-field-count run) 2)))))

(deftest req-sec-010-document-work-nodes-and-file-budget
  (let ((task (task)) (input (wire)))
    (rejected (lambda () (prepare task input :max-work 1)) 'resource-exhausted :fulltext-document-work)
    (rejected (lambda () (prepare task input :max-nodes 1)) 'resource-exhausted :cbor-node-budget)
    (multiple-value-bind (run upper file-upper) (prepare task input)
      (is (plusp upper)) (is (plusp (r::indice-posizionale-count run)))
      (rejected (lambda () (prepare task input :max-file-bytes (1- file-upper)))
                'resource-exhausted :fulltext-document-file-budget)
      (rejected (lambda () (d:risultati-preparazione-full-text task)) 'invalid-argument)
      (is (matches (prepare task input :max-file-bytes file-upper) 0 2 "beta" :all))))
  (let ((task (task (config) :tokens 1)))
    (rejected (lambda () (prepare task (wire))) 'resource-exhausted))
  (let ((task (task (config :limits #(16777216 4 1048576 67108864 268435456)))))
    (rejected (lambda () (prepare task (wire))) 'resource-exhausted)))

(deftest req-sec-010-document-cancel-and-reuse-at-every-phase
  (let ((task (task)) (input (wire)))
    (dolist (phase '(:scan :field :analysis :copy :seal :sort :measure))
      (d:inizia-preparazione-full-text task input 0 (length input) #xffffffff)
      (loop repeat 10000 until (eq phase (d::preparazione-full-text-phase task))
            do (d:passo-preparazione-full-text task 1)
            finally (is (eq phase (d::preparazione-full-text-phase task))))
      (is (eq :cancelled (d:annulla-preparazione-full-text task)))
      (is (eq :cancelled (d:annulla-preparazione-full-text task)))
      (is (null (d::preparazione-full-text-input task)))
      (is (null (a::spazio-full-text-input (d::preparazione-full-text-analysis task))))
      (rejected (lambda () (d:risultati-preparazione-full-text task)) 'invalid-argument)
      (is (matches (prepare task input :row #xffffffff) #xffffffff 1 "alpha" :all)))))

(deftest req-sec-010-document-preflight-keeps-prior-result
  (let* ((task (task)) (input (wire)) (run (prepare task input)))
    (dolist (args (list (list task nil 0 0 0) (list task input -1 1 0) (list task input 1 0 0)
                       (list task input 0 100 0) (list task input 0 1 -1)
                       (list task input 0 1 0 :max-work 0) (list task input 0 1 0 :max-nodes 0)
                       (list task (r::indice-posizionale-bytes run) 0 1 0)))
      (rejected (lambda () (apply #'d:inizia-preparazione-full-text args)) 'invalid-argument)
      (is (eq :done (d:stato-preparazione-full-text task))))
    (d:inizia-preparazione-full-text task input 0 (length input) 0)
    (rejected (lambda () (d:inizia-preparazione-full-text task input 0 (length input) 0))
              'invalid-argument :fulltext-document-busy)
    (rejected (lambda () (d:passo-preparazione-full-text task 0)) 'invalid-argument)
    (complete task) (is (matches run 0 1 "alpha" :all))))

(deftest req-sec-003-document-config-guards
  (dolist (defs '(((1 "body" ("body")) (1 "x" ("x")))
                  ((2 "body" ("body")) (1 "x" ("x")))
                  ((1 "body" ("body")) (2 "body" ("other")))
                  ((1 "body" ("body")) (2 "other" ("body")))
                  ((0 "body" ("body"))) ((1 "" ("body"))) ((1 "body" nil))))
    (rejected (lambda () (config :definitions defs)) 'invalid-argument))
  (rejected (lambda () (config :id 0)) 'invalid-argument)
  (rejected (lambda () (config :limits #(1 1 0 1 1))) 'invalid-argument)
  (rejected (lambda () (config :limits #(1 1 4294967296 1 1))) 'invalid-argument)
  (rejected (lambda () (d:crea-configurazione-full-text (fields) 1 1 1 :profile (text "other"))) 'unsupported-format)
  (rejected (lambda () (d:crea-configurazione-full-text (fields) 1 1 1 :max-memory 1)) 'resource-exhausted)
  (rejected (lambda () (d:crea-preparazione-full-text (config) :max-memory 1)) 'resource-exhausted)
  (rejected (lambda () (d:limite-fisso-indice-full-text nil)) 'invalid-argument)
  (rejected (lambda () (d:crea-preparazione-full-text (config) :max-tokens 0)) 'invalid-argument))

(deftest req-sec-003-document-depth-and-sibling-frames
  (let* ((path (loop repeat 100 collect "a"))
         (task (task (config :definitions (list (list 1 "body" path)))))
         (value "alpha"))
    (dotimes (i 100) (setf value (list :map (cons "a" value))))
    (is (matches (prepare task (ft::octets (ref-cbor-list value)) :quantum 1) 0 1 "alpha" :all))
    (setf value (list :map (cons "a" value)))
    (rejected (lambda () (prepare task (ft::octets (ref-cbor-list value)))) 'resource-exhausted :cbor-depth-budget))
  (let* ((task (task (config :definitions '((1 "a" ("a" "x")) (2 "b" ("b" "x"))))))
         (run (prepare task (document '("ignored" . (:array (:map ("x" . "wrong"))))
                                      '("b" . (:map ("x" . "beta"))) '("a" . (:map ("x" . "alpha")))))))
    (is (matches run 0 1 "alpha" :all)) (is (matches run 0 2 "beta" :all))))
