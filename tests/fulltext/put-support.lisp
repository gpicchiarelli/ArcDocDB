;;;; C4: fixture CBOR congelata e cornice di riferimento bitwise indipendente.
(defpackage #:arcdocdb.fulltext.put.tests
  (:use #:cl)
  (:local-nicknames (#:p #:arcdocdb.fulltext.put) (#:f #:arcdocdb.fulltext.admission)
                    (#:d #:arcdocdb.fulltext.document) (#:dt #:arcdocdb.fulltext.document.tests)
                    (#:ft #:arcdocdb.foundation.tests) (#:at #:arcdocdb.fulltext.analysis.tests)
                    (#:a #:arcdocdb.fulltext.admission.tests) (#:ex #:arcdocdb.execution)
                    (#:w #:arcdocdb.wal) (#:r #:arcdocdb.record) (#:b #:arcdocdb.binary)
                    (#:ix #:arcdocdb.fulltext.index))
  (:import-from #:arcdocdb.conditions #:invalid-argument #:resource-exhausted #:invariant-violation
                #:corruption-detected #:unsupported-format)
  (:export #:run))
(in-package #:arcdocdb.fulltext.put.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body) `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defmacro is (form) `(unless ,form (error "PUT full text: ~S" ',form)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test del legame PUT full text superati.~%" (length *tests*)) t)
(defun rejected (thunk type &optional reason) (dt::rejected thunk type reason))
(defun key () (dt::text "<article@example.invalid>"))
(defun request (configs &rest options)
  (apply #'p:crea-preparazione-put-full-text configs
         (append options '(:document-bytes 4096 :key-bytes 128 :max-scalars 4096 :max-tokens 128 :term-bytes 16384))))
(defun batch (&rest options)
  (apply #'w:crea-lotto :segment 1 (append options '(:capacity 4096 :max-records 8))))
(defun prepare (request generation &optional (quantum 4096))
  (loop repeat 100000 until (eq :prepared (p:passo-put-full-text request generation quantum))
        finally (is (eq :prepared (p:stato-put-full-text request generation)))))
(defun reserve (pool lease request generation &optional (quantum 4096))
  (p:prenota-put-full-text pool lease request generation)
  (loop repeat 100000 until (eq :reserved (p:passo-riserva-put-full-text pool lease request generation quantum))
        finally (is (eq :reserved (p:stato-put-full-text request generation)))))
(defmacro with-context ((pool queue configs request lease &rest options) &body body)
  `(let* ((,configs (a::configs)) (,queue (ex:crea-coda-writer :capacity 16))
          (,pool (a::pool ,queue ,configs)) (,request (request ,configs ,@options))
          (,lease (ex:acquisisci-writer ,queue)))
     (unwind-protect (progn ,@body) (ex:rilascia-writer ,queue ,lease))))
(defun snapshot (batch)
  (list (w::lotto-used batch) (w::lotto-count batch) (w::lotto-state batch) (copy-seq (w::lotto-buffer batch))
        (copy-seq (w::lotto-offsets batch)) (w::lotto-incarnation batch)))
