(in-package #:arcdocdb.fulltext.document.tests)

(defun joined (words) (format nil "~{~A~^ ~}" words))
(defun oracle (words query mode)
  (ecase mode
    (:all (every (lambda (word) (member word words :test #'equal)) query))
    (:any (not (null (some (lambda (word) (member word words :test #'equal)) query))))
    (:phrase (not (null (search query words :test #'equal))))))
(defun oracle-bound (fields)
  (loop for words in fields sum
    (+ 16 (* 4 (length words))
       (loop for word in (remove-duplicates words :test #'equal) sum (+ 48 (length (text word)))))))

(deftest req-sec-003-document-independent-differential
  (let* ((defs '((1 "subject" ("headers" "subject")) (7 "body" ("body"))))
         (task (task (config :definitions defs))) (query (at::small-space)) (checks 0)
         (words '("alpha" "beta" "gamma" "delta"))
         (queries (append (mapcar #'list words)
                          (loop for a in words append (loop for b in words collect (list a b)))
                          (loop for word in words collect (list word word word)) '(("omega")))))
    (dotimes (i 128)
      (let* ((subject-p (not (zerop (mod i 5)))) (body-p (not (zerop (mod i 4))))
             (subject (loop for j below (mod i 7) collect (nth (mod (+ i j) 4) words)))
             (body (loop for j below (mod i 11) collect (nth (mod (+ (* i 3) (floor j 2)) 4) words)))
             (pairs (list '("ignored" . (:tag 42 (:map ("body" . "omega"))))))
             (visible nil))
        (when subject-p (push (cons "headers" (list :map (cons "subject" (joined subject)))) pairs)
                       (push subject visible))
        (when body-p (push (cons "body" (joined body)) pairs) (push body visible))
        (multiple-value-bind (run upper bound prepared input-bytes) (prepare task (apply #'document pairs) :quantum (1+ (mod i 64)))
          (is (= upper (oracle-bound visible)))
          (is (= prepared (loop for terms in visible sum (+ 12 (* 20 (length terms)) (reduce #'+ terms :key #'length :initial-value 0)))))
          (is (= input-bytes (loop for terms in visible sum (length (text (joined terms))))))
          (multiple-value-bind (view size) (file-view run defs)
            (is (<= size bound))
            (dolist (terms queries)
              (at::analyzed (joined terms) :space query)
              (dolist (row '(0 1))
                (dolist (field '(1 7 999))
                  (dolist (mode '(:all :any :phrase))
                    (let* ((selected (case field (1 (and subject-p subject)) (7 (and body-p body)) (otherwise nil)))
                           (expected (and (zerop row) (not (null (oracle selected terms mode))))))
                      (is (eq expected (r:corrisponde-riga-full-text run row field query mode)))
                      (is (eq expected (c:corrisponde-riga-indice-full-text view row field query mode)))
                      (incf checks 2))))))))))
    (is (= checks 115200))
    (format t "Documenti CBOR: ~D confronti indipendenti su run e file, 128 bound verificati.~%" checks)))

(deftest req-sec-003-document-all-sixteen-fields
  (let* ((definitions (loop for i from 1 to 16 collect
                       (list (if (= i 16) 65535 i) (format nil "f~D" i) (list "headers" (format nil "f~D" i)))))
         (task (task (config :definitions definitions)))
         (input (document (cons "headers" (cons :map (loop for i from 1 to 16 collect (cons (format nil "f~D" i) "alpha")))))))
    (multiple-value-bind (run upper bound prepared used) (prepare task input :quantum 1)
      (is (= upper 1168)) (is (= prepared 592)) (is (= used 80)) (is (plusp bound))
      (dolist (field definitions) (is (matches run 0 (first field) "alpha" :all))))))

(deftest req-sec-010-document-hot-allocation
  (dolist (id '(1 #xffffffffffffffff))
    (let* ((limits (if (= id 1) #(16777216 1024 1048576 67108864 268435456)
                       #(18446744073709551615 18446744073709551615 4294967295 18446744073709551615 18446744073709551615)))
           (task (task (config :id id :limits limits))) (input (wire)) (query (at::small-space)))
      (at::analyzed "alpha" :space query)
      (dotimes (i 100) (prepare task input))
      (sb-ext:gc :full t)
      (let ((before (sb-ext:get-bytes-consed)))
        (dotimes (i 1000)
          (d:inizia-preparazione-full-text task input 0 (length input) 0)
          (complete task)
          (multiple-value-bind (run upper bound prepared used) (d:risultati-preparazione-full-text task)
            (is (= upper 145)) (is (plusp bound)) (is (= prepared 73)) (is (= used 9))
            (is (r:corrisponde-riga-full-text run 0 1 query :all))))
        (let ((allocated (- (sb-ext:get-bytes-consed) before)))
          (format t "Preparazione CBOR, ID ~D: ~D byte consed per 1000 operazioni.~%" id allocated)
          (is (zerop allocated)))))))

(deftest req-sec-006-document-parallel-workers
  (let* ((config (config)) (input (wire)) (tasks (loop repeat 4 collect (task config)))
         (ready (sb-thread:make-semaphore)) (start (sb-thread:make-semaphore))
         (threads (loop for task in tasks collect
                    (let ((private-task task))
                      (sb-thread:make-thread
                       (lambda ()
                         (sb-thread:signal-semaphore ready)
                         (is (sb-thread:wait-on-semaphore start :timeout 15))
                         (dotimes (i 100) (is (matches (prepare private-task input :quantum 3) 0 1 "alpha" :all))) t)
                       :name "fulltext-document-reader")))))
    (is (sb-thread:wait-on-semaphore ready :n 4 :timeout 15))
    (dotimes (i 4) (sb-thread:signal-semaphore start))
    (dolist (thread threads) (is (eq t (sb-thread:join-thread thread :timeout 30 :default :timeout))))))
