(in-package #:arcdocdb.fulltext.admission.tests)

(deftest req-sec-003-row-directory-independent-model
  (dotimes (round 64)
    (with-pool (pool queue configs lease :capacity 8)
      (let* ((keys '(0 1 42 65536 2147483648 4294967295))
             (ordered (append (nthcdr (mod round 6) keys) (subseq keys 0 (mod round 6)))) (model nil))
        (when (oddp round) (setf ordered (reverse ordered)))
        (check-row-model pool lease model)
        (dolist (row ordered) (setf model (model-add-row pool lease configs model row)))
        (dolist (row (subseq ordered 0 3)) (setf model (model-cancel-row pool lease model row)))
        (dolist (row (reverse (subseq ordered 0 3))) (setf model (model-add-row pool lease configs model row)))
        (dolist (row (subseq ordered 0 2))
          (let ((entry (assoc row model)))
            (complete pool lease (second entry) (third entry) 1)
            (setf (fourth entry) :ready) (check-row-model pool lease model)
            (f:trasferisci-riserva-full-text pool lease (second entry) (third entry))
            (setf (fourth entry) :transferred) (check-row-model pool lease model)))
        (dolist (row ordered)
          (let ((before (row-directory-image pool lease)))
            (rejected (lambda () (f:prenota-full-text pool lease (sources configs :row row)))
                      'invalid-argument :fulltext-reservation-duplicate-row)
            (is (equalp before (row-directory-image pool lease)))))
        (dolist (row (subseq ordered 2)) (setf model (model-cancel-row pool lease model row)))
        (is (= 2 (length model))) (check-row-model pool lease model)))))

(deftest req-sec-010-row-directory-capacity-and-cold-memory
  (let* ((configs (vector (config 1))) (queue (ex:crea-coda-writer :capacity 16)))
    (dolist (capacity '(1 1024))
      (let* ((memory (+ 4096 128 (* capacity (+ 1032 4096 (* 20 8) 64 (* 12 16)))))
             (args (list :capacity capacity :max-tokens 8 :term-bytes 64)))
        (rejected (lambda () (apply #'f:crea-riserve-full-text queue configs 1 :max-memory (1- memory) args))
                  'resource-exhausted :fulltext-reservation-memory)
        (let* ((pool (apply #'f:crea-riserve-full-text queue configs 1 :max-memory memory args))
               (sources (sources configs)) (lease (ex:acquisisci-writer queue)))
          (unwind-protect
               (progn
                 (dotimes (i capacity)
                   (dt::prepare (svref sources 0) (dt::wire) :row (- #xffffffff i))
                   (multiple-value-bind (slot token) (f:prenota-full-text pool lease sources)
                     (complete pool lease slot token) (f:trasferisci-riserva-full-text pool lease slot token)))
                 (dotimes (i capacity)
                   (multiple-value-bind (status slot token) (f:trova-riga-trasferita-full-text pool lease (- #xffffffff i))
                     (is (eq :transferred status)) (is (= (- #xffffffff i) (f::riserva-full-text-row slot)))
                     (is (= token (f::riserva-full-text-generation slot)))))
                 (check-pending-row pool lease 0 :absent)
                 (check-pending-row pool lease (- #xffffffff capacity) :absent)
                 (rejected (lambda () (f:prenota-full-text pool lease sources)) 'resource-exhausted :fulltext-reservation-slots))
            (ex:rilascia-writer queue lease)))))))

(deftest req-sec-006-row-directory-cancel-reuse-and-private-pending
  (with-pool (pool queue configs lease :capacity 1)
    (multiple-value-bind (slot token) (f:prenota-full-text pool lease (sources configs :row 0))
      (check-pending-row pool lease 0 :pending)
      (complete pool lease slot token) (check-pending-row pool lease 0 :pending)
      (f:annulla-riserva-full-text pool lease slot token)
      (f:annulla-riserva-full-text pool lease slot token) (check-pending-row pool lease 0 :absent)
      (multiple-value-bind (next generation) (f:prenota-full-text pool lease (sources configs :row #xffffffff))
        (is (eq slot next)) (is (> generation token))
        (rejected (lambda () (f:annulla-riserva-full-text pool lease slot token)) 'invalid-argument :fulltext-reservation-token)
        (check-pending-row pool lease 0 :absent) (check-pending-row pool lease #xffffffff :pending)
        (complete pool lease next generation) (f:trasferisci-riserva-full-text pool lease next generation)
        (is (equal (list :transferred next generation) (row-result pool lease #xffffffff)))
        (rejected (lambda () (f:annulla-riserva-full-text pool lease next generation)) 'invalid-argument)
        (is (= 1 (f::riserve-full-text-row-count pool)))))))

(deftest req-sec-010-row-directory-rejections-without-effects
  (with-pool (pool queue configs lease)
    (let ((before (row-directory-image pool lease)))
      (dolist (row '(nil -1 4294967296 1.0))
        (rejected (lambda () (row-result pool lease row)) 'invalid-argument :fulltext-row-input))
      (rejected (lambda () (row-result pool 0 0)) 'invalid-argument :writer-lease)
      (let ((thread (sb-thread:make-thread
                     (lambda () (rejected (lambda () (row-result pool lease 0)) 'invalid-argument :writer-lease) t))))
        (is (eq t (sb-thread:join-thread thread :timeout 30 :default :timeout))))
      (is (equalp before (row-directory-image pool lease))) (is (eq :healthy (f::riserve-full-text-state pool))))))

(deftest req-sec-006-row-directory-interrupted-insert
  (with-pool (pool queue configs lease)
    (let* ((sources (sources configs)) (symbol 'f::inserisci-riga-riserva) (original (symbol-function symbol)))
      (unwind-protect
           (progn
             (setf (symbol-function symbol) (lambda (pool slot position)
                                             (funcall original pool slot position) (throw 'row-interrupted :stopped)))
             (is (eq :stopped (catch 'row-interrupted (f:prenota-full-text pool lease sources))))
             (is (eq :faulted (f::riserve-full-text-state pool)))
             (is (not (f::riserve-full-text-effect pool)))
             (is (= 1 (f::riserve-full-text-row-count pool)))
             (is (every #'d::preparazione-full-text-borrower sources))
             (is (= 145 (aref (f::riserve-full-text-used pool) 1)))
             (rejected (lambda () (row-result pool lease 0)) 'invariant-violation))
        (setf (symbol-function symbol) original)))))

(deftest req-sec-006-row-directory-interrupted-remove
  (with-pool (pool queue configs lease)
    (let* ((sources (sources configs)) (symbol 'f::rimuovi-riga-riserva) (original (symbol-function symbol)))
      (multiple-value-bind (slot token) (f:prenota-full-text pool lease sources)
        (unwind-protect
             (progn
               (setf (symbol-function symbol) (lambda (pool slot)
                                               (funcall original pool slot) (throw 'row-interrupted :stopped)))
               (is (eq :stopped (catch 'row-interrupted (f:annulla-riserva-full-text pool lease slot token))))
               (is (eq :faulted (f::riserve-full-text-state pool)))
               (is (not (f::riserve-full-text-effect pool)))
               (is (zerop (f::riserve-full-text-row-count pool))) (is (= 1 (f::riserve-full-text-count pool)))
               (is (every (lambda (source) (eq slot (d::preparazione-full-text-borrower source))) sources))
               (is (= 146 (f::riserve-full-text-delta-used pool)))
               (is (= 145 (aref (f::riserve-full-text-used pool) 1))))
          (setf (symbol-function symbol) original))))))

(deftest req-sec-006-row-directory-corruption-fail-stop
  (dolist (mode '(:count :slot :row :missing))
    (with-pool (pool queue configs lease)
      (multiple-value-bind (slot token) (f:prenota-full-text pool lease (sources configs))
        (declare (ignore token))
        (ecase mode
          (:count (incf (f::riserve-full-text-row-count pool)))
          (:slot (setf (aref (f::riserve-full-text-row-slots pool) 0) 8))
          (:missing (setf (svref (f::riserve-full-text-slots pool) 0) nil))
          (:row (setf (f::riserva-full-text-row slot) 1)))
        (rejected (lambda () (row-result pool lease 0)) 'invariant-violation)
        (is (eq :faulted (f::riserve-full-text-state pool)))
        (is (= 146 (f::riserve-full-text-delta-used pool)))))))
