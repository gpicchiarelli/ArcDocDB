;;;; C4: fixture documentali manuali e modello dei contatori indipendente dal pool.
(defpackage #:arcdocdb.fulltext.admission.tests
  (:use #:cl)
  (:local-nicknames (#:f #:arcdocdb.fulltext.admission) (#:d #:arcdocdb.fulltext.document)
                    (#:dt #:arcdocdb.fulltext.document.tests) (#:r #:arcdocdb.fulltext.index)
                    (#:at #:arcdocdb.fulltext.analysis.tests) (#:ex #:arcdocdb.execution))
  (:import-from #:arcdocdb.conditions #:invalid-argument #:resource-exhausted #:invariant-violation)
  (:export #:run))
(in-package #:arcdocdb.fulltext.admission.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body) `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defmacro is (form) `(unless ,form (error "Riserve full text: ~S" ',form)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test delle riserve full text superati.~%" (length *tests*)) t)
(defun rejected (thunk type &optional reason) (dt::rejected thunk type reason))
(defun config (id &optional (generation 1))
  (d:crea-configurazione-full-text (dt::fields) id generation #xffffffffffffffff))
(defun configs () (vector (config 1) (config 2)))
(defun pool (queue configs &rest options)
  (apply #'f:crea-riserve-full-text queue configs 1 (append options '(:max-tokens 128 :term-bytes 16384))))
(defun sources (configs &key (row 0) (input (dt::wire)))
  (map 'vector (lambda (config) (let ((task (dt::task config))) (dt::prepare task input :row row) task)) configs))
(defmacro with-pool ((pool queue configs lease &rest options) &body body)
  `(let* ((,configs (configs)) (,queue (ex:crea-coda-writer :capacity 16))
          (,pool (pool ,queue ,configs ,@options)) (,lease (ex:acquisisci-writer ,queue)))
     (unwind-protect (progn ,@body) (ex:rilascia-writer ,queue ,lease))))
(defun complete (pool lease slot generation &optional (quantum 4096))
  (loop repeat 100000 until (eq :ready (f:passo-riserva-full-text pool lease slot generation quantum))
        finally (is (eq :ready (f:stato-riserva-full-text pool lease slot generation)))))
(defun budget (pool lease) (multiple-value-list (f:leggi-budget-riserve-full-text pool lease)))
(defun unborrowed (sources)
  (every (lambda (task) (and (eq :done (d:stato-preparazione-full-text task))
                            (null (d::preparazione-full-text-borrower task)))) sources))
(defun frozen-run (run)
  (list (subseq (r::indice-posizionale-tokens run) 0 (* 5 (r::indice-posizionale-count run)))
        (subseq (r::indice-posizionale-bytes run) 0 (r::indice-posizionale-byte-count run))
        (subseq (r::indice-posizionale-lengths run) 0 (* 3 (r::indice-posizionale-field-count run)))))
