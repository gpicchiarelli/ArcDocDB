(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-sec-003-put-all-sixteen-generations
  (let* ((configs (coerce (loop for id from 1 to 8 append (list (a::config id 1) (a::config id 2))) 'vector))
         (queue (ex:crea-coda-writer :capacity 16)) (pool (a::pool queue configs))
         (request (request configs)) (batch (batch)) (generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
    (prepare request generation 3)
    (let ((lease (ex:acquisisci-writer queue)))
      (unwind-protect
           (progn
             (reserve pool lease request generation 1)
             (multiple-value-bind (slot token) (p:aggiungi-put-full-text pool lease request generation batch)
               (dotimes (i 16) (is (dt::matches (f:leggi-run-riserva-full-text pool lease slot token i) 0 2 "BETA" :all)))
               (is (equal '(1168 0 1) (a::budget pool lease)))))
        (ex:rilascia-writer queue lease)))))

(deftest req-sec-010-put-hot-allocation
  (dolist (id '(1 #xffffffffffffffff))
    (let* ((configs (vector (a::config id #xffffffffffffffff))) (queue (ex:crea-coda-writer :capacity 16))
           (pool (a::pool queue configs :capacity 1000 :max-tokens 16 :term-bytes 128))
           (request (request configs :max-scalars 128 :max-tokens 16 :term-bytes 128))
           (batch (batch :capacity 131072 :max-records 1000)) (key (key)) (wire (dt::wire)) (query (at::small-space))
           (file (reference-file)) (registry (reference-registry #xfffffffffffffffe))
           (log (w:crea-log-io file :segment 1)) (tokens (make-array 1000 :element-type 'fixnum)))
      (unwind-protect (progn
      (at::analyzed "alpha" :space query)
      (dotimes (i 100)
        (let ((generation (p:inizia-put-full-text request key wire 0 :prepared t :txid-high #xffffffff :txid-low #xffffffff)))
          (prepare request generation)
          (let ((lease (ex:acquisisci-writer queue)))
            (reserve pool lease request generation) (p:annulla-riserva-put-full-text pool lease request generation)
            (ex:rilascia-writer queue lease))))
      (sb-ext:gc :full t)
      (let ((before (sb-ext:get-bytes-consed)))
        (dotimes (i 1000)
          (let ((generation (p:inizia-put-full-text request key wire i :prepared t :txid-high #xffffffff :txid-low #xffffffff)))
            (prepare request generation)
            (let ((lease (ex:acquisisci-writer queue)))
              (reserve pool lease request generation)
              (multiple-value-bind (slot token) (p:aggiungi-put-full-text pool lease request generation batch)
                (setf (aref tokens i) token)
                (p:leggi-legame-put-full-text pool lease slot token)
                (is (ix:corrisponde-riga-full-text (f:leggi-run-riserva-full-text pool lease slot token 0) i 1 query :all)))
              (ex:rilascia-writer queue lease))))
        (w:sigilla-lotto-con-csn batch registry log 64 64)
        (let ((lease (ex:acquisisci-writer queue)))
          (unwind-protect
               (dotimes (i 1000)
                 (let ((slot (svref (f::riserve-full-text-slots pool) i)) (token (aref tokens i)))
                   (check-incomplete-row-reference pool lease i :pending)
                   (p:cattura-riferimento-put-full-text pool lease slot token registry log)
                   (check-hot-row-reference pool lease i (+ 24 (length key) (length wire)))
                   (multiple-value-bind (row segment offset size version kind high low)
                       (p:leggi-riferimento-put-full-text pool lease slot token)
                     (is (= row i)) (is (= segment 1)) (is (= version 2)) (is (eq kind :txid))
                     (is (= high #xffffffff)) (is (= low #xffffffff))
                     (is (= size (+ 24 (length key) (length wire)))) (is (= offset (+ 64 (* i size)))))))
            (ex:rilascia-writer queue lease)))
        (let ((allocated (- (sb-ext:get-bytes-consed) before)))
          (format t "PUT/analisi/riserva/WAL/query, ID ~D: ~D byte consed per 1000 operazioni.~%" id allocated)
          (is (zerop allocated)))))
        (arcdocdb.io:chiudi file)))))

(deftest req-sec-006-put-four-independent-workers
  (let* ((configs (a::configs)) (ready (sb-thread:make-semaphore)) (start (sb-thread:make-semaphore))
         (contexts (loop repeat 4 collect
                     (let ((queue (ex:crea-coda-writer :capacity 16)))
                       (list queue (a::pool queue configs :capacity 100 :max-tokens 16 :term-bytes 128)
                             (request configs :max-scalars 128 :max-tokens 16 :term-bytes 128)
                             (batch :capacity 16384 :max-records 100)))))
         (threads (loop for context in contexts collect
                    (let ((private context))
                      (sb-thread:make-thread
                       (lambda ()
                         (destructuring-bind (queue pool request batch) private
                           (sb-thread:signal-semaphore ready) (is (sb-thread:wait-on-semaphore start :timeout 15))
                           (dotimes (i 100)
                             (let ((generation (p:inizia-put-full-text request (key) (dt::wire) i)))
                               (prepare request generation 1)
                               (let ((lease (ex:acquisisci-writer queue)))
                                 (unwind-protect
                                      (progn
                                        (reserve pool lease request generation 1)
                                        (multiple-value-bind (slot token) (p:aggiungi-put-full-text pool lease request generation batch)
                                          (check-incomplete-row-reference pool lease i :pending)
                                          (multiple-value-bind (status found generation)
                                              (f:trova-riga-trasferita-full-text pool lease i)
                                            (is (eq :transferred status)) (is (eq slot found)) (is (= token generation)))
                                          (is (dt::matches (f:leggi-run-riserva-full-text pool lease slot token 1) i 2 "beta" :all))))
                                   (ex:rilascia-writer queue lease))))) t))
                       :name "fulltext-put-worker")))))
    (is (sb-thread:wait-on-semaphore ready :n 4 :timeout 15))
    (dotimes (i 4) (sb-thread:signal-semaphore start))
    (dolist (thread threads) (is (eq t (sb-thread:join-thread thread :timeout 30 :default :timeout))))))
