(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-wal-005-frame-preflight-no-partial-effect
  (let* ((wire (ft::reference-put (key) (dt::wire) 0 0)) (batch (batch)) (before (snapshot batch)))
    (dotimes (end (length wire))
      (rejected (lambda () (w:aggiungi-cornice batch wire 0 end)) 'corruption-detected)
      (is (equalp before (snapshot batch))))
    (let ((copy (copy-seq wire)))
      (setf (aref copy (1- (length copy))) (logxor 1 (aref copy (1- (length copy)))))
      (rejected (lambda () (w:aggiungi-cornice batch copy 0 (length copy))) 'corruption-detected :body-crc))
    (let ((trailing (concatenate '(simple-array (unsigned-byte 8) (*)) wire (ft::bytes 0))))
      (rejected (lambda () (w:aggiungi-cornice batch trailing 0 (length trailing))) 'invalid-argument :lotto-frame-kind))
    (rejected (lambda () (w:aggiungi-cornice batch (w::lotto-buffer batch) 0 1)) 'invalid-argument)
    (rejected (lambda () (w:aggiungi-cornice nil wire 0 (length wire))) 'invalid-argument)
    (is (equalp before (snapshot batch)))))

(deftest req-sec-006-put-start-rejections-preserve-previous
  (let* ((configs (a::configs)) (request (request configs)) (key (key)) (wire (dt::wire))
         (generation (p:inizia-put-full-text request key wire 0)))
    (prepare request generation)
    (dolist (options '((:prepared t) (:txid-high 1) (:prepared 42) (:max-work 0) (:max-work 1)))
      (rejected (lambda () (apply #'p:inizia-put-full-text request key wire 0 options))
                (if (equal options '(:max-work 1)) 'resource-exhausted 'invalid-argument))
      (is (eq :prepared (p:stato-put-full-text request generation))))
    (rejected (lambda () (p:inizia-put-full-text request (p::preparazione-put-full-text-frame request) wire 0)) 'resource-exhausted)
    (rejected (lambda () (request configs :version 3)) 'unsupported-format)
    (let ((v1 (request configs :version 1 :key-bytes 256)))
      (rejected (lambda () (p:inizia-put-full-text v1 (make-array 256 :element-type '(unsigned-byte 8)) wire 0)) 'resource-exhausted))
    (let ((small (request configs :document-bytes 24)))
      (rejected (lambda () (p:inizia-put-full-text small key wire 0)) 'resource-exhausted))
    (setf (p::preparazione-put-full-text-generation request) most-positive-fixnum)
    (rejected (lambda () (p:inizia-put-full-text request key wire 0)) 'resource-exhausted :fulltext-put-generation)))

(deftest req-sec-003-put-invalid-document-never-reserved
  (with-context (pool queue configs request lease)
    (dolist (wire (list (ft::bytes 255) (dt::document '("subject" . "alpha") '("body" . :null))))
      (let ((generation (p:inizia-put-full-text request (key) wire 0)))
        (rejected (lambda () (prepare request generation)) 'arcdocdb.conditions:arcdocdb-error)
        (is (eq :failed (p:stato-put-full-text request generation)))
        (rejected (lambda () (p:prenota-put-full-text pool lease request generation)) 'invalid-argument)
        (is (equal '(0 0 0) (a::budget pool lease)))))))

(deftest req-sec-010-put-reservation-refusal-preserves-cohort
  (with-context (pool queue configs request lease)
    (let* ((short (a::pool queue configs :staging-bytes 145))
           (generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
      (prepare request generation)
      (rejected (lambda () (p:prenota-put-full-text short lease request generation)) 'resource-exhausted)
      (is (eq :prepared (p:stato-put-full-text request generation))) (is (equal '(0 0 0) (a::budget short lease)))
      (reserve pool lease request generation)
      (p:annulla-riserva-put-full-text pool lease request generation)
      (is (equal '(0 0 0) (a::budget pool lease))))))

(deftest req-sec-003-put-append-preflight-retains-reservation
  (with-context (pool queue configs request lease)
    (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)) (good (batch)))
      (prepare request generation) (reserve pool lease request generation)
      (let ((wrong-id (w:crea-lotto :segment 2)) (wrong-version (batch :version 1))
            (full (batch :capacity w::+seal-total+)))
        (dolist (bad (list wrong-id wrong-version full))
          (let ((before (snapshot bad)))
            (rejected (lambda () (p:aggiungi-put-full-text pool lease request generation bad)) 'arcdocdb.conditions:arcdocdb-error)
            (is (equalp before (snapshot bad))) (is (equal '(146 146 1) (a::budget pool lease)))
            (is (eq :reserved (p:stato-put-full-text request generation))))))
      (setf (p::preparazione-put-full-text-validated-generation request) 0)
      (rejected (lambda () (p:aggiungi-put-full-text pool lease request generation good))
                'invalid-argument :fulltext-put-unvalidated)
      (is (equal '(146 146 1) (a::budget pool lease)))
      (setf (p::preparazione-put-full-text-validated-generation request) generation)
      (p:aggiungi-put-full-text pool lease request generation good)
      (rejected (lambda () (p:aggiungi-put-full-text pool lease request generation good)) 'invalid-argument)
      (rejected (lambda () (p:annulla-riserva-put-full-text pool lease request generation)) 'invalid-argument))))

(deftest req-wal-005-put-worker-attests-frame-before-reservation
  (let* ((configs (a::configs)) (queue (ex:crea-coda-writer :capacity 16)) (pool (a::pool queue configs))
         (request (request configs)) (key (key)) (wire (dt::wire)))
    (dolist (offset '(0 24))
      (let* ((generation (p:inizia-put-full-text request key wire 0)) (frame (p::preparazione-put-full-text-frame request)))
        ;; Header o chiave corrotti; il CBOR selezionato resta valido, il CRC deve fallire nel worker.
        (setf (aref frame offset) (logxor 1 (aref frame offset)))
        (rejected (lambda () (prepare request generation 1)) 'corruption-detected)
        (is (eq :failed (p:stato-put-full-text request generation)))
        (is (zerop (p::preparazione-put-full-text-validated-generation request)))
        (let ((lease (ex:acquisisci-writer queue)))
          (unwind-protect
               (progn
                 (rejected (lambda () (p:prenota-put-full-text pool lease request generation)) 'invalid-argument)
                 (is (equal '(0 0 0) (a::budget pool lease))))
            (ex:rilascia-writer queue lease)))))))
