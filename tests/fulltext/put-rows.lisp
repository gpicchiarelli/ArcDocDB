(in-package #:arcdocdb.fulltext.put.tests)
(defun row-reference-values (pool lease row)
  (multiple-value-list (p:leggi-riferimento-riga-full-text pool lease row)))
(defun check-incomplete-row-reference (pool lease row expected)
  ;; C4: helper senza heap, usato anche nella misura PUT.
  (multiple-value-bind (status segment offset size version kind high low)
      (p:leggi-riferimento-riga-full-text pool lease row)
    (is (eq status expected)) (is (zerop segment)) (is (zerop offset)) (is (zerop size))
    (is (zerop version)) (is (eq :none kind)) (is (zerop high)) (is (zerop low))))
(defun check-hot-row-reference (pool lease row expected-size)
  (multiple-value-bind (status segment offset size version kind high low)
      (p:leggi-riferimento-riga-full-text pool lease row)
    (is (eq :sealed status)) (is (= segment 1)) (is (= offset (+ 64 (* row expected-size))))
    (is (= size expected-size)) (is (= version 2)) (is (eq :txid kind))
    (is (= high #xffffffff)) (is (= low #xffffffff))))

(deftest req-sec-004-row-reference-stages-and-stamps
  (dolist (version '(1 2))
    (dolist (prepared '(nil t))
      (with-reference-context (pool queue request batch registry log file) (:version version :base #xfffffffffffffffe)
        (let* ((row #xffffffff) (generation (p:inizia-put-full-text request (key) (dt::wire) row :prepared prepared
                                                                                :txid-high (if prepared #xffffffff 0)
                                                                                :txid-low (if prepared #xffffffff 0))))
          (with-reference-writer (lease queue) (check-incomplete-row-reference pool lease row :absent))
          (prepare request generation 1)
          (with-reference-writer (lease queue)
            (check-incomplete-row-reference pool lease row :absent)
            (p:prenota-put-full-text pool lease request generation)
            (check-incomplete-row-reference pool lease row :pending)
            (a::check-pending-row pool lease row :pending)
            (loop repeat 100000 until (eq :reserved (p:passo-riserva-put-full-text pool lease request generation 1))
                  finally (is (eq :reserved (p:stato-put-full-text request generation))))
            (check-incomplete-row-reference pool lease row :pending)
            (multiple-value-bind (slot token) (p:aggiungi-put-full-text pool lease request generation batch)
              (check-incomplete-row-reference pool lease row :pending)
              (w:sigilla-lotto-con-csn batch registry log 64 64)
              (check-incomplete-row-reference pool lease row :pending)
              (let* ((physical (reference-capture pool lease slot token registry log))
                     (actual (row-reference-values pool lease row)))
                (is (equal actual (cons :sealed (rest physical)))))
              (multiple-value-bind (status segment offset size actual-version kind high low)
                  (p:leggi-riferimento-riga-full-text pool lease row)
                (is (eq status :sealed)) (is (= segment 1)) (is (= offset 64))
                (is (= size (+ 24 (length (key)) (length (dt::wire))))) (is (= version actual-version))
                (is (eq kind (if prepared :txid :csn))) (is (= high #xffffffff)) (is (= low #xffffffff))))))))))

(deftest req-sec-004-row-reference-survives-wal-reuse
  (with-reference-context (pool queue request batch registry log file) ()
    (multiple-value-bind (slot token) (append-reference pool queue request batch 42)
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (with-reference-writer (lease queue)
        (let ((expected (cons :sealed (rest (reference-capture pool lease slot token registry log)))))
          (reference-retire batch registry log)
          (w:aggiungi-record batch r:+put+ (key) (dt::document '("body" . "different")))
          (is (equal expected (row-reference-values pool lease 42)))
          (check-incomplete-row-reference pool lease 0 :absent)
          (rejected (lambda () (p:leggi-legame-put-full-text pool lease slot token)) 'invalid-argument :fulltext-put-stale-batch)
          (rejected (lambda () (f:prenota-full-text pool lease (a::sources (f::riserve-full-text-configs pool) :row 42)))
                    'invalid-argument :fulltext-reservation-duplicate-row)
          (is (equal expected (row-reference-values pool lease 42))))))))

(deftest req-sec-006-row-reference-cancel-generic-and-inputs
  (with-context (pool queue configs request lease)
    (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
      (prepare request generation) (reserve pool lease request generation)
      (check-incomplete-row-reference pool lease 0 :pending)
      (p:annulla-riserva-put-full-text pool lease request generation)
      (check-incomplete-row-reference pool lease 0 :absent)
      (multiple-value-bind (slot token) (f:prenota-full-text pool lease (a::sources configs :row 0))
        (a::complete pool lease slot token) (f:trasferisci-riserva-full-text pool lease slot token)
        ;; Un trasferimento generico senza PUT non fornisce un riferimento fisico.
        (check-incomplete-row-reference pool lease 0 :pending)
        (let ((before (a::row-directory-image pool lease)))
          (rejected (lambda () (row-reference-values pool 0 0)) 'invalid-argument :writer-lease)
          (dolist (row '(nil -1 4294967296))
            (rejected (lambda () (row-reference-values pool lease row)) 'invalid-argument :fulltext-row-input))
          (is (equalp before (a::row-directory-image pool lease)))
          (is (eq :healthy (f::riserve-full-text-state pool))))))))

(deftest req-sec-006-row-reference-inconsistent-physical-fail-stop
  (with-reference-context (pool queue request batch registry log file) ()
    (multiple-value-bind (slot token) (append-reference pool queue request batch 0)
      (declare (ignore token))
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (setf (f::riserva-full-text-physical-state slot) :capturing)
      (with-reference-writer (lease queue)
        (rejected (lambda () (row-reference-values pool lease 0)) 'invariant-violation :fulltext-row-reference)
        (is (eq :faulted (f::riserve-full-text-state pool)))
        (is (= 146 (f::riserve-full-text-delta-used pool)))
        (is (= 1 (f::riserve-full-text-row-count pool)))))))
