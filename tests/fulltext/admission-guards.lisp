(in-package #:arcdocdb.fulltext.admission.tests)

(deftest req-sec-003-reservation-atomic-contract-and-row
  (with-pool (pool queue configs lease)
    (let* ((sources (sources configs)) (original (svref sources 1))
           (before (budget pool lease)) (fixed (f:leggi-bound-riserve-full-text pool lease 0)))
      (setf (svref sources 1) (svref (sources (vector (config 2))) 0))
      (rejected (lambda () (f:prenota-full-text pool lease sources)) 'invalid-argument :fulltext-contract-changed)
      (is (equal before (budget pool lease))) (is (unborrowed sources))
      (is (= fixed (f:leggi-bound-riserve-full-text pool lease 0)))
      (is (zerop (f::riserve-full-text-generation pool)))
      (setf (svref sources 1) original)
      (dt::prepare original (dt::wire) :row 1)
      (rejected (lambda () (f:prenota-full-text pool lease sources)) 'invalid-argument :fulltext-reservation-row)
      (is (equal before (budget pool lease))) (is (unborrowed sources))
      (dt::prepare original (dt::wire) :row 0)
      (multiple-value-bind (slot generation) (f:prenota-full-text pool lease sources)
        (complete pool lease slot generation)
        (rejected (lambda () (f:prenota-full-text pool lease sources)) 'invalid-argument :fulltext-reservation-duplicate-row)
        (f:annulla-riserva-full-text pool lease slot generation)))))

(deftest req-sec-006-reservation-borrow-and-generation
  (with-pool (pool queue configs lease :capacity 1)
    (let ((sources (sources configs)))
      (multiple-value-bind (slot generation) (f:prenota-full-text pool lease sources)
        (rejected (lambda () (dt::prepare (svref sources 0) (dt::wire))) 'invalid-argument :fulltext-document-borrowed)
        (is (eq :done (d:stato-preparazione-full-text (svref sources 0))))
        (is (eq :cancelled (f:annulla-riserva-full-text pool lease slot generation)))
        (is (eq :cancelled (f:annulla-riserva-full-text pool lease slot generation)))
        (is (unborrowed sources)) (is (equal '(0 0 0) (budget pool lease)))
        (multiple-value-bind (next next-generation) (f:prenota-full-text pool lease sources)
          (is (eq slot next)) (is (< generation next-generation))
          (rejected (lambda () (f:annulla-riserva-full-text pool lease slot generation)) 'invalid-argument :fulltext-reservation-token)
          (f:annulla-riserva-full-text pool lease next next-generation)))
      (setf (f::riserve-full-text-generation pool) most-positive-fixnum)
      (rejected (lambda () (f:prenota-full-text pool lease sources)) 'resource-exhausted :fulltext-reservation-generation)
      (is (unborrowed sources)) (is (equal '(0 0 0) (budget pool lease))))))

(deftest req-sec-010-reservation-public-input-guards
  (with-pool (pool queue configs lease)
    (dolist (bad (list nil #() (list (svref (sources configs) 0)) (vector nil nil)))
      (rejected (lambda () (f:prenota-full-text pool lease bad)) 'invalid-argument))
    (multiple-value-bind (slot generation) (f:prenota-full-text pool lease (sources configs))
      (dolist (quantum '(0 -1 65537 nil))
        (rejected (lambda () (f:passo-riserva-full-text pool lease slot generation quantum)) 'invalid-argument))
      (rejected (lambda () (f:trasferisci-riserva-full-text pool lease slot generation)) 'invalid-argument)
      (complete pool lease slot generation)
      (dolist (i '(-1 2 nil))
        (rejected (lambda () (f:leggi-run-riserva-full-text pool lease slot generation i)) 'invalid-argument)
        (rejected (lambda () (f:leggi-bound-riserve-full-text pool lease i)) 'invalid-argument))
      (f:annulla-riserva-full-text pool lease slot generation))
    (is (equal '(0 0 0) (budget pool lease)))))

(deftest req-sec-010-reservation-cold-guards-and-owned-config-vector
  (let* ((queue (ex:crea-coda-writer :capacity 16)) (configs (configs)))
    (dolist (bad (list #() (vector nil) (reverse configs) (vector (config 1) (config 1))
                      (vector (config 1 1) (config 1 2) (config 1 3))
                      (map 'vector #'config '(1 2 3 4 5 6 7 8 9))))
      (rejected (lambda () (pool queue bad)) 'invalid-argument))
    (rejected (lambda () (pool queue configs :max-memory 1)) 'resource-exhausted :fulltext-reservation-memory)
    (rejected (lambda () (pool queue configs :file-bytes 1)) 'resource-exhausted :fulltext-reservation-fixed)
    (dolist (options '((:capacity 0) (:max-tokens 0) (:term-bytes 0) (:delta-bytes 0) (:staging-bytes 0)))
      (rejected (lambda () (apply #'f:crea-riserve-full-text queue configs 1 options)) 'invalid-argument))
    (let* ((sources (sources configs)) (pool (pool queue configs)) (lease (ex:acquisisci-writer queue)))
      (fill configs nil)
      (unwind-protect
           (multiple-value-bind (slot generation) (f:prenota-full-text pool lease sources)
             (complete pool lease slot generation) (f:annulla-riserva-full-text pool lease slot generation))
        (ex:rilascia-writer queue lease)))))
