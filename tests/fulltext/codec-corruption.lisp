(in-package #:arcdocdb.fulltext.codec.tests)

(deftest req-sec-008-codec-crc-valid-body-errors
  (let* ((reference (golden)) (s (starts reference)) (d (aref s 1)) (p (aref s 3))
         (q (aref s 4)) (l (aref s 5)) (descriptor (descriptor)) (scratch (space)))
    (dolist (case (list (list (+ d 2) 1 2 :fulltext-dictionary-fields)
                        (list d 3 2 :fulltext-dictionary-fields)
                        (list (+ d 4) 0 4 :fulltext-term-length)
                        (list (+ d 4) 1025 4 :fulltext-term-length)
                        (list (+ d 8) 1 8 :fulltext-term-partition)
                        (list (+ d 16) 1 8 :fulltext-posting-partition)
                        (list (+ d 24) 0 8 :fulltext-posting-count)
                        (list (+ d 24) #xffffffffffffffff 8 :fulltext-posting-count)
                        (list (+ d 32) 0 2 :fulltext-dictionary-fields)
                        (list (+ d 40) 0 8 :fulltext-term-partition)
                        (list (+ d 48) 0 8 :fulltext-posting-partition)
                        (list (+ d 56) 1 8 :fulltext-section-partition)
                        (list (+ p 4) 0 4 :fulltext-posting-frequency)
                        (list (+ p 8) 1 8 :fulltext-position-partition)
                        (list (+ p 20) 2 4 :fulltext-position-order)
                        (list (+ p 32) 0 4 :fulltext-posting-order)
                        (list (+ p 32) 2 4 :fulltext-missing-length)
                        (list q 3 4 :fulltext-position-range)
                        (list (+ q 4) 0 4 :fulltext-position-order)
                        (list (+ q 8) 0 4 :fulltext-position-duplicate)
                        (list (+ l 6) 1 2 :fulltext-length-reserved)
                        (list (+ l 12) 1 4 :fulltext-length-reserved)
                        (list (+ l 8) 2 4 :fulltext-length-total)
                        (list (+ l 16) 0 4 :fulltext-length-order)
                        (list (+ l 4) 2 2 :fulltext-undeclared-field)
                        (list (+ l 16) 2 4 :fulltext-uncommitted-row)))
      (destructuring-bind (offset value width reason) case
        (let ((buffer (copy-seq reference)))
          (ft::ref-le buffer offset value width) (ft::repair buffer 0 (length buffer))
          (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                    'corruption-detected reason))))))

(deftest req-sec-008-codec-term-profile-corruption
  (let* ((reference (golden)) (s (starts reference)) (descriptor (descriptor)) (scratch (space)))
    (dolist (replacement '("Alpha" "a b c" "!!!!!"))
      (let ((buffer (copy-seq reference)))
        (replace buffer (map 'vector #'char-code replacement) :start1 (aref s 2))
        (ft::repair buffer 0 (length buffer))
        (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                  'corruption-detected :fulltext-term-profile)))
    (let ((buffer (copy-seq reference)))
      (setf (aref buffer (aref s 2)) #xc0) (ft::repair buffer 0 (length buffer))
      (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                'corruption-detected))))

(deftest req-sec-008-meta-authority-and-profile
  (let* ((reference (golden)) (descriptor (descriptor)) (scratch (space)))
    (let ((buffer (copy-seq reference)))
      (setf (aref buffer 209) 2) (ft::repair buffer 0 (length buffer))
      (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                'corruption-detected :fulltext-meta-mismatch))
    (let ((buffer (copy-seq reference)))
      (setf (aref buffer 16) 42) (ft::repair buffer 0 (length buffer))
      (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                'corruption-detected :fulltext-source-identity))
    (let ((buffer (copy-seq reference)))
      (setf (aref buffer 8) 3) (ft::repair buffer 0 (length buffer))
      (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch))
                'unsupported-format :fulltext-version)))
  (rejected (lambda () (descriptor :hint (ft::octets '(72 73 78 85)))) 'corruption-detected :fulltext-meta-value)
  (rejected (lambda () (descriptor :rows #*10)) 'corruption-detected :fulltext-meta-value)
  (rejected (lambda () (descriptor :meta (meta :profile "unicode-word-17.0.0-v1"))) 'unsupported-format :fulltext-profile)
  (dolist (fields '(((1 "body" ("body")) (1 "other" ("other")))
                    ((2 "body" ("body")) (1 "other" ("other")))
                    ((1 "body" ("body")) (2 "body" ("other")))
                    ((1 "body" ("body")) (2 "other" ("body")))
                    ((0 "body" ("body"))) ((1 "" ("body"))) ((1 "body" nil))))
    (rejected (lambda () (descriptor :meta (meta :fields fields))) 'corruption-detected))
  (dolist (ids '((0 1 1) (1 0 1) (1 1 0)))
    (rejected (lambda () (descriptor :meta (meta :ids ids))) 'corruption-detected :fulltext-meta-positive))
  (let* ((base (meta)) (nonminimal (ft::octets (append '(#x98 12) (coerce (subseq base 1) 'list)))))
    (rejected (lambda () (descriptor :meta nonminimal)) 'corruption-detected))
  (rejected (lambda () (descriptor :meta (ft::octets (append (coerce (meta) 'list) '(0)))))
            'corruption-detected :fulltext-meta-trailing))
