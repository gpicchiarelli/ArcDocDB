(in-package #:arcdocdb.fulltext.codec.tests)

(deftest req-sec-008-persisted-index-differential
  (let* ((rows (make-array 80 :element-type 'bit :initial-element 1))
         (descriptor (descriptor :rows rows :meta (meta :rows rows :fields '((1 "s" ("s")) (2 "b" ("b"))))))
         (scratch (space :max-lengths 256 :max-positions 4096)) (reference (make-array '(80 2)))
         (run (arcdocdb.fulltext.index:crea-indice-posizionale))
         (analysis (at::small-space)) (query (at::small-space)) (seed 17)
         (vocabulary #("uno" "due" "tre" "caffè" "strasse")) (checks 0))
    (flet ((choose (n) (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32))) (mod seed n)))
      (dotimes (row 80)
        (dotimes (field 2)
          (let ((words (loop repeat (choose 15) collect (aref vocabulary (choose 5)))))
            (setf (aref reference row field) words)
            (at::append-field run analysis row (1+ field) (format nil "~{~A~^ ~}" words)))))
      (at::seal run)
      (multiple-value-bind (buffer start end) (encode run descriptor scratch 9)
        (let ((view (c:crea-vista-indice-full-text buffer start end descriptor scratch)))
          (dotimes (q 60)
            (let ((terms (loop repeat (1+ (choose 5)) collect
                              (let ((i (choose 6))) (if (= i 5) "assente" (aref vocabulary i))))))
              (at::analyzed (format nil "~{~A~^ ~}" terms) :space query)
              (dotimes (row 80)
                (dotimes (field 3)
                  (dolist (mode '(:all :any :phrase))
                    (incf checks)
                    (is (eq (at::reference-match (if (< field 2) (aref reference row field) nil) terms mode)
                            (matches view row (1+ field) query mode)))))))))))
    (format t "Indice serializzato: ~D confronti con scansione indipendente.~%" checks)))

(deftest req-sec-008-codec-crc-valid-fuzz
  (let* ((reference (golden)) (descriptor (descriptor)) (scratch (space)) (seed #x5ec008)
         (accepted 0) (rejected 0))
    (dotimes (i 1024)
      (let ((buffer (copy-seq reference)))
        (dotimes (j (1+ (mod i 3)))
          (setf seed (mod (+ (* seed 1664525) 1013904223) (expt 2 32)))
          (let ((p (+ 208 (mod seed (- (length buffer) 212)))))
            (setf (aref buffer p) (logxor (aref buffer p) (ash 1 (mod (ash seed -16) 8))))))
        (ft::repair buffer 0 (length buffer))
        (handler-case
            (progn (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch) (incf accepted))
          (corruption-detected () (incf rejected)))))
    (is (> rejected 1000)) (is (= 1024 (+ accepted rejected)))
    (format t "Fuzz CRC valido: ~D rifiuti tipizzati, ~D varianti valide.~%" rejected accepted)))

(deftest req-sec-008-persisted-parallel-readers
  (let* ((buffer (golden)) (descriptor (descriptor)) (scratch (space))
         (view (c:crea-vista-indice-full-text buffer 0 (length buffer) descriptor scratch))
         (threads (make-array 4)) (errors (make-array 4 :initial-element nil)))
    (dotimes (i 4)
      (let ((worker i))
        (setf (aref threads i)
              (sb-thread:make-thread
               (lambda ()
                 (handler-case
                     (let ((query (at::small-space)))
                       (dotimes (j 100)
                         (at::analyzed "BETA ALPHA" :space query)
                         (is (matches view 0 1 query :phrase)) (is (not (matches view 1 1 query :all)))))
                   (error (condition) (setf (aref errors worker) condition))))))))
    (dotimes (i 4)
      (is (not (eq :timeout (sb-thread:join-thread (aref threads i) :timeout 30 :default :timeout))))
      (is (null (aref errors i))))))
