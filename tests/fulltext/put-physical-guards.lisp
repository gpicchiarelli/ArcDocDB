(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-sec-006-reference-rejections-preserve-state
  (with-reference-context (pool queue request batch registry log file) ()
    (multiple-value-bind (slot token) (append-reference pool queue request batch 0)
      (with-reference-writer (lease queue)
        (rejected (lambda () (reference-values pool lease slot token)) 'invalid-argument :fulltext-reference-absent)
        (rejected (lambda () (p:cattura-riferimento-put-full-text pool lease slot token registry log))
                  'invalid-argument :fulltext-reference-phase))
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (with-reference-writer (lease queue)
        (let ((before (reference-image slot)) (batch-before (snapshot batch)))
          (dolist (authority (list (list nil log) (list registry nil)
                                  (list (reference-registry) log) (list registry (w:crea-log-io file :segment 1))))
            (rejected (lambda () (apply #'p:cattura-riferimento-put-full-text pool lease slot token authority)) 'invalid-argument)
            (is (equal before (reference-image slot))) (is (equalp batch-before (snapshot batch))))
          (rejected (lambda () (p:cattura-riferimento-put-full-text pool 0 slot token registry log)) 'invalid-argument)
          (rejected (lambda () (p:cattura-riferimento-put-full-text pool lease slot (1+ token) registry log)) 'invalid-argument)
          (is (equal before (reference-image slot))) (is (equal '(146 0 1) (a::budget pool lease))))
        (let ((expected (reference-capture pool lease slot token registry log)))
          (rejected (lambda () (p:cattura-riferimento-put-full-text pool lease slot token registry log))
                    'invalid-argument :fulltext-reference-captured)
          (is (equal expected (reference-values pool lease slot token))))))))

(deftest req-wal-005-reference-rejects-manual-and-late-seals
  (dolist (mode '(:manual :group :reused))
    (with-reference-context (pool queue request batch registry log file) ()
      (multiple-value-bind (slot token) (append-reference pool queue request batch 0)
        (if (eq mode :manual) (w:sigilla-lotto batch 99 64 64)
            (w:sigilla-lotto-con-csn batch registry log 64 64))
        (when (eq mode :group) (w:aggiungi-lotto (w:crea-gruppo log) batch))
        (when (eq mode :reused) (reference-retire batch registry log))
        (with-reference-writer (lease queue)
          (let ((before (reference-image slot)))
            (rejected (lambda () (p:cattura-riferimento-put-full-text pool lease slot token registry log)) 'invalid-argument
                      (case mode (:manual :lotto-csn-free) (:group :fulltext-reference-phase) (:reused :fulltext-put-stale-batch)))
            (is (equal before (reference-image slot))) (is (equal '(146 0 1) (a::budget pool lease)))
            (is (eq :healthy (f::riserve-full-text-state pool)))))))))

(deftest req-wal-005-reference-header-corruption-fail-stop
  (dolist (prepared '(nil t))
    (dolist (mode '(:header :stamp :flags :extent :offset))
      (with-reference-context (pool queue request batch registry log file) ()
        (multiple-value-bind (slot token start end)
            (append-reference pool queue request batch 0 :prepared prepared :stamp (if prepared #xffffffffffffffff 0))
          (declare (ignore end))
          (w:sigilla-lotto-con-csn batch registry log 64 64)
          (let ((data (w::lotto-buffer batch)) (before (reference-image slot)))
            (ecase mode
              (:header (setf (aref data start) (logxor 1 (aref data start))))
              (:stamp (setf (aref data (+ start 16)) (logxor 1 (aref data (+ start 16)))))
              (:flags (setf (aref data (+ start 9)) (if prepared 0 1)))
              (:extent (incf (aref data (+ start 12))))
              (:offset (setf (w::lotto-start batch) most-positive-fixnum)))
            (unless (member mode '(:header :offset))
              (b:scrivi-u32 data start (ft::reference-crc data (+ start 4) (+ start 24))))
            (let ((bytes-before (copy-seq data)))
              (with-reference-writer (lease queue)
                (rejected (lambda () (p:cattura-riferimento-put-full-text pool lease slot token registry log))
                          'arcdocdb.conditions:arcdocdb-error))
              (is (equalp bytes-before data)))
            (is (equal before (reference-image slot))) (is (eq :faulted (w:stato-lotto batch)))
            (is (eq :faulted (f::riserve-full-text-state pool)))
            (is (= 146 (f::riserve-full-text-delta-used pool)))
            (is (w::lotto-csn-pending batch))))))))
