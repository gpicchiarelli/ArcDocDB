(defpackage #:arcdocdb.fulltext.codec.tests
  (:use #:cl)
  (:shadow #:space)
  (:local-nicknames (#:c #:arcdocdb.fulltext.codec) (#:a #:arcdocdb.fulltext.analysis)
                    (#:at #:arcdocdb.fulltext.analysis.tests) (#:ft #:arcdocdb.fulltext.format.tests))
  (:import-from #:arcdocdb.conditions #:arcdocdb-error #:corruption-detected #:invalid-argument
                #:resource-exhausted #:unsupported-format #:invariant-violation #:error-reason)
  (:export #:run))
(in-package #:arcdocdb.fulltext.codec.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body) `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defmacro is (form) `(unless ,form (error "Codec full text: ~S" ',form)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test del codec completo full text superati.~%" (length *tests*)) t)
(defun rejected (thunk type &optional reason)
  (let ((caught nil))
    (handler-case (funcall thunk) (arcdocdb-error (c) (setf caught c)))
    (is caught) (is (typep caught type)) (when reason (is (eq reason (error-reason caught))))))
(defun golden ()
  (let* ((path (asdf:system-relative-pathname "arcdocdb" "tests/fulltext/minimum-v2.hex"))
         (hex (remove-if (lambda (ch) (find ch '(#\Space #\Tab #\Newline #\Return))) (uiop:read-file-string path))))
    (is (evenp (length hex)))
    (let ((buffer (make-array (/ (length hex) 2) :element-type '(unsigned-byte 8))))
      (dotimes (i (length buffer) buffer)
        (setf (aref buffer i) (parse-integer hex :start (* i 2) :end (+ (* i 2) 2) :radix 16 :junk-allowed nil))))))
(defun starts (buffer &optional (prefix 0))
  (map 'vector (lambda (i) (+ prefix (ft::ref-u64 buffer (+ prefix 72 (* i 24))))) #(0 1 2 3 4 5)))
(defun ref-header (major n)
  (let* ((width (cond ((< n 24) 0) ((< n 256) 1) ((< n 65536) 2) ((< n (expt 2 32)) 4) (t 8)))
         (ai (if (zerop width) n (ecase width (1 24) (2 25) (4 26) (8 27)))))
    (cons (+ (* major 32) ai) (loop for i downfrom (1- width) to 0 collect (mod (floor n (expt 256 i)) 256)))))
(defun ref-cbor (value)
  (etypecase value
    (integer (ref-header 0 value))
    (string (let ((data (sb-ext:string-to-octets value :external-format :utf-8)))
              (append (ref-header 3 (length data)) (coerce data 'list))))
    (list (append (ref-header 4 (length value)) (mapcan #'ref-cbor value)))))
(defun meta (&key (fields '((1 "body" ("body")))) (rows #*11) (hint (ft::octets '(72 73 78 84)))
                 (profile "unicode-word-18.0.0-v1") (ids '(1 1 1))
                 (limits '(16777216 1024 1048576 67108864 268435456)))
  (ft::octets (ref-cbor (append ids (list 64 (length hint) (ft::ref-crc hint 0 (length hint)) (length rows)
                                        profile 1 fields limits (count 1 rows))))))
(defun descriptor (&key (meta (meta)) (rows #*11) (identity (ft::id-serie)) (segment 7)
                       (hint (ft::octets '(72 73 78 84))))
  (c:crea-descrittore-full-text meta identity segment 64 hint 0 (length hint) rows))
(defun space (&key (max-lengths 64) (max-positions 1024) (max-term-bytes 1024))
  (c:crea-spazio-codec-full-text :max-lengths max-lengths :max-positions max-positions
                               :max-term-bytes max-term-bytes :max-memory 2097152))
(defun sample-run ()
  (let ((run (arcdocdb.fulltext.index:crea-indice-posizionale :max-tokens 32 :max-bytes 512 :max-fields 16))
        (analysis (at::small-space)))
    (at::append-field run analysis 0 1 "alpha beta alpha")
    (at::append-field run analysis 1 1 "beta") (at::seal run) run))
(defun encode (run descriptor scratch &optional (prefix 0))
  (let* ((size (c:dimensione-indice-full-text run descriptor scratch))
         (buffer (make-array (+ size prefix 11) :element-type '(unsigned-byte 8) :initial-element #xac)))
    (is (= (+ prefix size) (c:scrivi-indice-full-text run descriptor scratch buffer prefix (length buffer))))
    (values buffer prefix (+ prefix size))))
(defun matches (view row field query mode)
  (c:corrisponde-riga-indice-full-text view row field query mode))
