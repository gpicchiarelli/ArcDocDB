;;;; C4: byte CBOR/attesi espliciti, encoder dei test indipendente dal prodotto.
(defpackage #:arcdocdb.fulltext.document.tests
  (:use #:cl)
  (:local-nicknames (#:d #:arcdocdb.fulltext.document) (#:r #:arcdocdb.fulltext.index)
                    (#:a #:arcdocdb.fulltext.analysis) (#:at #:arcdocdb.fulltext.analysis.tests)
                    (#:ct #:arcdocdb.fulltext.codec.tests) (#:c #:arcdocdb.fulltext.codec)
                    (#:ft #:arcdocdb.fulltext.format.tests))
  (:import-from #:arcdocdb.conditions #:arcdocdb-error #:invalid-argument #:resource-exhausted
                #:corruption-detected #:unsupported-format #:error-reason)
  (:export #:run))
(in-package #:arcdocdb.fulltext.document.tests)
(defvar *tests* nil)
(defmacro deftest (name &body body) `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defmacro is (form) `(unless ,form (error "Preparazione full text: ~S" ',form)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test della preparazione documentale full text superati.~%" (length *tests*)) t)
(defun rejected (thunk type &optional reason) (ct::rejected thunk type reason))
(defun text (string) (sb-ext:string-to-octets string :external-format :utf-8))
(defun fields (&optional (definitions '((1 "subject" ("subject")) (2 "body" ("body")))))
  (map 'vector (lambda (field) (vector (first field) (text (second field)) (map 'vector #'text (third field))))
       definitions))
(defun config (&key (definitions '((1 "subject" ("subject")) (2 "body" ("body"))))
                   (limits #(16777216 1024 1048576 67108864 268435456)) (id 1))
  (d:crea-configurazione-full-text (fields definitions) id id id :limits limits))
(defun task (&rest args)
  (let ((config (if (typep (first args) 'd:configurazione-full-text) (pop args) (config))))
    (d:crea-preparazione-full-text config :max-scalars (getf args :scalars 4096)
                                  :max-tokens (getf args :tokens 128) :token-bytes (getf args :bytes 16384))))
(defun wire ()
  ;; A2, "body":"beta", "subject":"alpha"; 25 byte congelati prima del primo parsing.
  (ft::octets '(162 100 98 111 100 121 100 98 101 116 97 103 115 117 98 106 101 99 116 101 97 108 112 104 97)))
(defun ref-cbor-list (value)
  (typecase value
    (string (let ((bytes (text value))) (append (ct::ref-header 3 (length bytes)) (coerce bytes 'list))))
    (integer (if (minusp value) (ct::ref-header 1 (- -1 value)) (ct::ref-header 0 value)))
    (symbol (ecase value (:null '(246)) (:true '(245)) (:false '(244))))
    (cons
     (ecase (first value)
       (:map (append (ct::ref-header 5 (length (rest value)))
                     (loop for pair in (rest value) append (append (ref-cbor-list (car pair)) (ref-cbor-list (cdr pair))))))
       (:array (append (ct::ref-header 4 (length (rest value))) (mapcan #'ref-cbor-list (rest value))))
       (:tag (append (ct::ref-header 6 (second value)) (ref-cbor-list (third value))))
       (:bytes (append (ct::ref-header 2 (length (second value))) (coerce (second value) 'list)))))
    (t (error "Valore fixture sconosciuto ~S" value))))
(defun document (&rest pairs) (ft::octets (ref-cbor-list (cons :map pairs))))
(defun complete (task &optional (quantum 4096))
  (loop repeat 1000000 until (eq :done (d:passo-preparazione-full-text task quantum))
        finally (is (eq :done (d:stato-preparazione-full-text task)))))
(defun prepare (task input &key (row 0) (start 0) (end (length input)) (quantum 4096)
                              (max-work 268435456) (max-file-bytes 17179869184) (max-nodes 16777216))
  (d:inizia-preparazione-full-text task input start end row :max-work max-work
                                  :max-file-bytes max-file-bytes :max-nodes max-nodes)
  (complete task quantum) (d:risultati-preparazione-full-text task))
(defun matches (run row field value mode &optional (query (at::small-space)))
  (at::analyzed value :space query) (r:corrisponde-riga-full-text run row field query mode))
(defun file-view (run definitions &key (limits '(16777216 1024 1048576 67108864 268435456)) (ids '(1 1 1)))
  (let* ((meta (ct::meta :rows #*1 :fields definitions :limits limits :ids ids))
         (descriptor (ct::descriptor :rows #*1 :meta meta)) (scratch (ct::space)))
    (multiple-value-bind (bytes start end) (ct::encode run descriptor scratch)
      (values (c:crea-vista-indice-full-text bytes start end descriptor scratch) (- end start)))))
