(in-package #:arcdocdb.fulltext.document.tests)

(deftest req-sec-003-cbor-nntp-independent-wire
  (let ((task (task)) (input (wire)))
    (is (equalp input (document '("body" . "beta") '("subject" . "alpha"))))
    (dotimes (prefix 32)
      (let ((buffer (make-array (+ prefix (length input) 11) :element-type '(unsigned-byte 8) :initial-element 42)))
        (replace buffer input :start1 prefix)
        (let ((before (copy-seq buffer)))
          (multiple-value-bind (run upper file-upper prepared used)
              (prepare task buffer :start prefix :end (+ prefix (length input)) :quantum (1+ prefix))
            (is (= upper 145)) (is (= prepared 73)) (is (= used 9))
            (is (= file-upper (+ upper (d:limite-fisso-indice-full-text (d::preparazione-full-text-config task)))))
            (is (matches run 0 1 "ALPHA" :all)) (is (matches run 0 2 "beta" :all))
            (is (not (matches run 0 1 "beta" :any))) (is (not (matches run 1 1 "alpha" :all)))
            (is (equalp buffer before))
            (multiple-value-bind (view size) (file-view run '((1 "subject" ("subject")) (2 "body" ("body"))))
              (is (<= size file-upper))
              (let ((query (at::small-space)))
                (at::analyzed "beta" :space query) (is (c:corrisponde-riga-indice-full-text view 0 2 query :phrase))))))))))

(deftest req-sec-010-document-bound-distinct-and-empty
  (let ((task (task (config :definitions '((1 "body" ("body")))))))
    (multiple-value-bind (run upper file-upper prepared used)
        (prepare task (document '("body" . "alpha alpha")))
      (is (eq :sealed (r::indice-posizionale-state run))) (is (= upper 77))
      (is (= prepared 62)) (is (= used 11)) (is (> file-upper upper))))
  (let ((task (task)))
    (multiple-value-bind (run upper file-upper prepared used) (prepare task (document '("body" . "")))
      (is (= upper 16)) (is (= prepared 12)) (is (zerop used)) (is (plusp file-upper))
      (is (= (r::indice-posizionale-field-count run) 1)) (is (zerop (r::indice-posizionale-count run))))
    (multiple-value-bind (run upper file-upper prepared used) (prepare task (document))
      (is (zerop upper)) (is (zerop prepared)) (is (zerop used)) (is (plusp file-upper))
      (is (zerop (r::indice-posizionale-field-count run))))))

(deftest req-sec-007-document-nested-and-unicode
  (let* ((defs '((1 "subject" ("headers" "subject")) (7 "body" ("body"))))
         (task (task (config :definitions defs)))
         (input (document '("body" . "Straße café alpha alpha")
                          '("ignored" . (:array "subject" (:map ("subject" . "wrong"))))
                          '("headers" . (:map ("subject" . "COMPosizione À"))))))
    (multiple-value-bind (run upper bound) (prepare task input :quantum 1)
      (is (plusp upper))
      (is (matches run 0 1 "composizione à" :phrase))
      (is (matches run 0 7 "STRASSE CAFÉ" :phrase))
      (is (matches run 0 7 "alpha alpha" :phrase))
      (is (not (matches run 0 1 "wrong" :any)))
      (multiple-value-bind (view size) (file-view run defs)
        (is (<= size bound))
        (let ((query (at::small-space)))
          (at::analyzed "strasse café" :space query)
          (is (c:corrisponde-riga-indice-full-text view 0 7 query :phrase)))))
    (is (null (d::preparazione-full-text-input task)))
    (is (null (a::spazio-full-text-input (d::preparazione-full-text-analysis task))))))

(deftest req-sec-003-document-tagged-and-complex-keys
  (let* ((task (task))
         (input (document '((:tag 42 "body") . "wrong") '((:array "subject") . "wrong")
                          '("headers" . (:map ("subject" . "wrong")))
                          '("body" . "beta") '("subject" . "alpha"))))
    (let ((run (prepare task input)))
      (is (matches run 0 1 "alpha" :all)) (is (matches run 0 2 "beta" :all))
      (is (not (matches run 0 2 "wrong" :any)))))
  (let* ((task (task (config :definitions '((1 "body" ("" "body"))))))
         (run (prepare task (document '("" . (:map ("body" . "Alpha")))))))
    (is (matches run 0 1 "alpha" :phrase))))

(deftest req-sec-003-document-config-owned-and-fixed-ids
  (let* ((fields (fields)) (limits (copy-seq #(16777216 1024 1048576 67108864 268435456)))
         (config (d:crea-configurazione-full-text fields #xffffffffffffffff #xffffffffffffffff #xffffffffffffffff :limits limits)))
    (fill (svref (svref fields 0) 1) 0)
    (fill (svref (svref (svref fields 0) 2) 0) 0)
    (fill limits 1) (setf (svref fields 0) nil)
    (multiple-value-bind (run upper bound) (prepare (task config) (wire))
      (is (= upper 145)) (is (matches run 0 1 "alpha" :all))
      (multiple-value-bind (view size)
          (file-view run '((1 "subject" ("subject")) (2 "body" ("body")))
                     :ids '(18446744073709551615 18446744073709551615 18446744073709551615))
        (is (<= size bound)) (is (typep view 'c:vista-indice-full-text))))))
