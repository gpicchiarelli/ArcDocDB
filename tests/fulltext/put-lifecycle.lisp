(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-wal-005-put-stale-batch-incarnation
  (with-context (pool queue configs request lease)
    (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)) (batch (batch)))
      (prepare request generation) (reserve pool lease request generation)
      (multiple-value-bind (slot token) (p:aggiungi-put-full-text pool lease request generation batch)
        ;; Fixture di ciclo di vita, non prova di durability: le precondizioni CSN/owner sono libere.
        (setf (w::lotto-state batch) :durable)
        (w:riusa-lotto batch)
        (w:aggiungi-record batch r:+put+ (key) (dt::document '("body" . "beta") '("subject" . "omega")))
        (rejected (lambda () (p:leggi-legame-put-full-text pool lease slot token)) 'invalid-argument :fulltext-put-stale-batch)
        (is (equal '(146 0 1) (a::budget pool lease)))
        (is (eq :healthy (f::riserve-full-text-state pool))))
      (setf (w::lotto-state batch) :durable (w::lotto-incarnation batch) most-positive-fixnum)
      (let ((before (snapshot batch)))
        (rejected (lambda () (w:verifica-riuso-lotto batch)) 'resource-exhausted :lotto-incarnation)
        (rejected (lambda () (w:riusa-lotto batch)) 'resource-exhausted :lotto-incarnation)
        (is (equalp before (snapshot batch)))))))

(deftest req-sec-006-put-cancel-and-reuse-stages
  (with-context (pool queue configs request lease)
    (dotimes (i 64)
      (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
        (p:passo-put-full-text request generation (1+ i))
        (p:annulla-put-full-text request generation)
        (is (eq :cancelled (p:annulla-put-full-text request generation)))))
    (dotimes (i 64)
      (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
        (prepare request generation) (p:prenota-put-full-text pool lease request generation)
        (p:passo-riserva-put-full-text pool lease request generation (1+ i))
        (rejected (lambda () (p:inizia-put-full-text request (key) (dt::wire) 1)) 'invalid-argument :fulltext-put-busy)
        (p:annulla-riserva-put-full-text pool lease request generation)
        (is (equal '(0 0 0) (a::budget pool lease)))))))

(deftest req-sec-006-put-wrong-lease-and-generation
  (with-context (pool queue configs request lease)
    (let ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)))
      (prepare request generation)
      (rejected (lambda () (p:prenota-put-full-text pool 0 request generation)) 'invalid-argument :writer-lease)
      (rejected (lambda () (p:prenota-put-full-text pool lease request (1+ generation))) 'invalid-argument :fulltext-put-token)
      (reserve pool lease request generation)
      (rejected (lambda () (p:passo-riserva-put-full-text pool lease request generation 0)) 'invalid-argument)
      (is (eq :reserved (p:stato-put-full-text request generation)))
      (p:annulla-riserva-put-full-text pool lease request generation))))

(deftest req-sec-006-put-interrupted-append-fail-stop
  (dolist (after-copy '(nil t))
    (with-context (pool queue configs request lease)
      (let* ((generation (p:inizia-put-full-text request (key) (dt::wire) 0)) (batch (batch))
             (symbol 'w::append-cornice-verificata) (original (symbol-function symbol)))
        (prepare request generation) (reserve pool lease request generation)
        (unwind-protect
             (progn
               (setf (symbol-function symbol)
                     (lambda (batch frame start end)
                       (when after-copy (funcall original batch frame start end)) (throw 'interrupted :stopped)))
               (is (eq :stopped (catch 'interrupted (p:aggiungi-put-full-text pool lease request generation batch))))
               (is (eq :faulted (p:stato-put-full-text request generation)))
               (is (eq :faulted (f::riserve-full-text-state pool))) (is (eq :faulted (w:stato-lotto batch)))
               (is (= 146 (f::riserve-full-text-delta-used pool)))
               (is (zerop (f::riserve-full-text-staging-used pool)))
               (is (= (if after-copy 1 0) (w::lotto-count batch))))
          (setf (symbol-function symbol) original))))))
