(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-sec-004-reference-v1-v2-ordinary-prepared-boundaries
  (dolist (version '(1 2))
    (dolist (prepared '(nil t))
      (dolist (stamp '(1 4294967295 4294967296 18446744073709551615))
        (with-reference-context (pool queue request batch registry log file) (:version version :base (1- stamp))
          (w:aggiungi-record batch r:+tombstone+ (dt::text "old") (ft::bytes))
          (multiple-value-bind (slot token start end)
              (append-reference pool queue request batch #xffffffff :prepared prepared :stamp (if prepared #xffffffffffffffff 0))
            (w:sigilla-lotto-con-csn batch registry log 64 64)
            (with-reference-writer (lease queue)
              (let ((values (reference-capture pool lease slot token registry log)))
                (is (equal (list #xffffffff 1 (+ 64 start) (- end start) version (if prepared :txid :csn)) (subseq values 0 6)))
                (is (= (reference-stamp values) (if prepared #xffffffffffffffff stamp)))
                (is (equal '(146 0 1) (a::budget pool lease)))
                (is (eq :sealed (w:stato-lotto batch)))
                (is (= 64 (arcdocdb.io:posizione-scritta file)))
                (is (eq :pendente (w:stato-csn-lotto batch)))))))))))

(deftest req-sec-004-reference-survives-real-batch-retirement
  (with-reference-context (pool queue request batch registry log file) ()
    (multiple-value-bind (slot token start end) (append-reference pool queue request batch 42)
      (declare (ignore start end))
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (let ((expected nil))
        (with-reference-writer (lease queue) (setf expected (reference-capture pool lease slot token registry log)))
        (reference-retire batch registry log)
        (w:aggiungi-record batch r:+put+ (key) (dt::document '("body" . "beta") '("subject" . "omega")))
        (with-reference-writer (lease queue)
          (is (equal expected (reference-values pool lease slot token)))
          (rejected (lambda () (p:leggi-legame-put-full-text pool lease slot token)) 'invalid-argument :fulltext-put-stale-batch)
          (is (equal '(146 0 1) (a::budget pool lease)))
          (is (dt::matches (f:leggi-run-riserva-full-text pool lease slot token 0) 42 1 "alpha" :all)))
        (is (> (arcdocdb.io:posizione-durevole file) 64))))))

(deftest req-wal-005-reference-header-only-crc
  (with-reference-context (pool queue request batch registry log file) ()
    (multiple-value-bind (slot token) (append-reference pool queue request batch 0 :prepared t :stamp #xffffffffffffffff)
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (let ((original (symbol-function 'b:crc32c)) (calls 0))
        (unwind-protect
             (progn
               (setf (symbol-function 'b:crc32c)
                     (lambda (buffer start end &optional (seed 0))
                       (incf calls) (is (= (- end start) 20)) (funcall original buffer start end seed)))
               (with-reference-writer (lease queue)
                 ;; Controllo negativo: una verifica completa deve raggiungere il body e fallire nel probe.
                 (is (handler-case
                         (progn (r:verifica-cornice (w::lotto-buffer batch) 0 (f::riserva-full-text-record-end slot)) nil)
                       (simple-error () t)))
                 (setf calls 0)
                 (reference-capture pool lease slot token registry log)
                 (is (= calls 1))
                 (reference-values pool lease slot token) (is (= calls 1))))
          (setf (symbol-function 'b:crc32c) original))))))

(deftest req-sec-006-reference-interrupted-capture-fail-stop
  (dolist (after '(nil t))
    (with-reference-context (pool queue request batch registry log file) ()
      (multiple-value-bind (slot token) (append-reference pool queue request batch 0)
        (w:sigilla-lotto-con-csn batch registry log 64 64)
        (let ((original (symbol-function 'p::installa-riferimento-put)))
          (unwind-protect
               (progn
                 (setf (symbol-function 'p::installa-riferimento-put)
                       (lambda (slot batch high low)
                         (if after (funcall original slot batch high low)
                             (setf (f::riserva-full-text-physical-state slot) :capturing))
                         (throw 'interrupted :stopped)))
                 (with-reference-writer (lease queue)
                   (is (eq :stopped (catch 'interrupted (p:cattura-riferimento-put-full-text pool lease slot token registry log))))))
            (setf (symbol-function 'p::installa-riferimento-put) original)))
        (is (eq :faulted (f::riserve-full-text-state pool))) (is (eq :faulted (w:stato-lotto batch)))
        (is (= 146 (f::riserve-full-text-delta-used pool))) (is (zerop (f::riserve-full-text-staging-used pool)))
        (is (not (f::riserve-full-text-effect pool)))))))

(defun reference-worker (ready start)
  (with-reference-context (pool queue request batch registry log file) ()
    (let ((slots (make-array 4)) (tokens (make-array 4)))
      (sb-thread:signal-semaphore ready)
      (is (sb-thread:wait-on-semaphore start :timeout 15))
      (dotimes (i 4)
        (multiple-value-bind (slot token) (append-reference pool queue request batch i)
          (setf (svref slots i) slot (svref tokens i) token)))
      (w:sigilla-lotto-con-csn batch registry log 64 64)
      (with-reference-writer (lease queue)
        (dotimes (i 4)
          (let ((reference (reference-capture pool lease (svref slots i) (svref tokens i) registry log)))
            (is (= i (first reference))) (is (= 1 (reference-stamp reference)))))))
  t))

(deftest req-sec-006-reference-four-independent-writers
  (let* ((ready (sb-thread:make-semaphore)) (start (sb-thread:make-semaphore))
         (threads (loop repeat 4 collect
                    (sb-thread:make-thread (lambda () (reference-worker ready start)) :name "fulltext-physical-writer"))))
    (is (sb-thread:wait-on-semaphore ready :n 4 :timeout 15))
    (dotimes (i 4) (sb-thread:signal-semaphore start))
    (dolist (thread threads) (is (eq t (sb-thread:join-thread thread :timeout 30 :default :timeout))))))
