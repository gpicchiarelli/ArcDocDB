;;;; C4: modello associativo, separato dalla directory e dalla ricerca del prodotto.
(in-package #:arcdocdb.fulltext.admission.tests)
(defun row-result (pool lease row)
  (multiple-value-list (f:trova-riga-trasferita-full-text pool lease row)))
(defun check-pending-row (pool lease row expected)
  ;; Anche chiamato nel percorso misurato: niente liste o oracle allocanti.
  (multiple-value-bind (status slot token) (f:trova-riga-trasferita-full-text pool lease row)
    (is (eq status expected)) (is (null slot)) (is (zerop token))))
(defun check-row-model (pool lease model)
  (let ((keys (sort (mapcar #'first model) #'<)))
    (is (= (length model) (f::riserve-full-text-count pool) (f::riserve-full-text-row-count pool)))
    (is (equal keys (coerce (subseq (f::riserve-full-text-rows pool) 0 (length keys)) 'list)))
    (dolist (row '(0 1 7 42 256 65536 2147483648 4294967294 4294967295))
      (let* ((entry (assoc row model)) (actual (row-result pool lease row)))
        (is (equal actual (cond ((null entry) '(:absent nil 0))
                               ((eq :transferred (fourth entry)) (list :transferred (second entry) (third entry)))
                               (t '(:pending nil 0)))))))
    (loop for row in keys for i from 0 do
      (is (eq (second (assoc row model))
              (svref (f::riserve-full-text-slots pool) (aref (f::riserve-full-text-row-slots pool) i)))))))
(defun model-add-row (pool lease configs model row)
  (multiple-value-bind (slot token) (f:prenota-full-text pool lease (sources configs :row row))
    (let ((next (acons row (list slot token :copying) model)))
      (check-row-model pool lease next) next)))
(defun model-cancel-row (pool lease model row)
  (let ((entry (assoc row model)))
    (f:annulla-riserva-full-text pool lease (second entry) (third entry))
    (let ((next (remove row model :key #'first))) (check-row-model pool lease next) next)))
(defun row-directory-image (pool lease)
  (list (copy-seq (f::riserve-full-text-rows pool)) (copy-seq (f::riserve-full-text-row-slots pool))
        (f::riserve-full-text-row-count pool) (f::riserve-full-text-generation pool) (budget pool lease)))
