(in-package #:arcdocdb.fulltext.put.tests)

(deftest req-sec-004-reference-native-file-independent-record
  (dolist (version '(1 2))
    (dolist (prepared '(nil t))
      (let* ((directory (uiop:symbol-call "ARCDOCDB.IO.TESTS" "FRESH-DIRECTORY"))
             (path (merge-pathnames "article.tmp" directory))
             (header (make-array 64 :element-type '(unsigned-byte 8) :initial-element 0))
             (serie (make-array 16 :element-type '(unsigned-byte 8) :initial-element 0))
             (file nil))
        (unwind-protect
             (let* ((configs (a::configs)) (queue (ex:crea-coda-writer :capacity 16)) (pool (a::pool queue configs))
                    (request (request configs :version version)) (batch (batch :version version)) (registry (reference-registry)))
               (arcdocdb.storage.format:scrivi-header-segmento header 0 serie 1 0 :version version)
               (setf file (arcdocdb.io:crea-temporaneo path))
               (arcdocdb.io:append-esatto file header 0 64) (arcdocdb.io:durable-flush file)
               (let ((log (w:crea-log-io file :segment 1 :version version)))
                 (multiple-value-bind (slot token) (append-reference pool queue request batch 7 :prepared prepared :stamp (if prepared 99 0))
                   (w:sigilla-lotto-con-csn batch registry log 64 64)
                   (let ((reference nil))
                     (with-reference-writer (lease queue) (setf reference (reference-capture pool lease slot token registry log)))
                     (reference-retire batch registry log)
                     (arcdocdb.io:chiudi file)
                     (setf file (arcdocdb.io:apri-lettura path))
                     (let* ((expected (ft::reference-put (key) (dt::wire) (if prepared 99 1) (if prepared 1 0)))
                            (actual (make-array (fourth reference) :element-type '(unsigned-byte 8))))
                       (is (= 64 (third reference))) (is (= (length expected) (length actual)))
                       (arcdocdb.io:leggi-esatto file actual 0 (length actual) (third reference))
                       (is (equalp expected actual))
                       (with-reference-writer (lease queue)
                         (is (equal reference (reference-values pool lease slot token)))))))))
          (when (and file (eq :open (arcdocdb.io:stato-file file))) (arcdocdb.io:chiudi file))
          ;; C4: contenuti della directory esclusiva 0700 di questa fixture soltanto.
          (uiop:delete-directory-tree directory :validate t))))))
