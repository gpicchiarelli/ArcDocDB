(in-package #:arcdocdb.fulltext.analysis.tests)

(deftest req-sec-007-scalar-reader-exhaustive
  (let ((buffer (make-array 7 :element-type '(unsigned-byte 8) :initial-element #xaa)) (count 0))
    (loop for cp from 0 to #x10ffff unless (<= #xd800 cp #xdfff) do
      (let* ((width (cond ((< cp #x80) 1) ((< cp #x800) 2) ((< cp #x10000) 3) (t 4)))
             (rest cp))
        (loop for i downfrom width above 1 do
          (setf (aref buffer i) (+ #x80 (mod rest 64)) rest (floor rest 64)))
        (setf (aref buffer 1) (+ rest (ecase width (1 0) (2 #xc0) (3 #xe0) (4 #xf0))))
        (multiple-value-bind (actual next) (arcdocdb.utf8:leggi-scalare-utf8 buffer 1 (1+ width))
          (is (= actual cp)) (is (= next (1+ width))))
        (incf count)))
    (is (= count 1112064))
    (rejected (lambda () (arcdocdb.utf8:leggi-scalare-utf8 buffer 0 0)) 'corruption-detected :utf8-truncated)
    (rejected (lambda () (arcdocdb.utf8:leggi-scalare-utf8 buffer -1 1)) 'invalid-argument :utf8-range)))

(deftest req-sec-007-profile-examples
  (dolist (quantum '(1 7 4096))
    (is (equal '("caffè" "strasse" "l'acqua" "123,456" "foo_bar" "café" "café")
               (analyzed "CAFFÈ Straße l'acqua 123,456 foo_bar CAFÉ CAFÉ" :quantum quantum)))
    (is (equal '("uno" "uno" "due") (analyzed "Uno uno... due! 😀" :quantum quantum)))
    (is (null (analyzed "😀 !!!" :quantum quantum)))
    (is (null (analyzed "" :quantum quantum)))
    (is (equal '("a" "b") (analyzed (coerce (list #\A #\Null #\B) 'string) :quantum quantum)))
    (is (equal '("가" "각") (analyzed "가 각" :quantum quantum)))))

(deftest req-sec-007-state-and-utf8-guards
  (let* ((space (small-space)) (input (bytes "abc")))
    (rejected (lambda () (risultati-analisi-full-text space)) 'invalid-argument :fulltext-analysis-incomplete)
    (rejected (lambda () (passo-analisi-full-text space 1)) 'invalid-argument :fulltext-analysis-state)
    (inizia-analisi-full-text space input 0 3 :max-tokens 128)
    (rejected (lambda () (inizia-analisi-full-text space input 0 3 :max-tokens 128))
              'invalid-argument :fulltext-analysis-busy)
    (rejected (lambda () (passo-analisi-full-text space 0)) 'invalid-argument :fulltext-analysis-step)
    (complete space) (is (eq :done (passo-analisi-full-text space 1)))
    (dolist (bad '((#x80) (#xc0 #x80) (#xed #xa0 #x80) (#xf4 #x90 #x80 #x80) (#xe2 #x82)))
      (let ((data (make-array (length bad) :element-type '(unsigned-byte 8) :initial-contents bad)))
        (inizia-analisi-full-text space data 0 (length data) :max-tokens 128)
        (rejected (lambda () (complete space)) 'corruption-detected nil)
        (is (eq :failed (a::spazio-full-text-phase space))) (is (null (a::spazio-full-text-input space)))
        (rejected (lambda () (risultati-analisi-full-text space)) 'invalid-argument :fulltext-analysis-incomplete)))
    (is (equal '("abc") (analyzed "ABC" :space space)))))

(deftest req-sec-010-analysis-budgets
  (rejected (lambda () (crea-spazio-full-text :max-memory 1)) 'resource-exhausted :fulltext-space-memory)
  (rejected (lambda () (crea-spazio-full-text :max-scalars 0)) 'invalid-argument :fulltext-space-budget)
  (dolist (case '(("abc" :max-work 1 :fulltext-analysis-work)
                  ("abc" :max-term-bytes 2 :fulltext-term-bytes)
                  ("a b" :max-tokens 1 :fulltext-token-count)))
    (let* ((space (small-space)) (data (bytes (first case))))
      (apply #'inizia-analisi-full-text space data 0 (length data)
             (append (unless (eq :max-tokens (second case)) '(:max-tokens 128)) (subseq case 1 3)))
      (rejected (lambda () (complete space)) 'resource-exhausted (fourth case))
      (is (zerop (a::spazio-full-text-token-count space)))))
  (let ((space (small-space :scalars 1)) (input (bytes "ab")))
    (inizia-analisi-full-text space input 0 2 :max-tokens 128)
    (rejected (lambda () (complete space)) 'resource-exhausted :fulltext-scalar-capacity))
  (let ((space (small-space :bytes 1)) (input (bytes "ab")))
    (inizia-analisi-full-text space input 0 2 :max-tokens 128)
    (rejected (lambda () (complete space)) 'resource-exhausted :fulltext-token-bytes)))
