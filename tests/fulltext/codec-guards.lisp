(in-package #:arcdocdb.fulltext.codec.tests)

(deftest req-sec-010-codec-preflight-preserves-destination
  (let* ((run (sample-run)) (descriptor (descriptor)) (scratch (space))
         (size (c:dimensione-indice-full-text run descriptor scratch))
         (buffer (make-array size :element-type '(unsigned-byte 8) :initial-element #xac)))
    (dolist (args (list (list buffer 0 (1- size)) (list buffer 0 size :max-bytes (1- size))
                       (list buffer 0 size :max-work 200)))
      (let ((before (copy-seq buffer)))
        (rejected (lambda () (apply #'c:scrivi-indice-full-text run descriptor scratch args)) 'resource-exhausted)
        (is (equalp buffer before))))
    (dolist (args (list (list nil 0 size) (list buffer -1 size) (list buffer size 0)))
      (rejected (lambda () (apply #'c:scrivi-indice-full-text run descriptor scratch args)) 'invalid-argument))
    (is (= size (c:scrivi-indice-full-text run descriptor scratch buffer 0 size)))
    (is (= size (c:verifica-indice-full-text buffer 0 size descriptor scratch)))))

(deftest req-sec-010-codec-scratch-and-work
  (let ((buffer (golden)) (descriptor (descriptor)) (scratch (space)))
    (dolist (small (list (space :max-positions 1) (space :max-lengths 1) (space :max-term-bytes 1)))
      (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor small)) 'resource-exhausted))
    (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch :max-work 1))
              'resource-exhausted :fulltext-codec-work)
    (rejected (lambda () (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch :max-work 0))
              'invalid-argument :fulltext-codec-input)
    (is (= (length buffer) (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch)))
    (let ((query (at::small-space)))
      (let ((view (c:crea-vista-indice-full-text buffer 0 (length buffer) descriptor scratch)))
        (rejected (lambda () (matches view 0 1 query :all)) 'invalid-argument :fulltext-file-query-input)
        (at::analyzed "!!!" :space query)
        (rejected (lambda () (matches view 0 1 query :all)) 'invalid-argument :fulltext-file-query-input)
        (at::analyzed "alpha" :space query)
        (setf (a::spazio-full-text-work-limit query) (a::spazio-full-text-work query))
        (rejected (lambda () (matches view 0 1 query :all)) 'resource-exhausted :fulltext-analysis-work))))
  (rejected (lambda () (c:crea-spazio-codec-full-text :max-memory 1)) 'resource-exhausted :fulltext-codec-memory)
  (rejected (lambda () (c:crea-spazio-codec-full-text :max-positions 0)) 'invalid-argument :fulltext-codec-capacity))

(deftest req-sec-008-descriptor-owns-configuration
  (let* ((meta (meta)) (identity (ft::id-serie)) (rows (copy-seq #*11))
         (descriptor (descriptor :meta meta :identity identity :rows rows)) (buffer (golden)) (scratch (space)))
    (fill meta 0) (fill identity 0) (fill rows 0)
    (is (= (length buffer) (c:verifica-indice-full-text buffer 0 (length buffer) descriptor scratch)))))

(deftest req-sec-008-candidate-contract-before-write
  (let* ((run (sample-run)) (rows #*10) (descriptor (descriptor :rows rows :meta (meta :rows rows)))
         (scratch (space)) (buffer (make-array 1024 :element-type '(unsigned-byte 8) :initial-element 42)))
    (rejected (lambda () (c:scrivi-indice-full-text run descriptor scratch buffer 0 1024))
              'corruption-detected :fulltext-uncommitted-row)
    (is (every (lambda (b) (= b 42)) buffer))))

(deftest req-sec-010-codec-hot-allocation
  (dolist (maximum-id '(1 #xffffffffffffffff))
    (let* ((descriptor (descriptor :segment maximum-id :meta (meta :ids (list maximum-id maximum-id maximum-id))))
           (scratch (space)) (run (sample-run)) (query (at::small-space)))
      (multiple-value-bind (buffer start end) (encode run descriptor scratch)
        (let* ((frozen (copy-seq buffer)) (view (c:crea-vista-indice-full-text frozen start end descriptor scratch)))
          (dotimes (i 100)
            (c:scrivi-indice-full-text run descriptor scratch buffer start end)
            (c:verifica-indice-full-text buffer start end descriptor scratch)
            (at::analyzed "alpha beta" :space query) (is (matches view 0 1 query :phrase)))
          (at::analyzed "alpha beta" :space query)
          (sb-ext:gc :full t)
          (let ((before (sb-ext:get-bytes-consed)))
            (dotimes (i 1000)
              (c:scrivi-indice-full-text run descriptor scratch buffer start end)
              (c:verifica-indice-full-text buffer start end descriptor scratch)
              (is (matches view 0 1 query :phrase)))
            (let ((allocated (- (sb-ext:get-bytes-consed) before)))
              (format t "Codec/query, ID ~D: ~D byte consed per 1000 operazioni.~%" maximum-id allocated)
              (is (zerop allocated)))))))))
