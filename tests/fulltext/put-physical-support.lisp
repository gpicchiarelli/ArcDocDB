;;;; C4: backend deterministico e oracle interi/binary indipendenti, fuori dai percorsi misurati.
(in-package #:arcdocdb.fulltext.put.tests)
(defun reference-file ()
  (let ((file (uiop:symbol-call "ARCDOCDB.WAL.TESTS" "FIXTURE-FILE")))
    (arcdocdb.io:append-esatto file (make-array 64 :element-type '(unsigned-byte 8) :initial-element 0) 0 64)
    (arcdocdb.io:durable-flush file) file))
(defun reference-registry (&optional (base 0))
  (arcdocdb.csn:crea-registro-csn :capacity 4 :initial-high (ldb (byte 32 32) base) :initial-low (ldb (byte 32 0) base)))
(defmacro with-reference-context ((pool queue request batch registry log file) (&key (version 2) (base 0)) &body body)
  `(let* ((configs (a::configs)) (,queue (ex:crea-coda-writer :capacity 16)) (,pool (a::pool ,queue configs))
          (,request (request configs :version ,version)) (,batch (batch :version ,version))
          (,registry (reference-registry ,base)) (,file (reference-file)) (,log (w:crea-log-io ,file :segment 1 :version ,version)))
     (unwind-protect (progn ,@body) (arcdocdb.io:chiudi ,file))))
(defun append-reference (pool queue request batch row &key prepared (stamp 0))
  (let ((generation (p:inizia-put-full-text request (key) (dt::wire) row :prepared prepared
                                            :txid-high (ldb (byte 32 32) stamp) :txid-low (ldb (byte 32 0) stamp))))
    (prepare request generation 1)
    (let ((lease (ex:acquisisci-writer queue)))
      (unwind-protect
           (progn (reserve pool lease request generation 1) (p:aggiungi-put-full-text pool lease request generation batch))
        (ex:rilascia-writer queue lease)))))
(defmacro with-reference-writer ((lease queue) &body body)
  `(let ((,lease (ex:acquisisci-writer ,queue)))
     (unwind-protect (progn ,@body) (ex:rilascia-writer ,queue ,lease))))
(defun reference-image (slot)
  (list (f::riserva-full-text-physical-state slot) (f::riserva-full-text-physical-offset slot)
        (f::riserva-full-text-physical-version slot) (f::riserva-full-text-put-high slot) (f::riserva-full-text-put-low slot)))
(defun reference-values (pool lease slot token)
  (multiple-value-list (p:leggi-riferimento-put-full-text pool lease slot token)))
(defun reference-stamp (value) (+ (ash (seventh value) 32) (eighth value)))
(defun reference-capture (pool lease slot token registry log)
  (is (eq :sealed (p:cattura-riferimento-put-full-text pool lease slot token registry log)))
  (reference-values pool lease slot token))
(defun reference-retire (batch registry log)
  ;; C4: pubblicazione modellata della sola fixture, non un primary/delta di prodotto.
  (let ((group (w:crea-gruppo log)) (root (vector nil)))
    (w:aggiungi-lotto group batch) (w:chiudi-gruppo group) (w:esegui-gruppo group)
    (is (null (sb-ext:compare-and-swap (svref root 0) nil batch)))
    (multiple-value-bind (slot high low) (w:leggi-csn-lotto batch)
      (w:risolvi-lotto-pubblicato batch registry slot high low :strong))
    (w:riusa-gruppo group) (w:riusa-lotto batch)))
