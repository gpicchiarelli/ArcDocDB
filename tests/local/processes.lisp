;;;; Processi reali: solo CLI di prodotto per startup, recovery e richieste.
(defpackage #:arcdocdb.local.process.tests
  (:use #:cl)
  (:local-nicknames (#:l #:arcdocdb.local))
  (:export #:run))
(in-package #:arcdocdb.local.process.tests)

(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))

(defvar *run-active* nil)
(defvar *root*)
(defvar *children*)
(defvar *scenarios*)
(defvar *cleanup-errors*)
(defvar *retain-root*)
(defparameter *process-timeout* 60)
(defparameter *stop-timeout* 5)
(defparameter *log-byte-limit* 1048576)
(defparameter *fixture-parent* (merge-pathnames ".arcdocdb-p3-tests/" (user-homedir-pathname)))
(defparameter *archive-hex* "49494949494949494949494949494949")
(defparameter *series-hex* "29292929292929292929292929292929")
(defparameter *key-one* "00FF000102030405060708090A0B0C0D")
(defparameter *key-two* "FF00000102030405060708090A0B0C0D")
(defparameter *key-three* "8000000102030405060708090A0B0C0D")

(defstruct child
  name role arguments process pid stdout stderr started ended socket
  (status :not-started) code (outcome :pending) ready response stop-reason
  expected-failure)

(defun check (truth control &rest arguments)
  (unless truth (error (apply #'format nil control arguments)))
  t)

(defun lstat-if-present (path)
  (handler-case (sb-posix:lstat (namestring path))
    (sb-posix:syscall-error (condition)
      (if (= sb-posix:enoent (sb-posix:syscall-errno condition))
          nil
          (error condition)))))

(defun check-ancestors (directory)
  ;; LSTAT rifiuta i symlink; antenati root/service, senza scrittura di gruppo/altri.
  (let ((name (string-right-trim "/" (namestring (uiop:ensure-directory-pathname directory)))))
    (check (and (plusp (length name)) (char= #\/ (char name 0)))
           "Directory non assoluta: ~A" name)
    (flet ((check-node (node)
             (let ((stat (sb-posix:lstat node)))
               (check (and (sb-posix:s-isdir (sb-posix:stat-mode stat))
                           (member (sb-posix:stat-uid stat) (list 0 (sb-posix:getuid)))
                           (zerop (logand #o022 (sb-posix:stat-mode stat))))
                      "Antenato non sicuro: ~A" node))))
      (check-node "/")
      ;; Il componente finale viene verificato dopo MKDIR, non prima della creazione.
      (loop for end from 1 below (length name)
            when (char= #\/ (char name end)) do (check-node (subseq name 0 end)))))
  directory)

(defun check-private-directory (path)
  (let ((stat (sb-posix:lstat (string-right-trim "/" (namestring path)))))
    (check (and (sb-posix:s-isdir (sb-posix:stat-mode stat))
                (= (sb-posix:getuid) (sb-posix:stat-uid stat))
                (= #o700 (logand #o777 (sb-posix:stat-mode stat))))
           "Directory runtime non privata: ~A" path))
  path)

(defun private-directory (path &key existing)
  (check-ancestors path)
  (let ((name (string-right-trim "/" (namestring path))))
    (if (and existing (lstat-if-present (pathname name)))
        (check-private-directory path)
        (progn (sb-posix:mkdir name #o700) (check-private-directory path))))
  path)

(defun fresh-root ()
  (private-directory *fixture-parent* :existing t)
  (loop for serial below 64
        for path = (merge-pathnames
                    (format nil "~36R-~36R-~36R/" (get-universal-time)
                            (sb-posix:getpid) serial)
                    *fixture-parent*)
        do (handler-case (return (private-directory path))
             (sb-posix:syscall-error (condition)
               (unless (= sb-posix:eexist (sb-posix:syscall-errno condition))
                 (error condition))))
        finally (error "Impossibile riservare una fixture privata.")))

(defun subdirectory (name)
  (private-directory (merge-pathnames name *root*)))

(defun socket-path (runtime leaf)
  (let* ((path (merge-pathnames leaf runtime)) (name (namestring path)))
    ;; Tutti i componenti sono ASCII: byte e caratteri coincidono.
    (check (and (every (lambda (character) (< (char-code character) 128)) name)
                (< (length name) 100))
           "Socket deve essere piu' corto di 100 byte: ~A" name)
    path))

(defun elapsed (start &optional (end (get-internal-real-time)))
  (/ (- end start) (float internal-time-units-per-second 1d0)))

(defun deadline (seconds)
  (+ (get-internal-real-time) (* seconds internal-time-units-per-second)))

(defun running-p (child)
  (and (child-process child)
       (member (sb-ext:process-status (child-process child)) '(:running :stopped))))

(defun check-logs (child)
  (dolist (path (list (child-stdout child) (child-stderr child)))
    (with-open-file (stream path :element-type '(unsigned-byte 8))
      (check (<= (file-length stream) *log-byte-limit*)
             "Log oltre il limite, processo ~A: ~A" (child-name child) path))))

(defun launch (name role script arguments &key expected-failure)
  (check (< (length *children*) 256) "Limite processi della fixture superato.")
  (let* ((id (1+ (length *children*)))
         (prefix (format nil "~3,'0D-~A" id name))
         (stdout (merge-pathnames (format nil "~A.stdout" prefix) *root*))
         (stderr (merge-pathnames (format nil "~A.stderr" prefix) *root*))
         (argv (append (list "--noinform" "--no-userinit" "--no-sysinit" "--script"
                             (namestring (asdf:system-relative-pathname "arcdocdb" script)))
                       arguments))
         (child (make-child :name name :role role :arguments argv
                            :stdout stdout :stderr stderr
                            :started (get-internal-real-time)
                            :expected-failure expected-failure)))
    ;; Registrazione prima dello spawn: anche un avvio fallito conserva i log.
    (push child *children*)
    (dolist (path (list stdout stderr))
      (with-open-file (stream path :direction :output :if-exists :error)
        (declare (ignorable stream))))
    (setf (child-process child)
          (sb-ext:run-program (namestring sb-ext:*runtime-pathname*) argv
                              :wait nil :input nil :output stdout :error stderr
                              :if-output-exists :append :if-error-exists :append)
          (child-pid child) (sb-ext:process-pid (child-process child)))
    child))

(defun wait-exit (child &key (timeout *process-timeout*) absent-socket (logs t))
  (let ((limit (deadline timeout)))
    (loop
      (when logs (check-logs child))
      (when absent-socket
        (check (null (lstat-if-present absent-socket))
               "Listener pubblicato durante startup rifiutato: ~A" absent-socket))
      (unless (running-p child) (return child))
      (check (< (get-internal-real-time) limit)
             "Timeout processo ~A (PID ~A)." (child-name child) (child-pid child))
      ;; Solo backoff del polling: il tempo trascorso non certifica mai READY.
      (sleep 0.01))))

(defun close-child (child)
  (when (child-process child)
    (check (not (running-p child)) "Tentativo di chiudere un processo vivo.")
    (setf (child-status child) (sb-ext:process-status (child-process child))
          (child-code child) (sb-ext:process-exit-code (child-process child))
          (child-ended child) (get-internal-real-time))
    (sb-ext:process-close (child-process child))
    (setf (child-process child) nil)))

(defun first-form (text)
  (with-standard-io-syntax
    (let ((*read-eval* nil))
      (handler-case
          (multiple-value-bind (form end) (read-from-string text nil :no-form)
            (if (eq form :no-form) (values nil nil nil) (values form end t)))
        (end-of-file () (values nil nil nil))))))

(defun only-form (child)
  (check-logs child)
  (let ((text (uiop:read-file-string (child-stdout child))))
    (multiple-value-bind (form end present) (first-form text)
      (check present "Nessuna forma stdout completa: ~A" (child-name child))
      (with-standard-io-syntax
        (let ((*read-eval* nil))
          (check (eq :no-form (read-from-string text nil :no-form :start end))
                 "Stdout contiene forme extra: ~A" (child-name child))))
      form)))

(defun check-fields (form keys)
  (check (and (listp form) (= (* 2 (length keys)) (length form))
              (let ((actual (loop for tail on form by #'cddr collect (first tail))))
                (every (lambda (key) (= 1 (count key actual :test #'eq))) keys)))
         "Risposta CLI inattesa: ~S" form)
  form)

(defun start-server (data runtime version stage &key create (script "tools/local-server.lisp") expected-failure)
  (let* ((socket (socket-path runtime (format nil "v~D-~D.sock" version stage)))
         (name (format nil "v~D-server-~D" version stage)))
    (check (null (lstat-if-present socket)) "Socket non fresco: ~A" socket)
    (let ((child (launch name :server script
                         (append (list (namestring data) (namestring socket)
                                       *archive-hex* *series-hex*)
                                 (when create (list "--create"))
                                 (list "--version" (write-to-string version)))
                         :expected-failure expected-failure))
          (limit (deadline *process-timeout*)))
      (setf (child-socket child) socket)
      (loop
        (check-logs child)
        (multiple-value-bind (form end present)
            (first-form (uiop:read-file-string (child-stdout child)))
          (declare (ignore end))
          (when present
            (check (equal form (list :kind :local-server :state :ready :pid (child-pid child)))
                   "Prima forma stdout non READY: ~S" form)
            (check (running-p child) "Server terminato alla pubblicazione READY.")
            (let ((stat (lstat-if-present socket)))
              (check (and stat (sb-posix:s-issock (sb-posix:stat-mode stat))
                          (= (sb-posix:getuid) (sb-posix:stat-uid stat)))
                     "READY senza nodo socket: ~A" socket))
            (setf (child-ready child) form)
            (return)))
        (check (running-p child) "Server terminato prima di READY: ~A" name)
        (check (< (get-internal-real-time) limit) "Timeout READY: ~A" name)
        (sleep 0.01))
      (values child socket))))

(defun stop-server (child signal reason)
  (check (running-p child) "Server morto prima dello stop richiesto: ~A" (child-name child))
  (setf (child-stop-reason child) reason)
  (sb-ext:process-kill (child-process child) signal)
  (wait-exit child :timeout *stop-timeout*)
  (let ((status (sb-ext:process-status (child-process child)))
        (code (sb-ext:process-exit-code (child-process child))))
    (check (if (= signal sb-posix:sigkill)
               (and (eq status :signaled) (eql code sb-posix:sigkill))
               (and (eq status :exited) (eql code 0)))
           "Esito stop inatteso: ~A ~S ~S" (child-name child) status code))
  (when (= signal sb-posix:sigterm)
    (check (null (lstat-if-present (child-socket child))) "TERM non ha rimosso il proprio nodo."))
  (check (equal (child-ready child) (only-form child)) "Stdout READY alterato.")
  (setf (child-outcome child) :pass)
  (close-child child))

(defun decode-hex (text)
  (check (and (stringp text) (evenp (length text))) "Documento HEX non valido: ~S" text)
  (let ((bytes (make-array (/ (length text) 2) :element-type '(unsigned-byte 8))))
    (dotimes (index (length bytes) bytes)
      (let ((high (digit-char-p (char text (* 2 index)) 16))
            (low (digit-char-p (char text (1+ (* 2 index))) 16)))
        (check (and high low) "Documento HEX non valido: ~S" text)
        (setf (aref bytes index) (+ (* 16 high) low))))))

(defun client-request (socket operation &key key document csn expected-document)
  (let* ((child (launch (string-downcase (symbol-name operation)) :client "tools/local-client.lisp"
                        (append (list (namestring socket) (string-downcase (symbol-name operation)))
                                (when key (list key)) (when document (list document)))))
         (expected-found (not (null expected-document))))
    (wait-exit child)
    (check (and (eq :exited (sb-ext:process-status (child-process child)))
                (eql 0 (sb-ext:process-exit-code (child-process child))))
           "Client fallito: ~A" (child-name child))
    (let ((form (only-form child)))
      (check (and (listp form) (eq :local-client (getf form :kind))
                  (eq operation (getf form :operation))) "Risposta client inattesa: ~S" form)
      (case operation
        ((:put :delete)
         (check-fields form '(:kind :operation :csn))
         (check (eql csn (getf form :csn)) "CSN atteso ~D, risposta ~S" csn form))
        (:get
         (check-fields form '(:kind :operation :found :document))
         (check (eq expected-found (getf form :found)) "Presenza errata: ~S" form)
         (if expected-found
             (check (equalp (decode-hex expected-document) (decode-hex (getf form :document)))
                    "Byte documento diversi da ~A: ~S" expected-document form)
             (check (null (getf form :document)) "Documento restituito per chiave assente: ~S" form)))
        (:ping
         (check-fields form '(:kind :operation :result))
         (check (null (getf form :result)) "PING non nullo: ~S" form))
        (otherwise (error "Operazione di test sconosciuta.")))
      (setf (child-response child) form))
    (setf (child-outcome child) :pass)
    (close-child child)
    t))

(defun check-state-four (socket)
  (client-request socket :ping)
  (client-request socket :get :key *key-one* :expected-document "182B")
  (client-request socket :get :key *key-two*)
  (client-request socket :get :key *key-three*))

(defun check-state-six (socket)
  (client-request socket :ping)
  (client-request socket :get :key *key-one*)
  (client-request socket :get :key *key-two*)
  (client-request socket :get :key *key-three* :expected-document "4300FF80"))

(defun raw-peer (path)
  ;; Stessi buffer, encoder e primitive finite del prodotto; solo gli span cambiano.
  (let* ((client (l::make-local-client))
         (output (l::local-client-output client))
         (until (deadline 5))
         (primary nil))
    (unwind-protect
         (handler-case
             (progn
               (let ((fd (l::connect-local-socket (namestring path) until)))
                 (setf (l::local-client-socket client) fd)
                 (check (typep fd '(integer 0 *)) "Il peer raw richiede un FD intero."))
               (let ((size (l::encode-local-hello output 65536)))
                 (check (< 5 size) "HELLO troppo corto per la frammentazione.")
                 ;; Prefisso spezzato in tre invii, poi primo byte del corpo separato.
                 (loop for (start end) in (list '(0 1) '(1 3) '(3 4) '(4 5) (list 5 size))
                       do (l::transfer-local-client client output start end :output until)))
               (let ((envelope (l::receive-local-client client 4096 until)))
                 (multiple-value-bind (frame inflight)
                     (l::decode-local-welcome (l::local-client-input client) envelope)
                   (check (and (= frame 65536) (= inflight 1)) "WELCOME raw inatteso.")
                   (setf (l::local-client-limit client) frame)))
               (labels ((response (id limit)
                          (let ((envelope (l::receive-local-client client 65536 limit)))
                            (check (and (= 3 (l::envelope-kind envelope))
                                        (= id (l::envelope-id envelope)))
                                   "Correlazione raw errata, ID atteso ~D." id)
                            (check (null (l::decode-local-response (l::local-client-input client)
                                           envelope (l::local-client-space client) 0))
                                   "Risposta raw PING non nulla."))))
                 (let ((size (l::encode-local-request output 1 0 nil nil))
                       (limit (deadline 30)))
                   (l::transfer-local-client client output 0 1 :output limit)
                   (l::transfer-local-client client output 1 4 :output limit)
                   (l::transfer-local-client client output 4 size :output limit)
                   (response 1 limit))
                 ;; Due frame completi in un solo span; i residui restano nel kernel.
                 (let* ((second (l::encode-local-request output 2 0 nil nil))
                        (extra (l::local-buffer))
                        (third (l::encode-local-request extra 3 0 nil nil))
                        (end (+ second third))
                        (limit (deadline 30)))
                   (check (<= end (length output)) "Budget frame coalescenti superato.")
                   (replace output extra :start1 second :end1 end :end2 third)
                   (l::transfer-local-client client output 0 end :output limit)
                   (response 2 limit)
                   (response 3 limit))))
           (serious-condition (condition) (setf primary condition)))
      (handler-case (l:close-local client)
        (serious-condition (condition)
          (push condition *cleanup-errors*)
          (unless primary (setf primary condition)))))
    (when primary (error primary))
    t))

(defun node-identity (path)
  (let ((stat (sb-posix:lstat (namestring path))))
    (list (sb-posix:stat-dev stat) (sb-posix:stat-ino stat)
          (sb-posix:stat-mode stat) (sb-posix:stat-uid stat) (sb-posix:stat-nlink stat))))

(defun competing-peers (path)
  (let ((slow (l::make-local-client)) (wide nil) (small nil) (primary nil))
    (unwind-protect
         (handler-case
             (progn
               (setf (l::local-client-socket slow) (l::connect-local-socket (namestring path) (deadline 5)))
               ;; Un solo byte del prefisso: questo peer non deve bloccare gli altri.
               (l::transfer-local-client slow (l::local-client-output slow) 0 1 :output (deadline 5))
               (setf wide (l:connect-local (namestring path) :max-frame 131072))
               (check (= 65536 (l::local-client-limit wide)) "Offerta non ridotta al limite M1.")
               (l:client-ping wide)
               (setf small (l:connect-local (namestring path) :max-frame 4096))
               (let ((seen nil))
                 (handler-case (l:client-get small (decode-hex *key-one*))
                   (l::request-rejected (condition)
                     (check (= 5 (l::rejection-status condition)) "Rifiuto GET negoziato errato.")
                     (setf seen t)))
                 (check seen "GET con risposta massima non prenotabile e' stato ammesso."))
               (l:client-ping small))
           (serious-condition (condition) (setf primary condition)))
      (dolist (client (list slow wide small))
        (when client
          (handler-case (l:close-local client)
            (serious-condition (condition)
              (push condition *cleanup-errors*) (unless primary (setf primary condition)))))))
    (when primary (error primary))
    t))

(defun check-old-nodes (nodes)
  (dolist (entry nodes)
    (check (equal (cdr entry) (node-identity (car entry)))
           "Nodo di un avvio precedente alterato: ~A" (car entry))))

(defun recovery-scenario (data runtime version)
  (let ((old-nodes nil))
    (multiple-value-bind (server socket) (start-server data runtime version 1 :create t)
      (client-request socket :ping)
      ;; CBOR valido: 42, false, poi aggiornamento a 43; chiavi con 00/FF/80.
      (client-request socket :put :key *key-one* :document "182A" :csn 1)
      (client-request socket :get :key *key-one* :expected-document "182A")
      (client-request socket :put :key *key-two* :document "F4" :csn 2)
      (client-request socket :get :key *key-two* :expected-document "F4")
      (client-request socket :put :key *key-one* :document "182B" :csn 3)
      (client-request socket :delete :key *key-two* :csn 4)
      (check-state-four socket)
      (stop-server server sb-posix:sigkill :first-durable-workload)
      (push (cons socket (node-identity socket)) old-nodes))
    (multiple-value-bind (server socket) (start-server data runtime version 2)
      (check-old-nodes old-nodes)
      (check-state-four socket)
      (client-request socket :put :key *key-three* :document "4300FF80" :csn 5)
      (client-request socket :delete :key *key-one* :csn 6)
      (check-state-six socket)
      (stop-server server sb-posix:sigkill :second-durable-workload)
      (push (cons socket (node-identity socket)) old-nodes))
    (multiple-value-bind (server socket) (start-server data runtime version 3)
      (check-old-nodes old-nodes)
      (check-state-six socket)
      (scenario :fragmented-and-coalesced-raw-peer version (lambda () (raw-peer socket)))
      (scenario :slow-peer-and-negotiated-capacities version (lambda () (competing-peers socket)))
      (client-request socket :ping)
      ;; Il terzo processo riceve TERM dopo l'oracolo: solo due KILL per scenario.
      (stop-server server sb-posix:sigterm :verification-complete))
    (check-old-nodes old-nodes)))

(defun read-octets (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (check (= (length bytes) (read-sequence bytes stream)) "Lettura incompleta: ~A" path)
      bytes)))

(defun lost-ack-scenario (runtime version)
  (let ((data (subdirectory (format nil "data-v~D-lost-ack/" version))))
    (multiple-value-bind (server socket)
        (start-server data runtime version 4 :create t :script "tools/local-fault-server.lisp" :expected-failure t)
      (let ((client (launch "put-lost-ack" :client "tools/local-client.lisp"
                            (list (namestring socket) "put" *key-one* "182A") :expected-failure t)))
        (wait-exit client)
        (check (and (eq :exited (sb-ext:process-status (child-process client)))
                    (eql 1 (sb-ext:process-exit-code (child-process client)))) "Client senza esito ignoto.")
        (check (search "LOCAL-OUTCOME-UNKNOWN" (uiop:read-file-string (child-stderr client)))
               "Perdita ACK tradotta in esito certo.")
        (check (zerop (length (uiop:read-file-string (child-stdout client)))) "Falsa conferma PUT.")
        (setf (child-outcome client) :pass) (close-child client))
      (wait-exit server)
      (check (and (eq :exited (sb-ext:process-status (child-process server)))
                  (eql 1 (sb-ext:process-exit-code (child-process server)))) "FI server non rilevata.")
      (check (search "LOCAL-AFTER-COMMIT" (uiop:read-file-string (child-stderr server)))
             "Server terminato per una causa diversa dalla FI.")
      (check (equal (child-ready server) (only-form server)) "Stdout FI inatteso.")
      (setf (child-outcome server) :pass) (close-child server))
    (multiple-value-bind (server socket) (start-server data runtime version 5)
      (client-request socket :get :key *key-one* :expected-document "182A")
      (client-request socket :put :key *key-two* :document "F4" :csn 2)
      (stop-server server sb-posix:sigterm :lost-ack-recovered))))

(defun rejected-server (data socket version name &key no-node)
  (let ((child (launch name :server "tools/local-server.lisp"
                       (list (namestring data) (namestring socket) *archive-hex* *series-hex*
                             "--version" (write-to-string version))
                       :expected-failure t)))
    (wait-exit child :absent-socket (when no-node socket))
    (check (and (eq :exited (sb-ext:process-status (child-process child)))
                (let ((code (sb-ext:process-exit-code (child-process child))))
                  (and (integerp code) (plusp code))))
           "Startup negativo non rifiutato: ~A" name)
    (check (zerop (length (uiop:read-file-string (child-stdout child))))
           "Startup negativo ha pubblicato stdout/READY: ~A" name)
    (check (plusp (length (uiop:read-file-string (child-stderr child))))
           "Startup negativo senza diagnostica stderr: ~A" name)
    (when no-node (check (null (lstat-if-present socket)) "Listener residuo: ~A" socket))
    (setf (child-outcome child) :pass)
    (close-child child)))

(defun collision-scenario (data runtime version)
  (let* ((node (socket-path runtime (format nil "v~D-collision.sock" version)))
         (sentinel (make-array 5 :element-type '(unsigned-byte 8)
                                :initial-contents '(0 255 128 42 0))))
    (with-open-file (stream node :direction :output :if-exists :error
                                :element-type '(unsigned-byte 8))
      (write-sequence sentinel stream))
    (let ((identity (node-identity node)))
      (rejected-server data node version (format nil "v~D-collision" version))
      (check (equal identity (node-identity node)) "Nodo preesistente sostituito: ~A" node)
      (check (equalp sentinel (read-octets node)) "Nodo preesistente troncato: ~A" node))))

(defun corrupt-startup-scenario (data runtime version)
  ;; FI su storage creato e riaperto esclusivamente dal prodotto: nessun bootstrap test.
  (let* ((control (merge-pathnames "control.log" data))
         (original (read-octets control))
         (backup (merge-pathnames (format nil "v~D-control-before-fi.bin" version) *root*))
         (socket (socket-path runtime (format nil "v~D-not-ready.sock" version))))
    (check (plusp (length original)) "CONTROL vuoto prima della FI.")
    (with-open-file (stream backup :direction :output :if-exists :error
                                  :element-type '(unsigned-byte 8))
      (write-sequence original stream))
    (with-open-file (stream control :direction :io :if-exists :overwrite
                                   :element-type '(unsigned-byte 8))
      (write-byte (logxor #xFF (aref original 0)) stream))
    (let ((corrupted (read-octets control)))
      (rejected-server data socket version (format nil "v~D-engine-not-ready" version) :no-node t)
      (check (equalp corrupted (read-octets control)) "Startup ha alterato CONTROL corrotto."))))

(defun storage-images (data)
  (mapcar (lambda (path) (list (file-namestring path) (node-identity path) (read-octets path)))
          (sort (copy-list (uiop:directory-files data)) #'string< :key #'file-namestring)))

(defun invalid-stored-cbor-scenario (runtime version)
  (let* ((data (subdirectory (format nil "data-v~D-bad-cbor/" version)))
         (socket (socket-path runtime (format nil "v~D-bad-cbor.sock" version)))
         ;; Seed attraverso API di prodotto senza validatore del profilo locale.
         ;; FF isolato non e' un documento CBOR: il wrapper deve rifiutarlo in recovery.
         (engine (arcdocdb.engine:apri-motore data (decode-hex *archive-hex*) (decode-hex *series-hex*)
                                           :create t :version version :clock (lambda () 10))))
    (unwind-protect
         (check (= 1 (arcdocdb.engine:scrivi-documento engine (decode-hex *key-one*) (decode-hex "FF")))
                "CSN seed CBOR invalido inatteso.")
      (arcdocdb.engine:chiudi-motore engine))
    (let ((images (storage-images data)))
      (rejected-server data socket version (format nil "v~D-stored-cbor-not-ready" version) :no-node t)
      (check (equalp images (storage-images data))
             "Startup ha modificato storage con documento CBOR invalido."))))

(defun scenario (kind version function)
  (let ((start (get-internal-real-time)) (passed nil))
    (unwind-protect (progn (funcall function) (setf passed t))
      (push (list :kind kind :version version :outcome (if passed :pass :fail)
                  :duration-seconds (elapsed start))
            *scenarios*))))

(defun attempt-cleanup (function)
  (handler-case (funcall function)
    (serious-condition (condition) (push condition *cleanup-errors*))))

(defun finish-children ()
  (dolist (child *children*)
    (when (eq :pending (child-outcome child)) (setf (child-outcome child) :fail))
    (when (child-process child)
      (when (running-p child)
        (setf (child-stop-reason child) :failure-cleanup)
        (attempt-cleanup (lambda () (sb-ext:process-kill (child-process child) sb-posix:sigkill))))
      (attempt-cleanup (lambda () (wait-exit child :timeout *stop-timeout* :logs nil)))
      (attempt-cleanup (lambda () (close-child child)))
      (when (child-process child)
        (attempt-cleanup
         (lambda ()
           (setf (child-status child) (sb-ext:process-status (child-process child))
                 (child-code child) (sb-ext:process-exit-code (child-process child)))))))
    (unless (child-ended child) (setf (child-ended child) (get-internal-real-time)))))

(defun child-record (child)
  (list :kind :local-process :name (child-name child) :role (child-role child)
        :pid (child-pid child) :arguments (child-arguments child)
        :socket (when (child-socket child) (namestring (child-socket child)))
        :status (child-status child) :code (child-code child)
        :outcome (child-outcome child) :expected-failure (child-expected-failure child)
        :stop-reason (child-stop-reason child)
        :duration-seconds (elapsed (child-started child) (child-ended child))
        :stdout (namestring (child-stdout child)) :stderr (namestring (child-stderr child))
        :ready (child-ready child) :response (child-response child)))

(defun emit-summary (passed condition)
  (let ((records (mapcar #'child-record (reverse *children*))))
    (with-standard-io-syntax
      (write (list :kind :production-local-tests :status (if passed :passed :failed)
                   :tests (length *tests*) :root (namestring *root*) :retained (or *retain-root* (not passed))
                   :processes records :scenarios (reverse *scenarios*)
                   :sigkills (count-if (lambda (record)
                                        (and (eq :signaled (getf record :status))
                                             (eql sb-posix:sigkill (getf record :code)))) records)
                   :condition (when condition (princ-to-string condition))
                   :cleanup-errors (mapcar #'princ-to-string (reverse *cleanup-errors*))
                   :benchmark nil :power-loss-qualification nil)
             :readably t :pretty nil)
      (terpri)
      (finish-output))))

(defun call-with-run (function)
  (if *run-active*
      (funcall function)
      (let* ((*run-active* t) (*children* nil) (*scenarios* nil) (*cleanup-errors* nil)
             (*retain-root* (equal "1" (uiop:getenv "ARCDOCDB_LOCAL_TEST_KEEP")))
             (*root* (fresh-root)) (failure nil) (passed nil))
        (unwind-protect
             (handler-case
                 (progn
                   (funcall function)
                   (check (every (lambda (child) (eq :pass (child-outcome child))) *children*)
                          "Processi senza esito verificato.")
                   (setf passed t))
               (serious-condition (condition) (setf failure condition)))
          (finish-children)
          (when *cleanup-errors* (setf passed nil))
          ;; La radice contiene tutte le versioni e tutti i log; mai cleanup per scenario.
          (when (and passed (not *retain-root*))
            (attempt-cleanup (lambda () (uiop:delete-directory-tree *root* :validate t)))
            (when *cleanup-errors* (setf passed nil)))
          (attempt-cleanup (lambda () (emit-summary passed failure)))
          (when *cleanup-errors* (setf passed nil))
          (unless passed
            (format *error-output* "~&LOCAL-ROOT-RETAINED ~A~%" *root*)
            (finish-output *error-output*)))
        (when failure (error failure))
        (when *cleanup-errors* (error (first (last *cleanup-errors*))))
        (check passed "Esecuzione locale interrotta.")
        t)))

;;; REQ: REQ-REC-001 REQ-WAL-006 REQ-MVC-006 REQ-STO-003 REQ-AFF-018 REQ-VAL-001
(deftest test-REQ-REC-001-production-local-two-SIGKILL-restarts-and-startup-refusals-v1-v2
  ;; Un singolo caso catalogabile conserva anche v1 se un successivo scenario v2 fallisce.
  (call-with-run
   (lambda ()
     (let ((runtime (subdirectory "runtime/")))
       (dolist (version '(1 2))
         (let ((data (subdirectory (format nil "data-v~D/" version))))
           (scenario :two-sigkill-three-starts version
                     (lambda () (recovery-scenario data runtime version)))
           (scenario :existing-node-preserved version
                     (lambda () (collision-scenario data runtime version)))
           (scenario :engine-not-ready-no-listener version
                     (lambda () (corrupt-startup-scenario data runtime version)))
           (scenario :invalid-stored-cbor-no-listener version
                     (lambda () (invalid-stored-cbor-scenario runtime version)))
           (scenario :lost-ack-after-strong-commit version
                     (lambda () (lost-ack-scenario runtime version)))))
       (check (= 4 (count-if (lambda (child)
                              (and (eq :pass (child-outcome child))
                                   (eq :signaled (child-status child))
                                   (eql sb-posix:sigkill (child-code child)))) *children*))
              "Numero di SIGKILL verificati inatteso.")))))

(defun run ()
  (call-with-run
   (lambda ()
     (dolist (test (reverse *tests*))
       (funcall test)
       (format t "~&ok    ~A~%" test))))
  t)
