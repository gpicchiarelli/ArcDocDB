(deftest test-REQ-CBR-009-string-every-header-and-payload-truncation-at-authorized-end
  (dolist (contents (list (append '(#x58 24) (make-list 24 :initial-element #xff))
                          (append '(#x78 24) (make-list 24 :initial-element #x61))
                          '(#x64 #xf0 #x90 #x80 #x80)))
    (dolist (prefix '(0 7))
      (multiple-value-bind (buffer start end) (csr-fixture contents '(#xff) :prefix prefix)
        (dotimes (available (length contents))
          (csr-reject buffer start (+ start available) 'corruption-detected :cbor-truncated (+ start available)))
        (csr-accept buffer start end (if (= (first contents) #x58) 2 3)
                    (+ start (if (= (length contents) 5) 1 2)) (+ start (length contents)))))))

