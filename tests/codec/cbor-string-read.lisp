(in-package #:arcdocdb.cbor.string.read.tests)

;;; REQ: REQ-CBR-009 REQ-LIM-001 REQ-LIM-002 REQ-AFF-004
(deftest test-REQ-CBR-009-string-literal-empty-utf8-and-unread-tails
  (dolist (contents '((#x40) (#x44 0 #xff #x1c #x80))) (csr-probe contents 2 1))
  (dolist (contents '((#x60) (#x61 0) (#x61 #x7f) (#x62 #xc2 #x80) (#x62 #xdf #xbf)
                      (#x63 #xe0 #xa0 #x80) (#x63 #xed #x9f #xbf) (#x63 #xee #x80 #x80)
                      (#x64 #xf0 #x90 #x80 #x80) (#x64 #xf4 #x8f #xbf #xbf)
                      (#x63 #xef #xbf #xbe) (#x63 #xef #xbb #xbf)))
    (csr-probe contents 3 1)))

(deftest test-REQ-CBR-009-string-length-width-boundaries-and-payload-offset
  (dolist (major '(2 3))
    (dolist (length '(0 1 23 24 255 256 65535 65536))
      (let ((header (csr-argument major length)))
        (csr-probe (append header (make-list length :initial-element (if (= major 2) #xff #x61)))
                   major (length header))))))

(deftest test-REQ-CBR-009-string-raw-bytes-never-validated-as-utf8
  (csr-probe (append '(#x59 1 0) (loop for byte below 256 collect byte)) 2 3)
  (dolist (payload '((#x80) (#xc0 #xaf) (#xff) (#xf5 #x80 #x80 #x80)
                     (#xc2) (#xe0 #x80 #x80) (#xed #xa0 #x80) (#xf4 #x90 #x80 #x80)))
    (csr-probe (cons (+ #x40 (length payload)) payload) 2 1)))

(deftest test-REQ-CBR-009-string-concatenation-and-zero-length-payload-frontiers
  (multiple-value-bind (buffer start end)
      (csr-fixture '(#x40 #x61 #x41 #x42 #xff #x80 #x60 #x63 #xe2 #x82 #xac) '(#xff))
    (let ((cursor start))
      (dolist (entry '((2 1 1) (3 2 3) (2 4 6) (3 7 7) (3 8 11)))
        (csr-accept buffer cursor end (first entry) (+ start (second entry)) (+ start (third entry)))
        (setf cursor (+ start (third entry))))
      (is (= cursor (+ start 11)))
      (csr-reject buffer cursor end 'corruption-detected :cbor-nonminimal cursor))))

(deftest test-REQ-CBR-009-string-buffer-type-range-and-backing-array-preserved
  (let* ((backing (make-array 32 :element-type '(unsigned-byte 8) :initial-element #xa5))
         (before (copy-seq backing)))
    (dolist (buffer (list nil '(#x40) "abc" (make-array 4)
                         (make-array 8 :element-type '(unsigned-byte 8) :displaced-to backing)
                         (make-array '(2 2) :element-type '(unsigned-byte 8))
                         (make-array 8 :element-type '(unsigned-byte 8) :fill-pointer 4)
                         (make-array 8 :element-type '(unsigned-byte 8) :adjustable t)))
      (csr-reject buffer 0 0 'invalid-argument :cbor-range nil :max-bytes nil))
    (is (equalp before backing)))
  (dolist (range (list '(nil 1) '(-1 1) '(0 -1) '(2 1) '(0 99) '(1.0 2)
                      '(0 nil) (list 0 (1+ most-positive-fixnum))))
    (csr-reject (bytes #x40 0) (first range) (second range)
                'invalid-argument :cbor-range nil :max-bytes nil)))

(deftest test-REQ-CBR-009-string-byte-limit-domain-and-preflight-precedences
  (dolist (budget (list nil -1 16777217 1.0 'bad (1+ most-positive-fixnum)))
    (csr-reject (bytes #x1c) 0 1 'invalid-argument :cbor-byte-limit nil :max-bytes budget))
  (csr-reject (bytes #x1c) -1 1 'invalid-argument :cbor-range nil :max-bytes nil)
  (csr-reject (bytes #x1c) 0 1 'invalid-argument :cbor-byte-limit nil :max-bytes nil)
  (csr-reject (bytes #x1c) 0 1 'resource-exhausted :cbor-byte-budget nil :max-bytes 0)
  (csr-reject (bytes #x1c) 0 0 'invalid-argument :cbor-byte-limit nil :max-bytes nil))

(deftest test-REQ-CBR-009-string-budget-covers-whole-window-and-empty-span
  (multiple-value-bind (buffer start end) (csr-fixture '(#x40) '(#xff #x1c #x18 0))
    (csr-accept buffer start end 2 (1+ start) (1+ start) :max-bytes 5)
    (dolist (budget '(0 1 4))
      (csr-reject buffer start end 'resource-exhausted :cbor-byte-budget nil :max-bytes budget))
    (csr-accept buffer start (1+ start) 2 (1+ start) (1+ start) :max-bytes 1)
    (csr-reject buffer start start 'corruption-detected :cbor-truncated start :max-bytes 0)))

(deftest test-REQ-CBR-009-string-type-precedes-fit-for-every-other-major
  (dolist (prefix '(0 7))
    (dolist (contents '((0) (#x20) (#x80) (#xa0) (#xc0) (#xf4)
                        (#xf8 #x20) (#xf9 #x7e 1) (#xfa 0 0 0 1)
                        (#xfb #xff #xf8 0 0 0 0 0 1)))
      (multiple-value-bind (buffer start end) (csr-fixture contents '(#xff) :prefix prefix)
        (csr-reject buffer start end 'corruption-detected :cbor-string-type start)))
    (dolist (major '(0 1 4 5 6))
      (multiple-value-bind (buffer start end) (csr-fixture (csr-argument major 4294967296) nil :prefix prefix)
        (csr-reject buffer start end 'corruption-detected :cbor-string-type start)))))

(deftest test-REQ-CBR-009-string-header-syntax-and-minimality-precede-type
  (dolist (prefix '(0 7))
    (dotimes (major 8)
      (dolist (ai '(28 29 30))
        (multiple-value-bind (buffer start end) (csr-fixture (list (+ (* major 32) ai)) nil :prefix prefix)
          (csr-reject buffer start end 'corruption-detected :cbor-reserved start)))
      (multiple-value-bind (buffer start end) (csr-fixture (list (+ (* major 32) 31)) nil :prefix prefix)
        (csr-reject buffer start end 'corruption-detected
                    (if (member major '(0 1 6)) :cbor-indefinite :cbor-nonminimal) start)))
    (dolist (entry '(((#x18) :cbor-truncated 1) ((#x18 0) :cbor-nonminimal 0)
                     ((#x98 0) :cbor-nonminimal 0) ((#xd8 0) :cbor-nonminimal 0)
                     ((#xf8 0) :cbor-simple 1) ((#xfa 0 0 0 0) :cbor-nonminimal 0)))
      (multiple-value-bind (buffer start end) (csr-fixture (first entry) nil :prefix prefix)
        (csr-reject buffer start end 'corruption-detected (second entry) (+ start (third entry)))))))

