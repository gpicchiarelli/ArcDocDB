(deftest test-REQ-CBR-009-string-full-16MiB-window-payload-and-one-byte-over
  (let* ((start 3) (window 16777216) (end (+ start window))
         (buffer (make-array (+ end 4) :element-type '(unsigned-byte 8) :initial-element #xff)))
    (setf (aref buffer start) #x40)
    (csr-accept buffer start end 2 (1+ start) (1+ start))
    (csr-reject buffer start end 'resource-exhausted :cbor-byte-budget nil :max-bytes (1- window))
    (csr-reject buffer start (1+ end) 'resource-exhausted :cbor-byte-budget nil)
    (csr-reject buffer start end 'invalid-argument :cbor-byte-limit nil :max-bytes (1+ window))
    (dolist (major '(2 3))
      (fill buffer (if (= major 2) #xff #x61) :start (+ start 5) :end end)
      (replace buffer (if (= major 2) '(#x5a 0 #xff #xff #xfb) '(#x7a 0 #xff #xff #xfb)) :start1 start)
      (csr-accept buffer start end major (+ start 5) end))))

(deftest test-REQ-CBR-009-string-fixed-seed-1024-fuzz-and-frozen-classes
  (let ((state #x53545239) (counts (make-array 9 :initial-element 0))
        (catalogue '(((#x40) 2 1) ((#x60) 3 1) ((#x42 #xff #x80) 2 1)
                     ((#x61 #x41) 3 1) ((#x62 #xc2 #x80) 3 1) ((#x63 #xe2 #x82 #xac) 3 1)
                     ((#x64 #xf4 #x8f #xbf #xbf) 3 1) ((#x43 0 #xff #x1c) 2 1))))
    (dotimes (iteration 1024)
      (setf state (logand #xffffffff (+ (* state 1664525) 1013904223)))
      (let ((category (mod iteration 16)))
        (if (< category 8)
            (let ((entry (nth (mod (ash state -8) 8) catalogue)))
              (multiple-value-bind (buffer start end)
                  (csr-fixture (first entry) '(#xff #x1c #x18 0) :prefix (mod state 16))
                (csr-accept buffer start end (second entry) (+ start (third entry)) (+ start (length (first entry)))))
              (incf (aref counts 0)))
            (multiple-value-bind (buffer start end) (csr-fixture '(#x40 #xff) nil :prefix (mod state 16))
              (case category
                (8 (csr-reject buffer start end 'resource-exhausted :cbor-byte-budget nil :max-bytes 1))
                (9 (setf (aref buffer start) 0)
                   (csr-reject buffer start end 'corruption-detected :cbor-string-type start))
                (10 (setf (aref buffer start) #x58 (aref buffer (1+ start)) 0)
                    (csr-reject buffer start end 'corruption-detected :cbor-nonminimal start))
                (11 (setf (aref buffer start) #x42)
                    (csr-reject buffer start end 'corruption-detected :cbor-truncated end))
                (12 (setf (aref buffer start) #x61)
                    (csr-reject buffer start end 'corruption-detected :utf8-leading (1+ start)))
                (13 (csr-reject buffer -1 end 'invalid-argument :cbor-range nil))
                (14 (csr-reject buffer start end 'invalid-argument :cbor-byte-limit nil :max-bytes nil))
                (15 (csr-reject buffer start start 'corruption-detected :cbor-truncated start)))
              (incf (aref counts (- category 7)))))))
    (is (equalp counts #(512 64 64 64 64 64 64 64 64))) (is (= state #xf8417639))
    (format t "  CBOR string read fuzz: seed53545239, 1024 casi, 512 successi e 64 ciascuno byte/type/nonminimal/truncated/utf8/range/byte-limit/empty.~%")))
