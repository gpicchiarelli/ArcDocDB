(in-package #:arcdocdb.cbor.map.write.tests)

;;; REQ: REQ-CBR-006 REQ-CON-005 REQ-LIM-001 REQ-LIM-002
(deftest test-REQ-CBR-006-map-two-reused-workers-private-scratch-and-readonly-inputs
  (multiple-value-bind (source ss se table count)
      (cmw-fixture '((#x61 #x61) (1) (#x61 #x62) (#x82 #xf4 #xf5)))
    (let* ((rounds 2048) (source-before (copy-seq source)) (table-before (copy-seq table))
           (buffers (make-array 2)) (spaces (make-array 2)) (expected (make-array 2))
           (begins #(3 7)) (limits #(12 16)) (tokens #(26698 37860))
           (ready (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
           (go (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
           (done (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
           (starts (make-array '(2 2) :initial-element 0))
           (firsts (make-array '(2 2) :initial-element 0))
           (finishes (make-array '(2 2) :initial-element 0))
           (sinks (make-array '(2 2) :initial-element 0)) (threads nil))
      (is (= (* 2 2 rounds) 8192))
      (dotimes (index 2)
        (multiple-value-bind (buffer start end)
            (cmw-destination 9 :prefix (svref begins index))
          (let ((cold (copy-seq buffer)))
            (replace cold '(#xa2 #x61 #x61 1 #x61 #x62 #x82 #xf4 #xf5) :start1 start)
            (is (= end (svref limits index)))
            (is (= (cmw-token cold end) (svref tokens index)))
            (is (= (* rounds (svref tokens index)) (if (zerop index) 54677504 77537280)))
            (setf (svref buffers index) buffer (svref expected index) cold
                  (svref spaces index) (cmw-dirty-space)))))
      (is (not (eq (svref buffers 0) (svref buffers 1))))
      (is (not (eq (svref spaces 0) (svref spaces 1))))
      (is (not (eq (arcdocdb.cbor::spazio-cbor-kinds (svref spaces 0))
                   (arcdocdb.cbor::spazio-cbor-kinds (svref spaces 1)))))
      (is (not (eq (arcdocdb.cbor::spazio-cbor-remaining (svref spaces 0))
                   (arcdocdb.cbor::spazio-cbor-remaining (svref spaces 1)))))
      (unwind-protect
           (progn
             (dotimes (i 2)
               (let ((index i))
                 (push (sb-thread:make-thread
                        (lambda ()
                          (cmw-worker index (svref buffers index) (svref begins index)
                                      (svref limits index) source ss se table count
                                      (svref spaces index) (svref expected index)
                                      (svref limits index) (svref tokens index)
                                      source-before table-before rounds ready go done starts firsts finishes sinks))
                        :name "CBOR map readonly-input private-destination private-scratch worker") threads)))
             (dotimes (wave 2)
               ;; READY attesta il primo item controllato di entrambi prima del lavoro restante.
               (dotimes (i 2) (cs-wait (svref ready wave)))
               (sb-thread:signal-semaphore (svref go wave) 2)
               (dotimes (i 2) (cs-wait (svref done wave)))
                 (let ((overlap (- (min (aref finishes 0 wave) (aref finishes 1 wave))
                                 (max (aref starts 0 wave) (aref starts 1 wave)))))
                 ;; Clock e sink reali conservati anche se un guard temporale successivo fallisce.
                 (format t "  CBOR map: onda ~D, 2 worker riusati, ~D composizioni; WALL fixture con rendezvous/controlli: worker 0 start/first/end ~D/~D/~D, sink ~D; worker 1 start/first/end ~D/~D/~D, sink ~D; overlap ~D tick (~D tick/s); nessuna inferenza su tempo puro encoder, CPU o scaling.~%"
                         wave (* 2 rounds)
                         (aref starts 0 wave) (aref firsts 0 wave) (aref finishes 0 wave) (aref sinks 0 wave)
                         (aref starts 1 wave) (aref firsts 1 wave) (aref finishes 1 wave) (aref sinks 1 wave)
                         overlap internal-time-units-per-second)
                 (force-output)
                 (dotimes (index 2)
                   (is (= (aref sinks index wave) (if (zerop index) 54677504 77537280)))
                   (is (> (aref finishes index wave) (aref starts index wave)))
                   (is (<= (aref starts index wave) (aref firsts index wave) (aref finishes index wave))))
                 (is (<= (max (aref firsts 0 wave) (aref firsts 1 wave))
                         (min (aref finishes 0 wave) (aref finishes 1 wave))))
                 (is (plusp overlap))))
             (dolist (thread threads) (cs-join thread))
             (is (equalp source source-before)) (is (equalp table table-before))
             (dotimes (index 2) (is (equalp (svref buffers index) (svref expected index)))))
        (dotimes (wave 2) (sb-thread:signal-semaphore (svref go wave) 2))
        (cs-stop-workers threads)))))
