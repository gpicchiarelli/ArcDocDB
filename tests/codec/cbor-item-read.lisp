(deftest test-REQ-CBR-008-item-full-16MiB-window-tail-and-complete-payload-boundary
  (let* ((start 2) (window 16777216) (end (+ start window))
         (buffer (make-array (+ end 4) :element-type '(unsigned-byte 8) :initial-element #x1c)))
    (setf (aref buffer start) 0)
    (cir-accept buffer start end (cir-dirty-space) 1 0 (1+ start))
    (cir-cold-reject buffer start end (cir-dirty-space) 'resource-exhausted :cbor-byte-budget nil
                     :max-bytes (1- window))
    (cir-cold-reject buffer start (1+ end) (cir-dirty-space) 'resource-exhausted :cbor-byte-budget nil)
    (replace buffer '(#x5a 0 #xff #xff #xfb) :start1 start)
    (cir-accept buffer start end (cir-dirty-space) 1 0 end :max-nodes 1 :max-depth 0)))

(deftest test-REQ-CBR-008-item-fixed-seed-1024-fuzz-and-frozen-class-counts
  (let ((state #x49544538) (counts (make-array 9 :initial-element 0))
        (catalogue '(((0) 1 0) ((#x38 #x18) 1 0) ((#x61 #x41) 1 0) ((#xf9 #x7e 1) 1 0)
                     ((#xc0 #xf6) 2 0) ((#x80) 1 1) ((#xa1 0 1) 3 1) ((#x63 #xe2 #x82 #xac) 1 0))))
    (dotimes (iteration 1024)
      (setf state (logand #xffffffff (+ (* state 1664525) 1013904223)))
      (let ((category (mod iteration 16)))
        (if (< category 8)
            (let ((entry (nth (mod (ash state -8) 8) catalogue)))
              (multiple-value-bind (buffer start end)
                  (cir-fixture (first entry) '(#xff #x1c #x18 0) :prefix (mod state 16))
                (cir-accept buffer start end (cir-dirty-space) (second entry) (third entry)
                            (+ start (length (first entry))))
                (incf (aref counts 0))))
            (multiple-value-bind (buffer start end) (cir-fixture '(0) '(#xff #x1c #x18) :prefix (mod state 16))
              (let ((space (cir-dirty-space)))
                (case category
                  (8 (cir-cold-reject buffer start end space 'resource-exhausted :cbor-byte-budget nil :max-bytes 3))
                  (9 (setf (aref buffer start) #x81 (aref buffer (1+ start)) 0)
                     (cir-reject buffer start end space 'resource-exhausted :cbor-node-budget (1+ start) :max-nodes 1))
                  (10 (setf (aref buffer start) #x80)
                      (cir-reject buffer start end space 'resource-exhausted :cbor-depth-budget start :max-depth 0))
                  (11 (setf (aref buffer start) #x18 (aref buffer (1+ start)) 0)
                      (cir-reject buffer start end space 'corruption-detected :cbor-nonminimal start))
                  (12 (cir-cold-reject buffer -1 end space 'invalid-argument :cbor-range nil))
                  (13 (cir-reject buffer start end nil 'invalid-argument :cbor-workspace nil))
                  (14 (cir-cold-reject buffer start end space 'invalid-argument :cbor-byte-limit nil :max-bytes nil))
                  (15 (cir-reject buffer start start space 'corruption-detected :cbor-truncated start)))
                (incf (aref counts (- category 7))))))))
    (is (equalp counts #(512 64 64 64 64 64 64 64 64)))
    (is (= state #x6cb25938))
    (format t "  CBOR item fuzz: seed49544538, 1024 casi, 512 successi e 64 ciascuno byte/nodi/depth/nonminimal/range/workspace/byte-limit/truncated.~%")))
