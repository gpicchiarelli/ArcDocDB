      (cir-accept buffer start end (cir-dirty-space) 1 0 (+ start 2))
      (cir-accept buffer start (+ start 2) (cir-dirty-space) 1 0 (+ start 2))
      (cir-reject buffer start (1+ start) (cir-dirty-space) 'corruption-detected :cbor-truncated (1+ start))
      (cir-reject buffer start start (cir-dirty-space) 'corruption-detected :cbor-truncated start))))

(deftest test-REQ-CBR-008-item-buffer-type-range-and-whole-backing-array-preservation
  (let* ((backing (make-array 32 :element-type '(unsigned-byte 8) :initial-element #xa5))
         (before (copy-seq backing)))
    (dolist (buffer (list nil '(0) "abc" (make-array 4)
                         (make-array 8 :element-type '(unsigned-byte 8) :displaced-to backing)
                         (make-array '(2 2) :element-type '(unsigned-byte 8))
                         (make-array 8 :element-type '(unsigned-byte 8) :fill-pointer 4)
                         (make-array 8 :element-type '(unsigned-byte 8) :adjustable t)))
      (cir-cold-reject buffer 0 0 (cir-dirty-space) 'invalid-argument :cbor-range nil))
    (is (equalp before backing)))
  (dolist (range (list '(nil 1) '(-1 1) '(0 -1) '(2 1) '(0 99) '(1.0 2)
                      '(0 nil) (list 0 (1+ most-positive-fixnum))))
    (cir-cold-reject (bytes 0 0) (first range) (second range) (cir-dirty-space)
                     'invalid-argument :cbor-range nil :max-bytes nil)))

