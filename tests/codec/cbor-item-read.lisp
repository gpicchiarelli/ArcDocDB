(deftest test-REQ-CBR-008-item-concatenated-frontiers-and-exact-scanners-still-trailing
  (multiple-value-bind (buffer start end)
      (cir-fixture '(0 #x38 #x18 #x61 #x41 #xc0 #x81 #xa0 #xa1 0 1 #xf9 #x3c 0) '(#xff))
    (let ((cursor start) (space (cir-dirty-space)))
      (dolist (entry '((1 0 1) (1 0 3) (1 0 5) (3 2 8) (3 1 11) (1 0 14)))
        (let ((next (+ start (third entry))))
          (cir-accept buffer cursor end space (first entry) (second entry) next)
          (setf cursor next)))
      (is (= (+ start 14) cursor))
      (cir-reject buffer cursor end space 'corruption-detected :cbor-nonminimal cursor))
    (dolist (minimal '(nil t))
      (let ((observed nil))
        (handler-case
            (if minimal (arcdocdb.cbor:verifica-struttura-cbor-minima buffer start end (cir-dirty-space))
                (arcdocdb.cbor:verifica-struttura-cbor buffer start end (cir-dirty-space)))
          (arcdocdb-error (condition) (setf observed condition)))
        (is (typep observed 'corruption-detected)) (is (eq :cbor-trailing (error-reason observed)))
        (is (= (1+ start) (error-offset observed)))))))

(deftest test-REQ-CBR-008-item-authorized-end-physical-sentinels-and-nonzero-start
