(deftest test-REQ-CBR-008-item-configured-limits-and-all-preflight-precedences
  (dolist (entry '((:max-bytes :cbor-byte-limit nil -1 16777217 1.0 bad)
                   (:max-nodes :cbor-node-limit nil 0 -1 16777217 1.0 bad)
                   (:max-depth :cbor-depth-limit nil -1 101 1.0 bad)))
    (dolist (value (cddr entry))
      (cir-cold-reject (bytes 0) 0 1 (cir-dirty-space) 'invalid-argument (second entry) nil (first entry) value)))
  (cir-reject (bytes 0) -1 1 nil 'invalid-argument :cbor-range nil :max-bytes nil)
  (cir-reject (bytes 0) 0 1 nil 'invalid-argument :cbor-workspace nil :max-bytes nil)
  (cir-cold-reject (bytes #x1c) 0 1 (cir-dirty-space) 'invalid-argument :cbor-byte-limit nil
                   :max-bytes nil :max-nodes nil :max-depth nil)
  (cir-cold-reject (bytes #x1c) 0 1 (cir-dirty-space) 'invalid-argument :cbor-node-limit nil
                   :max-nodes nil :max-depth nil)
  (cir-cold-reject (bytes #x1c) 0 1 (cir-dirty-space) 'invalid-argument :cbor-depth-limit nil :max-depth nil)
  (cir-cold-reject (bytes #x1c) 0 1 (cir-dirty-space) 'resource-exhausted :cbor-byte-budget nil :max-bytes 0))

