(deftest test-REQ-CBR-008-item-root-and-tag-chain-node-budget-without-tail-nodes
  (dolist (entry '(((0) 1 0) ((#xc0 0) 2 0) ((#x81 0) 2 1) ((#xa1 0 1) 3 1)))
    (multiple-value-bind (buffer start end) (cir-fixture (first entry) '(#xc0 #x1c #xff))
      (cir-accept buffer start end (cir-dirty-space) (second entry) (third entry)
                  (+ start (length (first entry))) :max-nodes (second entry))
      (when (> (second entry) 1)
        (cir-reject buffer start end (cir-dirty-space) 'resource-exhausted :cbor-node-budget
                    (+ start (1- (second entry))) :max-nodes (1- (second entry))))))
  (multiple-value-bind (buffer start end)
      (cir-fixture (append (make-list 1024 :initial-element #xc0) '(0)) '(#xff #x1c))
    (cir-accept buffer start end (cir-dirty-space) 1025 0 (+ start 1025) :max-nodes 1025 :max-depth 0)
    (cir-reject buffer start end (cir-dirty-space) 'resource-exhausted :cbor-node-budget (+ start 1024)
                :max-nodes 1024 :max-depth 0)))

(deftest test-REQ-CBR-008-item-depth-zero-and-100-101-without-tail-depth
  (cir-probe '(0) 1 0 :max-depth 0)
  (cir-probe '(#xc0 #xc1 0) 3 0 :max-depth 0)
  (dolist (lead '(#x80 #xa0))
    (cir-reject (bytes lead #xff) 0 2 (cir-dirty-space) 'resource-exhausted :cbor-depth-budget 0 :max-depth 0))
  (dolist (depth '(100 101))
    (multiple-value-bind (buffer start end)
        (cir-fixture (append (make-list depth :initial-element #x81) '(0)) '(#xff))
      (if (= depth 100)
          (cir-accept buffer start end (cir-dirty-space) 101 100 (+ start 101) :max-depth 100 :max-nodes 101)
          (cir-reject buffer start end (cir-dirty-space) 'resource-exhausted :cbor-depth-budget (+ start 100)
                      :max-depth 100)))))

