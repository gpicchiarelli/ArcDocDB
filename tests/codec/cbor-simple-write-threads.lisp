(in-package #:arcdocdb.cbor.simple.write.tests)

;;; REQ: REQ-CBR-003 REQ-AFF-004 REQ-AFF-008
(deftest test-REQ-CBR-003-simple-write-two-reused-workers-immutable-plans
  (let* ((rounds 8192) (buffers (make-array 2)) (befores (make-array 2))
         (plans (make-array 2)) (plans-before (make-array 2))
         (ready (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
         (go (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
         (done (vector (sb-thread:make-semaphore) (sb-thread:make-semaphore)))
         (starts (make-array '(2 2) :initial-element 0))
         (firsts (make-array '(2 2) :initial-element 0))
         (ends (make-array '(2 2) :initial-element 0))
         (sinks (make-array '(2 2) :initial-element 0)) (threads nil))
    (is (= (* 2 2 rounds) 32768))
    (dotimes (index 2)
      (multiple-value-bind (buffer start end)
          (csw-destination 8 :prefix (+ 3 (* index 4)) :suffix 251)
        (let* ((before (copy-seq buffer))
               (codes (if (zerop index) '(0 19 20 21 22 23 32 255) '(255 32 23 22 21 20 19 0)))
               (plan (csw-plan start end before codes)))
          (is (= (length plan) 8)) (is (zerop (mod rounds (length plan))))
          (is (= (* 1024 (reduce #'+ plan :key #'fifth))
                 (if (zerop index) 3804160 3836928)))
          (setf (svref buffers index) buffer (svref befores index) before
                (svref plans index) plan (svref plans-before index) (csw-copy-plan plan)))))
    (is (not (eq (svref buffers 0) (svref buffers 1))))
    (unwind-protect
         (progn
           (dotimes (i 2)
             (let ((index i))
               (push (sb-thread:make-thread
                      (lambda ()
                        (csw-worker index (svref buffers index) (svref befores index)
                                    (svref plans index) rounds ready go done starts firsts ends sinks))
                      :name "CBOR simple write immutable-plan private-destination worker") threads)))
           (dotimes (wave 2)
             ;; READY attesta il primo item controllato di entrambi prima del lavoro restante.
             (dotimes (i 2) (cbor-wait (svref ready wave)))
             (sb-thread:signal-semaphore (svref go wave) 2)
             (dotimes (i 2) (cbor-wait (svref done wave)))
             (let ((overlap (- (min (aref ends 0 wave) (aref ends 1 wave))
                               (max (aref starts 0 wave) (aref starts 1 wave)))))
               ;; Clock e sink reali conservati anche se un guard temporale successivo fallisce.
               (format t "  CBOR simple write: onda ~D, 2 worker riusati, ~D item; WALL fixture con rendezvous/controlli: worker 0 start/first/end ~D/~D/~D, sink ~D; worker 1 start/first/end ~D/~D/~D, sink ~D; overlap ~D tick (~D tick/s); nessuna inferenza su tempo puro encoder, CPU o scaling.~%"
                       wave (* 2 rounds)
                       (aref starts 0 wave) (aref firsts 0 wave) (aref ends 0 wave) (aref sinks 0 wave)
                       (aref starts 1 wave) (aref firsts 1 wave) (aref ends 1 wave) (aref sinks 1 wave)
                       overlap internal-time-units-per-second)
               (force-output)
               (dotimes (index 2)
                 (is (= (aref sinks index wave) (if (zerop index) 3804160 3836928)))
                 (is (> (aref ends index wave) (aref starts index wave)))
                 (is (<= (aref starts index wave) (aref firsts index wave) (aref ends index wave))))
               (is (<= (max (aref firsts 0 wave) (aref firsts 1 wave))
                       (min (aref ends 0 wave) (aref ends 1 wave))))
               (is (plusp overlap))))
           (dolist (thread threads) (cbor-join thread))
           (dotimes (index 2)
             (is (equalp (svref plans index) (svref plans-before index)))
             (let ((last (sixth (car (last (svref plans index))))))
               (is (equalp (svref buffers index) last))
               (let* ((size (length (svref befores index)))
                      (expected-before (make-array size :element-type '(unsigned-byte 8))))
                 (dotimes (i size) (setf (aref expected-before i) (mod (+ #xa7 (* i 37)) 256)))
                 (is (equalp (svref befores index) expected-before))))))
      (dotimes (wave 2) (sb-thread:signal-semaphore (svref go wave) 2))
      (cbor-stop-workers threads))))
