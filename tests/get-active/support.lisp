;;;; Fixture autonoma GET ACTIVE: file reale, controller e WAL pubblici.
;;; OWNER: namespace, lease, lotti e contesti esclusivi del singolo test.
;;; SHARED: radici/pagine immutabili e FD readonly conservati fino al cleanup GET.
(defpackage #:arcdocdb.get.active.tests
  (:use #:cl)
  (:local-nicknames (#:r #:arcdocdb.get.resolver) (#:g #:arcdocdb.get)
                    (#:io #:arcdocdb.io) (#:e #:arcdocdb.epochs)
                    (#:m #:arcdocdb.mvcc) (#:p #:arcdocdb.index.primary)
                    (#:c #:arcdocdb.cache) (#:w #:arcdocdb.wal) (#:s #:arcdocdb.series))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:import-from #:arcdocdb.conditions #:invalid-argument #:resource-exhausted
                #:invariant-violation #:corruption-detected #:snapshot-too-old
                #:io-fault #:error-reason)
  (:export #:run #:*get-active-tests*))
(in-package #:arcdocdb.get.active.tests)
(declaim (optimize (safety 3) (speed 2) (debug 3)))

(defvar *get-active-tests* nil)
(defmacro deftest (name &body body)
  `(progn
     (defun ,name () ,@body)
     (setf *get-active-tests*
           (acons ',name #',name (remove ',name *get-active-tests* :key #'car)))))
(defun run ()
  (dolist (test (reverse *get-active-tests*))
    (funcall (cdr test))
    (format t "ok    ~A~%" (car test)))
  (format t "~D test GET ACTIVE superati.~%" (length *get-active-tests*))
  t)

(defconstant +active-output-start+ 3)
(defconstant +active-sentinel+ #xcc)
(define-condition active-fixture-error (error)
  ((reason :initarg :reason :reader active-fixture-error-reason))
  (:report (lambda (condition stream)
             (format stream "Fixture GET ACTIVE: ~A." (active-fixture-error-reason condition)))))

;;; Encoding copiato e rinominato da tests/get-resolver/support.lisp,
;;; a sua volta attribuito a tests/get-directory/support.lisp. CRC bitwise,
;;; layout letterale e piano offset non chiamano encoder/verificatori prodotto.
(defun active-octets (count &optional (initial 0))
  (make-array count :element-type '(unsigned-byte 8) :initial-element initial))
(defun active-write-le (buffer start width number)
  (dotimes (i width buffer)
    (setf (aref buffer (+ start i)) (ldb (byte 8 (* 8 i)) number))))
(defun active-reference-crc (buffer start end &optional (seed 0))
  (let ((crc (logxor seed #xffffffff)))
    (loop for i from start below end do
      (setf crc (logxor crc (aref buffer i)))
      (dotimes (bit 8)
        (setf crc (logxor (ash crc -1) (if (oddp crc) #x82f63b78 0)))))
    (logxor crc #xffffffff)))
(defun active-reference-record (kind flags stamp key value)
  "Chiavi <=255: cornice 24+K+V, identica nei due formati della fixture."
  (let* ((end (+ 24 (length key) (length value))) (record (active-octets end)))
    (setf (aref record 8) kind (aref record 9) flags)
    (active-write-le record 10 2 (length key))
    (active-write-le record 12 4 (length value))
    (active-write-le record 16 8 stamp)
    (replace record key :start1 24)
    (replace record value :start1 (+ 24 (length key)))
    (active-write-le record 4 4 (active-reference-crc record 24 end))
    (active-write-le record 0 4 (active-reference-crc record 4 24))
    record))
(defun active-reference-seal (records start durable csn)
  (let ((body (active-octets 32)) (checksum 0))
    (dolist (record records)
      (setf checksum (active-reference-crc record 0 4 checksum)))
    (active-write-le body 0 8 17)
    (active-write-le body 8 8 start)
    (active-write-le body 16 8 durable)
    (active-write-le body 24 4 (length records))
    (active-write-le body 28 4 checksum)
    (active-reference-record 3 0 csn (active-octets 0) body)))
(defun active-key (ordinal)
  (let ((key (active-octets 16)))
    (replace key #(0 255 17 34 51 68 85 102 119 136 153 170 187 204 221 238))
    (active-write-le key 0 4 ordinal)
    key))
(defun active-value (ordinal &optional (size 16))
  (let ((value (active-octets size)))
    (dotimes (i size value)
      (setf (aref value i) (mod (+ 29 (* 31 ordinal) (* 73 i)) 256)))))
(defun active-reference-header (version identity)
  (let ((header (active-octets 64)))
    (replace header #(65 82 67 68 83 69 71 49))
    (active-write-le header 8 2 version)
    (setf (aref header 10) 1)
    (replace header identity :start1 16)
    (active-write-le header 32 8 17)
    (active-write-le header 40 8 123456)
    (active-write-le header 56 4 (active-reference-crc header 0 56))
    header))

(defstruct (active-observer (:constructor make-active-observer ())) reads writes flushes identities read-hook)
(defun active-observed-backend (observer)
  (io:make-backend
   #'io::native-open
   (lambda (fd buffer start count offset)
     (push (list fd offset count) (active-observer-reads observer))
     (when (active-observer-read-hook observer)
       (funcall (active-observer-read-hook observer) fd buffer start count offset))
     (io::native-read fd buffer start count offset))
   (lambda (fd buffer start count)
     (push (list fd count) (active-observer-writes observer))
     (io::native-write fd buffer start count))
   (lambda (fd)
     (push fd (active-observer-flushes observer))
     (io::native-flush fd))
   #'io::native-directory-flush #'io::native-close
   :identity (lambda (fd)
               (push fd (active-observer-identities observer))
               (io::native-identity fd))))

(defstruct (active-fixture (:constructor %make-active-fixture) (:conc-name af-))
  source segment controller lease input append path root header identity association
  observer backend registry index cache scope epochs snapshots snapshot view output
  (version 2) (base 6) (generation 0) (end 64) (published 0) (reused 0) (setup-complete-p nil)
  (contexts #() :type simple-vector) (batches #() :type simple-vector)
  (roots #() :type simple-vector) (events #() :type simple-vector)
  (event-generations #() :type simple-vector) (images #() :type simple-vector)
  (entries #() :type simple-vector) (keys #() :type simple-vector)
  (values #() :type simple-vector) (offsets #() :type simple-vector)
  (sizes #() :type simple-vector) (csns #() :type simple-vector)
  (put-batches #() :type simple-vector))
(defun af-context (fixture) (aref (af-contexts fixture) 0))
(defun active-reads (fixture)
  (reverse (copy-tree (active-observer-reads (af-observer fixture)))))
(defun active-clear-reads (fixture)
  (setf (active-observer-reads (af-observer fixture)) nil)
  nil)
(defun active-clear-effects (fixture)
  (let ((observer (af-observer fixture)))
    (setf (active-observer-reads observer) nil (active-observer-writes observer) nil
          (active-observer-flushes observer) nil (active-observer-identities observer) nil))
  nil)
(defun active-no-effects-p (fixture)
  (let ((observer (af-observer fixture)))
    (and (null (active-observer-reads observer)) (null (active-observer-writes observer))
         (null (active-observer-flushes observer)) (null (active-observer-identities observer)))))
(defun active-set-read-hook (fixture function)
  (setf (active-observer-read-hook (af-observer fixture)) function))
(defun active-fresh-root ()
  (loop for attempt below 1000
        for path = (merge-pathnames
                    (format nil "arcdocdb-active-~D-~D-~D/"
                            (get-universal-time) (sb-posix:getpid) attempt)
                    (uiop:temporary-directory)) do
    (handler-case
        (progn (sb-posix:mkdir (namestring path) #o700) (return-from active-fresh-root path))
      (sb-posix:syscall-error (condition)
        (unless (= sb-posix:eexist (sb-posix:syscall-errno condition)) (error condition)))))
  (error 'active-fixture-error :reason :namespace-budget))

(defun active-create-source (fixture &rest options)
  "Crea una nuova capacità della stessa fixture prima di adottare il primo lotto."
  (apply #'r:crea-sorgente-get-attiva (af-controller fixture) (af-lease fixture)
         (af-segment fixture)
         (append options (list :associazione-file (af-association fixture)))))
(defun active-normalize-entry (entry ordinal csn)
  (let* ((kind (getf entry :kind :put))
         (key (if (eq kind :outcome) (active-octets 0)
                  (copy-seq (or (getf entry :key) (active-key ordinal)))))
         (value (case kind
                  (:tombstone (active-octets 0))
                  (:outcome (active-write-le (active-octets 8) 0 8 csn))
                  (otherwise (copy-seq (or (getf entry :value) (active-value ordinal))))))
         (flags (getf entry :flags (if (eq kind :prepared) 1 0)))
         (stamp (getf entry :stamp #xfedcba9876543210)))
    (unless (member kind '(:put :tombstone :prepared :outcome))
      (error 'active-fixture-error :reason :record-kind))
    (list :kind kind :key key :value value :flags flags :stamp stamp)))
(defun active-entry-kind (entry)
  (case (getf entry :kind) ((:put :prepared) 1) (:tombstone 2) (:outcome 4)))
(defun active-make-batch (fixture entries)
  "OPEN esclusivo: niente CSN/I/O; usato anche per rifiuti preflight validi."
  (let* ((normalized (mapcar (lambda (entry) (active-normalize-entry entry 0 (1+ (af-base fixture)))) entries))
         (size (+ 56 (reduce #'+ normalized
                             :key (lambda (entry) (+ 24 (length (getf entry :key))
                                                    (length (getf entry :value)))) :initial-value 0)))
         (batch (w:crea-lotto :segment 17 :version (af-version fixture)
                              :capacity (max 56 size) :max-records (max 1 (length entries)))))
    (dolist (entry normalized)
      (w:aggiungi-record batch (active-entry-kind entry) (getf entry :key) (getf entry :value)
                        :flags (getf entry :flags) :txid (getf entry :stamp)))
    batch))
(defun active-seal-batch (fixture batch &optional (start (af-end fixture)))
  (w:sigilla-lotto-con-csn batch (af-registry fixture) (af-controller-log fixture)
                          start (io:posizione-durevole (af-append fixture))))
(defun af-controller-log (fixture)
  (s::controllore-serie-log (af-controller fixture)))

(defun active-publish-candidate (fixture ordinal &key (csn (aref (af-csns fixture) ordinal))
                                                    (size (aref (af-sizes fixture) ordinal))
                                                    (offset (aref (af-offsets fixture) ordinal)))
  "Indice pubblico. L'uso prima della root è fault injection esplicita del caller."
  (let* ((key (aref (af-keys fixture) ordinal)) (index (af-index fixture))
         (content (make-array 5 :element-type '(unsigned-byte 64) :initial-element 0)))
    (setf (aref content 0) csn (aref content 1) (logior (ash 17 32) offset)
          (aref content 2) (logior (ash (length key) 32) (ash 1 48)) (aref content 3) size)
    (multiple-value-bind (high low) (p:digest-chiave-indice index key 0 (length key))
      (p:pubblica-chiave-indice index (p:frammento-corrente-indice index high) key 0 (length key)
                               high low content (p:crea-contesto-indice)))))
(defun active-publish-through (fixture count)
  "Pubblica FIFO le sole radici durevoli richieste, poi i candidati corrispondenti."
  (unless (<= (af-published fixture) count (length (af-batches fixture)))
    (error 'active-fixture-error :reason :publication-order))
  (loop for rank from (af-published fixture) below count do
    (multiple-value-bind (status high low)
        (s:pubblica-commit-serie (af-controller fixture) (af-lease fixture)
                                (aref (af-events fixture) rank) (aref (af-event-generations fixture) rank))
      (unless (and (eq status :risolto)
                   (= (logior (ash high 32) low) (+ (af-base fixture) rank 1)))
        (error 'active-fixture-error :reason :publication-result)))
    (dotimes (ordinal (length (af-keys fixture)))
      (when (= rank (aref (af-put-batches fixture) ordinal))
        (active-publish-candidate fixture ordinal)))
    (setf (af-published fixture) (1+ rank)))
  nil)
(defun active-reuse-through (fixture count)
  (unless (<= (af-reused fixture) count (af-published fixture))
    (error 'active-fixture-error :reason :retirement-order))
  (loop for rank from (af-reused fixture) below count do
    (s:riusa-commit-serie (af-controller fixture) (af-lease fixture)
                         (aref (af-events fixture) rank) (aref (af-event-generations fixture) rank))
    (setf (af-reused fixture) (1+ rank)))
  nil)

(defun close-active-fixture (fixture)
  "Cleanup solo dopo witness GET; nessun dispatch autonomo o I/O ancora in volo."
  (unwind-protect
       (progn
         (dotimes (worker (length (af-contexts fixture)))
           (when (aref (af-contexts fixture) worker)
             (g:abbandona-get (aref (af-contexts fixture) worker))))
         (when (plusp (af-generation fixture))
           (m:termina-snapshot (af-snapshot fixture) (af-generation fixture))
           (setf (af-generation fixture) 0))
         ;; La fixture seriale completa tutti gli I/O in setup. I pendenti sani
         ;; vengono pubblicati soltanto dopo la fine delle osservazioni del test.
         (when (and (af-controller fixture) (af-lease fixture))
           (when (and (af-setup-complete-p fixture)
                      (eq (s:stato-controllore-serie (af-controller fixture)) :healthy))
             (active-publish-through fixture (length (af-batches fixture)))
             (active-reuse-through fixture (af-published fixture)))
           (s:rilascia-controllore-serie (af-controller fixture) (af-lease fixture))
           (setf (af-lease fixture) nil)))
    (unwind-protect
         (when (af-input fixture) (io:chiudi (af-input fixture)))
      (unwind-protect
           (when (af-append fixture) (io:chiudi (af-append fixture)))
        (when (and (af-path fixture) (probe-file (af-path fixture)))
          (sb-posix:unlink (namestring (af-path fixture))))
        (when (and (af-root fixture) (probe-file (af-root fixture)))
          (sb-posix:rmdir (namestring (af-root fixture))))
        (setf (af-root fixture) nil))))
  nil)

(defun make-active-fixture (&key (version 2) (cache-p t) (base 6)
                               (batches '(((:kind :put)))) (publish-count nil)
                               (record-bytes 256) (contexts 1)
                               (max-pages 65536) (max-puts 1048576)
                               (max-batch-records 65536) (max-batch-bytes 67108864)
                               (budget-payload 67108864))
  "BATCHES liste di plist; ordinale globale dei soli PUT. Il piano indipendente
precede WAL/root. Tutti i lotti vengono scritti e flushati; PUBLISH-COUNT può
lasciare una root solo pianificata. Non attesta l'indice atomico del prodotto."
  (unless (and (member version '(1 2)) (<= 1 contexts 8) (<= (length batches) 8)
               (typep base '(integer 0 #xfffffffffffffff0)))
    (error 'active-fixture-error :reason :configuration))
  (let ((fixture (%make-active-fixture :version version :base base)) (ready nil)
        (identity (active-octets 16)) (puts nil) (normalized nil) (images nil) (position 64) (ordinal 0))
    (dotimes (i 16) (setf (aref identity i) (+ 32 i)))
    ;; Le attese CSN/offset/byte sono calcolate da input e base, prima del prodotto.
    (loop for entries in batches for rank from 0 do
      (let ((start position) (records nil) (plan nil) (csn (+ base rank 1)))
        (dolist (entry entries)
          (let* ((entry (active-normalize-entry entry ordinal csn))
                 (kind (getf entry :kind))
                 (stamp (if (or (eq kind :outcome) (logbitp 0 (getf entry :flags)))
                            (getf entry :stamp) csn))
                 (record (active-reference-record (active-entry-kind entry) (getf entry :flags)
                                                  stamp (getf entry :key) (getf entry :value))))
            (when (member kind '(:put :prepared))
              (push (list (getf entry :key) (getf entry :value) position (length record) csn rank) puts)
              (incf ordinal))
            (push entry plan) (push record records) (incf position (length record))))
        (setf records (nreverse records))
        (let* ((seal (active-reference-seal records start 64 csn))
               (image (active-octets (+ (- position start) 56))) (cursor 0))
          (dolist (record records) (replace image record :start1 cursor) (incf cursor (length record)))
          (replace image seal :start1 cursor) (push image images) (incf position 56))
        (push (nreverse plan) normalized)))
    (setf puts (nreverse puts) normalized (nreverse normalized) images (nreverse images))
    (let* ((count (length puts)) (batch-count (length batches))
           (capacity (loop for n = 16 then (* 2 n) repeat 6 when (>= n (* 2 count)) return n))
           (scratch (if (listp record-bytes) record-bytes (make-list contexts :initial-element record-bytes))))
      (unless (and capacity (= (length scratch) contexts) (every (lambda (n) (<= 1 n 16842775)) scratch))
        (error 'active-fixture-error :reason :scratch-budget))
      (setf (af-identity fixture) identity (af-header fixture) (active-reference-header version identity)
            (af-end fixture) position (af-entries fixture) (coerce normalized 'simple-vector)
            (af-images fixture) (coerce images 'simple-vector)
            (af-keys fixture) (coerce (mapcar #'first puts) 'simple-vector)
            (af-values fixture) (coerce (mapcar #'second puts) 'simple-vector)
            (af-offsets fixture) (coerce (mapcar #'third puts) 'simple-vector)
            (af-sizes fixture) (coerce (mapcar #'fourth puts) 'simple-vector)
            (af-csns fixture) (coerce (mapcar #'fifth puts) 'simple-vector)
            (af-put-batches fixture) (coerce (mapcar #'sixth puts) 'simple-vector)
            (af-batches fixture) (make-array batch-count :initial-element nil)
            (af-roots fixture) (make-array batch-count :initial-element nil)
            (af-events fixture) (make-array batch-count :initial-element nil)
            (af-event-generations fixture) (make-array batch-count :initial-element nil)
            (af-contexts fixture) (make-array contexts :initial-element nil)
            (af-observer fixture) (make-active-observer))
      (unwind-protect
           (progn
             (setf (af-registry fixture) (arcdocdb.csn:crea-registro-csn
                                         :capacity 16 :initial-high (ldb (byte 32 32) base)
                                         :initial-low (ldb (byte 32 0) base))
                   (af-snapshots fixture) (m:crea-registro-snapshot (af-registry fixture) 4 20 5)
                   (af-snapshot fixture) (m:crea-contesto-snapshot (af-snapshots fixture))
                   (af-epochs fixture) (e:crea-registro-epoche contexts 4)
                   (af-scope fixture) (g:crea-ambito-get (af-epochs fixture) (af-snapshots fixture))
                   (af-index fixture) (p:crea-indice-primario
                                       :capacity capacity :arena-bytes (* (+ count 4) 255) :max-depth 1
                                       :directory-budget-bytes 4096
                                       :fragment-budget-bytes (+ (* 41 capacity) (* (+ count 4) 255))
                                       :hash-seed-high #x12345678 :hash-seed-low #x9abcdef0)
                   (af-cache fixture) (when cache-p
                                        (c:crea-cache-serie
                                         (make-array 1 :element-type '(unsigned-byte 32) :initial-element 1024)
                                         (make-array 1 :element-type '(unsigned-byte 32) :initial-element 1)
                                         (+ (* 8 (+ 1024 29)) 1 16) :stripes 1))
                   (af-view fixture) (g:crea-vista-get-serie (af-scope fixture) (af-index fixture)
                                                          (af-cache fixture) identity)
                   (af-output fixture) (active-octets (+ 6 (reduce #'max puts
                                            :key (lambda (put) (length (second put))) :initial-value 0))
                                                     +active-sentinel+)
                   (af-root fixture) (active-fresh-root)
                   (af-backend fixture) (active-observed-backend (af-observer fixture)))
             (loop for size in scratch for worker from 0 do
               (setf (aref (af-contexts fixture) worker)
                     (g:crea-contesto-get (af-scope fixture) worker :record-bytes size :budget-payload (+ size 152))))
             (let ((path (merge-pathnames "segment-17.tmp" (af-root fixture))))
               (setf (af-append fixture) (io:crea-temporaneo path :backend (af-backend fixture))
                     (af-path fixture) path)
               (io:append-esatto (af-append fixture) (af-header fixture) 0 64)
               (io:durable-flush (af-append fixture))
               (setf (af-input fixture) (io:apri-lettura path :backend (af-backend fixture))
                     (af-association fixture) (io:associa-file (af-input fixture) (af-append fixture))
                     (af-segment fixture) (g:crea-segmento-get (af-view fixture) (af-input fixture) 17 (active-octets 64))
                     (af-controller fixture) (s:crea-controllore-serie
                                              (af-registry fixture)
                                              (w:crea-log-io (af-append fixture) :segment 17 :version version)
                                              :capacity 8 :next-offset 64)
                     (af-lease fixture) (s:acquisisci-controllore-serie (af-controller fixture))
                     (af-source fixture) (active-create-source fixture :max-pages max-pages :max-puts max-puts
                                          :batch-records max-batch-records :batch-bytes max-batch-bytes
                                          :budget-payload budget-payload)))
             (let ((previous nil) (start 64))
               (dotimes (rank batch-count)
                 (let* ((entries (aref (af-entries fixture) rank))
                        (batch (active-make-batch fixture entries))
                        (expected (aref (af-images fixture) rank)))
                   (setf (aref (af-batches fixture) rank) batch)
                   (r:verifica-capienza-get-attiva (af-source fixture) (af-lease fixture) batch previous)
                   (w:sigilla-lotto-con-csn batch (af-registry fixture) (af-controller-log fixture) start 64)
                   (unless (and (= (w:lunghezza-lotto batch) (length expected))
                                (equalp expected (subseq (w::lotto-buffer batch) 0 (length expected))))
                     (error 'active-fixture-error :reason :independent-wire))
                   (multiple-value-bind (event generation root)
                       (r:registra-lotto-get-attivo (af-source fixture) (af-lease fixture) batch previous
                                                   (list :fixture-page rank) :group)
                     (setf (aref (af-events fixture) rank) event
                           (aref (af-event-generations fixture) rank) generation
                           (aref (af-roots fixture) rank) root previous root))
                   (incf start (length expected)))))
             (dotimes (rank batch-count)
               (let ((group (w:crea-gruppo (af-controller-log fixture) :max-lots 1))
                     (event (aref (af-events fixture) rank))
                     (generation (aref (af-event-generations fixture) rank)))
                 (s:inizia-io-commit-serie (af-controller fixture) (af-lease fixture) event generation)
                 (w:aggiungi-lotto group (aref (af-batches fixture) rank)) (w:chiudi-gruppo group)
                 (w:scrivi-gruppo group) (w:sincronizza-gruppo group)
                 (s:completa-io-commit-serie (af-controller fixture) (af-lease fixture) event generation)
                 (w:riusa-gruppo group)))
             (setf (af-setup-complete-p fixture) t)
             (active-publish-through fixture (or publish-count batch-count))
             (active-clear-effects fixture)
             (setf ready t)
             fixture)
        (unless ready (close-active-fixture fixture))))))

(defmacro with-active-fixture ((fixture &rest options) &body body)
  `(let ((,fixture (make-active-fixture ,@options)))
     (unwind-protect (progn ,@body) (close-active-fixture ,fixture))))
(defun active-register-snapshot (fixture &optional (now 10))
  (setf (af-generation fixture) (nth-value 0 (m:registra-snapshot (af-snapshot fixture) now))))
(defun active-begin (fixture ordinal &key (worker 0) (now 11)
                                        (snapshot-p (plusp (af-generation fixture))))
  (g:avvia-get (aref (af-contexts fixture) worker) (af-view fixture) (aref (af-keys fixture) ordinal)
               (when snapshot-p (af-snapshot fixture)) (if snapshot-p (af-generation fixture) 0) now))
(defun active-clean-p (fixture &optional (state :idle) (worker 0))
  "Witness del cleanup, separato dall'oracolo di valore e dalla directory."
  (let ((context (aref (af-contexts fixture) worker)))
    (and (eq state (g:stato-contesto-get context))
         (not (e:epoca-attiva-p (e:contesto-epoca (af-epochs fixture) worker)))
         (null (g::contesto-get-view context)) (null (g::contesto-get-key context))
         (not (g::contesto-get-snapshot-p context))
         (zerop (g::contesto-get-value-start context)) (zerop (g::contesto-get-value-end context))
         (every #'zerop (g::contesto-get-content context)) (every #'zerop (g::contesto-get-limit context)))))
(defun active-copy-and-finish (fixture ordinal &key (worker 0) (now 12))
  (let* ((value (aref (af-values fixture) ordinal)) (output (af-output fixture))
         (end (+ +active-output-start+ (length value))) (context (aref (af-contexts fixture) worker)))
    (fill output +active-sentinel+)
    (is (= end (g:copia-valore-get context output +active-output-start+)))
    (multiple-value-bind (result size) (g:concludi-get context now)
      (is (eq :found result)) (is (= size (length value))))
    (is (loop for i below +active-output-start+ always (= +active-sentinel+ (aref output i))))
    (is (loop for i below (length value) always (= (aref value i) (aref output (+ 3 i)))))
    (is (loop for i from end below (length output) always (= +active-sentinel+ (aref output i))))
    (is (active-clean-p fixture :idle worker))
    t))
