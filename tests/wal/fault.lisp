(in-package #:arcdocdb.wal.tests)

(deftest test-REQ-AFF-001-write-failure-stops-log-and-all-batches
  (dolist (errno (list sb-posix:eio sb-posix:enospc sb-posix:eintr))
    (let* ((calls 0) (flushes 0)
           (file (fixture-file :writer (lambda (fd b start count)
                                        (declare (ignore fd b start))
                                        (incf calls) (if (= calls 1) count
                                                       (error 'sb-posix:syscall-error :errno errno :name 'write)))
                               :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
           (log (crea-log-io file :segment 31)) (a (fixture-lotto))
           (b (fixture-lotto :start 82)) (group (fixture-group log a b)))
      (signals io-fault (scrivi-gruppo group))
      (is (= calls 2)) (is (zerop flushes))
      (is (eq :faulted (stato-log log))) (is (eq :faulted (stato-gruppo group)))
      (is (not (coperto-p a :async))) (is (not (coperto-p b :strong)))
      (signals invalid-argument (sincronizza-gruppo group))
      (signals io-fault (scrivi-gruppo (fixture-group log (fixture-lotto :start 82))))
      (is (= calls 2)) (arcdocdb.io:chiudi file))))

(deftest test-REQ-AFF-001-flush-failure-never-advances-durability
  (let* ((flushes 0) (file (fixture-file :flush (lambda (fd) (declare (ignore fd))
                                                (incf flushes)
                                                (if (= flushes 1) 0
                                                    (error 'sb-posix:syscall-error :errno sb-posix:eio :name 'flush)))))
         (log (crea-log-io file :segment 31)) (first (fixture-group log (fixture-lotto))))
    (esegui-gruppo first)
    (let* ((lotto (fixture-lotto :start 82 :durable 82)) (group (fixture-group log lotto)))
      (scrivi-gruppo group) (is (coperto-p lotto :async))
      (signals io-fault (sincronizza-gruppo group))
      (is (= 82 (arcdocdb.io:posizione-durevole file)))
      (is (coperto-p (svref (arcdocdb.wal::gruppo-slots first) 0) :strong))
      (is (not (coperto-p lotto :group))) (is (not (coperto-p lotto :async)))
      (signals invalid-argument (riusa-lotto lotto))
      (signals invalid-argument (sincronizza-gruppo group)) (is (= flushes 2)))
    (arcdocdb.io:chiudi file)))

(deftest test-REQ-WAL-005-crash-at-every-written-byte-v1-v2
  (dolist (version '(1 2))
    (dotimes (cut 165)
      (let* ((output (buffer 164)) (pos 0) (flushes 0)
             (file (fixture-file :writer
                     (lambda (fd data start count)
                       (declare (ignore fd))
                       (when (= pos cut)
                         (error 'sb-posix:syscall-error :errno sb-posix:eio :name 'crash))
                       (let ((n (min count (- cut pos) 7)))
                         (replace output data :start1 pos :start2 start :end2 (+ start n))
                         (incf pos n) n))
                                :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
             (log (crea-log-io file :segment 31 :version version))
             (a (fixture-lotto :version version))
             (b (fixture-lotto :start 82 :version version)) (group (fixture-group log a b)))
        (if (< cut 164) (signals io-fault (esegui-gruppo group)) (esegui-gruppo group))
        (is (= pos cut)) (is (= flushes (if (= cut 164) 1 0)))
        (multiple-value-bind (end state batches records)
            (arcdocdb.recovery.scan:scansiona-log output 0 cut 31 :version version :file-size cut)
          (is (= end (cond ((< cut 82) 0) ((< cut 164) 82) (t 164))))
          (is (= batches (floor cut 82))) (is (= records batches))
          (is (eq state (if (member cut '(0 82 164)) :complete :tail))))
        (arcdocdb.io:chiudi file)))))

(deftest test-REQ-AFF-001-private-ownership-violation-stops-before-flush
  (let* ((flushes 0) (file (fixture-file :flush (lambda (fd) (declare (ignore fd)) (incf flushes) 0)))
         (log (crea-log-io file :segment 31)) (group (fixture-group log (fixture-lotto))))
    (scrivi-gruppo group)
    (setf (arcdocdb.wal::log-io-active log) nil)
    (signals invariant-violation (sincronizza-gruppo group))
    (is (zerop flushes)) (is (eq :faulted (stato-log log)))
    (is (not (coperto-p (svref (arcdocdb.wal::gruppo-slots group) 0) :strong)))
    (arcdocdb.io:chiudi file)))

(deftest test-REQ-WAL-002-second-group-rejected-until-flush
  (let* ((file (fixture-file)) (log (crea-log-io file :segment 31))
         (first (fixture-group log (fixture-lotto)))
         (second (fixture-group log (fixture-lotto :start 82))))
    (scrivi-gruppo first)
    (signals resource-exhausted (scrivi-gruppo second))
    (is (= 82 (arcdocdb.io:posizione-scritta file)))
    (sincronizza-gruppo first) (esegui-gruppo second)
    (is (= 164 (arcdocdb.io:posizione-durevole file)))
    (arcdocdb.io:chiudi file)))

(deftest test-REQ-WAL-002-concurrent-groups-at-most-one-write
  (let* ((calls 0) (file (fixture-file :writer (lambda (fd b start count)
                                               (declare (ignore fd b start)) (incf calls) count)))
         (log (crea-log-io file :segment 31))
         (a (fixture-group log (fixture-lotto))) (b (fixture-group log (fixture-lotto)))
         (threads (loop for group in (list a b) collect
                        (let ((candidate group))
                          (sb-thread:make-thread
                           (lambda () (handler-case (progn (scrivi-gruppo candidate) :written)
                                        (resource-exhausted () :busy))))))))
    (let ((results (mapcar (lambda (thread) (sb-thread:join-thread thread :timeout 10)) threads)))
      (is (= 1 (count :written results))) (is (= 1 (count :busy results)))
      (is (= calls 1)))
    (sincronizza-gruppo (if (eq :written (stato-gruppo a)) a b))
    (arcdocdb.io:chiudi file)))

(deftest test-REQ-WAL-002-concurrent-flush-at-most-one-syscall
  (let* ((flushes 0) (started (sb-thread:make-semaphore)) (release (sb-thread:make-semaphore))
         (lock (sb-thread:make-mutex))
         (file (fixture-file :flush (lambda (fd) (declare (ignore fd))
                                     (let ((n (sb-thread:with-mutex (lock) (incf flushes))))
                                       (unless (= n 1) (error "Secondo flush entrato."))
                                       (sb-thread:signal-semaphore started)
                                       (unless (sb-thread:wait-on-semaphore release :timeout 10)
                                         (error "Flush della fixture non rilasciato.")) 0))))
         (log (crea-log-io file :segment 31)) (group (fixture-group log (fixture-lotto))))
    (scrivi-gruppo group)
    (let ((first (sb-thread:make-thread (lambda () (sincronizza-gruppo group) :durable))))
      (unwind-protect
           (progn
             (is (sb-thread:wait-on-semaphore started :timeout 10))
             (let* ((threads (loop repeat 3 collect
                         (sb-thread:make-thread
                          (lambda () (handler-case (progn (sincronizza-gruppo group) :durable)
                                       (resource-exhausted () :busy) (invalid-argument () :rejected)
                                       (error (c) c))))))
           (results (mapcar (lambda (thread) (sb-thread:join-thread thread :timeout 10)) threads)))
               (is (= flushes 1)) (is (every (lambda (x) (member x '(:busy :rejected))) results))))
        (sb-thread:signal-semaphore release))
      (is (eq :durable (sb-thread:join-thread first :timeout 10))))
    (arcdocdb.io:chiudi file)))
