;;;; Fixture Archivio CSN: replay e risultati Serie reali, oracoli bytewise qualificati CT/RT.
;;; OWNER: runner seriale, <=4 Serie, <=4 CLOSED/Serie, <=32 FD, 4096 byte/file, 65536 eventi.
;;; SHARED: nessun worker o FI globale nel supporto; tutte le sorgenti readonly congelate.
;;; REQ: REQ-REC-001 REQ-REC-002 REQ-MVC-006 REQ-TXM-005 REQ-AFF-008
(defpackage #:arcdocdb.recovery.archive.csn.tests
  (:use #:cl)
  (:local-nicknames (#:ac #:arcdocdb.recovery.archive.csn) (#:da #:arcdocdb.recovery.archive)
                   (#:cr #:arcdocdb.recovery.closed) (#:c #:arcdocdb.control) (#:io #:arcdocdb.io)
                   (#:ct #:arcdocdb.control.tests) (#:rt #:arcdocdb.recovery.tests)
                   (#:cd #:arcdocdb.recovery.closed.tests) (#:rac #:arcdocdb.recovery.active.checkpoint.tests)
                   (#:av #:arcdocdb.recovery.active.tests) (#:dar #:arcdocdb.recovery.archive.tests)
                   (#:g #:arcdocdb.get) (#:cs #:arcdocdb.csn.tests))
  (:import-from #:arcdocdb.foundation.tests #:is #:signals)
  (:import-from #:arcdocdb.conditions #:invalid-argument #:resource-exhausted #:corruption-detected
                #:invariant-violation #:unsupported-format #:io-fault #:error-reason #:error-offset)
  (:export #:run))
(in-package #:arcdocdb.recovery.archive.csn.tests)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defvar *tests* nil)
(defmacro deftest (name &body body)
  `(progn (defun ,name () ,@body) (pushnew ',name *tests*)))
(defun run ()
  (dolist (test (reverse *tests*)) (funcall test) (format t "ok    ~A~%" test))
  (format t "~D test piano CSN Archivio superati.~%" (length *tests*)) t)
(defun acr-identity (number) (rt::participant-id number #x40))
(defun acr-archive-id () (dar::dar-identity))
(defun acr-view (number &optional scope)
  (let ((prototype (ct::crr-view (acr-identity number))))
    (if scope
        (g:crea-vista-get-serie scope (g::vista-get-serie-primary prototype) nil (acr-identity number))
        prototype)))
(defun acr-serie (number &key active closed tail)
  (list :number number :active active :closed closed :tail tail))
(defun acr-closed (id &key (origin 1) batches records outcomes tail)
  (list :id id :origin origin :batches batches :records records :outcomes outcomes :tail tail))
(defun acr-control-bytes (identity version closed)
  (let ((bytes (cd::cdr-control-bytes version closed)))
    (replace bytes identity :start1 16 :end1 32)
    (ct::crr-pack bytes 56 (ct::crr-crc bytes 0 56) 4) bytes))
(defun acr-closed-bytes (identity version spec)
  (multiple-value-bind (bytes layouts prefix)
      (cd::cdr-log (getf spec :batches) :version version :id (getf spec :id)
        :origin (getf spec :origin) :records (getf spec :records) :tail (getf spec :tail))
    (declare (ignore layouts)) ; oracolo di layout non necessario al solo aggregatore.
    (replace bytes identity :start1 16 :end1 32)
    (ct::crr-pack bytes 56 (ct::crr-crc bytes 0 56) 4)
    (values bytes prefix)))

(defstruct (acr-fixture (:constructor %acr-fixture))
  archive scope views registri set decisions decision-input decision-bytes
  controls control-inputs control-bytes active active-inputs active-bytes active-prefixes
  closed closed-inputs closed-bytes version specs backend inputs
  (images (make-hash-table :test 'eql)) (references (make-hash-table :test 'eql))
  (paths (make-hash-table :test 'equal)) (closed-fds (make-hash-table :test 'eql))
  (events (make-array 65536 :fill-pointer 0)))
(defun acr-event (f event)
  (is (< (length (acr-fixture-events f)) 65536)) (vector-push event (acr-fixture-events f)))
(defun acr-clear (f) (setf (fill-pointer (acr-fixture-events f)) 0))
(defun acr-events (f) (coerce (acr-fixture-events f) 'list))
(defun acr-forbidden (f operation &rest args)
  (acr-event f (cons operation args)) (error 'invariant-violation :reason :archive-csn-fixture-io))
(defun acr-backend (f)
  (io:make-backend
   (lambda (path mode)
     (is (eq mode :input)) (or (gethash path (acr-fixture-paths f)) (error "Nome inatteso")))
   (lambda (fd buffer start count offset)
     (acr-event f (list :read fd start count offset))
     (is (not (gethash fd (acr-fixture-closed-fds f))))
     (let* ((bytes (gethash fd (acr-fixture-images f)))
            (n (min count (max 0 (- (length bytes) offset)))))
       (replace buffer bytes :start1 start :end1 (+ start n) :start2 offset :end2 (+ offset n)) n))
   (lambda (&rest args) (apply #'acr-forbidden f :write args))
   (lambda (&rest args) (apply #'acr-forbidden f :flush args))
   (lambda (&rest args) (apply #'acr-forbidden f :directory-flush args))
   (lambda (fd)
     (is (not (gethash fd (acr-fixture-closed-fds f))))
     (acr-event f (list :close fd)) (setf (gethash fd (acr-fixture-closed-fds f)) t) 0)
   :identity (lambda (fd) (acr-event f (list :identity fd)) (values 1 fd))
   :entry-identity (lambda (&rest args) (apply #'acr-forbidden f :entry args))
   :rename (lambda (&rest args) (apply #'acr-forbidden f :rename args))))
(defun acr-open (f bytes)
  (is (< (length (acr-fixture-inputs f)) 32)) (is (<= (length bytes) 4096))
  (let* ((fd (+ 701 (length (acr-fixture-inputs f)))) (path (format nil "/archive-csn/~D" fd)))
    (setf (gethash path (acr-fixture-paths f)) fd
          (gethash fd (acr-fixture-images f)) (copy-seq bytes)
          (gethash fd (acr-fixture-references f)) (copy-seq bytes))
    (let ((input (io:apri-lettura path :backend (acr-fixture-backend f) :max-transfer 4096)))
      (push input (acr-fixture-inputs f)) input)))
(defun acr-noeffects (f)
  (is (null (acr-events f)))
  (loop for fd being the hash-keys of (acr-fixture-images f) using (hash-value bytes)
        do (is (equalp bytes (gethash fd (acr-fixture-references f)))))
  (dolist (input (acr-fixture-inputs f))
    (is (eq :input (io:mode-file input)))
    (is (zerop (io:posizione-scritta input))) (is (zerop (io:posizione-durevole input)))))
(defun acr-expect (type reason thunk &optional (offset nil offset-p))
  (let ((actual (handler-case (progn (funcall thunk) nil) (error (condition) condition))))
    (unless (typep actual type) (error "Atteso ~S/~S, ottenuto ~S: ~A" type reason (type-of actual) actual))
    (when reason (is (eq reason (error-reason actual))))
    (when offset-p (is (eql offset (error-offset actual)))) actual))
(declaim (notinline acr-invoke))
(defun acr-invoke (name &rest args) (apply (symbol-function name) args))

(defun acr-replay (f &optional (archive (acr-fixture-archive f)))
  (let* ((bytes (acr-fixture-decision-bytes f)) (scratch (ct::crr-bytes (length bytes))))
    (da:leggi-decisioni-recuperate archive (acr-fixture-decision-input f) (length bytes) scratch
      :chunk-bytes 31 :max-bytes 4096 :max-batches 16 :max-batch-records 16
      :max-batch-bytes 4096 :max-decisions 32 :max-participants 128 :max-participants-per-decision 16)))
(defun acr-read-control (f i &optional (view (aref (acr-fixture-views f) i)))
  (let ((bytes (aref (acr-fixture-control-bytes f) i)))
    (c:leggi-control-recuperato view (aref (acr-fixture-control-inputs f) i) (length bytes)
      (ct::crr-bytes (length bytes)) :chunk-bytes 31 :max-bytes 4096 :max-batches 4
      :max-batch-records 4 :max-edits 4 :max-segmenti 8 :max-esiti 32)))
(defun acr-read-active (f i decisions &optional (control (aref (acr-fixture-controls f) i)))
  (let* ((bytes (aref (acr-fixture-active-bytes f) i)) (prefix (aref (acr-fixture-active-prefixes f) i))
         (result (da:leggi-active-con-decisioni control (aref (acr-fixture-active-inputs f) i) (length bytes)
                   decisions (ct::crr-bytes (length bytes)) :chunk-bytes 31 :max-bytes 4096 :max-batches 16
                   :max-batch-records 16 :max-batch-bytes 4096 :max-records 32 :max-prepared 16 :max-outcomes 16)))
    (is (equal (list (length bytes) prefix (if (= prefix (length bytes)) :complete :tail) (acr-fixture-version f))
               (multiple-value-list (arcdocdb.recovery.active:frontiere-active-recuperato result))))
    result))
(defun acr-read-closed (f i j &optional (control (aref (acr-fixture-controls f) i)))
  (let* ((spec (nth j (getf (aref (acr-fixture-specs f) i) :closed)))
         (bytes (aref (aref (acr-fixture-closed-bytes f) i) j)))
    (cr:leggi-closed-recuperato control (aref (aref (acr-fixture-closed-inputs f) i) j)
      (getf spec :id) (ct::crr-bytes (length bytes)) :chunk-bytes 31 :max-bytes 4096
      :max-batches 16 :max-records 32 :max-batch-records 16 :max-batch-bytes 4096
      :max-prepared 16 :max-outcomes 16 :max-esiti-chiusura 16)))
(defun acr-plan (f &rest options)
  (apply #'ac:crea-piano-csn-archivio (acr-fixture-set f) (acr-fixture-decisions f)
         (acr-fixture-active f) (acr-fixture-closed f) options))

(defun acr-prepare-serie (f i)
  (let* ((spec (aref (acr-fixture-specs f) i)) (version (acr-fixture-version f))
         (identity (acr-identity (getf spec :number))) (closed (getf spec :closed))
         (n (length closed)) (entries nil) (sources (make-array n)) (inputs (make-array n)))
    (is (<= n 4))
    (loop for item in closed for j from 0
          do (multiple-value-bind (bytes prefix) (acr-closed-bytes identity version item)
               (setf (aref sources j) bytes (aref inputs j) (acr-open f bytes))
               (push (list (getf item :id) prefix (getf item :outcomes)) entries)))
    (setf (aref (acr-fixture-closed-bytes f) i) sources (aref (acr-fixture-closed-inputs f) i) inputs)
    (let* ((control (acr-control-bytes identity version (nreverse entries)))
           (active (rac::ra-active-bytes version identity (getf spec :active)))
           (bytes (if (getf spec :tail) (ct::crr-cat active (getf spec :tail)) active)))
      (setf (aref (acr-fixture-control-bytes f) i) control
            (aref (acr-fixture-control-inputs f) i) (acr-open f control)
            (aref (acr-fixture-controls f) i) (acr-read-control f i)
            (aref (acr-fixture-active-bytes f) i) bytes
            (aref (acr-fixture-active-prefixes f) i) (length active)
            (aref (acr-fixture-active-inputs f) i) (acr-open f bytes)
            (aref (acr-fixture-active f) i) (acr-read-active f i (acr-fixture-decisions f))
            (aref (acr-fixture-closed f) i)
            (map 'simple-vector (lambda (j) (acr-read-closed f i j)) (loop for j below n collect j))))))

(defun acr-with-fixture (thunk &key (version 2) (series (list (acr-serie 1)))
                                  decisions decision-tail (registri 0))
  (is (<= 1 (length series) 4)) (is (<= 0 registri (1- (length series))))
  (let* ((scope (g::vista-get-serie-scope (acr-view 0))) (n (length series))
         (views (map 'simple-vector (lambda (spec) (acr-view (getf spec :number) scope)) series))
         (f (%acr-fixture :scope scope :views views :registri (aref views registri)
              :archive (da:crea-archivio-recovery scope (acr-archive-id)) :version version
              :specs (coerce series 'simple-vector) :controls (make-array n) :control-inputs (make-array n)
              :control-bytes (make-array n) :active (make-array n) :active-inputs (make-array n)
              :active-prefixes (make-array n)
              :active-bytes (make-array n) :closed (make-array n) :closed-inputs (make-array n)
              :closed-bytes (make-array n))))
    (setf (acr-fixture-backend f) (acr-backend f))
    (unwind-protect
         (progn
           (setf (acr-fixture-set f) (ac:crea-insieme-serie-recovery (acr-fixture-archive f)
                                     (acr-fixture-registri f) views)
                 (acr-fixture-decision-bytes f)
                 (dar::dar-log (when decisions (list decisions)) :version version :tail decision-tail)
                 (acr-fixture-decision-input f) (acr-open f (acr-fixture-decision-bytes f))
                 (acr-fixture-decisions f) (acr-replay f))
           (dotimes (i n) (acr-prepare-serie f i))
           (acr-clear f) (funcall thunk f))
      (dolist (input (acr-fixture-inputs f))
        (unless (eq :closed (io:stato-file input)) (io:chiudi input))))))
