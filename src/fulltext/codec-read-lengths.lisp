(in-package #:arcdocdb.fulltext.codec)
(declaim (optimize (safety 3) (debug 2)))

;;; REQ: REQ-SEC-008
(declaim (ftype (function (octets descrittore-full-text spazio-codec-full-text) null) verifica-lunghezze-file))
(defun verifica-lunghezze-file (buffer descriptor space)
  "Pre: cornice/META verificati. Post: LENGTHS ordinate, riservati zero, prefissi e somma.
Verifica tutte le righe/campi e il totale per documento, prima dei posting."
  (let* ((base (aref (spazio-codec-full-text-starts space) 5))
         (count (floor (aref (spazio-codec-full-text-lengths space) 5) +length-width+))
         (positions (floor (aref (spazio-codec-full-text-lengths space) 4) +position-width+))
         (total 0) (prior-row -1) (prior-field 0) (row-count 0))
    (prepara-copertura space count positions)
    (dotimes (i count)
      (lavoro-codec space)
      (let* ((p (+ base (* i +length-width+))) (row (leggi-u32 buffer p))
             (field (leggi-u16 buffer (+ p +length-field+))) (n (leggi-u32 buffer (+ p +length-count+))))
        (unless (and (zerop (leggi-u16 buffer (+ p +length-field+ 2)))
                     (zerop (leggi-u32 buffer (+ p +length-count+ 4))))
          (error 'corruption-detected :reason :fulltext-length-reserved :offset p))
        (unless (or (> row prior-row) (and (= row prior-row) (> field prior-field)))
          (error 'corruption-detected :reason :fulltext-length-order :offset p))
        (controlla-riga-campo descriptor row field)
        (when (/= row prior-row) (setf row-count 0))
        (incf row-count n)
        (when (> row-count (descrittore-full-text-token-limit descriptor))
          (error 'corruption-detected :reason :fulltext-document-tokens :offset p))
        (when (> n (- positions total)) (error 'corruption-detected :reason :fulltext-length-total :offset p))
        (setf (aref (spazio-codec-full-text-prefix space) i) total prior-row row prior-field field)
        (incf total n)))
    (unless (= total positions) (error 'corruption-detected :reason :fulltext-length-total)))
  nil)
