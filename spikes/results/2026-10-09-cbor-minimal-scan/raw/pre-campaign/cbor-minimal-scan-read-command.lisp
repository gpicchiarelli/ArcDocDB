;;;; Lettura dei record originali come dati; trascrizione separata, nessun overwrite.
(require :asdf)
(load "tools/evidence-storage.lisp")
(let* ((args (rest sb-ext:*posix-argv*))
       (path (first args))
       (record (arcdocdb.evidence:read-evidence path)))
  (unless (= 2 (length args)) (error "Uso: record transcript-base"))
  (dolist (key '(:command :status :exit-code :source-consistency :diagnostic :wall-seconds))
    (format t "~S: ~S~%" key (getf record key)))
  (dolist (key '(:stdout :stderr))
    (let ((text (getf record key)))
      (when text
        (with-open-file (out (format nil "~A.~(~A~).log" (second args) key)
                             :direction :output :if-exists :error :external-format :utf-8)
          (write-string text out)))))
  (let* ((text (getf record :stdout))
         (lines (when text (uiop:split-string text :separator '(#\Newline)))))
    (format t "Righe OK: ~D~%" (count-if (lambda (line) (uiop:string-prefix-p "ok    " line)) lines))
    (dolist (line lines)
      (when (or (search "CBOR struttura minima:" line)
                (search "CBOR minimal scan:" line)
                (search "build e test:" line)
                (search "SPK-" line))
        (write-line line)))))
