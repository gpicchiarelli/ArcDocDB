;;;; C4: verifica archivi di comandi pubblicati, solo Common Lisp (INV-X3).
;;;; sbcl --script tools/check-command-archive.lisp --archive DIR
;;;; sbcl --script tools/check-command-archive.lisp --self-test DIR-NUOVA
;;; REQ: REQ-VAL-001 REQ-AFF-012
(require :asdf)
(load (merge-pathnames "evidence-storage.lisp" *load-truename*))

(defpackage #:arcdocdb.command-archive.check
  (:use #:cl))
(in-package #:arcdocdb.command-archive.check)
(declaim (optimize (safety 3) (debug 3)))

(defconstant +plain-limit+ 1048576)
(defconstant +gzip-limit+ 8388608)
(defconstant +expanded-limit+ 134217728)
(defconstant +inventory-limit+ 100000)
(defconstant +directory-depth-limit+ 128)
(defparameter *checker-source* *load-truename*)

(define-condition invalid-archive (error)
  ((reason :initarg :reason :reader invalid-reason)
   (path :initarg :path :reader invalid-path)
   (detail :initarg :detail :reader invalid-detail))
  (:report (lambda (condition stream)
             (format stream "Archivio non valido ~A, ~S: ~A"
                     (invalid-path condition) (invalid-reason condition)
                     (invalid-detail condition)))))

(defun reject (reason path control &rest arguments)
  (error 'invalid-archive :reason reason :path path
         :detail (apply #'format nil control arguments)))

(defun ensure-that (value reason path control &rest arguments)
  (unless value (apply #'reject reason path control arguments)))

(defun required (data key path)
  (let* ((absent (gensym "ABSENT")) (value (getf data key absent)))
    (when (eq value absent) (reject :missing-field path "Campo ~S assente." key))
    value))

(defun proper-list-size (value path)
  (ensure-that (listp value) :structure path "Lista richiesta.")
  (let ((size (handler-case (list-length value)
                (type-error () (reject :structure path "Lista propria richiesta.")))))
    (ensure-that (and size (<= size +inventory-limit+))
                 :structure path "Lista ciclica o oltre ~D elementi." +inventory-limit+)
    size))

(defun check-plist (value path)
  (let ((size (proper-list-size value path)) (seen (make-hash-table :test #'eq)))
    (ensure-that (and (plusp size) (evenp size)) :structure path "Plist non vuota richiesta.")
    (loop for key in value by #'cddr
          do (ensure-that (keywordp key) :structure path "Chiave non keyword.")
             (ensure-that (not (gethash key seen)) :duplicate-field path "Chiave ~S duplicata." key)
             (setf (gethash key seen) t))
    value))

(defun read-data (path limit)
  "Una plist via dipendenza trusted, READ-EVAL NIL e EOF; nessun LOAD dei dati."
  (handler-case
      (check-plist (arcdocdb.evidence:read-evidence path :max-expanded-bytes limit) path)
    (arcdocdb.evidence:invalid-evidence (condition)
      (reject :evidence-read path "~A" condition))))

(defun relative-parts (value)
  (ensure-that (and (stringp value) (<= 1 (length value) 4096)
                    (not (find-if (lambda (character)
                                    (or (< (char-code character) 32)
                                        (= (char-code character) 127)
                                        (find character "\\:*?[]"))) value)))
               :relative-path value "Percorso relativo semplice richiesto.")
  (let ((parts (uiop:split-string value :separator "/")))
    (ensure-that (and (<= (length parts) +directory-depth-limit+)
                      (every (lambda (part)
                               (and (plusp (length part))
                                    (not (member part '("." "..") :test #'equal)))) parts))
                 :relative-path value "Componenti vuote, assolute o di escape vietate.")
    parts))

(defun path-mode (path)
  "LSTAT senza slash finale, per non seguire un symlink di directory."
  (let ((name (namestring path)))
    (sb-posix:stat-mode (sb-posix:lstat (if (> (length name) 1) (string-right-trim "/" name) name)))))

(defun archive-root (argument)
  (let ((root (truename (uiop:ensure-directory-pathname argument))))
    (ensure-that (sb-posix:s-isdir (path-mode root))
                 :archive-root argument "Directory richiesta.")
    (uiop:ensure-directory-pathname root)))

(defun inside-file (root relative)
  "Solo componenti regolari interne alla root reale; symlink rifiutati."
  (let ((parts (relative-parts relative)) (current root))
    (loop for part in parts for remaining on parts
          do (let* ((last (null (rest remaining)))
                    (path (merge-pathnames (if last part (concatenate 'string part "/")) current))
                    (mode (handler-case (path-mode path)
                            (sb-posix:syscall-error ()
                              (reject :missing-file relative "Componente assente o non accessibile.")))))
               (ensure-that (if last (sb-posix:s-isreg mode) (sb-posix:s-isdir mode))
                            :nonregular-path relative "File/directory regolare richiesto, niente symlink.")
               (setf current path)))
    (let ((resolved (truename current)) (base (namestring root)))
      (ensure-that (and (> (length (namestring resolved)) (length base))
                        (string= base (namestring resolved) :end2 (length base)))
                   :relative-path relative "Il file risolto esce dalla root.")
      resolved)))

(defun file-budget (path relative)
  (let ((bytes (arcdocdb.evidence:file-bytes path))
        (limit (if (equal (pathname-type path) "gz") +gzip-limit+ +plain-limit+)))
    (ensure-that (<= bytes limit) :file-budget relative "~D byte, limite ~D." bytes limit)
    bytes))

(defun inventory (root)
  "Inventario completo inclusi nascosti. Il limite voci non limita DIRECTORY preventivamente."
  (let ((files (make-hash-table :test #'equal)) (entries 0) (base (namestring root)))
    (labels ((walk (directory depth)
               (ensure-that (<= depth +directory-depth-limit+) :inventory-limit directory
                            "Profondita directory oltre ~D." +directory-depth-limit+)
               (dolist (path (directory (make-pathname :name :wild :type :wild :defaults directory)
                                       :resolve-symlinks nil))
                 (incf entries)
                 (ensure-that (<= entries +inventory-limit+) :inventory-limit directory
                              "Inventario oltre ~D voci." +inventory-limit+)
                 (let ((mode (path-mode path)))
                   (cond
                     ((sb-posix:s-isdir mode) (walk (uiop:ensure-directory-pathname path) (1+ depth)))
                     ((sb-posix:s-isreg mode)
                      (let ((relative (subseq (namestring path) (length base))))
                        (relative-parts relative)
                        (file-budget path relative)
                        (setf (gethash relative files) path)))
                     (t (reject :nonregular-path path "Inventario con file speciale o symlink.")))))))
      (walk root 0))
    files))

(defun hex64-p (value)
  (and (stringp value) (= (length value) 64)
       (every (lambda (character) (digit-char-p character 16)) value)))

(defun catalogue-schema (data path)
  (ensure-that (and (eql 1 (required data :schema-version path))
                    (eq :evidence-catalog (required data :kind path))
                    (null (required data :pending path))) :catalogue-schema path
               "Catalogo schema1, kind evidence-catalog, pending NIL richiesto.")
  (let ((entries (required data :entries path)))
    (ensure-that (= 1 (proper-list-size entries path)) :catalogue-schema path "Una entry richiesta.")
    (let ((entry (check-plist (first entries) path)))
      (ensure-that (and (eq :original-command-archive (required entry :kind path))
                        (equal "archive-index.lisp" (required entry :artifact path))
                        (eql 1 (required entry :artifact-schema-version path))
                        (eq :original-command-archive (required entry :artifact-kind path)))
                   :catalogue-schema path "Entry archive-index schema1 richiesta."))))

(defun check-indexed-files (root index actual)
  (let ((indexed (make-hash-table :test #'equal)) (total 0)
        (files (required index :files "archive-index.lisp")))
    (proper-list-size files "archive-index.lisp")
    (dolist (entry files)
      (check-plist entry "archive-index.lisp")
      (let* ((relative (required entry :path "archive-index.lisp"))
             (path (inside-file root relative))
             (bytes (required entry :bytes relative)) (sha (required entry :sha256 relative)))
        (ensure-that (not (member relative '("archive-index.lisp" "catalogo.lisp") :test #'equal))
                     :derived-file-indexed relative "Metadato derivato non indicizzabile in se stesso.")
        (ensure-that (not (gethash relative indexed)) :duplicate-file relative "Path duplicato nell'indice.")
        (ensure-that (and (integerp bytes) (<= 0 bytes) (hex64-p sha)) :file-metadata relative
                     "Bytes non negativi e SHA256 esadecimale richiesti.")
        (ensure-that (= bytes (file-budget path relative)) :bytes relative "Dimensione diversa dall'indice.")
        (ensure-that (string-equal sha (arcdocdb.evidence:file-sha256 path)) :sha256 relative
                     "SHA256 diverso dall'indice.")
        (ensure-that (gethash relative actual) :inventory relative "File non osservato nell'inventario.")
        (setf (gethash relative indexed) path)
        (incf total bytes)))
    (maphash (lambda (relative path)
               (declare (ignore path))
               (ensure-that (or (gethash relative indexed)
                                (member relative '("archive-index.lisp" "catalogo.lisp") :test #'equal))
                            :inventory relative "File effettivo non indicizzato.")) actual)
    (ensure-that (= (hash-table-count actual) (+ 2 (hash-table-count indexed)))
                 :inventory "archive-index.lisp" "Inventario non chiuso.")
    (values indexed total)))

(defun metadata-shape (process path)
  "Campi scalari/lista di stringhe: confronto EQUAL bounded anche su dati malformati."
  (let ((command (required process :command path)))
    (proper-list-size command path)
    (ensure-that (every #'stringp command) :process-metadata path "COMMAND deve contenere stringhe.")
    (dolist (key '(:status :source-consistency))
      (let ((value (required process key path)))
        (ensure-that (or (null value) (keywordp value)) :process-metadata path "~S non scalare." key)))
    (let ((code (required process :exit-code path)))
      (ensure-that (or (null code) (integerp code)) :process-metadata path "EXIT-CODE non intero/NIL."))))

(defun check-processes (root index indexed)
  (let ((processes (required index :processes "archive-index.lisp"))
        (labels (make-hash-table :test #'equal)) (paths (make-hash-table :test #'equal)) (observed nil))
    (proper-list-size processes "archive-index.lisp")
    (dolist (process processes)
      (check-plist process "archive-index.lisp")
      (let ((label (required process :label "archive-index.lisp"))
            (relative (required process :record-path "archive-index.lisp")))
        (ensure-that (and (stringp label) (plusp (length label)) (not (gethash label labels)))
                     :process-label "archive-index.lisp" "Label mancante, invalido o duplicato.")
        (relative-parts relative)
        (ensure-that (not (gethash relative paths)) :process-record relative "Record duplicato.")
        (ensure-that (gethash relative indexed) :process-record relative "Record non indicizzato.")
        (let ((record (read-data (inside-file root relative) +expanded-limit+)))
          (metadata-shape process relative)
          (metadata-shape record relative)
          (dolist (key '(:command :status :exit-code :source-consistency))
            (ensure-that (equal (required process key relative) (required record key relative))
                         :process-metadata relative "Campo ~S diverso dal record." key)))
        (setf (gethash label labels) t (gethash relative paths) t)
        (push (loop for key in '(:label :record-path :command :status :exit-code :source-consistency)
                    append (list key (getf process key))) observed)))
    (nreverse observed)))

(defun audit-archive (argument)
  "Osservazione locale/per-file, niente confronto SOURCE, inferenza risultati o atomicita."
  (let* ((root (archive-root argument))
         (index-path (inside-file root "archive-index.lisp"))
         (catalogue-path (inside-file root "catalogo.lisp")))
    (file-budget index-path "archive-index.lisp")
    (file-budget catalogue-path "catalogo.lisp")
    (let* ((index-sha (arcdocdb.evidence:file-sha256 index-path))
           (catalogue-sha (arcdocdb.evidence:file-sha256 catalogue-path))
           (index (read-data index-path +plain-limit+))
           (catalogue (read-data catalogue-path +plain-limit+))
           (actual (inventory root)))
      (ensure-that (and (eql 1 (required index :schema-version index-path))
                        (eq :original-command-archive (required index :kind index-path)))
                   :index-schema index-path "Indice schema1 original-command-archive richiesto.")
      (catalogue-schema catalogue catalogue-path)
      (multiple-value-bind (indexed total) (check-indexed-files root index actual)
        (let ((processes (check-processes root index indexed)) (after (inventory root)))
          (ensure-that (and (= (hash-table-count actual) (hash-table-count after))
                            (loop for key being the hash-keys of actual always (gethash key after)))
                       :snapshot root "L'insieme dei file e cambiato durante l'audit.")
          (ensure-that (and (string-equal index-sha (arcdocdb.evidence:file-sha256 index-path))
                            (string-equal catalogue-sha (arcdocdb.evidence:file-sha256 catalogue-path)))
                       :snapshot root "Indice/catalogo cambiati durante l'audit.")
          (list :schema-version 1 :kind :command-archive-audit :status :ok :archive (namestring root)
                :indexed-files (hash-table-count indexed) :actual-files (hash-table-count actual)
                :indexed-bytes total :processes processes :index-sha256 index-sha :catalogue-sha256 catalogue-sha
                :origins-compared nil :closed-inventory t :read-eval nil :eof-required t
                :limits (list :plain-bytes +plain-limit+ :gzip-bytes +gzip-limit+
                              :process-expanded-bytes +expanded-limit+ :entries +inventory-limit+
                              :directory-depth +directory-depth-limit+ :directory-enumeration-not-prebounded t
                              :per-file-local-observation t
                              :atomic-publication nil :result-or-gate-inference nil :mcdc-claim nil)))))))

(defun write-data-new (path data &optional trailing)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error)
    (write data :stream stream :pretty t) (terpri stream)
    (when trailing (write trailing :stream stream) (terpri stream))))

(defun write-text-new (path text)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error)
    (write-string text stream)))

(defun write-bytes-new (path bytes)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
    (write-sequence bytes stream)))

(defun read-bytes (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (ensure-that (= (length bytes) (read-sequence bytes stream)) :fixture path "Fixture accorciata.")
      bytes)))

(defun fresh-directory (path)
  (let ((directory (uiop:ensure-directory-pathname path)))
    (ensure-that (not (probe-file directory)) :destination-exists directory "Directory deve essere nuova.")
    (sb-posix:mkdir (namestring directory) #o700)
    directory))

(defun fixture-index (root paths processes)
  (list :schema-version 1 :kind :original-command-archive :metadata-policy :read-without-result-inference
        :processes processes :files
        (loop for relative in paths for path = (merge-pathnames relative root)
              collect (list :path relative :source "/origin-not-required/archived"
                            :bytes (arcdocdb.evidence:file-bytes path)
                            :sha256 (arcdocdb.evidence:file-sha256 path)))))

(defun fixture-catalogue ()
  (list :schema-version 1 :kind :evidence-catalog :pending nil :entries
        (list (list :kind :original-command-archive :artifact "archive-index.lisp"
                    :artifact-schema-version 1 :artifact-kind :original-command-archive))))

(defun fixture-process (label relative status code consistency)
  (list :label label :record-path relative :command (list "fixture" label)
        :status status :exit-code code :source-consistency consistency))

(defun positive-fixture (root)
  (let* ((plain (fixture-process "plain" "processes/plain/report.lisp" :ok 0 :stable))
         (compressed (fixture-process "gzip" "processes/gzip/report.lisp" :error 1 :changed))
         (original (merge-pathnames "processes/gzip/original.lisp" root))
         (payload (merge-pathnames "processes/gzip/report.lisp.gz" root)))
    (write-data-new (merge-pathnames (getf plain :record-path) root) plain)
    (write-data-new original compressed)
    (let ((process (sb-ext:run-program "gzip" (list "-c" (namestring original))
                                      :search t :wait t :input nil :output payload
                                      :if-output-exists :error :error :stream)))
      (unwind-protect
           (ensure-that (and (eq :exited (sb-ext:process-status process))
                             (eql 0 (sb-ext:process-exit-code process)))
                        :fixture payload "Preparazione gzip fallita.")
        (when (sb-ext:process-error process)
          (with-open-file (out (merge-pathnames "prepare-gzip.stderr.log" root) :direction :output :if-exists :error)
            (loop for line = (read-line (sb-ext:process-error process) nil nil) while line do (write-line line out))))
        (sb-ext:process-close process)))
    (write-data-new (merge-pathnames (getf compressed :record-path) root)
                    (list :schema-version 1 :kind :compressed-evidence :codec :gzip :payload "report.lisp.gz"
                          :uncompressed-bytes (arcdocdb.evidence:file-bytes original)
                          :uncompressed-sha256 (arcdocdb.evidence:file-sha256 original)
                          :compressed-bytes (arcdocdb.evidence:file-bytes payload)
                          :compressed-sha256 (arcdocdb.evidence:file-sha256 payload)))
    (write-bytes-new (merge-pathnames "raw/data.bin" root) #(10 20 30))
    (write-text-new (merge-pathnames "raw/.hidden.log" root) "hidden fixture")
    (let ((index (fixture-index root '("processes/plain/report.lisp" "processes/gzip/original.lisp"
                                      "processes/gzip/report.lisp" "processes/gzip/report.lisp.gz"
                                      "prepare-gzip.stderr.log" "raw/data.bin" "raw/.hidden.log")
                                (list plain compressed))))
      (write-data-new (merge-pathnames "archive-index.lisp" root) index)
      (write-data-new (merge-pathnames "catalogo.lisp" root) (fixture-catalogue))
      index)))

(defun eval-fixture-text (marker)
  (format nil "#.(progn (with-open-file (out ~S :direction :output :if-exists :error) (write-line \"EVALUATED\" out)) '(:schema-version 1))~%"
          (namestring marker)))

(defun variant-fixture (positive root variant marker)
  (let* ((index (copy-tree (read-data (merge-pathnames "archive-index.lisp" positive) +plain-limit+)))
         (catalogue (fixture-catalogue)) (data-entry (find "raw/data.bin" (getf index :files)
                                                         :key (lambda (entry) (getf entry :path)) :test #'equal)))
    (dolist (entry (getf index :files))
      (let* ((relative (getf entry :path)) (destination (merge-pathnames relative root)))
        (cond
          ((and (eq variant :directory-symlink) (uiop:string-prefix-p "raw/" relative)))
          ((and (eq variant :missing) (equal relative "raw/data.bin")))
          ((and (eq variant :corrupt) (equal relative "raw/data.bin")) (write-bytes-new destination #(11 20 30)))
          ((and (eq variant :symlink) (equal relative "raw/data.bin"))
           (ensure-directories-exist destination)
           (sb-posix:symlink (namestring (merge-pathnames relative positive)) (namestring destination)))
          ((and (member variant '(:report-read-eval :report-trailing)) (equal relative "processes/plain/report.lisp"))
           (if (eq variant :report-read-eval) (write-text-new destination (eval-fixture-text marker))
               (write-data-new destination (first (getf index :processes)) '(:trailing t)))
           (setf (getf entry :bytes) (arcdocdb.evidence:file-bytes destination)
                 (getf entry :sha256) (arcdocdb.evidence:file-sha256 destination)))
          (t (write-bytes-new destination (read-bytes (merge-pathnames relative positive)))))))
    (when (eq variant :directory-symlink)
      (sb-posix:symlink (namestring (merge-pathnames "raw/" positive))
                        (namestring (merge-pathnames "raw" root))))
    (case variant
      (:extra (write-text-new (merge-pathnames ".unindexed" root) "extra"))
      (:absolute (setf (getf data-entry :path) (namestring (merge-pathnames "raw/data.bin" positive))))
      (:escape (setf (getf data-entry :path) "../positive/raw/data.bin"))
      (:duplicate (push (copy-tree data-entry) (getf index :files)))
      (:bytes (incf (getf data-entry :bytes)))
      (:process-command (setf (getf (first (getf index :processes)) :command) '("different-command")))
      (:process-status (setf (getf (first (getf index :processes)) :status) :error))
      (:process-exit (setf (getf (first (getf index :processes)) :exit-code) 99))
      (:process-source (setf (getf (first (getf index :processes)) :source-consistency) :changed))
      (:process-duplicate (push (copy-tree (first (getf index :processes))) (getf index :processes)))
      (:catalogue-pending (setf (getf catalogue :pending) t))
      (:catalogue-entries (push (copy-tree (first (getf catalogue :entries))) (getf catalogue :entries)))
      (:index-schema (setf (getf index :schema-version) 2))
      ((:plain-budget :gzip-budget)
       (let* ((gzip (eq variant :gzip-budget))
              (path (merge-pathnames (if gzip "unindexed.gz" "unindexed.log") root)))
         (with-open-file (stream path :direction :output :if-exists :error :element-type '(unsigned-byte 8))
           (file-position stream (if gzip +gzip-limit+ +plain-limit+)) (write-byte 0 stream))))
      (otherwise nil))
    (if (eq variant :index-read-eval)
        (write-text-new (merge-pathnames "archive-index.lisp" root) (eval-fixture-text marker))
        (write-data-new (merge-pathnames "archive-index.lisp" root) index
                        (when (eq variant :index-trailing) '(:trailing t))))
    (write-data-new (merge-pathnames "catalogo.lisp" root) catalogue)))

(defun read-cli-output (path)
  (let ((*read-eval* nil) (*readtable* (copy-readtable nil)))
    (with-open-file (stream path)
      (let ((data (read stream nil :eof)))
        (ensure-that (and (not (eq data :eof)) (eq (read stream nil :eof) :eof))
                     :self-test path "Rapporto CLI unico richiesto.")
        (check-plist data path)))))

(defun invoke-case (root label archive reason marker)
  (let* ((stdout (merge-pathnames (format nil "logs/~A.stdout.log" label) root))
         (stderr (merge-pathnames (format nil "logs/~A.stderr.log" label) root)))
    (ensure-directories-exist stdout)
    (let* ((process (sb-ext:run-program (namestring sb-ext:*runtime-pathname*)
                                      (list "--noinform" "--no-userinit" "--no-sysinit" "--script"
                                            (namestring *checker-source*) "--archive" (namestring archive))
                                      :wait t :input nil :output stdout :error stderr
                                      :if-output-exists :error :if-error-exists :error))
           (code (sb-ext:process-exit-code process))
           (exited (eq :exited (sb-ext:process-status process)))
           (report (unwind-protect (read-cli-output stdout) (sb-ext:process-close process))))
      (ensure-that (and exited (eql code (if reason 1 0))
                        (eq :command-archive-audit (getf report :kind))
                        (eq (if reason :failed :ok) (getf report :status))
                        (or (null reason) (eq reason (getf report :reason)))
                        (not (probe-file marker)))
                   :self-test archive "Exit, classificazione o side effect inatteso: ~S." report)
      (list :case label :expected-reason reason :observed-exit-code code :status :ok
            :stdout (namestring stdout) :stderr (namestring stderr) :report report))))

(defun self-test (argument)
  "Fixture e log nuovi conservati; nessuna modifica/cancellazione di archivi pubblicati."
  (let* ((root (fresh-directory (merge-pathnames (uiop:ensure-directory-pathname argument) (uiop:getcwd))))
         (positive (fresh-directory (merge-pathnames "positive/" root)))
         (marker (merge-pathnames "reader-eval-marker" root))
         (cases nil))
    (positive-fixture positive)
    (push (invoke-case root "positive" positive nil marker) cases)
    (dolist (definition '((:corrupt :sha256) (:bytes :bytes) (:missing :missing-file)
                          (:extra :inventory) (:absolute :relative-path) (:escape :relative-path)
                          (:duplicate :duplicate-file) (:symlink :nonregular-path)
                          (:directory-symlink :nonregular-path)
                          (:process-command :process-metadata) (:process-status :process-metadata)
                          (:process-exit :process-metadata) (:process-source :process-metadata)
                          (:process-duplicate :process-label) (:catalogue-pending :catalogue-schema)
                          (:catalogue-entries :catalogue-schema) (:index-schema :index-schema)
                          (:plain-budget :file-budget) (:gzip-budget :file-budget)
                          (:index-read-eval :evidence-read) (:index-trailing :evidence-read)
                          (:report-read-eval :evidence-read) (:report-trailing :evidence-read)))
      (let* ((label (string-downcase (symbol-name (first definition))))
             (archive (fresh-directory (merge-pathnames (concatenate 'string label "/") root))))
        (variant-fixture positive archive (first definition) marker)
        (push (invoke-case root label archive (second definition) marker) cases)
        (write-data-new (merge-pathnames (format nil "cases/~A.lisp" label) root) (first cases))))
    (let ((report (list :schema-version 1 :kind :command-archive-self-test :status :ok :checks (length cases)
                        :cases (nreverse cases) :root (namestring root) :originals-overwritten nil
                        :product-campaigns nil :limits '(:local-fixtures :no-gate-or-mcdc-claim))))
      (write-data-new (merge-pathnames "report.lisp" root) report)
      report)))

(defun main ()
  (let ((arguments (rest sb-ext:*posix-argv*)))
    (handler-case
        (progn
          (ensure-that (and (= (length arguments) 2)
                            (member (first arguments) '("--archive" "--self-test") :test #'equal))
                       :arguments "CLI" "Uso: --archive DIR oppure --self-test DIR-NUOVA.")
          (write (if (equal (first arguments) "--self-test")
                     (self-test (second arguments)) (audit-archive (second arguments))) :pretty t)
          (terpri) (sb-ext:exit :code 0))
      (invalid-archive (condition)
        (write (list :schema-version 1 :kind :command-archive-audit :status :failed
                     :reason (invalid-reason condition) :path (princ-to-string (invalid-path condition))
                     :diagnostic (invalid-detail condition)) :pretty t)
        (terpri) (sb-ext:exit :code 1))
      (error (condition)
        (write (list :schema-version 1 :kind :command-archive-audit :status :failed
                     :reason :tool-error :diagnostic (princ-to-string condition)) :pretty t)
        (terpri) (sb-ext:exit :code 1)))))

(main)
