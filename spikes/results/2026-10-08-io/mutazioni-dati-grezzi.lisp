(defun verifica-record-edit (buffer start end &key (version 0)
                            (max-chiusi +default-list-budget+)
                            (max-rimossi +default-list-budget+)
                            (max-esiti +default-list-budget+)
                            (max-bytes +metadata-max-bytes+))
