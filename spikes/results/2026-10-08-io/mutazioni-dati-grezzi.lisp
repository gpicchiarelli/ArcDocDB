    (dotimes (i 256)
      (let ((crc i))
        (dotimes (bit 8)
          (setf crc (logxor (ash crc -1)
                           (if (oddp crc) +crc32c-polynomial+ 0))))
        (setf (aref tables 0 i) crc)))
    (dotimes (row 7)
      (dotimes (i 256)
        (let ((crc (aref tables row i)))
          (setf (aref tables (1+ row) i)
                (logxor (ash crc -8) (aref tables 0 (logand crc 255)))))))
    tables))

