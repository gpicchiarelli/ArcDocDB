                 (= (leggi-u32 buffer (+ start +stamp-offset+))
                    (leggi-u32 put-buffer (+ put-start +stamp-offset+)))
                 (= (leggi-u32 buffer (+ start +stamp-offset+ 4))
                    (leggi-u32 put-buffer (+ put-start +stamp-offset+ 4)))
                 (u64-equal-p buffer vs csn))
