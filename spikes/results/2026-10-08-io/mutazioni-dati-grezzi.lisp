;;; REQ: REQ-FOR-002
(declaim (ftype (function (integer index) (values u16 &optional)) versione-supportata))
(defun versione-supportata (version offset)
  \"Pre: VERSION intero. Post: layout 1 o 2 esplicitamente riconosciuto.
