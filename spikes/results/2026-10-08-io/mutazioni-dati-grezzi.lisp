;;; REQ: REQ-FOR-003
(declaim (ftype (function (keyword u8) boolean) log-record-p))
(defun log-record-p (log-kind kind)
  \"Pre: log-kind dichiarato. Post: tipo ammesso nel log prima del SEAL.
Segnala INVALID-ARGUMENT per un log sconosciuto.\"
  (case log-kind
