;;; REQ: REQ-AFF-009 REQ-AFF-008 REQ-AFF-017 REQ-FOR-003
(defpackage #:arcdocdb.recovery.scan
  (:use #:cl)
  (:import-from #:arcdocdb.binary
                #:octets #:index #:u32 #:u64 #:check-range #:leggi-u64)
