Segnala INVALID-ARGUMENT per un log sconosciuto.\"
  (case log-kind
    (:segment (not (null (member kind '(1 2 4)))))
    (:control (= kind +edit+))
    (:multiserie (= kind +decision+))
    (otherwise (error 'invalid-argument :reason :log-kind))))

