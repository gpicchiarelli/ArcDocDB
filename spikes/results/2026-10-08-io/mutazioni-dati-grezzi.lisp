                   (incf done progress)
                   (incf (file-written file) progress)))
      (sb-posix:syscall-error (c)
        (fallisci file :write :io-syscall (sb-posix:syscall-errno c) done)))
    (unless (= done count) (error 'invariant-violation :reason :io-incomplete-write))
