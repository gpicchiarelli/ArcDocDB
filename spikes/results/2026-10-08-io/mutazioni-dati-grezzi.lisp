                #:+header-bytes+ #:+seal-bytes+ #:+seal+ #:+type-offset+
                #:+seal-file-id-offset+ #:+seal-batch-start-offset+
                #:+seal-durable-offset+ #:format-limits #:u64-equal-p
                #:verifica-cornice #:verifica-lotto)
