;;; REQ: REQ-FOR-001 REQ-FOR-002
(defconstant +segment-header-bytes+ 64)
(defconstant +segment-magic-low+ #x44435241) ; ARCD, little-endian
(defconstant +segment-magic-high+ #x31474553) ; SEG1 anche per versione 2
