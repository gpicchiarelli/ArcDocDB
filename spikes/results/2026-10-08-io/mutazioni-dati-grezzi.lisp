    (unless (and (= (leggi-u64 buffer (+ value-start +seal-file-id-offset+)) file-id)
                 (= (leggi-u64 buffer (+ value-start +seal-batch-start-offset+)) batch-start)
                 (<= durable batch-start)
                 (= (leggi-u32 buffer (+ value-start +seal-count-offset+)) count)
