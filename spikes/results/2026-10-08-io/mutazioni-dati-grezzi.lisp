;;; REQ: REQ-FOR-001 REQ-FOR-002 REQ-FOR-003 REQ-AFF-008
(defpackage #:arcdocdb.storage.format
  (:use #:cl)
  (:import-from #:arcdocdb.binary #:octets #:index #:u8 #:u16 #:u32 #:u64
                #:check-range #:leggi-u16 #:leggi-u32 #:scrivi-u16 #:scrivi-u32
