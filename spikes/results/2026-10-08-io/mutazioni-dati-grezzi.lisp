Segnala INVALID-ARGUMENT se fuori range.\"
  (check-range buffer start (+ start 2))
  (logior (aref buffer start) (ash (aref buffer (+ start 1)) 8)))

;;; REQ: REQ-FOR-003
(defun leggi-u32 (buffer start)
