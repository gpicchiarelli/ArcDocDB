    (let ((version (versione-supportata
                    (leggi-u16 buffer (+ start +segment-version-offset+)) start))
          (origin (aref buffer (+ start +segment-origin-offset+))))
      (unless (or (= origin +writer-origin+) (= origin +compaction-origin+))
