                 (<= durable batch-start)
                 (= (leggi-u32 buffer (+ value-start +seal-count-offset+)) count)
                 (= (leggi-u32 buffer (+ value-start +seal-checksum-offset+)) checksum))
      (error 'corruption-detected :reason :seal-mismatch :offset record-start))
