    (loop repeat (floor (- end start) 8)
          do (let ((word (logxor crc
                                (aref buffer i)
                                (ash (aref buffer (+ i 1)) 8)
                                (ash (aref buffer (+ i 2)) 16)
                                (ash (aref buffer (+ i 3)) 24))))
               (setf crc
