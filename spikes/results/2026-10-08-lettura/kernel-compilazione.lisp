                                                (= 1 (ldb (byte 8 56) metadati))
                                                (= 16 (ldb (byte 8 24) metadati))
                                                (<= (+ offset 16) (length arena))
                                                (stessa-chiave-p chiave arena offset))))
                                    (declare (type u64 csn-letto posizione-letta
                                                   metadati fine-letta)
