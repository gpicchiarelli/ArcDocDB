  :ok)
(defun test-req-idx-003-workers ()
  (let ((before (sb-thread:list-all-threads)))
    (assert (handler-case
                (progn (workers-con-join (list (lambda () (error 'limite-indice :motivo :fixture))
                                              (lambda () :completed))) nil)
              (limite-indice (c) (eq (limite-motivo c) :fixture))))
