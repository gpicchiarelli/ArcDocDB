      (when (and (zerop (mod id 256)) (>= (get-internal-real-time) deadline)) (return))
      (scrivi-chiave buffer id)
      (unless (inserisci-pattern i buffer (1+ id)) (error \"INSERT benchmark non nuovo.\"))
      (incf count) (setf sink (logxor sink (1+ id))))
