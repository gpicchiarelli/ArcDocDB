            (progn (incf (indice-split i)) (incf (indice-split-ticks i) ticks)
                   (setf (indice-split-max-ticks i) (max ticks (indice-split-max-ticks i))))
            (progn (incf (indice-rebuild i)) (incf (indice-rebuild-ticks i) ticks)
