                        (when (eq stato :hit)
                          (setf (aref destinazione 0) csn
                                (aref destinazione 1) posizione
                                (aref destinazione 2) lunghezza
                                (aref destinazione 3) fine))
                        (return-from leggi (values stato tentativo))))))))))
      (if (or after-fragment after-fields)
          (lettura t)
          (lettura nil)))))
