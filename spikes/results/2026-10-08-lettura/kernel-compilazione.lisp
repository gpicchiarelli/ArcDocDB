                                            lunghezza (ldb (byte 24 32) metadati)
                                            fine fine-letta stato :hit)
                                      (return-from sondaggio nil))))))))))
                    ;; Anche un miss deve appartenere alla root ancora corrente.
                    (sb-thread:barrier (:read))
