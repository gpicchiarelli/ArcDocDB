                       (when (zerop (mod step 16)) (sb-thread:thread-yield)))
                     :writer-completed) (nreverse readers)))))
      (scrivi-chiave key 0) (verifica-valore i key 601)
      (assert (plusp (indice-split i)))
      (list :words words :status :ok :workers results))))
