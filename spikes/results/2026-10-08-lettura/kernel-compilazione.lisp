(defpackage #:arcdocdb.spk01.lettura-buffer
  (:use #:cl)
  (:import-from #:arcdocdb.spk01
                #:indice #:indice-root #:ottetti #:parole #:u64
                #:radice #:radice-generazione #:frammento
                #:frammento-capacita #:frammento-larghezza #:frammento-slots
