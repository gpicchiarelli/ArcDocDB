                      (declare (type fixnum capacita))
                      (block sondaggio
                        (dotimes (gruppo (ceiling capacita +gruppo+))
                          (declare (type fixnum gruppo))
                          (dotimes (n +gruppo+)
                            (declare (type fixnum n))
