               (eq :stable (getf record :source-consistency))))
  (assert (equal (getf record :source-blobs-before) (getf record :source-blobs-after)))
  (assert (= 17 (length rows))) (assert (= 3 (length inventory)))
  (assert (search \"95 test recovery superati.\" (getf record :stdout)))
