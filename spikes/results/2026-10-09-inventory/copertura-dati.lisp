          :raw-artifact \"copertura-dati.lisp\" :process-command-record *command-path*
          :input-hashes inputs :dedicated-tests 13 :recovery-tests 95
          :source-of-counts :original-sb-cover-html-index-rows
          :state-and-per-file-html-cross-check t :per-file inventory
          :inventory-totals (totals inventory) :full-recovery-totals (totals rows)
