  ";;;; Packaging di dati gia raccolti; nessun caricamento di prodotto o test.
(require :asdf)
(load \"tools/evidence-storage.lisp\")
(defparameter *coverage-directory* \"spikes/out/inventory-coverage-final/\")
(defparameter *command-path* \"spikes/out/4000528743-command-79670-0/report.lisp\")
(defparameter *destination* \"spikes/out/inventory-coverage-published/\")
(defparameter *helper-path* \"spikes/out/inventory-coverage-pack.lisp\")
(defparameter *inventory-names*
  '(\"inventory-build.lisp\" \"inventory-query.lisp\" \"inventory-types.lisp\"))

(defun text-file (path)
  (uiop:read-file-string path :external-format :utf-8))

(defun data-file (path)
  (with-open-file (stream path :external-format :utf-8)
    (let ((*read-eval* nil) (*package* (find-package :cl-user)))
      (let ((form (read stream)))
        (assert (eq :eof (read stream nil :eof))) form))))

(defun git-blob (path)
  (string-trim '(#\\Space #\\Newline #\\Return)
               (uiop:run-program (list \"git\" \"hash-object\" \"--\" path) :output :string)))

(defun original-bytes (path)
  (with-open-file (stream path :element-type '(unsigned-byte 8))
    (let ((bytes (make-array (file-length stream) :element-type '(unsigned-byte 8))))
      (assert (= (length bytes) (read-sequence bytes stream))) bytes)))

(defun raw-file (path)
  (let ((content (text-file path)) (bytes (original-bytes path)))
    (assert (equalp bytes (sb-ext:string-to-octets content :external-format :utf-8)))
    (list :path path :bytes (length bytes) :git-blob (git-blob path)
          :sha256 (arcdocdb.evidence:file-sha256 path) :content content)))

(defun cells-after (text position count)
  (loop repeat count for start = (search \"<td>\" text :start2 position)
        for end = (and start (search \"</td>\" text :start2 (+ start 4)))
        do (assert (and start end)) (setf position (+ end 5))
        collect (string-trim '(#\\Space) (subseq text (+ start 4) end))))

(defun index-rows (html)
  (let ((cursor 0) (rows nil) (marker \"<td class='text-cell'><a href='\"))
    (loop for found = (search marker html :start2 cursor) while found do
      (let* ((href-start (+ found (length marker))) (href-end (position #\\' html :start href-start))
             (name-start (+ href-end 2)) (name-end (search \"</a>\" html :start2 name-start))
             (row-start (search \"<tr class=\" html :end2 found :from-end t))
             (row-end (search \"</tr>\" html :start2 name-end))
             (cells (cells-after html name-end 6)))
        (assert (and row-start row-end))
        (push (list :path (subseq html name-start name-end)
                    :html (subseq html href-start href-end)
                    :expressions (mapcar #'parse-integer (subseq cells 0 2))
                    :branches (mapcar #'parse-integer (subseq cells 3 5))
                    :raw-index-row (subseq html row-start (+ row-end 5))) rows)
        (setf cursor (+ row-end 5))))
    (nreverse rows)))

(defun html-metric (html kind)
  (let ((position (search (format nil \"<td>~A</td>\" kind) html)))
    (assert position)
    (mapcar #'parse-integer (cells-after html (+ position (length kind) 9) 2))))

(defun state-metrics (entry)
  (let ((paths (second entry)) (bits (cddr entry))
        (expressions-covered 0) (expressions-total 0)
        (branches-covered 0) (branches-total 0) (missing nil))
    (assert (= (length paths) (length bits)))
    (loop for path across paths for bit across bits do
      (if (member (first path) '(:then :else))
          (progn (incf branches-total) (incf branches-covered bit)
                 (when (zerop bit) (push path missing)))
          (progn (incf expressions-total) (incf expressions-covered bit))))
    (values (list expressions-covered expressions-total)
            (list branches-covered branches-total) (nreverse missing))))

(defun checked-row (row state)
  (let* ((path (concatenate 'string \"src/recovery/\" (getf row :path)))
         (absolute (namestring (truename path)))
         (entry (assoc absolute state :test #'string=))
         (html (text-file (concatenate 'string *coverage-directory* (getf row :html)))))
    (assert entry)
    (multiple-value-bind (expressions branches missing) (state-metrics entry)
      (assert (equal expressions (getf row :expressions)))
      (assert (equal branches (getf row :branches)))
      (assert (equal expressions (html-metric html \"expression\")))
      (assert (equal branches (html-metric html \"branch\")))
      (append row (list :source-git-blob (git-blob path) :missing-branch-paths missing)))))

(defun totals (rows)
  (list :expressions-covered (loop for row in rows sum (first (getf row :expressions)))
        :expressions-total (loop for row in rows sum (second (getf row :expressions)))
        :branches-covered (loop for row in rows sum (first (getf row :branches)))
        :branches-total (loop for row in rows sum (second (getf row :branches)))))

(defun observed-input (path record)
  (let ((actual (git-blob path)))
    (dolist (key '(:source-blobs-before :source-blobs-after))
      (let ((entry (find path (getf record key) :key (lambda (item) (getf item :path))
                        :test #'string=)))
        (assert entry) (assert (equal actual (getf entry :git-blob)))))
    (list :path path :git-blob actual :record-before-after-current-match t)))

(defun write-data (path form)
  (with-open-file (stream path :direction :output :if-exists :error :external-format :utf-8)
    (let ((*print-readably* t) (*print-pretty* t))
      (write form :stream stream) (terpri stream))))

(defun verify-raw-bundle (path)
  (let ((bundle (data-file path)))
    (dolist (entry (append (getf bundle :raw-files) (list (getf bundle :packaging-helper))))
      (let ((original (getf entry :path)))
        (assert (equal (getf entry :git-blob) (git-blob original)))
        (assert (= (getf entry :bytes) (arcdocdb.evidence:file-bytes original)))
        (assert (equal (getf entry :sha256) (arcdocdb.evidence:file-sha256 original)))
        (assert (equalp (original-bytes original)
                        (sb-ext:string-to-octets (getf entry :content) :external-format :utf-8)))))
    t))

(let* ((record (data-file *command-path*))
       (index-path (concatenate 'string *coverage-directory* \"cover-index.html\"))
       (state-path (concatenate 'string *coverage-directory* \"coverage-state.lisp\"))
       (state (data-file state-path)) (rows (index-rows (text-file index-path)))
       (inventory (mapcar (lambda (row) (checked-row row state))
                          (remove-if-not (lambda (row) (member (getf row :path) *inventory-names*
                                                              :test #'string=)) rows)))
       (inputs (mapcar (lambda (path) (observed-input path record))
                      '(\"arcdocdb.asd\" \"src/recovery/manifest-package.lisp\"
                        \"src/recovery/inventory-types.lisp\" \"src/recovery/inventory-build.lisp\"
                        \"src/recovery/inventory-query.lisp\" \"tests/recovery/inventory-support.lisp\"
                        \"tests/recovery/inventory.lisp\" \"tools/foundation-coverage.lisp\")))
       (raw-paths (append (list state-path index-path)
                          (mapcar (lambda (row) (concatenate 'string *coverage-directory*
                                                             (getf row :html))) inventory)))
       (raw (mapcar #'raw-file raw-paths)) (helper (raw-file *helper-path*))
