(:SCHEMA-VERSION 1 :KIND :SOURCE-SUPPORT :LANGUAGE :COMMON-LISP :ORIGINAL-PATH
 "/tmp/arcdocdb-primary-evidence.lisp" :TEXT "(require :asdf)
(defun read-data (path)
  (let ((*read-eval* nil)) (with-open-file (stream path) (read stream))))
(defun save-data (path data)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))
(let* ((args (uiop:command-line-arguments)) (root (uiop:ensure-directory-pathname (pop args)))
       (base (merge-pathnames \"spikes/results/2026-10-09-primary-lookup/\" root))
       (catalog (merge-pathnames \"catalogo.lisp\" base)) (data (read-data catalog)))
  (unless (zerop (mod (length args) 3)) (error \"Tripla incompleta\"))
  (loop for (source stem kind) on args by #'cdddr
        for report = (merge-pathnames source root)
        for directory = (uiop:pathname-directory-pathname report)
        for name = (format nil \"~A.lisp\" stem)
        for auxiliary = (format nil \"~A-conservazione.lisp\" stem)
        for original = (read-data report)
        do (when (probe-file (merge-pathnames name base)) (error \"Artefatto presente: ~A\" name))
           (when (eq (getf original :kind) :compressed-evidence)
             (error \"Record compresso: usare gli strumenti di conservazione del repository\"))
           (uiop:copy-file report (merge-pathnames name base))
           (uiop:copy-file (merge-pathnames \"conservazione.lisp\" directory)
                           (merge-pathnames auxiliary base))
           (setf (getf data :entries)
                 (append (getf data :entries)
                         (list (list :kind (intern (string-upcase kind) :keyword) :artifact name
                                     :process-artifact auxiliary :variant :source-snapshot-in-record)))))
  (dolist (spec '((\"/tmp/arcdocdb-primary-evidence.lisp\" \"raccolta-sorgente.lisp\")
                  (\"/tmp/arcdocdb-primary-disassemble.lisp\" \"disassemblato-sorgente.lisp\")))
    (unless (probe-file (merge-pathnames (second spec) base))
      (save-data (merge-pathnames (second spec) base)
                 (list :schema-version 1 :kind :source-support :language :common-lisp
                       :original-path (first spec) :text (uiop:read-file-string (first spec))
                       :limits '(:filesystem-collection-only :no-product-function-execution)))
      (setf (getf data :entries)
            (append (getf data :entries)
                    (list (list :kind :source-support :artifact (second spec) :variant :verbatim-source-text))))))
  (save-data catalog data)
  (format t \"~&Catalogo: ~A; artefatti: ~D~%\" catalog (length (getf data :entries))))
"
 :LIMITS (:FILESYSTEM-COLLECTION-ONLY :NO-PRODUCT-FUNCTION-EXECUTION))
