(:SCHEMA-VERSION 1 :KIND :SOURCE-SUPPORT :LANGUAGE :COMMON-LISP :ORIGINAL-PATH
 "/tmp/arcdocdb-index-slots-flatten.lisp" :TEXT "(require :asdf)
(require :sb-posix)
(let* ((base #P\"/Users/gpicchiarelli/.codex/worktrees/orizzonte-csn/ArcDocDB/spikes/results/2026-10-09-index-slots/\")
       (catalog (merge-pathnames \"catalogo.lisp\" base))
       (data (let ((*read-eval* nil)) (with-open-file (stream catalog) (read stream)))))
  (uiop:copy-file catalog (merge-pathnames \"catalogo-prima-percorsi.lisp\" base))
  (dolist (entry (getf data :entries))
    (let ((artifact (getf entry :artifact)))
      (when (find #\\/ artifact)
        (let* ((stem (subseq artifact 0 (position #\\/ artifact)))
               (directory (merge-pathnames (format nil \"~A/\" stem) base))
               (report-name (format nil \"~A.lisp\" stem))
               (aux-name (format nil \"~A-conservazione.lisp\" stem)))
          (uiop:rename-file-overwriting-target (merge-pathnames \"report.lisp\" directory)
                                              (merge-pathnames report-name base))
          (uiop:rename-file-overwriting-target (merge-pathnames \"conservazione.lisp\" directory)
                                              (merge-pathnames aux-name base))
          (setf (getf entry :artifact) report-name (getf entry :process-artifact) aux-name)
          (sb-posix:rmdir (namestring directory))))))
  (setf (getf data :entries)
        (append (getf data :entries)
                (list (list :kind :historical-catalog :artifact \"catalogo-prima-percorsi.lisp\"
                            :variant :rejected-relative-paths))))
  (with-open-file (stream catalog :direction :output :if-exists :supersede)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))
"
 :LIMITS (:FILESYSTEM-COLLECTION-ONLY :NO-PRODUCT-FUNCTION-EXECUTION))
