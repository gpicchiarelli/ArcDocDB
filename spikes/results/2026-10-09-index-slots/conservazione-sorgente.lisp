(:SCHEMA-VERSION 1 :KIND :SOURCE-SUPPORT :LANGUAGE :COMMON-LISP :ORIGINAL-PATH
 "/tmp/arcdocdb-index-slots-evidence.lisp" :TEXT "(require :asdf)
(defun read-data (path)
  (let ((*read-eval* nil)) (with-open-file (stream path) (read stream))))
(defun save-data (path data)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (let ((*print-readably* t)) (write data :stream stream :pretty t) (terpri stream))))
(let* ((args (uiop:command-line-arguments))
       (root (uiop:ensure-directory-pathname (pop args)))
       (base (merge-pathnames \"spikes/results/2026-10-09-index-slots/\" root))
       (catalog (merge-pathnames \"catalogo.lisp\" base)) (data (read-data catalog)))
  (unless (zerop (mod (length args) 3)) (error \"Tripla incompleta\"))
  (loop for (source stem kind) on args by #'cdddr
        for report = (merge-pathnames source root)
        for directory = (uiop:pathname-directory-pathname report)
        for destination = (merge-pathnames (format nil \"~A/\" stem) base)
        do (unless (probe-file report) (error \"Report assente: ~A\" report))
           (when (probe-file destination) (error \"Artefatto presente: ~A\" destination))
           (ensure-directories-exist (merge-pathnames \"report.lisp\" destination))
           ;; Nome e directory conservati: anche il payload gzip e la conservazione rimangono validi.
           (dolist (file (uiop:directory-files directory))
             (uiop:copy-file file (merge-pathnames (file-namestring file) destination)))
           (setf (getf data :entries)
                 (append (getf data :entries)
                         (list (list :kind (intern (string-upcase kind) :keyword)
                                     :artifact (format nil \"~A/report.lisp\" stem)
                                     :variant :source-snapshot-in-record)))))
  (dolist (spec '((\"/tmp/arcdocdb-index-slots-disassemble.lisp\" \"disassemblato-sorgente.lisp\")
                  (\"/tmp/arcdocdb-index-slots-evidence.lisp\" \"conservazione-sorgente.lisp\")))
    (unless (probe-file (merge-pathnames (second spec) base))
      (save-data (merge-pathnames (second spec) base)
                 (list :schema-version 1 :kind :source-support :language :common-lisp
                       :original-path (first spec) :text (uiop:read-file-string (first spec))
                       :limits '(:static-inspection-only :no-product-function-execution)))
      (setf (getf data :entries)
            (append (getf data :entries)
                    (list (list :kind :source-support :artifact (second spec)
                                :variant :verbatim-source-text))))))
  (save-data catalog data)
  (format t \"~&Catalogo: ~A; artefatti: ~D~%\" catalog (length (getf data :entries))))
"
 :LIMITS (:STATIC-INSPECTION-ONLY :NO-PRODUCT-FUNCTION-EXECUTION))
