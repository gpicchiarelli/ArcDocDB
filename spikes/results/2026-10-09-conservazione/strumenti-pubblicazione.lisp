(:SCHEMA-VERSION 1 :KIND :PUBLICATION-TOOL-SOURCE :STATUS :RECORDED :INITIAL
 "(require :asdf)
(load \"tools/evidence-storage.lisp\")
(defparameter *target* #P\"spikes/results/2026-10-09-conservazione/\")
(defun save-data (data path)
  (with-open-file (s path :direction :output :if-exists :error :external-format :utf-8)
    (let ((*print-readably* t)) (write data :stream s :pretty t) (terpri s))))
(defun copy-proof (source target)
  (if (probe-file target)
      (unless (string= (arcdocdb.evidence:file-sha256 source)
                       (arcdocdb.evidence:file-sha256 target))
        (error \"Il file conservato differisce: ~A\" target))
      (uiop:copy-file source target)))
(let* ((args (uiop:command-line-arguments)) (catalog (merge-pathnames \"catalogo.lisp\" *target*))
       (data (if (probe-file catalog) (arcdocdb.evidence:read-evidence catalog)
                 (list :schema-version 1 :kind :evidence-catalog :date \"2026-10-09\"
                       :subject \"Conservazione compressa senza perdita\" :entries nil))))
  (ensure-directories-exist catalog)
  (unless (evenp (length args)) (error \"Argomenti: source target-name...\"))
  (loop for (source name) on args by #'cddr
        do (unless (and (stringp name) (not (find #\\/ name))) (error \"Nome non leaf\"))
           (copy-proof source (merge-pathnames name *target*))
           (unless (find name (getf data :entries) :key (lambda (e) (getf e :artifact))
                         :test #'string=)
             (setf (getf data :entries)
                   (append (getf data :entries)
                           (list (list :artifact name :variant name :source source))))))
  (let ((temporary (merge-pathnames \"catalogo.tmp\" *target*)))
    (save-data data temporary)
    (uiop:rename-file-overwriting-target temporary catalog))
  (write (list :schema-version 1 :kind :evidence-publication :status :ok
               :catalog (namestring catalog) :entries (length (getf data :entries))))
  (terpri))
