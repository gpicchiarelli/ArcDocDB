 :CURRENT "(require :asdf)
(load \"tools/evidence-storage.lisp\")
(defparameter *target* (merge-pathnames \"spikes/results/2026-10-09-conservazione/\" (truename \"./\")))
(defun save-data (data path)
  (with-open-file (s path :direction :output :if-exists :error :external-format :utf-8)
    (let ((*print-readably* t)) (write data :stream s :pretty t) (terpri s))))
(defun copy-proof (source target)
  (if (probe-file target)
      (unless (string= (arcdocdb.evidence:file-sha256 source)
                       (arcdocdb.evidence:file-sha256 target))
        (error \"Il file conservato differisce: ~A\" target))
      (uiop:copy-file source target))
  (when (equal (pathname-type source) \"lisp\")
    (let ((data (let ((*read-eval* nil))
                  (with-open-file (s source) (read s)))))
      (when (eq (getf data :kind) :compressed-evidence)
        (arcdocdb.evidence:call-with-evidence-bytes source (lambda (path) (declare (ignore path))))
        (copy-proof (merge-pathnames (getf data :payload)
                                    (uiop:pathname-directory-pathname source))
                    (merge-pathnames (getf data :payload)
                                     (uiop:pathname-directory-pathname target)))))))
(let* ((args (uiop:command-line-arguments)) (catalog (merge-pathnames \"catalogo.lisp\" *target*))
       (data (if (probe-file catalog) (arcdocdb.evidence:read-evidence catalog)
                 (list :schema-version 1 :kind :evidence-catalog :date \"2026-10-09\"
                       :subject \"Conservazione compressa senza perdita\" :entries nil))))
  (ensure-directories-exist catalog)
  (unless (evenp (length args)) (error \"Argomenti: source target-name...\"))
  (loop for (source name) on args by #'cddr
        do (unless (and (stringp name) (not (find #\\/ name))) (error \"Nome non leaf\"))
           (copy-proof source (merge-pathnames name *target*))
           (unless (find name (getf data :entries) :key (lambda (e) (getf e :artifact))
                         :test #'string=)
             (setf (getf data :entries)
                   (append (getf data :entries)
                           (list (list :artifact name :variant name :source source))))))
  (let ((temporary (merge-pathnames \"catalogo.tmp\" *target*)))
    (save-data data temporary)
    (uiop:rename-file-overwriting-target temporary catalog))
  (write (list :schema-version 1 :kind :evidence-publication :status :ok
               :catalog (namestring catalog) :entries (length (getf data :entries))))
  (terpri))
"
 :PRESERVER-INITIAL "(require :asdf)
(load \"tools/evidence-storage.lisp\")
(defun persist (name data)
  (let ((path (merge-pathnames name #P\"spikes/results/2026-10-09-conservazione/\")))
    (unless (probe-file path)
      (with-open-file (s path :direction :output :if-exists :error :external-format :utf-8)
        (let ((*print-readably* t)) (write data :stream s :pretty t) (terpri s))))
    (write-line (namestring path))))
(let* ((source (uiop:read-file-string \"tools/check-evidence-storage.lisp\"))
       (start (search \"  (let* ((tiny \" source))
       (end (search \"  (let* ((text (format nil\" source :start2 start))
       (previous (concatenate 'string (subseq source 0 start) (subseq source end)))
       (marker \":ok)) cases))))\") (position (search marker previous))
       (original (concatenate 'string (subseq previous 0 position)
                              \":ok)) cases)))\" (subseq previous (+ position (length marker)))))
  (let* ((failure (arcdocdb.evidence:read-evidence
                   \"spikes/results/2026-10-09-conservazione/selftest-eof-fallito.lisp\"))
         (expected (getf (find \"tools/check-evidence-storage.lisp\"
                              (getf failure :source-blobs-before)
                              :key (lambda (x) (getf x :path)) :test #'string=) :git-blob))
         (observed (with-input-from-string (s original)
                     (string-trim '(#\\Newline #\\Return)
                                  (uiop:run-program '(\"git\" \"hash-object\" \"--stdin\")
                                                    :input s :output :string :external-format :utf-8)))))
    (unless (string= expected observed) (error \"Ricostruzione sorgente EOF non coincide.\"))
    (persist \"sorgente-selftest-eof.lisp\"
             (list :schema-version 1 :kind :source-snapshot :status :ok
                   :path \"tools/check-evidence-storage.lisp\" :git-blob expected :source original
                   :method :reconstructed-and-verified-against-recorded-git-blob))))
(persist \"strumenti-pubblicazione.lisp\"
         (list :schema-version 1 :kind :publication-tool-source :status :recorded
               :initial (uiop:read-file-string \"/tmp/arcdocdb-publish-compaction-initial.lisp\")
               :current (uiop:read-file-string \"/tmp/arcdocdb-publish-compaction.lisp\")))
(persist \"compilazione-agente.lisp\"
         (list :schema-version 1 :kind :imported-agent-compilation :status :recorded
               :original (let ((*read-eval* nil))
                           (with-open-file (s \"/private/tmp/arcdocdb-evidence-compile.NgoTgu/result.lisp\")
                             (read s)))
               :limits '(:original-metadata-only :compiler-command-not-collected
                         :source-hash-not-collected :before-parent-integration)))
"
