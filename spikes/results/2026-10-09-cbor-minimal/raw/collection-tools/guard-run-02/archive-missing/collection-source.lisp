;;;; Conserva file originali, senza riscrivere i registri o dedurre risultati.
(require :asdf)
(load "tools/evidence-storage.lisp")
(defpackage #:cbor-minimal.collection (:use #:cl))
(in-package #:cbor-minimal.collection)

(defun read-one (path)
  (with-open-file (stream path :external-format :utf-8)
    (let* ((*read-eval* nil) (eof (gensym)) (datum (read stream nil eof)))
      (when (or (eq datum eof) (not (eq eof (read stream nil eof))))
        (error "Una sola forma richiesta in ~A." path))
      datum)))

(defun save-one (path datum)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :error
                               :external-format :utf-8)
    (let ((*print-readably* t)) (write datum :stream stream :pretty t) (terpri stream))))

(defun replace-index (path datum)
  (with-open-file (stream path :direction :output :if-exists :supersede
                               :external-format :utf-8)
    (let ((*print-readably* t)) (write datum :stream stream :pretty t) (terpri stream))))

(defun fingerprint (path)
  (list :bytes (arcdocdb.evidence:file-bytes path)
        :sha256 (arcdocdb.evidence:file-sha256 path)))

(defun copy-verified (source target root)
  (let ((before (fingerprint source)))
    (when (probe-file target) (error "Destinazione esistente: ~A." target))
    (ensure-directories-exist target)
    (uiop:copy-file source target)
    (unless (and (equal before (fingerprint source))
                 (equal before (fingerprint target)))
      (error "Copia alterata: ~A." source))
    (append (list :path (enough-namestring target root) :source (namestring source)) before)))

(defun selected-files (directory &key lisp-and-log-only)
  (let ((files nil))
    (labels ((walk (dir)
               (dolist (file (uiop:directory-files dir))
                 (when (or (not lisp-and-log-only)
                           (member (pathname-type file) '("lisp" "log" "gz") :test #'equal))
                   (push file files)))
               (dolist (sub (uiop:subdirectories dir))
                 (unless (find "fasl" (pathname-directory sub) :test #'equal) (walk sub)))))
      (walk directory))
    (sort files #'string< :key #'namestring)))

(defun collect (manifest-path destination)
  (let* ((manifest (read-one manifest-path))
         (root (merge-pathnames (uiop:ensure-directory-pathname destination) (truename "./")))
         (files nil) (processes nil))
    (unless (and (eql 1 (getf manifest :schema-version)) (getf manifest :processes))
      (error "Manifest della raccolta invalido."))
    (when (probe-file root) (error "Raccolta esistente: ~A." root))
    (ensure-directories-exist (merge-pathnames "placeholder" root))
    (dolist (record (getf manifest :processes))
      (destructuring-bind (label report-path) record
        (let* ((source (truename report-path))
               (base (uiop:pathname-directory-pathname source))
               (target-base (merge-pathnames (format nil "processes/~A/" label) root))
               (data (arcdocdb.evidence:read-evidence source)))
          (unless (and (eql 1 (getf data :schema-version))
                       (eq :command-verification (getf data :kind)))
            (error "Record di comando richiesto: ~A." source))
          (dolist (file (selected-files base))
            (push (copy-verified file (merge-pathnames (enough-namestring file base) target-base) root) files))
          (let ((target (merge-pathnames (file-namestring source) target-base)))
            (unless (equalp data (arcdocdb.evidence:read-evidence target))
              (error "Registro decodificato diverso dopo copia: ~A." source))
            (push (list :label label :record-path (enough-namestring target root)
                        :status (getf data :status) :exit-code (getf data :exit-code)
                        :source-consistency (getf data :source-consistency)
                        :command (getf data :command)) processes)))))
    (dolist (tree (getf manifest :trees))
      (destructuring-bind (label source-directory mode) tree
        (let ((base (truename source-directory))
              (target-base (merge-pathnames (format nil "raw/~A/" label) root)))
          (dolist (file (selected-files base :lisp-and-log-only (eq mode :lisp-and-log)))
            (push (copy-verified file (merge-pathnames (enough-namestring file base) target-base) root) files)))))
    (dolist (item (getf manifest :files))
      (destructuring-bind (label source) item
        (push (copy-verified (truename source) (merge-pathnames (format nil "raw/~A" label) root) root) files)))
    (push (copy-verified (truename manifest-path) (merge-pathnames "collection-manifest.lisp" root) root) files)
    (push (copy-verified (truename "spikes/out/cbor-minimal-collection/collect.lisp")
                        (merge-pathnames "collection-source.lisp" root) root) files)
    (let ((paths (mapcar (lambda (entry) (getf entry :path)) files)))
      (unless (= (length paths) (length (remove-duplicates paths :test #'equal)))
        (error "Percorso duplicato nella raccolta.")))
    (save-one (merge-pathnames "archive-index.lisp" root)
              (list :schema-version 1 :kind :original-command-archive
                    :metadata-policy :read-without-result-inference :processes (nreverse processes)
                    :files (sort files #'string< :key (lambda (entry) (getf entry :path)))
                    :limits '(:sha256-byte-copy-check :raw-originals-preserved
                              :fasl-excluded-from-published-mutation-trees
                              :no-requirement-or-release-promotion)))
    (save-one (merge-pathnames "catalogo.lisp" root)
              (list :schema-version 1 :kind :evidence-catalog :date "2026-10-09"
                    :path-base destination :formats nil :entries
                    (list (list :kind :original-command-archive :artifact "archive-index.lisp"
                                :artifact-schema-version 1 :artifact-kind :original-command-archive))
                    :pending nil))
    (format t "Raccolta: ~D file originali verificati, ~D processi.~%" (length files) (length processes))))

(defun audit (destination)
  (let* ((root (truename (uiop:ensure-directory-pathname destination)))
         (index (read-one (merge-pathnames "archive-index.lisp" root))))
    (dolist (entry (getf index :files))
      (let ((path (getf entry :path)))
        (unless (and (stringp path) (not (uiop:absolute-pathname-p path))
                     (not (search ".." path))
                     (equal (list :bytes (getf entry :bytes) :sha256 (getf entry :sha256))
                            (fingerprint (merge-pathnames path root))))
          (error "Artefatto alterato: ~S." path))))
    (dolist (entry (getf index :processes))
      (let ((data (arcdocdb.evidence:read-evidence (merge-pathnames (getf entry :record-path) root))))
        (unless (and (equal (getf entry :status) (getf data :status))
                     (equal (getf entry :exit-code) (getf data :exit-code))
                     (equal (getf entry :source-consistency) (getf data :source-consistency))
                     (equal (getf entry :command) (getf data :command)))
          (error "Metadata del registro incoerenti."))))
    (format t "Audit: ~D file e ~D processi conservati senza riscrittura.~%"
            (length (getf index :files)) (length (getf index :processes)))))

(defun append-process (destination label report-path)
  "Aggiunge un comando successivo in una directory nuova, senza toccare originali."
  (audit destination)
  (let* ((root (truename (uiop:ensure-directory-pathname destination)))
         (index-path (merge-pathnames "archive-index.lisp" root))
         (index (read-one index-path))
         (source (truename report-path))
         (base (uiop:pathname-directory-pathname source))
         (target-base (merge-pathnames (format nil "processes/~A/" label) root))
         (data (arcdocdb.evidence:read-evidence source))
         (files nil))
    (when (probe-file target-base) (error "Processo già presente: ~A." label))
    (unless (and (eql 1 (getf data :schema-version))
                 (eq :command-verification (getf data :kind)))
      (error "Record di comando richiesto."))
    (dolist (file (selected-files base))
      (push (copy-verified file (merge-pathnames (enough-namestring file base) target-base) root) files))
    (let ((target (merge-pathnames (file-namestring source) target-base)))
      (unless (equalp data (arcdocdb.evidence:read-evidence target))
        (error "Registro copiato diverso."))
      (setf (getf index :processes)
            (append (getf index :processes)
                    (list (list :label label :record-path (enough-namestring target root)
                                :status (getf data :status) :exit-code (getf data :exit-code)
                                :source-consistency (getf data :source-consistency)
                                :command (getf data :command))))
            (getf index :files) (append (getf index :files) (nreverse files))))
    (replace-index index-path index)
    (audit destination)))

(let ((args (uiop:command-line-arguments)))
  (cond ((and (= 3 (length args)) (string= "--collect" (first args)))
         (collect (second args) (third args)))
        ((and (= 2 (length args)) (string= "--audit" (first args))) (audit (second args)))
        ((and (= 4 (length args)) (string= "--append" (first args)))
         (append-process (second args) (third args) (fourth args)))
        (t (error "Uso: --collect manifest destinazione oppure --audit destinazione."))))
