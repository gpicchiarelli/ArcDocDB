(in-package #:arcdocdb.cbor.tests)

;;; REQ: REQ-CON-005 REQ-AFF-004 REQ-AFF-008
(deftest test-REQ-CON-005-cbor-two-private-buffers-and-real-cpu-overlap
  (let* ((units 65536) (repetitions 16) (prefix 3)
         (majors (vector 0 7)) (highs (vector #xfedcba98 #x7ff80000))
         (lows (vector #x76543210 #x01234567))
         (buffers (make-array 2)) (copies (make-array 2))
         (ready (sb-thread:make-semaphore)) (go (sb-thread:make-semaphore))
         (starts (vector 0 0)) (ends (vector 0 0)) (sinks (vector 0 0)) (threads nil))
    (dotimes (index 2)
      (let* ((head (append (list (+ (* 32 (svref majors index)) 27))
                           (cbor-big-endian (svref highs index) 4)
                           (cbor-big-endian (svref lows index) 4)))
             (buffer (make-array (+ prefix (* 9 units) 5) :element-type '(unsigned-byte 8)
                                 :initial-element #xff)))
        (dotimes (unit units) (replace buffer head :start1 (+ prefix (* 9 unit))))
        (setf (svref buffers index) buffer (svref copies index) (copy-seq buffer))))
    (is (not (eq (svref buffers 0) (svref buffers 1))))
    (unwind-protect
         (progn
           (dotimes (i 2)
             (let ((index i))
               (push (sb-thread:make-thread
                      (lambda ()
                        (handler-case
                            (progn
                              (sb-thread:signal-semaphore ready)
                              (cbor-wait go)
                              (setf (svref starts index) (get-internal-real-time))
                              (let ((buffer (svref buffers index)) (sink 0))
                                (dotimes (iteration repetitions)
                                  (dotimes (unit units)
                                    (let* ((cursor (+ prefix (* 9 unit))) (limit (+ cursor 9)))
                                      (multiple-value-bind (major ai high low next form)
                                          (arcdocdb.cbor:leggi-header-cbor buffer cursor limit)
                                        (is (= major (svref majors index))) (is (= ai 27))
                                        (is (= high (svref highs index))) (is (= low (svref lows index)))
                                        (is (= next limit)) (is (eq form :argument))
                                        (incf sink (logxor high low))))))
                                (setf (svref sinks index) sink))
                              (setf (svref ends index) (get-internal-real-time))
                              :ok)
                          (error (condition) condition)))
                      :name "CBOR private header worker") threads)))
           (dotimes (i 2) (cbor-wait ready))
           (sb-thread:signal-semaphore go 2)
           (dolist (thread threads) (cbor-join thread))
           (dotimes (index 2)
             (is (> (svref ends index) (svref starts index)))
             (is (= (svref sinks index)
                    (* units repetitions (logxor (svref highs index) (svref lows index)))))
             (is (equalp (svref buffers index) (svref copies index))))
           (let ((overlap (- (min (svref ends 0) (svref ends 1))
                             (max (svref starts 0) (svref starts 1)))))
             (is (plusp overlap))
             (format t "  CBOR CPU: 2 worker, ~D header, ~D byte, sink ~D/~D, overlap ~D tick, ~D tick/s.~%"
                     (* 2 units repetitions) (* 18 units repetitions)
                     (svref sinks 0) (svref sinks 1) overlap internal-time-units-per-second)))
      (sb-thread:signal-semaphore go 2)
      (cbor-stop-workers threads))))
