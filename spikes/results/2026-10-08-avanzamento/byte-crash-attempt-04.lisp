                    (phase (list :operation :compile-and-load :source path
                                 :fasl (namestring output) :status :running)))
               (setf (getf record :phases) (append (getf record :phases) (list phase)))
               (save)
               (multiple-value-bind (fasl warnings failure)
                   (compile-file path :output-file output :verbose nil :print nil)
                 (setf (getf phase :warnings) warnings (getf phase :failure) failure)
                 (when (or warnings failure (null fasl)) (error \"Compile strict fallito: ~A\" path))
                 (load fasl :verbose nil :print nil)
                 (setf (getf phase :status) :ok)
                 (save)))))
    (save)
    (handler-case
        (handler-bind ((warning (lambda (c) (error \"Avviso fatale, anche style-warning: ~A\" c))))
          (loop for path in '(\"src/foundation/package.lisp\"
