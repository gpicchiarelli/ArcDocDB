                      (getf result :classification-counts) (length (getf result :negative-controls))
                      (length (getf result :semantic-controls))))))
      (error (c)
        (let* ((package (find-package \"ARCDOCDB.SPK07.BYTE-CRASH\"))
               (type (and package (find-symbol \"BUDGET-EXHAUSTED\" package)))
               (reader (and package (find-symbol \"EXHAUSTED-LIMIT\" package)))
               (budget (and type (typep c type)))
               (last-phase (car (last (getf record :phases)))))
          (when last-phase (setf (getf last-phase :status) :failed))
          (setf (getf record :status) :failed
                (getf record :failure)
                (list :condition (princ-to-string (type-of c)) :message (princ-to-string c)
                      :budget-limit (when budget (funcall reader c))
                      :expected-failure-matched
                      (and budget
                           (or (and (equal mode \"case-limit\") (eq (funcall reader c) :case-limit))
                               (and (equal mode \"step-limit\") (eq (funcall reader c) :step-limit))
                               (and (equal mode \"recovery-limit\") (eq (funcall reader c) :recovery-limit))
                               (and (equal mode \"read-limit\") (eq (funcall reader c) :read-limit))
                               (and (equal mode \"seconds-limit\") (eq (funcall reader c) :seconds-limit))))))
          (save)
          (format *error-output* \"Fallimento registrato: ~A~%\" c)
          (sb-ext:exit :code 1))))))
