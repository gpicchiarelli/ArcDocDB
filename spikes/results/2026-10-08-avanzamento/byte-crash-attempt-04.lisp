                for index from 0 do (compile-one path index))
          (let* ((package (find-package \"ARCDOCDB.SPK07.BYTE-CRASH\"))
                 (check (find-symbol \"CHECK\" package))
                 (phase (list :operation :check :status :running)))
            (setf (getf record :phases) (append (getf record :phases) (list phase)))
            (save)
            (let ((result (cond ((equal mode \"full\") (funcall check))
                                ((equal mode \"case-limit\") (funcall check :case-limit 1))
                                ((equal mode \"step-limit\") (funcall check :step-limit 1))
                                ((equal mode \"recovery-limit\") (funcall check :recovery-limit 1))
                                ((equal mode \"read-limit\") (funcall check :read-limit 1))
                                ((equal mode \"seconds-limit\") (funcall check :seconds-limit 1/1000000000))
                                (t (error \"Modo sconosciuto: ~A\" mode)))))
              (unless (eq (getf result :status) :ok) (error \"CHECK non concluso: ~S\" result))
              (setf (getf record :result) result (getf phase :status) :ok
                    (getf record :status) :ok)
              (save)
              (format t \"CHECK :OK; casi ~D; recovery ~D; checkpoint ~D; interruzioni ~D; restart ~D; massimo ~D.~%\"
                      (getf result :cases) (getf result :recoveries) (getf result :checkpoints)
                      (getf result :interruptions) (getf result :restarts)
                      (getf result :maximum-checkpoints-per-recovery))
