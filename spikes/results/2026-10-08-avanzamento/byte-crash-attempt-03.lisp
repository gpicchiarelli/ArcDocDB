;;; REQ: REQ-VAL-001 REQ-AFF-003 REQ-AFF-008
(require :asdf)
(declaim (optimize (safety 3) (debug 3)))

(let* ((args (uiop:command-line-arguments))
       (mode (first args)) (out (pathname (second args)))
       (data-path (merge-pathnames \"data.sexp\" out))
       (record (list :schema-version 1 :kind :strict-byte-crash-driver
                     :argv sb-ext:*posix-argv* :stdin \"\" :status :running
                     :mode mode :phases nil :result nil :failure nil)))
  (labels ((save ()
             (with-open-file (s data-path :direction :output :if-exists :supersede)
               (let ((*print-readably* t) (*print-pretty* nil))
                 (write record :stream s) (terpri s))))
           (compile-one (path index)
             (let* ((output (merge-pathnames (format nil \"~2,'0D.fasl\" index) out))
                    (phase (list :operation :compile-and-load :source path
                                 :fasl (namestring output) :status :running)))
               (setf (getf record :phases) (append (getf record :phases) (list phase)))
               (save)
               (multiple-value-bind (fasl warnings failure)
                   (compile-file path :output-file output :verbose nil :print nil)
                 (setf (getf phase :warnings) warnings (getf phase :failure) failure)
                 (when (or warnings failure (null fasl)) (error \"Compile strict fallito: ~A\" path))
                 (load fasl :verbose nil :print nil)
                 (setf (getf phase :status) :ok)
                 (save)))))
    (save)
    (handler-case
        (handler-bind ((warning (lambda (c) (error \"Avviso fatale, anche style-warning: ~A\" c))))
          (loop for path in '(\"src/package.lisp\" \"src/foundation/package.lisp\"
                              \"src/foundation/conditions.lisp\" \"src/foundation/binary.lisp\"
                              \"src/foundation/crc32c.lisp\" \"src/foundation/record.lisp\"
                              \"src/foundation/batch.lisp\" \"spikes/SPK-07-protocols/byte-crash.lisp\")
                for index from 0 do (compile-one path index))
          (let* ((package (find-package \"ARCDOCDB.SPK07.BYTE-CRASH\"))
                 (check (find-symbol \"CHECK\" package))
                 (phase (list :operation :check :status :running)))
            (setf (getf record :phases) (append (getf record :phases) (list phase)))
            (save)
            (let ((result (cond ((equal mode \"full\") (funcall check))
                                ((equal mode \"case-limit\") (funcall check :case-limit 1))
                                ((equal mode \"step-limit\") (funcall check :step-limit 1))
                                (t (error \"Modo sconosciuto: ~A\" mode)))))
              (unless (eq (getf result :status) :ok) (error \"CHECK non concluso: ~S\" result))
              (setf (getf record :result) result (getf phase :status) :ok
                    (getf record :status) :ok)
              (save)
              (format t \"CHECK :OK; casi ~D; recovery ~D; checkpoint ~D; interruzioni ~D; restart ~D; massimo ~D.~%\"
                      (getf result :cases) (getf result :recoveries) (getf result :checkpoints)
                      (getf result :interruptions) (getf result :restarts)
                      (getf result :maximum-checkpoints-per-recovery))
              (format t \"Classi: ~S; negativi ~D; SEAL semantici ~D.~%\"
                      (getf result :classification-counts) (length (getf result :negative-controls))
                      (length (getf result :semantic-controls))))))
      (error (c)
        (let* ((package (find-package \"ARCDOCDB.SPK07.BYTE-CRASH\"))
               (type (and package (find-symbol \"BUDGET-EXHAUSTED\" package)))
               (reader (and package (find-symbol \"EXHAUSTED-LIMIT\" package)))
               (budget (and type (typep c type)))
               (last-phase (car (last (getf record :phases)))))
          (when last-phase (setf (getf last-phase :status) :failed))
          (setf (getf record :status) :failed
                (getf record :failure)
                (list :condition (princ-to-string (type-of c)) :message (princ-to-string c)
                      :budget-limit (when budget (funcall reader c))
                      :expected-failure-matched
                      (and budget
                           (or (and (equal mode \"case-limit\") (eq (funcall reader c) :case-limit))
                               (and (equal mode \"step-limit\") (eq (funcall reader c) :step-limit))))))
          (save)
          (format *error-output* \"Fallimento registrato: ~A~%\" c)
          (sb-ext:exit :code 1))))))
