                     (error \\\"Rango invalido: ~S -> ~S\\\" state next))
                   (push state (gethash next reverse-edges))
                   (unless (nth-value 1 (gethash next parents))
                     (setf (gethash next parents) (cons state (car edge)))
                     (when (>= (hash-table-count parents) limit)
                       (error \\\"Tetto raggiunto: ~D stati (limite ~D), ordine ~S, reader ~S, mutante ~S.\\\"
                              (hash-table-count parents) limit order targets mutant)))))
               edges))
           (violation (state)
             (incf oracle-calls)
             (dotimes (reader-id 2)
               (when (eighth (reader-at state reader-id))
                 (incf (nth reader-id accepted-checks))
                 (incf query-checks 3)))
