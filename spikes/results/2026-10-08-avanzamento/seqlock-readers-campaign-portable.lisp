(defun save-data (data path)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (let ((*print-readably* t) (*print-pretty* t))
      (write data :stream stream) (terpri stream))))

(let* ((args (uiop:command-line-arguments))
       (out (pathname (first args))) (limit (parse-integer (second args)))
       (path (merge-pathnames \"data.lisp\" out))
       (data (list :schema-version 1 :kind :seqlock-readers-data :status :running
                   :argv (copy-list sb-ext:*posix-argv*) :stdin \"\"
                   :state-limit limit :compilations nil :check nil :failure nil)))
  (ensure-directories-exist path)
  (save-data data path)
  (handler-case
      (progn
        (dolist (source '(\"spikes/SPK-07-protocols/core.lisp\"
                          \"spikes/SPK-07-protocols/seqlock-readers.lisp\"))
          (let* ((output (merge-pathnames (make-pathname :name (pathname-name source) :type \"fasl\") out))
                 (step (list :operation :compile-file :source source :output (namestring output)
                             :policy '(:safety 3 :warnings-fatal t :style-warnings-fatal t)
                             :status :running :returned-values nil)))
            (setf (getf data :compilations) (append (getf data :compilations) (list step)))
            (save-data data path)
            (handler-case
                (handler-bind ((warning (lambda (condition)
                                          (error \"Warning/style-warning fatale: ~A\" condition))))
                  (multiple-value-bind (fasl warnings failure)
                      (compile-file source :output-file output :verbose nil :print nil)
                    (setf (getf step :returned-values)
                          (list :fasl (and fasl (namestring fasl)) :warnings warnings :failure failure))
                    (when (or (null fasl) warnings failure) (error \"Compilazione fallita: ~A\" source))
                    (load fasl :verbose nil :print nil)
                    (setf (getf step :status) :ok)))
              (error (condition)
                (setf (getf step :status) :failed (getf step :diagnostic) (princ-to-string condition))
                (save-data data path)
                (error condition)))
            (save-data data path)))
        (setf (getf data :check) (list :operation :check :status :running :state-limit limit))
        (save-data data path)
        (let* ((package (find-package \"ARCDOCDB.SPK07.SEQLOCK-READERS\"))
               (entry (find-symbol \"CHECK\" package))
               (result (handler-bind ((warning (lambda (condition)
                                                (error \"Warning di CHECK: ~A\" condition))))
                         (funcall entry :state-limit limit))))
          (unless (eq (getf result :status) :ok) (error \"CHECK non riuscito: ~S\" result))
          (setf (getf data :check) (list :operation :check :status :ok :result result)
                (getf data :status) :ok)
          (save-data data path)
          (format t \"~&CHECK :OK; ~S~%Dati: ~A~%\" (getf result :counts) path)))
    (error (condition)
      (setf (getf data :status) :failed
            (getf data :failure) (list :condition-type (format nil \"~S\" (type-of condition))
                                      :diagnostic (princ-to-string condition)))
      (let* ((package (find-package \"ARCDOCDB.SPK07.SEQLOCK-READERS\"))
             (type (and package (find-symbol \"STATE-BUDGET-EXHAUSTED\" package)))
             (accessor (and package (find-symbol \"BUDGET-DATA\" package))))
        (when (and type (typep condition type) accessor (fboundp accessor))
          (setf (getf (getf data :failure) :module-data) (funcall accessor condition))))
      (when (eq (getf (getf data :check) :status) :running)
        (setf (getf (getf data :check) :status) :failed))
      (save-data data path)
      (format *error-output* \"~&ERRORE REGISTRATO: ~A~%\" condition)
      (sb-ext:exit :code 1))))
