            (2 (setf (nth 6 s) 1))
            (otherwise (error \"Passo snapshot writer\")))
          (push (cons (list :writer w) s) edges)))
      (when (and (< r 3) (or (/= r 2) (>= (nth 6 state) (nth 3 state))))
        (let ((s (changed state 1 (1+ r))))
