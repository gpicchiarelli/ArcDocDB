                (setf h (or (position 1 s) issued))
                (progn
                  (setf (nth (mod c 4) r) c)
                  (loop repeat 4 while (= (nth (mod (1+ h) 4) r) (1+ h)) do (incf h))))
            (push (cons (list :publish c) (list issued h r s)) edges))))
      edges)))

