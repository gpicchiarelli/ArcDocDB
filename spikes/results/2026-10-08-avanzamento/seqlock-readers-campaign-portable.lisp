  (setf (getf record :finished-at) (get-universal-time))
  (save-record record record-path)
  (format t \"~&~S; record schema 1: ~A~%\" (getf record :status) record-path)
  (let ((data (getf record :results-decoded)))
    (when (listp data)
      (format t \"~S~%\" (or (getf (getf (getf data :check) :result) :counts)
                           (getf data :failure)))))
  (unless (eq (getf record :status) :ok) (sb-ext:exit :code 1)))
