| 0, 1 | 0 / 0 | 5961 | 14385 | 49 |
| 0, 1 | 1 / 1 | 1938 | 4057 | 25 |
| 0, 1 | 0 / 1 | 3159 | 7053 | 35 |
| 0, 1 | 1 / 0 | 3159 | 7053 | 35 |
| 1, 0 | 0 / 0 | 1938 | 4057 | 25 |
