                   (namestring out) (princ-to-string limit)))
       (before (source-snapshot))
       (record (list :schema-version 1 :kind :seqlock-readers-command :status :running
                     :argv argv :stdin \"\" :recorder-argv (copy-list sb-ext:*posix-argv*)
                     :environment (observed-environment)
                     :source-content-before before :source-content-after nil
                     :results-decoded nil :stdout \"\" :stderr \"\" :exit-code nil
                     :limits (list :states-per-graph limit :hard-state-ceiling 200000
                                   :ceiling-reached-is-error t :scheduled-transitions 36
                                   :reader-attempts 2 :stdout-truncated nil :stderr-truncated nil
