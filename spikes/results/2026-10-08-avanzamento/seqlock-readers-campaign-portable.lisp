              (getf record :exit-code) code (getf record :status) (if (zerop code) :ok :failed)))
    (error (condition)
      (setf (getf record :status) :failed (getf record :diagnostic) (princ-to-string condition))))
  (save-record record record-path)
  (handler-case
      (progn
        (setf (getf record :source-content-after) (source-snapshot))
        (setf (getf record :source-consistency)
              (if (equal before (getf record :source-content-after)) :stable :changed))
        (setf (getf record :results-decoded) (if (probe-file data-path) (read-data data-path) :absent))
        (unless (eq (getf record :source-consistency) :stable)
          (setf (getf record :status) :source-changed)))
    (error (condition)
