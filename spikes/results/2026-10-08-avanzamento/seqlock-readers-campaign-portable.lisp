    (let ((*read-eval* nil)) (read stream))))

(let* ((args (uiop:command-line-arguments))
       (name (first args)) (limit (parse-integer (second args)))
       (out (merge-pathnames
             (format nil \"spikes/SPK-07-protocols/out/seqlock-readers-20261008/~A/\" name)
             (truename \"./\")))
       (record-path (merge-pathnames \"record.lisp\" out))
