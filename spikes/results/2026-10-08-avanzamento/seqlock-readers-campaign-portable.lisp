    (flet ((edges (state)
             (let ((edges (successors state order targets mutant)))
               (when (null edges)
                 (unless (terminal-p state) (error \\\"Terminale incompleto: ~S\\\" state))
                 (push state terminals))
               (dolist (edge edges)
                 (let ((next (cdr edge)))
