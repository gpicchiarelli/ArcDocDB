          (1 (setf (nth 3 s) 30))
          (2 (setf (nth 4 s) 70))
          (3 (setf (nth 2 s) 2))
          (otherwise (error \"Passo writer inatteso\")))
        (push (cons (list :writer w) s) edges)))
    (when (< r 5)
      (let ((s (changed state 1 (1+ r))))
        (case r
          (0 (setf (nth 5 s) (nth 2 state)))
          (1 (setf (nth 6 s) (nth 3 state)))
          (2 (setf (nth 7 s) (nth 4 state)))
