INVALID-ARGUMENT/RESOURCE-EXHAUSTED prima di qualsiasi syscall.\"
  (check-range buffer start end)
  (let ((count (- end start)))
    (when (> count (file-max-transfer file))
      (error 'resource-exhausted :reason :io-byte-budget :offset start))
    count))

