  (logior (aref buffer start) (ash (aref buffer (+ start 1)) 8)
          (ash (aref buffer (+ start 2)) 16) (ash (aref buffer (+ start 3)) 24)))

;;; REQ: REQ-FOR-003
(defun leggi-u64 (buffer start)
