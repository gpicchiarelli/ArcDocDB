  (logior (leggi-u32 buffer start) (ash (leggi-u32 buffer (+ start 4)) 32)))

;;; REQ: REQ-FOR-003
(declaim (ftype (function (octets index u16) (values u16 &optional)) scrivi-u16)
         (ftype (function (octets index u32) (values u32 &optional)) scrivi-u32)
