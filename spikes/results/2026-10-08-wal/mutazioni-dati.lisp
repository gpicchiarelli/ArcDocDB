                             (aref table 6 (ldb (byte 8 8) word))
                             (aref table 5 (ldb (byte 8 16) word))
                             (aref table 4 (ldb (byte 8 24) word))
                             (aref table 3 (aref buffer (+ i 4)))
                             (aref table 2 (aref buffer (+ i 5)))
                             (aref table 1 (aref buffer (+ i 6)))
