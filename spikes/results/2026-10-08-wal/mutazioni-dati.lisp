  (when (and (eq level :async) (not (eq (lotto-kind lotto) :segment)))
    (error 'invalid-argument :reason :async-control-log))
  (not (null (if (eq level :async) (member (lotto-state lotto) '(:written :durable))
                (eq (lotto-state lotto) :durable)))))

