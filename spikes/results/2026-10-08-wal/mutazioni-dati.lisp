  (unless (and (<= durable file-start)
               (<= (+ file-start (lotto-used lotto) +seal-total+) most-positive-fixnum))
    (error 'invalid-argument :reason :lotto-offset))
  (let ((seal (lotto-seal-value lotto)) (checksum (ristampa-record lotto stamp)))
