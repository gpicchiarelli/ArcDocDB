               (plusp max-batches) (typep max-batch-records 'u32)
               (plusp max-batch-records) (typep max-batch-bytes 'index)
               (>= max-batch-bytes +seal-record-bytes+)
               (typep max-search-bytes 'index)
               (typep (+ file-offset end) 'u64))
