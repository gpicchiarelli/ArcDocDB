        (esigi-budget outcomes (- max-esiti total) pos)
        (setf pos (spazio-ripetuto fixed-end end outcomes +closure-outcome-bytes+))
        (incf total outcomes)))
    (unless (<= start pos end)
      (error 'invariant-violation :reason :closed-range :offset start))
    (values pos total)))

