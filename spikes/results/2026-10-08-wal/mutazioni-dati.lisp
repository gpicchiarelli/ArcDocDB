          (aref buffer (+ start +flags-offset+)) flags)
    (scrivi-u16 buffer (+ start +key-length-offset+) (length key))
    (scrivi-u32 buffer (+ start +value-length-offset+) (length value))
    (scrivi-u64 buffer (+ start +stamp-offset+) stamp)
