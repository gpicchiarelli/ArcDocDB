    (fill buffer 0 :start start :end next)
    (scrivi-u32 buffer start +log-magic-low+)
    (scrivi-u32 buffer (+ start +log-magic-high-offset+) magic)
    (scrivi-u16 buffer (+ start +log-version-offset+) version)
