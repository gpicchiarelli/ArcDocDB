         (end (+ prefix 64))
         (buffer (make-array (+ end 9) :element-type '(unsigned-byte 8)
                                      :initial-element #xcc)))
    (replace buffer (log-header-oracle kind version identity) :start1 prefix :end1 end)
    (values buffer prefix end identity)))

