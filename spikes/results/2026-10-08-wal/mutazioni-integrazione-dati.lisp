      (let ((file (log-io-file (gruppo-log group))))
        (dotimes (i (gruppo-count group))
          (let* ((lotto (the lotto (svref (gruppo-slots group) i)))
                 (end (append-esatto file (lotto-buffer lotto) 0 (lotto-used lotto))))
