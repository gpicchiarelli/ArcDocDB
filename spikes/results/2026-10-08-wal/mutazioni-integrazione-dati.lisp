    (invariant-violation (c) (fault-gruppo group) (error c))))

;;; REQ: REQ-WAL-002 REQ-WAL-006 REQ-AFF-001
(declaim (ftype (function (gruppo) file-offset) sincronizza-gruppo))
(defun sincronizza-gruppo (group)
