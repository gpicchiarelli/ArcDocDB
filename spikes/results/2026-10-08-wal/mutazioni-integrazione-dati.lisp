      (multiple-value-bind (next kind flags ks ke vs ve)
          (verifica-cornice buffer pos (+ pos +seal-record-bytes+) :version version)
        (unless (and (= next (+ pos +seal-record-bytes+)) (= kind +seal+)
                     (zerop flags) (= ks ke) (= vs (+ pos +header-bytes+))
                     (= (- ve vs) +seal-bytes+))
