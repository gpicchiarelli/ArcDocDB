(declaim (ftype (function (file-io) null) chiudi))
(defun chiudi (file)
  \"Pre: nessun altro utente del FD. Post: capacità chiusa prima di una sola close.
IO-FAULT per guasto, anche EINTR; close ripetuta è no-op, mai usa un FD riutilizzato.\"
