    (pack-le buffer 8 version 2)
    (setf (aref buffer 10) origin)
    (replace buffer id-serie :start1 16)
    (pack-le buffer 32 segment-id 8)
    (pack-le buffer 40 created 8)
    (pack-le buffer 56 (reference-crc buffer 0 56) 4)
    buffer))

