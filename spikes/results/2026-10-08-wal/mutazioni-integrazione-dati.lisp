  (esigi-lotto lotto :sealed)
  (let ((log (gruppo-log group)) (count (gruppo-count group)))
    (unless (and (eq (lotto-kind lotto) (log-io-kind log))
                 (= (lotto-file-id lotto) (log-io-file-id log))
                 (= (lotto-version lotto) (log-io-version log))
