Segnala UNSUPPORTED-FORMAT per versione sconosciuta; nessun autodetect.\"
  (case version
    (1 (values 255 +max-v1-record-bytes+))
    (2 (values +max-key-bytes+ +max-record-bytes+))
    (otherwise (error 'unsupported-format :reason :record-version))))

