(defun magic-log (log-kind offset)
  \"Pre: tipo dichiarato dal chiamante. Post: magic alto; INVALID-ARGUMENT per altro tipo.\"
  (case log-kind (:control +control-magic-high+) (:multiserie +multiserie-magic-high+)
