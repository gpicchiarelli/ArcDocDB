               (style-warning #'treat-as-error))
  (asdf:load-asd (merge-pathnames \"arcdocdb.asd\" (truename \"./\")))
  (asdf:load-system \"arcdocdb\" :force t)
  (asdf:test-system \"arcdocdb\"))

(format t \"~&build e test: nessun avviso, tutti i controlli superati~%\")
