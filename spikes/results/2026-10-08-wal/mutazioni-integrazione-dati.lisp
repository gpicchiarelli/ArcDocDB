          (lotto-start lotto) file-start
          (lotto-state lotto) :sealed)
    (unless (<= +seal-total+ (lotto-used lotto) (length (lotto-buffer lotto)))
      (error 'invariant-violation :reason :lotto-sealed-length))
    (lotto-used lotto)))

