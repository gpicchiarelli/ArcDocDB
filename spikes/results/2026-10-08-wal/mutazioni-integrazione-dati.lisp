                #:error-transferred)
  (:import-from #:arcdocdb.io #:make-backend #:crea-temporaneo #:apri-lettura #:apri-directory
                #:append-esatto #:leggi-esatto #:durable-flush #:chiudi #:stato-file
                #:posizione-scritta #:posizione-durevole)
