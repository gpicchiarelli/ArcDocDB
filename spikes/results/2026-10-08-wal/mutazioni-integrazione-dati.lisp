  (let ((pos start) (total 0))
    (dotimes (i count)
      (let* ((fixed-end (spazio-ripetuto pos end 1 +closed-fixed-bytes+))
             (outcomes (leggi-u32 buffer (+ pos +closed-outcome-count-offset+))))
