      (dolist (flags '(0 1 4 5))
        (let* ((key (bytes 0 255 128 17)) (value (bytes #xa1 1 2))
               (expected (reference-put key value stamp flags)))
          (multiple-value-bind (actual start end) (fixture :version version :stamp stamp
