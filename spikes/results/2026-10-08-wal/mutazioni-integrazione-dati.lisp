          (error 'invariant-violation :reason :group-owner))
        (error c))
      (resource-exhausted (c)
        (unless (eq group (sb-ext:compare-and-swap (log-io-active log) group nil))
          (error 'invariant-violation :reason :group-owner))
        (error c))
