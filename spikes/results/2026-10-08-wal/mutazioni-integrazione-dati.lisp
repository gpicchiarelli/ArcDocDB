     ";;;; Harness delle fondazioni: oracoli indipendenti e seme deterministico.
(defpackage #:arcdocdb.foundation.tests
  (:use #:cl)
  (:import-from #:arcdocdb.binary #:octets #:crc32c #:leggi-u16 #:leggi-u32 #:leggi-u64
