          for width = 1 then (* width 2)
          do (loop repeat (ceiling count (* width 2))
                   for left = 0 then (+ left (* width 2))
                   do (merge-entry-runs source target left (min count (+ left width))
                                        (min count (+ left (* width 2)))))
             (rotatef source target))
