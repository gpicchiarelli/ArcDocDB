  (check-range right right-start (+ right-start +participant-id-bytes+))
  (dotimes (i +participant-id-bytes+ 0)
    (let ((a (aref left (+ left-start i))) (b (aref right (+ right-start i))))
      (when (/= a b) (return-from compare-id16 (if (< a b) -1 1))))))

