       (error 'corruption-detected :reason :control-key :offset start))))
  nil)

;;; REQ: REQ-FOR-003 REQ-LIM-001
(declaim (ftype (function (u8 u32 index) null) check-value-shape))
(defun check-value-shape (kind value-length start)
