;;;; C4: --self-test|--bench DIRECTORY-NUOVA; metodo-crc32c.md.
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
(asdf:load-system "arcdocdb")
(handler-bind ((warning (lambda (condition) (error condition))))
  (load (merge-pathnames "crc32c.lisp" *load-truename*)))
(defpackage #:arcdocdb.spk08.crc32c-run (:use #:cl))
(in-package #:arcdocdb.spk08.crc32c-run)
(declaim (optimize (safety 3) (speed 3)))
(defvar *report* nil)
(defvar *path* nil)
(defun save-report ()
  (with-open-file (s *path* :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write *report* :stream s :pretty t :readably t) (terpri s))
  (with-open-file (s *path*)
    (let ((*read-eval* nil)) (assert (equalp *report* (read s))))))
(defun reference (buffer start end seed)
  (let ((crc (logxor seed #xffffffff)))
    (loop for i from start below end do
      (setf crc (logxor crc (aref buffer i)))
      (dotimes (bit 8) (setf crc (logxor (ash crc -1) (if (oddp crc) #x82f63b78 0)))))
    (logxor crc #xffffffff)))
(defun check-case (buffer start size seed)
  (let* ((end (+ start size)) (expected (reference buffer start end seed)))
    (assert (= expected (arcdocdb.binary:crc32c buffer start end seed)
                        (arcdocdb.spk08.crc32c:native-crc buffer start end seed)))
    (dolist (split (if (<= size 128) (loop for x from 0 to size collect x)
                      (remove-duplicates (list 0 1 7 8 15 16 17 (1- size) size))))
      (let ((prefix (arcdocdb.spk08.crc32c:native-crc buffer start (+ start split) seed)))
        (assert (= expected (arcdocdb.spk08.crc32c:native-crc buffer (+ start split) end prefix)))))
    (incf (getf *report* :cases))))
(defun check ()
  (let* ((buffer (make-array 65568 :element-type '(unsigned-byte 8))) (before nil))
    (dotimes (i (length buffer)) (setf (aref buffer i) (mod (+ (* i 29) 11) 251)))
    (setf before (copy-seq buffer))
    (dolist (size (append (loop for x from 0 to 128 collect x)
                         '(255 256 257 4095 4096 4097 65535 65536 65537)))
      (dotimes (offset 16)
        (dolist (seed '(0 #xffffffff #x12345678)) (check-case buffer offset size seed))))
    (assert (equalp before buffer))
    (dolist (span '((-1 10) (2 1) (0 65569)))
      (let ((caught nil))
        (handler-case (arcdocdb.spk08.crc32c:native-crc buffer (first span) (second span))
          (error () (setf caught t)))
        (assert caught)))
    (let* ((expected (arcdocdb.spk08.crc32c:native-crc buffer 16 32))
           (old (aref buffer 15)))
      (setf (aref buffer 15) 255)
      (assert (= expected (arcdocdb.spk08.crc32c:native-crc buffer 16 32)))
      (setf (aref buffer 15) old)))
  (let ((vector (map '(simple-array (unsigned-byte 8) (*)) #'char-code "123456789")))
    (assert (= #xe3069283 (arcdocdb.spk08.crc32c:native-crc vector 0 9))))
  (setf (getf *report* :disassembly)
        (with-output-to-string (*standard-output*) (disassemble #'arcdocdb.spk08.crc32c:native-crc)))
  (save-report))
(defun measure (kernel buffer size replica)
  (let* ((expected (reference buffer 0 size 0))
         (function (ecase kernel (:software #'arcdocdb.binary:crc32c)
                                 (:hardware #'arcdocdb.spk08.crc32c:native-crc)))
         (completed 0) (failure nil) (ticks 0) (heap 0))
    (declare (type fixnum completed))
    (sb-ext:gc :full t)
    (dotimes (i 1024) (assert (= expected (funcall function buffer 0 size))))
    (setf ticks (get-internal-real-time) heap (sb-ext:get-bytes-consed))
    (handler-case
        (sb-ext:with-timeout 60
          (dotimes (i 65536)
            (assert (= expected (funcall function buffer 0 size))) (incf completed)))
      (error (condition) (setf failure (princ-to-string condition))))
    (setf heap (- (sb-ext:get-bytes-consed) heap) ticks (- (get-internal-real-time) ticks))
    (push (list :size size :method kernel :replica replica :iterations 65536
                :completed completed :ticks ticks :heap-bytes heap :diagnostic failure
                :ns-per-call (when (plusp ticks) (/ (* ticks 1d9) internal-time-units-per-second completed)))
          (getf *report* :windows))
    (save-report) (assert (null failure)) (assert (= completed 65536))))
(defun bench ()
  (dolist (size '(16 256 4096 65536))
    (let ((buffer (make-array size :element-type '(unsigned-byte 8))))
      (dotimes (i size) (setf (aref buffer i) (mod (+ (* i 29) 11) 251)))
      (dotimes (replica 5)
        (dolist (method (if (evenp replica) '(:software :hardware) '(:hardware :software)))
          (measure method buffer size replica))))))
(defun sensor ()
  (let* ((before (sb-ext:get-bytes-consed))
         (live (make-array (* 4 1024 1024) :element-type '(unsigned-byte 8) :initial-element 41))
         (observed (- (sb-ext:get-bytes-consed) before)))
    (assert (= (aref live 0) 41)) (assert (>= observed (* 4 1024 1024)))
    (setf (getf *report* :sensor-bytes) observed))
  (let ((sum 0) (before (sb-ext:get-bytes-consed)))
    (declare (type fixnum sum))
    (dotimes (i 65536) (incf sum))
    (assert (= sum 65536))
    (setf (getf *report* :empty-heap-bytes) (- (sb-ext:get-bytes-consed) before))
    (assert (zerop (getf *report* :empty-heap-bytes)))))
(let* ((args (uiop:command-line-arguments)) (mode (first args)) (directory (second args)))
  (assert (and (= (length args) 2) (member mode '("--self-test" "--bench") :test #'string=)))
  (setf *path* (merge-pathnames "report.lisp" (uiop:ensure-directory-pathname directory)))
  (assert (not (probe-file (uiop:pathname-directory-pathname *path*))))
  (ensure-directories-exist *path*)
  (setf *report* (list :schema-version 1 :kind :crc32c-spike :status :running
                      :cases 0 :windows nil :sensor-bytes nil :disassembly nil :diagnostic nil))
  (handler-case
      (sb-ext:with-timeout 900
        (if (arcdocdb.spk08.crc32c:available-p)
            (progn (check) (sensor) (when (string= mode "--bench") (bench))
                   (setf (getf *report* :status) :ok))
            (setf (getf *report* :status) :unsupported))
        (save-report))
    (error (condition)
      (setf (getf *report* :status) :failed (getf *report* :diagnostic) (princ-to-string condition))
      (save-report) (format *error-output* "run-crc32c.lisp COD-61: ~A~%" condition) (uiop:quit 1)))
  (format t "CRC32C spike: ~A, ~D casi.~%" (getf *report* :status) (getf *report* :cases)))
