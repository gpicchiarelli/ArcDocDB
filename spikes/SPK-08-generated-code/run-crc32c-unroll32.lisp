;;;; C4 --self-test|--bench|--negative-fixture DIRECTORY-NUOVA; metodo-crc32c-unroll32.md.
;;; REQ: REQ-FOR-003 REQ-SIM-001 REQ-VAL-001
(require :asdf)
(setf asdf:*compile-file-warnings-behaviour* :error asdf:*compile-file-failure-behaviour* :error)
(handler-bind ((warning (lambda (condition)
                         (unless (typep condition 'sb-kernel:redefinition-warning) (error condition)))))
  (asdf:load-asd (merge-pathnames "arcdocdb.asd" (truename "./")))
  (asdf:load-system "arcdocdb"))
(handler-bind ((warning (lambda (condition) (error condition))))
  (when (eq :arm64-crc32c (arcdocdb.binary:backend-crc32c))
    (load (merge-pathnames "crc32c-unroll32.lisp" *load-truename*))))

(defpackage #:arcdocdb.spk08.crc32c32-run
  (:use #:cl) (:local-nicknames (#:b #:arcdocdb.binary)))
(in-package #:arcdocdb.spk08.crc32c32-run)
(declaim (optimize (speed 3) (safety 3) (debug 2)))
(defvar *report* nil)
(defvar *path* nil)
(defparameter *methods* '(:software :current16 :unroll32-byte :unroll32-word))

(defun save-report ()
  (with-open-file (s *path* :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write *report* :stream s :readably t :pretty t) (terpri s))
  (with-open-file (s *path*)
    (let ((*read-eval* nil) (eof (gensym)))
      (assert (equalp *report* (read s nil eof))) (assert (eq eof (read s nil eof))))))

(defun kernel (method)
  (ecase method
    (:software #'b::crc32c-lisp)
    (:current16 (symbol-function 'b::crc32c-arm64))
    (:unroll32-byte (symbol-function (find-symbol "CRC32-BYTE-TAIL" "ARCDOCDB.SPK08.CRC32C32")))
    (:unroll32-word (symbol-function (find-symbol "CRC32-WORD-TAIL" "ARCDOCDB.SPK08.CRC32C32")))))

(defun reference (buffer start end seed)
  (declare (type b::octets buffer) (type fixnum start end) (type b::u32 seed))
  (let ((crc (logxor seed #xffffffff)))
    (declare (type b::u32 crc))
    (loop for i fixnum from start below end do
      (setf crc (logxor crc (aref buffer i)))
      (dotimes (bit 8) (setf crc (logxor (ash crc -1) (if (oddp crc) #x82f63b78 0)))))
    (logxor crc #xffffffff)))

(defun splits (size)
  (if (<= size 128) (loop for i from 0 to size collect i)
      '(0 1 3 4 5 7 8 15 16 17 31 32 33)))

(defun check-case (buffer start size seed)
  (let* ((end (+ start size)) (expected (reference buffer start end seed)))
    (assert (= expected (b:crc32c buffer start end seed)))
    (dolist (method *methods*)
      (let ((function (kernel method)))
        (assert (= expected (funcall function buffer start end seed)))
        (dolist (split (append (splits size) (unless (<= size 128) (list (1- size) size))))
          (let ((prefix (funcall function buffer start (+ start split) seed)))
            (assert (= expected (funcall function buffer (+ start split) end prefix)))))))
    (incf (getf *report* :cases))))

(defun check-vector (&optional negative)
  (let ((buffer (map '(simple-array (unsigned-byte 8) (*)) #'char-code "123456789"))
        (expected (if negative #xe3069282 #xe3069283)))
    (assert (= expected (reference buffer 0 9 0) (b:crc32c buffer 0 9)))
    (dolist (method *methods*) (assert (= expected (funcall (kernel method) buffer 0 9))))))

(defun check-guards (buffer)
  (dolist (method *methods*)
    (let* ((function (kernel method)) (expected (funcall function buffer 16 48))
           (before (copy-seq buffer)))
      (dolist (span (list '(-1 10) '(2 1) (list 0 (1+ (length buffer)))))
        (let ((caught nil))
          (handler-case (funcall function buffer (first span) (second span))
            (error () (setf caught t)))
          (assert caught) (assert (equalp buffer before))))
      (setf (aref buffer 15) (logxor 1 (aref buffer 15))
            (aref buffer 48) (logxor 1 (aref buffer 48)))
      (assert (= expected (funcall function buffer 16 48)))
      (setf (aref buffer 32) (logxor 1 (aref buffer 32)))
      (assert (/= expected (funcall function buffer 16 48)))
      (replace buffer before))))

(defun check ()
  (check-vector)
  (let ((buffer (make-array 65570 :element-type '(unsigned-byte 8))))
    (dotimes (i (length buffer)) (setf (aref buffer i) (mod (+ 11 (* 29 i)) 251)))
    (let ((before (copy-seq buffer)))
      (dolist (size (append (loop for i from 0 to 128 collect i)
                           '(255 256 257 4095 4096 4097 4111 4112 4113 65535 65536 65537)))
        (dotimes (offset 32)
          (dolist (seed '(0 #xffffffff #x12345678)) (check-case buffer offset size seed))))
      (assert (equalp buffer before)))
    (check-guards buffer))
  (setf (getf *report* :disassembly)
        (loop for method in (rest *methods*) collect
              (list :method method :text (with-output-to-string (*standard-output*)
                                           (disassemble (kernel method))))))
  (save-report))

(defun measure (method buffer offset size replica count)
  (let* ((function (kernel method)) (end (+ offset size))
         (expected (reference buffer offset end 0))
         (completed 0) (sink 0) (failure nil) (ticks 0) (cpu 0) (heap 0))
    (declare (type fixnum completed sink offset end count))
    (dotimes (i 1024) (assert (= expected (funcall function buffer offset end))))
    (sb-ext:gc :full t)
    (handler-case
        (sb-ext:with-timeout 60
          (setf cpu (get-internal-run-time) ticks (get-internal-real-time)
                heap (sb-ext:get-bytes-consed))
          (dotimes (i count)
            (incf sink (the b::u32 (funcall function buffer offset end))) (incf completed)))
      (error (condition) (setf failure (princ-to-string condition))))
    (setf heap (- (sb-ext:get-bytes-consed) heap) ticks (- (get-internal-real-time) ticks)
          cpu (- (get-internal-run-time) cpu))
    (push (list :method method :size size :offset offset :replica replica :iterations count
                :completed completed :sink sink :expected-sink (* count expected)
                :ticks ticks :cpu-ticks cpu :heap-bytes heap :diagnostic failure
                :ns-per-call (/ (* ticks 1d9) internal-time-units-per-second count))
          (getf *report* :windows))
    (save-report)
    (assert (null failure)) (assert (= completed count)) (assert (= sink (* count expected)))))

(defun method-order (replica)
  (let* ((shift (mod replica 4))
         (order (append (nthcdr shift *methods*) (subseq *methods* 0 shift))))
    (if (oddp replica) (reverse order) order)))

(defun bench ()
  (dolist (size '(16 64 256 4096 4112 65536))
    (dolist (offset '(0 24))
      (let ((buffer (make-array (+ offset size) :element-type '(unsigned-byte 8)))
            (count (cond ((<= size 256) 1048576) ((<= size 4112) 262144) (t 65536))))
        (dotimes (i (length buffer)) (setf (aref buffer i) (mod (+ 11 (* 29 i)) 251)))
        (dotimes (replica 5)
          (dolist (method (method-order replica))
            (measure method buffer offset size replica count)))))))

(defun sensor ()
  (let* ((before (sb-ext:get-bytes-consed))
         (live (make-array 4194304 :element-type '(unsigned-byte 8) :initial-element 41))
         (observed (- (sb-ext:get-bytes-consed) before)))
    (assert (= 41 (aref live 0))) (assert (>= observed 4194304))
    (setf (getf *report* :positive-sensor) observed))
  (let ((sum 0) (before (sb-ext:get-bytes-consed)))
    (declare (type fixnum sum))
    (dotimes (i 65536) (incf sum))
    (assert (= sum 65536))
    (setf (getf *report* :empty-sensor) (- (sb-ext:get-bytes-consed) before))
    (assert (zerop (getf *report* :empty-sensor)))))

(defun main ()
  (let* ((args (uiop:command-line-arguments)) (mode (first args)) (directory (second args)))
    (assert (and (= 2 (length args))
                 (member mode '("--self-test" "--bench" "--negative-fixture") :test #'string=)))
    (setf *path* (merge-pathnames "report.lisp" (uiop:ensure-directory-pathname directory)))
    (assert (not (probe-file (uiop:pathname-directory-pathname *path*))))
    (ensure-directories-exist *path*)
    (setf *report* (list :schema-version 1 :kind :crc32c-unroll32 :status :running
                        :selected-backend (b:backend-crc32c) :cases 0 :windows nil
                        :timer-units internal-time-units-per-second :diagnostic nil))
    (handler-case
        (sb-ext:with-timeout 900
          (if (eq :arm64-crc32c (b:backend-crc32c))
              (progn (when (string= mode "--negative-fixture") (check-vector t))
                     (check) (sensor) (when (string= mode "--bench") (bench))
                     (setf (getf *report* :status) :ok))
              (setf (getf *report* :status) :unsupported))
          (save-report))
      (error (condition)
        (setf (getf *report* :status) :failed (getf *report* :diagnostic) (princ-to-string condition))
        (save-report) (format *error-output* "run-crc32c-unroll32.lisp COD-61: ~A~%" condition)
        (uiop:quit 1)))
    (format t "CRC32C 16/32: ~A; ~D casi, ~D finestre.~%"
            (getf *report* :status) (getf *report* :cases) (length (getf *report* :windows)))))

(unless (member :arcdocdb-crc32c32-library *features*) (main))
