;;;; C4: un passo senza attesa, una sola syscall, deadline assoluta iniettata.
;;; OWNER: un solo compito conserva FD/buffer fino allo stato terminale.
;;; REQ: REQ-VAL-001 REQ-IPC-002
(in-package #:arcdocdb.spk11)
(declaim (optimize (safety 3) (speed 2) (debug 2)))

(defstruct (io-span (:constructor %make-io-span
                      (fd buffer start end direction chunk until now backend))
                    (:copier nil))
  (fd 0 :type io-fd :read-only t)
  (buffer (make-array 0 :element-type '(unsigned-byte 8)) :type io-octets :read-only t)
  (start 0 :type io-index :read-only t)
  (end 0 :type io-index :read-only t)
  (direction :input :type (member :input :output) :read-only t)
  (chunk 1 :type io-index :read-only t)
  (until 0 :type io-index :read-only t)
  (now 0 :type io-index)
  (backend nil :type (or null function) :read-only t)
  (cursor 0 :type io-index)
  (calls 0 :type io-index)
  (errno 0 :type fixnum)
  (state :active :type (member :active :done :eof :faulted :expired)))

(defun make-io-span (fd buffer start end direction chunk until now &optional backend)
  "Verifica l'intera regione prima del primo accesso nativo; nessun buffer creato."
  (demand (and (typep fd 'io-fd) (typep buffer 'io-octets)
               (typep start 'io-index) (typep end 'io-index)
               (< start end) (<= end (length buffer))) :io-span-range)
  (demand (member direction '(:input :output)) :io-direction)
  (demand (and (typep chunk 'io-index) (plusp chunk)) :io-chunk)
  (demand (and (typep until 'io-index) (typep now 'io-index) (<= now until)) :io-clock)
  (demand (or (null backend) (functionp backend)) :io-backend)
  (let ((span (%make-io-span fd buffer start end direction chunk until now backend)))
    (setf (io-span-cursor span) start)
    span))

(declaim (ftype (function (io-span (signed-byte 64) fixnum io-index) keyword)
                io-result))
(defun io-result (span n errno count)
  "Conferma solo progresso valido; EAGAIN/EINTR non avanzano ne ritentano."
  (unless (and (<= -1 n count) (<= 0 errno)
               (if (= n -1) (plusp errno) (zerop errno)))
    (setf (io-span-state span) :faulted)
    (error 'rejection :reason :io-result))
  (setf (io-span-errno span) errno)
  (cond
    ((plusp n)
     (incf (io-span-cursor span) n)
     (if (= (io-span-cursor span) (io-span-end span))
         (setf (io-span-state span) :done) :progress))
    ((zerop n)
     (setf (io-span-state span) (if (eq (io-span-direction span) :input) :eof :faulted)))
    ((or (= errno sb-posix:eagain) (= errno sb-posix:ewouldblock)) :would-block)
    ((= errno sb-posix:eintr) :interrupted)
    (t (setf (io-span-state span) :faulted))))

(declaim (ftype (function (io-span io-index) keyword) io-step))
(defun io-step (span now)
  "Un passo finito, nessun attendi/retry interno. Il caller conserva FD e buffer.
Terminale => nessuna chiamata; clock non monotono => rifiuto prima del backend."
  (unless (eq (io-span-state span) :active) (return-from io-step (io-span-state span)))
  (demand (>= now (io-span-now span)) :io-clock)
  (setf (io-span-now span) now)
  (when (>= now (io-span-until span))
    (return-from io-step (setf (io-span-state span) :expired)))
  (let* ((count (min (io-span-chunk span) (- (io-span-end span) (io-span-cursor span))))
         (function (or (io-span-backend span)
                       (if (eq (io-span-direction span) :input)
                           #'native-recv-span #'native-send-span))))
    (incf (io-span-calls span))
    (multiple-value-bind (n errno)
        (funcall function (io-span-fd span) (io-span-buffer span) (io-span-cursor span) count)
      (unless (and (typep n '(signed-byte 64)) (typep errno 'fixnum))
        (setf (io-span-state span) :faulted)
        (error 'rejection :reason :io-result))
      (io-result span n errno count))))
