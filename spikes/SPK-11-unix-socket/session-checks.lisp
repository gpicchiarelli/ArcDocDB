;;;; C4: fixture congelate, transizioni finite e controlli negativi della proposta.
;;; REQ: REQ-VAL-001 REQ-IPC-002 REQ-IPC-004
(in-package #:arcdocdb.spk11)
(declaim (optimize (safety 3) (debug 3)))

(defun codec-rejection (reason thunk)
  "Ragione precisa del codec comune; errori estranei non diventano successi."
  (demand (handler-case (progn (funcall thunk) nil)
            (arcdocdb.conditions:arcdocdb-error (condition)
              (eq reason (arcdocdb.conditions:error-reason condition)))) :missing-codec-rejection))

(defun check-session-wire ()
  (same-frames (list (hello-wire)) (list (bytes #x85 1 0 0 0 #xa2 0 #x19 #x20 0 1 2)))
  (same-frames (list (welcome-wire 4096 2 t))
               (list (bytes #x85 1 1 0 0 #xa3 0 #x19 #x10 0 1 2 2 #x81 0)))
  (same-frames (list (frame (ping 1))) (list (bytes 0 0 0 6 #x85 1 2 1 0 #xf6)))
  (dolist (id '(1 23 24 255 256 65535 65536 4294967295 4294967296 18446744073709551615))
    (demand (= id (getf (decode-control (control-wire 2 id 0 (bytes #xf6))) :id)) :uint-roundtrip))
  (same-frames (list (uint-wire #xffffffffffffffff))
               (list (bytes #x1b #xff #xff #xff #xff #xff #xff #xff #xff)))
  (dolist (pair (list (list :control-envelope (bytes #x84 1 2 1 #xf6))
                      (list :control-version (bytes #x85 2 2 1 0 #xf6))
                      (list :control-uint (bytes #x85 1 #x20 1 0 #xf6))
                      (list :request-id (bytes #x85 1 2 0 0 #xf6))
                      (list :response-status (bytes #x85 1 3 1 6 #xf6))))
    (expect-rejection (first pair) (lambda () (decode-control (second pair)))))
  (codec-rejection :cbor-nonminimal (lambda () (decode-control (bytes #x85 #x18 1 2 1 0 #xf6))))
  (codec-rejection :cbor-trailing (lambda () (decode-control (bytes #x85 1 2 1 0 #xf6 0))))
  t)

(defun check-session-maps ()
  ;; Ordine bytewise: uint24 (1818) precede -1 (20), anche con lunghezza maggiore.
  (decode-control (control-wire 2 1 7 (bytes #xa2 #x18 #x18 0 #x20 0)))
  (dolist (payload (list (bytes #xa2 #x20 0 #x18 #x18 0) (bytes #xa2 0 1 0 2)
                         (bytes #x81 #xa2 1 #xf6 0 #xf6)))
    (expect-rejection :control-map-order (lambda () (decode-control (control-wire 2 1 7 payload)))))
  (expect-rejection :hello-map (lambda () (decode-control (control-wire 0 0 0 (bytes #xa2 0 #x19 #x10 0 2 1)))))
  (expect-rejection :welcome-opcodes
                    (lambda () (decode-control (control-wire 1 0 0 (bytes #xa3 0 #x19 #x10 0 1 2 2 #x82 0 0)))))
  (let* ((payload (make-array 1025 :element-type '(unsigned-byte 8) :initial-element #xc0))
         (message nil))
    (setf (aref payload 1024) #xf6 message (control-wire 2 1 7 payload))
    (decode-control message)) ; mille tag consecutivi non creano ricorsione Lisp.
  (let ((payload (bytes #xf6)))
    (dotimes (i 8) (setf payload (concatenate '(simple-array (unsigned-byte 8) (*)) (bytes #x81) payload)))
    (codec-rejection :cbor-depth-budget (lambda () (decode-control (control-wire 2 1 7 payload)))))
  t)

(defun check-session-negotiation ()
  (let ((session (make-model-session)))
    (let ((response (decode-control (model-hello session (hello-wire +frame-limit+ 16) 1))))
      (demand (and (= 4096 (getf response :max-frame)) (= 2 (getf response :max-inflight))
                   (equal '(0) (getf response :opcodes))) :negotiation))
    (expect-rejection :request-state (lambda () (model-request session (ping 1) 1)))
    (model-welcome-sent session 1)
    (expect-rejection :hello-state (lambda () (model-hello session (hello-wire) 1)))
    (expect-rejection :request-kind (lambda () (model-request session (hello-wire) 1))))
  (dolist (pair (list (list :hello-frame (hello-wire 4095 1))
                      (list :hello-inflight (hello-wire 4096 0))
                      (list :control-uint-limit (hello-wire 4096 17))))
    (expect-rejection (first pair) (lambda () (decode-control (second pair)))))
  (let ((session (make-model-session :gate-open nil)))
    (demand (null (getf (decode-control (model-hello session (hello-wire) 0)) :opcodes)) :gate-capabilities)
    (model-welcome-sent session 0) (model-request session (ping 1) 0)
    (let ((message (decode-control (subseq (model-response session 1) 4))))
      (demand (and (= 3 (getf message :code)) (zerop (model-session-calls session))) :gate-admission)))
  t)

(defun check-session-credit ()
  (let ((session (model-ready)))
    (model-request session (ping 1) 0) (model-request session (ping 2) 0)
    (demand (and (eq :paused (model-request session (ping 3) 0)) (= 2 (model-session-last-id session))) :inflight-limit)
    (model-sent session 2 9 1)
    (demand (and (= 2 (hash-table-count (model-session-pending session)))
                 (= 20 (model-session-queued-bytes session))) :partial-credit)
    (model-sent session 2 1 1)
    (demand (= 3 (model-request session (ping 3) 1)) :credit-returned)
    (model-sent session 1 10 1)
    (expect-rejection :response-unknown (lambda () (model-sent session 1 0 1)))
    (expect-rejection :request-order (lambda () (model-request session (ping 1) 1))))
  (let ((session (model-ready :output-capacity 9)))
    (demand (eq :paused (model-request session (ping 1) 0)) :output-limit)
    (demand (and (zerop (model-session-last-id session)) (zerop (model-session-calls session))
                 (zerop (hash-table-count (model-session-pending session)))) :budget-before-admission)
    (setf (model-session-output-capacity session) 10)
    (demand (= 1 (model-request session (ping 1) 0)) :output-exact))
  (let ((state (make-decoder :limit 4096)))
    (expect-rejection :length (lambda () (feed state (prefix 4097) 0 4)))
    (demand (and (null (decoder-body state)) (zerop (decoder-allocations state))) :handshake-before-allocation))
  t)

(defun check-session-correlation ()
  (let ((client (make-model-client)))
    (model-issued client 1) (model-issued client 2)
    (model-received client (ping 2 3)) (model-received client (ping 1 3))
    (demand (equal '(2 1) (reverse (model-client-completed client))) :reply-order)
    (expect-rejection :client-unknown-response (lambda () (model-received client (ping 1 3))))
    (expect-rejection :client-unknown-response (lambda () (model-received client (ping 3 3)))))
  (let* ((session (model-ready)) (last #xffffffffffffffff))
    (demand (= last (model-request session (control-wire 2 last 0 (bytes #xf6)) 0)) :id-max)
    (demand (eq :draining (model-request session (ping 1) 0)) :id-no-wrap)
    (expect-rejection :request-state (lambda () (model-start-frame session 0)))
    (model-sent session last (length (model-response session last)) 0)
    (demand (eq :reconnect (model-session-state session)) :id-reconnect))
  (let ((session (model-ready)))
    (model-request session (control-wire 2 1 0 (bytes 0)) 0)
    (demand (= 1 (getf (decode-control (subseq (model-response session 1) 4)) :code)) :invalid-arguments)
    (model-request session (control-wire 2 2 42 (bytes #xa1 0 #xf6)) 0)
    (demand (= 4 (getf (decode-control (subseq (model-response session 2) 4)) :code)) :unsupported)
    (demand (zerop (model-session-calls session)) :errors-before-admission))
  t)

(defun check-session-time ()
  (let ((session (make-model-session)))
    (model-hello session (hello-wire) 4)
    (expect-rejection :hello-deadline (lambda () (model-welcome-sent session 5))))
  (let ((session (model-ready)))
    (demand (= 31 (model-start-frame session 1)) :frame-start)
    (demand (= 31 (model-start-frame session 30)) :frame-no-renew)
    (expect-rejection :frame-deadline (lambda () (model-time session 31))))
  (let ((session (model-ready)))
    (model-request session (ping 1) 1) (model-sent session 1 1 30)
    (expect-rejection :output-deadline (lambda () (model-sent session 1 1 31))))
  (let ((session (model-ready)))
    (model-time session 2)
    (expect-rejection :clock-regression (lambda () (model-time session 1))))
  t)

(defun check-session-isolation ()
  (let ((left (model-ready :server-inflight 1)) (right (model-ready :server-inflight 1)))
    (model-request left (ping 1) 0)
    (demand (eq :paused (model-request left (ping 2) 0)) :left-saturated)
    (demand (= 1 (model-request right (ping 1) 0)) :right-independent)
    (demand (not (eq (model-session-pending left) (model-session-pending right))) :owners-disjoint)
    (model-sent right 1 10 0)
    (demand (= 10 (model-session-queued-bytes left)) :owner-credit-independent))
  t)

(defun check-session-sensitivity ()
  (expect-rejection :negotiation-oracle
                    (lambda () (demand (= 4096 (getf (decode-control (welcome-wire 8192 2 t)) :max-frame))
                                       :negotiation-oracle)))
  (let ((session (model-ready)))
    (model-request session (ping 1) 0) (remhash 1 (model-session-pending session))
    (expect-rejection :credit-oracle
                      (lambda () (demand (= 1 (hash-table-count (model-session-pending session))) :credit-oracle))))
  (let ((session (model-ready)))
    (model-start-frame session 1) (setf (model-session-frame-until session) 60)
    (expect-rejection :deadline-oracle (lambda () (demand (= 31 (model-session-frame-until session)) :deadline-oracle))))
  (let ((original (symbol-function 'encoded-key-less-p)))
    (unwind-protect
         (progn
           (setf (symbol-function 'encoded-key-less-p) (lambda (&rest arguments) (declare (ignore arguments)) t))
           (expect-rejection :missing-rejection
                             (lambda () (expect-rejection :control-map-order
                                                         (lambda () (decode-control (control-wire 2 1 7 (bytes #xa2 0 1 0 2))))))))
      (setf (symbol-function 'encoded-key-less-p) original)))
  t)

(defun check-session ()
  "Otto famiglie finite; le fixture e il metodo precedono l'esecuzione."
  (let ((cases nil))
    (dolist (function '(check-session-wire check-session-maps check-session-negotiation check-session-credit
                        check-session-correlation check-session-time check-session-isolation check-session-sensitivity))
      (demand (funcall function) :session-case)
      (push (list :case (symbol-name function) :status :ok) cases))
    (list :status :ok :cases (nreverse cases) :sensitivity-controls 4 :profile-bytes 4096
          :limits '(:c4-model :simulated-gate-and-clock :no-engine :no-production-allocation-claim))))
