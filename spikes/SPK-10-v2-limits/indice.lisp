                                          (assert (not (inserisci-fixture i k 2))))))
      (assert (= csn 2)) (assert (= loc #xffffffff00000002))
      (assert (= len 41)) (assert (eq stato :hit)) (assert (= scartati 1)))
    (let* ((f (radice-frammento (indice-root i))) (s (cerca-writer f k (hash-chiave k)))
           (slots (frammento-slots f)) (pos (+ (* s 5) 3)) (seq (aref slots pos)))
      (setf (aref slots pos) (1+ seq))
      (unwind-protect
           (dolist (n '(1 8))
             (multiple-value-bind (csn loc len stato scartati) (leggi i k :attempts n)
               (assert (zerop csn)) (assert (zerop loc)) (assert (zerop len))
               (assert (eq stato :retry-limit)) (assert (= scartati n))))
        (setf (aref slots pos) seq))
      (setf (aref slots pos) (- +soglia-seq+ 2))
      (assert (not (inserisci-fixture i k 3)))
      (assert (= (indice-rebuild i) 1))
      (verifica-entry i k 3 #xffffffff00000003 41))
    (let ((valore 3))
      (assert (eq :retry-limit
                  (nth-value 3 (leggi i k :after-fields
                                     (lambda (f s) (assert (frammento-p f)) (assert (>= s 0))
                                       (incf valore) (inserisci-fixture i k valore))))))
      (assert (= valore 11)))
    (verifica-rifiuto i (lambda () (leggi i k :attempts 9)) :type-error)
    (verifica-rifiuto i (lambda () (leggi i k :attempts 0)) :type-error)
    (list :status :ok :odd-counter-attempts '(1 8) :field-race-retries 1
          :continuous-update-attempts 8 :threshold-rebuilds 1)))
(declaim (ftype (function () list) test-req-idx-007-root))
(defun test-req-idx-007-root ()
  "Scarta hit e miss della root ritirata e limita i cambiamenti ripetuti della root."
  (let* ((i (make-indice :capacity 8)) (k (chiave-fixture 16 1))
         (nuova (chiave-fixture 16 2)) (una-volta nil) (ritirato nil))
    (assert (inserisci-fixture i k 1))
    (multiple-value-bind (csn loc len stato scartati)
        (leggi i k :after-fragment
               (lambda (f) (unless una-volta
                             (setf una-volta t ritirato f)
                             (inserisci-fixture i k 2)
                             (ricostruisci i (indice-root i) -1)
                             (inserisci-fixture i k 3))))
      (assert (= csn 3)) (assert (= loc #xffffffff00000003))
      (assert (= len 41)) (assert (eq stato :hit)) (assert (= scartati 1)))
    (assert (= 2 (nth-value 0 (sonda-reader ritirato k (hash-chiave k) nil))))
    (setf una-volta nil)
    (multiple-value-bind (csn loc len stato scartati)
        (leggi i nuova :after-fragment
               (lambda (f) (assert (frammento-p f))
                 (unless una-volta (setf una-volta t)
                         (ricostruisci i (indice-root i) -1)
                         (inserisci-fixture i nuova 4))))
      (assert (= csn 4)) (assert (= loc #xffffffff00000004))
      (assert (= len 41)) (assert (eq stato :hit)) (assert (= scartati 1)))
    (multiple-value-bind (csn loc len stato scartati)
        (leggi i k :after-fragment (lambda (f) (assert (frammento-p f))
                                    (ricostruisci i (indice-root i) -1)))
      (assert (zerop csn)) (assert (zerop loc)) (assert (zerop len))
      (assert (eq stato :retry-limit)) (assert (= scartati 8)))
    (let* ((r (indice-root i)) (f (radice-frammento r))
           (s (cerca-writer f k (hash-chiave k))))
      (setf (indice-root i) (%radice +mask64+ f)
            (aref (frammento-slots f) (+ (* s 5) 3)) (- +soglia-seq+ 2))
      (verifica-rifiuto i (lambda () (inserisci-fixture i k 5)) :generazione-root))
    (list :status :ok :retired-hit-retries 1 :retired-miss-retries 1
          :continuous-root-attempts 8 :generation-wrap-rejected t)))

;;; REQ: REQ-LIM-003 REQ-IDX-003 REQ-IDX-005
(declaim (ftype (function (indice ottetti hash-table) null) verifica-oracolo))
(defun verifica-oracolo (i k riferimento)
  "L'oracolo equalp confronta CSN, location e lunghezza dopo ogni operazione."
  (multiple-value-bind (atteso presente) (gethash k riferimento)
    (multiple-value-bind (csn loc len stato scartati) (leggi i k)
      (assert (zerop scartati))
      (if presente
          (progn (assert (eq stato :hit))
                 (assert (equalp atteso (list csn loc len))))
          (progn (assert (eq stato :miss)) (assert (zerop csn))
                 (assert (zerop loc)) (assert (zerop len))))))
  nil)
(declaim (ftype (function () list) test-req-idx-005-differenziale))
(defun test-req-idx-005-differenziale ()
  "600 operazioni, seed fisso, 64 chiavi con quattro lunghezze e CSN alti."
  (let ((i (make-indice :capacity 128)) (riferimento (make-hash-table :test 'equalp))
        (chiavi (make-array 64)) (seed 424242) (scritture 0) (eliminazioni 0) (letture 0))
    (dotimes (n 64)
      (setf (aref chiavi n) (chiave-fixture (nth (mod n 4) '(1 255 256 65535)) n)))
    (dotimes (passo 600)
      (setf seed (logand #xffffffff (+ (* seed 1664525) 1013904223)))
      (let* ((k (aref chiavi (ldb (byte 6 16) seed)))
             (operazione (mod seed 3)) (presente (nth-value 1 (gethash k riferimento))))
        (case operazione
          (0 (let* ((csn (- +mask64+ passo)) (seg (- #xffffffff passo))
                    (off (+ passo 7)) (len (+ 24 (length k) (mod passo 100))))
               (assert (eq (inserisci i k csn seg off len) (not presente)))
               (setf (gethash (copy-seq k) riferimento) (list csn (logior (ash seg 32) off) len))
               (incf scritture)))
          (1 (assert (eq (elimina i k) presente)) (remhash k riferimento) (incf eliminazioni))
          (2 (incf letture))
          (otherwise (rifiuta :invariante-fixture)))
        (verifica-oracolo i k riferimento)
        (assert (= (hash-table-count riferimento)
                   (frammento-vivi (radice-frammento (indice-root i)))))))
    (dotimes (n 64) (verifica-oracolo i (aref chiavi n) riferimento))
    (list :status :ok :seed 424242 :operations 600 :oracle-comparisons 664
          :write-requests scritture :delete-requests eliminazioni :read-requests letture
          :key-lengths '(1 255 256 65535) :statistics (statistiche i))))

(declaim (ftype (function () list) check))
(defun check ()
  "Suite corta bounded: restituisce conteggi e limiti; un errore non ritorna :ok."
  (let* ((inizio (get-internal-real-time))
         (risultati (list (test-req-lim-001-layout) (test-req-lim-003-hash)
                          (test-req-lim-003-confronto) (test-req-lim-003-budget)
                          (test-req-idx-005-churn) (test-req-idx-003-seqlock)
                          (test-req-idx-007-root) (test-req-idx-005-differenziale))))
    (list :status :ok :module :indice :format-version 2 :test-groups (length risultati)
          :differential-operations 600 :oracle-comparisons 664 :churn-cycles 64
          :limits (list :document-bytes +documento-max+ :key-bytes +chiave-max+
                        :max-record-bytes +record-max+ :slot-words +parole-slot+
                        :bytes-per-slot +byte-slot+ :reader-attempts 8
                        :check-capacity-max 128 :check-differential-keys 64
                        :copy-block-bytes +blocco+ :arena-growth-steps 33)
          :seconds (secondi (- (get-internal-real-time) inizio)) :tests risultati
          :pending '(:split :extendible-directory :retained-versions :writer-fallback
                     :memory-model-arm64-x86-64 :production-commit :v2-gate))))

;;;; Benchmark solo su richiesta del parent: limiti complessivi cooperativi.
(declaim (ftype (function (ottetti u64) null) cambia-id))
(defun cambia-id (chiave id)
  "Riusa il buffer della fixture; ultimi otto byte little endian dal fondo."
  (declare (type ottetti chiave) (type u64 id))
  (dotimes (n 8) (setf (aref chiave (- (length chiave) n 1)) (ldb (byte 8 (* n 8)) id)))
  nil)
(declaim (ftype (function (indice ottetti fixnum integer) fixnum) bench-inserimenti))
(defun bench-inserimenti (i chiave massimo scadenza)
  "Conta soltanto gli inserimenti terminati; termine globale prima di ogni operazione."
  (let ((completati 0))
    (dotimes (n massimo completati)
      (when (>= (get-internal-real-time) scadenza) (return completati))
      (cambia-id chiave n)
      (assert (inserisci-fixture i chiave (1+ n)))
      (incf completati))))
(declaim (ftype (function (indice ottetti fixnum integer)
                         (values fixnum fixnum fixnum u32)) bench-letture-modifiche))
(defun bench-letture-modifiche (i chiave documenti scadenza)
  "Letture, aggiornamenti e churn bounded; durata e conteggi effettivi esterni."
  (let ((letture 0) (aggiornamenti 0) (churn 0) (sink 0))
    (declare (type u32 sink))
    (dotimes (n documenti)
      (when (>= (get-internal-real-time) scadenza) (return))
      (cambia-id chiave n)
      (multiple-value-bind (csn loc len stato scartati) (leggi i chiave)
        (assert (eq stato :hit)) (assert (zerop scartati))
        (assert (= loc (logior #xffffffff00000000 (1+ n))))
        (assert (= len (+ +header+ (length chiave) 1)))
        (setf sink (logxor sink (ldb (byte 32 0) csn))))
      (incf letture))
    (dotimes (n documenti)
      (when (>= (get-internal-real-time) scadenza) (return))
      (cambia-id chiave n)
      (assert (not (inserisci-fixture i chiave (+ 1 documenti n))))
      (incf aggiornamenti))
    (dotimes (n (min documenti 64))
      (when (>= (get-internal-real-time) scadenza) (return))
      (cambia-id chiave n)
      (assert (elimina i chiave))
      ;; Il reinserimento fa parte della stessa iterazione bounded di churn.
      (assert (inserisci-fixture i chiave (+ 1 (* 2 documenti) n)))
      (incf churn))
    (values letture aggiornamenti churn sink)))
(declaim (ftype (function (fixnum fixnum fixnum integer) list) bench-caso))
(defun bench-caso (len massimo capacita scadenza)
  "Un frammento dimensionato per il carico; niente split nascosti nel benchmark."
  (let* ((inizio (get-internal-real-time)) (allocazioni (sb-ext:get-bytes-consed))
         (i (make-indice :capacity capacita :max-arena-bytes 16777216
                         :copy-byte-budget 16777216
                         :transient-byte-budget +memoria-bench-max+))
         (chiave (chiave-fixture len 0))
         (inseriti (bench-inserimenti i chiave massimo scadenza)))
    (multiple-value-bind (letture aggiornamenti churn sink)
        (bench-letture-modifiche i chiave inseriti scadenza)
      (list :status :ok :key-bytes len :requested-documents massimo :inserted-documents inseriti
            :read-operations letture :update-operations aggiornamenti :churn-cycles churn
            :operations (+ inseriti letture aggiornamenti (* 2 churn)) :sink sink
            :seconds (secondi (- (get-internal-real-time) inizio))
            :bytes-consed (- (sb-ext:get-bytes-consed) allocazioni)
            :statistics (statistiche i)))))
(declaim (ftype (function (&key (:seconds real)) list) benchmark))
(defun benchmark (&key (seconds 3))
  "Massimi 10000/1000/64 documenti, chiavi16/256/65535, budget globale <=3s cooperativo.
Restituisce i conteggi misurati; nessuna stima di throughput o gate di produzione."
  (unless (typep seconds '(real 0 3))
    (error 'type-error :datum seconds :expected-type '(real 0 3)))
  (let* ((inizio (get-internal-real-time))
         (scadenza (+ inizio (floor (* seconds internal-time-units-per-second))))
         (casi (list (bench-caso 16 10000 16384 scadenza)
                     (bench-caso 256 1000 2048 scadenza)
                     (bench-caso 65535 64 128 scadenza)))
         (durata (secondi (- (get-internal-real-time) inizio))))
    (list :status :ok :module :indice :cases casi :seconds durata
          :operations (loop for caso in casi sum (getf caso :operations))
          :limits (list :seconds seconds :time-budget :cooperative-wall
                        :key-bytes '(16 256 65535) :documents '(10000 1000 64)
                        :transient-bytes +memoria-bench-max+ :capacity-max 16384)
          :deadline-overrun-seconds (max 0d0 (- durata (coerce seconds 'double-float)))
          :memory-accounting :array-payload :split-implemented nil
          :production-commit nil :v2-gate-completed nil)))
