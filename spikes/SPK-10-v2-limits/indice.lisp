;;;; SPK-10, esperimento C4: frammento primario v2, non motore di produzione.
(defpackage #:arcdocdb.spk10.indice
  (:use #:cl)
  (:export #:check #:benchmark #:make-indice #:inserisci #:elimina #:leggi
           #:statistiche #:limite-indice #:limite-motivo))
(in-package #:arcdocdb.spk10.indice)
(declaim (optimize (safety 3) (speed 2) (debug 1)))

(deftype u32 () '(unsigned-byte 32))
(deftype u64 () '(unsigned-byte 64))
(deftype ottetti () '(simple-array (unsigned-byte 8) (*)))
(deftype parole () '(simple-array (unsigned-byte 64) (*)))
(defconstant +mask64+ #xffffffffffffffff)
(defconstant +seed+ #xcbf29ce484222325)
(defconstant +prime+ #x100000001b3)
(defconstant +documento-max+ 16777216)
(defconstant +chiave-max+ 65535)
(defconstant +header+ 24)
(defconstant +record-max+ 16842775)
(defconstant +parole-slot+ 5)
(defconstant +byte-slot+ 41)
(defconstant +vuoto+ 255)
(defconstant +eliminato+ 254)
(defconstant +gruppo+ 8)
(defconstant +blocco+ 4096)
(defconstant +soglia-seq+ #x4000000000000000)
(defconstant +memoria-bench-max+ 134217728)

(define-condition limite-indice (error)
  ((motivo :initarg :motivo :reader limite-motivo))
  (:report (lambda (c s) (format s "Limite SPK-10 indice: ~S" (limite-motivo c)))))

;;; OWNER: un writer per indice; reader leggono soltanto array e root.
;;; SHARED: nessuno stato tra Serie. Seriali preparazione e pubblicazione writer.
;;; REQ: REQ-LIM-001 REQ-LIM-003 REQ-IDX-003 REQ-IDX-005 REQ-IDX-007
(defstruct (frammento (:constructor %frammento))
  (capacita 8 :type fixnum :read-only t)
  (ctrl (make-array 0 :element-type '(unsigned-byte 8)) :type ottetti :read-only t)
  (slots (make-array 0 :element-type '(unsigned-byte 64)) :type parole :read-only t)
  (arena (make-array 0 :element-type '(unsigned-byte 8)) :type ottetti)
  (usati 0 :type fixnum)
  (vivi 0 :type fixnum)
  (morti 0 :type fixnum)
  (byte-vivi 0 :type fixnum))
(defstruct (radice (:constructor %radice (generazione frammento)))
  (generazione 0 :type u64 :read-only t)
  (frammento (%frammento) :type frammento :read-only t))
(defstruct (indice (:constructor %indice))
  (root (%radice 0 (%frammento)) :type radice)
  (max-chiave +chiave-max+ :type fixnum :read-only t)
  (max-documento +documento-max+ :type fixnum :read-only t)
  (max-arena 8388608 :type fixnum :read-only t)
  (budget-copia 16777216 :type fixnum :read-only t)
  (budget-transitorio +memoria-bench-max+ :type fixnum :read-only t)
  (budget-ticks 500000 :type integer :read-only t)
  (clock #'get-internal-real-time :type function :read-only t)
  (inserimenti 0 :type integer) (aggiornamenti 0 :type integer)
  (eliminazioni 0 :type integer) (rebuild 0 :type integer)
  (crescite 0 :type integer) (byte-copiati 0 :type integer)
  (max-byte-copiati 0 :type fixnum) (max-slot-visitati 0 :type fixnum)
  (max-slot-copiati 0 :type fixnum) (max-riferimenti 0 :type fixnum)
  (picco-payload 0 :type fixnum) (picco-transitorio 0 :type fixnum)
  (max-preparazione-ticks 0 :type integer))

(declaim (ftype (function (t integer integer) integer) intero-limitato))
(defun intero-limitato (x minimo massimo)
  "Controlla un intervallo senza coercizioni o troncamenti."
  (unless (typep x `(integer ,minimo ,massimo))
    (error 'type-error :datum x :expected-type `(integer ,minimo ,massimo)))
  x)
(declaim (ftype (function (keyword) nil) rifiuta))
(defun rifiuta (motivo)
  "Segnala un limite previsto; i chiamanti lo usano prima di pubblicare."
  (error 'limite-indice :motivo motivo))
(declaim (ftype (function (frammento) fixnum) payload))
(defun payload (f)
  "Payload degli array e un riferimento di directory; esclude header e RSS."
  (+ (* +byte-slot+ (frammento-capacita f)) (length (frammento-arena f)) 8))
(declaim (ftype (function (fixnum fixnum) frammento) nuovo-frammento))
(defun nuovo-frammento (capacita arena-byte)
  "Alloca array specializzati; il frammento è inizialmente fuori dalla root."
  (%frammento :capacita capacita
              :ctrl (make-array capacita :element-type '(unsigned-byte 8)
                                        :initial-element +vuoto+)
              :slots (make-array (* capacita +parole-slot+)
                                 :element-type '(unsigned-byte 64) :initial-element 0)
              :arena (make-array arena-byte :element-type '(unsigned-byte 8)
                                           :initial-element 0)))

(declaim (ftype (function (&key (:capacity integer) (:max-key-bytes integer)
                               (:max-document-bytes integer) (:max-arena-bytes integer)
                               (:copy-byte-budget integer) (:transient-byte-budget integer)
                               (:maintenance-seconds real) (:clock function)) indice)
                make-indice))
(defun make-indice (&key (capacity 16384) (max-key-bytes +chiave-max+)
                        (max-document-bytes +documento-max+) (max-arena-bytes 8388608)
                        (copy-byte-budget 16777216)
                        (transient-byte-budget +memoria-bench-max+)
                        (maintenance-seconds 1/2) (clock #'get-internal-real-time))
  "Un frammento, arena vuota. Budget di copie e memoria in byte; tempo cooperativo."
  (intero-limitato capacity 8 32768)
  (unless (= 1 (logcount capacity)) (rifiuta :capacita-non-potenza-di-due))
  (intero-limitato max-key-bytes 1 +chiave-max+)
  (intero-limitato max-document-bytes 1 +documento-max+)
  (intero-limitato max-arena-bytes 0 #xffffffff)
  (intero-limitato copy-byte-budget 0 most-positive-fixnum)
  (intero-limitato transient-byte-budget 0 most-positive-fixnum)
  (unless (typep maintenance-seconds '(real 0 3))
    (error 'type-error :datum maintenance-seconds :expected-type '(real 0 3)))
  (check-type clock function)
  (let ((byte (+ (* +byte-slot+ capacity) 8)))
    (when (> byte transient-byte-budget) (rifiuta :memoria-iniziale))
    (%indice :root (%radice 0 (nuovo-frammento capacity 0))
             :max-chiave max-key-bytes :max-documento max-document-bytes
             :max-arena max-arena-bytes :budget-copia copy-byte-budget
             :budget-transitorio transient-byte-budget :clock clock
             :budget-ticks (floor (* maintenance-seconds internal-time-units-per-second))
             :picco-payload byte :picco-transitorio byte)))

;;; REQ: REQ-LIM-003. Hash streaming senza subseq o vettori temporanei.
(declaim (inline hash-intervallo hash-chiave impronta posizione stessa-chiave-p metadata))
(declaim (ftype (function (ottetti fixnum fixnum) u64) hash-intervallo))
(defun hash-intervallo (arena off len)
  "FNV-1a u64 con seed fisso; attraversa esattamente LEN byte. Non crittografico."
  (declare (type ottetti arena) (type fixnum off len))
  (let ((h +seed+))
    (declare (type u64 h))
    (dotimes (n len h)
      (declare (type fixnum n))
      (setf h (logand +mask64+ (* +prime+ (logxor h (aref arena (+ off n)))))))))
(declaim (ftype (function (ottetti) u64) hash-chiave))
(defun hash-chiave (chiave)
  "Kernel tipizzato; la lunghezza non è limitata a sedici byte."
  (declare (type ottetti chiave))
  (hash-intervallo chiave 0 (length chiave)))
(declaim (ftype (function (u64) (unsigned-byte 7)) impronta))
(defun impronta (h)
  "Sette bit nel controllo; l'impronta non decide l'uguaglianza."
  (declare (type u64 h))
  (ldb (byte 7 0) h))
(declaim (ftype (function (u64 fixnum fixnum) fixnum) posizione))
(defun posizione (h capacita n)
  "Gruppi contigui da otto con wrap; al massimo CAPACITA slot."
  (declare (type u64 h) (type fixnum capacita n))
  (logand (1- capacita) (+ (logand (1- capacita) (ash h -7)) n)))
(declaim (ftype (function (ottetti ottetti fixnum fixnum) boolean) stessa-chiave-p))
(defun stessa-chiave-p (chiave arena off len)
  "Confronto binario completo, inclusi zero e byte sopra 127."
  (declare (type ottetti chiave arena) (type fixnum off len))
  (and (= (length chiave) len)
       (<= (+ off len) (length arena))
       (dotimes (n len t)
         (unless (= (aref chiave n) (aref arena (+ off n))) (return nil)))))
(declaim (ftype (function (u32 (unsigned-byte 16) (unsigned-byte 8)) u64) metadata))
(defun metadata (off len flag)
  "Parola 2: off32, len16, flag8, riservato8 zero."
  (declare (type u32 off) (type (unsigned-byte 16) len) (type (unsigned-byte 8) flag))
  (logior off (ash len 32) (ash flag 48)))
(declaim (ftype (function (indice ottetti) null) valida-chiave))
(defun valida-chiave (i chiave)
  "Rifiuta prima di hashing o allocazione; accetta solo ottetti specializzati."
  (check-type chiave ottetti)
  (unless (<= 1 (length chiave) (indice-max-chiave i)) (rifiuta :lunghezza-chiave))
  nil)
(declaim (ftype (function (indice ottetti t t t t) null) valida-entry))
(defun valida-entry (i chiave csn segmento off len)
  "CSN u64, segmento/offset/lunghezza u32, limite documentale sul totale record."
  (valida-chiave i chiave)
  (check-type csn u64)
  (check-type segmento u32)
  (check-type off u32)
  (check-type len u32)
  (let ((minimo (+ +header+ (length chiave))))
    (unless (<= minimo len (+ minimo (indice-max-documento i)))
      (rifiuta :lunghezza-record)))
  nil)

(declaim (ftype (function (frammento ottetti u64) (values fixnum boolean)) cerca-writer))
(defun cerca-writer (f chiave h)
  "Un writer; tombstone riusabile e confronto di tutta la chiave."
  (let ((libero -1) (c (frammento-capacita f)) (ctrl (frammento-ctrl f)))
    (dotimes (g (/ c +gruppo+) (values libero nil))
      (dotimes (n +gruppo+)
        (let* ((s (posizione h c (+ (* g +gruppo+) n))) (b (* s +parole-slot+))
               (control (aref ctrl s)) (meta (aref (frammento-slots f) (+ b 2))))
          (when (= control +vuoto+)
            (return-from cerca-writer (values (if (minusp libero) s libero) nil)))
          (when (and (= control +eliminato+) (minusp libero)) (setf libero s))
          (when (and (= control (impronta h))
                     (stessa-chiave-p chiave (frammento-arena f)
                                     (ldb (byte 32 0) meta) (ldb (byte 16 32) meta)))
            (return-from cerca-writer (values s t))))))))
(declaim (ftype (function (frammento u64) fixnum) slot-vuoto))
(defun slot-vuoto (f h)
  "Solo costruzione di un frammento nuovo; visita al massimo C slot."
  (dotimes (n (frammento-capacita f))
    (let ((s (posizione h (frammento-capacita f) n)))
      (when (= +vuoto+ (aref (frammento-ctrl f) s)) (return-from slot-vuoto s))))
  (rifiuta :invariante-copia-satura))
(declaim (ftype (function (frammento fixnum u64 u64 u64 u32 u64) null) scrivi-campi))
(defun scrivi-campi (f s csn loc meta len h)
  "Pubblica campi sotto seqlock, poi controllo. Nessuna validazione tardiva."
  (let* ((slots (frammento-slots f)) (b (* s +parole-slot+))
         (seq (aref slots (+ b 3))))
    (assert (evenp seq))
    (assert (< seq (- +soglia-seq+ 2)))
    (setf (aref slots (+ b 3)) (1+ seq))
    (sb-thread:barrier (:write))
    (setf (aref slots b) csn (aref slots (+ b 1)) loc
          (aref slots (+ b 2)) meta (aref slots (+ b 4)) len)
    (sb-thread:barrier (:write))
    (setf (aref slots (+ b 3)) (+ seq 2))
    (sb-thread:barrier (:write))
    (setf (aref (frammento-ctrl f) s) (impronta h)))
  nil)
(declaim (ftype (function (indice) integer) ora))
(defun ora (i)
  "Clock di wall time in tick, iniettabile; valori non negativi."
  (let ((ticks (funcall (indice-clock i))))
    (check-type ticks (integer 0))
    ticks))
(declaim (ftype (function (indice integer) null) controlla-tempo))
(defun controlla-tempo (i scadenza)
  "Cooperativo; nessuna promessa sulla durata di allocazione, GC o scheduling."
  (when (>= (ora i) scadenza) (rifiuta :tempo-preparazione))
  nil)
(declaim (ftype (function (indice ottetti fixnum ottetti fixnum fixnum integer) null)
                copia-limitata))
(defun copia-limitata (i fonte off-fonte dest off-dest len scadenza)
  "Copia per blocchi di al massimo 4096 byte in un array ancora privato."
  (dotimes (blocco (ceiling len +blocco+))
    (controlla-tempo i scadenza)
    (let* ((off (* blocco +blocco+)) (fine (min len (+ off +blocco+))))
      (replace dest fonte :start1 (+ off-dest off) :end1 (+ off-dest fine)
                         :start2 (+ off-fonte off) :end2 (+ off-fonte fine))))
  nil)
(declaim (ftype (function (fixnum fixnum fixnum) fixnum) capacita-arena))
(defun capacita-arena (corrente richiesto massimo)
  "Raddoppio fino al tetto; al massimo 33 passi per il dominio u32."
  (when (> richiesto massimo) (rifiuta :arena))
  (let ((n corrente))
    (dotimes (passo 33)
      (when (>= n richiesto) (return-from capacita-arena n))
      (setf n (min massimo (max 32 (* 2 n)))))
    (rifiuta :invariante-crescita)))
(declaim (ftype (function (indice fixnum fixnum) null) preflight-byte))
(defun preflight-byte (i copie transitorio)
  "Nessun contatore o array mutato nei rifiuti di budget."
  (when (> copie (indice-budget-copia i)) (rifiuta :byte-copiati))
  (when (> transitorio (indice-budget-transitorio i)) (rifiuta :memoria-transitoria))
  nil)
(declaim (ftype (function (indice frammento frammento fixnum integer) fixnum) copia-vivi))
(defun copia-vivi (i fonte dest escluso scadenza)
  "Rebuild: C slot visitati, chiavi vive soltanto; hashing senza staging per entry."
  (let ((copiati 0) (slots (frammento-slots fonte)) (arena (frammento-arena fonte)))
    (dotimes (s (frammento-capacita fonte) copiati)
      (controlla-tempo i scadenza)
      (when (and (/= s escluso) (< (aref (frammento-ctrl fonte) s) 128))
        (let* ((b (* s +parole-slot+)) (meta (aref slots (+ b 2)))
               (off (ldb (byte 32 0) meta)) (len (ldb (byte 16 32) meta))
               (h (hash-intervallo arena off len)) (slot (slot-vuoto dest h))
               (nuovo-off (frammento-usati dest)))
          (copia-limitata i arena off (frammento-arena dest) nuovo-off len scadenza)
          (scrivi-campi dest slot (aref slots b) (aref slots (+ b 1))
                        (metadata nuovo-off len 1) (ldb (byte 32 0) (aref slots (+ b 4))) h)
          (incf (frammento-usati dest) len) (incf (frammento-byte-vivi dest) len)
          (incf (frammento-vivi dest)) (incf copiati))))))
(declaim (ftype (function (indice radice radice) null) pubblica-root))
(defun pubblica-root (i vecchia nuova)
  "CAS unico: confine di visibilità RAM, nessun commit durevole."
  (sb-thread:barrier (:write))
  (unless (eq vecchia (sb-ext:compare-and-swap (indice-root i) vecchia nuova))
    (rifiuta :violazione-writer-unico))
  nil)
(declaim (ftype (function (indice fixnum fixnum fixnum fixnum integer boolean boolean) null)
                registra-costi))
(defun registra-costi (i copie transitorio visitati copiati ticks rebuild crescita)
  "Solo dopo il successo; i reader non scrivono contatori comuni."
  (incf (indice-byte-copiati i) copie)
  (setf (indice-max-byte-copiati i) (max copie (indice-max-byte-copiati i))
        (indice-picco-transitorio i) (max transitorio (indice-picco-transitorio i))
        (indice-picco-payload i) (max (payload (radice-frammento (indice-root i)))
                                     (indice-picco-payload i))
        (indice-max-slot-visitati i) (max visitati (indice-max-slot-visitati i))
        (indice-max-slot-copiati i) (max copiati (indice-max-slot-copiati i))
        (indice-max-preparazione-ticks i) (max ticks (indice-max-preparazione-ticks i)))
  (when rebuild (incf (indice-rebuild i)) (setf (indice-max-riferimenti i) 1))
  (when crescita (incf (indice-crescite i)))
  nil)

(declaim (ftype (function (indice radice ottetti fixnum boolean) boolean) richiede-rebuild-p))
(defun richiede-rebuild-p (i root chiave s presente)
  "Pulizia tombstone/byte morti o ricambio seqlock; nessuna divisione implicita."
  (let ((f (radice-frammento root)))
    (or (and (>= s 0) (>= (aref (frammento-slots f) (+ (* s +parole-slot+) 3))
                              (- +soglia-seq+ 2)))
        (and (not presente)
             (or (>= (frammento-morti f) (/ (frammento-capacita f) 4))
                 (> (+ (frammento-usati f) (length chiave)) (indice-max-arena i))
                 (> (- (frammento-usati f) (frammento-byte-vivi f))
                    (max 1024 (frammento-byte-vivi f))))))))
(declaim (ftype (function (frammento fixnum ottetti u64 u64 u32 u64 boolean) null)
                termina-inserimento))
(defun termina-inserimento (f s copia csn loc len h presente)
  "Fase finale bounded: copia <=65535 byte, slot e contatori; preflight già completo."
  (let* ((control (aref (frammento-ctrl f) s)) (b (* s +parole-slot+))
         (off (if presente (ldb (byte 32 0) (aref (frammento-slots f) (+ b 2)))
                  (frammento-usati f)))
         (key-len (if presente (ldb (byte 16 32) (aref (frammento-slots f) (+ b 2)))
                      (length copia))))
    (unless presente
      (replace (frammento-arena f) copia :start1 off :end1 (+ off key-len))
      (incf (frammento-usati f) key-len) (incf (frammento-byte-vivi f) key-len)
      (incf (frammento-vivi f))
      (when (= control +eliminato+) (decf (frammento-morti f))))
    (scrivi-campi f s csn loc (metadata off key-len 1) len h))
  nil)
(declaim (ftype (function (indice radice ottetti fixnum boolean u64 u64 u32 u64) null)
                inserisci-diretto))
(defun inserisci-diretto (i root chiave s presente csn loc len h)
  "Prepara staging e possibile arena nuova, poi pubblica senza ulteriori rifiuti."
  (let* ((f (radice-frammento root)) (inizio (ora i))
         (scadenza (+ inizio (indice-budget-ticks i)))
         (key-len (if presente 0 (length chiave)))
         (vecchia (frammento-arena f))
         (cap (capacita-arena (length vecchia) (+ (frammento-usati f) key-len)
                             (indice-max-arena i)))
         (crescita (> cap (length vecchia)))
         (copie (+ (* 2 key-len) (if crescita (frammento-usati f) 0)))
         (transitorio (+ (payload f) key-len (if crescita cap 0))))
    (preflight-byte i copie transitorio)
    (controlla-tempo i scadenza)
    (let ((copia (make-array key-len :element-type '(unsigned-byte 8)))
          (arena (if crescita (make-array cap :element-type '(unsigned-byte 8)
                                            :initial-element 0) vecchia)))
      (copia-limitata i chiave 0 copia 0 key-len scadenza)
      (when crescita
        (copia-limitata i vecchia 0 arena 0 (frammento-usati f) scadenza))
      (let ((fine (ora i)))
        (when (>= fine scadenza) (rifiuta :tempo-preparazione))
        (when crescita
          (setf (frammento-arena f) arena)
          (sb-thread:barrier (:write)))
        (termina-inserimento f s copia csn loc len h presente)
        (registra-costi i copie transitorio 0 0 (- fine inizio) nil crescita))))
  nil)
(declaim (ftype (function (indice radice ottetti fixnum boolean u64 u64 u32 u64) null)
                inserisci-rebuild))
(defun inserisci-rebuild (i root chiave s presente csn loc len h)
  "Integra il nuovo inserimento nel rebuild privato: nessuno swap parziale su rifiuto."
  (declare (type fixnum s))
  (assert (>= s 0))
  (let* ((fonte (radice-frammento root)) (inizio (ora i))
         (scadenza (+ inizio (indice-budget-ticks i)))
         (key-len (if presente 0 (length chiave)))
         (cap (capacita-arena 0 (+ (frammento-byte-vivi fonte) key-len) (indice-max-arena i)))
         (copie (+ (frammento-byte-vivi fonte) (* 2 key-len)))
         (transitorio (+ (payload fonte) (* +byte-slot+ (frammento-capacita fonte))
                         cap 8 key-len)))
    (when (= (radice-generazione root) +mask64+) (rifiuta :generazione-root))
    (preflight-byte i copie transitorio)
    (controlla-tempo i scadenza)
    (let* ((dest (nuovo-frammento (frammento-capacita fonte) cap))
           (nuova (%radice (1+ (radice-generazione root)) dest))
           (copia (make-array key-len :element-type '(unsigned-byte 8)))
           (copiati (copia-vivi i fonte dest -1 scadenza)))
      (copia-limitata i chiave 0 copia 0 key-len scadenza)
      (multiple-value-bind (slot trovato) (cerca-writer dest chiave h)
        (assert (eq trovato presente))
        (assert (>= slot 0))
        (termina-inserimento dest slot copia csn loc len h presente))
      (let ((fine (ora i)))
        (when (>= fine scadenza) (rifiuta :tempo-preparazione))
        (pubblica-root i root nuova)
        (registra-costi i copie transitorio (frammento-capacita fonte) copiati
                        (- fine inizio) t nil))))
  nil)

;;; REQ: REQ-LIM-001 REQ-LIM-003 REQ-IDX-003 REQ-IDX-005 REQ-IDX-007
(declaim (ftype (function (indice ottetti u64 u32 u32 u32) boolean) inserisci))
(defun inserisci (i chiave csn segmento offset lunghezza)
  "Writer unico. T nuova entry, NIL aggiornamento; condizioni prima della mutazione.
LUNGHEZZA include header24 e chiave; il documento ammesso occupa <=16MiB.
Il chiamante mantiene CHIAVE stabile durante la chiamata; l'indice ne possiede la copia."
  (check-type i indice)
  (valida-entry i chiave csn segmento offset lunghezza)
  (let* ((root (indice-root i)) (f (radice-frammento root)) (h (hash-chiave chiave))
         (loc (logior (ash segmento 32) offset)))
    (multiple-value-bind (s presente) (cerca-writer f chiave h)
      (when (and (not presente) (>= (frammento-vivi f) (* 7 (/ (frammento-capacita f) 8))))
        (rifiuta :capacita-frammento))
      (when (minusp s) (rifiuta :sondaggio-saturo))
      (if (richiede-rebuild-p i root chiave s presente)
          (inserisci-rebuild i root chiave s presente csn loc lunghezza h)
          (inserisci-diretto i root chiave s presente csn loc lunghezza h))
      (if presente (incf (indice-aggiornamenti i)) (incf (indice-inserimenti i)))
      (not presente))))

(declaim (ftype (function (indice radice fixnum) null) ricostruisci))
(defun ricostruisci (i root escluso)
  "Manutenzione privata; ESCLUSO=-1 copia tutti, altrimenti completa l'eliminazione."
  (let* ((fonte (radice-frammento root)) (inizio (ora i))
         (scadenza (+ inizio (indice-budget-ticks i)))
         (rimossi (if (minusp escluso) 0
                      (ldb (byte 16 32) (aref (frammento-slots fonte)
                                            (+ (* escluso +parole-slot+) 2)))))
         (copie (- (frammento-byte-vivi fonte) rimossi))
         (cap (capacita-arena 0 copie (indice-max-arena i)))
         (transitorio (+ (payload fonte) (* +byte-slot+ (frammento-capacita fonte)) cap 8)))
    (when (= (radice-generazione root) +mask64+) (rifiuta :generazione-root))
    (preflight-byte i copie transitorio)
    (controlla-tempo i scadenza)
    (let* ((dest (nuovo-frammento (frammento-capacita fonte) cap))
           (nuova (%radice (1+ (radice-generazione root)) dest))
           (copiati (copia-vivi i fonte dest escluso scadenza)) (fine (ora i)))
      (when (>= fine scadenza) (rifiuta :tempo-preparazione))
      (pubblica-root i root nuova)
      (registra-costi i copie transitorio (frammento-capacita fonte) copiati
                      (- fine inizio) t nil)))
  nil)
(declaim (ftype (function (frammento fixnum) null) elimina-slot))
(defun elimina-slot (f s)
  "Elimina sotto seqlock; il controllo diventa tombstone, mai vuoto."
  (let* ((slots (frammento-slots f)) (b (* s +parole-slot+))
         (seq (aref slots (+ b 3))) (meta (aref slots (+ b 2))))
    (assert (evenp seq))
    (assert (< seq (- +soglia-seq+ 2)))
    (setf (aref slots (+ b 3)) (1+ seq))
    (sb-thread:barrier (:write))
    (setf (aref slots (+ b 2)) (logand meta #x0000ffffffffffff))
    (sb-thread:barrier (:write))
    (setf (aref slots (+ b 3)) (+ seq 2))
    (sb-thread:barrier (:write))
    (setf (aref (frammento-ctrl f) s) +eliminato+)
    (decf (frammento-vivi f)) (incf (frammento-morti f))
    (decf (frammento-byte-vivi f) (ldb (byte 16 32) meta)))
  nil)
(declaim (ftype (function (indice ottetti) boolean) elimina))
(defun elimina (i chiave)
  "T se eliminata, NIL assente; nessuno storage o conferma durable."
  (check-type i indice)
  (valida-chiave i chiave)
  (let* ((root (indice-root i)) (f (radice-frammento root)))
    (multiple-value-bind (s presente) (cerca-writer f chiave (hash-chiave chiave))
      (unless presente (return-from elimina nil))
      (if (>= (aref (frammento-slots f) (+ (* s +parole-slot+) 3)) (- +soglia-seq+ 2))
          (ricostruisci i root s)
          (elimina-slot f s))
      (incf (indice-eliminazioni i))
      t)))

;;; REQ: REQ-IDX-003 REQ-IDX-007
(declaim (ftype (function (frammento fixnum ottetti u64 (or null function))
                         (values u64 u64 u32 keyword)) leggi-slot))
(defun leggi-slot (f s chiave h dopo-campi)
  "Seqlock: pari, barriera, campi/arena/confronto, barriera, stesso contatore."
  (let* ((slots (frammento-slots f)) (b (* s +parole-slot+))
         (seq (aref slots (+ b 3))))
    (when (oddp seq) (return-from leggi-slot (values 0 0 0 :retry)))
    (sb-thread:barrier (:read))
    (let* ((csn (aref slots b)) (loc (aref slots (+ b 1)))
           (meta (aref slots (+ b 2))) (record (aref slots (+ b 4)))
           (ctrl (aref (frammento-ctrl f) s)) (arena (frammento-arena f))
           (match (and (= ctrl (impronta h)) (= 1 (ldb (byte 8 48) meta))
                       (zerop (ldb (byte 8 56) meta)) (zerop (ldb (byte 32 32) record))
                       (stessa-chiave-p chiave arena (ldb (byte 32 0) meta)
                                       (ldb (byte 16 32) meta)))))
      (when dopo-campi (funcall dopo-campi f s))
      (sb-thread:barrier (:read))
      (if (/= seq (aref slots (+ b 3))) (values 0 0 0 :retry)
          (values csn loc (ldb (byte 32 0) record) (if match :hit :skip))))))
(declaim (ftype (function (frammento ottetti u64 (or null function))
                         (values u64 u64 u32 keyword)) sonda-reader))
(defun sonda-reader (f chiave h dopo-campi)
  "Al più C controlli per tentativo, nessuna ricorsione o lock."
  (dotimes (g (/ (frammento-capacita f) +gruppo+) (values 0 0 0 :miss))
    (dotimes (n +gruppo+)
      (let* ((s (posizione h (frammento-capacita f) (+ (* g +gruppo+) n)))
             (ctrl (aref (frammento-ctrl f) s)))
        (when (= ctrl +vuoto+) (return-from sonda-reader (values 0 0 0 :miss)))
        (when (= ctrl (impronta h))
          (multiple-value-bind (csn loc len stato) (leggi-slot f s chiave h dopo-campi)
            (unless (eq stato :skip) (return-from sonda-reader (values csn loc len stato)))))))))
(declaim (ftype (function (indice ottetti &key (:attempts integer)
                         (:after-fragment (or null function)) (:after-fields (or null function)))
                         (values u64 u64 u32 keyword fixnum)) leggi))
(defun leggi (i chiave &key (attempts 8) after-fragment after-fields)
  "Valori CSN, location u64, record-len u32, :hit/:miss/:retry-limit, tentativi scartati.
Gli hook sono del solo harness; :retry-limit richiede inoltro al writer dal chiamante."
  (check-type i indice)
  (valida-chiave i chiave)
  (intero-limitato attempts 1 8)
  (check-type after-fragment (or null function))
  (check-type after-fields (or null function))
  (let ((h (hash-chiave chiave)))
    (dotimes (tentativo attempts (values 0 0 0 :retry-limit attempts))
      (let* ((root (indice-root i)) (gen (radice-generazione root)))
        (sb-thread:barrier (:read))
        (let ((f (radice-frammento root)))
          (when after-fragment (funcall after-fragment f))
          (multiple-value-bind (csn loc len stato) (sonda-reader f chiave h after-fields)
            (sb-thread:barrier (:read))
            (let ((attuale (indice-root i)))
              (when (and (not (eq stato :retry)) (eq root attuale)
                         (= gen (radice-generazione attuale)))
                (return-from leggi (values csn loc len stato tentativo))))))))))

(declaim (ftype (function (integer) double-float) secondi))
(defun secondi (ticks)
  "Conversione per reporting, fuori dal kernel di hashing."
  (/ (coerce ticks 'double-float) internal-time-units-per-second))
(declaim (ftype (function (indice) list) statistiche))
(defun statistiche (i)
  "Snapshot del writer; nessuna sincronizzazione dei contatori per i reader."
  (let* ((root (indice-root i)) (f (radice-frammento root)))
    (list :capacity (frammento-capacita f) :documents (frammento-vivi f)
          :ctrl-bytes (length (frammento-ctrl f)) :slot-words (length (frammento-slots f))
          :bytes-per-slot +byte-slot+ :arena-used (frammento-usati f)
          :arena-capacity (length (frammento-arena f)) :live-key-bytes (frammento-byte-vivi f)
          :tombstones (frammento-morti f) :root-generation (radice-generazione root)
          :payload-bytes (payload f) :peak-payload-bytes (indice-picco-payload i)
          :peak-transient-bytes (indice-picco-transitorio i)
          :insertions (indice-inserimenti i) :updates (indice-aggiornamenti i)
          :deletions (indice-eliminazioni i) :rebuilds (indice-rebuild i)
          :arena-growths (indice-crescite i) :copied-key-bytes (indice-byte-copiati i)
          :max-copied-key-bytes (indice-max-byte-copiati i)
          :max-source-slots-visited (indice-max-slot-visitati i)
          :max-source-slots-copied (indice-max-slot-copiati i)
          :max-directory-references-copied (indice-max-riferimenti i)
          :max-preparation-seconds (secondi (indice-max-preparazione-ticks i))
          :limits (list :key-bytes (indice-max-chiave i) :document-bytes (indice-max-documento i)
                        :arena-bytes (indice-max-arena i) :copy-bytes (indice-budget-copia i)
                        :transient-bytes (indice-budget-transitorio i)
                        :maintenance-seconds (secondi (indice-budget-ticks i))
                        :reader-attempts 8 :load-factor 7/8)
          :time-budget :cooperative-wall :memory-accounting :array-payload
          :pending '(:split :extendible-directory :retained-versions :writer-fallback
                     :memory-model-arm64-x86-64 :retired-roots-rss-budget))))

;;;; Harness bounded, separato dal percorso caldo e dall'oracolo del codec.
(declaim (ftype (function (fixnum u64) ottetti) chiave-fixture))
(defun chiave-fixture (len id)
  "Prefisso binario deterministico, ID nei byte finali; len configurato dal test."
  (let ((chiave (make-array len :element-type '(unsigned-byte 8))))
    (dotimes (n len) (setf (aref chiave n) (logand 255 (+ 113 (* 17 n)))))
    (dotimes (n (min len 8))
      (setf (aref chiave (- len n 1)) (ldb (byte 8 (* n 8)) id)))
    chiave))
(declaim (ftype (function (ottetti) u64) hash-riferimento))
(defun hash-riferimento (chiave)
  "Oracolo aritmetico indipendente; intermedi integer, MOD anziché maschera."
  (let ((h #xcbf29ce484222325))
    (dotimes (n (length chiave) h)
      (setf h (mod (* (logxor h (aref chiave n)) #x100000001b3) (expt 2 64))))))
(declaim (ftype (function (ottetti fixnum) u32) hash-loop))
(defun hash-loop (chiave volte)
  "Kernel inline per misurare le allocazioni degli intermedi, sink u32."
  (declare (type ottetti chiave) (type fixnum volte))
  (let ((sink 0))
    (declare (type u32 sink))
    (dotimes (n volte sink)
      (setf sink (logxor sink (ldb (byte 32 0) (hash-chiave chiave)))))))
(declaim (ftype (function (indice) list) fotografia))
(defun fotografia (i)
  "Identità root/array e copie integrali, compresi byte non referenziati e contatori."
  (let* ((r (indice-root i)) (f (radice-frammento r)) (a (frammento-arena f)))
    (list r f a (copy-seq (frammento-ctrl f)) (copy-seq (frammento-slots f))
          (copy-seq a) (statistiche i))))
(declaim (ftype (function (indice function keyword) null) verifica-rifiuto))
(defun verifica-rifiuto (i azione motivo)
  "Ogni rifiuto confronta identità e contenuti dello stato completo."
  (let ((prima (fotografia i))
        (esito (handler-case (progn (funcall azione) :nessun-rifiuto)
                 (limite-indice (c) (limite-motivo c))
                 (type-error () :type-error))))
    (assert (eq esito motivo))
    (let ((dopo (fotografia i)))
      (dotimes (n 3) (assert (eq (nth n prima) (nth n dopo))))
      (assert (equalp (nthcdr 3 prima) (nthcdr 3 dopo)))))
  nil)
(declaim (ftype (function (indice ottetti u64 u64 u32) null) verifica-entry))
(defun verifica-entry (i chiave csn loc len)
  "Controlla tutti i campi della risposta senza ridurre il CSN a fixnum."
  (multiple-value-bind (c l n stato scartati) (leggi i chiave)
    (assert (eq stato :hit)) (assert (= c csn)) (assert (= l loc))
    (assert (= n len)) (assert (zerop scartati)))
  nil)
(declaim (ftype (function (indice ottetti u64) boolean) inserisci-fixture))
(defun inserisci-fixture (i chiave valore)
  "Pattern coerente, location alta; documento fixture di un byte."
  (inserisci i chiave valore #xffffffff (ldb (byte 32 0) valore)
             (+ +header+ (length chiave) 1)))
(declaim (ftype (function (function indice ottetti t t t t) t) invoca-dati-errati))
(defun invoca-dati-errati (fun i chiave csn segmento off len)
  "Confine dinamico del test: i dati invalidi esercitano i typecheck a runtime."
  (funcall fun i chiave csn segmento off len))

