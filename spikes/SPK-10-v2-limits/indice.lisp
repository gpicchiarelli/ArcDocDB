        (setf len-record record)))
    (assert (= len-record +record-max+))
    (dolist (len '(0 65536))
      (let ((k (chiave-fixture len 1)))
        (verifica-rifiuto i (lambda () (inserisci-fixture i k 1)) :lunghezza-chiave)
        (verifica-rifiuto i (lambda () (leggi i k)) :lunghezza-chiave)))
    (let ((k (chiave-fixture 1 42)))
      (dolist (csn (list -1 (1+ +mask64+)))
        (verifica-rifiuto i (lambda () (invoca-dati-errati (symbol-function 'inserisci)
                                                        i k csn 0 0 25)) :type-error))
      (dolist (x '(-1 4294967296))
        (verifica-rifiuto i (lambda () (invoca-dati-errati (symbol-function 'inserisci)
                                                        i k 1 x 0 25)) :type-error)
        (verifica-rifiuto i (lambda () (invoca-dati-errati (symbol-function 'inserisci)
                                                        i k 1 0 x 25)) :type-error)
        (verifica-rifiuto i (lambda () (invoca-dati-errati (symbol-function 'inserisci)
                                                        i k 1 0 0 x)) :type-error))
      (verifica-rifiuto i (lambda () (inserisci i k 1 0 0 #xffffffff)) :lunghezza-record)
      (verifica-rifiuto i (lambda () (inserisci i k 1 0 0 24)) :lunghezza-record))
    (let ((f (radice-frammento (indice-root i))))
      (assert (= (* 5 16) (length (frammento-slots f))))
      (dotimes (s 16)
        (when (< (aref (frammento-ctrl f) s) 128)
          (assert (zerop (ldb (byte 8 56) (aref (frammento-slots f) (+ (* s 5) 2)))))
          (assert (zerop (ldb (byte 32 32) (aref (frammento-slots f) (+ (* s 5) 4))))))))
    (let ((m (metadata #xffffffff #xffff #xff)))
      (assert (= m #x00ffffffffffffff))
      (assert (= #xffffffff (ldb (byte 32 0) m)))
      (assert (= #xffff (ldb (byte 16 32) m))))
    (let* ((ridotto (make-indice :capacity 8 :max-key-bytes 255 :max-document-bytes 1))
           (k (chiave-fixture 255 1)))
      (assert (inserisci-fixture ridotto k 1))
      (verifica-rifiuto ridotto (lambda () (inserisci ridotto k 2 1 1 (+ 24 255 2)))
                        :lunghezza-record)
      (verifica-rifiuto ridotto (lambda () (inserisci-fixture ridotto (chiave-fixture 256 1) 1))
                        :lunghezza-chiave))
    (list :status :ok :accepted-key-lengths '(1 255 256 65535)
