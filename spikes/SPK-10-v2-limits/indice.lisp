(declaim (ftype (function () list) test-req-lim-003-confronto))
(defun test-req-lim-003-confronto ()
  "Chiavi a prefisso comune e impronta uguale richiedono confronto esatto."
  (let* ((i (make-indice :capacity 8)) (a (chiave-fixture 32 0))
         (b (copy-seq a)) (originale (copy-seq a)) (prove 0))
    (loop for n from 1 to 65535 do
      (setf (aref b 30) (ldb (byte 8 8) n) (aref b 31) (ldb (byte 8 0) n))
      (incf prove)
      (when (= (impronta (hash-chiave a)) (impronta (hash-chiave b))) (return)))
    (assert (not (equalp a b)))
    (assert (= (impronta (hash-chiave a)) (impronta (hash-chiave b))))
    (assert (inserisci-fixture i a 1)) (assert (inserisci-fixture i b 2))
    (fill a 0)
    (verifica-entry i originale 1 #xffffffff00000001 57)
    (verifica-entry i b 2 #xffffffff00000002 57)
    (assert (eq :miss (nth-value 3 (leggi i a))))
    (assert (elimina i originale))
    (verifica-entry i b 2 #xffffffff00000002 57)
    (list :status :ok :fingerprint-searches prove :prefix-bytes 30
          :private-copy-tested t :full-comparison-tested t)))

