(declaim (ftype (function () list) test-req-lim-001-layout))
(defun test-req-lim-001-layout ()
  "Confini di chiave/record, packing, u64 alto e configurazione ridotta."
  (let ((i (make-indice :capacity 16)) (len-record 0))
    (assert (zerop (getf (statistiche i) :arena-capacity)))
